// SPEC-FLAG-WORLD-FIRST-TICK-001
// STATUS: PROPOSED. No promotion, activation or first-tick execution is claimed.
// AUTHORITY: Codex PROPOSE; Devon Generally DECIDE / PROMOTE.
// VERSION: 0.1.1
// DATE: 2026-10-19
// SUPERSEDES: v0.1.0 PROPOSED, SHA256 0852FDF07349E6BFC605A339DDE1E7E51CE3DC19ACEDECD297532F3F3970CEC8.
// METHOD: SPEC-MAL-SPECIFICATION-SYSTEM-002 v0.3.1.
// METHOD_SHA256: 110D3C5EEA6F14592FEF4C480E1CABE41B6AF830901A75860FEF21BB0CC15EFE
// METHOD_PROMOTION_RECEIPT_SHA256: 16ACC1C93A9F40A399279CF8E877AFA4A398137C2EDCCA81DD130AA607F36B4E
// TARGET: ONE flag-world first tick: D2 genesis, one supplied governed selection,
// successor and committed readback, realized from v3 source on the GPU substrate.
// The four laws close this specification's walk, not the runtime world step.
// W8 admits this source; it does not execute its readings or discharge O_exec.
//
// CONTACTS used by the individual readings below:
// D2 := D2/tick.py, SHA256 535535DA2474B13B9B2D6C6FC9508C25D43FF2B406066540D76FF5E2AA19C7DA.
// D2 README := D2/README.md, SHA256 545D755A14373E2632E87BBBAC56A6DED1DF38B63591580BC56FF76178DABE0A.
// D2 incidence := D2/flag_rederive.py, SHA256 A17272D377554B163E41D348E78B1BB1E35784A5CD43369E4E15722A3EB16838.
// Archive := D2_tick_m2.zip, SHA256 A41A5C65762683030C937E5EC64E1C90E633FEBF957F1D915F03A221BF89BB8E.
// D2 remains the reference definition, not a Python runtime dependency of this realization.
// 096 := W040_INCIDENCE_COORDINATES_CONTACT_096/CONTACT.md sections 1-3,
// SHA256 AA1B7589978102D6B1519BD1BF01F427D774A66E797AAA7634E57DEAD14A6576.
// 116 := W040_SURFACE_FABRIC_LOWERING_116/SPEC.md L01-L14,
// SHA256 FFF676FC92D57CB564A2045754939794CE4CB0BE71DA286E5B709A623E3F9513.
// 117 := W040_SURFACE_FABRIC_LOWERING_117/AMENDMENT.md W01-W07,
// SHA256 1621C8ED130701DC6197FCB730247E2F60A002BBE5714518848B04C098171B7A.
// 117 takes precedence over conflicting 116 language. Retired implementations are not dependencies.
// CANON := hardware/JTP custody commit bfa2eacf62b30ee93a430954c39f7558268d3e41,
// and Ships-Computer commit 130f85239f684c3054c3096acb035324dbe19b5c.
// JTP := Ships-Computer/v3/junction_transaction_protocol/specs/
// SPEC-JUNCTION-TRANSITION-PROTOCOL-001_v0.1.0.md:14-50.
// PURE := Ships-Computer/v3/shipcomp_junction_protocol/packet_corpus/queuegate/v0.2.0/
// SPEC-QUEUEGATE-JTP-PURE-GATE-JUNCTION-001_v0.2.0.md sections 5,7,9.2-9.7,11.
// PURE SHA256 514F42BDED4319362DB5CC7E5B3DB536C3FC1B8CE430345693014FF6A124829A.
// RTL := Ships-Computer/v3/shipcomp_junction_protocol/rtl/
// jtp_pure_gate_dual_obligation_machine_004/qg_jtp_engine.sv:467-476.
// Persistence := Ships-Computer/v3/junction_transaction_protocol/runtime/
// k0c-jtp-governed-v1/k0_journal.c; MAIN-BANK-018 repair at mal_kernel_lab_repo
// ee3dd6379316d224ff8df4985c6fcbd60cf09a92, source SHA256
// F27B50C54D9611A8BB33181D67BFB0AD2DB22A96DF1D01136C4BFE722EE2CF64.
// Host repair witness SHA256 5555EA3B2ECC6C8D1DADB9AABA250F660722445E612EDEB17089337DA4934F1C.
// Its AVR board receipt remains O_next, not a first-tick gate.
// EMIT := promoted SPEC-V3-GPU-EMIT-001 v0.1.5, SHA256
// 5344E38F99B1AFB66B2A6FD2978CD9FD7B18C0CAE04EC4E7A284363CF6A434ED.
// EMIT V1/V2 discharge is retained; arbitrary world lowering is not inferred from it.

domain FLAG_WORLD_FIRST_TICK on face_11;

@propose seed FLAG_WORLD_FIRST_TICK_WALK := {
  WHAT(THIS),              // ONE D2 world is the complete m=2 field, entity positions and genealogy. Contact D2:2-5,37,47-53.
  HOW(THIS),               // Genesis records the supplied kappa; every one of 480 flags reads NO except E0 positions reading THIS. Contact D2:47-53; README.
  FOR_WHAT(THIS),          // Readback exposes the constituted successor, not a source check or a sandbox closure. Contact D2:105-108; JTP:14-22.

  WHAT(SAME_NOT_SAME),     // Agreement is equality of readings on each incidence overlap; agreement identity is NOT-SAME world identity. Contact D2:36-38,95-103.
  HOW(SAME_NOT_SAME),      // Compare exact vector output bytes; compare state, receipt and chain contents, not only wall counts. Contact D2:36-38,95-103; 002 HOW(INSIDE_OUTSIDE).
  FOR_WHAT(SAME_NOT_SAME), // A retained wall can have exchanged endpoint readings; it remains in the wall set even with no local receipt entry. Contact D2:38,96-101; V1/V2 below.

  WHAT(NO),                // NO is the determined empty marker reading after genesis; it is not an absent input or UNREAD. Contact D2:9,47-53.
  HOW(NO),                 // A supplied selection outside the offered lifts, stale basis, wrong stage or wrong predecessor cannot commit. Contact D2:82-89,105-107; JTP:50.
  FOR_WHAT(NO),            // No world law is supplied by fixture answers, host scheduling or application-specific substrate code. Contact 116 L01/L02/L11/L14; CANON; Devon's first-tick target.

  WHAT(IF_THEN),           // A first tick follows genesis -> PROPOSE -> supplied DECIDE -> PROMOTE -> EXECUTE, with their authorities distinct. Contact D2:47-108.
  HOW(IF_THEN),            // Only the promoted successor extending the current chain can become the next world state. Contact D2:105-108; JTP:40; PURE section 11.
  FOR_WHAT(IF_THEN),       // Commit is witnessed by the resulting state and one chain extension, not by a closure candidate alone. Contact D2:108; JTP:14-22,40.

  WHAT(BECAUSE),           // Each successor reading is grounded in the initial field and the selected offered lift; the receipt compares those two fields. Contact D2:87-103; 117 W02/W03.
  HOW(BECAUSE),            // Bind source, operands, result and the constituted states at ordered W-coordinates; naming their hashes does not supply their contents. Contact 116 L01/L02/L11; 117 W01-W04.
  FOR_WHAT(BECAUSE),       // BECAUSE field, selected lift and receipt are present in D2's promotion, retain their support through lowering and transaction construction. Contact D2:94-103; 116 L11/L12; 117 W02.

  WHAT(INSIDE_OUTSIDE),    // INSIDE is the bounded first tick and readback; later ticks, re-entry and physical board operations are OUTSIDE. Contact D2:47-108; current authoring scope.
  HOW(INSIDE_OUTSIDE),     // All 480 flags and all 720 delta/gamma/tau overlaps contribute; no replacement by the 105-cell witness basis. Contact D2:25-38; 096 sections 1-3.
  FOR_WHAT(INSIDE_OUTSIDE), // The two complete vector inputs and expectations are bound inside these bytes; undischarged work is named in the terminal. Contact 002 W6/W7.

  WHAT(NEAR_FAR),          // Adjacency is the incidence of delta, gamma and tau, not label distance or allocator order. Contact D2:28-35; 096 section 1; 117 W01.
  HOW(NEAR_FAR),           // Delta changes site within edge/triad; gamma changes edge at site/triad; tau changes triad at site/edge. Contact D2:31-34.
  FOR_WHAT(NEAR_FAR),      // Only overlaps incident to changed flags can change agreement; unchanged disagreement remains a wall. Contact D2:38,90-98.

  WHAT(CAN_CANNOT),        // PROPOSE supplies every completing lift with its gluing reading and selects none. Contact D2:61-80.
  HOW(CAN_CANNOT),         // The supplied selected lift must be one offered for the bound entity, kind, target and basis; no implementer tie-break. Contact D2:80-85; vectors supply the choice.
  FOR_WHAT(CAN_CANNOT),    // CAN reuse discharged EMIT profile/evaluator behavior; CANNOT infer world evaluation or commit from that discharge. Contact EMIT B1/V1/V2; 116 L02/L14.

  WHAT(MAYBE),             // Source-to-cell operands, D2-to-JTP construction and connected GPU commit remain PENDING implementation obligations, not invented readings. Contact 116 L02/L14; PURE section 9; terminal.
  HOW(MAYBE),              // Keep reading verdict, PENDING/REALIZED obligation status and TIG disposition separate; an incomplete frame supplies no default reading. Contact 002 HOW(MAYBE); 116 L09; PURE:188-190,353-355.
  FOR_WHAT(MAYBE),         // W8 may discharge form admission while every world-execution obligation remains PENDING. Contact 002 W8 and CONFORM; this proposal's terminal.

  WHAT(MUST_LET),          // MUST preserve D2's selected transition and hardware-governed transaction behavior; LET no unbound world semantics. Contact D2:87-108; CANON; 116 L02.
  HOW(MUST_LET),           // Substrate provides generic primitives only; source-derived cells and operands carry world law. Contact 116 L01-L09; 096 section 2; CANON.
  FOR_WHAT(MUST_LET),      // A gap returns to the spec's named obligations, never an implementer's supplied payload value. Contact 002 FOR_WHAT(NO), HOW(MUST_LET); 116 L14.

  WHAT(TOGETHER_ALONE),    // The successor, selected lift and receipt belong to ONE promotion while retaining distinct contents and identities. Contact D2:94-103.
  HOW(TOGETHER_ALONE),     // Authority, geometric reading and persistence contributions compose the transaction; candidate, append and committed result remain distinct. Contact JTP:14-40; CANON.
  FOR_WHAT(TOGETHER_ALONE), // The GPU tick uses the hardware definitions without requiring board reconnection; host evidence is not an AVR receipt. Contact CANON; MAIN-BANK-018 host repair; Devon's scope.

  WHAT(MORE_LESS),         // m=2 has 42 sites, 120 edges, 80 small triads and 480 flags; the walk basis has 105 cells. Contact D2 README; 002 MANY_ONE.
  HOW(MORE_LESS),          // Both adjacent single-marker vectors have three walls before and after: two discharge, two open, one retained. Contact D2:31-38,96-98; exact local derivation below.
  FOR_WHAT(MORE_LESS),     // Equal wall counts do not imply equal state; exact readback distinguishes the two selected successors. Contact D2:99-103; V1/V2.

  WHAT(GOES_WITH),         // Generated operands belong to their source occurrence, governing relation and realized incidence, not a type-product tuple. Contact 096 section 2; 116 L01/L08/L11.
  HOW(GOES_WITH),          // A cell's operator/witness identity binds its motif; translate witness names, not raw indices, across JTP and EMIT. Contact PURE motif registry; EMIT B1; witness correspondence below.
  FOR_WHAT(GOES_WITH),     // Source identity, fabric identity, obligation identity and world identity remain distinct with correspondence evidence. Contact 116 L11; 117 W01/W06; D2:36,100-102.

  WHAT(MANY_ONE),          // One first-tick operation consumes one initial world and one explicit governed selection; its internal work may contain many obligations. Contact D2:82-108; PURE sections 5/7.
  HOW(MANY_ONE),           // Derive pending work from satisfied law antecedents over realized content, retaining all distinct owed consequences. Contact 096 sections 2-3; PURE:337-359.
  FOR_WHAT(MANY_ONE),      // One D2 chain extension is the world-level outcome, not one append for every overlap or every internal cell. Contact D2:100-108; JTP:14-22,40.

  WHAT(EVERY_SOME),        // EVERY vector binds a complete initial state, exact selected lift and complete expected successor with receipt. Contact 002 W7; D2:47-108; V1/V2.
  HOW(EVERY_SOME),         // W1-W7 check these bytes; W8 uses the qualified native checker; CONFORM later runs V1 and V2 on the realization. Contact 002 W1-W8 and CONFORM.
  FOR_WHAT(EVERY_SOME),    // A form discharge never upgrades unexecuted vectors; ONE CONFORM verdict follows the prescribed identity/NO/MAYBE/IF_THEN order. Contact 002 FOR_WHAT(EVERY_SOME).

  THIS, SAME_NOT_SAME, NO, IF_THEN, BECAUSE, INSIDE_OUTSIDE, NEAR_FAR,
  CAN_CANNOT, MAYBE, MUST_LET, TOGETHER_ALONE, MORE_LESS, GOES_WITH,
  MANY_ONE, EVERY_SOME
};

law R1_WHERE :=
  IF WHAT(o)
  THEN WHERE(o);

law R1_WHICH :=
  IF WHAT(o)
  THEN WHICH(o);

law R1_WHEN :=
  IF HOW(o)
  THEN WHEN(o);

law R2_WHENCE :=
  IF WHERE(o), WHICH(o), WHEN(o), FOR_WHAT(o), FOR_WHAT(BECAUSE)
  THEN WHENCE(o);

// EXPECTED TERMINAL
// Structural: seed cells 45; derived 60 = WHERE 15 + WHICH 15 + WHEN 15 + WHENCE 15.
// Total 105 witness cells plus the 15 carrier atoms. PENDING seed/derived cells: {}.
// This structural terminal is NOT the world-execution terminal.
// Current O_exec, each PENDING:
// O_SOURCE_DERIVED_LOWERING: realize the readings as v3 source-derived cells, typed
// operands/results, incidence, witness correspondence and complete source support;
// includes native m=2 constitution, genesis, completing-lift production and selection.
// O_JTP_OBLIGATION_CONSTRUCTION: derive the D2 work and its obligation identities,
// authority, geometry and persistence projections from that lowering; preserve all
// successor/lift/receipt support. Neither the old A5 witness nor the 24-vector caller
// supplies this D2 realization. No arbitrary ID or payload substitution is admitted.
// O_GPU_STEP_EXECUTION: execute that source-derived genesis and selected step via
// the generic GPU substrate with connected inputs, provenance and exact readback.
// O_COMMIT: apply the admitted successor and one chain extension, with authority,
// predecessor and persistence checks; do not report a candidate as committed.
// O_VECTOR_CONFORMANCE: execute V1 and V2 against the named realization, compare the
// exact expected bytes, and record per-vector execution/SAME or NOT_SAME and ONE verdict.
// Expected completed execution terminal: O_exec = {} only after those witnesses.
// O_next = { O_AVR_REPAIR_BOARD_RECEIPT, O_LATER_TICKS_AND_REENTRY,
//            O_R1_R3_GATE_READING_SELECTION, O_INDEPENDENT_BUILDER_COMPARISON }.
// O_AVR_REPAIR_BOARD_RECEIPT: PENDING, host-witnessed repair retained; not a GPU tick gate.
// O_LATER_TICKS_AND_REENTRY: PENDING, outside this one-tick scope.
// O_R1_R3_GATE_READING_SELECTION: PENDING by record; no reading chosen here;
// D2 NO/THIS marker-field agreement remains the bounded input.
// O_INDEPENDENT_BUILDER_COMPARISON: PENDING; this authoring/checking pass is not independent.
// W8 results and spec SHA256 belong to the external run record, not a self-hash.

// VECTORS -- exact byte-observable first-tick readbacks, not GPU memory layouts.
// Common reading: D2's reference encoding is UTF-8 sorted-key compact JSON,
// separators comma/colon, no BOM, no terminal newline. Array order is retained.
// D2's embedded digest strings are lowercase; the binding hashes below are uppercase.
// This is reference observation encoding, not a new production CANONICAL_BYTES law.
// Output projection: {"receipt": receipt, "state": state_body_with_chain}.
// state_body_with_chain contains D2 state_body's field/entities and the actual chain.
// field is the complete 480-entry sorted flag/reading list, never a sparse substitute.
// receipt_reading is THIS when discharged or opened has content; NO when both have none.
// These are pre-numeric carrier readings, not truth values; the complete receipt remains.
// Genealogy RECEIPT_READING_001: Devon's instruction replaces D2 tick.py:100-103
// receipt_empty with receipt_reading. D2 is reproduced except this field and its
// downstream tick-link/output digests. No other state or receipt content changes.
// The input carries kappa, E0, complete genesis initial_state, entity, kind, target,
// and exact selected_lift. initial_state must be the genesis produced from kappa/E0.
// The supplied lift is a choice input, not a host ordering rule or a fabricated token.
// The runtime stages establish its membership, basis and authorization before commit.
// Derivation contact: D2:47-53,61-108. Expected bytes are frozen before any candidate.
// No expected-output file may supply the candidate's world state.
//
// Exact local names for the hand derivation (each tuple is [site,edge,triad]):
// t  = ["C:N|U0","C:N|U1","D:N"]
// t4 = ["C:N|U0","C:N|U4","D:N"]
// t2 = ["C:N|U1","C:N|U2","D:N"]
// ea = ["C:N|U0","D:N"]; eb = ["C:N|U1","D:N"];
// ec = ["C:N|U0","C:N|U1"].
// f=["D:N",ea,t]; g=["C:N|U0",ea,t]; h=["D:N",eb,t]; j=["D:N",ea,t4].
// gGamma=["C:N|U0",ec,t]; gTau=["C:N|U0",ea,t4].
// hDelta=["C:N|U1",eb,t]; hTau=["D:N",eb,t2].
// Initial kappa=f, E0={"e1":f}; f reads THIS, the other 479 flags read NO.
// Each pair and the pair list use D2's lexicographic incidence ordering.
// V1: delta(f)=g. Discharged {(f,h),(f,j)}; opened {(g,gGamma),(g,gTau)}.
// The pair (f,g) remains a wall: THIS/NO becomes NO/THIS.
// V2: gamma(f)=h. Discharged {(f,g),(f,j)}; opened {(h,hDelta),(h,hTau)}.
// The pair (f,h) remains a wall. All other unchanged overlaps retain their reading.
// For either vector the selected lift has from=f, via=f, to=g or h, and reading
// {"discharged":2,"opened":2,"walls_after":3}. The two receipts are distinct.
// Genesis record follows D2:52-53; tick record follows D2:100-103 except
// RECEIPT_READING_001 above, with ONE new link.
// Mechanical expansion/hashing of this hand-derived data is retained in
// author_vectors.mjs; it is authoring support, not a runtime or independent builder.

// V1 FIRST_TICK(V1.input.json)
//    argument_1 V1.input.json sha256 28093717ACC694FACC3B635701A22AFF37DDB09FB0447774BACC700647F262BE
//    input_bytes 32842; kind site; target "C:N|U0"; selected_lift f -> g via f.
//    expected_sha256 69786966E9B5D66A2078D29C43E1F1511545786AB07BF562E37D91205085B588
//    expected_bytes_count 33563; expected_file V1.expected.json.
//    origin D2 definitions plus hand-derived adjacent-site receipt; no candidate output.
//    execution NOT_RUN.

// V2 FIRST_TICK(V2.input.json)
//    argument_1 V2.input.json sha256 DC46E239B9D693AF25DC3D7005718060230D31AC9CA057F7ECCCF73968AA2C8E
//    input_bytes 32847; kind edge; target eb; selected_lift f -> h via f.
//    expected_sha256 BD0492B4CAC427432CC3251EB27FC997C0D5EFF2862ECBC10A89B9AC19F1AD0F
//    expected_bytes_count 33548; expected_file V2.expected.json.
//    origin D2 definitions plus hand-derived adjacent-edge receipt; no candidate output.
//    execution NOT_RUN.

// Witness correspondence, content of HOW(GOES_WITH), not an additional law:
// JTP order WHAT,WHERE,WHICH,WHEN,FOR_WHAT,HOW,WHENCE maps by name to EMIT
// WHAT,HOW,FOR_WHAT,WHERE,WHICH,WHEN,WHENCE via [0,3,4,5,2,1,6].
// motif = 7*family+witness in the named JTP order; EMIT cell = 7*op+witness
// in its own named order. No raw-index equality or 480-flag/105-cell equality.
// The pure-gate section 9.2 object is NOT the legacy MALCFU24 ObligationV1 core.
// Its layout is supplied; D2-specific source-to-payload realization remains O_exec.
// Existing EMIT CONFORM IF_THEN is retained only for its V1/V2 canonical profile.
// Genealogy: historical 8E69D9C5 checker prefix discrepancy stays OPEN_NOT_SAME,
// not a W8 gate. No inherited form or hardware discharge is reopened here.
