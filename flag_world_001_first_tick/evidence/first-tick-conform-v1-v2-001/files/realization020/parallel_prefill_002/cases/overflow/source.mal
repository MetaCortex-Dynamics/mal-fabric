law PRODUCT := IF THIS(ANCHOR,a), THIS(ITEM,x) THEN GOES_WITH(OUTPUT,a,x);
law ECHO := IF GOES_WITH(OUTPUT,a,x) THEN GOES_WITH(ECHO,a,x);
law REDUNDANT_PROOF := IF THIS(ITEM,x), THIS(ANCHOR,a) THEN GOES_WITH(OUTPUT,a,x);

