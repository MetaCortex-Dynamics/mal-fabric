// Hardware-only base data, header SHA256 25AF837405F450986FBD24A425D2197BD5E5D9D4BF952F74BE43CFB992B10F64
// QG-003 incidence SHA256 82E388FD7F12E77D97E248DBF243E5B7D55F8EE56AFAED137BB37DD315F15BDB
// 116/117/096: realization connection; no new promotion or kappa selection.
// HW identifiers and order are transport codes, not quantities or placement.
domain HARDWARE_INCIDENCE on face_11;
@propose seed BASE_INCIDENCE := {
 GOES_WITH(BASE_EDGE,HW_00,HW_01),
