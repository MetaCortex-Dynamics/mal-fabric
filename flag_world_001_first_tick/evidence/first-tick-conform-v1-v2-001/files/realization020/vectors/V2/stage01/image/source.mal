 GOES_WITH(VC_BYTE_BITS,B211,BITS(THIS,THIS,NO,THIS,NO,NO,THIS,THIS)),
 GOES_WITH(VC_BYTE_BITS,B212,BITS(THIS,THIS,NO,THIS,NO,THIS,NO,NO)),
 GOES_WITH(VC_BYTE_BITS,B213,BITS(THIS,THIS,NO,THIS,NO,THIS,NO,THIS)),
 GOES_WITH(VC_BYTE_BITS,B214,BITS(THIS,THIS,NO,THIS,NO,THIS,THIS,NO)),
 GOES_WITH(VC_BYTE_BITS,B215,BITS(THIS,THIS,NO,THIS,NO,THIS,THIS,THIS)),
 GOES_WITH(VC_BYTE_BITS,B216,BITS(THIS,THIS,NO,THIS,THIS,NO,NO,NO)),
 GOES_WITH(VC_BYTE_BITS,B217,BITS(THIS,THIS,NO,THIS,THIS,NO,NO,THIS)),
 GOES_WITH(VC_BYTE_BITS,B218,BITS(THIS,THIS,NO,THIS,THIS,NO,THIS,NO)),
 GOES_WITH(VC_BYTE_BITS,B219,BITS(THIS,THIS,NO,THIS,THIS,NO,THIS,THIS)),
 GOES_WITH(VC_BYTE_BITS,B220,BITS(THIS,THIS,NO,THIS,THIS,THIS,NO,NO)),
 GOES_WITH(VC_BYTE_BITS,B221,BITS(THIS,THIS,NO,THIS,THIS,THIS,NO,THIS)),
 GOES_WITH(VC_BYTE_BITS,B222,BITS(THIS,THIS,NO,THIS,THIS,THIS,THIS,NO)),
 GOES_WITH(VC_BYTE_BITS,B223,BITS(THIS,THIS,NO,THIS,THIS,THIS,THIS,THIS)),
 GOES_WITH(VC_BYTE_BITS,B224,BITS(THIS,THIS,THIS,NO,NO,NO,NO,NO)),
 GOES_WITH(VC_BYTE_BITS,B225,BITS(THIS,THIS,THIS,NO,NO,NO,NO,THIS)),
 GOES_WITH(VC_BYTE_BITS,B226,BITS(THIS,THIS,THIS,NO,NO,NO,THIS,NO)),
 GOES_WITH(VC_BYTE_BITS,B227,BITS(THIS,THIS,THIS,NO,NO,NO,THIS,THIS)),
 GOES_WITH(VC_BYTE_BITS,B228,BITS(THIS,THIS,THIS,NO,NO,THIS,NO,NO)),
 GOES_WITH(VC_BYTE_BITS,B229,BITS(THIS,THIS,THIS,NO,NO,THIS,NO,THIS)),
 GOES_WITH(VC_BYTE_BITS,B230,BITS(THIS,THIS,THIS,NO,NO,THIS,THIS,NO)),
 GOES_WITH(VC_BYTE_BITS,B231,BITS(THIS,THIS,THIS,NO,NO,THIS,THIS,THIS)),
 GOES_WITH(VC_BYTE_BITS,B232,BITS(THIS,THIS,THIS,NO,THIS,NO,NO,NO)),
 GOES_WITH(VC_BYTE_BITS,B233,BITS(THIS,THIS,THIS,NO,THIS,NO,NO,THIS)),
 GOES_WITH(VC_BYTE_BITS,B234,BITS(THIS,THIS,THIS,NO,THIS,NO,THIS,NO)),
 GOES_WITH(VC_BYTE_BITS,B235,BITS(THIS,THIS,THIS,NO,THIS,NO,THIS,THIS)),
 GOES_WITH(VC_BYTE_BITS,B236,BITS(THIS,THIS,THIS,NO,THIS,THIS,NO,NO)),
 GOES_WITH(VC_BYTE_BITS,B237,BITS(THIS,THIS,THIS,NO,THIS,THIS,NO,THIS)),
 GOES_WITH(VC_BYTE_BITS,B238,BITS(THIS,THIS,THIS,NO,THIS,THIS,THIS,NO)),
 GOES_WITH(VC_BYTE_BITS,B239,BITS(THIS,THIS,THIS,NO,THIS,THIS,THIS,THIS)),
 GOES_WITH(VC_BYTE_BITS,B240,BITS(THIS,THIS,THIS,THIS,NO,NO,NO,NO)),
 GOES_WITH(VC_BYTE_BITS,B241,BITS(THIS,THIS,THIS,THIS,NO,NO,NO,THIS)),
 GOES_WITH(VC_BYTE_BITS,B242,BITS(THIS,THIS,THIS,THIS,NO,NO,THIS,NO)),
 GOES_WITH(VC_BYTE_BITS,B243,BITS(THIS,THIS,THIS,THIS,NO,NO,THIS,THIS)),
 GOES_WITH(VC_BYTE_BITS,B244,BITS(THIS,THIS,THIS,THIS,NO,THIS,NO,NO)),
 GOES_WITH(VC_BYTE_BITS,B245,BITS(THIS,THIS,THIS,THIS,NO,THIS,NO,THIS)),
 GOES_WITH(VC_BYTE_BITS,B246,BITS(THIS,THIS,THIS,THIS,NO,THIS,THIS,NO)),
 GOES_WITH(VC_BYTE_BITS,B247,BITS(THIS,THIS,THIS,THIS,NO,THIS,THIS,THIS)),
 GOES_WITH(VC_BYTE_BITS,B248,BITS(THIS,THIS,THIS,THIS,THIS,NO,NO,NO)),
 GOES_WITH(VC_BYTE_BITS,B249,BITS(THIS,THIS,THIS,THIS,THIS,NO,NO,THIS)),
 GOES_WITH(VC_BYTE_BITS,B250,BITS(THIS,THIS,THIS,THIS,THIS,NO,THIS,NO)),
 GOES_WITH(VC_BYTE_BITS,B251,BITS(THIS,THIS,THIS,THIS,THIS,NO,THIS,THIS)),
 GOES_WITH(VC_BYTE_BITS,B252,BITS(THIS,THIS,THIS,THIS,THIS,THIS,NO,NO)),
 GOES_WITH(VC_BYTE_BITS,B253,BITS(THIS,THIS,THIS,THIS,THIS,THIS,NO,THIS)),
 GOES_WITH(VC_BYTE_BITS,B254,BITS(THIS,THIS,THIS,THIS,THIS,THIS,THIS,NO)),
 GOES_WITH(VC_BYTE_BITS,B255,BITS(THIS,THIS,THIS,THIS,THIS,THIS,THIS,THIS))
};

law VC_ROWS := IF THIS(VC_INPUT_FIELD,ARRAY(rows))
 THEN THIS(VC_ROWS,rows);
law VC_ROWS_TAIL := IF THIS(VC_ROWS,CONS(row,tail))
 THEN THIS(VC_ROWS,tail);
law VC_ROWS_BLOCK := IF THIS(VC_ROWS,CONS(a,CONS(b,CONS(c,CONS(d,CONS(e,CONS(f,CONS(g,CONS(h,tail)))))))))
 THEN THIS(VC_ROWS,tail);
law VC_REF_FLAG := IF THIS(VC_ROWS,CONS(ARRAY(CONS(flag,CONS(reading,NIL))),tail)), GOES_WITH(VC_READING,reading,r)
 THEN GOES_WITH(VC_REF_FLAG,flag,reading,r);
law VC_REF_FLAG_PARTS := IF GOES_WITH(VC_REF_FLAG,ARRAY(CONS(s,CONS(e,CONS(t,NIL)))),reading,r)
 THEN GOES_WITH(VC_REF_FLAG_PARTS,ARRAY(CONS(s,CONS(e,CONS(t,NIL)))),s,e,t);
law VC_REF_SITE := IF GOES_WITH(VC_REF_FLAG_PARTS,f,s,e,t)
 THEN THIS(VC_REF_SITE,s);
law VC_REF_EDGE := IF GOES_WITH(VC_REF_FLAG_PARTS,f,s,e,t)
 THEN THIS(VC_REF_EDGE,e);
law VC_REF_TRIAD := IF GOES_WITH(VC_REF_FLAG_PARTS,f,s,e,t)
 THEN THIS(VC_REF_TRIAD,t);
law VC_REF_DOMAIN_SITE := IF THIS(VC_REF_SITE,TEXT(CONS(B68,CONS(B58,name))))
 THEN GOES_WITH(VC_REF_DOMAIN_SITE,TEXT(CONS(B68,CONS(B58,name))),TEXT(name));
law VC_REF_DOMAIN := IF GOES_WITH(VC_REF_DOMAIN_SITE,s,a)
 THEN THIS(VC_REF_DOMAIN,a);
law VC_DOMAIN_BYTES := IF THIS(VC_REF_DOMAIN,TEXT(bytes))
 THEN THIS(VC_BYTES,bytes);
law VC_SITE_BYTES := IF THIS(VC_REF_SITE,TEXT(bytes))
 THEN THIS(VC_BYTES,bytes);
law VC_BYTES_TAIL := IF THIS(VC_BYTES,CONS(b,tail))
 THEN THIS(VC_BYTES,tail);
law VC_BYTE := IF THIS(VC_BYTES,CONS(b,tail))
 THEN THIS(VC_BYTE,b);
law VC_BYTE_DIFFER_0 := IF THIS(VC_BYTE,x), THIS(VC_BYTE,y), GOES_WITH(VC_BYTE_BITS,x,BITS(NO,a1,a2,a3,a4,a5,a6,a7)), GOES_WITH(VC_BYTE_BITS,y,BITS(THIS,b1,b2,b3,b4,b5,b6,b7))
 THEN GOES_WITH(VC_BYTE_DIFFER,x,y);
law VC_BYTE_DIFFER_1 := IF THIS(VC_BYTE,x), THIS(VC_BYTE,y), GOES_WITH(VC_BYTE_BITS,x,BITS(a0,NO,a2,a3,a4,a5,a6,a7)), GOES_WITH(VC_BYTE_BITS,y,BITS(b0,THIS,b2,b3,b4,b5,b6,b7))
 THEN GOES_WITH(VC_BYTE_DIFFER,x,y);
law VC_BYTE_DIFFER_2 := IF THIS(VC_BYTE,x), THIS(VC_BYTE,y), GOES_WITH(VC_BYTE_BITS,x,BITS(a0,a1,NO,a3,a4,a5,a6,a7)), GOES_WITH(VC_BYTE_BITS,y,BITS(b0,b1,THIS,b3,b4,b5,b6,b7))
 THEN GOES_WITH(VC_BYTE_DIFFER,x,y);
law VC_BYTE_DIFFER_3 := IF THIS(VC_BYTE,x), THIS(VC_BYTE,y), GOES_WITH(VC_BYTE_BITS,x,BITS(a0,a1,a2,NO,a4,a5,a6,a7)), GOES_WITH(VC_BYTE_BITS,y,BITS(b0,b1,b2,THIS,b4,b5,b6,b7))
 THEN GOES_WITH(VC_BYTE_DIFFER,x,y);
law VC_BYTE_DIFFER_4 := IF THIS(VC_BYTE,x), THIS(VC_BYTE,y), GOES_WITH(VC_BYTE_BITS,x,BITS(a0,a1,a2,a3,NO,a5,a6,a7)), GOES_WITH(VC_BYTE_BITS,y,BITS(b0,b1,b2,b3,THIS,b5,b6,b7))
 THEN GOES_WITH(VC_BYTE_DIFFER,x,y);
law VC_BYTE_DIFFER_5 := IF THIS(VC_BYTE,x), THIS(VC_BYTE,y), GOES_WITH(VC_BYTE_BITS,x,BITS(a0,a1,a2,a3,a4,NO,a6,a7)), GOES_WITH(VC_BYTE_BITS,y,BITS(b0,b1,b2,b3,b4,THIS,b6,b7))
 THEN GOES_WITH(VC_BYTE_DIFFER,x,y);
law VC_BYTE_DIFFER_6 := IF THIS(VC_BYTE,x), THIS(VC_BYTE,y), GOES_WITH(VC_BYTE_BITS,x,BITS(a0,a1,a2,a3,a4,a5,NO,a7)), GOES_WITH(VC_BYTE_BITS,y,BITS(b0,b1,b2,b3,b4,b5,THIS,b7))
 THEN GOES_WITH(VC_BYTE_DIFFER,x,y);
law VC_BYTE_DIFFER_7 := IF THIS(VC_BYTE,x), THIS(VC_BYTE,y), GOES_WITH(VC_BYTE_BITS,x,BITS(a0,a1,a2,a3,a4,a5,a6,NO)), GOES_WITH(VC_BYTE_BITS,y,BITS(b0,b1,b2,b3,b4,b5,b6,THIS))
 THEN GOES_WITH(VC_BYTE_DIFFER,x,y);
law VC_BYTE_DIFFER_REVERSE := IF GOES_WITH(VC_BYTE_DIFFER,a,b)
 THEN GOES_WITH(VC_BYTE_DIFFER,b,a);
law VC_TEXT_REQUEST := IF THIS(VC_REF_DOMAIN,TEXT(a)), THIS(VC_REF_DOMAIN,TEXT(b))
 THEN THIS(VC_TEXT_REQUEST,a,b);
law VC_SITE_TEXT_REQUEST := IF THIS(VC_REF_SITE,TEXT(a)), THIS(VC_REF_SITE,TEXT(b))
 THEN THIS(VC_TEXT_REQUEST,a,b);
law VC_TEXT_REQUEST_TAIL := IF THIS(VC_TEXT_REQUEST,CONS(b,a),CONS(b,c))
 THEN THIS(VC_TEXT_REQUEST,a,c);
law VC_TEXT_DIFFER_LEFT_END := IF THIS(VC_TEXT_REQUEST,NIL,CONS(b,c))
 THEN GOES_WITH(VC_TEXT_DIFFER,NIL,CONS(b,c));
law VC_TEXT_DIFFER_RIGHT_END := IF THIS(VC_TEXT_REQUEST,CONS(b,c),NIL)
 THEN GOES_WITH(VC_TEXT_DIFFER,CONS(b,c),NIL);
law VC_TEXT_DIFFER_BYTE := IF THIS(VC_TEXT_REQUEST,CONS(a,x),CONS(b,y)), GOES_WITH(VC_BYTE_DIFFER,a,b)
 THEN GOES_WITH(VC_TEXT_DIFFER,CONS(a,x),CONS(b,y));
law VC_TEXT_DIFFER_PREFIX := IF THIS(VC_TEXT_REQUEST,CONS(a,x),CONS(a,y)), GOES_WITH(VC_TEXT_DIFFER,x,y)
 THEN GOES_WITH(VC_TEXT_DIFFER,CONS(a,x),CONS(a,y));
law VC_REF_DISTINCT := IF THIS(VC_REF_DOMAIN,TEXT(a)), THIS(VC_REF_DOMAIN,TEXT(b)), GOES_WITH(VC_TEXT_DIFFER,a,b)
 THEN GOES_WITH(VC_REF_DISTINCT,TEXT(a),TEXT(b));
law VC_REF_SITE_DISTINCT := IF THIS(VC_REF_SITE,TEXT(a)), THIS(VC_REF_SITE,TEXT(b)), GOES_WITH(VC_TEXT_DIFFER,a,b)
 THEN GOES_WITH(VC_REF_SITE_DISTINCT,TEXT(a),TEXT(b));

// Decode corridors by reconstruction from domain byte identities, not by
// selecting a lexical split or interpreting an identifier as NUMBER.
law VC_JOIN_REQUEST := IF THIS(VC_REF_DOMAIN,TEXT(a)), THIS(VC_REF_DOMAIN,TEXT(b)), GOES_WITH(VC_REF_DISTINCT,TEXT(a),TEXT(b))
 THEN THIS(VC_JOIN_REQUEST,a,CONS(B124,b));
law VC_JOIN_TAIL := IF THIS(VC_JOIN_REQUEST,CONS(h,t),b)
 THEN THIS(VC_JOIN_REQUEST,t,b);
law VC_JOIN_EMPTY := IF THIS(VC_JOIN_REQUEST,NIL,b)
 THEN GOES_WITH(VC_JOINED,NIL,b,b);
law VC_JOIN_HEAD := IF THIS(VC_JOIN_REQUEST,CONS(h,t),b), GOES_WITH(VC_JOINED,t,b,r)
 THEN GOES_WITH(VC_JOINED,CONS(h,t),b,CONS(h,r));
law VC_REF_MIDPOINT := IF THIS(VC_REF_SITE,TEXT(CONS(B67,CONS(B58,r)))), THIS(VC_REF_DOMAIN,TEXT(a)), THIS(VC_REF_DOMAIN,TEXT(b)), GOES_WITH(VC_REF_DISTINCT,TEXT(a),TEXT(b)), GOES_WITH(VC_JOINED,a,CONS(B124,b),r)
 THEN GOES_WITH(VC_REF_MIDPOINT,TEXT(CONS(B67,CONS(B58,r))),TEXT(a),TEXT(b));
law VC_REF_CORRIDOR_FORWARD := IF GOES_WITH(VC_REF_MIDPOINT,s,a,b)
 THEN GOES_WITH(VC_REF_CORRIDOR,s,a,b);
law VC_REF_CORRIDOR_REVERSE := IF GOES_WITH(VC_REF_MIDPOINT,s,a,b)
 THEN GOES_WITH(VC_REF_CORRIDOR,s,b,a);
law VC_REF_EDGE_MEMBER_0 := IF THIS(VC_REF_EDGE,ARRAY(CONS(a,CONS(b,NIL))))
 THEN GOES_WITH(VC_REF_EDGE_MEMBER,ARRAY(CONS(a,CONS(b,NIL))),a);
law VC_REF_EDGE_MEMBER_1 := IF THIS(VC_REF_EDGE,ARRAY(CONS(a,CONS(b,NIL))))
 THEN GOES_WITH(VC_REF_EDGE_MEMBER,ARRAY(CONS(a,CONS(b,NIL))),b);
law VC_REF_TRIAD_MEMBER_0 := IF THIS(VC_REF_TRIAD,ARRAY(CONS(a,CONS(b,CONS(c,NIL)))))
 THEN GOES_WITH(VC_REF_TRIAD_MEMBER,ARRAY(CONS(a,CONS(b,CONS(c,NIL)))),a);
law VC_REF_TRIAD_MEMBER_1 := IF THIS(VC_REF_TRIAD,ARRAY(CONS(a,CONS(b,CONS(c,NIL)))))
 THEN GOES_WITH(VC_REF_TRIAD_MEMBER,ARRAY(CONS(a,CONS(b,CONS(c,NIL)))),b);
law VC_REF_TRIAD_MEMBER_2 := IF THIS(VC_REF_TRIAD,ARRAY(CONS(a,CONS(b,CONS(c,NIL)))))
 THEN GOES_WITH(VC_REF_TRIAD_MEMBER,ARRAY(CONS(a,CONS(b,CONS(c,NIL)))),c);
law VC_REF_BASE_FACE := IF GOES_WITH(VC_REF_TRIAD_MEMBER,t,u), GOES_WITH(VC_REF_TRIAD_MEMBER,t,v), GOES_WITH(VC_REF_TRIAD_MEMBER,t,w), GOES_WITH(VC_REF_CORRIDOR,u,a,b), GOES_WITH(VC_REF_CORRIDOR,v,a,c), GOES_WITH(VC_REF_CORRIDOR,w,b,c)
 THEN GOES_WITH(VC_REF_BASE_FACE,t,a,b,c);
law VC_REF_OPPOSITE := IF GOES_WITH(VC_REF_BASE_FACE,t,a,b,c), GOES_WITH(VC_REF_BASE_FACE,u,a,b,d), GOES_WITH(VC_REF_DISTINCT,c,d)
 THEN GOES_WITH(VC_REF_OPPOSITE,a,b,c,d);

// The frozen fixtures carry a refined domain-site flag. Its parent triangle
// is recovered through the selected incident midpoint and the other midpoint.
// Every target face and all six orders remain observer contexts.
law VC_REFERENCE_ANCHOR := IF THIS(VC_INPUT_KAPPA,ARRAY(CONS(s,CONS(e,CONS(t,NIL))))), GOES_WITH(VC_REF_DOMAIN_SITE,s,a), GOES_WITH(VC_REF_EDGE_MEMBER,e,m), GOES_WITH(VC_REF_CORRIDOR,m,a,b), GOES_WITH(VC_REF_TRIAD_MEMBER,t,n), GOES_WITH(VC_REF_CORRIDOR,n,a,c), GOES_WITH(VC_REF_DISTINCT,b,c), GOES_WITH(VC_REF_BASE_FACE,u,a,b,c)
 THEN GOES_WITH(VC_REFERENCE_ANCHOR,a,b,c);
law VC_HW_FACE_ABC := IF GOES_WITH(HARDWARE_FACE,w,a,b,c)
 THEN GOES_WITH(VC_HW_FACE,w,a,b,c);
law VC_HW_FACE_ACB := IF GOES_WITH(HARDWARE_FACE,w,a,b,c)
 THEN GOES_WITH(VC_HW_FACE,w,a,c,b);
law VC_HW_FACE_BAC := IF GOES_WITH(HARDWARE_FACE,w,a,b,c)
 THEN GOES_WITH(VC_HW_FACE,w,b,a,c);
law VC_HW_FACE_BCA := IF GOES_WITH(HARDWARE_FACE,w,a,b,c)
 THEN GOES_WITH(VC_HW_FACE,w,b,c,a);
law VC_HW_FACE_CAB := IF GOES_WITH(HARDWARE_FACE,w,a,b,c)
 THEN GOES_WITH(VC_HW_FACE,w,c,a,b);
law VC_HW_FACE_CBA := IF GOES_WITH(HARDWARE_FACE,w,a,b,c)
 THEN GOES_WITH(VC_HW_FACE,w,c,b,a);
law VC_HW_OPPOSITE := IF GOES_WITH(VC_HW_FACE,t,a,b,c), GOES_WITH(VC_HW_FACE,u,a,b,d), GOES_WITH(DISTINCT_SITE,THIS(c),THIS(d))
 THEN GOES_WITH(VC_HW_OPPOSITE,a,b,c,d);
law VC_HW_ANCHOR := IF GOES_WITH(VC_HW_FACE,w,x,y,z), GOES_WITH(VC_REFERENCE_ANCHOR,a,b,c)
 THEN GOES_WITH(VC_HW_ANCHOR,ANCHOR(w,x,y,z),x,y,z);
law VC_ANCHOR_DOMAIN_0 := IF GOES_WITH(VC_REFERENCE_ANCHOR,a,b,c), GOES_WITH(VC_HW_ANCHOR,k,x,y,z)
 THEN GOES_WITH(VC_DOMAIN_CANDIDATE,k,a,x);
law VC_ANCHOR_DOMAIN_1 := IF GOES_WITH(VC_REFERENCE_ANCHOR,a,b,c), GOES_WITH(VC_HW_ANCHOR,k,x,y,z)
 THEN GOES_WITH(VC_DOMAIN_CANDIDATE,k,b,y);
law VC_ANCHOR_DOMAIN_2 := IF GOES_WITH(VC_REFERENCE_ANCHOR,a,b,c), GOES_WITH(VC_HW_ANCHOR,k,x,y,z)
 THEN GOES_WITH(VC_DOMAIN_CANDIDATE,k,c,z);
law VC_PROPAGATE := IF GOES_WITH(VC_REF_OPPOSITE,a,b,c,d), GOES_WITH(VC_HW_OPPOSITE,x,y,z,w), GOES_WITH(VC_DOMAIN_CANDIDATE,k,a,x), GOES_WITH(VC_DOMAIN_CANDIDATE,k,b,y), GOES_WITH(VC_DOMAIN_CANDIDATE,k,c,z)
 THEN GOES_WITH(VC_DOMAIN_CANDIDATE,k,d,w);

// Complete injective assignments, not an existential assertion about raw map
// facts. All satisfying assignments remain in the output relation.
law VC_DOMAIN_LIST := IF THIS(VC_HW_DOMAINS,rows)
 THEN GOES_WITH(VC_INVENTORY,DOMAIN,rows);
law VC_EDGE_LIST := IF THIS(VC_HW_EDGES,rows)
 THEN GOES_WITH(VC_INVENTORY,EDGE,rows);
law VC_FACE_LIST := IF THIS(VC_HW_FACES,rows)
 THEN GOES_WITH(VC_INVENTORY,FACE,rows);
law VC_INVENTORY_TAIL := IF GOES_WITH(VC_INVENTORY,kind,CONS(h,t))
 THEN GOES_WITH(VC_INVENTORY,kind,t);
law VC_ASSIGN_END := IF GOES_WITH(VC_HW_ANCHOR,k,a,b,c), GOES_WITH(VC_INVENTORY,DOMAIN,NIL)
 THEN GOES_WITH(VC_ASSIGN,k,NIL,NIL);
law VC_DISTINCT_REQUEST := IF GOES_WITH(VC_INVENTORY,DOMAIN,CONS(x,tail)), GOES_WITH(VC_ASSIGN,k,tail,bindings), GOES_WITH(VC_DOMAIN_CANDIDATE,k,a,x)
 THEN THIS(VC_NOT_MEMBER_REQUEST,a,bindings);
law VC_NOT_MEMBER_END := IF THIS(VC_NOT_MEMBER_REQUEST,a,NIL)
 THEN GOES_WITH(VC_NOT_MEMBER,a,NIL);
law VC_NOT_MEMBER_TAIL := IF THIS(VC_NOT_MEMBER_REQUEST,a,CONS(BIND(b,x),tail)), GOES_WITH(VC_REF_DISTINCT,a,b)
 THEN THIS(VC_NOT_MEMBER_REQUEST,a,tail);
law VC_NOT_MEMBER_HEAD := IF THIS(VC_NOT_MEMBER_REQUEST,a,CONS(BIND(b,x),tail)), GOES_WITH(VC_REF_DISTINCT,a,b), GOES_WITH(VC_NOT_MEMBER,a,tail)
 THEN GOES_WITH(VC_NOT_MEMBER,a,CONS(BIND(b,x),tail));
law VC_ASSIGN_HEAD := IF GOES_WITH(VC_INVENTORY,DOMAIN,CONS(x,tail)), GOES_WITH(VC_ASSIGN,k,tail,bindings), GOES_WITH(VC_DOMAIN_CANDIDATE,k,a,x), GOES_WITH(VC_NOT_MEMBER,a,bindings)
 THEN GOES_WITH(VC_ASSIGN,k,CONS(x,tail),CONS(BIND(a,x),bindings));
law VC_ASSIGNMENT := IF THIS(VC_HW_DOMAINS,domains), GOES_WITH(VC_ASSIGN,k,domains,bindings)
 THEN GOES_WITH(VC_ASSIGNMENT,k,bindings);
law VC_BINDING_ROWS := IF GOES_WITH(VC_ASSIGNMENT,k,bindings)
 THEN GOES_WITH(VC_BINDING_ROWS,bindings,bindings);
law VC_BINDING_TAIL := IF GOES_WITH(VC_BINDING_ROWS,m,CONS(b,tail))
 THEN GOES_WITH(VC_BINDING_ROWS,m,tail);
law VC_ASSIGN_DOMAIN := IF GOES_WITH(VC_BINDING_ROWS,m,CONS(BIND(a,x),tail))
 THEN GOES_WITH(VC_ASSIGN_DOMAIN,m,a,x);
law VC_COVER_DOMAIN := IF GOES_WITH(VC_ASSIGN_DOMAIN,m,a,x), THIS(SITE,THIS(x))
 THEN GOES_WITH(VC_COVER,m,DOMAIN,x);
law VC_COVER_EDGE := IF GOES_WITH(HARDWARE_EDGE,j,x,y), GOES_WITH(VC_ASSIGN_DOMAIN,m,a,x), GOES_WITH(VC_ASSIGN_DOMAIN,m,b,y), GOES_WITH(VC_REF_CORRIDOR,e,a,b)
 THEN GOES_WITH(VC_COVER,m,EDGE,j);
law VC_COVER_FACE := IF GOES_WITH(HARDWARE_FACE,w,x,y,z), GOES_WITH(VC_ASSIGN_DOMAIN,m,a,x), GOES_WITH(VC_ASSIGN_DOMAIN,m,b,y), GOES_WITH(VC_ASSIGN_DOMAIN,m,c,z), GOES_WITH(VC_REF_BASE_FACE,t,a,b,c)
 THEN GOES_WITH(VC_COVER,m,FACE,w);
law VC_COVER_END := IF GOES_WITH(VC_ASSIGNMENT,k,m), GOES_WITH(VC_INVENTORY,kind,NIL)
 THEN GOES_WITH(VC_COVER_SUFFIX,m,kind,NIL);
law VC_COVER_HEAD := IF GOES_WITH(VC_INVENTORY,kind,CONS(x,tail)), GOES_WITH(VC_COVER,m,kind,x), GOES_WITH(VC_COVER_SUFFIX,m,kind,tail)
 THEN GOES_WITH(VC_COVER_SUFFIX,m,kind,CONS(x,tail));

// Transport refinement incidence by actual site/edge/triad membership. Tuple
// permutations recognize the source's canonical constructor, never a role.
law VC_SITE_DOMAIN := IF GOES_WITH(VC_REF_DOMAIN_SITE,s,a), GOES_WITH(VC_ASSIGN_DOMAIN,m,a,x), THIS(SITE,THIS(x))
 THEN GOES_WITH(VC_ASSIGN_SITE,m,s,THIS(x));
law VC_SITE_MIDPOINT := IF GOES_WITH(VC_REF_CORRIDOR,s,a,b), GOES_WITH(VC_ASSIGN_DOMAIN,m,a,x), GOES_WITH(VC_ASSIGN_DOMAIN,m,b,y), GOES_WITH(HARDWARE_EDGE,j,x,y), THIS(SITE,TOGETHER_ALONE(x,y))
 THEN GOES_WITH(VC_ASSIGN_SITE,m,s,TOGETHER_ALONE(x,y));
law VC_MAP_EDGE_AB := IF THIS(VC_REF_EDGE,ARRAY(CONS(a,CONS(b,NIL)))), GOES_WITH(VC_ASSIGN_SITE,m,a,x), GOES_WITH(VC_ASSIGN_SITE,m,b,y), THIS(EDGE,TOGETHER_ALONE(x,y))
 THEN GOES_WITH(VC_ASSIGN_EDGE,m,ARRAY(CONS(a,CONS(b,NIL))),TOGETHER_ALONE(x,y));
law VC_MAP_EDGE_BA := IF THIS(VC_REF_EDGE,ARRAY(CONS(a,CONS(b,NIL)))), GOES_WITH(VC_ASSIGN_SITE,m,a,x), GOES_WITH(VC_ASSIGN_SITE,m,b,y), THIS(EDGE,TOGETHER_ALONE(y,x))
 THEN GOES_WITH(VC_ASSIGN_EDGE,m,ARRAY(CONS(a,CONS(b,NIL))),TOGETHER_ALONE(y,x));
law VC_MAP_TRIAD_ABC := IF THIS(VC_REF_TRIAD,ARRAY(CONS(a,CONS(b,CONS(c,NIL))))), GOES_WITH(VC_ASSIGN_SITE,m,a,x), GOES_WITH(VC_ASSIGN_SITE,m,b,y), GOES_WITH(VC_ASSIGN_SITE,m,c,z), THIS(TRIAD,TOGETHER_ALONE(x,y,z))
 THEN GOES_WITH(VC_ASSIGN_TRIAD,m,ARRAY(CONS(a,CONS(b,CONS(c,NIL)))),TOGETHER_ALONE(x,y,z));
law VC_MAP_TRIAD_ACB := IF THIS(VC_REF_TRIAD,ARRAY(CONS(a,CONS(b,CONS(c,NIL))))), GOES_WITH(VC_ASSIGN_SITE,m,a,x), GOES_WITH(VC_ASSIGN_SITE,m,b,y), GOES_WITH(VC_ASSIGN_SITE,m,c,z), THIS(TRIAD,TOGETHER_ALONE(x,z,y))
 THEN GOES_WITH(VC_ASSIGN_TRIAD,m,ARRAY(CONS(a,CONS(b,CONS(c,NIL)))),TOGETHER_ALONE(x,z,y));
law VC_MAP_TRIAD_BAC := IF THIS(VC_REF_TRIAD,ARRAY(CONS(a,CONS(b,CONS(c,NIL))))), GOES_WITH(VC_ASSIGN_SITE,m,a,x), GOES_WITH(VC_ASSIGN_SITE,m,b,y), GOES_WITH(VC_ASSIGN_SITE,m,c,z), THIS(TRIAD,TOGETHER_ALONE(y,x,z))
 THEN GOES_WITH(VC_ASSIGN_TRIAD,m,ARRAY(CONS(a,CONS(b,CONS(c,NIL)))),TOGETHER_ALONE(y,x,z));
law VC_MAP_TRIAD_BCA := IF THIS(VC_REF_TRIAD,ARRAY(CONS(a,CONS(b,CONS(c,NIL))))), GOES_WITH(VC_ASSIGN_SITE,m,a,x), GOES_WITH(VC_ASSIGN_SITE,m,b,y), GOES_WITH(VC_ASSIGN_SITE,m,c,z), THIS(TRIAD,TOGETHER_ALONE(y,z,x))
 THEN GOES_WITH(VC_ASSIGN_TRIAD,m,ARRAY(CONS(a,CONS(b,CONS(c,NIL)))),TOGETHER_ALONE(y,z,x));
law VC_MAP_TRIAD_CAB := IF THIS(VC_REF_TRIAD,ARRAY(CONS(a,CONS(b,CONS(c,NIL))))), GOES_WITH(VC_ASSIGN_SITE,m,a,x), GOES_WITH(VC_ASSIGN_SITE,m,b,y), GOES_WITH(VC_ASSIGN_SITE,m,c,z), THIS(TRIAD,TOGETHER_ALONE(z,x,y))
 THEN GOES_WITH(VC_ASSIGN_TRIAD,m,ARRAY(CONS(a,CONS(b,CONS(c,NIL)))),TOGETHER_ALONE(z,x,y));
law VC_MAP_TRIAD_CBA := IF THIS(VC_REF_TRIAD,ARRAY(CONS(a,CONS(b,CONS(c,NIL))))), GOES_WITH(VC_ASSIGN_SITE,m,a,x), GOES_WITH(VC_ASSIGN_SITE,m,b,y), GOES_WITH(VC_ASSIGN_SITE,m,c,z), THIS(TRIAD,TOGETHER_ALONE(z,y,x))
 THEN GOES_WITH(VC_ASSIGN_TRIAD,m,ARRAY(CONS(a,CONS(b,CONS(c,NIL)))),TOGETHER_ALONE(z,y,x));
law VC_ASSIGN_FLAG := IF GOES_WITH(VC_REF_FLAG_PARTS,flag,s,e,t), GOES_WITH(VC_ASSIGN_SITE,m,s,x), GOES_WITH(VC_ASSIGN_EDGE,m,e,y), GOES_WITH(VC_ASSIGN_TRIAD,m,t,z), THIS(FLAG,TOGETHER_ALONE(x,y,z))
 THEN GOES_WITH(VC_ASSIGN_FLAG,m,flag,TOGETHER_ALONE(x,y,z));

// The three involutive contacts are read independently on the retained input
// incidence. A move changes its named flag component and retains the other two,
// exactly as moves.mal does on hardware incidence. The other endpoint / opposite
// site is witnessed positively; no absent fact or identifier order is used.
law VC_REF_EDGE_OTHER_AB := IF THIS(VC_REF_EDGE,ARRAY(CONS(a,CONS(b,NIL))))
 THEN GOES_WITH(VC_REF_EDGE_OTHER,ARRAY(CONS(a,CONS(b,NIL))),a,b);
law VC_REF_EDGE_OTHER_BA := IF THIS(VC_REF_EDGE,ARRAY(CONS(a,CONS(b,NIL))))
 THEN GOES_WITH(VC_REF_EDGE_OTHER,ARRAY(CONS(a,CONS(b,NIL))),b,a);
law VC_REF_OPPOSITE_AB := IF THIS(VC_REF_TRIAD,ARRAY(CONS(a,CONS(b,CONS(c,NIL))))), GOES_WITH(VC_REF_EDGE_MEMBER,e,a), GOES_WITH(VC_REF_EDGE_MEMBER,e,b)
 THEN GOES_WITH(VC_REF_EDGE_OPPOSITE,e,c,ARRAY(CONS(a,CONS(b,CONS(c,NIL)))));
law VC_REF_OPPOSITE_AC := IF THIS(VC_REF_TRIAD,ARRAY(CONS(a,CONS(b,CONS(c,NIL))))), GOES_WITH(VC_REF_EDGE_MEMBER,e,a), GOES_WITH(VC_REF_EDGE_MEMBER,e,c)
 THEN GOES_WITH(VC_REF_EDGE_OPPOSITE,e,b,ARRAY(CONS(a,CONS(b,CONS(c,NIL)))));
law VC_REF_OPPOSITE_BC := IF THIS(VC_REF_TRIAD,ARRAY(CONS(a,CONS(b,CONS(c,NIL))))), GOES_WITH(VC_REF_EDGE_MEMBER,e,b), GOES_WITH(VC_REF_EDGE_MEMBER,e,c)
 THEN GOES_WITH(VC_REF_EDGE_OPPOSITE,e,a,ARRAY(CONS(a,CONS(b,CONS(c,NIL)))));
law VC_REF_DELTA := IF GOES_WITH(VC_REF_FLAG_PARTS,f,s,e,t), GOES_WITH(VC_REF_FLAG_PARTS,g,u,e,t), GOES_WITH(VC_REF_EDGE_OTHER,e,s,u), GOES_WITH(VC_REF_SITE_DISTINCT,s,u)
 THEN GOES_WITH(VC_REF_MOVE,DELTA,f,g);
law VC_REF_GAMMA := IF GOES_WITH(VC_REF_FLAG_PARTS,f,s,e,t), GOES_WITH(VC_REF_FLAG_PARTS,g,s,u,t), GOES_WITH(VC_REF_EDGE_OTHER,e,s,a), GOES_WITH(VC_REF_EDGE_OTHER,u,s,b), GOES_WITH(VC_REF_SITE_DISTINCT,a,b)
 THEN GOES_WITH(VC_REF_MOVE,GAMMA,f,g);
law VC_REF_TAU := IF GOES_WITH(VC_REF_FLAG_PARTS,f,s,e,t), GOES_WITH(VC_REF_FLAG_PARTS,g,s,e,u), GOES_WITH(VC_REF_EDGE_OPPOSITE,e,a,t), GOES_WITH(VC_REF_EDGE_OPPOSITE,e,b,u), GOES_WITH(VC_REF_SITE_DISTINCT,a,b)
 THEN GOES_WITH(VC_REF_MOVE,TAU,f,g);
law VC_REF_MOVES := IF GOES_WITH(VC_REF_MOVE,DELTA,f,d), GOES_WITH(VC_REF_MOVE,GAMMA,f,g), GOES_WITH(VC_REF_MOVE,TAU,f,t)
 THEN GOES_WITH(VC_REF_MOVES,f,d,g,t);

// A single proof retains the three commuting squares for one flag. Its eight
// antecedents compare the reference contacts with the already source-produced
// hardware moves. A bijection that does not commute cannot complete coverage.
law VC_MOVE_COMMUTATION := IF GOES_WITH(VC_ASSIGN_FLAG,m,r,f), GOES_WITH(VC_REF_MOVES,r,rd,rg,rt), GOES_WITH(VC_ASSIGN_FLAG,m,rd,d), GOES_WITH(VC_ASSIGN_FLAG,m,rg,g), GOES_WITH(VC_ASSIGN_FLAG,m,rt,t), GOES_WITH(DELTA,f,d), GOES_WITH(GAMMA,f,g), GOES_WITH(TAU,f,t)
 THEN GOES_WITH(VC_MOVE_COMMUTATION,m,r,f,TRIPLE(rd,rg,rt),TRIPLE(d,g,t));

// Length is checked once, independently of correspondence. Per-map coverage
// walks each complete sequence; it does not materialize overlapping spans for
// every map. These pure custody folds run before any fixture execution.
law VC_REFERENCE_ROW_LENGTH := IF THIS(VC_ROWS,CONS(ARRAY(CONS(flag,CONS(reading,NIL))),tail)), GOES_WITH(VC_REF_FLAG,flag,reading,r)
 THEN GOES_WITH(VC_REFERENCE_LENGTH,ONE,CONS(ARRAY(CONS(flag,CONS(reading,NIL))),tail),tail);
law VC_REFERENCE_DOUBLE_LENGTH := IF GOES_WITH(GSC_SPAN_DOUBLE,n,z), GOES_WITH(VC_REFERENCE_LENGTH,n,a,b), GOES_WITH(VC_REFERENCE_LENGTH,n,b,c)
 THEN GOES_WITH(VC_REFERENCE_LENGTH,z,a,c);
law VC_REFERENCE_FULL_LENGTH := IF THIS(VC_INPUT_FIELD,ARRAY(a)), GOES_WITH(VC_REFERENCE_LENGTH,TWO_FIFTY_SIX,a,b), GOES_WITH(VC_REFERENCE_LENGTH,ONE_TWENTY_EIGHT,b,c), GOES_WITH(VC_REFERENCE_LENGTH,SIXTY_FOUR,c,d), GOES_WITH(VC_REFERENCE_LENGTH,THIRTY_TWO,d,NIL)
 THEN THIS(VC_REFERENCE_FULL_LENGTH);
law VC_REFERENCE_COVER_END := IF GOES_WITH(VC_ASSIGNMENT,k,m), THIS(VC_ROWS,NIL)
 THEN GOES_WITH(VC_FLAG_COVER_SUFFIX,m,REFERENCE,NIL);
law VC_REFERENCE_COVER_HEAD := IF THIS(VC_ROWS,CONS(ARRAY(CONS(flag,CONS(reading,NIL))),tail)), GOES_WITH(VC_REF_FLAG,flag,reading,r), GOES_WITH(VC_MOVE_COMMUTATION,m,flag,f,referenceMoves,hardwareMoves), GOES_WITH(VC_FLAG_COVER_SUFFIX,m,REFERENCE,tail)
 THEN GOES_WITH(VC_FLAG_COVER_SUFFIX,m,REFERENCE,CONS(ARRAY(CONS(flag,CONS(reading,NIL))),tail));
law VC_HARDWARE_COVER_END := IF GOES_WITH(VC_ASSIGNMENT,k,m), GOES_WITH(GSC_ROWS,CURRENT_FIELD,NIL)
 THEN GOES_WITH(VC_FLAG_COVER_SUFFIX,m,HARDWARE,NIL);
law VC_HARDWARE_COVER_HEAD := IF GOES_WITH(GSC_ROW_SPAN,CURRENT_FIELD,ONE,CONS(row,tail),tail), GOES_WITH(GSC_ROW_KEY,CURRENT_FIELD,row,f), GOES_WITH(VC_ASSIGN_FLAG,m,flag,f), GOES_WITH(VC_FLAG_COVER_SUFFIX,m,HARDWARE,tail)
 THEN GOES_WITH(VC_FLAG_COVER_SUFFIX,m,HARDWARE,CONS(row,tail));
law VC_FLAG_REFERENCE_ROOT := IF THIS(VC_INPUT_FIELD,ARRAY(rows))
 THEN GOES_WITH(VC_FLAG_ROOT,REFERENCE,rows);
law VC_FLAG_HARDWARE_ROOT := IF THIS(GSC_FIELD_INPUT,ARRAY(rows)), GOES_WITH(GSC_COMPLETE,CURRENT_FIELD,ARRAY(rows))
 THEN GOES_WITH(VC_FLAG_ROOT,HARDWARE,rows);
law VC_FLAGS_COMPLETE := IF GOES_WITH(VC_FLAG_ROOT,kind,a), GOES_WITH(VC_FLAG_COVER_SUFFIX,m,kind,a), THIS(VC_REFERENCE_FULL_LENGTH)
 THEN GOES_WITH(VC_FLAGS_COMPLETE,m,kind);
law VC_CORRESPONDENCE_COMPLETE := IF GOES_WITH(VC_ASSIGNMENT,k,m), THIS(VC_HW_DOMAINS,ds), THIS(VC_HW_EDGES,es), THIS(VC_HW_FACES,ts), GOES_WITH(VC_COVER_SUFFIX,m,DOMAIN,ds), GOES_WITH(VC_COVER_SUFFIX,m,EDGE,es), GOES_WITH(VC_COVER_SUFFIX,m,FACE,ts)
 THEN GOES_WITH(VC_BASE_COMPLETE,CORRESPONDENCE(k,m),BASE_COVERAGE(ds,es,ts));
law VC_COMPLETE := IF GOES_WITH(VC_BASE_COMPLETE,CORRESPONDENCE(k,m),proof), GOES_WITH(VC_FLAGS_COMPLETE,m,REFERENCE), GOES_WITH(VC_FLAGS_COMPLETE,m,HARDWARE)
 THEN GOES_WITH(VC_CORRESPONDENCE_COMPLETE,CORRESPONDENCE(k,m),INCIDENCE_BIJECTION(proof,REFERENCE_FLAGS,HARDWARE_FLAGS,MOVE_COMMUTATION(DELTA,GAMMA,TAU)));
law VC_DOMAIN_MAP := IF GOES_WITH(VC_CORRESPONDENCE_COMPLETE,CORRESPONDENCE(k,m),proof), GOES_WITH(VC_ASSIGN_DOMAIN,m,a,x)
 THEN GOES_WITH(VC_DOMAIN_MAP,CORRESPONDENCE(k,m),a,x);
law VC_EDGE_MAP := IF GOES_WITH(VC_CORRESPONDENCE_COMPLETE,CORRESPONDENCE(k,m),proof), GOES_WITH(VC_REF_CORRIDOR,s,a,b), GOES_WITH(VC_ASSIGN_DOMAIN,m,a,x), GOES_WITH(VC_ASSIGN_DOMAIN,m,b,y), GOES_WITH(HARDWARE_EDGE,j,x,y)
 THEN GOES_WITH(VC_EDGE_MAP,CORRESPONDENCE(k,m),s,j);
law VC_FACE_MAP := IF GOES_WITH(VC_CORRESPONDENCE_COMPLETE,CORRESPONDENCE(k,m),proof), GOES_WITH(VC_REF_BASE_FACE,t,a,b,c), GOES_WITH(VC_ASSIGN_DOMAIN,m,a,x), GOES_WITH(VC_ASSIGN_DOMAIN,m,b,y), GOES_WITH(VC_ASSIGN_DOMAIN,m,c,z), GOES_WITH(HARDWARE_FACE,w,x,y,z)
 THEN GOES_WITH(VC_FACE_MAP,CORRESPONDENCE(k,m),t,w);
law VC_FLAG_MAP := IF GOES_WITH(VC_CORRESPONDENCE_COMPLETE,CORRESPONDENCE(k,m),proof), GOES_WITH(VC_ASSIGN_FLAG,m,r,f)
 THEN GOES_WITH(VC_FLAG_MAP,CORRESPONDENCE(k,m),r,f);
law VC_VECTOR_FIELD := IF GOES_WITH(VC_FLAG_MAP,c,flag,f), GOES_WITH(VC_REF_FLAG,flag,reading,r)
 THEN GOES_WITH(VC_VECTOR_FIELD,c,f,r);
law VC_KAPPA_OBSERVATION := IF THIS(VC_INPUT_KAPPA,flag), GOES_WITH(VC_FLAG_MAP,c,flag,f)
 THEN GOES_WITH(VC_KAPPA_OBSERVATION,c,flag,f);

// All ordered hardware faces are covered. This neither chooses one context
// nor proves output equivariance; EVERY exported context must execute and its
// inverse-observed output must agree before universal conformance is claimed.
law VC_ANCHOR_COMPLETE := IF GOES_WITH(VC_CORRESPONDENCE_COMPLETE,CORRESPONDENCE(k,m),proof)
 THEN THIS(VC_ANCHOR_COMPLETE,k);
law VC_FACE_ALL_ANCHORS := IF GOES_WITH(HARDWARE_FACE,w,a,b,c), THIS(VC_ANCHOR_COMPLETE,ANCHOR(w,a,b,c)), THIS(VC_ANCHOR_COMPLETE,ANCHOR(w,a,c,b)), THIS(VC_ANCHOR_COMPLETE,ANCHOR(w,b,a,c)), THIS(VC_ANCHOR_COMPLETE,ANCHOR(w,b,c,a)), THIS(VC_ANCHOR_COMPLETE,ANCHOR(w,c,a,b)), THIS(VC_ANCHOR_COMPLETE,ANCHOR(w,c,b,a))
 THEN THIS(VC_FACE_ALL_ANCHORS,w);
law VC_FAMILY_END := IF GOES_WITH(VC_INVENTORY,FACE,NIL)
 THEN THIS(VC_FAMILY_SUFFIX,NIL);
law VC_FAMILY_HEAD := IF GOES_WITH(VC_INVENTORY,FACE,CONS(w,tail)), THIS(VC_FACE_ALL_ANCHORS,w), THIS(VC_FAMILY_SUFFIX,tail)
 THEN THIS(VC_FAMILY_SUFFIX,CONS(w,tail));
law VC_ALL_ANCHORS_COVERED := IF THIS(VC_HW_FACES,faces), THIS(VC_FAMILY_SUFFIX,faces)
 THEN THIS(VC_ALL_ANCHORS_COVERED,ALL_ORDERED_HARDWARE_FACES);

// This universal witness covers incidence and the three move contacts, not a
// selected world kappa and not an unexecuted successor. VC_VECTOR_FIELD copies
// each exact reading through the certified bijection; no payload is inferred.
// The eventual output-SAME witness must additionally consume every context's
// executed and inverse-observed result. That witness is not asserted here.
law VC_UNIVERSAL_TRANSPORT := IF THIS(VC_ALL_ANCHORS_COVERED,ALL_ORDERED_HARDWARE_FACES), THIS(VC_REFERENCE_FULL_LENGTH)
 THEN THIS(VC_UNIVERSAL_TRANSPORT,ALL_ORDERED_HARDWARE_FACES,INCIDENCE_AND_MOVES(DELTA,GAMMA,TAU),READINGS_UNCHANGED);

// Frozen-vector observer execution on the hardware-derived carrier.
// Authority: FT v0.1.3 (2ECF2EEF...C1A01), unchanged D2 genesis/displacement
// readings; 116 L11 checked correspondence. Source contacts retained verbatim
// in meaning: input_custody.mal, genesis.mal, displacement.mal,
// entity_successor.mal, initial_state_custody.mal, genesis_record.mal and
// initial_chain.mal under flag_world_first_tick_realization_001/source/.
//
// EVERY certified observer context is retained. The frozen input supplies its
// entity, target and complete selected lift; no map or lift is selected here.
// VD_* fields are fixture-context values, NOT CURRENT_FIELD or actual genesis.
// The original C: artifacts and promoted V1/V2 bytes remain unchanged.
@readonly input VD_INPUT_E0 := "vector:/E0";
@readonly input VD_INPUT_ENTITY := "vector:/entity";
@readonly input VD_INPUT_KIND := "vector:/kind";
@readonly input VD_INPUT_TARGET := "vector:/target";
@readonly input VD_INPUT_LIFT := "vector:/selected_lift";
@readonly input VD_INPUT_ENTITIES := "vector:/initial_state/entities";
@readonly input VD_INPUT_CHAIN := "vector:/initial_state/chain";

// Positive structural NOT_SAME. Array/list positions compare observation
// structure only, never choose a domain, correspondence, placement or move.
law VD_DIFFER_TEXT_REQUEST := IF THIS(VD_DIFFER_REQUEST,TEXT(a),TEXT(b))
 THEN THIS(VC_TEXT_REQUEST,a,b);
law VD_DIFFER_TEXT_A_BYTES := IF THIS(VD_DIFFER_REQUEST,TEXT(a),TEXT(b))
 THEN THIS(VC_BYTES,a);
law VD_DIFFER_TEXT_B_BYTES := IF THIS(VD_DIFFER_REQUEST,TEXT(a),TEXT(b))
 THEN THIS(VC_BYTES,b);
law VD_DIFFER_TEXT := IF THIS(VD_DIFFER_REQUEST,TEXT(a),TEXT(b)), GOES_WITH(VC_TEXT_DIFFER,a,b)
 THEN GOES_WITH(VD_DIFFER,TEXT(a),TEXT(b));
law VD_DIFFER_ARRAY_REQUEST := IF THIS(VD_DIFFER_REQUEST,ARRAY(a),ARRAY(b))
 THEN THIS(VD_DIFFER_REQUEST,a,b);
law VD_DIFFER_ARRAY := IF THIS(VD_DIFFER_REQUEST,ARRAY(a),ARRAY(b)), GOES_WITH(VD_DIFFER,a,b)
 THEN GOES_WITH(VD_DIFFER,ARRAY(a),ARRAY(b));
law VD_DIFFER_CONS_HEAD_REQUEST := IF THIS(VD_DIFFER_REQUEST,CONS(a,b),CONS(c,d))
 THEN THIS(VD_DIFFER_REQUEST,a,c);
law VD_DIFFER_CONS_TAIL_REQUEST := IF THIS(VD_DIFFER_REQUEST,CONS(a,b),CONS(c,d))
 THEN THIS(VD_DIFFER_REQUEST,b,d);
law VD_DIFFER_CONS_HEAD := IF THIS(VD_DIFFER_REQUEST,CONS(a,b),CONS(c,d)), GOES_WITH(VD_DIFFER,a,c)
 THEN GOES_WITH(VD_DIFFER,CONS(a,b),CONS(c,d));
law VD_DIFFER_CONS_TAIL := IF THIS(VD_DIFFER_REQUEST,CONS(a,b),CONS(c,d)), GOES_WITH(VD_DIFFER,b,d)
 THEN GOES_WITH(VD_DIFFER,CONS(a,b),CONS(c,d));
law VD_DIFFER_EMPTY_LEFT := IF THIS(VD_DIFFER_REQUEST,NIL,CONS(a,b))
 THEN GOES_WITH(VD_DIFFER,NIL,CONS(a,b));
law VD_DIFFER_EMPTY_RIGHT := IF THIS(VD_DIFFER_REQUEST,CONS(a,b),NIL)
 THEN GOES_WITH(VD_DIFFER,CONS(a,b),NIL);
law VD_DIFFER_SITE := IF THIS(VD_DIFFER_REQUEST,a,b), GOES_WITH(DISTINCT_SITE,a,b)
 THEN GOES_WITH(VD_DIFFER,a,b);
law VD_DIFFER_PAIR_FIRST_REQUEST := IF THIS(VD_DIFFER_REQUEST,TOGETHER_ALONE(a,b),TOGETHER_ALONE(c,d))
 THEN THIS(VD_DIFFER_REQUEST,a,c);
law VD_DIFFER_PAIR_SECOND_REQUEST := IF THIS(VD_DIFFER_REQUEST,TOGETHER_ALONE(a,b),TOGETHER_ALONE(c,d))
 THEN THIS(VD_DIFFER_REQUEST,b,d);
law VD_DIFFER_PAIR_FIRST := IF THIS(VD_DIFFER_REQUEST,TOGETHER_ALONE(a,b),TOGETHER_ALONE(c,d)), GOES_WITH(VD_DIFFER,a,c)
 THEN GOES_WITH(VD_DIFFER,TOGETHER_ALONE(a,b),TOGETHER_ALONE(c,d));
law VD_DIFFER_PAIR_SECOND := IF THIS(VD_DIFFER_REQUEST,TOGETHER_ALONE(a,b),TOGETHER_ALONE(c,d)), GOES_WITH(VD_DIFFER,b,d)
 THEN GOES_WITH(VD_DIFFER,TOGETHER_ALONE(a,b),TOGETHER_ALONE(c,d));
law VD_DIFFER_TRIPLE_FIRST_REQUEST := IF THIS(VD_DIFFER_REQUEST,TOGETHER_ALONE(a,b,c),TOGETHER_ALONE(d,e,f))
 THEN THIS(VD_DIFFER_REQUEST,a,d);
law VD_DIFFER_TRIPLE_SECOND_REQUEST := IF THIS(VD_DIFFER_REQUEST,TOGETHER_ALONE(a,b,c),TOGETHER_ALONE(d,e,f))
 THEN THIS(VD_DIFFER_REQUEST,b,e);
law VD_DIFFER_TRIPLE_THIRD_REQUEST := IF THIS(VD_DIFFER_REQUEST,TOGETHER_ALONE(a,b,c),TOGETHER_ALONE(d,e,f))
 THEN THIS(VD_DIFFER_REQUEST,c,f);
law VD_DIFFER_TRIPLE_FIRST := IF THIS(VD_DIFFER_REQUEST,TOGETHER_ALONE(a,b,c),TOGETHER_ALONE(d,e,f)), GOES_WITH(VD_DIFFER,a,d)
 THEN GOES_WITH(VD_DIFFER,TOGETHER_ALONE(a,b,c),TOGETHER_ALONE(d,e,f));
law VD_DIFFER_TRIPLE_SECOND := IF THIS(VD_DIFFER_REQUEST,TOGETHER_ALONE(a,b,c),TOGETHER_ALONE(d,e,f)), GOES_WITH(VD_DIFFER,b,e)
 THEN GOES_WITH(VD_DIFFER,TOGETHER_ALONE(a,b,c),TOGETHER_ALONE(d,e,f));
law VD_DIFFER_TRIPLE_THIRD := IF THIS(VD_DIFFER_REQUEST,TOGETHER_ALONE(a,b,c),TOGETHER_ALONE(d,e,f)), GOES_WITH(VD_DIFFER,c,f)
 THEN GOES_WITH(VD_DIFFER,TOGETHER_ALONE(a,b,c),TOGETHER_ALONE(d,e,f));

// E0 constructs the reference genesis field. The supplied field is compared
// with that result; it never supplies genesis readings by assertion.
law VD_E0_ROWS := IF THIS(VD_INPUT_E0,OBJECT(rows))
 THEN THIS(VD_E0_ROWS,rows);
law VD_E0_TAIL := IF THIS(VD_E0_ROWS,CONS(row,tail))
 THEN THIS(VD_E0_ROWS,tail);
law VD_REFERENCE_ENTITY := IF THIS(VD_E0_ROWS,CONS(MEMBER(name,f),tail)), GOES_WITH(VC_REF_FLAG,f,text,r)
 THEN GOES_WITH(VD_REFERENCE_ENTITY,name,f);
law VD_E0_END := IF THIS(VD_E0_ROWS,NIL)
 THEN THIS(VD_E0_COMPLETE,NIL);
law VD_E0_HEAD := IF THIS(VD_E0_ROWS,CONS(MEMBER(name,f),tail)), GOES_WITH(VD_REFERENCE_ENTITY,name,f), THIS(VD_E0_COMPLETE,tail)
 THEN THIS(VD_E0_COMPLETE,CONS(MEMBER(name,f),tail));
law VD_REFERENCE_GENESIS_INPUTS := IF THIS(VD_INPUT_E0,OBJECT(rows)), THIS(VD_E0_COMPLETE,rows), THIS(VC_INPUT_KAPPA,k), GOES_WITH(VC_REF_FLAG,k,text,r)
 THEN THIS(VD_REFERENCE_GENESIS_INPUTS,k,rows);
law VD_REFERENCE_GENESIS_THIS := IF THIS(VD_REFERENCE_GENESIS_INPUTS,k,rows), GOES_WITH(VD_REFERENCE_ENTITY,name,f)
 THEN GOES_WITH(VD_REFERENCE_GENESIS_FIELD,f,THIS);
law VD_EMPTY_SCAN := IF THIS(VD_REFERENCE_GENESIS_INPUTS,k,rows), GOES_WITH(VC_REF_FLAG,f,text,r)
 THEN THIS(VD_EMPTY_SCAN,f,rows);
law VD_EMPTY_COMPARE := IF THIS(VD_EMPTY_SCAN,f,CONS(MEMBER(name,g),tail))
 THEN THIS(VD_DIFFER_REQUEST,f,g);
law VD_EMPTY_ADVANCE := IF THIS(VD_EMPTY_SCAN,f,CONS(MEMBER(name,g),tail)), GOES_WITH(VD_DIFFER,f,g)
 THEN THIS(VD_EMPTY_SCAN,f,tail);
law VD_REFERENCE_GENESIS_NO := IF THIS(VD_EMPTY_SCAN,f,NIL)
 THEN GOES_WITH(VD_REFERENCE_GENESIS_FIELD,f,NO);
law VD_INITIAL_SUFFIX_END := IF THIS(VC_ROWS,NIL)
 THEN THIS(VD_INITIAL_SUFFIX,NIL);
law VD_INITIAL_SUFFIX_HEAD := IF THIS(VC_ROWS,CONS(ARRAY(CONS(f,CONS(text,NIL))),tail)), GOES_WITH(VC_READING,text,r), GOES_WITH(VD_REFERENCE_GENESIS_FIELD,f,r), THIS(VD_INITIAL_SUFFIX,tail)
 THEN THIS(VD_INITIAL_SUFFIX,CONS(ARRAY(CONS(f,CONS(text,NIL))),tail));
law VD_INITIAL_FIELD_MATCH := IF THIS(VC_INPUT_FIELD,ARRAY(rows)), THIS(VD_INITIAL_SUFFIX,rows), THIS(VC_REFERENCE_FULL_LENGTH), THIS(VC_ALL_ANCHORS_COVERED,ALL_ORDERED_HARDWARE_FACES)
 THEN THIS(VD_INITIAL_FIELD_MATCH);
law VD_INITIAL_ENTITIES_MATCH := IF THIS(VD_INPUT_ENTITIES,OBJECT(rows)), THIS(VD_INPUT_E0,OBJECT(rows)), THIS(VD_REFERENCE_GENESIS_INPUTS,k,rows)
 THEN THIS(VD_INITIAL_ENTITIES_MATCH);
law VD_INITIAL_CONTENT_MATCH := IF THIS(VD_INITIAL_FIELD_MATCH), THIS(VD_INITIAL_ENTITIES_MATCH)
 THEN THIS(VD_INITIAL_CONTENT_MATCH);
law VD_GENESIS_FIELD := IF THIS(VD_INITIAL_CONTENT_MATCH), GOES_WITH(VC_FLAG_MAP,c,reference,f), GOES_WITH(VD_REFERENCE_GENESIS_FIELD,reference,r)
 THEN GOES_WITH(VD_GENESIS_FIELD,c,f,r);
law VD_GENESIS_ENTITY := IF THIS(VD_INITIAL_CONTENT_MATCH), GOES_WITH(VD_REFERENCE_ENTITY,name,reference), GOES_WITH(VC_FLAG_MAP,c,reference,f)
 THEN GOES_WITH(VD_GENESIS_ENTITY,c,name,f);

// Preserve the full selected object, including the reading. Geometric
// selection below is not full offered-object membership or a DECISION.
law VD_SELECTED_REFERENCE_ENTITY := IF THIS(VD_INPUT_ENTITY,name), GOES_WITH(VD_REFERENCE_ENTITY,name,f), THIS(VD_INITIAL_CONTENT_MATCH)
 THEN GOES_WITH(VD_SELECTED_REFERENCE_ENTITY,name,f);
law VD_SELECTED_ENTITY := IF THIS(VD_INPUT_ENTITY,name), GOES_WITH(VD_GENESIS_ENTITY,c,name,f)
 THEN GOES_WITH(VD_SELECTED_ENTITY,c,name,f);
law VD_SELECTED_OBJECT := IF THIS(VD_INPUT_LIFT,OBJECT(CONS(MEMBER("from",f),CONS(MEMBER("reading",reading),CONS(MEMBER("to",h),CONS(MEMBER("via",g),NIL))))))
 THEN GOES_WITH(VD_SELECTED_OBJECT,LIFT(f,g,h),reading);
law VD_REFERENCE_TARGET_SITE := IF THIS(VD_INPUT_KIND,"site"), THIS(VD_INPUT_TARGET,target), THIS(VC_REF_SITE,target)
 THEN GOES_WITH(VD_REFERENCE_TARGET,SITE,target);
law VD_REFERENCE_TARGET_EDGE := IF THIS(VD_INPUT_KIND,"edge"), THIS(VD_INPUT_TARGET,target), THIS(VC_REF_EDGE,target)
 THEN GOES_WITH(VD_REFERENCE_TARGET,EDGE,target);
law VD_REFERENCE_TARGET_TRIAD := IF THIS(VD_INPUT_KIND,"triad"), THIS(VD_INPUT_TARGET,target), THIS(VC_REF_TRIAD,target)
 THEN GOES_WITH(VD_REFERENCE_TARGET,TRIAD,target);
law VD_TARGET_SITE := IF GOES_WITH(VD_REFERENCE_TARGET,SITE,reference), GOES_WITH(VC_CORRESPONDENCE_COMPLETE,CORRESPONDENCE(k,m),proof), GOES_WITH(VC_ASSIGN_SITE,m,reference,target)
 THEN GOES_WITH(VD_TARGET,CORRESPONDENCE(k,m),SITE,target);
law VD_TARGET_EDGE := IF GOES_WITH(VD_REFERENCE_TARGET,EDGE,reference), GOES_WITH(VC_CORRESPONDENCE_COMPLETE,CORRESPONDENCE(k,m),proof), GOES_WITH(VC_ASSIGN_EDGE,m,reference,target)
 THEN GOES_WITH(VD_TARGET,CORRESPONDENCE(k,m),EDGE,target);
law VD_TARGET_TRIAD := IF GOES_WITH(VD_REFERENCE_TARGET,TRIAD,reference), GOES_WITH(VC_CORRESPONDENCE_COMPLETE,CORRESPONDENCE(k,m),proof), GOES_WITH(VC_ASSIGN_TRIAD,m,reference,target)
 THEN GOES_WITH(VD_TARGET,CORRESPONDENCE(k,m),TRIAD,target);

// The retained displacement definitions are evaluated independently on the
// reference incidence and hardware incidence. No selected lift is a premise
// of the geometric offer relation.
law VD_REFERENCE_SITE_LIFT := IF GOES_WITH(VD_SELECTED_REFERENCE_ENTITY,name,f), GOES_WITH(VC_REF_FLAG_PARTS,f,s,e,t), GOES_WITH(VD_REFERENCE_TARGET,SITE,d), GOES_WITH(VC_REF_MOVE,DELTA,g,h), GOES_WITH(VC_REF_FLAG_PARTS,g,s,q,u), GOES_WITH(VC_REF_FLAG_PARTS,h,d,q,u)
 THEN THIS(VD_REFERENCE_LIFT_GEOMETRY,LIFT(f,g,h));
law VD_REFERENCE_EDGE_LIFT := IF GOES_WITH(VD_SELECTED_REFERENCE_ENTITY,name,f), GOES_WITH(VD_REFERENCE_TARGET,EDGE,e), GOES_WITH(VC_REF_MOVE,GAMMA,f,h), GOES_WITH(VC_REF_FLAG_PARTS,h,s,e,t)
 THEN THIS(VD_REFERENCE_LIFT_GEOMETRY,LIFT(f,f,h));
law VD_REFERENCE_TRIAD_LIFT := IF GOES_WITH(VD_SELECTED_REFERENCE_ENTITY,name,f), GOES_WITH(VC_REF_FLAG_PARTS,f,s,e,t), GOES_WITH(VD_REFERENCE_TARGET,TRIAD,u), GOES_WITH(VC_REF_MOVE,TAU,g,h), GOES_WITH(VC_REF_FLAG_PARTS,g,v,q,t), GOES_WITH(VC_REF_FLAG_PARTS,h,v,q,u)
 THEN THIS(VD_REFERENCE_LIFT_GEOMETRY,LIFT(f,g,h));
law VD_HARDWARE_SITE_LIFT_AB := IF GOES_WITH(VD_SELECTED_ENTITY,c,name,TOGETHER_ALONE(v,e,t)), GOES_WITH(VD_TARGET,c,SITE,d), GOES_WITH(EDGE_IN_TRIAD,TOGETHER_ALONE(v,d),u)
 THEN GOES_WITH(VD_LIFT_GEOMETRY,c,LIFT(TOGETHER_ALONE(v,e,t),TOGETHER_ALONE(v,TOGETHER_ALONE(v,d),u),TOGETHER_ALONE(d,TOGETHER_ALONE(v,d),u)));
law VD_HARDWARE_SITE_LIFT_BA := IF GOES_WITH(VD_SELECTED_ENTITY,c,name,TOGETHER_ALONE(v,e,t)), GOES_WITH(VD_TARGET,c,SITE,d), GOES_WITH(EDGE_IN_TRIAD,TOGETHER_ALONE(d,v),u)
 THEN GOES_WITH(VD_LIFT_GEOMETRY,c,LIFT(TOGETHER_ALONE(v,e,t),TOGETHER_ALONE(v,TOGETHER_ALONE(d,v),u),TOGETHER_ALONE(d,TOGETHER_ALONE(d,v),u)));
law VD_HARDWARE_EDGE_LIFT := IF GOES_WITH(VD_SELECTED_ENTITY,c,name,f), GOES_WITH(VD_TARGET,c,EDGE,e), GOES_WITH(GAMMA,f,TOGETHER_ALONE(v,e,t))
 THEN GOES_WITH(VD_LIFT_GEOMETRY,c,LIFT(f,f,TOGETHER_ALONE(v,e,t)));
law VD_HARDWARE_TRIAD_LIFT := IF GOES_WITH(VD_SELECTED_ENTITY,c,name,TOGETHER_ALONE(v,e,t)), GOES_WITH(VD_TARGET,c,TRIAD,u), GOES_WITH(TAU,TOGETHER_ALONE(s,q,t),TOGETHER_ALONE(s,q,u))
 THEN GOES_WITH(VD_LIFT_GEOMETRY,c,LIFT(TOGETHER_ALONE(v,e,t),TOGETHER_ALONE(s,q,t),TOGETHER_ALONE(s,q,u)));
law VD_LIFT_TRANSPORT := IF THIS(VD_REFERENCE_LIFT_GEOMETRY,LIFT(f,g,h)), GOES_WITH(VC_FLAG_MAP,c,f,x), GOES_WITH(VC_FLAG_MAP,c,g,y), GOES_WITH(VC_FLAG_MAP,c,h,z), GOES_WITH(VD_LIFT_GEOMETRY,c,LIFT(x,y,z))
 THEN GOES_WITH(VD_REF_LIFT_TRANSPORT,c,LIFT(f,g,h),LIFT(x,y,z));
law VD_SELECTED_REFERENCE_GEOMETRY := IF GOES_WITH(VD_SELECTED_OBJECT,l,reading), THIS(VD_REFERENCE_LIFT_GEOMETRY,l)
 THEN THIS(VD_SELECTED_REFERENCE_GEOMETRY,l);
law VD_SELECTED_GEOMETRY := IF THIS(VD_SELECTED_REFERENCE_GEOMETRY,l), GOES_WITH(VD_REF_LIFT_TRANSPORT,c,l,hardwareLift)
 THEN GOES_WITH(VD_SELECTED_GEOMETRY,c,hardwareLift);

// Complete geometric offer sets. SITE has the two incident-triad completions;
// TRIAD has the two shared-edge endpoint completions; EDGE has the GAMMA
// completion. These are the retained proposal_basis.mal contacts. BOTH orders
// of a two-element set may be witnessed; neither order chooses a lift.
law VD_REFERENCE_OFFER_ONE := IF THIS(VD_INPUT_KIND,"edge"), THIS(VD_REFERENCE_LIFT_GEOMETRY,l)
 THEN THIS(VD_REFERENCE_OFFER_SET,ONE_OFFER(l));
law VD_REFERENCE_OFFER_SITE_TWO := IF THIS(VD_INPUT_KIND,"site"), THIS(VD_REFERENCE_LIFT_GEOMETRY,LIFT(f,g,h)), THIS(VD_REFERENCE_LIFT_GEOMETRY,LIFT(f,i,j)), GOES_WITH(VC_REF_MOVE,TAU,g,i), GOES_WITH(VC_REF_MOVE,TAU,h,j)
 THEN THIS(VD_REFERENCE_OFFER_SET,TWO_OFFERS(LIFT(f,g,h),LIFT(f,i,j)));
law VD_REFERENCE_OFFER_TRIAD_TWO := IF THIS(VD_INPUT_KIND,"triad"), THIS(VD_REFERENCE_LIFT_GEOMETRY,LIFT(f,g,h)), THIS(VD_REFERENCE_LIFT_GEOMETRY,LIFT(f,i,j)), GOES_WITH(VC_REF_MOVE,DELTA,g,i), GOES_WITH(VC_REF_MOVE,DELTA,h,j)
 THEN THIS(VD_REFERENCE_OFFER_SET,TWO_OFFERS(LIFT(f,g,h),LIFT(f,i,j)));
law VD_HARDWARE_OFFER_ONE := IF THIS(VD_INPUT_KIND,"edge"), GOES_WITH(VD_LIFT_GEOMETRY,c,l)
 THEN GOES_WITH(VD_HARDWARE_OFFER_SET,c,ONE_OFFER(l));
law VD_HARDWARE_OFFER_SITE_TWO := IF THIS(VD_INPUT_KIND,"site"), GOES_WITH(VD_LIFT_GEOMETRY,c,LIFT(f,g,h)), GOES_WITH(VD_LIFT_GEOMETRY,c,LIFT(f,i,j)), GOES_WITH(TAU,g,i), GOES_WITH(TAU,h,j)
 THEN GOES_WITH(VD_HARDWARE_OFFER_SET,c,TWO_OFFERS(LIFT(f,g,h),LIFT(f,i,j)));
law VD_HARDWARE_OFFER_TRIAD_TWO := IF THIS(VD_INPUT_KIND,"triad"), GOES_WITH(VD_LIFT_GEOMETRY,c,LIFT(f,g,h)), GOES_WITH(VD_LIFT_GEOMETRY,c,LIFT(f,i,j)), GOES_WITH(DELTA,g,i), GOES_WITH(DELTA,h,j)
 THEN GOES_WITH(VD_HARDWARE_OFFER_SET,c,TWO_OFFERS(LIFT(f,g,h),LIFT(f,i,j)));
law VD_OFFER_ONE_TRANSPORT := IF THIS(VD_REFERENCE_OFFER_SET,ONE_OFFER(r)), GOES_WITH(VD_HARDWARE_OFFER_SET,c,ONE_OFFER(h)), GOES_WITH(VD_REF_LIFT_TRANSPORT,c,r,h)
 THEN THIS(VD_ALL_LIFTS_TRANSPORT_COMPLETE,c);
law VD_OFFER_TWO_TRANSPORT := IF THIS(VD_REFERENCE_OFFER_SET,TWO_OFFERS(a,b)), GOES_WITH(VD_HARDWARE_OFFER_SET,c,TWO_OFFERS(x,y)), GOES_WITH(VD_REF_LIFT_TRANSPORT,c,a,x), GOES_WITH(VD_REF_LIFT_TRANSPORT,c,b,y)
 THEN THIS(VD_ALL_LIFTS_TRANSPORT_COMPLETE,c);

// Canonical observer order is the already-bound reference flag sequence,
// filtered by VIA membership. It is encoding only; every offered lift remains.
law VD_REFERENCE_OFFER_MEMBER_ONE := IF THIS(VD_REFERENCE_OFFER_SET,ONE_OFFER(l))
 THEN GOES_WITH(VD_REFERENCE_OFFER_MEMBER,ONE_OFFER(l),l);
law VD_REFERENCE_OFFER_MEMBER_TWO_A := IF THIS(VD_REFERENCE_OFFER_SET,TWO_OFFERS(a,b))
 THEN GOES_WITH(VD_REFERENCE_OFFER_MEMBER,TWO_OFFERS(a,b),a);
law VD_REFERENCE_OFFER_MEMBER_TWO_B := IF THIS(VD_REFERENCE_OFFER_SET,TWO_OFFERS(a,b))
 THEN GOES_WITH(VD_REFERENCE_OFFER_MEMBER,TWO_OFFERS(a,b),b);
law VD_REFERENCE_OFFER_COMPARE := IF GOES_WITH(VD_REFERENCE_OFFER_MEMBER,set,LIFT(f,g,h)), GOES_WITH(VC_REF_FLAG,x,text,r)
 THEN THIS(VD_DIFFER_REQUEST,x,g);
law VD_REFERENCE_OFFER_FILTER_END := IF THIS(VD_REFERENCE_OFFER_SET,set), THIS(VC_ROWS,NIL)
 THEN GOES_WITH(VD_REFERENCE_OFFER_FILTER,set,NIL,NIL);
law VD_REFERENCE_OFFER_FILTER_INCLUDE := IF THIS(VC_ROWS,CONS(ARRAY(CONS(g,CONS(text,NIL))),tail)), GOES_WITH(VD_REFERENCE_OFFER_MEMBER,set,LIFT(f,g,h)), GOES_WITH(VD_REFERENCE_OFFER_FILTER,set,tail,rest)
 THEN GOES_WITH(VD_REFERENCE_OFFER_FILTER,set,CONS(ARRAY(CONS(g,CONS(text,NIL))),tail),CONS(LIFT(f,g,h),rest));
law VD_REFERENCE_OFFER_FILTER_SKIP_ONE := IF THIS(VC_ROWS,CONS(ARRAY(CONS(x,CONS(text,NIL))),tail)), THIS(VD_REFERENCE_OFFER_SET,ONE_OFFER(LIFT(f,g,h))), GOES_WITH(VD_DIFFER,x,g), GOES_WITH(VD_REFERENCE_OFFER_FILTER,ONE_OFFER(LIFT(f,g,h)),tail,rest)
 THEN GOES_WITH(VD_REFERENCE_OFFER_FILTER,ONE_OFFER(LIFT(f,g,h)),CONS(ARRAY(CONS(x,CONS(text,NIL))),tail),rest);
law VD_REFERENCE_OFFER_FILTER_SKIP_TWO := IF THIS(VC_ROWS,CONS(ARRAY(CONS(x,CONS(text,NIL))),tail)), THIS(VD_REFERENCE_OFFER_SET,TWO_OFFERS(LIFT(f,g,h),LIFT(f,i,j))), GOES_WITH(VD_DIFFER,x,g), GOES_WITH(VD_DIFFER,x,i), GOES_WITH(VD_REFERENCE_OFFER_FILTER,TWO_OFFERS(LIFT(f,g,h),LIFT(f,i,j)),tail,rest)
 THEN GOES_WITH(VD_REFERENCE_OFFER_FILTER,TWO_OFFERS(LIFT(f,g,h),LIFT(f,i,j)),CONS(ARRAY(CONS(x,CONS(text,NIL))),tail),rest);
law VD_COMPLETE_REFERENCE_LIFTS := IF THIS(VC_INPUT_FIELD,ARRAY(rows)), GOES_WITH(VD_REFERENCE_OFFER_FILTER,set,rows,lifts), THIS(VD_INITIAL_CONTENT_MATCH)
 THEN THIS(VD_COMPLETE_REFERENCE_LIFTS,ARRAY(lifts));
law VD_REFERENCE_LIFT_ROWS := IF THIS(VD_COMPLETE_REFERENCE_LIFTS,ARRAY(lifts))
 THEN THIS(VD_REFERENCE_LIFT_ROWS,lifts);
law VD_REFERENCE_LIFT_TAIL := IF THIS(VD_REFERENCE_LIFT_ROWS,CONS(l,tail))
 THEN THIS(VD_REFERENCE_LIFT_ROWS,tail);

// Source-owned displacement, not a supplied successor. Reference and hardware
// fields independently set FROM to NO, TO to THIS and retain every other flag.
// Complete transport is checked below before the fixture becomes frame input.
law VD_REFERENCE_CANDIDATE_FROM := IF THIS(VD_SELECTED_REFERENCE_GEOMETRY,LIFT(f,g,h)), GOES_WITH(VD_REFERENCE_GENESIS_FIELD,f,r)
 THEN GOES_WITH(VD_REFERENCE_CANDIDATE_FIELD,f,NO);
law VD_REFERENCE_CANDIDATE_TO := IF THIS(VD_SELECTED_REFERENCE_GEOMETRY,LIFT(f,g,h)), GOES_WITH(VD_REFERENCE_GENESIS_FIELD,h,r)
 THEN GOES_WITH(VD_REFERENCE_CANDIDATE_FIELD,h,THIS);
law VD_REFERENCE_CANDIDATE_COMPARE_FROM := IF THIS(VD_SELECTED_REFERENCE_GEOMETRY,LIFT(f,g,h)), GOES_WITH(VD_REFERENCE_GENESIS_FIELD,x,r)
 THEN THIS(VD_DIFFER_REQUEST,x,f);
law VD_REFERENCE_CANDIDATE_COMPARE_TO := IF THIS(VD_SELECTED_REFERENCE_GEOMETRY,LIFT(f,g,h)), GOES_WITH(VD_REFERENCE_GENESIS_FIELD,x,r)
 THEN THIS(VD_DIFFER_REQUEST,x,h);
law VD_REFERENCE_CANDIDATE_RETAIN := IF THIS(VD_SELECTED_REFERENCE_GEOMETRY,LIFT(f,g,h)), GOES_WITH(VD_REFERENCE_GENESIS_FIELD,x,r), GOES_WITH(VD_DIFFER,x,f), GOES_WITH(VD_DIFFER,x,h)
 THEN GOES_WITH(VD_REFERENCE_CANDIDATE_FIELD,x,r);
law VD_CANDIDATE_FROM := IF GOES_WITH(VD_SELECTED_GEOMETRY,c,LIFT(f,g,h)), GOES_WITH(VD_GENESIS_FIELD,c,f,r)
 THEN GOES_WITH(VD_CANDIDATE_FIELD,c,f,NO);
law VD_CANDIDATE_TO := IF GOES_WITH(VD_SELECTED_GEOMETRY,c,LIFT(f,g,h)), GOES_WITH(VD_GENESIS_FIELD,c,h,r)
 THEN GOES_WITH(VD_CANDIDATE_FIELD,c,h,THIS);
law VD_CANDIDATE_COMPARE_FROM := IF GOES_WITH(VD_SELECTED_GEOMETRY,c,LIFT(f,g,h)), GOES_WITH(VD_GENESIS_FIELD,c,x,r)
 THEN THIS(VD_DIFFER_REQUEST,x,f);
law VD_CANDIDATE_COMPARE_TO := IF GOES_WITH(VD_SELECTED_GEOMETRY,c,LIFT(f,g,h)), GOES_WITH(VD_GENESIS_FIELD,c,x,r)
 THEN THIS(VD_DIFFER_REQUEST,x,h);
law VD_CANDIDATE_RETAIN := IF GOES_WITH(VD_SELECTED_GEOMETRY,c,LIFT(f,g,h)), GOES_WITH(VD_GENESIS_FIELD,c,x,r), GOES_WITH(VD_DIFFER,x,f), GOES_WITH(VD_DIFFER,x,h)
 THEN GOES_WITH(VD_CANDIDATE_FIELD,c,x,r);
law VD_SELECTED_SUCCESSOR_ENTITY := IF GOES_WITH(VD_SELECTED_ENTITY,c,name,f), GOES_WITH(VD_SELECTED_GEOMETRY,c,LIFT(f,g,h))
 THEN GOES_WITH(VD_CANDIDATE_ENTITY,c,name,h);
law VD_OTHER_ENTITY_COMPARE := IF GOES_WITH(VD_GENESIS_ENTITY,c,name,f), THIS(VD_INPUT_ENTITY,selected)
 THEN THIS(VD_DIFFER_REQUEST,name,selected);
law VD_OTHER_SUCCESSOR_ENTITY := IF GOES_WITH(VD_GENESIS_ENTITY,c,name,f), THIS(VD_INPUT_ENTITY,selected), GOES_WITH(VD_DIFFER,name,selected)
 THEN GOES_WITH(VD_CANDIDATE_ENTITY,c,name,f);

// PROPOSE evaluates every completing lift's field and gluing reading. This
// mirrors offered_readings/proposal_counts of the retained007 realization;
// it is not a canonical fabric payload admission or STEP_FABRIC_RETURN.
law VD_OFFERED_FROM := IF GOES_WITH(VD_LIFT_GEOMETRY,c,LIFT(f,g,h)), GOES_WITH(VD_GENESIS_FIELD,c,f,r)
 THEN GOES_WITH(VD_OFFERED_FIELD,c,LIFT(f,g,h),f,NO);
law VD_OFFERED_TO := IF GOES_WITH(VD_LIFT_GEOMETRY,c,LIFT(f,g,h)), GOES_WITH(VD_GENESIS_FIELD,c,h,r)
 THEN GOES_WITH(VD_OFFERED_FIELD,c,LIFT(f,g,h),h,THIS);
law VD_OFFERED_COMPARE_FROM := IF GOES_WITH(VD_LIFT_GEOMETRY,c,LIFT(f,g,h)), GOES_WITH(VD_GENESIS_FIELD,c,x,r)
 THEN THIS(VD_DIFFER_REQUEST,x,f);
law VD_OFFERED_COMPARE_TO := IF GOES_WITH(VD_LIFT_GEOMETRY,c,LIFT(f,g,h)), GOES_WITH(VD_GENESIS_FIELD,c,x,r)
 THEN THIS(VD_DIFFER_REQUEST,x,h);
law VD_OFFERED_RETAIN := IF GOES_WITH(VD_LIFT_GEOMETRY,c,LIFT(f,g,h)), GOES_WITH(VD_GENESIS_FIELD,c,x,r), GOES_WITH(VD_DIFFER,x,f), GOES_WITH(VD_DIFFER,x,h)
 THEN GOES_WITH(VD_OFFERED_FIELD,c,LIFT(f,g,h),x,r);
law VD_GENESIS_GLUING := IF GOES_WITH(PAIR,f,g), GOES_WITH(VD_GENESIS_FIELD,c,f,a), GOES_WITH(VD_GENESIS_FIELD,c,g,b), GOES_WITH(JTP_SAME_RESULT,MARKER(a),MARKER(b),word,reading)
 THEN GOES_WITH(VD_GENESIS_GLUING,c,f,g,reading);
law VD_OFFERED_GLUING := IF GOES_WITH(PAIR,f,g), GOES_WITH(VD_OFFERED_FIELD,c,l,f,a), GOES_WITH(VD_OFFERED_FIELD,c,l,g,b), GOES_WITH(JTP_SAME_RESULT,MARKER(a),MARKER(b),word,reading)
 THEN GOES_WITH(VD_OFFERED_GLUING,c,l,f,g,reading);
law VD_OFFERED_SAME_SAME := IF GOES_WITH(VD_GENESIS_GLUING,c,f,g,SAME), GOES_WITH(VD_OFFERED_GLUING,c,l,f,g,SAME)
 THEN GOES_WITH(VD_OFFERED_CHANGE,c,l,f,g,UNCHANGED);
law VD_OFFERED_SAME_DIFFER := IF GOES_WITH(VD_GENESIS_GLUING,c,f,g,SAME), GOES_WITH(VD_OFFERED_GLUING,c,l,f,g,NOT_SAME)
 THEN GOES_WITH(VD_OFFERED_CHANGE,c,l,f,g,OPENED);
law VD_OFFERED_DIFFER_SAME := IF GOES_WITH(VD_GENESIS_GLUING,c,f,g,NOT_SAME), GOES_WITH(VD_OFFERED_GLUING,c,l,f,g,SAME)
 THEN GOES_WITH(VD_OFFERED_CHANGE,c,l,f,g,DISCHARGED);
law VD_OFFERED_DIFFER_DIFFER := IF GOES_WITH(VD_GENESIS_GLUING,c,f,g,NOT_SAME), GOES_WITH(VD_OFFERED_GLUING,c,l,f,g,NOT_SAME)
 THEN GOES_WITH(VD_OFFERED_CHANGE,c,l,f,g,RETAINED_WALL);

// The source-checked018 witness array supplies only complete720PAIR identity
// coverage. Its readings are NOT operands in these counts. One linear fold
// counts every unordered overlap once, with no reverse-direction duplicate.
law VD_OFFERED_COUNT_END := IF GOES_WITH(VD_LIFT_GEOMETRY,c,l), GOES_WITH(GSC_ROWS,CURRENT_WITNESS,NIL)
 THEN GOES_WITH(VD_OFFERED_COUNT_SUFFIX,c,l,NIL,COUNTS(EMPTY_COUNT,EMPTY_COUNT,EMPTY_COUNT));
law VD_OFFERED_COUNT_UNCHANGED := IF GOES_WITH(GSC_ROW_SPAN,CURRENT_WITNESS,ONE,CONS(row,tail),tail), GOES_WITH(GSC_ROW_KEY,CURRENT_WITNESS,row,TOGETHER_ALONE(f,g)), GOES_WITH(VD_OFFERED_CHANGE,c,l,f,g,UNCHANGED), GOES_WITH(VD_OFFERED_COUNT_SUFFIX,c,l,tail,counts)
 THEN GOES_WITH(VD_OFFERED_COUNT_SUFFIX,c,l,CONS(row,tail),counts);
law VD_OFFERED_COUNT_OPENED := IF GOES_WITH(GSC_ROW_SPAN,CURRENT_WITNESS,ONE,CONS(row,tail),tail), GOES_WITH(GSC_ROW_KEY,CURRENT_WITNESS,row,TOGETHER_ALONE(f,g)), GOES_WITH(VD_OFFERED_CHANGE,c,l,f,g,OPENED), GOES_WITH(VD_OFFERED_COUNT_SUFFIX,c,l,tail,COUNTS(d,o,w))
 THEN GOES_WITH(VD_OFFERED_COUNT_SUFFIX,c,l,CONS(row,tail),COUNTS(d,NEXT_COUNT(o),NEXT_COUNT(w)));
law VD_OFFERED_COUNT_DISCHARGED := IF GOES_WITH(GSC_ROW_SPAN,CURRENT_WITNESS,ONE,CONS(row,tail),tail), GOES_WITH(GSC_ROW_KEY,CURRENT_WITNESS,row,TOGETHER_ALONE(f,g)), GOES_WITH(VD_OFFERED_CHANGE,c,l,f,g,DISCHARGED), GOES_WITH(VD_OFFERED_COUNT_SUFFIX,c,l,tail,COUNTS(d,o,w))
 THEN GOES_WITH(VD_OFFERED_COUNT_SUFFIX,c,l,CONS(row,tail),COUNTS(NEXT_COUNT(d),o,w));
law VD_OFFERED_COUNT_RETAINED := IF GOES_WITH(GSC_ROW_SPAN,CURRENT_WITNESS,ONE,CONS(row,tail),tail), GOES_WITH(GSC_ROW_KEY,CURRENT_WITNESS,row,TOGETHER_ALONE(f,g)), GOES_WITH(VD_OFFERED_CHANGE,c,l,f,g,RETAINED_WALL), GOES_WITH(VD_OFFERED_COUNT_SUFFIX,c,l,tail,COUNTS(d,o,w))
 THEN GOES_WITH(VD_OFFERED_COUNT_SUFFIX,c,l,CONS(row,tail),COUNTS(d,o,NEXT_COUNT(w)));
law VD_OFFERED_COUNTS := IF THIS(GSC_WITNESS_INPUT,ARRAY(rows)), GOES_WITH(GSC_COMPLETE,CURRENT_WITNESS,ARRAY(rows)), GOES_WITH(VD_OFFERED_COUNT_SUFFIX,c,l,rows,counts), THIS(VD_ALL_LIFTS_TRANSPORT_COMPLETE,c)
 THEN GOES_WITH(VD_OFFERED_COUNTS,c,l,counts);

// Decimal observation encoding of counts, not order on identifiers. This is
// the retained proposal_reading_encoding.mal algorithm with private names.
@propose seed VD_DECIMAL_DIGIT_SUCCESSION := {
 GOES_WITH(VD_DIGIT_SUCCESSOR,B48,B49), GOES_WITH(VD_DIGIT_SUCCESSOR,B49,B50),
 GOES_WITH(VD_DIGIT_SUCCESSOR,B50,B51), GOES_WITH(VD_DIGIT_SUCCESSOR,B51,B52),
 GOES_WITH(VD_DIGIT_SUCCESSOR,B52,B53), GOES_WITH(VD_DIGIT_SUCCESSOR,B53,B54),
 GOES_WITH(VD_DIGIT_SUCCESSOR,B54,B55), GOES_WITH(VD_DIGIT_SUCCESSOR,B55,B56),
 GOES_WITH(VD_DIGIT_SUCCESSOR,B56,B57)
};
law VD_COUNT_REQUEST_D := IF GOES_WITH(VD_OFFERED_COUNTS,c,l,COUNTS(d,o,w))
 THEN THIS(VD_COUNT_ENCODING_REQUEST,d);
law VD_COUNT_REQUEST_O := IF GOES_WITH(VD_OFFERED_COUNTS,c,l,COUNTS(d,o,w))
 THEN THIS(VD_COUNT_ENCODING_REQUEST,o);
law VD_COUNT_REQUEST_W := IF GOES_WITH(VD_OFFERED_COUNTS,c,l,COUNTS(d,o,w))
 THEN THIS(VD_COUNT_ENCODING_REQUEST,w);
law VD_COUNT_ENCODING_EMPTY := IF THIS(VD_COUNT_ENCODING_REQUEST,EMPTY_COUNT)
 THEN GOES_WITH(VD_COUNT_ENCODING,EMPTY_COUNT,CONS(B48,NIL));
law VD_COUNT_ENCODING_DESCEND := IF THIS(VD_COUNT_ENCODING_REQUEST,NEXT_COUNT(n))
 THEN THIS(VD_COUNT_ENCODING_REQUEST,n);
law VD_COUNT_ENCODING_INCREMENT := IF THIS(VD_COUNT_ENCODING_REQUEST,NEXT_COUNT(n)), GOES_WITH(VD_COUNT_ENCODING,n,bytes)
 THEN THIS(VD_DECIMAL_INCREMENT_REQUEST,bytes);
law VD_DECIMAL_INCREMENT_TAIL := IF THIS(VD_DECIMAL_INCREMENT_REQUEST,CONS(d,t))
 THEN THIS(VD_DECIMAL_INCREMENT_REQUEST,t);
law VD_DECIMAL_INCREMENT_END := IF THIS(VD_DECIMAL_INCREMENT_REQUEST,NIL)
 THEN GOES_WITH(VD_DECIMAL_INCREMENT,NIL,NIL,CARRY);
law VD_DECIMAL_INCREMENT_STABLE := IF THIS(VD_DECIMAL_INCREMENT_REQUEST,CONS(d,t)), GOES_WITH(VD_DECIMAL_INCREMENT,t,u,NO_CARRY)
 THEN GOES_WITH(VD_DECIMAL_INCREMENT,CONS(d,t),CONS(d,u),NO_CARRY);
law VD_DECIMAL_INCREMENT_DIGIT := IF THIS(VD_DECIMAL_INCREMENT_REQUEST,CONS(d,t)), GOES_WITH(VD_DECIMAL_INCREMENT,t,u,CARRY), GOES_WITH(VD_DIGIT_SUCCESSOR,d,e)
 THEN GOES_WITH(VD_DECIMAL_INCREMENT,CONS(d,t),CONS(e,u),NO_CARRY);
law VD_DECIMAL_INCREMENT_CARRY := IF THIS(VD_DECIMAL_INCREMENT_REQUEST,CONS(B57,t)), GOES_WITH(VD_DECIMAL_INCREMENT,t,u,CARRY)
 THEN GOES_WITH(VD_DECIMAL_INCREMENT,CONS(B57,t),CONS(B48,u),CARRY);
law VD_COUNT_ENCODING_NEXT := IF THIS(VD_COUNT_ENCODING_REQUEST,NEXT_COUNT(n)), GOES_WITH(VD_COUNT_ENCODING,n,b), GOES_WITH(VD_DECIMAL_INCREMENT,b,c,NO_CARRY)
 THEN GOES_WITH(VD_COUNT_ENCODING,NEXT_COUNT(n),c);
law VD_COUNT_ENCODING_GROW := IF THIS(VD_COUNT_ENCODING_REQUEST,NEXT_COUNT(n)), GOES_WITH(VD_COUNT_ENCODING,n,b), GOES_WITH(VD_DECIMAL_INCREMENT,b,c,CARRY)
 THEN GOES_WITH(VD_COUNT_ENCODING,NEXT_COUNT(n),CONS(B49,c));
law VD_OFFERED_READING := IF GOES_WITH(VD_OFFERED_COUNTS,c,l,COUNTS(d,o,w)), GOES_WITH(VD_COUNT_ENCODING,d,db), GOES_WITH(VD_COUNT_ENCODING,o,ob), GOES_WITH(VD_COUNT_ENCODING,w,wb)
 THEN GOES_WITH(VD_OFFERED_READING,c,l,OBJECT(CONS(MEMBER("discharged",JSON_INTEGER(TEXT(db))),CONS(MEMBER("opened",JSON_INTEGER(TEXT(ob))),CONS(MEMBER("walls_after",JSON_INTEGER(TEXT(wb))),NIL)))));

// One complete per-context fold checks BOTH fields at all480flags. Bijection
// and positive move commutation were already discharged by VC_COMPLETE.
law VD_FIELD_CHECK_END := IF GOES_WITH(VD_SELECTED_GEOMETRY,c,l), THIS(VC_ROWS,NIL)
 THEN GOES_WITH(VD_FIELD_CHECK_SUFFIX,c,NIL);
law VD_FIELD_CHECK_HEAD := IF THIS(VC_ROWS,CONS(ARRAY(CONS(reference,CONS(text,NIL))),tail)), GOES_WITH(VC_FLAG_MAP,c,reference,f), GOES_WITH(VD_REFERENCE_GENESIS_FIELD,reference,a), GOES_WITH(VD_GENESIS_FIELD,c,f,a), GOES_WITH(VD_REFERENCE_CANDIDATE_FIELD,reference,b), GOES_WITH(VD_CANDIDATE_FIELD,c,f,b), GOES_WITH(VD_FIELD_CHECK_SUFFIX,c,tail)
 THEN GOES_WITH(VD_FIELD_CHECK_SUFFIX,c,CONS(ARRAY(CONS(reference,CONS(text,NIL))),tail));
law VD_FIELD_TRANSPORT_COMPLETE := IF THIS(VC_INPUT_FIELD,ARRAY(rows)), GOES_WITH(VD_FIELD_CHECK_SUFFIX,c,rows), GOES_WITH(VC_CORRESPONDENCE_COMPLETE,c,proof), THIS(VD_INITIAL_CONTENT_MATCH)
 THEN GOES_WITH(VD_FIELD_TRANSPORT_COMPLETE,c,GENESIS_AND_SELECTED_CANDIDATE);
law VD_SNAPSHOT_GENESIS := IF GOES_WITH(VD_FIELD_TRANSPORT_COMPLETE,c,GENESIS_AND_SELECTED_CANDIDATE), GOES_WITH(VD_GENESIS_FIELD,c,f,r)
 THEN GOES_WITH(VD_FIELD_SNAPSHOT,OBSERVER(c,GENESIS),f,r);
law VD_SNAPSHOT_CANDIDATE := IF GOES_WITH(VD_FIELD_TRANSPORT_COMPLETE,c,GENESIS_AND_SELECTED_CANDIDATE), GOES_WITH(VD_CANDIDATE_FIELD,c,f,r)
 THEN GOES_WITH(VD_FIELD_SNAPSHOT,OBSERVER(c,CANDIDATE),f,r);

// Exact basis and chain: hash the SOURCE-MATCHED reference bytes. These generic
// requests neither read hardware labels as reference labels nor alter hashes
// after the fact. No supplied chain digest is trusted without recomputation.
law VD_INITIAL_BODY := IF THIS(VD_INITIAL_CONTENT_MATCH), THIS(VD_INPUT_E0,entities), THIS(VC_INPUT_FIELD,field)
 THEN THIS(VD_INITIAL_BODY,OBJECT(CONS(MEMBER("entities",entities),CONS(MEMBER("field",field),NIL))));
law VD_INITIAL_BODY_REQUEST := IF THIS(VD_INITIAL_BODY,body)
 THEN GOES_WITH(GPU_HASH_REQUEST,VD_INITIAL_BODY,REFERENCE,body);
law VD_INITIAL_BODY_HASH := IF THIS(VD_INITIAL_BODY,body), GOES_WITH(GPU_HASH_RESPONSE,body,digest)
 THEN GOES_WITH(VD_INITIAL_BODY_HASH,body,digest);
law VD_GENESIS_RECORD := IF THIS(VD_REFERENCE_GENESIS_INPUTS,k,rows), GOES_WITH(VD_INITIAL_BODY_HASH,body,digest)
 THEN THIS(VD_GENESIS_RECORD,OBJECT(CONS(MEMBER("governance_type","anchored"),CONS(MEMBER("kappa",k),CONS(MEMBER("kind","GENESIS"),CONS(MEMBER("resolution_m",JSON_INTEGER("2")),CONS(MEMBER("state_hash",digest),NIL)))))));
law VD_GENESIS_LINK_REQUEST := IF THIS(VD_GENESIS_RECORD,record)
 THEN GOES_WITH(GPU_HASH_REQUEST,VD_GENESIS_LINK,REFERENCE,record);
law VD_GENESIS_LINK := IF THIS(VD_GENESIS_RECORD,record), GOES_WITH(GPU_HASH_RESPONSE,record,digest)
 THEN THIS(VD_GENESIS_LINK,digest);
law VD_GENESIS_ENTRY := IF THIS(VD_REFERENCE_GENESIS_INPUTS,k,rows), GOES_WITH(VD_INITIAL_BODY_HASH,body,stateHash), THIS(VD_GENESIS_LINK,link)
 THEN THIS(VD_GENESIS_ENTRY,OBJECT(CONS(MEMBER("governance_type","anchored"),CONS(MEMBER("kappa",k),CONS(MEMBER("kind","GENESIS"),CONS(MEMBER("link",link),CONS(MEMBER("resolution_m",JSON_INTEGER("2")),CONS(MEMBER("state_hash",stateHash),NIL))))))));
law VD_INITIAL_CHAIN_MATCH := IF THIS(VD_INPUT_CHAIN,ARRAY(CONS(entry,NIL))), THIS(VD_GENESIS_ENTRY,entry), THIS(VD_INITIAL_CONTENT_MATCH)
 THEN THIS(VD_INITIAL_CHAIN_MATCH);

// Full selected-object membership consumes the source-produced proposal
// readings above, never input.reading as an answer. The canonical STEP path
// still must execute its admitted payloads and return the selected successor.
law VD_OFFERED_REFERENCE_OBJECT := IF GOES_WITH(VD_REF_LIFT_TRANSPORT,c,LIFT(f,g,h),hardwareLift), GOES_WITH(VD_OFFERED_READING,c,hardwareLift,reading)
 THEN GOES_WITH(VD_OFFERED_REFERENCE_OBJECT,c,hardwareLift,OBJECT(CONS(MEMBER("from",f),CONS(MEMBER("reading",reading),CONS(MEMBER("to",h),CONS(MEMBER("via",g),NIL))))));
law VD_SELECTED_FULL_OFFERED_MEMBER := IF THIS(VD_INPUT_LIFT,object), GOES_WITH(VD_OFFERED_REFERENCE_OBJECT,c,l,object), THIS(VD_INITIAL_CONTENT_MATCH), GOES_WITH(VD_FIELD_TRANSPORT_COMPLETE,c,GENESIS_AND_SELECTED_CANDIDATE)
 THEN GOES_WITH(VD_SELECTED_FULL_OFFERED_MEMBER,c,l,object);
law VD_SELECTED_BASIS_MEMBER := IF GOES_WITH(VD_SELECTED_FULL_OFFERED_MEMBER,c,l,object), GOES_WITH(VD_INITIAL_BODY_HASH,body,basis), THIS(VD_INITIAL_CHAIN_MATCH)
 THEN GOES_WITH(VD_SELECTED_BASIS_MEMBER,c,l,basis,object);

// Full proposal object in the retained observer encoding. Every source offer
// and its computed reading is included. Filtering above fixes encoding order
// from the frozen reference sequence, not a hardware representative.
law VD_PROPOSAL_LIST_END := IF THIS(VD_ALL_LIFTS_TRANSPORT_COMPLETE,c), THIS(VD_REFERENCE_LIFT_ROWS,NIL)
 THEN GOES_WITH(VD_PROPOSAL_LIST_SUFFIX,c,NIL,NIL);
law VD_PROPOSAL_LIST_HEAD := IF THIS(VD_REFERENCE_LIFT_ROWS,CONS(reference,tail)), GOES_WITH(VD_REF_LIFT_TRANSPORT,c,reference,hardwareLift), GOES_WITH(VD_OFFERED_REFERENCE_OBJECT,c,hardwareLift,object), GOES_WITH(VD_PROPOSAL_LIST_SUFFIX,c,tail,objects)
 THEN GOES_WITH(VD_PROPOSAL_LIST_SUFFIX,c,CONS(reference,tail),CONS(object,objects));
law VD_PROPOSAL_COMPLETE := IF THIS(VD_COMPLETE_REFERENCE_LIFTS,ARRAY(lifts)), GOES_WITH(VD_PROPOSAL_LIST_SUFFIX,c,lifts,objects), GOES_WITH(VD_INITIAL_BODY_HASH,body,basis), THIS(VD_INPUT_ENTITY,entity), THIS(VD_INPUT_KIND,kind), THIS(VD_INPUT_TARGET,target), GOES_WITH(VD_FIELD_TRANSPORT_COMPLETE,c,GENESIS_AND_SELECTED_CANDIDATE)
 THEN GOES_WITH(VD_PROPOSAL,c,PROPOSAL(basis,entity,kind,target,ARRAY(objects)));
law VD_DECISION := IF GOES_WITH(VD_PROPOSAL,c,p), GOES_WITH(VD_SELECTED_FULL_OFFERED_MEMBER,c,l,object), THIS(VD_INITIAL_CHAIN_MATCH)
 THEN GOES_WITH(VD_DECISION,c,DECISION(p,object));
// VD_DECISION records the already-supplied frozen selection. It is not Devon's
// selection of a world kappa and not a promotion, canonical admission or commit.
// Those still require the returned canonical fabric successor. No VD_* token
// bypasses admission or manufactures a passed runtime gate.

// Checked universal observation adapter, not a selected hardware map.
// FT v0.1.3 2ECF2EEF...C1A01:148--149,342--360; 116 L11:94--98
// FFF676FC...3F9513. The frozen vector is reference observation encoding.
// VC supplies every incidence/move certificate; VD executes genesis, every
// completing lift and its proposal reading, and the supplied selected lift.
// Every one of the six anchors of every hardware face must supply the SAME
// inverse-observed contents before ONE reference-labelled fixture is exposed.
// No anchor, hardware kappa, current world, or occurrence is selected here.
//
// Runtime is NOT collapsed into these proofs. The exposed complete operands
// still require the shared canonical builder, typed ingress, STEP_FABRIC,
// actual RETURN, reference-encoded commit and exact V1/V2 byte comparison.
// There is no runtime receipt, ADMITTED payload or COMMITTED fact in this file.
//
// observer_pairs is a generic sorted observation of this source's VO_PAIR
// rows. It is untrusted custody: source membership, strict tuple order,
// distinctness, all480flags' three contacts and720rows are checked below.
@readonly input VO_PAIR_INVENTORY := "observer_pairs:";

// The reference entity successor is the retained D2 replacement rule. Its
// per-context counterpart is checked, not inferred from a renamed variable.
law VO_REFERENCE_ENTITY_SELECTED := IF GOES_WITH(VD_SELECTED_REFERENCE_ENTITY,n,f), THIS(VD_SELECTED_REFERENCE_GEOMETRY,LIFT(f,g,h))
 THEN GOES_WITH(VO_REFERENCE_ENTITY,n,h);
law VO_REFERENCE_ENTITY_COMPARE := IF GOES_WITH(VD_REFERENCE_ENTITY,n,f), THIS(VD_INPUT_ENTITY,selected)
 THEN THIS(VD_DIFFER_REQUEST,n,selected);
law VO_REFERENCE_ENTITY_RETAIN := IF GOES_WITH(VD_REFERENCE_ENTITY,n,f), THIS(VD_INPUT_ENTITY,selected), GOES_WITH(VD_DIFFER,n,selected)
 THEN GOES_WITH(VO_REFERENCE_ENTITY,n,f);
law VO_ENTITY_CHECK_END := IF GOES_WITH(VC_CORRESPONDENCE_COMPLETE,c,proof), THIS(VD_E0_ROWS,NIL)
 THEN GOES_WITH(VO_ENTITY_CHECK,c,NIL);
law VO_ENTITY_CHECK_HEAD := IF THIS(VD_E0_ROWS,CONS(MEMBER(n,f),tail)), GOES_WITH(VC_FLAG_MAP,c,f,x), GOES_WITH(VD_GENESIS_ENTITY,c,n,x), GOES_WITH(VO_REFERENCE_ENTITY,n,g), GOES_WITH(VC_FLAG_MAP,c,g,y), GOES_WITH(VD_CANDIDATE_ENTITY,c,n,y), GOES_WITH(VO_ENTITY_CHECK,c,tail)
 THEN GOES_WITH(VO_ENTITY_CHECK,c,CONS(MEMBER(n,f),tail));
law VO_ENTITIES_COMPLETE := IF THIS(VD_INPUT_E0,OBJECT(rows)), GOES_WITH(VO_ENTITY_CHECK,c,rows), THIS(VD_E0_COMPLETE,rows)
 THEN THIS(VO_ENTITIES_COMPLETE,c);

// Context completeness includes the complete offered set, not just the
// selected geometry. Selected membership includes its independently produced
// full reading and the source-recomputed initial basis/chain.
law VO_CONTEXT_READY := IF GOES_WITH(VC_CORRESPONDENCE_COMPLETE,CORRESPONDENCE(k,m),proof), GOES_WITH(VD_FIELD_TRANSPORT_COMPLETE,CORRESPONDENCE(k,m),GENESIS_AND_SELECTED_CANDIDATE), THIS(VD_ALL_LIFTS_TRANSPORT_COMPLETE,CORRESPONDENCE(k,m)), THIS(VO_ENTITIES_COMPLETE,CORRESPONDENCE(k,m)), GOES_WITH(VD_SELECTED_BASIS_MEMBER,CORRESPONDENCE(k,m),lift,basis,object), GOES_WITH(VD_DECISION,CORRESPONDENCE(k,m),DECISION(proposal,object))
 THEN GOES_WITH(VO_CONTEXT_READY,k,basis,object);
law VO_FACE_READY := IF GOES_WITH(HARDWARE_FACE,w,a,b,c), GOES_WITH(VO_CONTEXT_READY,ANCHOR(w,a,b,c),basis,object), GOES_WITH(VO_CONTEXT_READY,ANCHOR(w,a,c,b),basis,object), GOES_WITH(VO_CONTEXT_READY,ANCHOR(w,b,a,c),basis,object), GOES_WITH(VO_CONTEXT_READY,ANCHOR(w,b,c,a),basis,object), GOES_WITH(VO_CONTEXT_READY,ANCHOR(w,c,a,b),basis,object), GOES_WITH(VO_CONTEXT_READY,ANCHOR(w,c,b,a),basis,object)
 THEN GOES_WITH(VO_FACE_READY,w,basis,object);
law VO_CONTEXTS_END := IF GOES_WITH(VC_INVENTORY,FACE,NIL), GOES_WITH(VO_CONTEXT_READY,k,basis,object)
 THEN GOES_WITH(VO_CONTEXTS_SUFFIX,NIL,basis,object);
law VO_CONTEXTS_HEAD := IF GOES_WITH(VC_INVENTORY,FACE,CONS(w,tail)), GOES_WITH(VO_FACE_READY,w,basis,object), GOES_WITH(VO_CONTEXTS_SUFFIX,tail,basis,object)
 THEN GOES_WITH(VO_CONTEXTS_SUFFIX,CONS(w,tail),basis,object);
law VO_ALL_CONTEXTS := IF THIS(VC_HW_FACES,faces), GOES_WITH(VO_CONTEXTS_SUFFIX,faces,basis,object), THIS(VC_ALL_ANCHORS_COVERED,ALL_ORDERED_HARDWARE_FACES)
 THEN GOES_WITH(VO_ALL_CONTEXTS,basis,object);

// A candidate reading is never exported after one map. The universal fold
// below is a conjunction over every anchor and retains the same exact JSON
// reading in all premises. It cannot implement choose-first or majority.
law VO_READING_ANCHOR := IF GOES_WITH(VD_REF_LIFT_TRANSPORT,CORRESPONDENCE(k,m),reference,hardware), GOES_WITH(VD_OFFERED_READING,CORRESPONDENCE(k,m),hardware,reading), THIS(VD_ALL_LIFTS_TRANSPORT_COMPLETE,CORRESPONDENCE(k,m))
 THEN GOES_WITH(VO_READING_ANCHOR,k,reference,reading);
law VO_READING_FACE := IF GOES_WITH(HARDWARE_FACE,w,a,b,c), GOES_WITH(VO_READING_ANCHOR,ANCHOR(w,a,b,c),lift,reading), GOES_WITH(VO_READING_ANCHOR,ANCHOR(w,a,c,b),lift,reading), GOES_WITH(VO_READING_ANCHOR,ANCHOR(w,b,a,c),lift,reading), GOES_WITH(VO_READING_ANCHOR,ANCHOR(w,b,c,a),lift,reading), GOES_WITH(VO_READING_ANCHOR,ANCHOR(w,c,a,b),lift,reading), GOES_WITH(VO_READING_ANCHOR,ANCHOR(w,c,b,a),lift,reading)
 THEN GOES_WITH(VO_READING_FACE,w,lift,reading);
law VO_READINGS_END := IF GOES_WITH(VC_INVENTORY,FACE,NIL), GOES_WITH(VO_READING_ANCHOR,k,lift,reading)
 THEN GOES_WITH(VO_READINGS_SUFFIX,NIL,lift,reading);
law VO_READINGS_HEAD := IF GOES_WITH(VC_INVENTORY,FACE,CONS(w,tail)), GOES_WITH(VO_READING_FACE,w,lift,reading), GOES_WITH(VO_READINGS_SUFFIX,tail,lift,reading)
 THEN GOES_WITH(VO_READINGS_SUFFIX,CONS(w,tail),lift,reading);
law VO_REFERENCE_OFFERED_READING := IF THIS(VC_HW_FACES,faces), GOES_WITH(VO_READINGS_SUFFIX,faces,lift,reading), THIS(VC_ALL_ANCHORS_COVERED,ALL_ORDERED_HARDWARE_FACES)
 THEN GOES_WITH(VD_REFERENCE_OFFERED_READING,lift,reading);
law VO_OFFER_OBJECT := IF GOES_WITH(VD_REFERENCE_OFFERED_READING,LIFT(f,g,h),reading)
 THEN GOES_WITH(VO_OFFER_OBJECT,LIFT(f,g,h),OBJECT(CONS(MEMBER("from",f),CONS(MEMBER("reading",reading),CONS(MEMBER("to",h),CONS(MEMBER("via",g),NIL))))));
law VO_LIFT_ROWS := IF THIS(VD_COMPLETE_REFERENCE_LIFTS,ARRAY(rows))
 THEN THIS(VO_LIFT_ROWS,rows);
law VO_LIFT_TAIL := IF THIS(VO_LIFT_ROWS,CONS(lift,tail))
 THEN THIS(VO_LIFT_ROWS,tail);
law VO_OFFERS_END := IF THIS(VO_LIFT_ROWS,NIL)
 THEN GOES_WITH(VO_OFFER_SUFFIX,NIL,NIL);
law VO_OFFERS_HEAD := IF THIS(VO_LIFT_ROWS,CONS(lift,tail)), GOES_WITH(VO_OFFER_OBJECT,lift,object), GOES_WITH(VO_OFFER_SUFFIX,tail,objects)
 THEN GOES_WITH(VO_OFFER_SUFFIX,CONS(lift,tail),CONS(object,objects));
law VO_PROPOSAL := IF GOES_WITH(VO_ALL_CONTEXTS,basis,selected), THIS(VD_COMPLETE_REFERENCE_LIFTS,ARRAY(rows)), GOES_WITH(VO_OFFER_SUFFIX,rows,objects), THIS(VD_INPUT_ENTITY,entity), THIS(VD_INPUT_KIND,kind), THIS(VD_INPUT_TARGET,target), THIS(VD_INITIAL_CHAIN_MATCH)
 THEN THIS(VO_PROPOSAL,PROPOSAL(basis,entity,kind,target,ARRAY(objects)));
law VO_PROPOSAL_MEMBERS := IF THIS(VO_PROPOSAL,PROPOSAL(b,e,k,t,ARRAY(rows)))
 THEN GOES_WITH(VO_PROPOSAL_MEMBERS,PROPOSAL(b,e,k,t,ARRAY(rows)),rows);
law VO_PROPOSAL_MEMBER_TAIL := IF GOES_WITH(VO_PROPOSAL_MEMBERS,p,CONS(a,tail))
 THEN GOES_WITH(VO_PROPOSAL_MEMBERS,p,tail);
law VO_DECISION := IF GOES_WITH(VO_PROPOSAL_MEMBERS,p,CONS(a,tail)), THIS(VD_INPUT_LIFT,a), THIS(VD_INITIAL_CHAIN_MATCH)
 THEN THIS(VO_DECISION,DECISION(p,a));

// Reference-only comparison for the frozen array encoding. NO/THIS are bit
// readings; Bxx are byte identities. This order selects no world object.
// A request reaches only the actual first differing byte of a tuple string.
law VO_ORDER_TEXT_REQUEST := IF THIS(VO_ORDER_REQUEST,TEXT(a),TEXT(b))
 THEN THIS(VO_TEXT_REQUEST,a,b);
law VO_TEXT_REQUEST_TAIL := IF THIS(VO_TEXT_REQUEST,CONS(a,x),CONS(a,y))
 THEN THIS(VO_TEXT_REQUEST,x,y);
law VO_TEXT_BYTE_REQUEST := IF THIS(VO_TEXT_REQUEST,CONS(a,x),CONS(b,y))
 THEN THIS(VO_BYTE_REQUEST,a,b);
law VO_BYTE_LESS_0 := IF THIS(VO_BYTE_REQUEST,x,y), GOES_WITH(VC_BYTE_BITS,x,BITS(NO,a,b,c,d,e,f,g)), GOES_WITH(VC_BYTE_BITS,y,BITS(THIS,h,i,j,k,l,m,n))
 THEN GOES_WITH(VO_BYTE_LESS,x,y);
law VO_BYTE_LESS_1 := IF THIS(VO_BYTE_REQUEST,x,y), GOES_WITH(VC_BYTE_BITS,x,BITS(a,NO,b,c,d,e,f,g)), GOES_WITH(VC_BYTE_BITS,y,BITS(a,THIS,h,i,j,k,l,m))
 THEN GOES_WITH(VO_BYTE_LESS,x,y);
law VO_BYTE_LESS_2 := IF THIS(VO_BYTE_REQUEST,x,y), GOES_WITH(VC_BYTE_BITS,x,BITS(a,b,NO,c,d,e,f,g)), GOES_WITH(VC_BYTE_BITS,y,BITS(a,b,THIS,h,i,j,k,l))
 THEN GOES_WITH(VO_BYTE_LESS,x,y);
law VO_BYTE_LESS_3 := IF THIS(VO_BYTE_REQUEST,x,y), GOES_WITH(VC_BYTE_BITS,x,BITS(a,b,c,NO,d,e,f,g)), GOES_WITH(VC_BYTE_BITS,y,BITS(a,b,c,THIS,h,i,j,k))
 THEN GOES_WITH(VO_BYTE_LESS,x,y);
law VO_BYTE_LESS_4 := IF THIS(VO_BYTE_REQUEST,x,y), GOES_WITH(VC_BYTE_BITS,x,BITS(a,b,c,d,NO,e,f,g)), GOES_WITH(VC_BYTE_BITS,y,BITS(a,b,c,d,THIS,h,i,j))
 THEN GOES_WITH(VO_BYTE_LESS,x,y);
law VO_BYTE_LESS_5 := IF THIS(VO_BYTE_REQUEST,x,y), GOES_WITH(VC_BYTE_BITS,x,BITS(a,b,c,d,e,NO,f,g)), GOES_WITH(VC_BYTE_BITS,y,BITS(a,b,c,d,e,THIS,h,i))
 THEN GOES_WITH(VO_BYTE_LESS,x,y);
law VO_BYTE_LESS_6 := IF THIS(VO_BYTE_REQUEST,x,y), GOES_WITH(VC_BYTE_BITS,x,BITS(a,b,c,d,e,f,NO,g)), GOES_WITH(VC_BYTE_BITS,y,BITS(a,b,c,d,e,f,THIS,h))
 THEN GOES_WITH(VO_BYTE_LESS,x,y);
law VO_BYTE_LESS_7 := IF THIS(VO_BYTE_REQUEST,x,y), GOES_WITH(VC_BYTE_BITS,x,BITS(a,b,c,d,e,f,g,NO)), GOES_WITH(VC_BYTE_BITS,y,BITS(a,b,c,d,e,f,g,THIS))
 THEN GOES_WITH(VO_BYTE_LESS,x,y);
law VO_TEXT_EMPTY := IF THIS(VO_TEXT_REQUEST,NIL,CONS(a,b))
 THEN GOES_WITH(VO_TEXT_LESS,NIL,CONS(a,b));
law VO_TEXT_DIFFER := IF THIS(VO_TEXT_REQUEST,CONS(a,x),CONS(b,y)), GOES_WITH(VO_BYTE_LESS,a,b)
 THEN GOES_WITH(VO_TEXT_LESS,CONS(a,x),CONS(b,y));
law VO_TEXT_PREFIX := IF THIS(VO_TEXT_REQUEST,CONS(a,x),CONS(a,y)), GOES_WITH(VO_TEXT_LESS,x,y)
 THEN GOES_WITH(VO_TEXT_LESS,CONS(a,x),CONS(a,y));
law VO_ORDER_TEXT := IF THIS(VO_ORDER_REQUEST,TEXT(a),TEXT(b)), GOES_WITH(VO_TEXT_LESS,a,b)
 THEN GOES_WITH(VO_ORDERED,TEXT(a),TEXT(b));
law VO_ORDER_ARRAY_REQUEST := IF THIS(VO_ORDER_REQUEST,ARRAY(a),ARRAY(b))
 THEN THIS(VO_ORDER_REQUEST,a,b);
law VO_ORDER_ARRAY := IF THIS(VO_ORDER_REQUEST,ARRAY(a),ARRAY(b)), GOES_WITH(VO_ORDERED,a,b)
 THEN GOES_WITH(VO_ORDERED,ARRAY(a),ARRAY(b));
law VO_ORDER_HEAD_REQUEST := IF THIS(VO_ORDER_REQUEST,CONS(a,x),CONS(b,y))
 THEN THIS(VO_ORDER_REQUEST,a,b);
law VO_ORDER_TAIL_REQUEST := IF THIS(VO_ORDER_REQUEST,CONS(a,x),CONS(a,y))
 THEN THIS(VO_ORDER_REQUEST,x,y);
law VO_ORDER_HEAD := IF THIS(VO_ORDER_REQUEST,CONS(a,x),CONS(b,y)), GOES_WITH(VO_ORDERED,a,b)
 THEN GOES_WITH(VO_ORDERED,CONS(a,x),CONS(b,y));
law VO_ORDER_TAIL := IF THIS(VO_ORDER_REQUEST,CONS(a,x),CONS(a,y)), GOES_WITH(VO_ORDERED,x,y)
 THEN GOES_WITH(VO_ORDERED,CONS(a,x),CONS(a,y));
law VO_ORDER_EMPTY := IF THIS(VO_ORDER_REQUEST,NIL,CONS(a,b))
 THEN GOES_WITH(VO_ORDERED,NIL,CONS(a,b));

// Each involution contributes its unordered overlap once. The two directions
// are not two occurrences. Tuple ordering here preserves D2 observation bytes.
law VO_PAIR_ORDER_REQUEST := IF GOES_WITH(VC_REF_MOVE,kind,f,g)
 THEN THIS(VO_ORDER_REQUEST,f,g);
law VO_PAIR := IF GOES_WITH(VC_REF_MOVE,kind,f,g), GOES_WITH(VO_ORDERED,f,g)
 THEN GOES_WITH(VO_PAIR,f,g);
law VO_PAIR_OBSERVATION := IF GOES_WITH(VO_PAIR,f,g)
 THEN THIS(OBSERVATION_ROW,VO_PAIRS,ARRAY(CONS(f,CONS(g,NIL))));
law VO_PAIR_ROWS := IF THIS(VO_PAIR_INVENTORY,ARRAY(rows))
 THEN THIS(VO_PAIR_ROWS,rows);
law VO_PAIR_ROWS_TAIL := IF THIS(VO_PAIR_ROWS,CONS(row,tail))
 THEN THIS(VO_PAIR_ROWS,tail);
law VO_PAIR_ROW_MEMBER := IF THIS(VO_PAIR_ROWS,CONS(ARRAY(CONS(f,CONS(g,NIL))),tail)), GOES_WITH(VO_PAIR,f,g)
 THEN THIS(VO_PAIR_ROW_MEMBER,ARRAY(CONS(f,CONS(g,NIL))));
law VO_PAIR_ROW_ORDER_REQUEST := IF THIS(VO_PAIR_ROWS,CONS(a,CONS(b,tail))), THIS(VO_PAIR_ROW_MEMBER,a), THIS(VO_PAIR_ROW_MEMBER,b)
 THEN THIS(VO_ORDER_REQUEST,a,b);
law VO_PAIR_SPAN_HEAD := IF THIS(VO_PAIR_ROWS,CONS(a,CONS(b,tail))), THIS(VO_PAIR_ROW_MEMBER,a), THIS(VO_PAIR_ROW_MEMBER,b), GOES_WITH(VO_ORDERED,a,b)
 THEN GOES_WITH(VO_PAIR_SPAN,ONE,CONS(a,CONS(b,tail)),CONS(b,tail));
law VO_PAIR_SPAN_LAST := IF THIS(VO_PAIR_ROWS,CONS(a,NIL)), THIS(VO_PAIR_ROW_MEMBER,a)
 THEN GOES_WITH(VO_PAIR_SPAN,ONE,CONS(a,NIL),NIL);
law VO_PAIR_SPAN_DOUBLE := IF GOES_WITH(GSC_SPAN_DOUBLE,n,m), GOES_WITH(VO_PAIR_SPAN,n,a,b), GOES_WITH(VO_PAIR_SPAN,n,b,c)
 THEN GOES_WITH(VO_PAIR_SPAN,m,a,c);
law VO_PAIR_COVER_FORWARD := IF THIS(VO_PAIR_ROW_MEMBER,ARRAY(CONS(f,CONS(g,NIL))))
 THEN GOES_WITH(VO_PAIR_COVER,f,g);
law VO_PAIR_COVER_REVERSE := IF THIS(VO_PAIR_ROW_MEMBER,ARRAY(CONS(f,CONS(g,NIL))))
 THEN GOES_WITH(VO_PAIR_COVER,g,f);
law VO_FLAG_PAIR_COVER := IF GOES_WITH(VC_REF_MOVES,f,d,g,t), GOES_WITH(VO_PAIR_COVER,f,d), GOES_WITH(VO_PAIR_COVER,f,g), GOES_WITH(VO_PAIR_COVER,f,t)
 THEN THIS(VO_FLAG_PAIR_COVER,f);
law VO_PAIR_COVER_END := IF THIS(VC_ROWS,NIL)
 THEN THIS(VO_PAIR_COVER_SUFFIX,NIL);
law VO_PAIR_COVER_HEAD := IF THIS(VC_ROWS,CONS(ARRAY(CONS(f,CONS(reading,NIL))),tail)), THIS(VO_FLAG_PAIR_COVER,f), THIS(VO_PAIR_COVER_SUFFIX,tail)
 THEN THIS(VO_PAIR_COVER_SUFFIX,CONS(ARRAY(CONS(f,CONS(reading,NIL))),tail));
law VO_PAIRS_COMPLETE := IF THIS(VO_PAIR_INVENTORY,ARRAY(rows)), GOES_WITH(VO_PAIR_SPAN,FIVE_TWELVE,rows,a), GOES_WITH(VO_PAIR_SPAN,ONE_TWENTY_EIGHT,a,b), GOES_WITH(VO_PAIR_SPAN,SIXTY_FOUR,b,c), GOES_WITH(VO_PAIR_SPAN,SIXTEEN,c,NIL), THIS(VC_INPUT_FIELD,ARRAY(flags)), THIS(VO_PAIR_COVER_SUFFIX,flags), THIS(VC_REFERENCE_FULL_LENGTH)
 THEN THIS(VO_PAIR_SEQUENCE,ARRAY(rows));

// One fixture with complete input support, not120 runtime receipt aliases.
// Its parent is the frozen fixture's source-recomputed genesis, never the
// actual018 world chain. That world and its kappa remain untouched.
law VO_FIXTURE_READY := IF GOES_WITH(VO_ALL_CONTEXTS,basis,selected), THIS(VO_DECISION,DECISION(PROPOSAL(basis,entity,kind,target,lifts),selected)), THIS(VO_PAIR_SEQUENCE,pairs), THIS(VD_INITIAL_CHAIN_MATCH)
 THEN THIS(VO_OPERAND_FIXTURE_READY,FROZEN_VECTOR_OBSERVER);
law VO_FLAG_EXPORT := IF THIS(VO_OPERAND_FIXTURE_READY,FROZEN_VECTOR_OBSERVER), GOES_WITH(VC_REF_FLAG,f,text,r)
 THEN THIS(VO_FLAG,f);
law VO_FLAG_JSON_EXPORT := IF THIS(VO_FLAG,f)
 THEN GOES_WITH(VO_FLAG_JSON,f,f);
law VO_GENESIS_FIELD_EXPORT := IF THIS(VO_OPERAND_FIXTURE_READY,FROZEN_VECTOR_OBSERVER), GOES_WITH(VD_REFERENCE_GENESIS_FIELD,f,r)
 THEN GOES_WITH(VO_FIELD,GENESIS,f,r);
law VO_CANDIDATE_FIELD_EXPORT := IF THIS(VO_OPERAND_FIXTURE_READY,FROZEN_VECTOR_OBSERVER), GOES_WITH(VD_REFERENCE_CANDIDATE_FIELD,f,r)
 THEN GOES_WITH(VO_FIELD,CANDIDATE,f,r);
law VO_COMPARATOR_EXPORT := IF THIS(VO_OPERAND_FIXTURE_READY,FROZEN_VECTOR_OBSERVER), GOES_WITH(VO_PAIR,f,g)
 THEN GOES_WITH(VO_COMPARATOR,OCCURRENCE(TYPE(SAME_NOT_SAME,WHAT),OVERLAP(f,g)),f,g);
law VO_FIXTURE_PARENT := IF THIS(VO_OPERAND_FIXTURE_READY,FROZEN_VECTOR_OBSERVER), GOES_WITH(VD_INITIAL_BODY_HASH,body,basis), THIS(VD_GENESIS_LINK,link), THIS(VD_GENESIS_ENTRY,entry), THIS(VD_INITIAL_CHAIN_MATCH)
 THEN GOES_WITH(VO_FIXTURE_PARENT,basis,link,entry);

// Generic source-bound SHA responses. A response alone discharges no world law.
@readonly input HASH_BATCH_RESPONSES := "hash_batch:";
law HASH_BATCH_BEGIN := IF THIS(HASH_BATCH_RESPONSES,ARRAY(rows)) THEN THIS(HASH_BATCH_ROWS,rows);
law HASH_BATCH_TAIL := IF THIS(HASH_BATCH_ROWS,CONS(row,tail)) THEN THIS(HASH_BATCH_ROWS,tail);
law HASH_BATCH_BLOCK := IF THIS(HASH_BATCH_ROWS,CONS(a,CONS(b,CONS(c,CONS(d,CONS(e,CONS(f,CONS(g,CONS(h,tail))))))))) THEN THIS(HASH_BATCH_ROWS,tail);
law HASH_BATCH_RESPONSE := IF THIS(HASH_BATCH_ROWS,CONS(ARRAY(CONS(subject,CONS(digest,NIL))),tail)) THEN GOES_WITH(GPU_HASH_RESPONSE,subject,digest);


