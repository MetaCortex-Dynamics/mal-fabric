// Exact source contacts of the retained actual018/020 run.
// These wrappers permit the identical canonical program and runtime module to
// consume a separately source-certified frozen-vector observation fixture.
// They introduce no admission, placement, field, coverage, or chain default.
law AC_OCCURRENCE := IF GOES_WITH(SF_COMPARATOR,c,f,g)
 THEN GOES_WITH(P20_SOURCE_OCCURRENCE,c,f,g);
law AC_FLAG_JSON := IF GOES_WITH(FLAG_JSON,f,j)
 THEN GOES_WITH(P20_SOURCE_FLAG_JSON,f,j);
law AC_PLACEMENT := IF GOES_WITH(SF_OCCURRENCE_PLACEMENT,c,l)
 THEN GOES_WITH(P20_SOURCE_PLACEMENT,c,l);
law AC_ADMISSION := IF GOES_WITH(SF_OCCURRENCE_ADMITTED,c,e)
 THEN GOES_WITH(P20_SOURCE_ADMISSION,c,e);
law AC_COVERAGE := IF THIS(GSC_WITNESS_INPUT,ARRAY(rows)), GOES_WITH(GSC_COMPLETE,CURRENT_WITNESS,ARRAY(rows))
 THEN THIS(P20_SOURCE_COVERAGE,ARRAY(rows));
law AC_SNAPSHOT := IF THIS(COMMITTED_GENESIS,obj), THIS(GSC_LINK_RECORD,record), GOES_WITH(GSC_LINK_HASH,record,h), THIS(READOUT_CURRENT_ADMITTED)
 THEN GOES_WITH(P20_SOURCE_SNAPSHOT,h,obj);
law AC_ADMITTED := IF GOES_WITH(P20_SOURCE_SNAPSHOT,h,obj)
 THEN THIS(P20_SOURCE_ADMITTED,h);
law AC_OPERAND := IF GOES_WITH(P20_SOURCE_SNAPSHOT,h,obj), GOES_WITH(SF_SNAPSHOT_FIELD,GENESIS,f,r)
 THEN GOES_WITH(P20_SOURCE_OPERAND,h,f,r);
