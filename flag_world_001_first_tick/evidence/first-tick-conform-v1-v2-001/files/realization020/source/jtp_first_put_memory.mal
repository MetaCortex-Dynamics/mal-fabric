// Bounded source construction: ONE supplied PURE80 obligation, ONE fresh logical
// main-bank store, ONE first PUT. This is not an accumulated EEPROM history.
// No physical ACK, JTPClosureV1, board effect or world COMMITTED fact is emitted.
//
// Repaired k0_journal.c (k0-main-bank-repair-20261018/build-a/src/):
// SHA256 F27B50C54D9611A8BB33181D67BFB0AD2DB22A96DF1D01136C4BFE722EE2CF64.
// :79--108 EMPTY detection; :135--151 clear marker / write / readback / CRC /
// marker-last / reselect; :162--184 first PUT and unchanged80B custody.
// k0.h :14--20 binds80B obligation,160B slot, main bank and slotA identities.
// Host witness5555EA3B2ECC6C8D1DADB9AABA250F660722445E612EDEB17089337DA4934F1C
// is prior HOST_NATIVE scope, not execution of this module or an AVR receipt.
//
// PURE caller: k0c-jtp-nonpersistent-responder-001/k0_commands.c,
// SHA256 68F825F8DACCCD09453EDFC7E0D51C98B28F496D2D6ABC9B4566DBF5D7738283.
// :66--76 supplied input lifecycle=PENDING, flags/result absent; :79--93 exact
// virtual160B record; :95--109 per-request48B persistence projection.
// This module consumes caller-supplied complete typed PURE bytes, not MALCFU24.
// Semantic motif/operand admission stays with their existing source producers.
//
// PURE spec514F42BDED4319362DB5CC7E5B3DB536C3FC1B8CE430345693014FF6A124829A:
// section9.2:421--438 input80B; section9.5:470--481 projection48B;
// section11.1:540--549 CRC32/ISO-HDLC. The stored lifecycle0x10 is NOT the
// obligation's PENDING lifecycle0. No context, nonce, required_R, header or
// authority CRC is supplied here; all80 input bytes must already be constructed.
//
// Explicit entry: THIS(JP_FIRST_PUT_REQUEST,key). No request is seeded here.
// Every store and emitted JO projection uses VIRTUAL_FIRST_PUT(key), retaining
// its per-request logical scope. No reset of an existing store is performed.
// Logical memory is an immutable byte list; copy/readback rules below retain
// every byte. Fault-injected or physical write/read acknowledgements are absent.
// The ordered phase witnesses are source construction, not hardware testimony.

@propose seed JP_LAYOUT_CONSTANTS := {
 GOES_WITH(JP_PREFIX_7,SEQUENCE(CONS(U8(B1),CONS(U8(B16),CONS(U8(B0),CONS(U32(B0,B0,B0,B1),NIL)))))),
 GOES_WITH(JP_ZERO_32,U256(U128(U32(B0,B0,B0,B0),U32(B0,B0,B0,B0),U32(B0,B0,B0,B0),U32(B0,B0,B0,B0)),U128(U32(B0,B0,B0,B0),U32(B0,B0,B0,B0),U32(B0,B0,B0,B0),U32(B0,B0,B0,B0))))
};

// An explicit first-PUT request cannot fill incomplete input fields.
law JP_INPUT := IF THIS(JP_FIRST_PUT_REQUEST,k), GOES_WITH(JO_KIND_ONE_OBJECT,k,BYTES(o)), GOES_WITH(JO_FIELD,k,LIFECYCLE,U8(B0)), GOES_WITH(JO_FIELD,k,FLAGS,U8(B0)), GOES_WITH(JO_FIELD,k,RESULT_BITS,U32(B0,B0,B0,B0)), GOES_WITH(JO_FIELD,k,OBLIGATION_ID,id)
 THEN GOES_WITH(JP_INPUT,VIRTUAL_FIRST_PUT(k),k,BYTES(o),id);
law JP_EMPTY_MAIN_STORE := IF GOES_WITH(JP_INPUT,k,source,o,id)
 THEN GOES_WITH(JP_LOGICAL_EMPTY_STORE,k,MAIN_BANK,SLOT_A,SLOT_B);
law JP_MARKER_CLEAR := IF GOES_WITH(JP_LOGICAL_EMPTY_STORE,k,MAIN_BANK,SLOT_A,SLOT_B)
 THEN GOES_WITH(JP_LOGICAL_STATE,k,MARKER_CLEARED,MAIN_BANK,SLOT_A,B0,UNWRITTEN);

// Record bytes1..155: version/lifecycle/verdict/generation(7), obligation(80),
// obligationCRC(4), zero remainder(64). No input byte is interpreted or replaced.
law JP_PREFIX_REQUEST := IF GOES_WITH(JP_PREFIX_7,s) THEN THIS(JO_ENCODE_REQUEST,s);
law JP_PREFIX := IF GOES_WITH(JP_PREFIX_7,s), GOES_WITH(JO_ENCODE,s,BYTES(bytes))
 THEN GOES_WITH(JP_PREFIX_BYTES_7,BYTES(bytes));
law JP_OBLIGATION_CRC_REQUEST := IF GOES_WITH(JP_INPUT,k,source,bytes,id), GOES_WITH(JO_CRC_PARAMETERS,ISO_HDLC,p,i,x)
 THEN GOES_WITH(JO_CRC32_REQUEST,ISO_HDLC,k,OBLIGATION_80,bytes);
law JP_OBLIGATION_CRC := IF GOES_WITH(JP_INPUT,k,source,bytes,id), GOES_WITH(JO_CRC32_RESPONSE,ISO_HDLC,bytes,crc), GOES_WITH(JO_TYPED,crc,U32)
 THEN GOES_WITH(JP_OBLIGATION_CRC,k,crc);
law JP_TAIL_LAYOUT := IF GOES_WITH(JP_OBLIGATION_CRC,k,crc), GOES_WITH(JP_ZERO_32,z)
 THEN GOES_WITH(JP_TAIL_LAYOUT_68,k,SEQUENCE(CONS(crc,CONS(z,CONS(z,NIL)))));
law JP_TAIL_REQUEST := IF GOES_WITH(JP_TAIL_LAYOUT_68,k,s) THEN THIS(JO_ENCODE_REQUEST,s);
law JP_TAIL := IF GOES_WITH(JP_TAIL_LAYOUT_68,k,s), GOES_WITH(JO_ENCODE,s,BYTES(bytes))
 THEN GOES_WITH(JP_TAIL_BYTES_68,k,BYTES(bytes));
law JP_PREFIX_OBLIGATION_REQUEST := IF GOES_WITH(JP_INPUT,k,source,BYTES(o),id), GOES_WITH(JP_PREFIX_BYTES_7,BYTES(prefix))
 THEN THIS(JO_APPEND_REQUEST,prefix,o);
law JP_PREFIX_OBLIGATION := IF GOES_WITH(JP_INPUT,k,source,BYTES(o),id), GOES_WITH(JP_PREFIX_BYTES_7,BYTES(prefix)), GOES_WITH(JO_APPEND,prefix,o,joined)
 THEN GOES_WITH(JP_PREFIX_OBLIGATION_87,k,BYTES(joined));
law JP_RECORD_BODY_REQUEST := IF GOES_WITH(JP_PREFIX_OBLIGATION_87,k,BYTES(prefix)), GOES_WITH(JP_TAIL_BYTES_68,k,BYTES(tail))
 THEN THIS(JO_APPEND_REQUEST,prefix,tail);
law JP_RECORD_BODY := IF GOES_WITH(JP_PREFIX_OBLIGATION_87,k,BYTES(prefix)), GOES_WITH(JP_TAIL_BYTES_68,k,BYTES(tail)), GOES_WITH(JO_APPEND,prefix,tail,joined)
 THEN GOES_WITH(JP_RECORD_BODY_155,k,BYTES(joined));
law JP_RECORD_CRC_REQUEST := IF GOES_WITH(JP_RECORD_BODY_155,k,bytes), GOES_WITH(JO_CRC_PARAMETERS,ISO_HDLC,p,i,x)
 THEN GOES_WITH(JO_CRC32_REQUEST,ISO_HDLC,k,JOURNAL_RECORD_BODY_155,bytes);
law JP_RECORD_CRC := IF GOES_WITH(JP_RECORD_BODY_155,k,bytes), GOES_WITH(JO_CRC32_RESPONSE,ISO_HDLC,bytes,crc), GOES_WITH(JO_TYPED,crc,U32)
 THEN GOES_WITH(JP_RECORD_CRC,k,crc);
law JP_PAYLOAD_REQUEST := IF GOES_WITH(JP_RECORD_BODY_155,k,BYTES(body)), GOES_WITH(JP_RECORD_CRC,k,crc), GOES_WITH(JO_ENCODE,crc,BYTES(tail))
 THEN THIS(JO_APPEND_REQUEST,body,tail);
law JP_PAYLOAD := IF GOES_WITH(JP_RECORD_BODY_155,k,BYTES(body)), GOES_WITH(JP_RECORD_CRC,k,crc), GOES_WITH(JO_ENCODE,crc,BYTES(tail)), GOES_WITH(JO_APPEND,body,tail,joined)
 THEN GOES_WITH(JP_EXPECTED_PAYLOAD_159,k,BYTES(joined));

// Logical write materializes every supplied byte; no write witness is seeded.
law JP_WRITE_BEGIN := IF GOES_WITH(JP_LOGICAL_STATE,k,MARKER_CLEARED,MAIN_BANK,SLOT_A,B0,UNWRITTEN), GOES_WITH(JP_EXPECTED_PAYLOAD_159,k,BYTES(payload))
 THEN THIS(JP_WRITE_ROWS,k,payload);
law JP_WRITE_TAIL := IF THIS(JP_WRITE_ROWS,k,CONS(b,tail)), THIS(JO_BYTE,b)
 THEN THIS(JP_WRITE_ROWS,k,tail);
law JP_WRITE_END := IF THIS(JP_WRITE_ROWS,k,NIL)
 THEN GOES_WITH(JP_WRITTEN_SUFFIX,k,NIL,NIL);
law JP_WRITE_BYTE := IF THIS(JP_WRITE_ROWS,k,CONS(b,tail)), THIS(JO_BYTE,b), GOES_WITH(JP_WRITTEN_SUFFIX,k,tail,written)
 THEN GOES_WITH(JP_WRITTEN_SUFFIX,k,CONS(b,tail),CONS(b,written));
law JP_PAYLOAD_WRITTEN := IF GOES_WITH(JP_LOGICAL_STATE,k,MARKER_CLEARED,MAIN_BANK,SLOT_A,B0,UNWRITTEN), GOES_WITH(JP_EXPECTED_PAYLOAD_159,k,BYTES(expected)), GOES_WITH(JP_WRITTEN_SUFFIX,k,expected,stored)
 THEN GOES_WITH(JP_LOGICAL_STATE,k,PAYLOAD_WRITTEN,MAIN_BANK,SLOT_A,B0,BYTES(stored));

// Read all159 written bytes back from the logical store, then compare the whole
// readback to the expected payload. Prefix/partial equality emits no seal.
law JP_READ_BEGIN := IF GOES_WITH(JP_LOGICAL_STATE,k,PAYLOAD_WRITTEN,MAIN_BANK,SLOT_A,B0,BYTES(stored))
 THEN THIS(JP_READ_ROWS,k,stored);
law JP_READ_TAIL := IF THIS(JP_READ_ROWS,k,CONS(b,tail)), THIS(JO_BYTE,b)
 THEN THIS(JP_READ_ROWS,k,tail);
law JP_READ_END := IF THIS(JP_READ_ROWS,k,NIL)
 THEN GOES_WITH(JP_READ_SUFFIX,k,NIL,NIL);
law JP_READ_BYTE := IF THIS(JP_READ_ROWS,k,CONS(b,tail)), THIS(JO_BYTE,b), GOES_WITH(JP_READ_SUFFIX,k,tail,read)
 THEN GOES_WITH(JP_READ_SUFFIX,k,CONS(b,tail),CONS(b,read));
law JP_READBACK := IF GOES_WITH(JP_LOGICAL_STATE,k,PAYLOAD_WRITTEN,MAIN_BANK,SLOT_A,B0,BYTES(stored)), GOES_WITH(JP_READ_SUFFIX,k,stored,read)
 THEN GOES_WITH(JP_LOGICAL_READBACK,k,BYTES(read));
law JP_READBACK_SAME := IF GOES_WITH(JP_LOGICAL_READBACK,k,bytes), GOES_WITH(JP_EXPECTED_PAYLOAD_159,k,bytes)
 THEN GOES_WITH(JP_LOGICAL_READBACK_EVIDENCE,k,SAME,bytes);
law JP_CRC_RECHECK := IF GOES_WITH(JP_LOGICAL_READBACK_EVIDENCE,k,SAME,stored), GOES_WITH(JP_INPUT,k,source,obligation,id), GOES_WITH(JP_OBLIGATION_CRC,k,oc), GOES_WITH(JO_CRC32_RESPONSE,ISO_HDLC,obligation,oc), GOES_WITH(JP_RECORD_BODY_155,k,body), GOES_WITH(JP_RECORD_CRC,k,rc), GOES_WITH(JO_CRC32_RESPONSE,ISO_HDLC,body,rc)
 THEN GOES_WITH(JP_LOGICAL_CRC_EVIDENCE,k,OBLIGATION_80,oc,JOURNAL_RECORD_BODY_155,rc);
law JP_MARKER_LAST := IF GOES_WITH(JP_LOGICAL_STATE,k,PAYLOAD_WRITTEN,MAIN_BANK,SLOT_A,B0,bytes), GOES_WITH(JP_LOGICAL_READBACK_EVIDENCE,k,SAME,bytes), GOES_WITH(JP_LOGICAL_CRC_EVIDENCE,k,OBLIGATION_80,oc,JOURNAL_RECORD_BODY_155,rc)
 THEN GOES_WITH(JP_LOGICAL_STATE,k,MARKER_PUBLISHED,MAIN_BANK,SLOT_A,B165,bytes);
law JP_RECORD := IF GOES_WITH(JP_LOGICAL_STATE,k,MARKER_PUBLISHED,MAIN_BANK,SLOT_A,B165,BYTES(payload))
 THEN GOES_WITH(JP_LOGICAL_RECORD_160,k,BYTES(CONS(B165,payload)));
// Reselection sees the published marker and the complete checked first-PUT body.
law JP_RESELECT := IF GOES_WITH(JP_LOGICAL_RECORD_160,k,BYTES(CONS(B165,payload))), GOES_WITH(JP_EXPECTED_PAYLOAD_159,k,BYTES(payload)), GOES_WITH(JP_LOGICAL_CRC_EVIDENCE,k,OBLIGATION_80,oc,JOURNAL_RECORD_BODY_155,rc), GOES_WITH(JP_LOGICAL_READBACK_EVIDENCE,k,SAME,BYTES(payload))
 THEN GOES_WITH(JP_LOGICAL_SELECTION,k,MAIN_BANK,SLOT_A,STORED_PENDING,U32(B0,B0,B0,B1));

// Exact48B profile, under the virtual key only. These are constructed logical
// observations; they are not UART responses or a claim about the board's store.
law JP_PROJECTION_ID := IF GOES_WITH(JP_LOGICAL_SELECTION,k,MAIN_BANK,SLOT_A,STORED_PENDING,g), GOES_WITH(JP_INPUT,k,source,bytes,id)
 THEN GOES_WITH(JO_SOURCE_FIELD,k,OBLIGATION_ID,id);
law JP_PROJECTION_LIFECYCLE := IF GOES_WITH(JP_LOGICAL_SELECTION,k,MAIN_BANK,SLOT_A,STORED_PENDING,g)
 THEN GOES_WITH(JO_SOURCE_FIELD,k,PERSISTENCE_LIFECYCLE,U8(B16));
law JP_PROJECTION_VERB_RESULT := IF GOES_WITH(JP_LOGICAL_SELECTION,k,MAIN_BANK,SLOT_A,STORED_PENDING,g)
 THEN GOES_WITH(JO_SOURCE_FIELD,k,PERSISTENCE_VERB_RESULT,U8(B0));
law JP_PROJECTION_SLOT := IF GOES_WITH(JP_LOGICAL_SELECTION,k,MAIN_BANK,SLOT_A,STORED_PENDING,g)
 THEN GOES_WITH(JO_SOURCE_FIELD,k,SELECTED_SLOT,U8(B0));
law JP_PROJECTION_INTEGRITY := IF GOES_WITH(JP_LOGICAL_SELECTION,k,MAIN_BANK,SLOT_A,STORED_PENDING,g), GOES_WITH(JP_LOGICAL_CRC_EVIDENCE,k,OBLIGATION_80,oc,JOURNAL_RECORD_BODY_155,rc)
 THEN GOES_WITH(JO_SOURCE_FIELD,k,RECORD_INTEGRITY,U8(B1));
law JP_PROJECTION_GENERATION := IF GOES_WITH(JP_LOGICAL_SELECTION,k,MAIN_BANK,SLOT_A,STORED_PENDING,g)
 THEN GOES_WITH(JO_SOURCE_FIELD,k,GENERATION,g);
law JP_PROJECTION_RECORD_CRC := IF GOES_WITH(JP_LOGICAL_SELECTION,k,MAIN_BANK,SLOT_A,STORED_PENDING,g), GOES_WITH(JP_RECORD_CRC,k,crc)
 THEN GOES_WITH(JO_SOURCE_FIELD,k,RECORD_CRC,crc);
law JP_PROJECTION_OBLIGATION_CRC := IF GOES_WITH(JP_LOGICAL_SELECTION,k,MAIN_BANK,SLOT_A,STORED_PENDING,g), GOES_WITH(JP_OBLIGATION_CRC,k,crc)
 THEN GOES_WITH(JO_OBLIGATION_CRC,k,crc);
law JP_PROJECTION := IF GOES_WITH(JP_LOGICAL_SELECTION,k,MAIN_BANK,SLOT_A,STORED_PENDING,g), GOES_WITH(JO_PERSISTENCE_PAYLOAD,k,bytes)
 THEN GOES_WITH(JP_LOGICAL_PERSISTENCE_48,k,bytes);
