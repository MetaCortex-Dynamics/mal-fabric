// Bounded ingress + ONE STEP_FABRIC for the comparator-only program.
// MF_GAME section9: FED38C3B57092838D25DEC5FA323A3827FB28A360251ECCD1CB991D976480557.
// _seed_frame/ingress_bind: game_loop.py:379--425,
// F711C6499E345C6B6952D8E8AA570B385D7F48A46F3E2189491E98653C4C1833.
// V3.3 sections1--8: 5BB1497AA3D791150F0416FEDA4E393695A9302B42030ADD0A7D22C08CCBEAC0.
// Only the declared ingress boundary is reused; no DEMO-003 game content.
// No marker CellDefs, internal routes, FabricEdits or same-tick operand reads.
// The initial empty auxiliary custody is constructed below for a NEW fabric
// run, not substituted for an absent prior fabric snapshot.
//
// Required contacts from source-owned program construction:
// P20_CELL(c,canonical_id,CellDef,LOCATION), SF_PROGRAM(p,cells,NIL),
// SF_PROGRAM_DRC(p,IF_THEN,receipt), THIS(P20_NO_INTERNAL_ROUTES,p).
// Generic hash contact: GPU_HASH_REQUEST(kind,key,JSON_subject) requests SHA-256;
// GOES_WITH(GPU_HASH_RESPONSE,JSON_subject,digest) returns subject-bound bytes.
// Neither the primitive nor its transport creates a frame or world verdict.
@readonly input I20_RECEIPT_INVENTORY := "receipt_inventory:";

// Exact published genesis custody, not the uncommitted 019 evaluation result.
law I20_COMMITTED_SNAPSHOT := IF THIS(COMMITTED_GENESIS,obj), THIS(GSC_LINK_RECORD,record), GOES_WITH(GSC_LINK_HASH,record,h), THIS(READOUT_CURRENT_ADMITTED)
 THEN GOES_WITH(I20_COMMITTED_SNAPSHOT,h,obj);
law I20_PROGRAM_SNAPSHOT := IF GOES_WITH(SF_PROGRAM,p,cells,NIL), GOES_WITH(SF_PROGRAM_DRC,p,IF_THEN,e), THIS(P20_NO_INTERNAL_ROUTES,p), GOES_WITH(I20_COMMITTED_SNAPSHOT,h,obj)
 THEN GOES_WITH(I20_RUN,p,h,cells);
law I20_CELLS_BEGIN := IF GOES_WITH(I20_RUN,p,h,cells)
 THEN GOES_WITH(I20_CELL_TAIL,p,h,cells);
law I20_CELLS_TAIL := IF GOES_WITH(I20_CELL_TAIL,p,h,CONS(c,tail))
 THEN GOES_WITH(I20_CELL_TAIL,p,h,tail);
law I20_CELL_MEMBER := IF GOES_WITH(I20_CELL_TAIL,p,h,CONS(c,tail)), GOES_WITH(P20_CELL,c,id,def,location)
 THEN GOES_WITH(I20_CELL,p,h,c,id);

// InitialFabricState: execution_kernel.py:382--403. EMPTY per declared cell;
// the five auxiliary collections are empty by new-run construction.
law I20_INITIAL_PAYLOAD := IF GOES_WITH(I20_CELL,p,h,c,id)
 THEN GOES_WITH(I20_INITIAL_PAYLOAD,p,h,c,EMPTY);
law I20_INITIAL_AUX := IF GOES_WITH(I20_RUN,p,h,cells)
 THEN GOES_WITH(I20_INITIAL_AUX,p,h,AUX(NIL,NIL,NIL,NIL,NIL));

// Declared ingress bindings follow this occurrence's two source operands.
// They are external observation bindings, NOT program.routes.
law I20_LEFT_BINDING := IF GOES_WITH(I20_CELL,p,h,c,id), GOES_WITH(SF_COMPARATOR,c,f,g), GOES_WITH(SF_PORT,LEFT,EXACTLY_ONE)
 THEN GOES_WITH(I20_INGRESS_BINDING,p,h,c,id,LEFT,f);
law I20_RIGHT_BINDING := IF GOES_WITH(I20_CELL,p,h,c,id), GOES_WITH(SF_COMPARATOR,c,f,g), GOES_WITH(SF_PORT,RIGHT,EXACTLY_ONE)
 THEN GOES_WITH(I20_INGRESS_BINDING,p,h,c,id,RIGHT,g);
law I20_BINDING_ROW := IF GOES_WITH(I20_CELL,p,h,c,id), GOES_WITH(SF_COMPARATOR,c,f,g), GOES_WITH(FLAG_JSON,f,a), GOES_WITH(FLAG_JSON,g,b)
 THEN GOES_WITH(I20_BINDING_ROW,p,h,c,OBJECT(CONS(MEMBER("LEFT",a),CONS(MEMBER("RIGHT",b),CONS(MEMBER("target_cell",id),NIL)))));
law I20_BINDING_END := IF GOES_WITH(I20_CELL_TAIL,p,h,NIL)
 THEN GOES_WITH(I20_BINDING_SUFFIX,p,h,NIL,NIL);
law I20_BINDING_ROW_APPEND := IF GOES_WITH(I20_CELL_TAIL,p,h,CONS(c,tail)), GOES_WITH(I20_BINDING_ROW,p,h,c,row), GOES_WITH(I20_BINDING_SUFFIX,p,h,tail,rows)
 THEN GOES_WITH(I20_BINDING_SUFFIX,p,h,CONS(c,tail),CONS(row,rows));
law I20_BINDING_OBJECT := IF GOES_WITH(I20_RUN,p,h,cells), GOES_WITH(I20_BINDING_SUFFIX,p,h,cells,rows)
 THEN GOES_WITH(I20_BINDING_OBJECT,p,h,OBJECT(CONS(MEMBER("fabric_digest",p),CONS(MEMBER("ingress_bindings",ARRAY(rows)),CONS(MEMBER("snapshot",h),NIL)))));
law I20_BINDING_HASH_REQUEST := IF GOES_WITH(I20_BINDING_OBJECT,p,h,subject)
 THEN GOES_WITH(GPU_HASH_REQUEST,INGRESS_BINDING,CONTEXT(p,h),subject);
law I20_BINDING_ID := IF GOES_WITH(I20_BINDING_OBJECT,p,h,subject), GOES_WITH(GPU_HASH_RESPONSE,subject,digest)
 THEN GOES_WITH(I20_BINDING_ID,p,h,digest);
law I20_RUN_ID_SUBJECT := IF GOES_WITH(I20_BINDING_ID,p,h,binding)
 THEN GOES_WITH(I20_RUN_ID_SUBJECT,p,h,ARRAY(CONS("FLAG_WORLD_RUN",CONS(p,CONS(binding,CONS(h,NIL))))));
law I20_RUN_ID_REQUEST := IF GOES_WITH(I20_RUN_ID_SUBJECT,p,h,subject)
 THEN GOES_WITH(GPU_HASH_REQUEST,RUN_ID,CONTEXT(p,h),subject);
law I20_RUN_ID := IF GOES_WITH(I20_RUN_ID_SUBJECT,p,h,subject), GOES_WITH(GPU_HASH_RESPONSE,subject,digest)
 THEN GOES_WITH(I20_RUN_ID,p,h,digest);
@propose seed I20_ENCODING := {
 GOES_WITH(I20_ROLE_TEXT,LEFT,"LEFT"), GOES_WITH(I20_ROLE_TEXT,RIGHT,"RIGHT"),
 GOES_WITH(I20_READING_TEXT,NO,"NO"), GOES_WITH(I20_READING_TEXT,THIS,"THIS"),
 GOES_WITH(I20_RESULT_TEXT,SAME,"SAME"), GOES_WITH(I20_RESULT_TEXT,NOT_SAME,"NOT_SAME"),
 GOES_WITH(I20_COMPARE,NO,NO,SAME), GOES_WITH(I20_COMPARE,THIS,THIS,SAME),
 GOES_WITH(I20_COMPARE,NO,THIS,NOT_SAME), GOES_WITH(I20_COMPARE,THIS,NO,NOT_SAME)
};
// Input payload contains both the reading and its committed snapshot/flag
// custody. A captured snapshot is never resampled during evaluation.
law I20_INPUT_PAYLOAD := IF GOES_WITH(I20_INGRESS_BINDING,p,h,c,id,role,f), GOES_WITH(SF_SNAPSHOT_FIELD,GENESIS,f,r), GOES_WITH(FLAG_JSON,f,j), GOES_WITH(I20_READING_TEXT,r,t)
 THEN GOES_WITH(I20_INPUT_PAYLOAD,p,h,c,role,r,OBJECT(CONS(MEMBER("flag",j),CONS(MEMBER("reading",t),CONS(MEMBER("snapshot",h),NIL)))));
// Source-owned canonical input identity. The role and occurrence distinguish
// the two input values even when their readings are SAME.
// The first logical tick is count NO (JSON integer 0), not an identifier order.
// This is the caller's GAME_INGRESS hash formula with source-owned bindings.
law I20_ROUTE_SUBJECT := IF GOES_WITH(I20_INGRESS_BINDING,p,h,c,id,role,f), GOES_WITH(I20_ROLE_TEXT,role,t), GOES_WITH(I20_BINDING_ID,p,h,binding)
 THEN GOES_WITH(I20_ROUTE_SUBJECT,p,h,c,role,ARRAY(CONS("GAME_INGRESS",CONS(binding,CONS(JSON_INTEGER("0"),CONS(id,CONS(t,NIL)))))));
law I20_ROUTE_HASH_REQUEST := IF GOES_WITH(I20_ROUTE_SUBJECT,p,h,c,role,subject)
 THEN GOES_WITH(GPU_HASH_REQUEST,INGRESS_ROUTE,CONTEXT(p,h,c,role),subject);
law I20_ROUTE_HASH := IF GOES_WITH(I20_ROUTE_SUBJECT,p,h,c,role,subject), GOES_WITH(GPU_HASH_RESPONSE,subject,digest)
 THEN GOES_WITH(I20_ROUTE_ID,p,h,c,role,digest);
law I20_INPUT_RECEIPT_SUBJECT := IF GOES_WITH(I20_ROUTE_ID,p,h,c,role,rid), GOES_WITH(I20_INPUT_PAYLOAD,p,h,c,role,r,payload)
 THEN GOES_WITH(I20_INPUT_RECEIPT_SUBJECT,p,h,c,role,ARRAY(CONS("GAME_INGRESS_RECEIPT",CONS(rid,CONS(payload,NIL)))));
law I20_INPUT_RECEIPT_REQUEST := IF GOES_WITH(I20_INPUT_RECEIPT_SUBJECT,p,h,c,role,subject)
 THEN GOES_WITH(GPU_HASH_REQUEST,INGRESS_RECEIPT,CONTEXT(p,h,c,role),subject);
law I20_INPUT_VALUE := IF GOES_WITH(I20_ROUTE_ID,p,h,c,role,rid), GOES_WITH(I20_INPUT_PAYLOAD,p,h,c,role,r,payload), GOES_WITH(I20_INPUT_RECEIPT_SUBJECT,p,h,c,role,subject), GOES_WITH(GPU_HASH_RESPONSE,subject,receipt)
 THEN GOES_WITH(I20_INPUT_VALUE,p,h,c,role,r,INPUT_VALUE(rid,IDENTITY_ESSENCE,payload,receipt));
law I20_INPUT_JSON := IF GOES_WITH(I20_INPUT_VALUE,p,h,c,role,r,INPUT_VALUE(rid,IDENTITY_ESSENCE,payload,receipt))
 THEN GOES_WITH(I20_INPUT_JSON,p,h,c,role,OBJECT(CONS(MEMBER("payload_type","identity/essence"),CONS(MEMBER("route_id",rid),CONS(MEMBER("source_receipt",receipt),CONS(MEMBER("value",payload),NIL))))));

// Singleton role lists are EXACTLY_ONE. Their payload types match the imported
// SAME/WHAT JOIN_SIGNATURE. No default or partial frame can reach ADMITTED.
law I20_FRAME := IF GOES_WITH(I20_INPUT_VALUE,p,h,c,LEFT,a,left), GOES_WITH(I20_INPUT_VALUE,p,h,c,RIGHT,b,right), GOES_WITH(I20_INPUT_JSON,p,h,c,LEFT,lj), GOES_WITH(I20_INPUT_JSON,p,h,c,RIGHT,rj)
 THEN GOES_WITH(I20_FRAME,p,h,c,FRAME(LEFT(CONS(left,NIL)),RIGHT(CONS(right,NIL))),OBJECT(CONS(MEMBER("LEFT",ARRAY(CONS(lj,NIL))),CONS(MEMBER("RIGHT",ARRAY(CONS(rj,NIL))),NIL))));
law I20_ADMISSION_SUBJECT := IF GOES_WITH(I20_CELL,p,h,c,id), GOES_WITH(I20_FRAME,p,h,c,frame,json), GOES_WITH(I20_RUN_ID,p,h,run)
 THEN GOES_WITH(I20_ADMISSION_SUBJECT,p,h,c,ARRAY(CONS("GAME_FRAME_ADMITTED",CONS(run,CONS(JSON_INTEGER("0"),CONS(id,CONS(json,NIL)))))));
law I20_ADMISSION_REQUEST := IF GOES_WITH(I20_ADMISSION_SUBJECT,p,h,c,subject)
 THEN GOES_WITH(GPU_HASH_REQUEST,FRAME_ADMISSION,CONTEXT(p,h,c),subject);
law I20_PREPARED_PAYLOAD := IF GOES_WITH(I20_INITIAL_PAYLOAD,p,h,c,EMPTY), GOES_WITH(I20_FRAME,p,h,c,frame,json), GOES_WITH(I20_ADMISSION_SUBJECT,p,h,c,subject), GOES_WITH(GPU_HASH_RESPONSE,subject,receipt), GOES_WITH(SF_OCCURRENCE_ADMITTED,c,e)
 THEN GOES_WITH(I20_PREPARED_PAYLOAD,p,h,c,ADMITTED(frame,receipt));

// STEP_FABRIC stage1: the entire prepared payload map is closed before the
// immutable snapshot opens. Inputs and receipts are copied, not recomputed.
law I20_PREPARED_END := IF GOES_WITH(I20_CELL_TAIL,p,h,NIL)
 THEN GOES_WITH(I20_PREPARED_SUFFIX,p,h,NIL,NIL);
law I20_PREPARED_ROW := IF GOES_WITH(I20_CELL_TAIL,p,h,CONS(c,tail)), GOES_WITH(I20_CELL,p,h,c,id), GOES_WITH(I20_PREPARED_PAYLOAD,p,h,c,payload), GOES_WITH(I20_PREPARED_SUFFIX,p,h,tail,rows)
 THEN GOES_WITH(I20_PREPARED_SUFFIX,p,h,CONS(c,tail),CONS(CELL_STATE(id,payload),rows));
law I20_SNAPSHOT := IF GOES_WITH(I20_RUN,p,h,cells), GOES_WITH(I20_PREPARED_SUFFIX,p,h,cells,payloads), GOES_WITH(I20_INITIAL_AUX,p,h,AUX(rs,pa,ib,ob,receipts))
 THEN GOES_WITH(I20_SNAPSHOT,p,h,FABRIC_STATE(PAYLOAD_MAP(payloads),rs,pa,ib,ob,receipts));

// Stage2: pure SAME reading of this snapshot's complete typed frame.
law I20_EVALUATE := IF GOES_WITH(I20_SNAPSHOT,p,h,snapshot), GOES_WITH(I20_PREPARED_PAYLOAD,p,h,c,ADMITTED(FRAME(LEFT(CONS(left,NIL)),RIGHT(CONS(right,NIL))),admission)), GOES_WITH(I20_INPUT_VALUE,p,h,c,LEFT,a,left), GOES_WITH(I20_INPUT_VALUE,p,h,c,RIGHT,b,right), GOES_WITH(I20_COMPARE,a,b,r)
 THEN GOES_WITH(I20_CELL_RESULT,p,h,c,RESULT(r));
law I20_AGREEMENT := IF GOES_WITH(I20_CELL_RESULT,p,h,c,RESULT(r)), GOES_WITH(SF_COMPARATOR,c,f,g)
 THEN GOES_WITH(I20_AGREEMENT,p,h,f,g,r);
law I20_WALL := IF GOES_WITH(I20_AGREEMENT,p,h,f,g,NOT_SAME)
 THEN GOES_WITH(I20_WALL,p,h,f,g);

// Full result and RuntimeReceipt custody, execution_kernel.py:338--341,
// 490--505, 941--959. SHA is generic; every hashed subject is source-produced.
law I20_RESULT_JSON := IF GOES_WITH(I20_CELL_RESULT,p,h,c,RESULT(r)), GOES_WITH(I20_FRAME,p,h,c,frame,fj), GOES_WITH(I20_RESULT_TEXT,r,t)
 THEN GOES_WITH(I20_RESULT_JSON,p,h,c,OBJECT(CONS(MEMBER("input_frame",fj),CONS(MEMBER("operator","SAME_NOT_SAME"),CONS(MEMBER("reading",t),CONS(MEMBER("witness","WHAT"),NIL))))));
law I20_EVALUATION_PAYLOAD := IF GOES_WITH(I20_RESULT_JSON,p,h,c,json)
 THEN GOES_WITH(I20_RECEIPT_PAYLOAD,p,h,c,CELL_EVALUATED,json);
law I20_TRANSITION_PAYLOAD := IF GOES_WITH(I20_CELL_RESULT,p,h,c,r)
 THEN GOES_WITH(I20_RECEIPT_PAYLOAD,p,h,c,PAYLOAD_TRANSITION,ARRAY(CONS("ADMITTED",CONS("COMPLETED",NIL))));
@propose seed I20_RECEIPT_KINDS := {
 GOES_WITH(I20_RECEIPT_KIND_TEXT,CELL_EVALUATED,"CELL_EVALUATED"),
 GOES_WITH(I20_RECEIPT_KIND_TEXT,PAYLOAD_TRANSITION,"PAYLOAD_TRANSITION")
};
law I20_RECEIPT_PAYLOAD_REQUEST := IF GOES_WITH(I20_RECEIPT_PAYLOAD,p,h,c,kind,subject)
 THEN GOES_WITH(GPU_HASH_REQUEST,RUNTIME_PAYLOAD,CONTEXT(p,h,c,kind),subject);
law I20_RECEIPT_ID_SUBJECT := IF GOES_WITH(I20_RECEIPT_PAYLOAD,p,h,c,kind,subject), GOES_WITH(GPU_HASH_RESPONSE,subject,digest), GOES_WITH(I20_CELL,p,h,c,id), GOES_WITH(I20_RECEIPT_KIND_TEXT,kind,k)
 THEN GOES_WITH(I20_RECEIPT_ID_SUBJECT,p,h,c,kind,digest,ARRAY(CONS(k,CONS(id,CONS(digest,NIL)))));
law I20_RECEIPT_ID_REQUEST := IF GOES_WITH(I20_RECEIPT_ID_SUBJECT,p,h,c,kind,digest,subject)
 THEN GOES_WITH(GPU_HASH_REQUEST,RUNTIME_RECEIPT,CONTEXT(p,h,c,kind),subject);
law I20_RUNTIME_RECEIPT := IF GOES_WITH(I20_RECEIPT_ID_SUBJECT,p,h,c,kind,digest,subject), GOES_WITH(GPU_HASH_RESPONSE,subject,rid), GOES_WITH(I20_CELL,p,h,c,id), GOES_WITH(I20_RECEIPT_KIND_TEXT,kind,k)
 THEN GOES_WITH(I20_RUNTIME_RECEIPT,p,h,c,kind,rid,OBJECT(CONS(MEMBER("kind",k),CONS(MEMBER("payload_digest",digest),CONS(MEMBER("receipt_id",rid),CONS(MEMBER("subject_id",id),NIL))))));
law I20_RECEIPT_ROW := IF GOES_WITH(I20_RUNTIME_RECEIPT,p,h,c,kind,rid,json)
 THEN THIS(OBSERVATION_ROW,I20_RECEIPTS,ARRAY(CONS(rid,CONS(json,NIL))));

// Stage3: the exact canonical program inventory has NO internal routes. No
// source associations are silently reclassified; ingress is explicitly above.
law I20_PROPAGATE := IF GOES_WITH(I20_SNAPSHOT,p,h,snapshot), GOES_WITH(SF_PROGRAM,p,cells,NIL), THIS(P20_NO_INTERNAL_ROUTES,p)
 THEN GOES_WITH(I20_ROUTE_RESULTS,p,h,NIL);
// Stage4: with no route results and a NEW initial snapshot's empty pending
// custody, runtime governance carries those exact five auxiliary collections.
law I20_GOVERN := IF GOES_WITH(I20_ROUTE_RESULTS,p,h,NIL), GOES_WITH(I20_SNAPSHOT,p,h,FABRIC_STATE(payloads,rs,NIL,NIL,NIL,receipts))
 THEN GOES_WITH(I20_GOVERNANCE,p,h,AUX(rs,NIL,NIL,NIL,receipts));

// Stage5: every ADMITTED cell becomes COMPLETED simultaneously. The empty
// completion-evidence set is sourced by the actual empty program route list.
// It is post-evaluation custody, never a claim of a selected displacement.
law I20_COMPLETED := IF GOES_WITH(I20_PREPARED_PAYLOAD,p,h,c,ADMITTED(frame,admission)), GOES_WITH(I20_CELL_RESULT,p,h,c,result), GOES_WITH(I20_GOVERNANCE,p,h,aux)
 THEN GOES_WITH(I20_NEXT_PAYLOAD,p,h,c,COMPLETED(frame,result,NIL));
law I20_NEXT_END := IF GOES_WITH(I20_CELL_TAIL,p,h,NIL), GOES_WITH(I20_GOVERNANCE,p,h,aux)
 THEN GOES_WITH(I20_NEXT_SUFFIX,p,h,NIL,NIL,NIL);
law I20_NEXT_ROW := IF GOES_WITH(I20_CELL_TAIL,p,h,CONS(c,tail)), GOES_WITH(I20_CELL,p,h,c,id), GOES_WITH(I20_NEXT_PAYLOAD,p,h,c,after), GOES_WITH(I20_RUNTIME_RECEIPT,p,h,c,CELL_EVALUATED,eid,e), GOES_WITH(I20_RUNTIME_RECEIPT,p,h,c,PAYLOAD_TRANSITION,tid,t), GOES_WITH(I20_NEXT_SUFFIX,p,h,tail,rows,receipts)
 THEN GOES_WITH(I20_NEXT_SUFFIX,p,h,CONS(c,tail),CONS(CELL_STATE(id,after),rows),CONS(e,CONS(t,receipts)));
law I20_SIMULTANEOUS_COMMIT := IF GOES_WITH(I20_RUN,p,h,cells), GOES_WITH(I20_NEXT_SUFFIX,p,h,cells,payloads,newreceipts), GOES_WITH(I20_GOVERNANCE,p,h,AUX(rs,pa,ib,ob,NIL)), GOES_WITH(I20_SNAPSHOT,p,h,snapshot)
 THEN GOES_WITH(STEP_FABRIC_RETURN,p,snapshot,FABRIC_STATE(PAYLOAD_MAP(payloads),rs,pa,ib,ob,RECEIPT_SET(newreceipts)));

// Effects may read only this returned simultaneous successor (MF_GAME section11).
law I20_RETURNED_AGREEMENT := IF GOES_WITH(I20_SNAPSHOT,p,h,snapshot), GOES_WITH(STEP_FABRIC_RETURN,p,snapshot,next), GOES_WITH(I20_AGREEMENT,p,h,f,g,r)
 THEN GOES_WITH(I20_COMMITTED_AGREEMENT,p,h,next,f,g,r);

// Canonical observation of the complete successor. The host may collect/sort
// emitted receipt rows, but cannot supply an object not produced above. Strict
// byte order below is receipt-identity serialization, never world selection.
law I20_RECEIPT_ROWS := IF THIS(I20_RECEIPT_INVENTORY,ARRAY(rows))
 THEN THIS(I20_RECEIPT_ROWS,rows);
law I20_RECEIPT_ROWS_TAIL := IF THIS(I20_RECEIPT_ROWS,CONS(row,tail))
 THEN THIS(I20_RECEIPT_ROWS,tail);
law I20_RECEIPT_ROWS_BLOCK := IF THIS(I20_RECEIPT_ROWS,CONS(a,CONS(b,CONS(c,CONS(d,CONS(e,CONS(f,CONS(g,CONS(h,tail)))))))))
 THEN THIS(I20_RECEIPT_ROWS,tail);
law I20_RECEIPT_ROW_MEMBER := IF THIS(I20_RECEIPT_ROWS,CONS(ARRAY(CONS(id,CONS(json,NIL))),tail)), GOES_WITH(I20_RUNTIME_RECEIPT,p,h,c,kind,id,json)
 THEN GOES_WITH(I20_RECEIPT_ROW_MEMBER,p,h,ARRAY(CONS(id,CONS(json,NIL))),id,json);
@propose seed I20_HEX_SERIALIZATION := {
 GOES_WITH(I20_HEX_NEXT,B48,B49), GOES_WITH(I20_HEX_NEXT,B49,B50),
 GOES_WITH(I20_HEX_NEXT,B50,B51), GOES_WITH(I20_HEX_NEXT,B51,B52),
 GOES_WITH(I20_HEX_NEXT,B52,B53), GOES_WITH(I20_HEX_NEXT,B53,B54),
 GOES_WITH(I20_HEX_NEXT,B54,B55), GOES_WITH(I20_HEX_NEXT,B55,B56),
 GOES_WITH(I20_HEX_NEXT,B56,B57), GOES_WITH(I20_HEX_NEXT,B57,B97),
 GOES_WITH(I20_HEX_NEXT,B97,B98), GOES_WITH(I20_HEX_NEXT,B98,B99),
 GOES_WITH(I20_HEX_NEXT,B99,B100), GOES_WITH(I20_HEX_NEXT,B100,B101),
 GOES_WITH(I20_HEX_NEXT,B101,B102),
 GOES_WITH(I20_SPAN_DOUBLE,ONE,TWO), GOES_WITH(I20_SPAN_DOUBLE,TWO,FOUR),
 GOES_WITH(I20_SPAN_DOUBLE,FOUR,EIGHT), GOES_WITH(I20_SPAN_DOUBLE,EIGHT,SIXTEEN),
 GOES_WITH(I20_SPAN_DOUBLE,SIXTEEN,THIRTY_TWO), GOES_WITH(I20_SPAN_DOUBLE,THIRTY_TWO,SIXTY_FOUR),
 GOES_WITH(I20_SPAN_DOUBLE,SIXTY_FOUR,ONE_TWENTY_EIGHT), GOES_WITH(I20_SPAN_DOUBLE,ONE_TWENTY_EIGHT,TWO_FIFTY_SIX),
 GOES_WITH(I20_SPAN_DOUBLE,TWO_FIFTY_SIX,FIVE_TWELVE), GOES_WITH(I20_SPAN_DOUBLE,FIVE_TWELVE,TEN_TWENTY_FOUR)
};
law I20_HEX_LESS_ONE := IF GOES_WITH(I20_HEX_NEXT,a,b) THEN GOES_WITH(I20_HEX_LESS,a,b);
law I20_HEX_LESS_MORE := IF GOES_WITH(I20_HEX_LESS,a,b), GOES_WITH(I20_HEX_NEXT,b,c) THEN GOES_WITH(I20_HEX_LESS,a,c);
law I20_RECEIPT_ORDER_REQUEST := IF THIS(I20_RECEIPT_ROWS,CONS(ARRAY(CONS(a,CONS(x,NIL))),CONS(ARRAY(CONS(b,CONS(y,NIL))),tail)))
 THEN THIS(I20_DIGEST_ORDER_REQUEST,a,b);
law I20_DIGEST_ORDER_PREFIX := IF THIS(I20_DIGEST_ORDER_REQUEST,TEXT(CONS(a,x)),TEXT(CONS(a,y)))
 THEN THIS(I20_DIGEST_ORDER_REQUEST,TEXT(x),TEXT(y));
law I20_DIGEST_ORDER_DIFFERENT := IF THIS(I20_DIGEST_ORDER_REQUEST,TEXT(CONS(a,x)),TEXT(CONS(b,y))), GOES_WITH(I20_HEX_LESS,a,b)
 THEN GOES_WITH(I20_DIGEST_LESS,TEXT(CONS(a,x)),TEXT(CONS(b,y)));
law I20_DIGEST_ORDER_EQUAL_PREFIX := IF THIS(I20_DIGEST_ORDER_REQUEST,TEXT(CONS(a,x)),TEXT(CONS(a,y))), GOES_WITH(I20_DIGEST_LESS,TEXT(x),TEXT(y))
 THEN GOES_WITH(I20_DIGEST_LESS,TEXT(CONS(a,x)),TEXT(CONS(a,y)));
law I20_RECEIPT_SPAN_ROW := IF THIS(I20_RECEIPT_ROWS,CONS(a,CONS(b,tail))), GOES_WITH(I20_RECEIPT_ROW_MEMBER,p,h,a,x,aj), GOES_WITH(I20_RECEIPT_ROW_MEMBER,p,h,b,y,bj), GOES_WITH(I20_DIGEST_LESS,x,y)
 THEN GOES_WITH(I20_RECEIPT_SPAN,p,h,ONE,CONS(a,CONS(b,tail)),CONS(b,tail));
law I20_RECEIPT_SPAN_LAST := IF THIS(I20_RECEIPT_ROWS,CONS(a,NIL)), GOES_WITH(I20_RECEIPT_ROW_MEMBER,p,h,a,x,aj)
 THEN GOES_WITH(I20_RECEIPT_SPAN,p,h,ONE,CONS(a,NIL),NIL);
law I20_RECEIPT_SPAN_DOUBLE := IF GOES_WITH(I20_SPAN_DOUBLE,n,m), GOES_WITH(I20_RECEIPT_SPAN,p,h,n,a,b), GOES_WITH(I20_RECEIPT_SPAN,p,h,n,b,c)
 THEN GOES_WITH(I20_RECEIPT_SPAN,p,h,m,a,c);
// Two runtime receipts per each of the complete 720 canonical occurrences.
law I20_RECEIPT_COMPLETE := IF THIS(I20_RECEIPT_INVENTORY,ARRAY(a)), GOES_WITH(I20_RECEIPT_SPAN,p,h,TEN_TWENTY_FOUR,a,b), GOES_WITH(I20_RECEIPT_SPAN,p,h,TWO_FIFTY_SIX,b,c), GOES_WITH(I20_RECEIPT_SPAN,p,h,ONE_TWENTY_EIGHT,c,d), GOES_WITH(I20_RECEIPT_SPAN,p,h,THIRTY_TWO,d,NIL)
 THEN GOES_WITH(I20_RECEIPT_COMPLETE,p,h,a);
law I20_RECEIPT_JSON_END := IF THIS(I20_RECEIPT_ROWS,NIL)
 THEN GOES_WITH(I20_RECEIPT_JSON_SUFFIX,NIL,NIL);
law I20_RECEIPT_JSON_ROW := IF THIS(I20_RECEIPT_ROWS,CONS(ARRAY(CONS(id,CONS(json,NIL))),tail)), GOES_WITH(I20_RECEIPT_JSON_SUFFIX,tail,rows)
 THEN GOES_WITH(I20_RECEIPT_JSON_SUFFIX,CONS(ARRAY(CONS(id,CONS(json,NIL))),tail),CONS(json,rows));
law I20_COMPLETED_JSON := IF GOES_WITH(I20_NEXT_PAYLOAD,p,h,c,COMPLETED(frame,result,NIL)), GOES_WITH(I20_FRAME,p,h,c,frame,fj), GOES_WITH(I20_RESULT_JSON,p,h,c,rj)
 THEN GOES_WITH(I20_COMPLETED_JSON,p,h,c,OBJECT(CONS(MEMBER("admission_receipt",JSON_NULL),CONS(MEMBER("completion_evidence",ARRAY(NIL)),CONS(MEMBER("discharge_receipt",JSON_NULL),CONS(MEMBER("frame",fj),CONS(MEMBER("phase","COMPLETED"),CONS(MEMBER("result",rj),CONS(MEMBER("result_ref",JSON_NULL),NIL)))))))));
law I20_PAYLOAD_JSON_END := IF GOES_WITH(I20_CELL_TAIL,p,h,NIL)
 THEN GOES_WITH(I20_PAYLOAD_JSON_SUFFIX,p,h,NIL,NIL);
law I20_PAYLOAD_JSON_ROW := IF GOES_WITH(I20_CELL_TAIL,p,h,CONS(c,tail)), GOES_WITH(I20_CELL,p,h,c,id), GOES_WITH(I20_COMPLETED_JSON,p,h,c,json), GOES_WITH(I20_PAYLOAD_JSON_SUFFIX,p,h,tail,rows)
 THEN GOES_WITH(I20_PAYLOAD_JSON_SUFFIX,p,h,CONS(c,tail),CONS(MEMBER(id,json),rows));
law I20_SUCCESSOR_JSON := IF GOES_WITH(I20_RUN,p,h,cells), GOES_WITH(I20_SNAPSHOT,p,h,snapshot), GOES_WITH(STEP_FABRIC_RETURN,p,snapshot,next), GOES_WITH(I20_PAYLOAD_JSON_SUFFIX,p,h,cells,payloads), GOES_WITH(I20_RECEIPT_COMPLETE,p,h,receiptrows), GOES_WITH(I20_RECEIPT_JSON_SUFFIX,receiptrows,receipts)
 THEN GOES_WITH(I20_SUCCESSOR_JSON,p,h,next,OBJECT(CONS(MEMBER("outstanding_obligations",ARRAY(NIL)),CONS(MEMBER("payload_states",OBJECT(payloads)),CONS(MEMBER("pending_admissions",ARRAY(NIL)),CONS(MEMBER("pending_input_buffers",ARRAY(NIL)),CONS(MEMBER("receipts",ARRAY(receipts)),CONS(MEMBER("route_states",OBJECT(NIL)),NIL))))))));
