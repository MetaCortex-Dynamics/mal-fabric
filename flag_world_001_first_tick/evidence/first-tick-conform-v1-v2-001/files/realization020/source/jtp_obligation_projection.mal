 GOES_WITH(JO_BYTE_BITS,B221,BITS(THIS,THIS,NO,THIS,THIS,THIS,NO,THIS)),
 GOES_WITH(JO_BYTE_BITS,B222,BITS(THIS,THIS,NO,THIS,THIS,THIS,THIS,NO)),
 GOES_WITH(JO_BYTE_BITS,B223,BITS(THIS,THIS,NO,THIS,THIS,THIS,THIS,THIS)),
 GOES_WITH(JO_BYTE_BITS,B224,BITS(THIS,THIS,THIS,NO,NO,NO,NO,NO)),
 GOES_WITH(JO_BYTE_BITS,B225,BITS(THIS,THIS,THIS,NO,NO,NO,NO,THIS)),
 GOES_WITH(JO_BYTE_BITS,B226,BITS(THIS,THIS,THIS,NO,NO,NO,THIS,NO)),
 GOES_WITH(JO_BYTE_BITS,B227,BITS(THIS,THIS,THIS,NO,NO,NO,THIS,THIS)),
 GOES_WITH(JO_BYTE_BITS,B228,BITS(THIS,THIS,THIS,NO,NO,THIS,NO,NO)),
 GOES_WITH(JO_BYTE_BITS,B229,BITS(THIS,THIS,THIS,NO,NO,THIS,NO,THIS)),
 GOES_WITH(JO_BYTE_BITS,B230,BITS(THIS,THIS,THIS,NO,NO,THIS,THIS,NO)),
 GOES_WITH(JO_BYTE_BITS,B231,BITS(THIS,THIS,THIS,NO,NO,THIS,THIS,THIS)),
 GOES_WITH(JO_BYTE_BITS,B232,BITS(THIS,THIS,THIS,NO,THIS,NO,NO,NO)),
 GOES_WITH(JO_BYTE_BITS,B233,BITS(THIS,THIS,THIS,NO,THIS,NO,NO,THIS)),
 GOES_WITH(JO_BYTE_BITS,B234,BITS(THIS,THIS,THIS,NO,THIS,NO,THIS,NO)),
 GOES_WITH(JO_BYTE_BITS,B235,BITS(THIS,THIS,THIS,NO,THIS,NO,THIS,THIS)),
 GOES_WITH(JO_BYTE_BITS,B236,BITS(THIS,THIS,THIS,NO,THIS,THIS,NO,NO)),
 GOES_WITH(JO_BYTE_BITS,B237,BITS(THIS,THIS,THIS,NO,THIS,THIS,NO,THIS)),
 GOES_WITH(JO_BYTE_BITS,B238,BITS(THIS,THIS,THIS,NO,THIS,THIS,THIS,NO)),
 GOES_WITH(JO_BYTE_BITS,B239,BITS(THIS,THIS,THIS,NO,THIS,THIS,THIS,THIS)),
 GOES_WITH(JO_BYTE_BITS,B240,BITS(THIS,THIS,THIS,THIS,NO,NO,NO,NO)),
 GOES_WITH(JO_BYTE_BITS,B241,BITS(THIS,THIS,THIS,THIS,NO,NO,NO,THIS)),
 GOES_WITH(JO_BYTE_BITS,B242,BITS(THIS,THIS,THIS,THIS,NO,NO,THIS,NO)),
 GOES_WITH(JO_BYTE_BITS,B243,BITS(THIS,THIS,THIS,THIS,NO,NO,THIS,THIS)),
 GOES_WITH(JO_BYTE_BITS,B244,BITS(THIS,THIS,THIS,THIS,NO,THIS,NO,NO)),
 GOES_WITH(JO_BYTE_BITS,B245,BITS(THIS,THIS,THIS,THIS,NO,THIS,NO,THIS)),
 GOES_WITH(JO_BYTE_BITS,B246,BITS(THIS,THIS,THIS,THIS,NO,THIS,THIS,NO)),
 GOES_WITH(JO_BYTE_BITS,B247,BITS(THIS,THIS,THIS,THIS,NO,THIS,THIS,THIS)),
 GOES_WITH(JO_BYTE_BITS,B248,BITS(THIS,THIS,THIS,THIS,THIS,NO,NO,NO)),
 GOES_WITH(JO_BYTE_BITS,B249,BITS(THIS,THIS,THIS,THIS,THIS,NO,NO,THIS)),
 GOES_WITH(JO_BYTE_BITS,B250,BITS(THIS,THIS,THIS,THIS,THIS,NO,THIS,NO)),
 GOES_WITH(JO_BYTE_BITS,B251,BITS(THIS,THIS,THIS,THIS,THIS,NO,THIS,THIS)),
 GOES_WITH(JO_BYTE_BITS,B252,BITS(THIS,THIS,THIS,THIS,THIS,THIS,NO,NO)),
 GOES_WITH(JO_BYTE_BITS,B253,BITS(THIS,THIS,THIS,THIS,THIS,THIS,NO,THIS)),
 GOES_WITH(JO_BYTE_BITS,B254,BITS(THIS,THIS,THIS,THIS,THIS,THIS,THIS,NO)),
 GOES_WITH(JO_BYTE_BITS,B255,BITS(THIS,THIS,THIS,THIS,THIS,THIS,THIS,THIS))
};
@propose seed JO_FIELD_TYPES := {
 GOES_WITH(JO_FIELD_TYPE,MOTIF_ID,U16),
 GOES_WITH(JO_FIELD_TYPE,OPCODE,U8),
 GOES_WITH(JO_FIELD_TYPE,WITNESS_ID,U8),
 GOES_WITH(JO_FIELD_TYPE,VERTEX_ID,U8),
 GOES_WITH(JO_FIELD_TYPE,CAPABILITY,U8),
 GOES_WITH(JO_FIELD_TYPE,LIFECYCLE,U8),
 GOES_WITH(JO_FIELD_TYPE,FLAGS,U8),
 GOES_WITH(JO_FIELD_TYPE,OPERAND_A,U32),
 GOES_WITH(JO_FIELD_TYPE,OPERAND_B,U32),
 GOES_WITH(JO_FIELD_TYPE,CONTEXT,U32),
 GOES_WITH(JO_FIELD_TYPE,RESULT_BITS,U32),
 GOES_WITH(JO_FIELD_TYPE,MACHINE_STATE_NONCE,U64),
 GOES_WITH(JO_FIELD_TYPE,REQUIRED_R_BITMAP,U128),
 GOES_WITH(JO_FIELD_TYPE,OBLIGATION_ID,U256),
 GOES_WITH(JO_FIELD_TYPE,WORLDLINE_FRONTIER_CRC,U32),
 GOES_WITH(JO_FIELD_TYPE,GLOBAL_PRESTATE_CRC,U32),
 GOES_WITH(JO_FIELD_TYPE,AUTHORITY_CONTEXT_CRC,U32),
 GOES_WITH(JO_FIELD_TYPE,REQUIRED_R_BITMAP_CRC,U32),
 GOES_WITH(JO_FIELD_TYPE,POLICY_CRC,U32),
 GOES_WITH(JO_FIELD_TYPE,JUNCTION_ADMISSION,U8),
 GOES_WITH(JO_FIELD_TYPE,TRIAD_STATE,U8),
 GOES_WITH(JO_FIELD_TYPE,FORWARDING_STATE,U8),
 GOES_WITH(JO_FIELD_TYPE,HEALTH,U8),
 GOES_WITH(JO_FIELD_TYPE,GEOMETRY_RESULT_BITS,U32),
 GOES_WITH(JO_FIELD_TYPE,AUTHORITY_FRAME_CRC,U32),
 GOES_WITH(JO_FIELD_TYPE,PERSISTENCE_LIFECYCLE,U8),
 GOES_WITH(JO_FIELD_TYPE,PERSISTENCE_VERB_RESULT,U8),
 GOES_WITH(JO_FIELD_TYPE,SELECTED_SLOT,U8),
 GOES_WITH(JO_FIELD_TYPE,RECORD_INTEGRITY,U8),
 GOES_WITH(JO_FIELD_TYPE,GENERATION,U32),
 GOES_WITH(JO_FIELD_TYPE,RECORD_CRC,U32),
 GOES_WITH(JO_CRC_PARAMETERS,ISO_HDLC,U32(B237,B184,B131,B32),U32(B255,B255,B255,B255),U32(B255,B255,B255,B255))
};

// Width checks are source predicates. Unknown byte identities cannot encode.
law JO_BYTE := IF GOES_WITH(JO_BYTE_BITS,b,bits) THEN THIS(JO_BYTE,b);
law JO_FIELD_REQUEST := IF GOES_WITH(JO_SOURCE_FIELD,k,f,value), GOES_WITH(JO_FIELD_TYPE,f,type)
 THEN THIS(JO_ENCODE_REQUEST,value);
law JO_BYTE_ENCODE := IF THIS(JO_ENCODE_REQUEST,U8(a)), THIS(JO_BYTE,a)
 THEN GOES_WITH(JO_ENCODE,U8(a),BYTES(CONS(a,NIL)));
law JO_U16_ENCODE := IF THIS(JO_ENCODE_REQUEST,U16(a,b)), THIS(JO_BYTE,a), THIS(JO_BYTE,b)
 THEN GOES_WITH(JO_ENCODE,U16(a,b),BYTES(CONS(a,CONS(b,NIL))));
law JO_U32_ENCODE := IF THIS(JO_ENCODE_REQUEST,U32(a,b,c,d)), THIS(JO_BYTE,a), THIS(JO_BYTE,b), THIS(JO_BYTE,c), THIS(JO_BYTE,d)
 THEN GOES_WITH(JO_ENCODE,U32(a,b,c,d),BYTES(CONS(a,CONS(b,CONS(c,CONS(d,NIL))))));
law JO_U8_TYPED := IF GOES_WITH(JO_ENCODE,U8(a),bytes) THEN GOES_WITH(JO_TYPED,U8(a),U8);
law JO_U16_TYPED := IF GOES_WITH(JO_ENCODE,U16(a,b),bytes) THEN GOES_WITH(JO_TYPED,U16(a,b),U16);
law JO_U32_TYPED := IF GOES_WITH(JO_ENCODE,U32(a,b,c,d),bytes) THEN GOES_WITH(JO_TYPED,U32(a,b,c,d),U32);
law JO_U64_CHILD_A := IF THIS(JO_ENCODE_REQUEST,U64(a,b)) THEN THIS(JO_ENCODE_REQUEST,a);
law JO_U64_CHILD_B := IF THIS(JO_ENCODE_REQUEST,U64(a,b)) THEN THIS(JO_ENCODE_REQUEST,b);
law JO_U128_CHILD_A := IF THIS(JO_ENCODE_REQUEST,U128(a,b,c,d)) THEN THIS(JO_ENCODE_REQUEST,a);
law JO_U128_CHILD_B := IF THIS(JO_ENCODE_REQUEST,U128(a,b,c,d)) THEN THIS(JO_ENCODE_REQUEST,b);
law JO_U128_CHILD_C := IF THIS(JO_ENCODE_REQUEST,U128(a,b,c,d)) THEN THIS(JO_ENCODE_REQUEST,c);
law JO_U128_CHILD_D := IF THIS(JO_ENCODE_REQUEST,U128(a,b,c,d)) THEN THIS(JO_ENCODE_REQUEST,d);
law JO_U256_CHILD_A := IF THIS(JO_ENCODE_REQUEST,U256(a,b)) THEN THIS(JO_ENCODE_REQUEST,a);
law JO_U256_CHILD_B := IF THIS(JO_ENCODE_REQUEST,U256(a,b)) THEN THIS(JO_ENCODE_REQUEST,b);
law JO_U64_TYPED := IF THIS(JO_ENCODE_REQUEST,U64(a,b)), GOES_WITH(JO_TYPED,a,U32), GOES_WITH(JO_TYPED,b,U32)
 THEN GOES_WITH(JO_TYPED,U64(a,b),U64);
law JO_U128_TYPED := IF THIS(JO_ENCODE_REQUEST,U128(a,b,c,d)), GOES_WITH(JO_TYPED,a,U32), GOES_WITH(JO_TYPED,b,U32), GOES_WITH(JO_TYPED,c,U32), GOES_WITH(JO_TYPED,d,U32)
 THEN GOES_WITH(JO_TYPED,U128(a,b,c,d),U128);
law JO_U256_TYPED := IF THIS(JO_ENCODE_REQUEST,U256(a,b)), GOES_WITH(JO_TYPED,a,U128), GOES_WITH(JO_TYPED,b,U128)
 THEN GOES_WITH(JO_TYPED,U256(a,b),U256);
law JO_U64_LAYOUT := IF GOES_WITH(JO_TYPED,U64(a,b),U64)
 THEN GOES_WITH(JO_LAYOUT,U64(a,b),SEQUENCE(CONS(a,CONS(b,NIL))));
law JO_U128_LAYOUT := IF GOES_WITH(JO_TYPED,U128(a,b,c,d),U128)
 THEN GOES_WITH(JO_LAYOUT,U128(a,b,c,d),SEQUENCE(CONS(a,CONS(b,CONS(c,CONS(d,NIL))))));
law JO_U256_LAYOUT := IF GOES_WITH(JO_TYPED,U256(a,b),U256)
 THEN GOES_WITH(JO_LAYOUT,U256(a,b),SEQUENCE(CONS(a,CONS(b,NIL))));
law JO_LAYOUT_REQUEST := IF GOES_WITH(JO_LAYOUT,value,sequence) THEN THIS(JO_ENCODE_REQUEST,sequence);
law JO_LAYOUT_ENCODE := IF GOES_WITH(JO_LAYOUT,value,sequence), GOES_WITH(JO_ENCODE,sequence,bytes)
 THEN GOES_WITH(JO_ENCODE,value,bytes);
law JO_FIELD := IF GOES_WITH(JO_SOURCE_FIELD,k,f,value), GOES_WITH(JO_FIELD_TYPE,f,type), GOES_WITH(JO_TYPED,value,type)
 THEN GOES_WITH(JO_FIELD,k,f,value);

// Generic concatenation consumes source-ordered fields and preserves each byte.
law JO_SEQUENCE_ROWS := IF THIS(JO_ENCODE_REQUEST,SEQUENCE(rows)) THEN THIS(JO_SEQUENCE_ROWS,rows);
law JO_SEQUENCE_TAIL := IF THIS(JO_SEQUENCE_ROWS,CONS(a,tail)) THEN THIS(JO_SEQUENCE_ROWS,tail);
law JO_SEQUENCE_ITEM := IF THIS(JO_SEQUENCE_ROWS,CONS(a,tail)) THEN THIS(JO_ENCODE_REQUEST,a);
law JO_SEQUENCE_END := IF THIS(JO_SEQUENCE_ROWS,NIL) THEN GOES_WITH(JO_SEQUENCE_SUFFIX,NIL,NIL);
law JO_SEQUENCE_APPEND_REQUEST := IF THIS(JO_SEQUENCE_ROWS,CONS(a,tail)), GOES_WITH(JO_ENCODE,a,BYTES(head)), GOES_WITH(JO_SEQUENCE_SUFFIX,tail,rest)
 THEN THIS(JO_APPEND_REQUEST,head,rest);
law JO_APPEND_TAIL := IF THIS(JO_APPEND_REQUEST,CONS(a,tail),rest) THEN THIS(JO_APPEND_REQUEST,tail,rest);
law JO_APPEND_END := IF THIS(JO_APPEND_REQUEST,NIL,rest) THEN GOES_WITH(JO_APPEND,NIL,rest,rest);
law JO_APPEND_HEAD := IF THIS(JO_APPEND_REQUEST,CONS(a,tail),rest), GOES_WITH(JO_APPEND,tail,rest,joined)
 THEN GOES_WITH(JO_APPEND,CONS(a,tail),rest,CONS(a,joined));
law JO_SEQUENCE_HEAD := IF THIS(JO_SEQUENCE_ROWS,CONS(a,tail)), GOES_WITH(JO_ENCODE,a,BYTES(head)), GOES_WITH(JO_SEQUENCE_SUFFIX,tail,rest), GOES_WITH(JO_APPEND,head,rest,joined)
 THEN GOES_WITH(JO_SEQUENCE_SUFFIX,CONS(a,tail),joined);
law JO_SEQUENCE_ENCODE := IF THIS(JO_ENCODE_REQUEST,SEQUENCE(rows)), GOES_WITH(JO_SEQUENCE_SUFFIX,rows,bytes)
 THEN GOES_WITH(JO_ENCODE,SEQUENCE(rows),BYTES(bytes));

// section9.2. Exact widths 8+4+4+4+4+8+16+32 =80.
law JO_HEADER_A := IF GOES_WITH(JO_FIELD,k,MOTIF_ID,U16(a,b)), GOES_WITH(JO_FIELD,k,OPCODE,U8(o)), GOES_WITH(JO_FIELD,k,WITNESS_ID,U8(w))
 THEN GOES_WITH(JO_HEADER_A,k,U32(a,b,o,w));
law JO_HEADER_B := IF GOES_WITH(JO_FIELD,k,VERTEX_ID,U8(v)), GOES_WITH(JO_FIELD,k,CAPABILITY,U8(c)), GOES_WITH(JO_FIELD,k,LIFECYCLE,U8(l)), GOES_WITH(JO_FIELD,k,FLAGS,U8(f))
 THEN GOES_WITH(JO_HEADER_B,k,U32(v,c,l,f));
law JO_HEADER := IF GOES_WITH(JO_HEADER_A,k,a), GOES_WITH(JO_HEADER_B,k,b)
 THEN GOES_WITH(JO_HEADER,k,U64(a,b));
law JO_OPERANDS := IF GOES_WITH(JO_FIELD,k,OPERAND_A,a), GOES_WITH(JO_FIELD,k,OPERAND_B,b), GOES_WITH(JO_FIELD,k,CONTEXT,c), GOES_WITH(JO_FIELD,k,RESULT_BITS,r)
 THEN GOES_WITH(JO_OPERANDS,k,VALUES(a,b,c,r));
law JO_LINEAGE := IF GOES_WITH(JO_FIELD,k,MACHINE_STATE_NONCE,n), GOES_WITH(JO_FIELD,k,REQUIRED_R_BITMAP,r), GOES_WITH(JO_FIELD,k,OBLIGATION_ID,i)
 THEN GOES_WITH(JO_LINEAGE,k,LINEAGE(n,r,i));
law JO_OBLIGATION_SEQUENCE := IF GOES_WITH(JO_HEADER,k,h), GOES_WITH(JO_OPERANDS,k,VALUES(a,b,c,r)), GOES_WITH(JO_LINEAGE,k,LINEAGE(n,q,i))
 THEN GOES_WITH(JO_OBLIGATION_SEQUENCE,k,SEQUENCE(CONS(h,CONS(a,CONS(b,CONS(c,CONS(r,CONS(n,CONS(q,CONS(i,NIL))))))))));
law JO_OBLIGATION_REQUEST := IF GOES_WITH(JO_OBLIGATION_SEQUENCE,k,s) THEN THIS(JO_ENCODE_REQUEST,s);
law JO_OBLIGATION_BYTES := IF GOES_WITH(JO_OBLIGATION_SEQUENCE,k,s), GOES_WITH(JO_ENCODE,s,bytes)
 THEN GOES_WITH(JO_OBLIGATION_BYTES,k,bytes);

// section9.3 explicitly requires no result. No missing flag/result is filled.
law JO_KIND_ONE_OBJECT := IF GOES_WITH(JO_OBLIGATION_BYTES,k,bytes), GOES_WITH(JO_FIELD,k,FLAGS,U8(f)), GOES_WITH(JO_BYTE_BITS,f,BITS(a,b,c,d,e,g,h,NO)), GOES_WITH(JO_FIELD,k,RESULT_BITS,U32(B0,B0,B0,B0))
 THEN GOES_WITH(JO_KIND_ONE_OBJECT,k,bytes);
law JO_OBLIGATION_CRC_REQUEST := IF GOES_WITH(JO_KIND_ONE_OBJECT,k,bytes), GOES_WITH(JO_CRC_PARAMETERS,ISO_HDLC,p,i,x)
 THEN GOES_WITH(JO_CRC32_REQUEST,ISO_HDLC,k,OBLIGATION_80,bytes);
law JO_CRC_TYPED_REQUEST := IF GOES_WITH(JO_CRC32_RESPONSE,ISO_HDLC,bytes,crc) THEN THIS(JO_ENCODE_REQUEST,crc);
law JO_OBLIGATION_CRC := IF GOES_WITH(JO_KIND_ONE_OBJECT,k,bytes), GOES_WITH(JO_CRC32_RESPONSE,ISO_HDLC,bytes,crc), GOES_WITH(JO_TYPED,crc,U32)
 THEN GOES_WITH(JO_OBLIGATION_CRC,k,crc);
law JO_AUTHORITY_SUFFIX := IF GOES_WITH(JO_FIELD,k,WORLDLINE_FRONTIER_CRC,w), GOES_WITH(JO_FIELD,k,GLOBAL_PRESTATE_CRC,p), GOES_WITH(JO_FIELD,k,AUTHORITY_CONTEXT_CRC,a), GOES_WITH(JO_FIELD,k,REQUIRED_R_BITMAP_CRC,r), GOES_WITH(JO_FIELD,k,POLICY_CRC,c), GOES_WITH(JO_OBLIGATION_CRC,k,o)
 THEN GOES_WITH(JO_AUTHORITY_SUFFIX,k,SEQUENCE(CONS(w,CONS(p,CONS(a,CONS(r,CONS(c,CONS(o,NIL))))))));
law JO_AUTHORITY_SUFFIX_REQUEST := IF GOES_WITH(JO_AUTHORITY_SUFFIX,k,s) THEN THIS(JO_ENCODE_REQUEST,s);
law JO_AUTHORITY_JOIN := IF GOES_WITH(JO_KIND_ONE_OBJECT,k,BYTES(o)), GOES_WITH(JO_AUTHORITY_SUFFIX,k,s), GOES_WITH(JO_ENCODE,s,BYTES(t))
 THEN THIS(JO_APPEND_REQUEST,o,t);
law JO_AUTHORITY_PAYLOAD := IF GOES_WITH(JO_KIND_ONE_OBJECT,k,BYTES(o)), GOES_WITH(JO_AUTHORITY_SUFFIX,k,s), GOES_WITH(JO_ENCODE,s,BYTES(t)), GOES_WITH(JO_APPEND,o,t,bytes)
 THEN GOES_WITH(JO_AUTHORITY_PAYLOAD,k,BYTES(bytes));

// section9.4: carry the SAME80B, supplied status/result,188B predecessor count,
// and exact obligation CRC. No status or opcode result is invented here.
law JO_GEOMETRY_STATUS := IF GOES_WITH(JO_FIELD,k,JUNCTION_ADMISSION,U8(a)), GOES_WITH(JO_FIELD,k,TRIAD_STATE,U8(t)), GOES_WITH(JO_FIELD,k,FORWARDING_STATE,U8(f)), GOES_WITH(JO_FIELD,k,HEALTH,U8(h))
 THEN GOES_WITH(JO_GEOMETRY_STATUS,k,U32(a,t,f,h));
law JO_GEOMETRY_SUFFIX := IF GOES_WITH(JO_GEOMETRY_STATUS,k,s), GOES_WITH(JO_FIELD,k,GEOMETRY_RESULT_BITS,r), GOES_WITH(JO_FIELD,k,AUTHORITY_FRAME_CRC,a), GOES_WITH(JO_OBLIGATION_CRC,k,o)
 THEN GOES_WITH(JO_GEOMETRY_SUFFIX,k,SEQUENCE(CONS(s,CONS(r,CONS(a,CONS(U16(B0,B188),CONS(o,NIL)))))));
law JO_GEOMETRY_SUFFIX_REQUEST := IF GOES_WITH(JO_GEOMETRY_SUFFIX,k,s) THEN THIS(JO_ENCODE_REQUEST,s);
law JO_GEOMETRY_PREFIX_JOIN := IF GOES_WITH(JO_AUTHORITY_PAYLOAD,k,authority), GOES_WITH(JO_KIND_ONE_OBJECT,k,BYTES(o)), GOES_WITH(JO_GEOMETRY_SUFFIX,k,s), GOES_WITH(JO_ENCODE,s,BYTES(t))
 THEN THIS(JO_APPEND_REQUEST,o,t);
law JO_GEOMETRY_PREFIX := IF GOES_WITH(JO_AUTHORITY_PAYLOAD,k,authority), GOES_WITH(JO_KIND_ONE_OBJECT,k,BYTES(o)), GOES_WITH(JO_GEOMETRY_SUFFIX,k,s), GOES_WITH(JO_ENCODE,s,BYTES(t)), GOES_WITH(JO_APPEND,o,t,bytes)
 THEN GOES_WITH(JO_GEOMETRY_PREFIX,k,BYTES(bytes));
law JO_GEOMETRY_CRC_REQUEST := IF GOES_WITH(JO_GEOMETRY_PREFIX,k,bytes), GOES_WITH(JO_CRC_PARAMETERS,ISO_HDLC,p,i,x)
 THEN GOES_WITH(JO_CRC32_REQUEST,ISO_HDLC,k,GEOMETRY_PREFIX_98,bytes);
law JO_GEOMETRY_CRC := IF GOES_WITH(JO_GEOMETRY_PREFIX,k,bytes), GOES_WITH(JO_CRC32_RESPONSE,ISO_HDLC,bytes,crc), GOES_WITH(JO_TYPED,crc,U32)
 THEN GOES_WITH(JO_GEOMETRY_CRC,k,crc);
law JO_GEOMETRY_JOIN := IF GOES_WITH(JO_GEOMETRY_PREFIX,k,BYTES(prefix)), GOES_WITH(JO_GEOMETRY_CRC,k,crc), GOES_WITH(JO_ENCODE,crc,BYTES(tail))
 THEN THIS(JO_APPEND_REQUEST,prefix,tail);
law JO_GEOMETRY_PAYLOAD := IF GOES_WITH(JO_GEOMETRY_PREFIX,k,BYTES(prefix)), GOES_WITH(JO_GEOMETRY_CRC,k,crc), GOES_WITH(JO_ENCODE,crc,BYTES(tail)), GOES_WITH(JO_APPEND,prefix,tail,bytes)
 THEN GOES_WITH(JO_GEOMETRY_PAYLOAD,k,BYTES(bytes));

// section9.5. These are supplied persistence observations, not synthetic ACKs.
law JO_PERSISTENCE_STATUS := IF GOES_WITH(JO_FIELD,k,PERSISTENCE_LIFECYCLE,U8(l)), GOES_WITH(JO_FIELD,k,PERSISTENCE_VERB_RESULT,U8(v)), GOES_WITH(JO_FIELD,k,SELECTED_SLOT,U8(s)), GOES_WITH(JO_FIELD,k,RECORD_INTEGRITY,U8(i))
 THEN GOES_WITH(JO_PERSISTENCE_STATUS,k,U32(l,v,s,i));
law JO_PERSISTENCE_SEQUENCE := IF GOES_WITH(JO_FIELD,k,OBLIGATION_ID,id), GOES_WITH(JO_PERSISTENCE_STATUS,k,s), GOES_WITH(JO_FIELD,k,GENERATION,g), GOES_WITH(JO_FIELD,k,RECORD_CRC,r), GOES_WITH(JO_OBLIGATION_CRC,k,o)
 THEN GOES_WITH(JO_PERSISTENCE_SEQUENCE,k,SEQUENCE(CONS(id,CONS(s,CONS(g,CONS(r,CONS(o,NIL)))))));
law JO_PERSISTENCE_REQUEST := IF GOES_WITH(JO_PERSISTENCE_SEQUENCE,k,s) THEN THIS(JO_ENCODE_REQUEST,s);
law JO_PERSISTENCE_PAYLOAD := IF GOES_WITH(JO_PERSISTENCE_SEQUENCE,k,s), GOES_WITH(JO_ENCODE,s,bytes)
 THEN GOES_WITH(JO_PERSISTENCE_PAYLOAD,k,bytes);

