// R1: source-owned two-site inputs and the bounded 484+1440 diagnostic offers.
// Candidate diagnostic only. No promoted offer exhaustion, selection, admission,
// worldline append, or current-world write. All verdicts below concern this family.
// Native ancestry: diagnostic008 geometry/distinction; sections009/fibres010
// constant-coordinate assignments; pairs011 sparse receipt/completeness clauses.
// KD_DIFF is the unchanged byte/array distinction fragment of diagnostic008.
// Coverage rows are generic grouping of every native R1_MEMBER, not extra offers.

law R1_FIELD_IMPORT := IF THIS(R1_INPUT_FIELD_ROW,ARRAY(CONS(f,CONS(r,NIL)))) THEN GOES_WITH(R1_SOURCE_FIELD,f,r);
law R1_FLAG := IF GOES_WITH(R1_SOURCE_FIELD,ARRAY(CONS(v,CONS(e,CONS(t,NIL)))),r) THEN GOES_WITH(R1_FLAG,ARRAY(CONS(v,CONS(e,CONS(t,NIL)))),v,e,t);
law R1_WITNESS_IMPORT := IF THIS(R1_INPUT_WITNESS_ROW,ARRAY(CONS(a,CONS(b,CONS(r,NIL))))) THEN GOES_WITH(R1_SOURCE_WITNESS,a,b,r);
law R1_OVERLAP := IF GOES_WITH(R1_SOURCE_WITNESS,a,b,r) THEN GOES_WITH(R1_OVERLAP,a,b);
law R1_DELTA := IF GOES_WITH(R1_OVERLAP,a,b), GOES_WITH(R1_FLAG,a,v,e,t), GOES_WITH(R1_FLAG,b,w,e,t) THEN GOES_WITH(R1_INCIDENT,a,DELTA,a,b);
law R1_GAMMA := IF GOES_WITH(R1_OVERLAP,a,b), GOES_WITH(R1_FLAG,a,v,e,t), GOES_WITH(R1_FLAG,b,v,q,t) THEN GOES_WITH(R1_INCIDENT,a,GAMMA,a,b);
law R1_TAU := IF GOES_WITH(R1_OVERLAP,a,b), GOES_WITH(R1_FLAG,a,v,e,t), GOES_WITH(R1_FLAG,b,v,e,u) THEN GOES_WITH(R1_INCIDENT,a,TAU,a,b);
law R1_INCIDENT_OTHER := IF GOES_WITH(R1_INCIDENT,a,k,a,b) THEN GOES_WITH(R1_INCIDENT,b,k,a,b);
law R1_SITE := IF GOES_WITH(R1_FLAG,f,v,e,t) THEN THIS(R1_SITE,v);
law R1_EDGE := IF GOES_WITH(R1_FLAG,f,v,e,t) THEN THIS(R1_EDGE,e);
law R1_TRIAD := IF GOES_WITH(R1_FLAG,f,v,e,t) THEN THIS(R1_TRIAD,t);
law R1_TWO_SITE_INPUT := IF THIS(R1_EDGE,ARRAY(CONS(v,CONS(w,NIL)))) THEN THIS(R1_INPUT,TWO_SITES(ARRAY(CONS(v,CONS(w,NIL)))));

// The exact 1,924 families are enumerated from incidence, not supplied by host.
law R1_SITE_THIS := IF THIS(R1_SITE,v) THEN THIS(R1_CASE,SITE(v,"THIS"));
law R1_SITE_NO := IF THIS(R1_SITE,v) THEN THIS(R1_CASE,SITE(v,"NO"));
law R1_EDGE_THIS := IF THIS(R1_EDGE,e) THEN THIS(R1_CASE,EDGE(e,"THIS"));
law R1_EDGE_NO := IF THIS(R1_EDGE,e) THEN THIS(R1_CASE,EDGE(e,"NO"));
law R1_TRIAD_THIS := IF THIS(R1_TRIAD,t) THEN THIS(R1_CASE,TRIAD(t,"THIS"));
law R1_TRIAD_NO := IF THIS(R1_TRIAD,t) THEN THIS(R1_CASE,TRIAD(t,"NO"));
law R1_PAIR_THIS := IF GOES_WITH(R1_INCIDENT,a,k,a,b) THEN THIS(R1_CASE,PAIR(k,a,b,"THIS"));
law R1_PAIR_NO := IF GOES_WITH(R1_INCIDENT,a,k,a,b) THEN THIS(R1_CASE,PAIR(k,a,b,"NO"));
law R1_SITE_MEMBER := IF THIS(R1_CASE,SITE(v,r)), GOES_WITH(R1_FLAG,f,v,e,t) THEN GOES_WITH(R1_MEMBER,SITE(v,r),f,r);
law R1_EDGE_MEMBER := IF THIS(R1_CASE,EDGE(e,r)), GOES_WITH(R1_FLAG,f,v,e,t) THEN GOES_WITH(R1_MEMBER,EDGE(e,r),f,r);
law R1_TRIAD_MEMBER := IF THIS(R1_CASE,TRIAD(t,r)), GOES_WITH(R1_FLAG,f,v,e,t) THEN GOES_WITH(R1_MEMBER,TRIAD(t,r),f,r);
law R1_PAIR_MEMBER_A := IF THIS(R1_CASE,PAIR(k,a,b,r)) THEN GOES_WITH(R1_MEMBER,PAIR(k,a,b,r),a,r);
law R1_PAIR_MEMBER_B := IF THIS(R1_CASE,PAIR(k,a,b,r)) THEN GOES_WITH(R1_MEMBER,PAIR(k,a,b,r),b,r);
law R1_AFFECTED := IF GOES_WITH(R1_MEMBER,m,f,r), GOES_WITH(R1_INCIDENT,f,k,a,b) THEN GOES_WITH(R1_AFFECTED,m,a,b);

// G2 is qualification only. TWO_SITES writes both complete site fibres THIS,
// every other flag NO. Original g2 witness statuses never bind new baselines.
law R1_TRIAL_G2 := IF THIS(R1_REQUEST,G2) THEN THIS(R1_TRIAL,G2);
law R1_TRIAL_TWO := IF THIS(R1_REQUEST,TWO_SITES(e)), THIS(R1_INPUT,TWO_SITES(e)) THEN THIS(R1_TRIAL,TWO_SITES(e));
law R1_BASE_G2 := IF THIS(R1_TRIAL,G2), GOES_WITH(R1_SOURCE_FIELD,f,r) THEN GOES_WITH(R1_BASE,G2,f,r);
law R1_BASE_LEFT := IF THIS(R1_TRIAL,TWO_SITES(ARRAY(CONS(v,CONS(w,NIL))))), GOES_WITH(R1_FLAG,f,v,e,t) THEN GOES_WITH(R1_BASE,TWO_SITES(ARRAY(CONS(v,CONS(w,NIL)))),f,"THIS");
law R1_BASE_RIGHT := IF THIS(R1_TRIAL,TWO_SITES(ARRAY(CONS(v,CONS(w,NIL))))), GOES_WITH(R1_FLAG,f,w,e,t) THEN GOES_WITH(R1_BASE,TWO_SITES(ARRAY(CONS(v,CONS(w,NIL)))),f,"THIS");
law R1_BASE_COMPARE_LEFT := IF THIS(R1_TRIAL,TWO_SITES(ARRAY(CONS(v,CONS(w,NIL))))), THIS(R1_SITE,s) THEN GOES_WITH(KD_DIFF_REQUEST,s,v);
law R1_BASE_COMPARE_RIGHT := IF THIS(R1_TRIAL,TWO_SITES(ARRAY(CONS(v,CONS(w,NIL))))), THIS(R1_SITE,s) THEN GOES_WITH(KD_DIFF_REQUEST,s,w);
law R1_BASE_OUTSIDE := IF THIS(R1_TRIAL,TWO_SITES(ARRAY(CONS(v,CONS(w,NIL))))), GOES_WITH(R1_FLAG,f,s,e,t), GOES_WITH(KD_DIFF,s,v), GOES_WITH(KD_DIFF,s,w) THEN GOES_WITH(R1_BASE,TWO_SITES(ARRAY(CONS(v,CONS(w,NIL)))),f,"NO");
law R1_BASE_SAME := IF THIS(R1_TRIAL,i), GOES_WITH(R1_OVERLAP,a,b), GOES_WITH(R1_BASE,i,a,r), GOES_WITH(R1_BASE,i,b,r) THEN GOES_WITH(R1_BASELINE,i,a,b,"SAME");
law R1_BASE_DIFF_A := IF THIS(R1_TRIAL,i), GOES_WITH(R1_OVERLAP,a,b), GOES_WITH(R1_BASE,i,a,"THIS"), GOES_WITH(R1_BASE,i,b,"NO") THEN GOES_WITH(R1_BASELINE,i,a,b,"NOT_SAME");
law R1_BASE_DIFF_B := IF THIS(R1_TRIAL,i), GOES_WITH(R1_OVERLAP,a,b), GOES_WITH(R1_BASE,i,a,"NO"), GOES_WITH(R1_BASE,i,b,"THIS") THEN GOES_WITH(R1_BASELINE,i,a,b,"NOT_SAME");
law R1_OLD_WALL := IF GOES_WITH(R1_BASELINE,i,a,b,"NOT_SAME") THEN GOES_WITH(R1_OLD_WALL,i,a,b);
law R1_G2_WITNESS_BOUND := IF GOES_WITH(R1_BASELINE,G2,a,b,r), GOES_WITH(R1_SOURCE_WITNESS,a,b,r) THEN GOES_WITH(R1_G2_WITNESS_BOUND,a,b,r);

// Only assigned flags may change. Every affected overlap and every old wall
// is evaluated, so all three receipt sets have explicit native witnesses.
law R1_CHECK_AFFECTED := IF GOES_WITH(R1_AFFECTED,m,a,b), GOES_WITH(R1_BASELINE,i,a,b,old) THEN GOES_WITH(R1_CHECK,i,m,a,b,old);
law R1_CHECK_WALL := IF THIS(R1_CASE,m), GOES_WITH(R1_OLD_WALL,i,a,b) THEN GOES_WITH(R1_CHECK,i,m,a,b,"NOT_SAME");
law R1_READ_A := IF GOES_WITH(R1_CHECK,i,m,a,b,old) THEN GOES_WITH(R1_READ,i,m,a);
law R1_READ_B := IF GOES_WITH(R1_CHECK,i,m,a,b,old) THEN GOES_WITH(R1_READ,i,m,b);
law R1_ASSIGNED := IF GOES_WITH(R1_READ,i,m,f), GOES_WITH(R1_MEMBER,m,f,r) THEN GOES_WITH(R1_NEXT,i,m,f,r);
law R1_COMPARE_SITE := IF GOES_WITH(R1_READ,i,SITE(v,r),f), GOES_WITH(R1_FLAG,f,w,e,t) THEN GOES_WITH(KD_DIFF_REQUEST,w,v);
law R1_COMPARE_EDGE := IF GOES_WITH(R1_READ,i,EDGE(e,r),f), GOES_WITH(R1_FLAG,f,v,q,t) THEN GOES_WITH(KD_DIFF_REQUEST,q,e);
law R1_COMPARE_TRIAD := IF GOES_WITH(R1_READ,i,TRIAD(t,r),f), GOES_WITH(R1_FLAG,f,v,e,u) THEN GOES_WITH(KD_DIFF_REQUEST,u,t);
law R1_COMPARE_PAIR_A := IF GOES_WITH(R1_READ,i,PAIR(k,a,b,r),f) THEN GOES_WITH(KD_DIFF_REQUEST,f,a);
law R1_COMPARE_PAIR_B := IF GOES_WITH(R1_READ,i,PAIR(k,a,b,r),f) THEN GOES_WITH(KD_DIFF_REQUEST,f,b);
law R1_RETAIN_SITE := IF GOES_WITH(R1_READ,i,SITE(v,r),f), GOES_WITH(R1_FLAG,f,w,e,t), GOES_WITH(KD_DIFF,w,v), GOES_WITH(R1_BASE,i,f,old) THEN GOES_WITH(R1_NEXT,i,SITE(v,r),f,old);
law R1_RETAIN_EDGE := IF GOES_WITH(R1_READ,i,EDGE(e,r),f), GOES_WITH(R1_FLAG,f,v,q,t), GOES_WITH(KD_DIFF,q,e), GOES_WITH(R1_BASE,i,f,old) THEN GOES_WITH(R1_NEXT,i,EDGE(e,r),f,old);
law R1_RETAIN_TRIAD := IF GOES_WITH(R1_READ,i,TRIAD(t,r),f), GOES_WITH(R1_FLAG,f,v,e,u), GOES_WITH(KD_DIFF,u,t), GOES_WITH(R1_BASE,i,f,old) THEN GOES_WITH(R1_NEXT,i,TRIAD(t,r),f,old);
law R1_RETAIN_PAIR := IF GOES_WITH(R1_READ,i,PAIR(k,a,b,r),f), GOES_WITH(KD_DIFF,f,a), GOES_WITH(KD_DIFF,f,b), GOES_WITH(R1_BASE,i,f,old) THEN GOES_WITH(R1_NEXT,i,PAIR(k,a,b,r),f,old);
law R1_AFTER_SAME := IF GOES_WITH(R1_CHECK,i,m,a,b,old), GOES_WITH(R1_NEXT,i,m,a,r), GOES_WITH(R1_NEXT,i,m,b,r) THEN GOES_WITH(R1_AFTER,i,m,a,b,old,"SAME");
law R1_AFTER_DIFF_A := IF GOES_WITH(R1_CHECK,i,m,a,b,old), GOES_WITH(R1_NEXT,i,m,a,"THIS"), GOES_WITH(R1_NEXT,i,m,b,"NO") THEN GOES_WITH(R1_AFTER,i,m,a,b,old,"NOT_SAME");
law R1_AFTER_DIFF_B := IF GOES_WITH(R1_CHECK,i,m,a,b,old), GOES_WITH(R1_NEXT,i,m,a,"NO"), GOES_WITH(R1_NEXT,i,m,b,"THIS") THEN GOES_WITH(R1_AFTER,i,m,a,b,old,"NOT_SAME");
law R1_OPENED := IF GOES_WITH(R1_AFTER,i,m,a,b,"SAME","NOT_SAME") THEN GOES_WITH(R1_OPENED,i,m,a,b);
law R1_DISCHARGED := IF GOES_WITH(R1_AFTER,i,m,a,b,"NOT_SAME","SAME") THEN GOES_WITH(R1_DISCHARGED,i,m,a,b);
law R1_RETAINED := IF GOES_WITH(R1_AFTER,i,m,a,b,"NOT_SAME","NOT_SAME") THEN GOES_WITH(R1_RETAINED,i,m,a,b);
law R1_NO_OPEN_SAME := IF GOES_WITH(R1_AFTER,i,m,a,b,old,"SAME") THEN GOES_WITH(R1_NO_OPEN,i,m,a,b);
law R1_NO_OPEN_RETAINED := IF GOES_WITH(R1_AFTER,i,m,a,b,"NOT_SAME","NOT_SAME") THEN GOES_WITH(R1_NO_OPEN,i,m,a,b);
law R1_NO_DISCHARGE_SAME := IF GOES_WITH(R1_AFTER,i,m,a,b,"SAME",next) THEN GOES_WITH(R1_NO_DISCHARGE,i,m,a,b);
law R1_NO_DISCHARGE_RETAINED := IF GOES_WITH(R1_AFTER,i,m,a,b,"NOT_SAME","NOT_SAME") THEN GOES_WITH(R1_NO_DISCHARGE,i,m,a,b);

// Generalize PA's two-endpoint proof to the complete native member extent.
law R1_MEMBER_SEEN := IF GOES_WITH(R1_MEMBER,m,f,r), GOES_WITH(R1_INCIDENT,f,k,a,b), GOES_WITH(R1_AFTER,i,m,a,b,old,next) THEN GOES_WITH(R1_MEMBER_SEEN,i,m,f,k);
law R1_MEMBER_COMPLETE := IF GOES_WITH(R1_MEMBER_SEEN,i,m,f,DELTA), GOES_WITH(R1_MEMBER_SEEN,i,m,f,GAMMA), GOES_WITH(R1_MEMBER_SEEN,i,m,f,TAU) THEN GOES_WITH(R1_MEMBER_COMPLETE,i,m,f);
law R1_MEMBER_NO_OPEN_KIND := IF GOES_WITH(R1_MEMBER,m,f,r), GOES_WITH(R1_INCIDENT,f,k,a,b), GOES_WITH(R1_NO_OPEN,i,m,a,b) THEN GOES_WITH(R1_MEMBER_NO_OPEN_KIND,i,m,f,k);
law R1_MEMBER_NO_OPEN := IF GOES_WITH(R1_MEMBER_NO_OPEN_KIND,i,m,f,DELTA), GOES_WITH(R1_MEMBER_NO_OPEN_KIND,i,m,f,GAMMA), GOES_WITH(R1_MEMBER_NO_OPEN_KIND,i,m,f,TAU) THEN GOES_WITH(R1_MEMBER_NO_OPEN,i,m,f);
law R1_MEMBER_NO_DISCHARGE_KIND := IF GOES_WITH(R1_MEMBER,m,f,r), GOES_WITH(R1_INCIDENT,f,k,a,b), GOES_WITH(R1_NO_DISCHARGE,i,m,a,b) THEN GOES_WITH(R1_MEMBER_NO_DISCHARGE_KIND,i,m,f,k);
law R1_MEMBER_NO_DISCHARGE := IF GOES_WITH(R1_MEMBER_NO_DISCHARGE_KIND,i,m,f,DELTA), GOES_WITH(R1_MEMBER_NO_DISCHARGE_KIND,i,m,f,GAMMA), GOES_WITH(R1_MEMBER_NO_DISCHARGE_KIND,i,m,f,TAU) THEN GOES_WITH(R1_MEMBER_NO_DISCHARGE,i,m,f);

// Bounded chunk transport is generic list projection. It never supplies a case,
// field, receipt, completeness fact, exclusion or strict verdict.
law R1_COVER_CHUNK := IF THIS(R1_INPUT_COVER_CHUNK,ARRAY(xs)) THEN THIS(R1_COVER_ROWS,xs);
law R1_COVER_ROW := IF THIS(R1_COVER_ROWS,CONS(row,tail)) THEN THIS(R1_COVER_ROW,row);
law R1_COVER_TAIL := IF THIS(R1_COVER_ROWS,CONS(row,tail)) THEN THIS(R1_COVER_ROWS,tail);
law R1_IMPORT_LEAF := IF THIS(R1_COVER_ROW,LEAF(m,n,f)) THEN GOES_WITH(R1_COVER_LEAF,m,n,f);
law R1_IMPORT_JOIN := IF THIS(R1_COVER_ROW,JOIN(m,n,a,b)) THEN GOES_WITH(R1_COVER_JOIN,m,n,a,b);
law R1_IMPORT_ROOT := IF THIS(R1_COVER_ROW,ROOT(m,n)) THEN GOES_WITH(R1_COVER_ROOT,m,n);
law R1_COVER_LEAF := IF GOES_WITH(R1_COVER_LEAF,m,n,f), GOES_WITH(R1_MEMBER_COMPLETE,i,m,f) THEN GOES_WITH(R1_COVER,i,m,n);
law R1_COVER_JOIN := IF GOES_WITH(R1_COVER_JOIN,m,n,a,b), GOES_WITH(R1_COVER,i,m,a), GOES_WITH(R1_COVER,i,m,b) THEN GOES_WITH(R1_COVER,i,m,n);
law R1_EMPTY_OPEN_LEAF := IF GOES_WITH(R1_COVER_LEAF,m,n,f), GOES_WITH(R1_MEMBER_NO_OPEN,i,m,f) THEN GOES_WITH(R1_EMPTY_OPEN,i,m,n);
law R1_EMPTY_OPEN_JOIN := IF GOES_WITH(R1_COVER_JOIN,m,n,a,b), GOES_WITH(R1_EMPTY_OPEN,i,m,a), GOES_WITH(R1_EMPTY_OPEN,i,m,b) THEN GOES_WITH(R1_EMPTY_OPEN,i,m,n);
law R1_EMPTY_DISCHARGE_LEAF := IF GOES_WITH(R1_COVER_LEAF,m,n,f), GOES_WITH(R1_MEMBER_NO_DISCHARGE,i,m,f) THEN GOES_WITH(R1_EMPTY_DISCHARGE,i,m,n);
law R1_EMPTY_DISCHARGE_JOIN := IF GOES_WITH(R1_COVER_JOIN,m,n,a,b), GOES_WITH(R1_EMPTY_DISCHARGE,i,m,a), GOES_WITH(R1_EMPTY_DISCHARGE,i,m,b) THEN GOES_WITH(R1_EMPTY_DISCHARGE,i,m,n);
law R1_COMPLETE := IF GOES_WITH(R1_COVER_ROOT,m,n), GOES_WITH(R1_COVER,i,m,n) THEN GOES_WITH(R1_COMPLETE,i,m);
law R1_STRICT := IF GOES_WITH(R1_COMPLETE,i,m), GOES_WITH(R1_COVER_ROOT,m,n), GOES_WITH(R1_EMPTY_OPEN,i,m,n), GOES_WITH(R1_DISCHARGED,i,m,a,b) THEN GOES_WITH(R1_STRICT,i,m);
law R1_EXCLUDED_OPEN := IF GOES_WITH(R1_COMPLETE,i,m), GOES_WITH(R1_OPENED,i,m,a,b) THEN GOES_WITH(R1_EXCLUDED_OPEN,i,m,a,b);
law R1_EXCLUDED_EMPTY := IF GOES_WITH(R1_COMPLETE,i,m), GOES_WITH(R1_COVER_ROOT,m,n), GOES_WITH(R1_EMPTY_DISCHARGE,i,m,n) THEN GOES_WITH(R1_EXCLUDED_EMPTY,i,m);
