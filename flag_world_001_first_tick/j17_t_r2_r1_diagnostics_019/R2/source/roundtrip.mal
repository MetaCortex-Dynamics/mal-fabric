// Diagnostic application only. No live-world mutation or inferred entity list.
// All direct SITE delta lifts from a THIS flag to a NO flag are test subjects.
// VD_HARDWARE_SITE_LIFT and VD_OFFERED_* bodies are extracted byte-exact from
// the qualified first-tick realization by run.mjs, not implemented on the host.
law R2_CASE := IF GOES_WITH(CURRENT_FIELD,f,THIS), GOES_WITH(DELTA,f,h), GOES_WITH(CURRENT_FIELD,h,NO)
 THEN GOES_WITH(R2_CASE,f,h);
law R2_OUT_ENTITY := IF GOES_WITH(R2_CASE,f,h) THEN GOES_WITH(VD_SELECTED_ENTITY,OUT(f,h),f,f);
law R2_OUT_TARGET := IF GOES_WITH(R2_CASE,f,TOGETHER_ALONE(v,e,t)) THEN GOES_WITH(VD_TARGET,OUT(f,TOGETHER_ALONE(v,e,t)),SITE,v);
law R2_OUT_SNAPSHOT := IF GOES_WITH(R2_CASE,f,h), GOES_WITH(CURRENT_FIELD,x,r) THEN GOES_WITH(VD_GENESIS_FIELD,OUT(f,h),x,r);
law R2_OUT_OFFERED := IF GOES_WITH(R2_CASE,f,h), GOES_WITH(VD_LIFT_GEOMETRY,OUT(f,h),LIFT(f,f,h))
 THEN GOES_WITH(R2_OFFERED,BRANCH(f,h),OUT,LIFT(f,f,h));
law R2_OUT_FIELD := IF GOES_WITH(R2_OFFERED,BRANCH(f,h),OUT,LIFT(f,f,h)), GOES_WITH(VD_OFFERED_FIELD,OUT(f,h),LIFT(f,f,h),x,r)
 THEN GOES_WITH(R2_FIELD,BRANCH(f,h),OUT,x,r);
law R2_BACK_ENTITY := IF GOES_WITH(R2_OFFERED,BRANCH(f,h),OUT,LIFT(f,f,h)), GOES_WITH(R2_FIELD,BRANCH(f,h),OUT,h,THIS), GOES_WITH(R2_FIELD,BRANCH(f,h),OUT,f,NO)
 THEN GOES_WITH(VD_SELECTED_ENTITY,BACK(f,h),f,h);
law R2_BACK_TARGET := IF GOES_WITH(R2_CASE,TOGETHER_ALONE(v,e,t),h) THEN GOES_WITH(VD_TARGET,BACK(TOGETHER_ALONE(v,e,t),h),SITE,v);
law R2_BACK_SNAPSHOT := IF GOES_WITH(R2_FIELD,BRANCH(f,h),OUT,x,r) THEN GOES_WITH(VD_GENESIS_FIELD,BACK(f,h),x,r);
law R2_BACK_OFFERED := IF GOES_WITH(R2_CASE,f,h), GOES_WITH(VD_LIFT_GEOMETRY,BACK(f,h),LIFT(h,h,f))
 THEN GOES_WITH(R2_OFFERED,BRANCH(f,h),BACK,LIFT(h,h,f));
law R2_BACK_FIELD := IF GOES_WITH(R2_OFFERED,BRANCH(f,h),BACK,LIFT(h,h,f)), GOES_WITH(VD_OFFERED_FIELD,BACK(f,h),LIFT(h,h,f),x,r)
 THEN GOES_WITH(R2_FIELD,BRANCH(f,h),BACK,x,r);
law R2_OUT_GLUING := IF GOES_WITH(R2_CASE,f,h), GOES_WITH(VD_OFFERED_GLUING,OUT(f,h),LIFT(f,f,h),a,b,r) THEN GOES_WITH(R2_GLUING,BRANCH(f,h),OUT,a,b,r);
law R2_BACK_GLUING := IF GOES_WITH(R2_CASE,f,h), GOES_WITH(VD_OFFERED_GLUING,BACK(f,h),LIFT(h,h,f),a,b,r) THEN GOES_WITH(R2_GLUING,BRANCH(f,h),BACK,a,b,r);
law R2_OUT_CHANGE := IF GOES_WITH(R2_CASE,f,h), GOES_WITH(VD_OFFERED_CHANGE,OUT(f,h),LIFT(f,f,h),a,b,r) THEN GOES_WITH(R2_CHANGE,BRANCH(f,h),OUT,a,b,r);
law R2_BACK_CHANGE := IF GOES_WITH(R2_CASE,f,h), GOES_WITH(VD_OFFERED_CHANGE,BACK(f,h),LIFT(h,h,f),a,b,r) THEN GOES_WITH(R2_CHANGE,BRANCH(f,h),BACK,a,b,r);
law R2_ENDPOINT_SAME_SAME := IF GOES_WITH(VD_GENESIS_GLUING,OUT(f,h),a,b,SAME), GOES_WITH(R2_GLUING,BRANCH(f,h),BACK,a,b,SAME) THEN GOES_WITH(R2_CHANGE,BRANCH(f,h),ENDPOINT,a,b,UNCHANGED);
law R2_ENDPOINT_SAME_DIFFER := IF GOES_WITH(VD_GENESIS_GLUING,OUT(f,h),a,b,SAME), GOES_WITH(R2_GLUING,BRANCH(f,h),BACK,a,b,NOT_SAME) THEN GOES_WITH(R2_CHANGE,BRANCH(f,h),ENDPOINT,a,b,OPENED);
law R2_ENDPOINT_DIFFER_SAME := IF GOES_WITH(VD_GENESIS_GLUING,OUT(f,h),a,b,NOT_SAME), GOES_WITH(R2_GLUING,BRANCH(f,h),BACK,a,b,SAME) THEN GOES_WITH(R2_CHANGE,BRANCH(f,h),ENDPOINT,a,b,DISCHARGED);
law R2_ENDPOINT_DIFFER_DIFFER := IF GOES_WITH(VD_GENESIS_GLUING,OUT(f,h),a,b,NOT_SAME), GOES_WITH(R2_GLUING,BRANCH(f,h),BACK,a,b,NOT_SAME) THEN GOES_WITH(R2_CHANGE,BRANCH(f,h),ENDPOINT,a,b,RETAINED_WALL);
// Negative lift control: alias FROM and TO. It must not join the native offers.
law R2_UNOFFERED_REQUEST := IF GOES_WITH(R2_CASE,f,h) THEN GOES_WITH(R2_UNOFFERED_REQUEST,BRANCH(f,h),LIFT(h,h,h));
law R2_UNOFFERED_ACCEPTED := IF GOES_WITH(R2_UNOFFERED_REQUEST,BRANCH(f,h),l), GOES_WITH(VD_LIFT_GEOMETRY,BACK(f,h),l) THEN THIS(R2_UNOFFERED_ACCEPTED,BRANCH(f,h));
// RECEIPT_READING_001, first-tick v0.1.3 lines350-354. Nonempty discharged
// or opened is THIS. NO requires the complete carrier pair tree to have no
// discharged/opened row. Tree order is grouping only, never lift selection.
law R2_READING_DISCHARGED := IF GOES_WITH(R2_CHANGE,c,s,a,b,DISCHARGED) THEN GOES_WITH(R2_RECEIPT_READING,c,s,"THIS");
law R2_READING_OPENED := IF GOES_WITH(R2_CHANGE,c,s,a,b,OPENED) THEN GOES_WITH(R2_RECEIPT_READING,c,s,"THIS");
law R2_EMPTY_LEAF_SAME := IF GOES_WITH(R2_PAIR_LEAF,n,a,b), GOES_WITH(R2_CHANGE,c,s,a,b,UNCHANGED) THEN GOES_WITH(R2_EMPTY_TREE,c,s,n);
law R2_EMPTY_LEAF_RETAINED := IF GOES_WITH(R2_PAIR_LEAF,n,a,b), GOES_WITH(R2_CHANGE,c,s,a,b,RETAINED_WALL) THEN GOES_WITH(R2_EMPTY_TREE,c,s,n);
law R2_EMPTY_JOIN := IF GOES_WITH(R2_PAIR_JOIN,n,a,b), GOES_WITH(R2_EMPTY_TREE,c,s,a), GOES_WITH(R2_EMPTY_TREE,c,s,b) THEN GOES_WITH(R2_EMPTY_TREE,c,s,n);
law R2_READING_EMPTY := IF THIS(R2_PAIR_ROOT,n), GOES_WITH(R2_EMPTY_TREE,c,s,n) THEN GOES_WITH(R2_RECEIPT_READING,c,s,"NO");
