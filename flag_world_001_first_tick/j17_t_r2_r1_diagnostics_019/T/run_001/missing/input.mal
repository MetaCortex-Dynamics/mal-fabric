  GOES_WITH(T_PARENT_TRIAD,T_SOURCE(H_A5729729A8636C16DA1AC84476C6B32E5CD443BE506BE7068CCB53FB57792A8F,H_49F3C4B48F355703BD6959A82995F41ADA517FFBBF7283C217044E5151ABE14A,H_8FF8E9B0EBBDD18445F0E294A3B8B501A2385D5A137C8B00CB6AA090A14205E7),TOGETHER_ALONE(TOGETHER_ALONE(HW_00,HW_03),TOGETHER_ALONE(HW_03,HW_04),THIS(HW_03))),
