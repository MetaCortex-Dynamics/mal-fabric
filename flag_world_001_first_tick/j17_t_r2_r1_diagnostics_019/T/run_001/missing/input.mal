  GOES_WITH(T_PARENT_TRIAD,T_SOURCE(H_A5729729A8636C16DA1AC84476C6B32E5CD443BE506BE7068CCB53FB57792A8F,H_49F3C4B48F355703BD6959A82995F41ADA517FFBBF7283C217044E5151ABE14A,H_8FF8E9B0EBBDD18445F0E294A3B8B501A2385D5A137C8B00CB6AA090A14205E7),TOGETHER_ALONE(TOGETHER_ALONE(HW_07,HW_08),TOGETHER_ALONE(HW_07,HW_11),TOGETHER_ALONE(HW_08,HW_11))),
  GOES_WITH(T_PARENT_TRIAD,T_SOURCE(H_A5729729A8636C16DA1AC84476C6B32E5CD443BE506BE7068CCB53FB57792A8F,H_49F3C4B48F355703BD6959A82995F41ADA517FFBBF7283C217044E5151ABE14A,H_8FF8E9B0EBBDD18445F0E294A3B8B501A2385D5A137C8B00CB6AA090A14205E7),TOGETHER_ALONE(TOGETHER_ALONE(HW_08,HW_09),TOGETHER_ALONE(HW_08,HW_11),TOGETHER_ALONE(HW_09,HW_11))),
  GOES_WITH(T_PARENT_TRIAD,T_SOURCE(H_A5729729A8636C16DA1AC84476C6B32E5CD443BE506BE7068CCB53FB57792A8F,H_49F3C4B48F355703BD6959A82995F41ADA517FFBBF7283C217044E5151ABE14A,H_8FF8E9B0EBBDD18445F0E294A3B8B501A2385D5A137C8B00CB6AA090A14205E7),TOGETHER_ALONE(TOGETHER_ALONE(HW_09,HW_10),TOGETHER_ALONE(HW_09,HW_11),TOGETHER_ALONE(HW_10,HW_11))),
  GOES_WITH(T_PARENT_TRIAD,T_SOURCE(H_A5729729A8636C16DA1AC84476C6B32E5CD443BE506BE7068CCB53FB57792A8F,H_49F3C4B48F355703BD6959A82995F41ADA517FFBBF7283C217044E5151ABE14A,H_8FF8E9B0EBBDD18445F0E294A3B8B501A2385D5A137C8B00CB6AA090A14205E7),TOGETHER_ALONE(TOGETHER_ALONE(HW_00,HW_01),TOGETHER_ALONE(HW_01,HW_02),THIS(HW_01))),
  GOES_WITH(T_PARENT_TRIAD,T_SOURCE(H_A5729729A8636C16DA1AC84476C6B32E5CD443BE506BE7068CCB53FB57792A8F,H_49F3C4B48F355703BD6959A82995F41ADA517FFBBF7283C217044E5151ABE14A,H_8FF8E9B0EBBDD18445F0E294A3B8B501A2385D5A137C8B00CB6AA090A14205E7),TOGETHER_ALONE(TOGETHER_ALONE(HW_00,HW_01),TOGETHER_ALONE(HW_01,HW_05),THIS(HW_01))),
  GOES_WITH(T_PARENT_TRIAD,T_SOURCE(H_A5729729A8636C16DA1AC84476C6B32E5CD443BE506BE7068CCB53FB57792A8F,H_49F3C4B48F355703BD6959A82995F41ADA517FFBBF7283C217044E5151ABE14A,H_8FF8E9B0EBBDD18445F0E294A3B8B501A2385D5A137C8B00CB6AA090A14205E7),TOGETHER_ALONE(TOGETHER_ALONE(HW_00,HW_02),TOGETHER_ALONE(HW_01,HW_02),THIS(HW_02))),
