// Relative orientation transport over the actual T parent/child correspondence.
// The parent tuple supplies a local reference, not a selected global hand.
// The enclosing child record binds the already admitted parent seating/frame.
// These clauses add witnesses; they neither create incidence nor append a world.
// A canonical tuple permutation is recorded separately from geometric transport.

law CT23_ORIENT_A :=
  IF GOES_WITH(T_CHILD_PARENT,ctx,t,TOGETHER_ALONE(a,b,c),CORNER_A), GOES_WITH(T_PARENT_TRIAD,ctx,TOGETHER_ALONE(a,b,c))
  THEN GOES_WITH(CT23_ORIENTATION,ctx,t,TOGETHER_ALONE(a,b,c),CORNER_A,TOGETHER_ALONE(THIS(a),TOGETHER_ALONE(a,b),TOGETHER_ALONE(a,c)));
law CT23_ORIENT_B :=
  IF GOES_WITH(T_CHILD_PARENT,ctx,t,TOGETHER_ALONE(a,b,c),CORNER_B), GOES_WITH(T_PARENT_TRIAD,ctx,TOGETHER_ALONE(a,b,c))
  THEN GOES_WITH(CT23_ORIENTATION,ctx,t,TOGETHER_ALONE(a,b,c),CORNER_B,TOGETHER_ALONE(TOGETHER_ALONE(a,b),THIS(b),TOGETHER_ALONE(b,c)));
law CT23_ORIENT_C :=
  IF GOES_WITH(T_CHILD_PARENT,ctx,t,TOGETHER_ALONE(a,b,c),CORNER_C), GOES_WITH(T_PARENT_TRIAD,ctx,TOGETHER_ALONE(a,b,c))
  THEN GOES_WITH(CT23_ORIENTATION,ctx,t,TOGETHER_ALONE(a,b,c),CORNER_C,TOGETHER_ALONE(TOGETHER_ALONE(a,c),TOGETHER_ALONE(b,c),THIS(c)));
law CT23_ORIENT_CENTRE :=
  IF GOES_WITH(T_CHILD_PARENT,ctx,t,TOGETHER_ALONE(a,b,c),CENTRE), GOES_WITH(T_PARENT_TRIAD,ctx,TOGETHER_ALONE(a,b,c))
  THEN GOES_WITH(CT23_ORIENTATION,ctx,t,TOGETHER_ALONE(a,b,c),CENTRE,TOGETHER_ALONE(TOGETHER_ALONE(a,b),TOGETHER_ALONE(b,c),TOGETHER_ALONE(a,c)));

// PERM_* describes the oriented sequence relative to the canonical child tuple.
// ODD here is serialization parity, not a reflected geometric realization.
law CT23_PERM_ABC :=
  IF GOES_WITH(CT23_ORIENTATION,ctx,TOGETHER_ALONE(a,b,c),p,k,TOGETHER_ALONE(a,b,c)), THIS(TRIAD,TOGETHER_ALONE(a,b,c))
  THEN GOES_WITH(CT23_PERMUTATION,ctx,TOGETHER_ALONE(a,b,c),p,k,PERM_ABC,EVEN);
law CT23_PERM_ACB :=
  IF GOES_WITH(CT23_ORIENTATION,ctx,TOGETHER_ALONE(a,b,c),p,k,TOGETHER_ALONE(a,c,b)), THIS(TRIAD,TOGETHER_ALONE(a,b,c))
  THEN GOES_WITH(CT23_PERMUTATION,ctx,TOGETHER_ALONE(a,b,c),p,k,PERM_ACB,ODD);
law CT23_PERM_BAC :=
  IF GOES_WITH(CT23_ORIENTATION,ctx,TOGETHER_ALONE(a,b,c),p,k,TOGETHER_ALONE(b,a,c)), THIS(TRIAD,TOGETHER_ALONE(a,b,c))
  THEN GOES_WITH(CT23_PERMUTATION,ctx,TOGETHER_ALONE(a,b,c),p,k,PERM_BAC,ODD);
law CT23_PERM_BCA :=
  IF GOES_WITH(CT23_ORIENTATION,ctx,TOGETHER_ALONE(a,b,c),p,k,TOGETHER_ALONE(b,c,a)), THIS(TRIAD,TOGETHER_ALONE(a,b,c))
  THEN GOES_WITH(CT23_PERMUTATION,ctx,TOGETHER_ALONE(a,b,c),p,k,PERM_BCA,EVEN);
law CT23_PERM_CAB :=
  IF GOES_WITH(CT23_ORIENTATION,ctx,TOGETHER_ALONE(a,b,c),p,k,TOGETHER_ALONE(c,a,b)), THIS(TRIAD,TOGETHER_ALONE(a,b,c))
  THEN GOES_WITH(CT23_PERMUTATION,ctx,TOGETHER_ALONE(a,b,c),p,k,PERM_CAB,EVEN);
law CT23_PERM_CBA :=
  IF GOES_WITH(CT23_ORIENTATION,ctx,TOGETHER_ALONE(a,b,c),p,k,TOGETHER_ALONE(c,b,a)), THIS(TRIAD,TOGETHER_ALONE(a,b,c))
  THEN GOES_WITH(CT23_PERMUTATION,ctx,TOGETHER_ALONE(a,b,c),p,k,PERM_CBA,ODD);
