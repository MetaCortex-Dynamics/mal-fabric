export function checkCurrentProcesses(absenceRef,requiredAbsent,nativeExecutables,options={}){
 const binding=generationBinding(),absence=validateAbsence(absenceRef,requiredAbsent);
 for(const r of nativeExecutables)verify(r);
 const root=options.outputDirectory??path.join(home,'invocations');fs.mkdirSync(root,{recursive:true});
 need(path.resolve(fs.realpathSync.native(root)).toLowerCase()===path.resolve(root).toLowerCase(),'GENERATION_DIAGNOSTIC_ALIAS');
 const dir=fs.mkdtempSync(path.join(root,'call_'));
 const start=save(path.join(dir,'START.json'),{schema:'GenerationCensusStart038V1',at:new Date().toISOString(),caller_pid:process.pid,parent_pid:process.ppid,binding,absence:absenceRef,required_absent:requiredAbsent,native_executables:nativeExecutables,timeout_ms:LIMIT_MS,argv:[],retry:'NONE',gpu_execution:'NONE'});
 let r;try{r=spawnSync(binding.helper_executable.path,[],{shell:false,windowsHide:true,encoding:null,timeout:LIMIT_MS,maxBuffer:MAX_BUFFER});}catch(e){r={status:null,signal:null,error:e,pid:0,stdout:Buffer.alloc(0),stderr:Buffer.alloc(0)};}
 const out=Buffer.isBuffer(r.stdout)?r.stdout:Buffer.from(r.stdout??''),err=Buffer.isBuffer(r.stderr)?r.stderr:Buffer.from(r.stderr??'');
 let result=null,rows=null,condition=null;
