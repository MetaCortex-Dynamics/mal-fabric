 }catch(e){condition=e.message;}
 const diagnostic=save(path.join(dir,'DIAGNOSTIC.json'),{schema:'GenerationCensusDiagnostic038V1',verdict:condition?'MAYBE':'IF_THEN',start,at:new Date().toISOString(),helper_pid:r.pid??null,status:r.status??null,signal:r.signal??null,error:r.error?{name:r.error.name,message:r.error.message,code:r.error.code??null}:null,stdout:{bytes:out.length,sha256:sha(out),utf8:out.toString('utf8')},stderr:{bytes:err.length,sha256:sha(err),utf8:err.toString('utf8')},condition,result,rows,absence:absenceRef,absence_cutoff_filetime:absence.cutoff_filetime,retry:'NONE',fallback:'NONE',gpu_execution:'NONE',world_effect:'NONE'});
 if(condition){const e=Error(condition);e.diagnostic=diagnostic;throw e;}
 return{...result,at:new Date().toISOString(),rows,diagnostic,absence:absenceRef,binding};
}

