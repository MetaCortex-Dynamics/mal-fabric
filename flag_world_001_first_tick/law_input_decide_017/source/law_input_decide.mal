// E21/A6 LAW-input reduction over a complete source-bound offer tree.
// Receipt lists are custody inputs, not host verdicts. Tree order is transport.
// Caller checks distinct member identities and complete family custody.
// A result is determination, not PROMOTE, EXECUTE or a grant.
law LD_ROOT := IF GOES_WITH(LD_INPUT,c,t) THEN GOES_WITH(LD_VISIT,c,t);
law LD_LEFT := IF GOES_WITH(LD_VISIT,c,BRANCH(a,b)) THEN GOES_WITH(LD_VISIT,c,a);
law LD_RIGHT := IF GOES_WITH(LD_VISIT,c,BRANCH(a,b)) THEN GOES_WITH(LD_VISIT,c,b);
law LD_EMPTY := IF GOES_WITH(LD_VISIT,c,EMPTY_TREE) THEN GOES_WITH(LD_REDUCED,c,EMPTY_TREE,EMPTY);
law LD_STRICT := IF GOES_WITH(LD_VISIT,c,LEAF(m,CONS(d,ds),NIL)) THEN GOES_WITH(LD_REDUCED,c,LEAF(m,CONS(d,ds),NIL),UNIQUE(m));
law LD_NO_DISCHARGE := IF GOES_WITH(LD_VISIT,c,LEAF(m,NIL,o)) THEN GOES_WITH(LD_REDUCED,c,LEAF(m,NIL,o),EMPTY);
law LD_OPENED := IF GOES_WITH(LD_VISIT,c,LEAF(m,d,CONS(o,os))) THEN GOES_WITH(LD_REDUCED,c,LEAF(m,d,CONS(o,os)),EMPTY);
law LD_MERGE_EMPTY := IF GOES_WITH(LD_VISIT,c,BRANCH(a,b)), GOES_WITH(LD_REDUCED,c,a,EMPTY), GOES_WITH(LD_REDUCED,c,b,EMPTY) THEN GOES_WITH(LD_REDUCED,c,BRANCH(a,b),EMPTY);
law LD_MERGE_LEFT := IF GOES_WITH(LD_VISIT,c,BRANCH(a,b)), GOES_WITH(LD_REDUCED,c,a,UNIQUE(m)), GOES_WITH(LD_REDUCED,c,b,EMPTY) THEN GOES_WITH(LD_REDUCED,c,BRANCH(a,b),UNIQUE(m));
law LD_MERGE_RIGHT := IF GOES_WITH(LD_VISIT,c,BRANCH(a,b)), GOES_WITH(LD_REDUCED,c,a,EMPTY), GOES_WITH(LD_REDUCED,c,b,UNIQUE(m)) THEN GOES_WITH(LD_REDUCED,c,BRANCH(a,b),UNIQUE(m));
law LD_MERGE_TWO := IF GOES_WITH(LD_VISIT,c,BRANCH(a,b)), GOES_WITH(LD_REDUCED,c,a,UNIQUE(m)), GOES_WITH(LD_REDUCED,c,b,UNIQUE(n)) THEN GOES_WITH(LD_REDUCED,c,BRANCH(a,b),MULTIPLE);
law LD_MERGE_MANY_LEFT := IF GOES_WITH(LD_VISIT,c,BRANCH(a,b)), GOES_WITH(LD_REDUCED,c,a,MULTIPLE), GOES_WITH(LD_REDUCED,c,b,s) THEN GOES_WITH(LD_REDUCED,c,BRANCH(a,b),MULTIPLE);
law LD_MERGE_MANY_RIGHT := IF GOES_WITH(LD_VISIT,c,BRANCH(a,b)), GOES_WITH(LD_REDUCED,c,a,s), GOES_WITH(LD_REDUCED,c,b,MULTIPLE) THEN GOES_WITH(LD_REDUCED,c,BRANCH(a,b),MULTIPLE);
law LD_NONE := IF GOES_WITH(LD_INPUT,c,t), GOES_WITH(LD_REDUCED,c,t,EMPTY) THEN GOES_WITH(LD_RESULT,c,NO_ENACTMENT);
law LD_ONE := IF GOES_WITH(LD_INPUT,c,t), GOES_WITH(LD_REDUCED,c,t,UNIQUE(m)) THEN GOES_WITH(LD_RESULT,c,DETERMINED(m));
law LD_MANY := IF GOES_WITH(LD_INPUT,c,t), GOES_WITH(LD_REDUCED,c,t,MULTIPLE) THEN GOES_WITH(LD_RESULT,c,MAYBE);
law LD_MEMBER := IF GOES_WITH(LD_VISIT,c,LEAF(m,CONS(d,ds),NIL)) THEN GOES_WITH(LD_STRICT_MEMBER,c,m);
law LD_GATE := IF GOES_WITH(LD_RESULT,c,DETERMINED(SECTION_READING(id))) THEN GOES_WITH(LD_GATE_DECIDE_INPUT,c,id);
law LD_LIFT := IF GOES_WITH(LD_RESULT,c,DETERMINED(A3_LIFT(id))) THEN GOES_WITH(LD_LIFT_DECIDE_INPUT,c,id);
