// Recorded native-relation contact, implementation 018.
// SPEC_MAL_SPECIFICATION_SYSTEM_002 :56,61-62,91-93,171-173;
// FF85EE5F18813F7D64CE7BF275EBEA2F1FF581B32431D232FA4FD2B5B4E7E093.
// Positive contacts to an actual rule/application record, not a field-name
// classifier or a theorem extracting arbitrary prose. Transport preserves
// source/map/readback and named law/parent identities. No FOR_WHAT is inferred.
// The two application checks below reproduce the operand joins of SC_SITE_NO
// and SC_STRICT in source 80CBE260C40FA58B5E5A70C557FF102428EC4036F5064446F143650196DEC2A1.
// They do not re-run the historical derivation or create its admission witness.
// Missing record, law, parent or reference withholds the contact. Role labels
// cannot supply a derivation. PROMOTE's recorded tuple is not a native firing.
// Multiple application contacts retain distinct relation identifiers; a
// consumer cannot choose the first payload at an operator/witness coordinate.

law RD_CASE_INSTANCE := IF GOES_WITH(RD_APPLICATION,s,f,l,THIS(SC_CASE,SITE(v,"NO")),CONS(parent,NIL)), GOES_WITH(RD_RULE_NAME,s,l,SC_SITE_NO), GOES_WITH(RD_FACT,s,parent,THIS(SC_SITE,v)) THEN GOES_WITH(RD_SUPPORTED,s,f,l);
law RD_STRICT_INSTANCE := IF GOES_WITH(RD_APPLICATION,s,f,l,THIS(SC_STRICT,m),CONS(p1,CONS(p2,CONS(p3,CONS(p4,NIL))))), GOES_WITH(RD_RULE_NAME,s,l,SC_STRICT), GOES_WITH(RD_FACT,s,p1,THIS(SC_COMPLETE,m)), GOES_WITH(RD_FACT,s,p2,THIS(SC_COVER_ROOT,root)), GOES_WITH(RD_FACT,s,p3,GOES_WITH(SC_EMPTY_OPEN,m,root)), GOES_WITH(RD_FACT,s,p4,GOES_WITH(SC_DISCHARGED,m,a,b)) THEN GOES_WITH(RD_SUPPORTED,s,f,l);

// OWNER declares the source-bound subject restriction independently of content.
// RULE carries the complete source-map antecedent AST and single consequent.
// FACT transports both fact identity and term, including every concrete parent.
law RD_OPEN := IF GOES_WITH(RD_OWNER,p,r,s,f), GOES_WITH(RD_SUPPORTED,s,f,l), GOES_WITH(RD_APPLICATION,s,f,l,c,ps), GOES_WITH(RD_FACT,s,f,c), GOES_WITH(RD_RULE,s,l,CONS(a,aa),z) THEN GOES_WITH(RD_APPLICATION_CONTACT,RD_CONTEXT(p,r,s,f,l,c,ps),CONS(a,aa),z);
law RD_PARENTS_BEGIN := IF GOES_WITH(RD_APPLICATION_CONTACT,RD_CONTEXT(p,r,s,f,l,c,ps),aa,z) THEN GOES_WITH(RD_PARENT_SCAN,RD_CONTEXT(p,r,s,f,l,c,ps),aa,ps);
law RD_PARENT_STEP := IF GOES_WITH(RD_PARENT_SCAN,RD_CONTEXT(p,r,s,f,l,c,ps),CONS(a,aa),CONS(parent,pp)), GOES_WITH(RD_FACT,s,parent,t) THEN GOES_WITH(RD_PARENT_SCAN,RD_CONTEXT(p,r,s,f,l,c,ps),aa,pp);
law RD_PARENTS_END := IF GOES_WITH(RD_PARENT_SCAN,RD_CONTEXT(p,r,s,f,l,c,ps),NIL,NIL) THEN GOES_WITH(RD_COMPLETE,RD_CONTEXT(p,r,s,f,l,c,ps));

// Rule and application references are separate content subjects, both bound to
// all their operands. Neither replaces the member's identity or grants authority.
law RD_RULE_READING := IF GOES_WITH(RD_COMPLETE,RD_CONTEXT(p,r,s,f,l,c,ps)), GOES_WITH(RD_APPLICATION_CONTACT,RD_CONTEXT(p,r,s,f,l,c,ps),aa,z), GOES_WITH(RD_RULE_CONTENT,s,l,aa,z,PRESENT(bits)) THEN GOES_WITH(RD_CONTACT,p,r,RD_RELATION(s,f),POSITION(IF_THEN,WHAT),RULE_RELATION,"IF_THEN",PRESENT(bits));
law RD_PROOF_READING := IF GOES_WITH(RD_COMPLETE,RD_CONTEXT(p,r,s,f,l,c,ps)), GOES_WITH(RD_PROOF_CONTENT,s,f,l,c,ps,PRESENT(bits)) THEN GOES_WITH(RD_CONTACT,p,r,RD_RELATION(s,f),POSITION(BECAUSE,HOW),APPLICATION_PROVENANCE,"IF_THEN",PRESENT(bits));

// R4 normalizes verdicts only; the relation identifier keeps independent
// contact subjects distinct. No derived content reference is manufactured.
law RD_NORMALIZE := IF GOES_WITH(RD_CONTACT,p,r,k,POSITION(o,b),ty,v,ref) THEN GOES_WITH(P15_SEED,RD_SUBJECT(p,r,k),POSITION(o,b),v,ref);

// A topology party is an additional supplied binding, never inferred from a
// successful contact. The restriction component checks its visibility/grants.
law RD_AUTHORITY_INPUT := IF GOES_WITH(RD_CONTACT,p,r,k,pos,ty,v,ref), GOES_WITH(RD_AUTHORITY_PARTY,p,r,k,party) THEN GOES_WITH(AR_CONTACT,party,pos,ty,v,ref);

// Authority/topology restriction implementation candidate 018.
// Contract contact: SPEC-JUNCTION-001 v0.3 :417-426,437-446,463-466,759-772,
// SHA256 9A82BC60519DBA3793C66ED51A31501C953D4B2016F5F96D02710C6BEEB6BAB3.
// This implementation consumes custody-bound declarations; it does not issue,
// authenticate or infer grants, topology, participant roles or overlap rows.
// No default topology, synthetic grant, seal, GlobalSection, admission or effect.
// No BECAUSE-private rule. Ownership and content equality do not set visibility.
// Operator and witness remain separate keys; no witness-only ordinal collapse.
//
// Explicit input contract (each row is GOES_WITH):
// AR_PAIR(AR_CONTEXT(topology,scope,pairId),leftParty,rightParty).
//   party := AR_PARTICIPANT(participant,record,role,grant).
// AR_TYPE(topology,role,POSITION(operator,witness),payloadType).
// AR_VISIBILITY(topology,scope,participant,role,position,SHARED|LOCAL_ONLY).
// AR_GRANT(grant,participant,record,role,topology,scope).
// AR_GRANT_POSITION(grant,position).
// AR_CONTACT(party,position,payloadType,verdict,PRESENT(bits)|ABSENT).
// AR_OVERLAP(AR_CONTEXT(topology,scope,pairId),position,leftType,rightType).
// Types are topology-owned, never supplied as a per-contact type override.
// Endpoint types may differ only as explicitly named by the overlap row;
// comparison is exact reference-content comparison, not a type coercion.
//
// AR_PROJECTABLE and AR_SHARED depend on declarations, not contact contents.
// Missing input withholds its dependent conclusion. Missing contact is pending
// observationally; it does not emit LOCAL_ONLY, private, NO, or a wall.
// Explicit ABSENT is preserved for the unchanged 014 comparator's MAYBE branch.
// AR_LOCAL_* is separate local custody, never projected or sent to comparison.
// Unshared is not private: every SHARED/granted contact remains projected even
// without an overlap row. Do not put AR_LOCAL_CONTACT into a public section union.
//
// Positive closure limitation: contradictory SHARED/LOCAL_ONLY declarations
// emit AR_VISIBILITY_CONFLICT but do not retract other derived observations.
// This component does not certify uniqueness/consistency of input tables or
// authorize effects from its observations. Unknown enum values withhold typing.

@propose seed AR_FIXED_TYPES := {
  GOES_WITH(AR_OPERATOR,THIS), GOES_WITH(AR_OPERATOR,SAME_NOT_SAME),
  GOES_WITH(AR_OPERATOR,NO), GOES_WITH(AR_OPERATOR,IF_THEN),
  GOES_WITH(AR_OPERATOR,BECAUSE), GOES_WITH(AR_OPERATOR,INSIDE_OUTSIDE),
  GOES_WITH(AR_OPERATOR,NEAR_FAR), GOES_WITH(AR_OPERATOR,CAN_CANNOT),
  GOES_WITH(AR_OPERATOR,MAYBE), GOES_WITH(AR_OPERATOR,MUST_LET),
  GOES_WITH(AR_OPERATOR,TOGETHER_ALONE), GOES_WITH(AR_OPERATOR,MORE_LESS),
  GOES_WITH(AR_OPERATOR,GOES_WITH), GOES_WITH(AR_OPERATOR,MANY_ONE),
  GOES_WITH(AR_OPERATOR,EVERY_SOME),
  GOES_WITH(AR_WITNESS,WHAT), GOES_WITH(AR_WITNESS,HOW),
  GOES_WITH(AR_WITNESS,FOR_WHAT), GOES_WITH(AR_WITNESS,WHERE),
  GOES_WITH(AR_WITNESS,WHICH), GOES_WITH(AR_WITNESS,WHEN),
  GOES_WITH(AR_WITNESS,WHENCE),
  GOES_WITH(AR_ROLE,PROPOSE), GOES_WITH(AR_ROLE,DECIDE),
  GOES_WITH(AR_ROLE,PROMOTE), GOES_WITH(AR_ROLE,EXECUTE),
  GOES_WITH(AR_VERDICT,"IF_THEN"), GOES_WITH(AR_VERDICT,"NOT_SAME"),
  GOES_WITH(AR_VERDICT,"NO"), GOES_WITH(AR_VERDICT,"MAYBE")
};

law AR_LEFT_PARTY := IF GOES_WITH(AR_PAIR,c,l,r) THEN GOES_WITH(AR_PARTY,c,l);
law AR_RIGHT_PARTY := IF GOES_WITH(AR_PAIR,c,l,r) THEN GOES_WITH(AR_PARTY,c,r);

law AR_TOPOLOGY_TYPE := IF GOES_WITH(AR_PARTY,AR_CONTEXT(t,s,k),AR_PARTICIPANT(p,r,a,g)), GOES_WITH(AR_TYPE,t,a,POSITION(o,w),ty), GOES_WITH(AR_ROLE,a), GOES_WITH(AR_OPERATOR,o), GOES_WITH(AR_WITNESS,w) THEN GOES_WITH(AR_TYPED,AR_CONTEXT(t,s,k),AR_PARTICIPANT(p,r,a,g),POSITION(o,w),ty);
law AR_BOUND_GRANT := IF GOES_WITH(AR_PARTY,AR_CONTEXT(t,s,k),AR_PARTICIPANT(p,r,a,g)), GOES_WITH(AR_GRANT,g,p,r,a,t,s), GOES_WITH(AR_ROLE,a) THEN GOES_WITH(AR_SCOPE_GRANTED,AR_CONTEXT(t,s,k),AR_PARTICIPANT(p,r,a,g));

law AR_VISIBLE_GRANTED_POSITION := IF GOES_WITH(AR_TYPED,AR_CONTEXT(t,s,k),AR_PARTICIPANT(p,r,a,g),pos,ty), GOES_WITH(AR_VISIBILITY,t,s,p,a,pos,SHARED), GOES_WITH(AR_SCOPE_GRANTED,AR_CONTEXT(t,s,k),AR_PARTICIPANT(p,r,a,g)), GOES_WITH(AR_GRANT_POSITION,g,pos) THEN GOES_WITH(AR_PROJECTABLE,AR_CONTEXT(t,s,k),AR_PARTICIPANT(p,r,a,g),pos,ty);
law AR_EXPLICIT_LOCAL_POSITION := IF GOES_WITH(AR_TYPED,AR_CONTEXT(t,s,k),AR_PARTICIPANT(p,r,a,g),pos,ty), GOES_WITH(AR_VISIBILITY,t,s,p,a,pos,LOCAL_ONLY) THEN GOES_WITH(AR_LOCAL_POSITION,AR_CONTEXT(t,s,k),AR_PARTICIPANT(p,r,a,g),pos,ty);
law AR_CONTRADICTORY_VISIBILITY := IF GOES_WITH(AR_TYPED,AR_CONTEXT(t,s,k),AR_PARTICIPANT(p,r,a,g),pos,ty), GOES_WITH(AR_VISIBILITY,t,s,p,a,pos,SHARED), GOES_WITH(AR_VISIBILITY,t,s,p,a,pos,LOCAL_ONLY) THEN GOES_WITH(AR_VISIBILITY_CONFLICT,AR_CONTEXT(t,s,k),AR_PARTICIPANT(p,r,a,g),pos,ty);

law AR_PROJECT_PRESENT := IF GOES_WITH(AR_PROJECTABLE,c,p,pos,ty), GOES_WITH(AR_CONTACT,p,pos,ty,v,PRESENT(bits)), GOES_WITH(AR_VERDICT,v) THEN GOES_WITH(AR_PROJECTED_CONTACT,c,p,pos,ty,v,PRESENT(bits));
law AR_PROJECT_ABSENT := IF GOES_WITH(AR_PROJECTABLE,c,p,pos,ty), GOES_WITH(AR_CONTACT,p,pos,ty,v,ABSENT), GOES_WITH(AR_VERDICT,v) THEN GOES_WITH(AR_PROJECTED_CONTACT,c,p,pos,ty,v,ABSENT);
law AR_RETAIN_LOCAL_PRESENT := IF GOES_WITH(AR_LOCAL_POSITION,c,p,pos,ty), GOES_WITH(AR_CONTACT,p,pos,ty,v,PRESENT(bits)), GOES_WITH(AR_VERDICT,v) THEN GOES_WITH(AR_LOCAL_CONTACT,c,p,pos,ty,v,PRESENT(bits));
law AR_RETAIN_LOCAL_ABSENT := IF GOES_WITH(AR_LOCAL_POSITION,c,p,pos,ty), GOES_WITH(AR_CONTACT,p,pos,ty,v,ABSENT), GOES_WITH(AR_VERDICT,v) THEN GOES_WITH(AR_LOCAL_CONTACT,c,p,pos,ty,v,ABSENT);

// Expected shared domain is present even when either CONTACT is missing.
law AR_DECLARED_SHARED_DOMAIN := IF GOES_WITH(AR_PAIR,c,l,r), GOES_WITH(AR_OVERLAP,c,pos,lt,rt), GOES_WITH(AR_PROJECTABLE,c,l,pos,lt), GOES_WITH(AR_PROJECTABLE,c,r,pos,rt) THEN GOES_WITH(AR_SHARED,c,l,r,pos,lt,rt);
law AR_COMPARE_DECLARED_OVERLAP := IF GOES_WITH(AR_SHARED,c,l,r,pos,lt,rt), GOES_WITH(AR_PROJECTED_CONTACT,c,l,pos,lt,lv,lr), GOES_WITH(AR_PROJECTED_CONTACT,c,r,pos,rt,rv,rr) THEN GOES_WITH(GJC_REQUEST,AR_COMPARE_CONTEXT(c,l,r,lt,rt),pos,lr,rr);

// Producer-side projection interface, implementation candidate 015.
// AUTHOR declarations are inputs owned by the named producer and bound to
// its record/domain identities. This source does not assign those declarations.
// Three role-specific emitters preserve that ownership; none promotes law.
// R4 consumes verdicts only. Reference content remains at its declared basis
// coordinate, never copied into a derived witness as an invented payload.
// No LocalSection seal, GlobalSection admission, grant, or EXECUTE is emitted.
// Scope: comparison and normalization interface, NOT an authorization boundary
// or general schema validator. Contradictory domain declarations are named;
// this positive closure does not retract other observations when they appear.

@propose seed P15_FIXED_TYPES := {
  GOES_WITH(P15_OPERATOR,THIS), GOES_WITH(P15_OPERATOR,SAME_NOT_SAME),
  GOES_WITH(P15_OPERATOR,NO), GOES_WITH(P15_OPERATOR,IF_THEN),
  GOES_WITH(P15_OPERATOR,BECAUSE), GOES_WITH(P15_OPERATOR,INSIDE_OUTSIDE),
  GOES_WITH(P15_OPERATOR,NEAR_FAR), GOES_WITH(P15_OPERATOR,CAN_CANNOT),
  GOES_WITH(P15_OPERATOR,MAYBE), GOES_WITH(P15_OPERATOR,MUST_LET),
  GOES_WITH(P15_OPERATOR,TOGETHER_ALONE), GOES_WITH(P15_OPERATOR,MORE_LESS),
  GOES_WITH(P15_OPERATOR,GOES_WITH), GOES_WITH(P15_OPERATOR,MANY_ONE),
  GOES_WITH(P15_OPERATOR,EVERY_SOME),
  GOES_WITH(P15_BASIS,WHAT), GOES_WITH(P15_BASIS,HOW), GOES_WITH(P15_BASIS,FOR_WHAT),
  GOES_WITH(P15_VERDICT,"IF_THEN"), GOES_WITH(P15_VERDICT,"NOT_SAME"),
  GOES_WITH(P15_VERDICT,"NO"), GOES_WITH(P15_VERDICT,"MAYBE"),
  GOES_WITH(P15_DOMAIN_STATUS,SUPPORTED), GOES_WITH(P15_DOMAIN_STATUS,UNSUPPORTED)
};

law P15_PROPOSE_OWNER := IF GOES_WITH(P15_PRODUCER,p,PROPOSE,r,d) THEN GOES_WITH(P15_OWNER,p,r,d);
law P15_DECIDE_OWNER := IF GOES_WITH(P15_PRODUCER,p,DECIDE,r,d) THEN GOES_WITH(P15_OWNER,p,r,d);
law P15_PROMOTE_OWNER := IF GOES_WITH(P15_PRODUCER,p,PROMOTE,r,d) THEN GOES_WITH(P15_OWNER,p,r,d);

law P15_DOMAIN_FROM_OWNER := IF GOES_WITH(P15_OWNER,p,r,d), GOES_WITH(P15_DECLARE,p,d,POSITION(o,w),s), GOES_WITH(P15_OPERATOR,o), GOES_WITH(P15_BASIS,w), GOES_WITH(P15_DOMAIN_STATUS,s) THEN GOES_WITH(P15_DOMAIN,p,d,POSITION(o,w),s);
law P15_PRESENT_CONTACT := IF GOES_WITH(P15_OWNER,p,r,d), GOES_WITH(P15_DOMAIN,p,d,pos,SUPPORTED), GOES_WITH(P15_CONTACT,p,r,pos,v,PRESENT(bits)), GOES_WITH(P15_VERDICT,v) THEN GOES_WITH(P15_SEED,p,pos,v,PRESENT(bits));
law P15_ABSENT_CONTACT := IF GOES_WITH(P15_OWNER,p,r,d), GOES_WITH(P15_DOMAIN,p,d,pos,SUPPORTED), GOES_WITH(P15_CONTACT,p,r,pos,v,ABSENT), GOES_WITH(P15_VERDICT,v) THEN GOES_WITH(P15_SEED,p,pos,v,ABSENT);
law P15_UNSUPPORTED_PENDING := IF GOES_WITH(P15_DOMAIN,p,d,pos,UNSUPPORTED) THEN GOES_WITH(P15_PENDING,p,pos);
law P15_CONTRADICTORY_DOMAIN := IF GOES_WITH(P15_DOMAIN,p,d,pos,SUPPORTED), GOES_WITH(P15_DOMAIN,p,d,pos,UNSUPPORTED) THEN GOES_WITH(P15_DOMAIN_CONFLICT,p,d,pos);

// The shared-domain witness is independent of both payload values and their
// availability. Explicit UNSUPPORTED, not absent content, witnesses private
// domain membership relative to the other producer.
law P15_DOMAIN_INTERSECTION := IF GOES_WITH(P15_PAIR,c,p,q), GOES_WITH(P15_DOMAIN,p,dp,pos,SUPPORTED), GOES_WITH(P15_DOMAIN,q,dq,pos,SUPPORTED) THEN GOES_WITH(P15_SHARED,c,p,q,pos);
law P15_LEFT_PRIVATE := IF GOES_WITH(P15_PAIR,c,p,q), GOES_WITH(P15_DOMAIN,p,dp,pos,SUPPORTED), GOES_WITH(P15_DOMAIN,q,dq,pos,UNSUPPORTED) THEN GOES_WITH(P15_PRIVATE,PAIR_CONTEXT(c,p,q),p,pos);
law P15_RIGHT_PRIVATE := IF GOES_WITH(P15_PAIR,c,p,q), GOES_WITH(P15_DOMAIN,p,dp,pos,UNSUPPORTED), GOES_WITH(P15_DOMAIN,q,dq,pos,SUPPORTED) THEN GOES_WITH(P15_PRIVATE,PAIR_CONTEXT(c,p,q),q,pos);
law P15_BOTH_OUTSIDE := IF GOES_WITH(P15_PAIR,c,p,q), GOES_WITH(P15_DOMAIN,p,dp,pos,UNSUPPORTED), GOES_WITH(P15_DOMAIN,q,dq,pos,UNSUPPORTED) THEN GOES_WITH(P15_OUTSIDE_BOTH,PAIR_CONTEXT(c,p,q),pos);

// Only shared positions reach the unchanged 014 comparator. Verdicts are not
// converted to content. Missing CONTACT leaves comparison pending; an explicit
// ABSENT reference reaches 014's MAYBE branch without becoming a wall.
law P15_SHARED_CONTENT := IF GOES_WITH(P15_SHARED,c,p,q,pos), GOES_WITH(P15_SEED,p,pos,vp,lp), GOES_WITH(P15_SEED,q,pos,vq,rq) THEN GOES_WITH(GJC_REQUEST,PAIR_CONTEXT(c,p,q),pos,lp,rq);

// Producer projection 015: verdict-only R4 normalization implementation candidate.
// Bound correspondence: witness_basis_normalizer_r4.mal, SHA256
// 3B9480414D1A2A61F7F976993E713811EBFD3FEBEAD1F7878ACA8CF848BA048F.
// BINDING_RECORD.md, SHA256
// CA4865B47A3FF7866A14392A1C1F16CBC3170DC43B6177DD0C24B123CA72B7D7.
// Input: GOES_WITH(P15_SEED,producer,POSITION(operator,basis),verdict,reference).
// The surrounding component supplies the fixed P15_OPERATOR, P15_BASIS and
// P15_VERDICT enum facts. Operators and witnesses are bare constructors;
// verdicts are the quoted readings "IF_THEN", "NOT_SAME", "NO", "MAYBE".
// References remain opaque input support. They are neither normalized nor
// copied into a derived witness. This component computes no content projection,
// shared/private partition, seed assignment, promotion, seal or admission.
// Missing inputs produce no derived conclusion; absence is never converted to NO.
// Partial indexed inputs are consumed independently. This is not a full-map
// schema or single-reading-per-coordinate validator.
// P15_DERIVED witnesses partial R1/R2 closure, not complete-map normalization.
// No complete-normal-form terminal is emitted; full-map coverage is observed separately.
// R1: WHERE = WHAT, WHICH = WHAT, WHEN = HOW.
// R2: WHENCE = WHAT meet (WHAT meet (HOW meet (FOR_WHAT meet why_F))),
// where why_F is this same producer's FOR_WHAT(BECAUSE).
// The full input-reading tuple is retained in each intermediate context.
// Native support custody links the derived verdicts to the original seeds.

law P15_R4_ACCEPT_SEED := IF GOES_WITH(P15_SEED,p,POSITION(o,b),v,r), GOES_WITH(P15_OPERATOR,o), GOES_WITH(P15_BASIS,b), GOES_WITH(P15_VERDICT,v) THEN GOES_WITH(P15_R4_INPUT,p,POSITION(o,b),v);

law P15_R4_WHERE := IF GOES_WITH(P15_R4_INPUT,p,POSITION(o,WHAT),v) THEN GOES_WITH(P15_DERIVED,p,POSITION(o,WHERE),v);
law P15_R4_WHICH := IF GOES_WITH(P15_R4_INPUT,p,POSITION(o,WHAT),v) THEN GOES_WITH(P15_DERIVED,p,POSITION(o,WHICH),v);
law P15_R4_WHEN := IF GOES_WITH(P15_R4_INPUT,p,POSITION(o,HOW),v) THEN GOES_WITH(P15_DERIVED,p,POSITION(o,WHEN),v);

// Explicit four-by-four meet table: NO < MAYBE < NOT_SAME < IF_THEN.
law P15_R4_MEET_IF_THEN_IF_THEN := IF GOES_WITH(P15_R4_MEET_REQUEST,p,c,"IF_THEN","IF_THEN") THEN GOES_WITH(P15_R4_MEET_RESULT,p,c,"IF_THEN","IF_THEN","IF_THEN");
law P15_R4_MEET_IF_THEN_NOT_SAME := IF GOES_WITH(P15_R4_MEET_REQUEST,p,c,"IF_THEN","NOT_SAME") THEN GOES_WITH(P15_R4_MEET_RESULT,p,c,"IF_THEN","NOT_SAME","NOT_SAME");
law P15_R4_MEET_IF_THEN_NO := IF GOES_WITH(P15_R4_MEET_REQUEST,p,c,"IF_THEN","NO") THEN GOES_WITH(P15_R4_MEET_RESULT,p,c,"IF_THEN","NO","NO");
law P15_R4_MEET_IF_THEN_MAYBE := IF GOES_WITH(P15_R4_MEET_REQUEST,p,c,"IF_THEN","MAYBE") THEN GOES_WITH(P15_R4_MEET_RESULT,p,c,"IF_THEN","MAYBE","MAYBE");
law P15_R4_MEET_NOT_SAME_IF_THEN := IF GOES_WITH(P15_R4_MEET_REQUEST,p,c,"NOT_SAME","IF_THEN") THEN GOES_WITH(P15_R4_MEET_RESULT,p,c,"NOT_SAME","IF_THEN","NOT_SAME");
law P15_R4_MEET_NOT_SAME_NOT_SAME := IF GOES_WITH(P15_R4_MEET_REQUEST,p,c,"NOT_SAME","NOT_SAME") THEN GOES_WITH(P15_R4_MEET_RESULT,p,c,"NOT_SAME","NOT_SAME","NOT_SAME");
law P15_R4_MEET_NOT_SAME_NO := IF GOES_WITH(P15_R4_MEET_REQUEST,p,c,"NOT_SAME","NO") THEN GOES_WITH(P15_R4_MEET_RESULT,p,c,"NOT_SAME","NO","NO");
law P15_R4_MEET_NOT_SAME_MAYBE := IF GOES_WITH(P15_R4_MEET_REQUEST,p,c,"NOT_SAME","MAYBE") THEN GOES_WITH(P15_R4_MEET_RESULT,p,c,"NOT_SAME","MAYBE","MAYBE");
law P15_R4_MEET_NO_IF_THEN := IF GOES_WITH(P15_R4_MEET_REQUEST,p,c,"NO","IF_THEN") THEN GOES_WITH(P15_R4_MEET_RESULT,p,c,"NO","IF_THEN","NO");
law P15_R4_MEET_NO_NOT_SAME := IF GOES_WITH(P15_R4_MEET_REQUEST,p,c,"NO","NOT_SAME") THEN GOES_WITH(P15_R4_MEET_RESULT,p,c,"NO","NOT_SAME","NO");
law P15_R4_MEET_NO_NO := IF GOES_WITH(P15_R4_MEET_REQUEST,p,c,"NO","NO") THEN GOES_WITH(P15_R4_MEET_RESULT,p,c,"NO","NO","NO");
law P15_R4_MEET_NO_MAYBE := IF GOES_WITH(P15_R4_MEET_REQUEST,p,c,"NO","MAYBE") THEN GOES_WITH(P15_R4_MEET_RESULT,p,c,"NO","MAYBE","NO");
law P15_R4_MEET_MAYBE_IF_THEN := IF GOES_WITH(P15_R4_MEET_REQUEST,p,c,"MAYBE","IF_THEN") THEN GOES_WITH(P15_R4_MEET_RESULT,p,c,"MAYBE","IF_THEN","MAYBE");
law P15_R4_MEET_MAYBE_NOT_SAME := IF GOES_WITH(P15_R4_MEET_REQUEST,p,c,"MAYBE","NOT_SAME") THEN GOES_WITH(P15_R4_MEET_RESULT,p,c,"MAYBE","NOT_SAME","MAYBE");
law P15_R4_MEET_MAYBE_NO := IF GOES_WITH(P15_R4_MEET_REQUEST,p,c,"MAYBE","NO") THEN GOES_WITH(P15_R4_MEET_RESULT,p,c,"MAYBE","NO","NO");
law P15_R4_MEET_MAYBE_MAYBE := IF GOES_WITH(P15_R4_MEET_REQUEST,p,c,"MAYBE","MAYBE") THEN GOES_WITH(P15_R4_MEET_RESULT,p,c,"MAYBE","MAYBE","MAYBE");

law P15_R4_WHENCE_BEGIN := IF GOES_WITH(P15_R4_INPUT,p,POSITION(o,WHAT),w), GOES_WITH(P15_R4_INPUT,p,POSITION(o,HOW),h), GOES_WITH(P15_R4_INPUT,p,POSITION(o,FOR_WHAT),f), GOES_WITH(P15_R4_INPUT,p,POSITION(BECAUSE,FOR_WHAT),y) THEN GOES_WITH(P15_R4_MEET_REQUEST,p,P15_R4_WHENCE_CONTEXT(o,w,h,f,y,FOR_WHAT_WHY_F),f,y);
law P15_R4_WHENCE_WHEN := IF GOES_WITH(P15_R4_MEET_RESULT,p,P15_R4_WHENCE_CONTEXT(o,w,h,f,y,FOR_WHAT_WHY_F),f,y,a) THEN GOES_WITH(P15_R4_MEET_REQUEST,p,P15_R4_WHENCE_CONTEXT(o,w,h,f,y,WITH_WHEN),h,a);
law P15_R4_WHENCE_WHICH := IF GOES_WITH(P15_R4_MEET_RESULT,p,P15_R4_WHENCE_CONTEXT(o,w,h,f,y,WITH_WHEN),h,a,v) THEN GOES_WITH(P15_R4_MEET_REQUEST,p,P15_R4_WHENCE_CONTEXT(o,w,h,f,y,WITH_WHICH),w,v);
law P15_R4_WHENCE_WHERE := IF GOES_WITH(P15_R4_MEET_RESULT,p,P15_R4_WHENCE_CONTEXT(o,w,h,f,y,WITH_WHICH),w,a,v) THEN GOES_WITH(P15_R4_MEET_REQUEST,p,P15_R4_WHENCE_CONTEXT(o,w,h,f,y,WITH_WHERE),w,v);
law P15_R4_WHENCE_END := IF GOES_WITH(P15_R4_MEET_RESULT,p,P15_R4_WHENCE_CONTEXT(o,w,h,f,y,WITH_WHERE),w,a,v) THEN GOES_WITH(P15_DERIVED,p,POSITION(o,WHENCE),v);

// GoverningJunction content-agreement component, implementation candidate 014.
// Scope: compare supplied projections at a supplied shared operator/witness
// position. This does not extract record seeds, discover shared positions,
// seal a LocalSection, admit a GlobalSection, or license a worldline commit.
//
// Source contract: GOES_WITH(GJC_REQUEST,case,POSITION(operator,witness),l,r).
// Each side is ABSENT or PRESENT(bits); bits are a finite CONS list of the
// carrier readings "NO" and "THIS", ending in NIL. Byte-to-bit transport is
// representation only. All agreement conclusions are native rule outputs.
// IF_THEN = equal supplied content; NOT_SAME = distinguished supplied content;
// MAYBE = at least one absent projection. Missing evidence is not a wall.
// Malformed content has no terminal unless the inspected prefix already
// supplies a disagreement; this component is not a content-schema validator.
// The original request is retained in every result, including its full key.

law GJC_BEGIN := IF GOES_WITH(GJC_REQUEST,c,POSITION(o,w),PRESENT(a),PRESENT(b)) THEN GOES_WITH(GJC_SCAN,c,POSITION(o,w),PRESENT(a),PRESENT(b),a,b);
law GJC_NEXT_NO := IF GOES_WITH(GJC_SCAN,c,p,l,r,CONS("NO",a),CONS("NO",b)) THEN GOES_WITH(GJC_SCAN,c,p,l,r,a,b);
law GJC_NEXT_THIS := IF GOES_WITH(GJC_SCAN,c,p,l,r,CONS("THIS",a),CONS("THIS",b)) THEN GOES_WITH(GJC_SCAN,c,p,l,r,a,b);
law GJC_EQUAL_END := IF GOES_WITH(GJC_SCAN,c,p,l,r,NIL,NIL) THEN GOES_WITH(GJC_RESULT,c,p,l,r,"IF_THEN");
law GJC_DIFFER_NO_THIS := IF GOES_WITH(GJC_SCAN,c,p,l,r,CONS("NO",a),CONS("THIS",b)) THEN GOES_WITH(GJC_RESULT,c,p,l,r,"NOT_SAME");
law GJC_DIFFER_THIS_NO := IF GOES_WITH(GJC_SCAN,c,p,l,r,CONS("THIS",a),CONS("NO",b)) THEN GOES_WITH(GJC_RESULT,c,p,l,r,"NOT_SAME");
law GJC_LEFT_END := IF GOES_WITH(GJC_SCAN,c,p,l,r,NIL,CONS(v,b)) THEN GOES_WITH(GJC_RESULT,c,p,l,r,"NOT_SAME");
law GJC_RIGHT_END := IF GOES_WITH(GJC_SCAN,c,p,l,r,CONS(v,a),NIL) THEN GOES_WITH(GJC_RESULT,c,p,l,r,"NOT_SAME");
law GJC_AGREE := IF GOES_WITH(GJC_RESULT,c,p,l,r,"IF_THEN") THEN GOES_WITH(GJC_AGREEMENT,c,p,l,r);
law GJC_DISTINGUISH := IF GOES_WITH(GJC_RESULT,c,p,l,r,"NOT_SAME") THEN GOES_WITH(GJC_WALL,c,p,l,r);

law GJC_LEFT_ABSENT := IF GOES_WITH(GJC_REQUEST,c,POSITION(o,w),ABSENT,PRESENT(b)) THEN GOES_WITH(GJC_RESULT,c,POSITION(o,w),ABSENT,PRESENT(b),"MAYBE");
law GJC_RIGHT_ABSENT := IF GOES_WITH(GJC_REQUEST,c,POSITION(o,w),PRESENT(a),ABSENT) THEN GOES_WITH(GJC_RESULT,c,POSITION(o,w),PRESENT(a),ABSENT,"MAYBE");
law GJC_BOTH_ABSENT := IF GOES_WITH(GJC_REQUEST,c,POSITION(o,w),ABSENT,ABSENT) THEN GOES_WITH(GJC_RESULT,c,POSITION(o,w),ABSENT,ABSENT,"MAYBE");
law GJC_LEFT_MISSING := IF GOES_WITH(GJC_RESULT,c,p,ABSENT,PRESENT(b),"MAYBE") THEN GOES_WITH(GJC_MISSING,c,p,LEFT);
law GJC_RIGHT_MISSING := IF GOES_WITH(GJC_RESULT,c,p,PRESENT(a),ABSENT,"MAYBE") THEN GOES_WITH(GJC_MISSING,c,p,RIGHT);
law GJC_BOTH_MISSING := IF GOES_WITH(GJC_RESULT,c,p,ABSENT,ABSENT,"MAYBE") THEN GOES_WITH(GJC_MISSING,c,p,BOTH);

