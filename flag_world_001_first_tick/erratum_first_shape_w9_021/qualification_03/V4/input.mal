      expected {"law_positions":["atom","hydrogen"],"verdict":"NO"}
  V2  input  V2.mal   := `// the first shape (D,I) @ (2,0) ["hydrogen", correspondence MAYBE]`      (bracketed label, comment)
      expected {"law_positions":[],"verdict":"IF_THEN"}
  V3  input  V3.mal   := `law SHAPE := IF THIS(FIRST_SHAPE,D,I) THEN GOES_WITH(SHELL,2,0); // hydrogen is a label`
      expected {"law_positions":[],"verdict":"IF_THEN"}
  V4  input  this file (ERRATUM_E_FIRST_SHAPE_NO_PIECES_001.mal v0.1.3)          (mentions only, incl. the specimens above)
      expected {"law_positions":[],"verdict":"IF_THEN"}
  V5  input  V5.mal   := `FIRST_SHAPE := (D,I) @ (2,0) ["hydrogen", correspondence MAYBE]`   (correspondence bracket, NOT a comment)
      expected {"law_positions":[],"verdict":"IF_THEN"}
