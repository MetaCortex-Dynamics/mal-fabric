      "N107" -> NO IN "ERRATUM_ID"
      "N111" -> NO IN "SPEC_ID"
      "N115" -> NO IN "atom"
      "N123" -> NO IN "hydrogen"
      "N130" -> NO IN "particle"
      "N136" -> NO IN "element"
      "N146" -> NO IN "singularity"
      "N149" -> NO IN "entropy"
      "N151" -> NO IN "tie"
      _ -> NO IN "ID"
    }
  }

  CAN readonly IN w9_finish_word() -> Atom {
    SAME w9_word_active {
      false -> NO IN NONE
      true -> NONE
    }
    THIS w9_wc = w9_trie_word.call(w9_word_node)
    SAME w9_wc {
      "LAW" -> SAME w9_had_upper { true -> THIS w9_wc = "ID" _ -> NONE }
      "DOMAIN" -> SAME w9_had_upper { true -> THIS w9_wc = "ID" _ -> NONE }
      "PROPOSE" -> SAME w9_had_upper { true -> THIS w9_wc = "ID" _ -> NONE }
      "SEED" -> SAME w9_had_upper { true -> THIS w9_wc = "ID" _ -> NONE }
      "READONLY" -> SAME w9_had_upper { true -> THIS w9_wc = "ID" _ -> NONE }
      "INPUT" -> SAME w9_had_upper { true -> THIS w9_wc = "ID" _ -> NONE }
      "IF" -> SAME w9_had_lower { true -> THIS w9_wc = "ID" _ -> NONE }
      "THEN" -> SAME w9_had_lower { true -> THIS w9_wc = "ID" _ -> NONE }
      "RETIRES" -> SAME w9_had_lower { true -> THIS w9_wc = "ID" _ -> NONE }
      "VECTORS" -> SAME w9_had_lower { true -> THIS w9_wc = "ID" _ -> NONE }
      "STATES" -> SAME w9_had_lower { true -> THIS w9_wc = "ID" _ -> NONE }
      "WRITING" -> SAME w9_had_lower { true -> THIS w9_wc = "ID" _ -> NONE }
      "W9" -> SAME w9_had_lower { true -> THIS w9_wc = "ID" _ -> NONE }
      "GENEALOGY" -> SAME w9_had_lower { true -> THIS w9_wc = "ID" _ -> NONE }
      "ENTRY" -> SAME w9_had_lower { true -> THIS w9_wc = "ID" _ -> NONE }
      "TERMINAL" -> SAME w9_had_lower { true -> THIS w9_wc = "ID" _ -> NONE }
      "CONTACTS" -> SAME w9_had_lower { true -> THIS w9_wc = "ID" _ -> NONE }
      "OPERANDS" -> SAME w9_had_lower { true -> THIS w9_wc = "ID" _ -> NONE }
      _ -> NONE
    }
    SAME w9_word_number {
      true -> w9_push.call("NUM", false)
      false -> w9_push.call(w9_wc, true)
    }
    THIS w9_word_active = false
    NO IN NONE
  }
  CAN readonly IN w9_word_byte(w9_wb: Atom, w9_wclass: Atom) -> Atom {
    SAME w9_word_active {
      false -> IN w9_word_begin {
        THIS w9_word_active = true THIS w9_word_node = "N0"
        THIS w9_had_upper = false THIS w9_had_lower = false
        THIS w9_word_number = false
        SAME w9_wclass { "DIGIT" -> THIS w9_word_number = true _ -> NONE }
      }
      _ -> NONE
    }
    SAME w9_wclass { "LETTER" -> THIS w9_word_number = false _ -> NONE }
    THIS w9_word_node = w9_trie_step.call(w9_word_node, w9_fold.call(w9_wb))
    NO IN NONE
  }
  CAN readonly IN w9_code_byte(w9_cb: Atom) -> Atom {
    THIS w9_cls = w9_char_class.call(w9_cb)
    SAME w9_cls {
      "LETTER" -> NO IN w9_word_byte.call(w9_cb, w9_cls)
      "DIGIT" -> NO IN w9_word_byte.call(w9_cb, w9_cls)
      _ -> w9_finish_word.call()
    }
    SAME w9_cb {
      47 -> THIS w9_lex = "SLASH"
      34 -> THIS w9_lex = "STRING"
      96 -> THIS w9_lex = "BACKTICK"
      10 -> w9_push.call("NL", false)
      40 -> w9_push.call("LP", false) 41 -> w9_push.call("RP", false)
      123 -> w9_push.call("LB", false) 125 -> w9_push.call("RB", false)
      91 -> w9_push.call("LSQ", false) 93 -> w9_push.call("RSQ", false)
      44 -> w9_push.call("COMMA", false) 58 -> w9_push.call("COLON", false)
      61 -> w9_push.call("EQ", false) 59 -> w9_push.call("SEMI", false)
      64 -> w9_push.call("AT", false)
      32 -> NONE 9 -> NONE 13 -> NONE
      _ -> w9_push.call("OTHER", false)
    }
    NO IN NONE
  }
  CAN readonly IN w9_lex_byte(w9_lb: Atom) -> Atom {
    SAME w9_lex {
      "CODE" -> NO IN w9_code_byte.call(w9_lb)
      "SLASH" -> SAME w9_lb {
        47 -> THIS w9_lex = "COMMENT"
        _ -> IN w9_lone_slash { THIS w9_lex = "CODE" w9_push.call("OTHER",false) w9_code_byte.call(w9_lb) }
      }
      "COMMENT" -> SAME w9_lb { 10 -> IN w9_comment_end { THIS w9_lex = "CODE" w9_push.call("NL",false) } _ -> NONE }
      "STRING" -> SAME w9_lb {
        92 -> THIS w9_lex = "ESCAPE"
        34 -> IN w9_string_end { THIS w9_lex = "CODE" w9_push.call("STRING",false) }
        _ -> NONE
      }
      "ESCAPE" -> THIS w9_lex = "STRING"
      "BACKTICK" -> SAME w9_lb { 96 -> IN w9_tick_end { THIS w9_lex = "CODE" w9_push.call("BACKTICK",false) } _ -> NONE }
    }
    NO IN NONE
  }
  CAN readonly IN w9_reverse() -> Atom {
    SAME w9_tokens.kind {
      "END" -> NO IN NONE
      "NODE" -> IN w9_reverse_node {
        THIS w9_reversed = TOGETHER { kind: "NODE" c: w9_tokens.c word: w9_tokens.word next: w9_reversed }
        THIS w9_tokens = w9_tokens.next
        NO IN w9_reverse.call()
      }
    }
  }
  CAN readonly IN w9_current() -> Atom {
    SAME w9_cursor.kind { "END" -> NO IN "EOF" "NODE" -> NO IN w9_cursor.c }
  }
  CAN readonly IN w9_word() -> Atom {
    SAME w9_cursor.kind { "END" -> NO IN false "NODE" -> NO IN w9_cursor.word }
  }
  CAN readonly IN w9_next() -> Atom {
    SAME w9_cursor.kind { "NODE" -> THIS w9_cursor = w9_cursor.next _ -> NONE }
    NO IN NONE
  }
  CAN readonly IN w9_skip_nl() -> Atom {
    SAME w9_current.call() { "NL" -> IN w9_skip_one { w9_next.call() NO IN w9_skip_nl.call() } _ -> NO IN NONE }
  }
  CAN readonly IN w9_equal(w9_ea: Atom, w9_eb: Atom) -> Atom {
    SAME w9_ea {
      "COLON" -> SAME w9_eb { "COLON" -> NO IN true _ -> NO IN false }
      "EQ" -> SAME w9_eb { "EQ" -> NO IN true _ -> NO IN false }
      "IF" -> SAME w9_eb { "IF" -> NO IN true _ -> NO IN false }
      "SEMI" -> SAME w9_eb { "SEMI" -> NO IN true _ -> NO IN false }
      "SEED" -> SAME w9_eb { "SEED" -> NO IN true _ -> NO IN false }
      "INPUT" -> SAME w9_eb { "INPUT" -> NO IN true _ -> NO IN false }
      "LB" -> SAME w9_eb { "LB" -> NO IN true _ -> NO IN false }
      _ -> NO IN false
    }
  }
  CAN readonly IN w9_expect(w9_ec: Atom) -> Atom {
    w9_skip_nl.call()
    SAME w9_equal.call(w9_current.call(), w9_ec) {
      true -> IN w9_expected { w9_next.call() NO IN true }
      _ -> IN w9_expected_gap { w9_gap_note.call() NO IN false }
    }
  }
  CAN readonly IN w9_skip_rest() -> Atom {
    SAME w9_current.call() {
      "EOF" -> NO IN NONE
      "NL" -> NO IN w9_next.call()
      "SEMI" -> NO IN w9_next.call()
      _ -> IN w9_rest_more { w9_next.call() NO IN w9_skip_rest.call() }
    }
  }
  // Prose has no statement boundary at semicolons. Only code recovery uses skip_rest.
  CAN readonly IN w9_skip_line() -> Atom {
    SAME w9_current.call() {
      "EOF" -> NO IN NONE
      "NL" -> NO IN w9_next.call()
      _ -> IN w9_line_more { w9_next.call() NO IN w9_skip_line.call() }
    }
  }
  CAN readonly IN w9_term() -> Atom {
    w9_skip_nl.call()
    SAME w9_word.call() {
      true -> IN w9_term_id {
        w9_mark.call(w9_current.call())
        w9_next.call() w9_skip_nl.call()
        SAME w9_current.call() {
          "LP" -> IN w9_term_call { w9_next.call() NO IN w9_arguments.call() }
          _ -> NO IN true
        }
      }
      false -> SAME w9_current.call() {
        "NUM" -> IN w9_term_num { w9_next.call() NO IN true }
        "STRING" -> IN w9_term_string { w9_next.call() NO IN true }
        _ -> IN w9_term_gap { w9_gap_note.call() NO IN false }
      }
    }
  }
  CAN readonly IN w9_arguments() -> Atom {
    w9_skip_nl.call()
    SAME w9_current.call() { "RP" -> IN w9_args_empty { w9_next.call() NO IN true } _ -> NONE }
    SAME w9_term.call() { false -> NO IN false _ -> NONE }
    w9_skip_nl.call()
    SAME w9_current.call() {
      "COMMA" -> IN w9_args_more { w9_next.call() NO IN w9_arguments_nonempty.call() }
      "RP" -> IN w9_args_end { w9_next.call() NO IN true }
      _ -> IN w9_args_gap { w9_gap_note.call() NO IN false }
    }
  }
  CAN readonly IN w9_arguments_nonempty() -> Atom {
    w9_skip_nl.call()
    SAME w9_current.call() { "RP" -> IN w9_trailing_comma { w9_gap_note.call() NO IN false } _ -> NO IN w9_arguments.call() }
  }
  CAN readonly IN w9_law_tail() -> Atom {
    SAME w9_term.call() { false -> NO IN false _ -> NONE }
    w9_skip_nl.call()
    SAME w9_current.call() {
      "COMMA" -> IN w9_law_antecedent { w9_next.call() NO IN w9_law_tail.call() }
      "THEN" -> IN w9_law_consequent {
        w9_next.call()
        SAME w9_term.call() { false -> NO IN false _ -> NONE }
        NO IN w9_expect.call("SEMI")
      }
      _ -> IN w9_law_tail_gap { w9_gap_note.call() NO IN false }
    }
  }
  CAN readonly IN w9_document_from_code() -> Atom {
    SAME w9_document { "UNKNOWN" -> THIS w9_document = "SPEC" _ -> NONE }
    NO IN NONE
  }
  CAN readonly IN w9_law() -> Atom {
    w9_document_from_code.call()
    w9_next.call() w9_skip_nl.call()
    SAME w9_word.call() { false -> IN w9_law_id_gap { w9_gap_note.call() NO IN false } _ -> NONE }
    THIS w9_law_name = w9_current.call()
    w9_next.call()
    SAME w9_expect.call("COLON") { false -> NO IN false _ -> NONE }
    SAME w9_expect.call("EQ") { false -> NO IN false _ -> NONE }
    w9_mark.call(w9_law_name)
    SAME w9_expect.call("IF") { false -> NO IN false _ -> NONE }
    NO IN w9_law_tail.call()
  }
  CAN readonly IN w9_named() -> Atom {
    w9_skip_nl.call()
    SAME w9_word.call() {
      true -> IN w9_named_word { w9_mark.call(w9_current.call()) w9_next.call() NO IN true }
      false -> IN w9_named_gap { w9_gap_note.call() NO IN false }
    }
  }
  CAN readonly IN w9_authority() -> Atom {
    w9_next.call() w9_skip_nl.call()
    SAME w9_current.call() {
      "PROPOSE" -> IN w9_authority_seed {
        w9_next.call()
        SAME w9_expect.call("SEED") { false -> NO IN false _ -> NONE }
        w9_document_from_code.call()
        NO IN w9_named.call()
      }
      "READONLY" -> IN w9_authority_input {
        w9_next.call()
        SAME w9_expect.call("INPUT") { false -> NO IN false _ -> NONE }
        w9_document_from_code.call()
        NO IN w9_named.call()
      }
      _ -> IN w9_other_authority { w9_gap_note.call() NO IN false }
    }
  }
  CAN readonly IN w9_open_enumeration() -> Atom {
    w9_next.call() w9_skip_nl.call()
    SAME w9_current.call() {
      "COLON" -> IN w9_enum_colon { w9_next.call() SAME w9_expect.call("EQ") { false -> NO IN false _ -> NONE } }
      "EQ" -> w9_next.call()
      _ -> NONE
    }
    NO IN w9_expect.call("LB")
  }
  CAN readonly IN w9_enum_entries() -> Atom {
    w9_skip_nl.call()
    SAME w9_current.call() { "RB" -> IN w9_enum_end { w9_next.call() NO IN true } _ -> NONE }
    SAME w9_term.call() { false -> NO IN false _ -> NONE }
    w9_skip_nl.call()
    SAME w9_current.call() {
      "COMMA" -> IN w9_enum_more { w9_next.call() NO IN w9_enum_entries.call() }
      "RB" -> IN w9_enum_closed { w9_next.call() NO IN true }
      _ -> IN w9_enum_gap { w9_gap_note.call() NO IN false }
    }
  }
  CAN readonly IN w9_binding_entries() -> Atom {
    w9_skip_nl.call()
    SAME w9_current.call() { "RB" -> IN w9_binding_end { w9_next.call() NO IN true } _ -> NONE }
    SAME w9_word.call() {
      true -> w9_next.call()
      false -> SAME w9_current.call() {
        "STRING" -> w9_next.call()
        _ -> IN w9_binding_label_gap { w9_gap_note.call() NO IN false }
      }
    }
    SAME w9_expect.call("COLON") { false -> NO IN false _ -> NONE }
    SAME w9_term.call() { false -> NO IN false _ -> NONE }
    w9_skip_nl.call()
    SAME w9_current.call() {
      "COMMA" -> IN w9_binding_more { w9_next.call() NO IN w9_binding_entries.call() }
      "RB" -> IN w9_binding_closed { w9_next.call() NO IN true }
      _ -> IN w9_binding_gap { w9_gap_note.call() NO IN false }
    }
  }
  CAN readonly IN w9_heading(w9_hc: Atom) -> Atom {
    SAME w9_hc {
      "STATES" -> NO IN true "WRITING" -> NO IN true "W9" -> NO IN true
      "GENEALOGY" -> NO IN true "ENTRY" -> NO IN true "VECTORS" -> NO IN true
      "TERMINAL" -> NO IN true "CONTACTS" -> NO IN true "OPERANDS" -> NO IN true
      _ -> NO IN false
    }
  }
  CAN readonly IN w9_top() -> Atom {
    SAME w9_current.call() {
      "EOF" -> NO IN NONE
      "NL" -> IN w9_top_blank {
        SAME w9_section { "RETIRES" -> THIS w9_section = "MAIN" _ -> NONE }
        w9_next.call() NO IN w9_top.call()
      }
      "SEMI" -> IN w9_top_semi { w9_next.call() NO IN w9_top.call() }
      _ -> NONE
    }
    SAME w9_section {
      "RETIRES" -> SAME w9_heading.call(w9_current.call()) {
        true -> THIS w9_section = "MAIN"
        false -> IN w9_retired_mention_line { w9_skip_line.call() NO IN w9_top.call() }
      }
      _ -> NONE
    }
    SAME w9_current.call() {
      "ERRATUM_ID" -> IN w9_doc_erratum { THIS w9_document = "ERRATUM" w9_skip_line.call() }
      "SPEC_ID" -> IN w9_doc_spec { THIS w9_document = "SPEC" w9_skip_line.call() }
      "RETIRES" -> IN w9_retires_header {
        SAME w9_document { "ERRATUM" -> THIS w9_section = "RETIRES" _ -> w9_gap_note.call() }
        w9_skip_line.call()
      }
      "VECTORS" -> IN w9_vectors_header {
        SAME w9_document { "UNKNOWN" -> w9_gap_note.call() _ -> THIS w9_section = "VECTORS" }
        w9_skip_line.call()
      }
      "STATES" -> IN w9_states_header { THIS w9_section = "MAIN" w9_skip_line.call() }
      "WRITING" -> IN w9_writing_header { THIS w9_section = "MAIN" w9_skip_line.call() }
      "W9" -> IN w9_w9_header { THIS w9_section = "MAIN" w9_skip_line.call() }
      "GENEALOGY" -> IN w9_genealogy_header { THIS w9_section = "MAIN" w9_skip_line.call() }
      "ENTRY" -> IN w9_entry_header { THIS w9_section = "MAIN" w9_skip_line.call() }
      "LAW" -> SAME w9_law.call() { false -> w9_skip_rest.call() _ -> NONE }
      "DOMAIN" -> IN w9_domain_decl {
        w9_document_from_code.call() w9_next.call() w9_named.call() w9_skip_rest.call()
      }
      "AT" -> IN w9_authority_decl { w9_authority.call() w9_skip_rest.call() }
      "TERMINAL" -> IN w9_terminal_decl {
        SAME w9_open_enumeration.call() {
          true -> SAME w9_enum_entries.call() { false -> w9_skip_rest.call() _ -> NONE }
          false -> w9_skip_rest.call()
        }
      }
      "CONTACTS" -> IN w9_contacts_decl {
        SAME w9_open_enumeration.call() {
          true -> SAME w9_binding_entries.call() { false -> w9_skip_rest.call() _ -> NONE }
          false -> w9_skip_rest.call()
        }
      }
      "OPERANDS" -> IN w9_operands_decl {
        SAME w9_open_enumeration.call() {
          true -> SAME w9_binding_entries.call() { false -> w9_skip_rest.call() _ -> NONE }
          false -> w9_skip_rest.call()
        }
      }
      "BACKTICK" -> IN w9_top_tick {
        SAME w9_section { "VECTORS" -> NONE _ -> w9_gap_note.call() }
        w9_next.call()
      }
      "BROKEN" -> IN w9_top_broken { w9_gap_note.call() w9_next.call() }
      _ -> w9_skip_line.call()
    }
    NO IN w9_top.call()
  }
  CAN readonly IN w9_check(w9_input: ByteSeq) -> W9Result {
    THIS w9_atom = 0 THIS w9_hydrogen = 0 THIS w9_particle = 0
    THIS w9_element = 0 THIS w9_singularity = 0 THIS w9_entropy = 0 THIS w9_tie = 0
    THIS w9_hit = false THIS w9_gap = false
    THIS w9_tokens = TOGETHER { kind: "END" }
    THIS w9_reversed = TOGETHER { kind: "END" }
    THIS w9_lex = "CODE" THIS w9_word_active = false
    THIS w9_word_node = "N0" THIS w9_word_number = false
    THIS w9_had_upper = false THIS w9_had_lower = false
    THIS w9_document = "UNKNOWN" THIS w9_section = "MAIN"
    SAME w9_input.kind {
      "LEAF" -> IN w9_leaf_input {
        MANY w9_byte IN w9_input.items { w9_lex_byte.call(w9_byte) }
        w9_finish_word.call()
        SAME w9_lex {
          "CODE" -> NONE "COMMENT" -> NONE
          "SLASH" -> w9_push.call("OTHER", false)
          _ -> IN w9_unclosed_literal { w9_gap_note.call() w9_push.call("BROKEN",false) }
        }
        w9_reverse.call()
        THIS w9_cursor = w9_reversed
        w9_top.call()
      }
      _ -> w9_gap_note.call()
    }
    THIS w9_verdict = "IF_THEN" THIS w9_reason = "PARSED_NAMED_POSITIONS"
    SAME w9_gap { true -> IN w9_unread { THIS w9_verdict = "MAYBE" THIS w9_reason = "UNSUPPORTED_OR_MALFORMED_RELEVANT_PARSE" } _ -> NONE }
    SAME w9_hit {
      true -> IN w9_excluded {
        THIS w9_verdict = "NO" THIS w9_reason = "RETIRED_LAW_POSITION"
        SAME w9_gap { true -> THIS w9_reason = "RETIRED_LAW_POSITION_WITH_OPEN_PARSE" _ -> NONE }
      }
      _ -> NONE
    }
    NO IN TOGETHER {
      verdict: w9_verdict atom: w9_atom hydrogen: w9_hydrogen particle: w9_particle
      element: w9_element singularity: w9_singularity entropy: w9_entropy tie: w9_tie reason: w9_reason
    }
  }
}

