  CAN readonly IN byte_index_zero() -> ByteIndex {
    NO IN TOGETHER {
      kind: "ZERO"
    }
  }

  CAN readonly IN byte_index_successor(
    byte_index_predecessor: ByteIndex
  ) -> ByteIndex {
    NO IN TOGETHER {
      kind: "SUCC"
      previous: byte_index_predecessor
    }
  }

  CAN readonly IN byte_seq_empty() -> ByteSeq {
    NO IN TOGETHER {
      kind: "EMPTY"
    }
  }

  CAN readonly IN byte_seq_leaf(byte_leaf_items: Many(Atom)) -> ByteSeq {
    NO IN TOGETHER {
      kind: "LEAF"
      items: byte_leaf_items
    }
  }

  CAN readonly IN byte_seq_single(byte_single_value: Atom) -> ByteSeq {
    SAME byte_valid.call(byte_single_value) {
      true -> NO IN byte_seq_leaf.call(MANY [byte_single_value])
      _ -> NO IN TOGETHER {
        kind: "INVALID"
      }
    }
  }

  CAN readonly IN byte_seq_concat(
    byte_concat_left: ByteSeq,
    byte_concat_right: ByteSeq
  ) -> ByteSeq {
    NO IN TOGETHER {
      kind: "CONCAT"
      left: byte_concat_left
      right: byte_concat_right
    }
  }

  CAN readonly IN byte_seq_append(
    byte_append_sequence: ByteSeq,
    byte_append_value: Atom
  ) -> ByteSeq {
    THIS byte_append_single = byte_seq_single.call(byte_append_value)
    SAME byte_append_single.kind {
      "LEAF" -> NO IN byte_seq_concat.call(byte_append_sequence, byte_append_single)
      _ -> NO IN TOGETHER {
        kind: "INVALID"
      }
    }
  }

  CAN readonly IN byte_seq_validation_walk() -> Atom {
    SAME byte_validation_stack.kind {
      "END" -> NO IN byte_validation_result
      "NODE" -> IN byte_validation_step {
        THIS byte_validation_node = byte_validation_stack.value
        THIS byte_validation_rest = byte_validation_stack.next
        SAME byte_validation_node.kind {
          "EMPTY" -> IN byte_validation_empty {
            THIS byte_validation_stack = byte_validation_rest
            NO IN byte_seq_validation_walk.call()
          }
          "LEAF" -> IN byte_validation_leaf {
            MANY byte_validation_item IN byte_validation_node.items {
              SAME byte_valid.call(byte_validation_item) {
                false -> THIS byte_validation_result = false
                _ -> NONE
              }
            }
            THIS byte_validation_stack = byte_validation_rest
            NO IN byte_seq_validation_walk.call()
          }
          "CONCAT" -> IN byte_validation_concat {
            THIS byte_validation_stack = TOGETHER {
              kind: "NODE"
              value: byte_validation_node.left
              next: TOGETHER {
                kind: "NODE"
                value: byte_validation_node.right
                next: byte_validation_rest
              }
            }
            NO IN byte_seq_validation_walk.call()
          }
          _ -> NO IN false
        }
      }
      _ -> NO IN false
    }
  }

  CAN readonly IN byte_seq_valid(byte_sequence_candidate: ByteSeq) -> Atom {
    SAME byte_sequence_candidate.kind {
      "EMPTY" -> IN byte_validation_start {
        THIS byte_validation_result = true
        THIS byte_validation_stack = TOGETHER {
          kind: "NODE"
          value: byte_sequence_candidate
          next: TOGETHER {
            kind: "END"
          }
        }
        NO IN byte_seq_validation_walk.call()
      }
      "LEAF" -> IN byte_validation_start_leaf {
        THIS byte_validation_result = true
        THIS byte_validation_stack = TOGETHER {
          kind: "NODE"
          value: byte_sequence_candidate
          next: TOGETHER {
            kind: "END"
          }
        }
        NO IN byte_seq_validation_walk.call()
      }
      "CONCAT" -> IN byte_validation_start_concat {
        THIS byte_validation_result = true
        THIS byte_validation_stack = TOGETHER {
          kind: "NODE"
          value: byte_sequence_candidate
          next: TOGETHER {
            kind: "END"
          }
        }
        NO IN byte_seq_validation_walk.call()
      }
      _ -> NO IN false
    }
  }

  CAN readonly IN byte_seq_index_walk() -> ByteLookup {
    SAME byte_index_stack.kind {
      "END" -> NO IN byte_index_result
      "NODE" -> IN byte_index_step {
        THIS byte_index_node = byte_index_stack.value
        THIS byte_index_rest = byte_index_stack.next
        SAME byte_index_node.kind {
          "EMPTY" -> IN byte_index_empty {
            THIS byte_index_stack = byte_index_rest
            NO IN byte_seq_index_walk.call()
          }
          "LEAF" -> IN byte_index_leaf {
            MANY byte_index_item IN byte_index_node.items {
              SAME byte_index_result.found {
                false -> SAME byte_index_cursor.kind {
                  "ZERO" -> THIS byte_index_result = TOGETHER {
                    found: true
                    value: byte_index_item
                  }
                  "SUCC" -> THIS byte_index_cursor = byte_index_cursor.previous
                  _ -> THIS byte_index_result = TOGETHER {
                    found: false
                    value: NONE
                  }
                }
                _ -> NONE
              }
            }
            THIS byte_index_stack = byte_index_rest
            NO IN byte_seq_index_walk.call()
          }
          "CONCAT" -> IN byte_index_concat {
            THIS byte_index_stack = TOGETHER {
              kind: "NODE"
              value: byte_index_node.left
              next: TOGETHER {
                kind: "NODE"
                value: byte_index_node.right
                next: byte_index_rest
              }
            }
            NO IN byte_seq_index_walk.call()
          }
          _ -> NO IN TOGETHER {
            found: false
            value: NONE
          }
        }
      }
      _ -> NO IN TOGETHER {
        found: false
        value: NONE
      }
    }
  }

  CAN readonly IN byte_seq_index(
    byte_index_sequence: ByteSeq,
    byte_index_requested: ByteIndex
  ) -> ByteLookup {
    SAME byte_seq_valid.call(byte_index_sequence) {
      true -> IN byte_index_start {
        THIS byte_index_cursor = byte_index_requested
        THIS byte_index_result = TOGETHER {
          found: false
          value: NONE
        }
        THIS byte_index_stack = TOGETHER {
          kind: "NODE"
          value: byte_index_sequence
          next: TOGETHER {
            kind: "END"
          }
        }
        NO IN byte_seq_index_walk.call()
      }
      _ -> NO IN TOGETHER {
        found: false
        value: NONE
      }
    }
  }

  CAN readonly IN byte_seq_equal_walk() -> Atom {
    SAME byte_equal_stack.kind {
      "END" -> IN byte_equal_end {
        THIS byte_equal_terminal_lookup = byte_seq_index.call(
          byte_equal_right_sequence,
          byte_equal_cursor
        )
        SAME byte_equal_terminal_lookup.found {
          false -> NO IN byte_equal_result
          _ -> NO IN false
        }
      }
      "NODE" -> IN byte_equal_step {
        THIS byte_equal_node = byte_equal_stack.value
        THIS byte_equal_rest = byte_equal_stack.next
        SAME byte_equal_node.kind {
          "EMPTY" -> IN byte_equal_empty {
            THIS byte_equal_stack = byte_equal_rest
            NO IN byte_seq_equal_walk.call()
          }
          "LEAF" -> IN byte_equal_leaf {
            MANY byte_equal_item IN byte_equal_node.items {
              SAME byte_equal_result {
                true -> IN byte_equal_compare {
                  THIS byte_equal_lookup = byte_seq_index.call(
                    byte_equal_right_sequence,
                    byte_equal_cursor
                  )
                  SAME byte_equal_lookup.found {
                    true -> THIS byte_equal_result = byte_equal.call(
                      byte_equal_item,
                      byte_equal_lookup.value
                    )
                    _ -> THIS byte_equal_result = false
                  }
                }
                _ -> NONE
              }
              THIS byte_equal_cursor = byte_index_successor.call(
                byte_equal_cursor
              )
            }
            THIS byte_equal_stack = byte_equal_rest
            NO IN byte_seq_equal_walk.call()
          }
          "CONCAT" -> IN byte_equal_concat {
            THIS byte_equal_stack = TOGETHER {
              kind: "NODE"
              value: byte_equal_node.left
              next: TOGETHER {
                kind: "NODE"
                value: byte_equal_node.right
                next: byte_equal_rest
              }
            }
            NO IN byte_seq_equal_walk.call()
          }
          _ -> NO IN false
        }
      }
      _ -> NO IN false
    }
  }

  CAN readonly IN byte_seq_equal(
    byte_equal_left_sequence: ByteSeq,
    byte_equal_right_input: ByteSeq
  ) -> Atom {
    SAME byte_seq_valid.call(byte_equal_left_sequence) {
      true -> SAME byte_seq_valid.call(byte_equal_right_input) {
        true -> IN byte_equal_start {
          THIS byte_equal_result = true
          THIS byte_equal_cursor = byte_index_zero.call()
          THIS byte_equal_right_sequence = byte_equal_right_input
          THIS byte_equal_stack = TOGETHER {
            kind: "NODE"
            value: byte_equal_left_sequence
            next: TOGETHER {
              kind: "END"
            }
          }
          NO IN byte_seq_equal_walk.call()
        }
        _ -> NO IN false
      }
      _ -> NO IN false
    }
  }
