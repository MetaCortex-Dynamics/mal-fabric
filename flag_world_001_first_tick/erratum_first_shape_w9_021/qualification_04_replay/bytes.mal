// MALCOG_PROJECTION_ABI_001 — byte and ByteSeq library.
// Direct MaLCog v3 source. No foreign semantic implementation.

IN malcog_projection_bytes {
  CAN readonly IN bool_xor(byte_bool_x: Atom, byte_bool_y: Atom) -> Atom {
    SAME byte_bool_x {
      true -> NO IN NO byte_bool_y
      false -> NO IN byte_bool_y
    }
  }

  CAN readonly IN bool_and(byte_and_x: Atom, byte_and_y: Atom) -> Atom {
    SAME byte_and_x {
      true -> NO IN byte_and_y
      false -> NO IN false
    }
  }

  CAN readonly IN bool_or(byte_or_x: Atom, byte_or_y: Atom) -> Atom {
    SAME byte_or_x {
      true -> NO IN true
      false -> NO IN byte_or_y
    }
  }

