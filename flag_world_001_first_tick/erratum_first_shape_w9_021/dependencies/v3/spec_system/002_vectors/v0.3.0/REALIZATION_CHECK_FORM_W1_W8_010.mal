  // two-digit decimal values: TOGETHER { t, o, n } (n digits; n 0 := absent, n 3 := too many)
  CAN readonly IN realization_num_none() -> Num {
    NO IN TOGETHER { t: 0 o: 0 n: 0 }
  }

  CAN readonly IN realization_num_push(realization_np: Num, realization_nd: Atom) -> Num {
    SAME realization_np.n {
      0 -> NO IN TOGETHER { t: 0 o: realization_nd n: 1 }
      1 -> NO IN TOGETHER { t: realization_np.o o: realization_nd n: 2 }
      _ -> NO IN TOGETHER { t: 0 o: 0 n: 3 }
    }
  }

  CAN readonly IN realization_dec_inc(realization_di: Num) -> Num {
    SAME realization_di.o {
      9 -> NO IN TOGETHER { t: realization_succ.call(realization_di.t) o: 0 n: 2 }
      _ -> NO IN TOGETHER { t: realization_di.t o: realization_succ.call(realization_di.o) n: 2 }
    }
  }

  CAN readonly IN realization_num_same(realization_na: Num, realization_nb: Num) -> Atom {
    SAME realization_na.n {
      1 -> NONE
      2 -> NONE
      _ -> NO IN false
    }
    NO IN bool_and.call(byte_equal.call(realization_na.t, realization_nb.t), byte_equal.call(realization_na.o, realization_nb.o))
  }

  // declarations INSIDE the terminal section
  CAN readonly IN realization_decl(realization_dc: Atom) -> Atom {
    SAME byte_equal.call(realization_dc, 107) {
      true -> THIS realization_pending_named = true
      false -> NONE
    }
    SAME realization_ds {
      "EXB" -> SAME byte_equal.call(realization_dc, 125) {
        true -> IN realization_ds_exb {
          THIS realization_exec_ok = true
          THIS realization_ds = "IDLE"
        }
        false -> NONE
      }
      "NXB" -> SAME byte_equal.call(realization_dc, 125) {
        true -> IN realization_ds_nxb {
          THIS realization_next_ok = true
          THIS realization_ds = "IDLE"
        }
        false -> NONE
      }
      "SEED" -> SAME byte_equal.call(realization_dc, 102) {
        true -> THIS realization_ds = "SEEDC"
        false -> THIS realization_ds = realization_decl_start.call(realization_dc)
      }
      "SEEDC" -> SAME byte_equal.call(realization_dc, 110) {
        true -> IN realization_ds_seedn {
          THIS realization_seed_decl = realization_cnum
          THIS realization_ds = "IDLE"
        }
        false -> THIS realization_ds = realization_decl_start.call(realization_dc)
      }
      "DER" -> SAME byte_equal.call(realization_dc, 110) {
        true -> IN realization_ds_dern {
          THIS realization_derived_decl = realization_cnum
          THIS realization_ds = "IDLE"
        }
        false -> THIS realization_ds = realization_decl_start.call(realization_dc)
      }
      "EX" -> SAME byte_equal.call(realization_dc, 61) {
        true -> THIS realization_ds = "EXV"
        false -> THIS realization_ds = realization_decl_start.call(realization_dc)
      }
      "NX" -> SAME byte_equal.call(realization_dc, 61) {
        true -> THIS realization_ds = "NXV"
        false -> THIS realization_ds = realization_decl_start.call(realization_dc)
      }
      "EXV" -> SAME realization_dc {
        106 -> IN realization_ds_exe {
          THIS realization_exec_ok = true
          THIS realization_ds = "IDLE"
        }
        123 -> THIS realization_ds = "EXB"
        _ -> THIS realization_ds = realization_decl_start.call(realization_dc)
      }
      "NXV" -> SAME realization_dc {
        106 -> IN realization_ds_nxe {
          THIS realization_next_ok = true
          THIS realization_ds = "IDLE"
        }
        123 -> THIS realization_ds = "NXB"
        _ -> THIS realization_ds = realization_decl_start.call(realization_dc)
      }
      _ -> THIS realization_ds = realization_decl_start.call(realization_dc)
    }
    NO IN NONE
  }

