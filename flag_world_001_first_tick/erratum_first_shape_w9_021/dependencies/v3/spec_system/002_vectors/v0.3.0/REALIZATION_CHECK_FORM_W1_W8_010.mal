  // ONE token per identifier run: number (110), 64-hex digest (111), Vn (112), or a word code
  CAN readonly IN realization_cflush() -> Atom {
    SAME realization_cin {
      "RUN" -> IN realization_cf_run {
        THIS realization_run_code = realization_cword.call(realization_cnode)
        SAME realization_run_vn {
          "VD" -> THIS realization_run_code = 112
          _ -> NONE
        }
        SAME realization_and.call(realization_run_hex, realization_num_same.call(realization_run_len, TOGETHER { t: 6 o: 4 n: 2 })) {
          true -> THIS realization_run_code = 111
          false -> NONE
        }
        SAME realization_run_alldig {
          true -> SAME realization_run_code { 111 -> NONE _ -> THIS realization_run_code = 110 }
          false -> NONE
        }
        THIS realization_r = realization_ctoken.call(realization_run_code)
      }
      _ -> NONE
    }
    THIS realization_cin = "NONE"
    NO IN NONE
  }

  CAN readonly IN realization_run_start() -> Atom {
