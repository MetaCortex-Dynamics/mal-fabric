        THIS realization_binding_claim_cursor = realization_binding_associations
        realization_binding_association_walk.call()
        SAME realization_binding_argument_gap { true -> SAME realization_arg_status { "NO" -> NONE _ -> THIS realization_arg_status = "MAYBE" } false -> NONE }
        SAME realization_arg_status {
          "NO" -> THIS realization_e_status = "NO"
          "MAYBE" -> SAME realization_e_status { "NO" -> NONE _ -> THIS realization_e_status = "MAYBE" }
          _ -> NONE
