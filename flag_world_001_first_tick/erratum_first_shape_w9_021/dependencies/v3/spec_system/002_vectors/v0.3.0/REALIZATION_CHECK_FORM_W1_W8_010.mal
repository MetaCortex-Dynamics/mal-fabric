  CAN readonly IN realization_ctoken(realization_ct: Atom) -> Atom {
    realization_binding_token_before.call(realization_ct)
    SAME realization_sec {
      "NONE" -> SAME byte_equal.call(realization_ct, 109) {
        true -> SAME byte_equal.call(realization_prev_ct, 108) {
          true -> THIS realization_sec = "HEAD"
          false -> NONE
        }
        false -> NONE
      }
      "IN0" -> SAME realization_cline_rule {
        true -> NONE
        false -> THIS realization_r = realization_decl.call(realization_ct)
      }
      "IN" -> SAME realization_cline_rule {
        true -> NONE
        false -> THIS realization_r = realization_decl.call(realization_ct)
      }
      _ -> NONE
    }
    THIS realization_prev_ct = realization_ct
    THIS realization_r = realization_vtoken.call(realization_ct)
    THIS realization_ctok0 = false
    NO IN NONE
  }

  // -008: explicit identity witnesses retain declaration-local argument positions.
  // Positions bind arguments, never operation names. Hash-only output is not a reading opcode.
  CAN readonly IN realization_binding_numbered_range() -> Atom {
    SAME realization_ccl { "DASH" -> NONE _ -> NO IN false }
    THIS realization_binding_range_second = byte_seq_index.call(realization_source,realization_position)
    THIS realization_binding_range_v = byte_seq_index.call(realization_source,byte_index_successor.call(realization_position))
    SAME bool_and.call(realization_binding_range_second.found,realization_binding_range_v.found) { false -> NO IN false true -> NONE }
    NO IN bool_and.call(byte_equal.call(realization_binding_range_second.value,45),byte_equal.call(realization_binding_range_v.value,86))
  }
  CAN readonly IN realization_binding_token_bytes(realization_binding_tc: Atom) -> ByteSeq {
    SAME realization_binding_tc {
      40 -> NO IN byte_seq_single.call(40)
      41 -> NO IN byte_seq_single.call(41)
      44 -> NO IN byte_seq_single.call(44)
      61 -> NO IN byte_seq_single.call(61)
      123 -> NO IN byte_seq_single.call(123)
      125 -> NO IN byte_seq_single.call(125)
      254 -> NO IN byte_seq_single.call(realization_cbt)
      _ -> NO IN realization_run_bytes
    }
  }

  CAN readonly IN realization_binding_position_walk() -> Atom {
    THIS realization_binding_position_lookup = byte_seq_index.call(realization_binding_marker, realization_binding_position_index)
    SAME realization_binding_position_lookup.found {
      false -> NO IN NONE
      true -> IN realization_binding_position_digit {
        SAME realization_cclass.call(realization_binding_position_lookup.value) {
          "D" -> NONE
          _ -> IN realization_binding_position_gap { THIS realization_binding_position_ok = false NO IN NONE }
        }
        THIS realization_binding_position_seen = true
        THIS realization_binding_position_x2 = word32_add2_full.call(realization_binding_position_value,realization_binding_position_value)
        THIS realization_binding_position_x4 = word32_add2_full.call(realization_binding_position_x2.word,realization_binding_position_x2.word)
        THIS realization_binding_position_x8 = word32_add2_full.call(realization_binding_position_x4.word,realization_binding_position_x4.word)
        THIS realization_binding_position_x10 = word32_add2_full.call(realization_binding_position_x8.word,realization_binding_position_x2.word)
