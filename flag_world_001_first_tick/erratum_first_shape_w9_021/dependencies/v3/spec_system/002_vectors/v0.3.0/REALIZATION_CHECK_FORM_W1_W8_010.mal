  CAN readonly IN realization_discharge_arguments() -> Atom {
    SAME realization_arg_walk.kind {
      "END" -> NO IN NONE
      "NODE" -> IN realization_argument_obligation {
        THIS realization_arg_now = realization_arg_walk.value
        THIS realization_arg_witness = TOGETHER { kind: "ABSENT" reason: "INPUT_IDENTITY_WITNESS_ABSENT" }
        THIS realization_arg_status = "MAYBE"
