  // substring step: advance on a match, restart on the first byte, else back to the start
  CAN readonly IN realization_find(realization_f_node: Chain, realization_f_start: Chain, realization_f_byte: Atom) -> Chain {
    SAME realization_f_node.kind {
      "END" -> NO IN realization_f_node
      _ -> NONE
    }
    SAME byte_equal.call(realization_f_byte, realization_f_node.b) {
      true -> NO IN realization_f_node.next
      false -> NONE
    }
    SAME byte_equal.call(realization_f_byte, realization_f_start.b) {
      true -> NO IN realization_f_start.next
      false -> NO IN realization_f_start
    }
  }

  // prefix step: advance on a match, die otherwise
  CAN readonly IN realization_prefix(realization_p_node: Chain, realization_p_byte: Atom) -> Chain {
    SAME realization_p_node.kind {
      "B" -> SAME byte_equal.call(realization_p_byte, realization_p_node.b) {
        true -> NO IN realization_p_node.next
        false -> NO IN realization_dead.call()
      }
      _ -> NO IN realization_p_node
    }
  }

  CAN readonly IN realization_done(realization_d_node: Chain) -> Atom {
    SAME realization_d_node.kind {
      "END" -> NO IN true
      _ -> NO IN false
    }
  }

  // one law token against one cursor
  CAN readonly IN realization_law_step(realization_ls_node: Chain, realization_ls_tok: Atom) -> Chain {
    SAME realization_ls_node.kind {
      "B" -> SAME byte_equal.call(realization_ls_tok, realization_ls_node.b) {
        true -> NO IN realization_ls_node.next
        false -> NO IN realization_dead.call()
      }
      _ -> NO IN realization_dead.call()
    }
  }

  CAN readonly IN realization_law_seen(realization_lz: Atom) -> Atom {
    SAME realization_lz {
      true -> THIS realization_w5 = false
      false -> NONE
    }
    NO IN true
  }

  CAN readonly IN realization_law_end() -> Atom {
    THIS realization_law_hit = false
    SAME realization_done.call(realization_k1) {
      true -> IN realization_le1 {
        THIS realization_law_l1 = realization_law_seen.call(realization_law_l1)
        THIS realization_law_hit = true
      }
      false -> NONE
    }
    SAME realization_done.call(realization_k2) {
      true -> IN realization_le2 {
        THIS realization_law_l2 = realization_law_seen.call(realization_law_l2)
        THIS realization_law_hit = true
      }
      false -> NONE
    }
    SAME realization_done.call(realization_k3) {
      true -> IN realization_le3 {
        THIS realization_law_l3 = realization_law_seen.call(realization_law_l3)
        THIS realization_law_hit = true
      }
      false -> NONE
    }
    SAME realization_done.call(realization_k4) {
      true -> IN realization_le4 {
        THIS realization_law_l4 = realization_law_seen.call(realization_law_l4)
        THIS realization_law_hit = true
      }
      false -> NONE
    }
    SAME realization_law_hit {
      true -> NONE
      false -> THIS realization_w5 = false
    }
    THIS realization_in_law = false
    NO IN NONE
  }

  // seed-block entry machine: START -> W -> LP -> O -> END  |  START -> A (atom) ; "," or "}" closes
  CAN readonly IN realization_entry_close() -> Atom {
    SAME realization_es {
      "START" -> NONE
      "A" -> THIS realization_r = realization_mark_atom.call(realization_eop)
      "END" -> NONE
      _ -> IN realization_entry_bad {
        THIS realization_w2 = false
        THIS realization_walk_entries = false
      }
    }
    THIS realization_es = "START"
    NO IN NONE
  }

  CAN readonly IN realization_entry_token(realization_et: Atom) -> Atom {
    SAME byte_equal.call(realization_et, 44) {
      true -> NO IN realization_entry_close.call()
      false -> NONE
    }
    SAME realization_es {
      "START" -> SAME realization_is_wit.call(realization_et) {
        true -> IN realization_et_w {
          THIS realization_es = "W"
          THIS realization_ewit = realization_et
        }
        false -> SAME realization_is_op.call(realization_et) {
          true -> IN realization_et_a {
            THIS realization_es = "A"
            THIS realization_eop = realization_et
          }
          false -> THIS realization_es = "BAD"
        }
      }
      "W" -> SAME byte_equal.call(realization_et, 40) {
        true -> THIS realization_es = "LP"
        false -> THIS realization_es = "BAD"
      }
      "LP" -> SAME realization_is_op.call(realization_et) {
        true -> IN realization_et_o {
          THIS realization_es = "O"
          THIS realization_eop = realization_et
        }
        false -> THIS realization_es = "BAD"
      }
      "O" -> SAME byte_equal.call(realization_et, 41) {
        true -> IN realization_et_cell {
          THIS realization_es = "END"
          THIS realization_r = realization_mark_cell.call(realization_ewit, realization_eop)
          THIS realization_need_reading = true
        }
        false -> THIS realization_es = "BAD"
      }
      _ -> THIS realization_es = "BAD"
    }
    NO IN NONE
  }

  // every code token
  CAN readonly IN realization_token(realization_tk: Atom) -> Atom {
    SAME realization_inside {
      true -> SAME byte_equal.call(realization_tk, 125) {
        true -> IN realization_tk_close {
          THIS realization_r = realization_entry_close.call()
          THIS realization_inside = false
        }
        false -> THIS realization_r = realization_entry_token.call(realization_tk)
      }
      false -> IN realization_tk_out {
        SAME byte_equal.call(realization_tk, 23) {
          true -> SAME realization_w8_authority {
            true -> THIS realization_after_seed = true
            false -> IN realization_unannotated_seed {
              THIS realization_w2 = false
              THIS realization_after_seed = false
            }
          }
          false -> NONE
        }
        SAME byte_equal.call(realization_tk, 123) {
          true -> SAME realization_after_seed {
            true -> IN realization_tk_open {
              SAME realization_blocks {
                "NONE" -> THIS realization_blocks = "ONE"
                _ -> THIS realization_w2 = false
              }
              THIS realization_inside = true
              THIS realization_after_seed = false
              THIS realization_es = "START"
            }
            false -> NONE
          }
          false -> NONE
        }
        SAME realization_in_law {
          true -> IN realization_tk_law {
            THIS realization_k1 = realization_law_step.call(realization_k1, realization_tk)
            THIS realization_k2 = realization_law_step.call(realization_k2, realization_tk)
            THIS realization_k3 = realization_law_step.call(realization_k3, realization_tk)
            THIS realization_k4 = realization_law_step.call(realization_k4, realization_tk)
            SAME byte_equal.call(realization_tk, 59) {
              true -> THIS realization_r = realization_law_end.call()
              false -> NONE
            }
          }
          false -> SAME byte_equal.call(realization_tk, 24) {
            true -> IN realization_tk_law_open {
              THIS realization_in_law = true
              THIS realization_k1 = realization_law1.call().next
              THIS realization_k2 = realization_law2.call().next
              THIS realization_k3 = realization_law3.call().next
              THIS realization_k4 = realization_law4.call().next
            }
            false -> NONE
          }
        }
      }
    }
    NO IN NONE
  }

  CAN readonly IN realization_flush() -> Atom {
    SAME realization_node {
      "^" -> NONE
      _ -> IN realization_w8_flush_both { THIS realization_w8_r = realization_w8_token.call(realization_w8_word.call(realization_w8_node)) THIS realization_w8_node = "^" THIS realization_r = realization_token.call(realization_word_code.call(realization_node)) }
    }
    THIS realization_node = "^"
    NO IN NONE
  }

  CAN readonly IN realization_code_byte(realization_cb: Atom, realization_cb_class: Atom) -> Atom {
    SAME realization_cb { 64 -> THIS realization_w8_authority = true _ -> NONE }
    SAME realization_cb_class {
      "ID" -> IN realization_cb_id {
        THIS realization_node = realization_step.call(realization_node, realization_cb)
        THIS realization_w8_node = realization_w8_lex.call(realization_w8_node, realization_cb)
        THIS realization_in_header = false
      }
      "SL" -> IN realization_cb_slash {
        THIS realization_r = realization_flush.call()
        THIS realization_mode = "SLASH"
      }
      "WS" -> THIS realization_r = realization_flush.call()
      "LF" -> IN realization_cb_lf {
        THIS realization_r = realization_flush.call()
        SAME realization_need_reading {
          true -> THIS realization_w3 = false
          false -> NONE
        }
        THIS realization_r = realization_line_end.call()
      }
      "PU" -> IN realization_cb_pu {
        THIS realization_r = realization_flush.call()
        THIS realization_w8_r = realization_w8_token.call(realization_cb)
        THIS realization_r = realization_token.call(realization_cb)
        THIS realization_in_header = false
      }
      _ -> IN realization_cb_ot {
        THIS realization_r = realization_flush.call()
        THIS realization_w8_r = realization_w8_token.call(254)
        THIS realization_r = realization_token.call(254)
        THIS realization_in_header = false
      }
    }
    SAME realization_cb { 13 -> THIS realization_w8_authority = false _ -> NONE }
    NO IN NONE
  }

  CAN readonly IN realization_bytes_step(realization_bs: Atom) -> Atom {
    THIS realization_m1 = realization_prefix.call(realization_m1, realization_bs)
    SAME realization_in_header {
      true -> IN realization_bs_head {
        THIS realization_m2 = realization_find.call(realization_m2, realization_pat2.call(), realization_bs)
