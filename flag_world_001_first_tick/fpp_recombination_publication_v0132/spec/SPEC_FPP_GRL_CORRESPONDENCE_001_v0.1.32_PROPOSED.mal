// by no obligation.

domain FPP_GRL_CORRESPONDENCE;

@propose seed FPP_GRL_CORRESPONDENCE := {
  WHAT(THIS),            // The object is the correspondence between FPP §6 fold-accounting terms and native GRL objects of
                         // one world's tick; THIS := that world's root ▽ (J17 first). BECAUSE FPP :131–138, PROOF, TICK.
  HOW(THIS),             // Referents are read as native identities in the world's own records; no label supplies one.
                         // BECAUSE JUNCTIONS, FRAME.
  FOR_WHAT(THIS),        // So FPP accounting can be checked inside the world that unfolds. BECAUSE SAY S07, TICK.

  WHAT(SAME_NOT_SAME),   // Candidate (R_ONE of O_FPP_FOLD_ACCOUNTING): ONE SAME the coupled whole of a bound junction (CARRIER,
                         // vertex_id), whose four domain–witness positions lift to four whole ▽ roots. The candidate does not
                         // by itself discharge FPP's accounting restrictions. BECAUSE FPP :133, CARRIER, R243, R244.
  HOW(SAME_NOT_SAME),    // By identity: source_obligation lineage from predecessor openings to successor images. BECAUSE JUNCTIONS.
  FOR_WHAT(SAME_NOT_SAME), // Correspondence is by identity, never by count. BECAUSE SKEL (q₁ is about foldable-ones), JUNCTIONS.

  WHAT(NO),              // The externally seeded fixture is NO as a referent for MANY or ONE. BECAUSE N6, SAY S07.
  HOW(NO),               // Non-discharging routes: (a) counting images as q₁; (b) equating BORN with shed; (c) inserting a
                         // structure from outside the world; (d) identifying MANY, ONE and carriers one term at a time —
                         // FPP :131–138 is a joint accounting clause; (e) summing or subtracting q-readings, which are
                         // operator readings (1 := THIS, 0 := NO), not quantities; (f) taking a refinement four for a coupled
                         // four; (g) treating separately checked face, edge, vertex, dual, boundary and genealogical
                         // conditions as constitutive admission without their joint satisfaction on the SAME candidate c
                         // cannot discharge that joint requirement (CGRL_TEXT L48). BECAUSE FPP, JUNCTIONS, TRACE, SAY S07,
                         // W10D W10.4, R198, R195, CGRL_TEXT.

  WHAT(IF_THEN),         // IF the tick admits THEN FPP's fold of that tick is admitted (enough-for-fold), as an obligation to
                         // discharge by SAME, not a measurement. BECAUSE FPP :58, TICK.
  HOW(IF_THEN),          // The admission is the native F25_ADMIT → F25_EFFECT pair of the tick. BECAUSE PROOF.
  FOR_WHAT(IF_THEN),     // Enough-for-fold is a verdict, not a threshold. BECAUSE FPP :58.

  WHAT(BECAUSE),         // Every correspondence row carries the clause that grounds it. BECAUSE W10D, TICK.
  HOW(BECAUSE),          // The native BECAUSE is the source_obligation chain. BECAUSE JUNCTIONS.
  FOR_WHAT(BECAUSE),     // Reason this object exists: FPP §6 terms have no bound native referents; the native evidence of
                         // J17's fold is complete while the joint FPP identification on the junction product reads MAYBE on all
                         // eight restrictions (q₂ SAME within the junction's members, q₁ within refinement families); FPP is to be
                         // read inside the fabric universe. BECAUSE FPP, PROOF, JUNCTIONS, SAY S07, R199, R155, R243.

  WHAT(INSIDE_OUTSIDE),  // Openings BORN this fold are INSIDE the admitted successor's F (carried), not shed. BECAUSE JUNCTIONS.
  HOW(INSIDE_OUTSIDE),   // receipt_class BORN within the successor F. BECAUSE JUNCTIONS, INV.
  FOR_WHAT(INSIDE_OUTSIDE), // δ is shed OUTSIDE; no identity-bound shed is found in the inspected records (R098 L9–L11), and that
                         // absence does not falsify constitutive shedding, whose witness is the substrate unfolding (DSUB
                         // L12–L18); on the junction product δ stays MAYBE (link 2 → 3: R_REC_DELTA). BECAUSE FPP :138, R098, DSUB.

  WHAT(NEAR_FAR),        // The fold's coupling is the tick's discharge activity. BECAUSE THERMAL_V014, FPP :47.
  HOW(NEAR_FAR),         // Read per location as native discharge events. BECAUSE THERMAL_V014, JUNCTIONS.
  FOR_WHAT(NEAR_FAR),    // Supplies FPP's NEAR from inside; Π has no inverse. BECAUSE FPP :74–83.

  WHAT(CAN_CANNOT),      // The externally seeded fixture CANNOT supply MANY or ONE; only the world's own fold CAN.
                         // BECAUSE N6, SAY S07.

  WHAT(MAYBE),           // On the junction product, δ (R_DELTA) and seven further restrictions are carried MAYBE with their exact
                         // operands; q₂ is SAME within R199's scope (the junction's members) and q₁ within R155's (refinement
                         // families); neither transfers to the product. BECAUSE FPP :138, R199, R155, DSUB, R201, R243.
  HOW(MAYBE),            // Each open operand is stored once. BECAUSE JUNCTIONS.
  FOR_WHAT(MAYBE),       // Never selected. BECAUSE FPP §7.

  WHAT(MUST_LET),        // MUST: every FPP term binds to native identities of the world's own tick. LET: none.
                         // BECAUSE SAY S07, TICK.

  WHAT(TOGETHER_ALONE),  // Each world's correspondence stands ALONE; J17 and Metis are never joined. BECAUSE TICK (each world
                         // appends by its own admission on its own inputs).

  WHAT(MORE_LESS),       // Each consumed opening has more than one image (T1 three, T2–T4 two); identity is preserved while
                         // images are more than one. BECAUSE FRAME, INV.
  HOW(MORE_LESS),        // Read through lineage, not by tally. BECAUSE JUNCTIONS.
  FOR_WHAT(MORE_LESS),   // q₁ conservation is identity coverage of foldable-ones. BECAUSE SKEL.

  WHAT(GOES_WITH),       // Each image goes with its source obligation. BECAUSE FRAME (J39_IMAGE).
  HOW(GOES_WITH),        // J39_IMAGE relations, identity-bound. BECAUSE FRAME, JUNCTIONS.
  FOR_WHAT(GOES_WITH),   // The four ▽ roots go with the junction's coupled whole through the domain–witness incidence lift.
                         // BECAUSE FPP :133, CARRIER, R243.

  WHAT(MANY_ONE),        // Candidate definitions (R_ONE, R_MANY of O_FPP_FOLD_ACCOUNTING): MANY := the four whole ▽ roots lifted
                         // from a bound junction's domain–witness pairs; ONE := that junction's coupled whole. The refinement
                         // (ONE whole → its four parts) is the witnessed recursion, NOT_SAME the coupling. BECAUSE FPP :133,
                         // CARRIER, R243, R238, R195.
  HOW(MANY_ONE),         // Identity coverage on the junction: each of the four positions lifts to exactly one whole ▽ root
                         // (120 positions over 30 junctions). BECAUSE CARRIER, R243.
  FOR_WHAT(MANY_ONE),    // Candidate: FPP's MANY → ONE read as the four ▽ roots → the junction's coupled whole, inside the
                         // recursion the refinement witnesses, to be witnessed by one joint record. BECAUSE FPP :131–138,
                         // R243, R238.

  WHAT(EVERY_SOME),      // Every predecessor opening is consumed; none remains unimaged. BECAUSE INV.

  THIS, SAME_NOT_SAME, NO, IF_THEN, BECAUSE, INSIDE_OUTSIDE, NEAR_FAR, CAN_CANNOT, MAYBE, MUST_LET,
  TOGETHER_ALONE, MORE_LESS, GOES_WITH, MANY_ONE, EVERY_SOME
};

law R1_WHERE :=
  IF WHAT(o)
  THEN WHERE(o);

law R1_WHICH :=
  IF WHAT(o)
  THEN WHICH(o);

law R1_WHEN :=
  IF HOW(o)
  THEN WHEN(o);

law R2_WHENCE :=
  IF WHERE(o), WHICH(o), WHEN(o), FOR_WHAT(o), FOR_WHAT(BECAUSE)
  THEN WHENCE(o);

// OBLIGATION WITNESSES (readings of this one object, not additional laws).
// O_FPP_FOLD_ACCOUNTING: FPP's fold accounting (MANY, ONE, foldable-ones, coupled product, carriers, separation-content, δ shed) read on one world's tick as one joint witness. Each restriction below is part of that witness; none is a separate stage.
// R_ONE: FPP ONE (stable coupled product) is SAME the coupled whole of a bound junction, identified by carrier hash (CARRIER) and vertex_id, with its complete domain/witness incidence (two domains × two witness triangles).
// R_MANY: FPP foldable-ones are SAME the four whole ▽ roots (CCD triads by type, corridor–corridor–domain: DR345 L17; named CCD roots at R259 L19) uniquely lifted from that junction's domain–witness pairs, R(d0,t0), R(d0,t1), R(d1,t0), R(d1,t1).
// R_ADMISSION: Enough-for-fold: FPP's internal MUST condition is SAME the tick's admission (site AGREE and typed AGREE).
// R_FOLDABLE_ONES: q₁ defined consistently at source and product: predecessor identities preserved (each once, not by image multiplicity) and the product's BORN openings, which are carried within the part wholes that hold them into the next construction (R243 L14). Open operand FPP_PRODUCT_FOLDABLE_ONE_MEMBERSHIP_AND_Q1_CONTRIBUTION: which product entries, including BORN and multiple source images, contribute to the same foldable-one accounting; whether BORN are product constituents, carriers or remainder.
// R_POLARITY: q₂ coupling polarity. No typed record field binds coupling-polarity roles; candidate: operator poles (operations). Not selected.
// R_DELTA: Separation-content the product cannot absorb, shed and receipted. Births are carried inside F; no shed receipt is located.
// R_ARITY: The Skeleton's minimal-preferred fold-arity four (stability): state whether this correspondence tests FPP's general accounting form, the minimal stable construction, or both. Refinement relates one whole face to its four parts; refinement and coupling are NOT_SAME as direct constructions, so matching arity supplies neither membership nor stability. MAYBE.
// R_DIRECTION: The tick is the unfolding: ONE whole → MANY parts (four) (Devon, D202: "ONE parent → MANY children (four)"; labels per R258), witnessed as the recursive construction (R238). FPP's fold relates MANY → ONE at the bound junction: the four whole ▽ roots → the junction's coupled whole; it is NOT_SAME the refinement relation (R195).
// REQUIRED: One correspondence record carrying all eight restrictions with source clauses and native identities; root-G conditional cases carried through it, never collapsed; for the 60 CCD triads G := D by type and is not a conditional case (DR345 L16–L17, L23; R259 L18–L19). A record supplying R_ONE and R_MANY without R_FOLDABLE_ONES, R_DELTA and R_DIRECTION is a finding, not partial discharge. Absent operand, named and not supplied: Devon's 2026-11-06 "the reaction IS the Tick" as original message bytes.
// STATUS: PENDING
// SUBJECT: FPP_FOLD_ON_TICK
// LAW_CLAUSE: FPP#L131-L138; FPP#L133-L133; FPP#L135-L136; FPP#L138-L138; FPP#L58-L58; SKEL#L345-L359; SKEL#L337-L342; FRAME#L42-L46; FRAME#L24-L27; JUNCTIONS#L23-L37; JUNCTIONS#L24-L30; JUNCTIONS#L38-L45; INV#/inventory; INV#/O8; PROOF#/parts/ADMIT/fact; PROOF#/effect/fact; TICK#L12-L23; TRACE#L643-L645; BIND#L53-L64; GROUND#L18-L34
// O_FPP_RECOMBINATION_ACCOUNTING: FPP's fold accounting (MANY, ONE, q₁, q₂, carriers, δ shed) read on ONE recombination of one world, J17 link 2 → 3, as one joint witness. Each restriction below is part of that witness; none is a separate stage. Its subject is proposed as NOT_SAME the subject of O_FPP_FOLD_ACCOUNTING (SOURCE USE (two subjects)): this tick preserves its carrier configuration and performs no refinement (CPLR L1, L18).
// R_REC_ROOTS: Junction 17 (CARRIER /vertices/17, signature [0,3,4,9]: witness labels {0,3}, domains {4,9}) has the four CCD roots 48, 52, 50 and 54 (ROOTS); they are the four roots R_MANY names for that junction, and each retains all six of its flag identities before and after (CRJA L1–L12).
// R_REC_MANY: MANY := the foldable whole together with the twelve-flag THIS defect as its input anti-polarity carrier (CRJA L16; TRH L24). The four CCD roots are constituents of the coupled whole and are not this reaction's MANY (CRJA L37).
// R_REC_ONE: ONE := the preserved carrier configuration, read at junction 17 with its same four CCD roots and complete incidence, now carrying the uniform-NO field (CRJA L17). FPP's general clause is applied to this fold, which the paper does not work (TRH L31–L32); the coupled-two and coupled-four stability arguments are not used for this reaction (TRH L34; CRJA L39, L41).
// R_REC_Q1: q₁ is SAME before and after: the foldable whole persists and the input defect is a carrier, not an additional foldable-one (CRJA L25). BORN openings and image multiplicity belong to folds that form new parts (CRJA L38).
// R_REC_Q2: q₂ is SAME under the bound recombination account: the opposed foldable-one and carrier contributions of MANY are retained in the product's neutral account, and no output polarity-carrier is required (CRJA L26).
// R_REC_DELTA: δ := the departing twelve-flag THIS section, realized by the twelve captured ASSIGN effects, facts 623402–623413 (CRJA L18, L27; C1727 L15–L17). Its substrate witness is discharged for this fold (RDISCH L4–L13).
// R_REC_NO_REMAINDER: The reaction has no output remainder-carrier; γ is Π(δ) and carries no q_i (CRJA L19; C1725 L1–L11; TRH L25–L26).
// R_REC_TRANSITION: MANY, ONE and δ belong to ONE transition supported by the one admitted effect 623321: predecessor coupled state → successor coupled state + δ (CRJA L21, L40). The references at junctions 15, 16, 18 and 25 locate shared incidence and introduce no reactant or remainder-carrier (CRJA L21; C1725 L41). Enough-for-fold, the reaction's MUST (TRH L25), is read from this reaction's own coupling operands: over the complete twelve-flag section 12 DELTA overlaps go NOT_SAME → SAME and 6 GAMMA and 6 TAU overlaps stay SAME, every member has all three overlap-kind witnesses, no new disagreement opens and none remains (CEFF L7–L13, L24). The strict move R1_STRICT 582029, whose ordered supports are the complete coupling read 580038, that same member extent's root 210262, no opened disagreement over that extent 579648 and a witnessed discharged disagreement 561071, is carried into the admission premise 623237 and from it to the effect 623321, and no selection intervenes (CEFF L5, L15–L22). The reading imports no four-root stability test, refinement admission or numerical coupling threshold (CEFF L26; CRJA L42); CPLR L15's MAYBE on the four-root product of the first obligation's R_ADMISSION is another operand (CN0125 L47).
// REQUIRED: One correspondence record carrying all eight restrictions with source lines and native identities on link 2 → 3. Offered: CRJA with C1725, C1727, ROOTS, CEFF and the discharged shed witness (RDISCH). Whether that record discharges this obligation is Devon's DECIDE; these bytes do not discharge it.
