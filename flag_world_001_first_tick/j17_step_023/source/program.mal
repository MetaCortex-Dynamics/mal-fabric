// EXECUTE TASK_CODEX_J17_SECOND_STEP_023, exact source-selected subprogram.
// No admission verdict, membership, placement or route selection enters from host.
// Generic custody contacts: J23_ID_RESPONSE(source_term, TEXT(exact_term_bytes));
// J23_ROUTE_HASH(m,RESULT,c,role,rid,mid,cid) is the pinned u64be-length
// prefixed SHA256 over (mid,"RESULT",cid,role). Program hash is generic sorted
// compact JSON SHA256. The three inventories order observed source facts only.
// Reverse coverage walks the already source-checked committed 480 field rows
// and 720 overlap rows. No count substitutes for a missing selected occurrence.
// Static definition E328B574 sections3--8,13; imported kernel8B983301 lines
// 386--433,501--630. Existing normalized per-occurrence enclosure pattern:
// frozen020/source/program.mal 08651A36, lines67--86.
// Source uses G/S/F; boxed JSON strings preserve imported static ABI spelling.
@propose seed J23_STATIC_SCHEMA := {
 THIS(J23_FABRIC_ROOT,"FLAG_WORLD_J17_SECOND_STEP_023"),
 THIS(J23_TICK_BLOCK,"FIRST_TICK"),
 GOES_WITH(J23_WITNESS_TYPE,WHAT,"identity/essence"),
 GOES_WITH(J23_SCHEMA,THIS,VALUE,EXACTLY_ONE),
 GOES_WITH(J23_SCHEMA,SAME_NOT_SAME,LEFT,EXACTLY_ONE),
 GOES_WITH(J23_SCHEMA,SAME_NOT_SAME,RIGHT,EXACTLY_ONE),
 GOES_WITH(J23_BYTE_NEXT,B40,B41),
 GOES_WITH(J23_BYTE_NEXT,B41,B44),
 GOES_WITH(J23_BYTE_NEXT,B44,B48),
 GOES_WITH(J23_BYTE_NEXT,B48,B49),
 GOES_WITH(J23_BYTE_NEXT,B49,B50),
 GOES_WITH(J23_BYTE_NEXT,B50,B51),
 GOES_WITH(J23_BYTE_NEXT,B51,B52),
 GOES_WITH(J23_BYTE_NEXT,B52,B53),
 GOES_WITH(J23_BYTE_NEXT,B53,B54),
 GOES_WITH(J23_BYTE_NEXT,B54,B55),
 GOES_WITH(J23_BYTE_NEXT,B55,B56),
 GOES_WITH(J23_BYTE_NEXT,B56,B57),
 GOES_WITH(J23_BYTE_NEXT,B57,B65),
 GOES_WITH(J23_BYTE_NEXT,B65,B66),
 GOES_WITH(J23_BYTE_NEXT,B66,B67),
 GOES_WITH(J23_BYTE_NEXT,B67,B68),
 GOES_WITH(J23_BYTE_NEXT,B68,B69),
 GOES_WITH(J23_BYTE_NEXT,B69,B70),
 GOES_WITH(J23_BYTE_NEXT,B70,B71),
 GOES_WITH(J23_BYTE_NEXT,B71,B72),
 GOES_WITH(J23_BYTE_NEXT,B72,B73),
 GOES_WITH(J23_BYTE_NEXT,B73,B74),
 GOES_WITH(J23_BYTE_NEXT,B74,B75),
 GOES_WITH(J23_BYTE_NEXT,B75,B76),
 GOES_WITH(J23_BYTE_NEXT,B76,B77),
 GOES_WITH(J23_BYTE_NEXT,B77,B78),
 GOES_WITH(J23_BYTE_NEXT,B78,B79),
 GOES_WITH(J23_BYTE_NEXT,B79,B80),
 GOES_WITH(J23_BYTE_NEXT,B80,B81),
 GOES_WITH(J23_BYTE_NEXT,B81,B82),
 GOES_WITH(J23_BYTE_NEXT,B82,B83),
 GOES_WITH(J23_BYTE_NEXT,B83,B84),
 GOES_WITH(J23_BYTE_NEXT,B84,B85),
 GOES_WITH(J23_BYTE_NEXT,B85,B86),
 GOES_WITH(J23_BYTE_NEXT,B86,B87),
 GOES_WITH(J23_BYTE_NEXT,B87,B88),
 GOES_WITH(J23_BYTE_NEXT,B88,B89),
 GOES_WITH(J23_BYTE_NEXT,B89,B90),
 GOES_WITH(J23_BYTE_NEXT,B90,B95),
 GOES_WITH(J23_BYTE_NEXT,B95,B97),
 GOES_WITH(J23_BYTE_NEXT,B97,B98),
 GOES_WITH(J23_BYTE_NEXT,B98,B99),
 GOES_WITH(J23_BYTE_NEXT,B99,B100),
 GOES_WITH(J23_BYTE_NEXT,B100,B101),
 GOES_WITH(J23_BYTE_NEXT,B101,B102)
};

// Canonical byte order is observation encoding, never locus/role selection.
law J23_BYTE_ORDER_BASE := IF GOES_WITH(J23_BYTE_NEXT,a,b)
 THEN GOES_WITH(J23_BYTE_LESS,a,b);
law J23_BYTE_ORDER_CHAIN := IF GOES_WITH(J23_BYTE_LESS,a,b), GOES_WITH(J23_BYTE_NEXT,b,c)
 THEN GOES_WITH(J23_BYTE_LESS,a,c);
law J23_LEX_PREFIX_REQUEST := IF THIS(J23_LEX_REQUEST,CONS(a,x),CONS(a,y))
 THEN THIS(J23_LEX_REQUEST,x,y);
law J23_LEX_FIRST_DISTINCT := IF THIS(J23_LEX_REQUEST,CONS(a,x),CONS(b,y)), GOES_WITH(J23_BYTE_LESS,a,b)
 THEN GOES_WITH(J23_LEX_LESS,CONS(a,x),CONS(b,y));
law J23_LEX_SHORTER := IF THIS(J23_LEX_REQUEST,NIL,CONS(a,y))
 THEN GOES_WITH(J23_LEX_LESS,NIL,CONS(a,y));
law J23_LEX_EQUAL_PREFIX := IF THIS(J23_LEX_REQUEST,CONS(a,x),CONS(a,y)), GOES_WITH(J23_LEX_LESS,x,y)
 THEN GOES_WITH(J23_LEX_LESS,CONS(a,x),CONS(a,y));

law J23_CELLS_START := IF THIS(J23_INVENTORY_CELLS,xs) THEN GOES_WITH(J23_LIST,CELLS,xs);
law J23_ROUTES_START := IF THIS(J23_INVENTORY_ROUTES,xs) THEN GOES_WITH(J23_LIST,ROUTES,xs);
law J23_COMPARATORS_START := IF THIS(J23_INVENTORY_COMPARATORS,xs) THEN GOES_WITH(J23_LIST,COMPARATORS,xs);
law J23_LIST_TAIL := IF GOES_WITH(J23_LIST,k,CONS(a,t)) THEN GOES_WITH(J23_LIST,k,t);
law J23_CELL_LIST_MEMBER := IF GOES_WITH(J23_LIST,CELLS,CONS(c,t)), GOES_WITH(J23_ID_RESPONSE,c,id)
 THEN GOES_WITH(J23_DECLARED_CELL,c,id);
law J23_COMP_LIST_MEMBER := IF GOES_WITH(J23_LIST,COMPARATORS,CONS(c,t)), GOES_WITH(J23_ID_RESPONSE,c,id), GOES_WITH(J23_SELECTED_COMPARATOR,c,f,g)
 THEN GOES_WITH(J23_DECLARED_COMPARATOR,c,id,f,g);
law J23_ROUTE_LIST_MEMBER := IF GOES_WITH(J23_LIST,ROUTES,CONS(ROUTE(rid,m,RESULT,c,role),t)), GOES_WITH(J23_SELECTED_ROUTE,m,RESULT,c,role), GOES_WITH(J23_ROUTE_HASH,m,RESULT,c,role,rid,mid,cid), GOES_WITH(J23_ID_RESPONSE,m,mid), GOES_WITH(J23_ID_RESPONSE,c,cid)
 THEN GOES_WITH(J23_DECLARED_ROUTE,ROUTE(rid,m,RESULT,c,role),mid,cid);
law J23_CELL_KEY := IF GOES_WITH(J23_LIST,CELLS,CONS(c,t)), GOES_WITH(J23_DECLARED_CELL,c,id)
 THEN GOES_WITH(J23_LIST_KEY,CELLS,c,id);
law J23_COMP_KEY := IF GOES_WITH(J23_LIST,COMPARATORS,CONS(c,t)), GOES_WITH(J23_DECLARED_COMPARATOR,c,id,f,g)
 THEN GOES_WITH(J23_LIST_KEY,COMPARATORS,c,id);
law J23_ROUTE_KEY := IF GOES_WITH(J23_DECLARED_ROUTE,ROUTE(rid,m,RESULT,c,role),mid,cid)
 THEN GOES_WITH(J23_LIST_KEY,ROUTES,ROUTE(rid,m,RESULT,c,role),rid);
law J23_LIST_ORDER_REQUEST := IF GOES_WITH(J23_LIST,k,CONS(a,CONS(b,t))), GOES_WITH(J23_LIST_KEY,k,a,TEXT(x)), GOES_WITH(J23_LIST_KEY,k,b,TEXT(y))
 THEN THIS(J23_LEX_REQUEST,x,y);
law J23_LIST_ORDER := IF GOES_WITH(J23_LIST,k,CONS(a,CONS(b,t))), GOES_WITH(J23_LIST_KEY,k,a,TEXT(x)), GOES_WITH(J23_LIST_KEY,k,b,TEXT(y)), GOES_WITH(J23_LEX_LESS,x,y)
 THEN THIS(J23_ORDERED,k,CONS(a,CONS(b,t)));
law J23_LIST_LAST := IF GOES_WITH(J23_LIST,k,CONS(a,NIL)), GOES_WITH(J23_LIST_KEY,k,a,id)
 THEN THIS(J23_ORDERED,k,CONS(a,NIL));

// Every selected cell is typed and located from its own already-produced contact.
// Constructor namespaces separate marker identities, comparator identities,
// source enclosures, block and root; strict inventory order prohibits aliases.
law J23_MARKER_CELL := IF GOES_WITH(J23_SELECTED_MARKER,m,f), GOES_WITH(J23_DECLARED_CELL,m,id), GOES_WITH(J22_CLASS,m,A,w,j,S), GOES_WITH(J22_LOCATION_EVIDENCE,m,LOCATION(INTERIOR(S),CONTAINMENT(FIRST_TICK,INCIDENCE(v,e,t)))), GOES_WITH(J21_COORDINATE,m,INCIDENCE(v,e,t),PARENT(w)), GOES_WITH(J22_MARKER_CAPABILITY,G), GOES_WITH(J22_MARKER_CAPABILITY,S), GOES_WITH(J23_SCHEMA,THIS,VALUE,EXACTLY_ONE)
 THEN GOES_WITH(J23_TYPED_SOURCE,m,id,THIS,"THIS",CONTAINMENT(FIRST_TICK,INCIDENCE(v,e,t)));
law J23_COMPARATOR_SCHEMA := IF GOES_WITH(SF_CAPABILITY,SAME_NOT_SAME,G), GOES_WITH(SF_CAPABILITY,SAME_NOT_SAME,S), GOES_WITH(J23_SCHEMA,SAME_NOT_SAME,LEFT,EXACTLY_ONE), GOES_WITH(J23_SCHEMA,SAME_NOT_SAME,RIGHT,EXACTLY_ONE)
 THEN THIS(J23_COMPARATOR_SCHEMA);
law J23_COMPARATOR_CELL := IF GOES_WITH(J23_SELECTED_COMPARATOR,c,f,g), GOES_WITH(J23_DECLARED_COMPARATOR,c,id,f,g), GOES_WITH(J23_DECLARED_CELL,c,id), GOES_WITH(SF_OCCURRENCE_ADMITTED,c,e), GOES_WITH(SF_OCCURRENCE_PLACEMENT,c,LOCATION(INTERIOR(S),CONTAINMENT(FIRST_TICK,OVERLAP(f,g)))), THIS(J23_COMPARATOR_SCHEMA)
 THEN GOES_WITH(J23_TYPED_SOURCE,c,id,SAME_NOT_SAME,"SAME_NOT_SAME",CONTAINMENT(FIRST_TICK,OVERLAP(f,g)));
law J23_CELL_ID_EXPORT := IF GOES_WITH(J23_TYPED_SOURCE,c,id,op,text,enclosure)
 THEN GOES_WITH(J23_CELL_ID,c,id);
law J23_ENCLOSURE_ID := IF GOES_WITH(J23_TYPED_SOURCE,c,TEXT(h),op,text,enclosure)
 THEN GOES_WITH(J23_ENCLOSURE_ID,c,TEXT(CONS(B101,CONS(B110,CONS(B99,CONS(B108,CONS(B111,CONS(B115,CONS(B117,CONS(B114,CONS(B101,CONS(B58,h))))))))))),enclosure);
law J23_CELL_DEF := IF GOES_WITH(J23_TYPED_SOURCE,c,id,op,text,enclosure), GOES_WITH(J23_WITNESS_TYPE,WHAT,t)
 THEN GOES_WITH(J23_CELL_DEF,c,OBJECT(CONS(MEMBER("cell_id",id),CONS(MEMBER("operator",text),CONS(MEMBER("payload_slot_type",t),CONS(MEMBER("triad_capability",ARRAY(CONS("\u25a1G",CONS("\u25a1S",NIL)))),CONS(MEMBER("witness","WHAT"),NIL)))))));
law J23_LOCATION := IF GOES_WITH(J23_TYPED_SOURCE,c,id,op,text,enclosure), GOES_WITH(J23_ENCLOSURE_ID,c,m,enclosure), THIS(J23_TICK_BLOCK,b), THIS(J23_FABRIC_ROOT,p)
 THEN GOES_WITH(J23_LOCATION,c,OBJECT(CONS(MEMBER("containment_path",ARRAY(CONS(m,CONS(b,CONS(p,NIL))))),CONS(MEMBER("triad_position",OBJECT(CONS(MEMBER("dimension","\u25a1S"),CONS(MEMBER("kind","INTERIOR"),NIL)))),NIL))));
law J23_PLACEMENT_ROW := IF GOES_WITH(J23_CELL_ID,c,id), GOES_WITH(J23_LOCATION,c,loc)
 THEN GOES_WITH(J23_PLACEMENT_ROW,c,OBJECT(CONS(MEMBER("cell_id",id),CONS(MEMBER("location",loc),NIL))));
law J23_MOTIF_ROW := IF GOES_WITH(J23_CELL_ID,c,id), GOES_WITH(J23_ENCLOSURE_ID,c,m,enclosure)
 THEN GOES_WITH(J23_MOTIF_ROW,c,OBJECT(CONS(MEMBER("contained_ids",ARRAY(CONS(id,NIL))),CONS(MEMBER("motif_id",m),NIL))));
law J23_CELL_CHECK := IF GOES_WITH(J23_CELL_DEF,c,def), GOES_WITH(J23_LOCATION,c,loc), GOES_WITH(J23_PLACEMENT_ROW,c,place), GOES_WITH(J23_MOTIF_ROW,c,motif), GOES_WITH(J23_ENCLOSURE_ID,c,m,enclosure), THIS(J23_TICK_BLOCK,b), THIS(J23_FABRIC_ROOT,p)
 THEN GOES_WITH(J23_CELL_CHECK,c,STATIC_CELL_CHECK(def,place,motif,CONTAINMENT_PATH(m,b,p),SOURCE_ENCLOSURE(enclosure)));

// Port, type, endpoint and hash checks for each actual selected route.
law J23_ROUTE_ENDPOINTS := IF GOES_WITH(J23_DECLARED_ROUTE,ROUTE(rid,m,RESULT,c,role),mid,cid), GOES_WITH(J23_CELL_CHECK,m,mp), GOES_WITH(J23_CELL_CHECK,c,cp), GOES_WITH(J23_CELL_ID,m,mid), GOES_WITH(J23_CELL_ID,c,cid)
 THEN GOES_WITH(J23_ROUTE_ENDPOINTS,ROUTE(rid,m,RESULT,c,role),mid,cid,ENDPOINTS(mp,cp));
law J23_ROUTE_CHECK := IF GOES_WITH(J23_ROUTE_ENDPOINTS,ROUTE(rid,m,RESULT,c,role),mid,cid,ep), GOES_WITH(J21_PORT,THIS,WHAT,RESULT,OUT,EXACTLY_ONE,t), GOES_WITH(J21_PORT,SAME_NOT_SAME,WHAT,role,IN,EXACTLY_ONE,t), GOES_WITH(J23_ROUTE_HASH,m,RESULT,c,role,rid,mid,cid), GOES_WITH(J22_ROUTE_REGION,m,RESULT,c,role,SAME_REGION(S))
 THEN GOES_WITH(J23_ROUTE_CHECK,ROUTE(rid,m,RESULT,c,role),STATIC_ROUTE_CHECK(ENDPOINTS(m,c),HASH(rid,mid,RESULT,cid,role),PORTS(RESULT,OUT,role,IN),PAYLOAD(t),SAME_REGION(S)));
law J23_ROUTE_JSON := IF GOES_WITH(J23_ROUTE_CHECK,ROUTE(rid,m,RESULT,c,role),proof), GOES_WITH(J23_CELL_ID,m,mid), GOES_WITH(J23_CELL_ID,c,cid), GOES_WITH(J23_ROLE_TEXT,role,text)
 THEN GOES_WITH(J23_ROUTE_JSON,ROUTE(rid,m,RESULT,c,role),OBJECT(CONS(MEMBER("route_id",rid),CONS(MEMBER("source_cell",mid),CONS(MEMBER("source_role","RESULT"),CONS(MEMBER("target_cell",cid),CONS(MEMBER("target_role",text),NIL)))))));
@propose seed J23_ROLE_OBSERVATION := {
 GOES_WITH(J23_ROLE_TEXT,LEFT,"LEFT"),
 GOES_WITH(J23_ROLE_TEXT,RIGHT,"RIGHT")
};
law J23_COMPLETE_JOIN := IF GOES_WITH(J23_DECLARED_COMPARATOR,c,id,f,g), GOES_WITH(J23_SELECTED_MARKER,l,f), GOES_WITH(J23_SELECTED_MARKER,r,g), GOES_WITH(J23_ROUTE_CHECK,ROUTE(lr,l,RESULT,c,LEFT),lp), GOES_WITH(J23_ROUTE_CHECK,ROUTE(rr,r,RESULT,c,RIGHT),rp), GOES_WITH(J22_JOIN_CHECK,c,IF_THEN,JOIN(LEFT(ONE),RIGHT(ONE)))
 THEN GOES_WITH(J23_COMPLETE_JOIN,c,l,lr,r,rr,JOIN(LEFT(ONE),RIGHT(ONE)));

// Forward inventory folds: every supplied row has a source proof; strict keys
// rule out duplicates/collisions. No success seed bypasses a missing member.
law J23_CELL_FOLD_END := IF GOES_WITH(J23_LIST,CELLS,NIL)
 THEN GOES_WITH(J23_CELL_FOLD,NIL,LISTS(NIL,NIL,NIL,NIL),NIL);
law J23_CELL_FOLD_ROW := IF GOES_WITH(J23_LIST,CELLS,CONS(c,t)), THIS(J23_ORDERED,CELLS,CONS(c,t)), GOES_WITH(J23_CELL_DEF,c,def), GOES_WITH(J23_PLACEMENT_ROW,c,place), GOES_WITH(J23_MOTIF_ROW,c,motif), GOES_WITH(J23_ENCLOSURE_ID,c,m,enclosure), GOES_WITH(J23_CELL_CHECK,c,proof), GOES_WITH(J23_CELL_FOLD,t,LISTS(ds,ms,ps,bs),proofs)
 THEN GOES_WITH(J23_CELL_FOLD,CONS(c,t),LISTS(CONS(def,ds),CONS(motif,ms),CONS(place,ps),CONS(m,bs)),CONS(proof,proofs));
law J23_ROUTE_FOLD_END := IF GOES_WITH(J23_LIST,ROUTES,NIL)
 THEN GOES_WITH(J23_ROUTE_FOLD,NIL,NIL,NIL);
law J23_ROUTE_FOLD_ROW := IF GOES_WITH(J23_LIST,ROUTES,CONS(r,t)), THIS(J23_ORDERED,ROUTES,CONS(r,t)), GOES_WITH(J23_ROUTE_JSON,r,json), GOES_WITH(J23_ROUTE_CHECK,r,proof), GOES_WITH(J23_ROUTE_FOLD,t,rs,proofs)
 THEN GOES_WITH(J23_ROUTE_FOLD,CONS(r,t),CONS(json,rs),CONS(proof,proofs));
law J23_COMP_FOLD_END := IF GOES_WITH(J23_LIST,COMPARATORS,NIL)
 THEN GOES_WITH(J23_COMP_FOLD,NIL,NIL);
law J23_COMP_FOLD_ROW := IF GOES_WITH(J23_LIST,COMPARATORS,CONS(c,t)), THIS(J23_ORDERED,COMPARATORS,CONS(c,t)), GOES_WITH(J23_COMPLETE_JOIN,c,l,lr,r,rr,proof), GOES_WITH(J23_COMP_FOLD,t,proofs)
 THEN GOES_WITH(J23_COMP_FOLD,CONS(c,t),CONS(COMPLETE_JOIN(c,l,lr,r,rr,proof),proofs));

// Reverse coverage: the retained committed field/witness lists, not a new
// host-selected coverage list, enumerate the entire candidate source.
law J23_MARKER_COVERED_A := IF GOES_WITH(J22_CLASS,m,A,w,j,d), GOES_WITH(J23_SELECTED_MARKER,m,f), GOES_WITH(J23_CELL_CHECK,m,proof)
 THEN THIS(J23_MARKER_COVERED,m);
law J23_MARKER_COVERED_B := IF GOES_WITH(J22_CLASS,m,B,w,j,d)
 THEN THIS(J23_MARKER_COVERED,m);
law J23_MARKER_COVERED_C := IF GOES_WITH(J22_CLASS,m,C,w,j,d)
 THEN THIS(J23_MARKER_COVERED,m);
law J23_MARKER_COVERED_D := IF GOES_WITH(J22_CLASS,m,D,w,j,d)
 THEN THIS(J23_MARKER_COVERED,m);
law J23_FIELD_COVER_END := IF GOES_WITH(GSC_ROWS,CURRENT_FIELD,NIL)
 THEN THIS(J23_FIELD_COVERED,NIL);
law J23_FIELD_COVER_ROW := IF GOES_WITH(GSC_ROWS,CURRENT_FIELD,CONS(ARRAY(CONS(json,CONS(text,NIL))),tail)), GOES_WITH(FLAG_JSON,f,json), GOES_WITH(J21_MARKER,m,TYPE(THIS,WHAT),f,r), THIS(J23_MARKER_COVERED,m), THIS(J23_FIELD_COVERED,tail)
 THEN THIS(J23_FIELD_COVERED,CONS(ARRAY(CONS(json,CONS(text,NIL))),tail));
law J23_COMP_COVERED_SELECTED := IF GOES_WITH(J23_COMPLETE_JOIN,c,l,lr,r,rr,proof)
 THEN THIS(J23_COMP_COVERED,c);
law J23_COMP_COVERED_WITHHELD := IF GOES_WITH(J23_EXCLUDED_TARGET,c,reason)
 THEN THIS(J23_COMP_COVERED,c);
law J23_PAIR_COVER_END := IF GOES_WITH(GSC_ROWS,CURRENT_WITNESS,NIL)
 THEN THIS(J23_PAIR_COVERED,NIL);
law J23_PAIR_COVER_ROW := IF GOES_WITH(GSC_ROWS,CURRENT_WITNESS,CONS(ARRAY(CONS(a,CONS(b,CONS(text,NIL)))),tail)), GOES_WITH(FLAG_JSON,f,a), GOES_WITH(FLAG_JSON,g,b), GOES_WITH(SF_COMPARATOR,c,f,g), THIS(J23_COMP_COVERED,c), THIS(J23_PAIR_COVERED,tail)
 THEN THIS(J23_PAIR_COVERED,CONS(ARRAY(CONS(a,CONS(b,CONS(text,NIL)))),tail));
law J23_FULL_COVERAGE := IF THIS(GSC_FIELD_INPUT,ARRAY(fs)), GOES_WITH(GSC_COMPLETE,CURRENT_FIELD,ARRAY(fs)), THIS(J23_FIELD_COVERED,fs), THIS(GSC_WITNESS_INPUT,ARRAY(ws)), GOES_WITH(GSC_COMPLETE,CURRENT_WITNESS,ARRAY(ws)), THIS(J23_PAIR_COVERED,ws)
 THEN THIS(J23_FULL_COVERAGE);

// All eight imported conditions are separately exposed on the assembled
// candidate. They depend on checked source rows, strict inventories, complete
// reverse coverage, exact endpoint/hash contacts and complete static joins.
law J23_STATIC_ASSEMBLED := IF THIS(J23_INVENTORY_CELLS,cs), GOES_WITH(J23_CELL_FOLD,cs,LISTS(ds,ms,ps,bs),cp), THIS(J23_INVENTORY_ROUTES,rs), GOES_WITH(J23_ROUTE_FOLD,rs,rjson,rp), THIS(J23_INVENTORY_COMPARATORS,ks), GOES_WITH(J23_COMP_FOLD,ks,kp), THIS(J23_FULL_COVERAGE)
 THEN GOES_WITH(J23_STATIC_ASSEMBLED,cs,rs,ks,LISTS(ds,ms,ps,bs,rjson),CHECKS(cp,rp,kp));
law J23_DRC_I := IF GOES_WITH(J23_STATIC_ASSEMBLED,cs,rs,ks,lists,CHECKS(cp,rp,kp))
 THEN GOES_WITH(J23_DRC_CONDITION,I,IF_THEN,IDENTITY_INTEGRITY(cs,cp));
law J23_DRC_II := IF GOES_WITH(J23_STATIC_ASSEMBLED,cs,rs,ks,lists,CHECKS(cp,rp,kp))
 THEN GOES_WITH(J23_DRC_CONDITION,II,IF_THEN,CONTAINMENT(cp));
law J23_DRC_III := IF GOES_WITH(J23_STATIC_ASSEMBLED,cs,rs,ks,lists,CHECKS(cp,rp,kp))
 THEN GOES_WITH(J23_DRC_CONDITION,III,IF_THEN,PLACEMENT_CAPABILITY(cp));
law J23_DRC_IV := IF GOES_WITH(J23_STATIC_ASSEMBLED,cs,rs,ks,lists,CHECKS(cp,rp,kp))
 THEN GOES_WITH(J23_DRC_CONDITION,IV,IF_THEN,ENDPOINTS(rp));
law J23_DRC_V := IF GOES_WITH(J23_STATIC_ASSEMBLED,cs,rs,ks,lists,CHECKS(cp,rp,kp))
 THEN GOES_WITH(J23_DRC_CONDITION,V,IF_THEN,ROUTE_IDENTITIES(rp));
law J23_DRC_VI := IF GOES_WITH(J23_STATIC_ASSEMBLED,cs,rs,ks,lists,CHECKS(cp,rp,kp))
 THEN GOES_WITH(J23_DRC_CONDITION,VI,IF_THEN,PORT_DIRECTION(rp));
law J23_DRC_VII := IF GOES_WITH(J23_STATIC_ASSEMBLED,cs,rs,ks,lists,CHECKS(cp,rp,kp))
 THEN GOES_WITH(J23_DRC_CONDITION,VII,IF_THEN,PAYLOAD_TYPE(rp));
law J23_DRC_VIII := IF GOES_WITH(J23_STATIC_ASSEMBLED,cs,rs,ks,lists,CHECKS(cp,rp,kp))
 THEN GOES_WITH(J23_DRC_CONDITION,VIII,IF_THEN,JOIN_ROLES_MULTIPLICITY(kp));

law J23_CANONICAL_PROGRAM := IF GOES_WITH(J23_STATIC_ASSEMBLED,cs,rs,ks,LISTS(ds,ms,ps,bs,rjson),proof), THIS(J23_FABRIC_ROOT,root), THIS(J23_TICK_BLOCK,block)
 THEN GOES_WITH(J23_CANONICAL_PROGRAM,cs,rs,ks,proof,OBJECT(CONS(MEMBER("cells",ARRAY(ds)),CONS(MEMBER("fabric_id",root),CONS(MEMBER("motifs",ARRAY(ms)),CONS(MEMBER("placements",ARRAY(ps)),CONS(MEMBER("routes",ARRAY(rjson)),CONS(MEMBER("triad_blocks",ARRAY(CONS(OBJECT(CONS(MEMBER("block_id",block),CONS(MEMBER("contained_ids",ARRAY(bs)),NIL))),NIL))),NIL))))))));
law J23_PROGRAM_HASH_REQUEST := IF GOES_WITH(J23_CANONICAL_PROGRAM,cs,rs,ks,proof,object)
 THEN GOES_WITH(GPU_HASH_REQUEST,PROGRAM,PROGRAM_023,object);
law J23_PROGRAM_BOUND := IF GOES_WITH(J23_CANONICAL_PROGRAM,cs,rs,ks,proof,object), GOES_WITH(GPU_HASH_RESPONSE,object,p)
 THEN GOES_WITH(J23_PROGRAM_BOUND,p,cs,rs,ks,proof,object);
law J23_PROGRAM_EXPORT := IF GOES_WITH(J23_PROGRAM_BOUND,p,cs,rs,ks,proof,object)
 THEN GOES_WITH(J23_PROGRAM,p,cs,rs);
law J23_PROGRAM_OBJECT_EXPORT := IF GOES_WITH(J23_PROGRAM_BOUND,p,cs,rs,ks,proof,object)
 THEN GOES_WITH(J23_PROGRAM_OBJECT,p,object);
law J23_PROGRAM_DRC_EXPORT := IF GOES_WITH(J23_PROGRAM_BOUND,p,cs,rs,ks,proof,object)
 THEN GOES_WITH(J23_PROGRAM_DRC,p,IF_THEN,proof);
law J23_COMPARATOR_LIST_EXPORT := IF GOES_WITH(J23_PROGRAM_BOUND,p,cs,rs,ks,proof,object)
 THEN GOES_WITH(J23_COMPARATOR_LIST,p,ks);
law J23_MARKER_MEMBER_EXPORT := IF GOES_WITH(J23_PROGRAM_BOUND,p,cs,rs,ks,proof,object), GOES_WITH(J23_SELECTED_MARKER,m,f), GOES_WITH(J23_CELL_CHECK,m,check)
 THEN GOES_WITH(J23_MARKER_MEMBER,p,m,f);
law J23_COMPARATOR_MEMBER_EXPORT := IF GOES_WITH(J23_PROGRAM_BOUND,p,cs,rs,ks,proof,object), GOES_WITH(J23_SELECTED_COMPARATOR,c,f,g), GOES_WITH(J23_COMPLETE_JOIN,c,l,lr,r,rr,check)
 THEN GOES_WITH(J23_COMPARATOR_MEMBER,p,c,f,g);
law J23_ROUTE_EXPORT := IF GOES_WITH(J23_PROGRAM_BOUND,p,cs,rs,ks,proof,object), GOES_WITH(J23_ROUTE_CHECK,ROUTE(rid,m,RESULT,c,role),check)
 THEN GOES_WITH(J23_ROUTE,p,rid,m,RESULT,c,role);
law J23_JOIN_EXPORT := IF GOES_WITH(J23_PROGRAM_BOUND,p,cs,rs,ks,proof,object), GOES_WITH(J23_COMPLETE_JOIN,c,l,lr,r,rr,check)
 THEN GOES_WITH(J23_JOIN,p,c,l,lr,r,rr);
// Report condition (iii) on every touched witness face, and condition (iv)
// for every route of this program rather than the larger retained candidate.
law J23_MARKER_FACE_CHECK := IF GOES_WITH(J23_MARKER_MEMBER,p,m,f), GOES_WITH(J21_CCC_MARKER,m,w,j), GOES_WITH(J22_DRC_III_CELL,m,w,IF_THEN,location)
 THEN GOES_WITH(J23_DRC_III_OCCURRENCE_FACE,p,m,w,IF_THEN,location);
law J23_COMPARATOR_FACE_CHECK := IF GOES_WITH(J23_COMPARATOR_MEMBER,p,c,f,g), GOES_WITH(J22_DRC_III_CELL,c,w,IF_THEN,location)
 THEN GOES_WITH(J23_DRC_III_OCCURRENCE_FACE,p,c,w,IF_THEN,location);
law J23_TOUCHED_FACE_CHECK := IF GOES_WITH(J23_DRC_III_OCCURRENCE_FACE,p,c,w,IF_THEN,location)
 THEN GOES_WITH(J23_DRC_III_FACE,p,w,IF_THEN);
law J23_ROUTE_ENDPOINT_CHECK := IF GOES_WITH(J23_ROUTE,p,rid,m,RESULT,c,role), GOES_WITH(J23_ROUTE_CHECK,ROUTE(rid,m,RESULT,c,role),check)
 THEN GOES_WITH(J23_DRC_IV_ROUTE,p,rid,IF_THEN,ENDPOINTS(m,c));

