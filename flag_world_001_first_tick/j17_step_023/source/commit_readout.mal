// EXECUTE TASK_CODEX_J17_SECOND_STEP_023, steps 3--4.
// Reuse GPU-self-witness / C20 link observation schema, not frozen V1/V2 bytes.
// Every world effect is source-owned. Host JSON/SHA is generic observation only.
// The selected program contains THIS markers and SAME comparators only. Neither
// operator writes a flag reading. Full program and result folds below certify
// that restricted effect set before the unchanged world projection is made.
// Runtime payload state DOES change and is bound separately by its whole hash.
// An unchanged world field still appends a predecessor-bound link as instructed.

@readonly input C23_HASH_INPUT := "hash_batch:";
law C23_HASH_BEGIN := IF THIS(C23_HASH_INPUT,ARRAY(rows)) THEN THIS(C23_HASH_ROWS,rows);
law C23_HASH_TAIL := IF THIS(C23_HASH_ROWS,CONS(row,tail)) THEN THIS(C23_HASH_ROWS,tail);
law C23_HASH_RESPONSE := IF THIS(C23_HASH_ROWS,CONS(ARRAY(CONS(subject,CONS(digest,NIL))),tail))
 THEN GOES_WITH(GPU_HASH_RESPONSE,subject,digest);

// Exact archived g1 custody: the original chain entry and its source-bound hash.
law C23_GENESIS := IF THIS(COMMITTED_GENESIS,OBJECT(CONS(MEMBER("chain",ARRAY(CONS(entry,NIL))),CONS(MEMBER("field",field),CONS(MEMBER("receipt",receipt),CONS(MEMBER("witness",witness),NIL)))))), GOES_WITH(GSC_CHAIN_ENTRY,record,entry), GOES_WITH(GSC_LINK_HASH,record,h)
 THEN GOES_WITH(C23_GENESIS,h,entry,field,witness);
law C23_RETURN := IF GOES_WITH(STEP_FABRIC_RETURN,p,GENESIS,next), GOES_WITH(S23_SUCCESSOR_JSON,p,GENESIS,next,json), GOES_WITH(C23_GENESIS,h,entry,field,witness)
 THEN GOES_WITH(C23_RETURN,p,h,next,json);

// The task's exact 18-cell program, not an assumption about absent effects.
law C23_EFFECT_TAIL_START := IF GOES_WITH(J23_PROGRAM,p,cells,routes)
 THEN GOES_WITH(C23_EFFECT_TAIL,p,cells);
law C23_EFFECT_TAIL := IF GOES_WITH(C23_EFFECT_TAIL,p,CONS(c,tail))
 THEN GOES_WITH(C23_EFFECT_TAIL,p,tail);
law C23_MARKER_EFFECT := IF GOES_WITH(J23_MARKER_MEMBER,p,m,f)
 THEN GOES_WITH(C23_CELL_EFFECT,p,m,NO_FLAG_WRITE);
law C23_COMPARATOR_EFFECT := IF GOES_WITH(J23_COMPARATOR_MEMBER,p,c,f,g)
 THEN GOES_WITH(C23_CELL_EFFECT,p,c,NO_FLAG_WRITE);
law C23_EFFECT_END := IF GOES_WITH(C23_EFFECT_TAIL,p,NIL)
 THEN GOES_WITH(C23_EFFECT_SUFFIX,p,NIL,NO_FLAG_WRITE);
law C23_EFFECT_ROW := IF GOES_WITH(C23_EFFECT_TAIL,p,CONS(c,tail)), GOES_WITH(C23_CELL_EFFECT,p,c,NO_FLAG_WRITE), GOES_WITH(C23_EFFECT_SUFFIX,p,tail,NO_FLAG_WRITE)
 THEN GOES_WITH(C23_EFFECT_SUFFIX,p,CONS(c,tail),NO_FLAG_WRITE);
law C23_EFFECT_COMPLETE := IF GOES_WITH(J23_PROGRAM,p,cells,routes), GOES_WITH(C23_EFFECT_SUFFIX,p,cells,NO_FLAG_WRITE)
 THEN GOES_WITH(C23_PROGRAM_EFFECT,p,NO_FLAG_WRITE);

// Every admitted comparator must actually evaluate the same snapshot gluing.
// This certifies only the six program results; it does not pretend the other
// 714 comparators ran. The unchanged field carries their unchanged witnesses.
law C23_RESULT_TAIL_START := IF GOES_WITH(J23_COMPARATOR_LIST,p,cs)
 THEN GOES_WITH(C23_RESULT_TAIL,p,cs);
law C23_RESULT_TAIL := IF GOES_WITH(C23_RESULT_TAIL,p,CONS(c,tail))
 THEN GOES_WITH(C23_RESULT_TAIL,p,tail);
law C23_RESULT_SAME := IF GOES_WITH(J23_COMPARATOR_MEMBER,p,c,f,g), GOES_WITH(S23_COMPARATOR_READING,p,c,f,g,r), GOES_WITH(CURRENT_GLUING,f,g,r)
 THEN GOES_WITH(C23_RESULT_SAME,p,c,f,g,r);
law C23_RESULT_DIFFER_SAME := IF GOES_WITH(S23_COMPARATOR_READING,p,c,f,g,SAME), GOES_WITH(CURRENT_GLUING,f,g,NOT_SAME)
 THEN GOES_WITH(C23_RESULT_DIFFER,p,c,f,g,NOT_SAME);
law C23_RESULT_DIFFER_WALL := IF GOES_WITH(S23_COMPARATOR_READING,p,c,f,g,NOT_SAME), GOES_WITH(CURRENT_GLUING,f,g,SAME)
 THEN GOES_WITH(C23_RESULT_DIFFER,p,c,f,g,NOT_SAME);
law C23_RESULT_END := IF GOES_WITH(C23_RESULT_TAIL,p,NIL)
 THEN GOES_WITH(C23_RESULT_SUFFIX,p,NIL);
law C23_RESULT_ROW := IF GOES_WITH(C23_RESULT_TAIL,p,CONS(c,tail)), GOES_WITH(C23_RESULT_SAME,p,c,f,g,r), GOES_WITH(C23_RESULT_SUFFIX,p,tail)
 THEN GOES_WITH(C23_RESULT_SUFFIX,p,CONS(c,tail));
law C23_RESULTS_COMPLETE := IF GOES_WITH(J23_COMPARATOR_LIST,p,cs), GOES_WITH(C23_RESULT_SUFFIX,p,cs)
 THEN THIS(C23_RESULTS_COMPLETE,p);
law C23_PROJECTION := IF GOES_WITH(C23_RETURN,p,h,next,json), GOES_WITH(C23_GENESIS,h,entry,field,witness), GOES_WITH(C23_PROGRAM_EFFECT,p,NO_FLAG_WRITE), THIS(C23_RESULTS_COMPLETE,p), GOES_WITH(GSC_COMPLETE,CURRENT_FIELD,field), GOES_WITH(GSC_COMPLETE,CURRENT_WITNESS,witness)
 THEN GOES_WITH(C23_PROJECTION,p,next,PAIR(field,witness));
law C23_NEXT_FIELD := IF GOES_WITH(C23_PROJECTION,p,next,PAIR(field,witness)), GOES_WITH(CURRENT_FIELD,f,r)
 THEN GOES_WITH(C23_NEXT_FIELD,p,next,f,r);
law C23_NEXT_GLUING := IF GOES_WITH(C23_PROJECTION,p,next,PAIR(field,witness)), GOES_WITH(CURRENT_GLUING,f,g,r)
 THEN GOES_WITH(C23_NEXT_GLUING,p,next,f,g,r);

// Receipts describe the complete unchanged field, not just admitted routes.
// Retained walls are witnessed, never silently erased by a six-cell subprogram.
law C23_UNCHANGED := IF GOES_WITH(C23_RETURN,p,h,next,json), GOES_WITH(C23_NEXT_GLUING,p,next,f,g,SAME), GOES_WITH(CURRENT_GLUING,f,g,SAME)
 THEN GOES_WITH(C23_RECEIPT_PAIR,p,h,f,g,"UNCHANGED");
law C23_RETAINED := IF GOES_WITH(C23_RETURN,p,h,next,json), GOES_WITH(C23_NEXT_GLUING,p,next,f,g,NOT_SAME), GOES_WITH(CURRENT_GLUING,f,g,NOT_SAME)
 THEN GOES_WITH(C23_RECEIPT_PAIR,p,h,f,g,"RETAINED");
law C23_RECEIPT_ROW := IF GOES_WITH(C23_RECEIPT_PAIR,p,h,f,g,status), GOES_WITH(FLAG_JSON,f,a), GOES_WITH(FLAG_JSON,g,b)
 THEN THIS(OBSERVATION_ROW,STEP_023_RECEIPT,ARRAY(CONS(a,CONS(b,CONS(status,NIL)))));
law C23_RETAINED_ROW := IF GOES_WITH(C23_RECEIPT_PAIR,p,h,f,g,"RETAINED"), GOES_WITH(FLAG_JSON,f,a), GOES_WITH(FLAG_JSON,g,b)
 THEN THIS(OBSERVATION_ROW,STEP_023_RETAINED_WALLS,ARRAY(CONS(a,CONS(b,NIL))));

law C23_PAIR_OBJECT := IF GOES_WITH(C23_RETURN,p,h,next,json), GOES_WITH(C23_PROJECTION,p,next,PAIR(field,witness))
 THEN GOES_WITH(C23_PAIR_OBJECT,p,h,OBJECT(CONS(MEMBER("field",field),CONS(MEMBER("witness",witness),NIL))));
law C23_RECEIPT_OBJECT := IF GOES_WITH(C23_RETURN,p,h,next,json), GOES_WITH(C23_PROJECTION,p,next,PAIR(field,witness))
 THEN GOES_WITH(C23_RECEIPT_OBJECT,p,h,OBJECT(CONS(MEMBER("discharged",ARRAY(NIL)),CONS(MEMBER("opened",ARRAY(NIL)),NIL))));
law C23_RECEIPT_READING := IF GOES_WITH(C23_RECEIPT_OBJECT,p,h,OBJECT(CONS(MEMBER("discharged",ARRAY(NIL)),CONS(MEMBER("opened",ARRAY(NIL)),NIL))))
 THEN GOES_WITH(C23_RECEIPT_READING,p,h,"NO");
law C23_PAIR_HASH_REQUEST := IF GOES_WITH(C23_PAIR_OBJECT,p,h,subject)
 THEN GOES_WITH(GPU_HASH_REQUEST,WORLD_PAIR,CONTEXT(p,h),subject);
law C23_RECEIPT_HASH_REQUEST := IF GOES_WITH(C23_RECEIPT_OBJECT,p,h,subject)
 THEN GOES_WITH(GPU_HASH_REQUEST,WORLD_RECEIPT,CONTEXT(p,h),subject);
law C23_FABRIC_HASH_REQUEST := IF GOES_WITH(C23_RETURN,p,h,next,json)
 THEN GOES_WITH(GPU_HASH_REQUEST,FABRIC_SUCCESSOR,CONTEXT(p,h),json);
law C23_FABRIC_HASH := IF GOES_WITH(C23_RETURN,p,h,next,json), GOES_WITH(GPU_HASH_RESPONSE,json,digest)
 THEN GOES_WITH(C23_FABRIC_STATE_HASH,p,h,next,digest);
law C23_PAIR_HASH := IF GOES_WITH(C23_PAIR_OBJECT,p,h,subject), GOES_WITH(GPU_HASH_RESPONSE,subject,digest)
 THEN GOES_WITH(C23_PAIR_HASH,p,h,subject,digest);
law C23_RECEIPT_HASH := IF GOES_WITH(C23_RECEIPT_OBJECT,p,h,subject), GOES_WITH(GPU_HASH_RESPONSE,subject,digest)
 THEN GOES_WITH(C23_RECEIPT_HASH,p,h,subject,digest);
law C23_RECORD_PARTS := IF GOES_WITH(C23_PAIR_HASH,p,h,OBJECT(CONS(MEMBER("field",field),CONS(MEMBER("witness",witness),NIL))),pairhash), GOES_WITH(C23_RECEIPT_HASH,p,h,receipt,receipthash), GOES_WITH(C23_RECEIPT_READING,p,h,reading)
 THEN GOES_WITH(C23_RECORD_PARTS,p,h,PARTS(field,witness,receipt,pairhash,receipthash,reading));
law C23_TICK_RECORD := IF GOES_WITH(C23_RECORD_PARTS,p,h,PARTS(field,witness,receipt,pairhash,receipthash,reading))
 THEN GOES_WITH(C23_TICK_RECORD,p,h,OBJECT(CONS(MEMBER("fabric_program",p),CONS(MEMBER("field",field),CONS(MEMBER("kind","TICK"),CONS(MEMBER("pair_hash",pairhash),CONS(MEMBER("prev",h),CONS(MEMBER("receipt",receipt),CONS(MEMBER("receipt_hash",receipthash),CONS(MEMBER("receipt_reading",reading),CONS(MEMBER("witness",witness),NIL)))))))))));
law C23_TICK_HASH_REQUEST := IF GOES_WITH(C23_TICK_RECORD,p,h,subject)
 THEN GOES_WITH(GPU_HASH_REQUEST,WORLD_TICK,CONTEXT(p,h),subject);
law C23_TICK_HASH := IF GOES_WITH(C23_TICK_RECORD,p,h,subject), GOES_WITH(GPU_HASH_RESPONSE,subject,digest)
 THEN GOES_WITH(C23_TICK_HASH,p,h,subject,digest);
law C23_TICK_ENTRY := IF GOES_WITH(C23_TICK_HASH,p,h,record,digest)
 THEN GOES_WITH(C23_TICK_ENTRY,p,h,OBJECT(CONS(MEMBER("link",digest),CONS(MEMBER("record",record),NIL))));
// Publish one successor over g1 even when field and witness are unchanged.
// Its changed runtime state is witnessed separately by C23_FABRIC_STATE_HASH.
law C23_COMMIT_OBJECT := IF GOES_WITH(C23_RETURN,p,h,next,json), GOES_WITH(C23_PROJECTION,p,next,PAIR(field,witness)), GOES_WITH(C23_GENESIS,h,genesis,field,priorwitness), GOES_WITH(C23_RECORD_PARTS,p,h,PARTS(field,witness,receipt,pairhash,receipthash,reading)), GOES_WITH(C23_TICK_ENTRY,p,h,tick), GOES_WITH(C23_FABRIC_STATE_HASH,p,h,next,statehash)
 THEN GOES_WITH(C23_COMMITTED_OBJECT,p,h,next,OBJECT(CONS(MEMBER("chain",ARRAY(CONS(genesis,CONS(tick,NIL)))),CONS(MEMBER("field",field),CONS(MEMBER("receipt",receipt),CONS(MEMBER("witness",witness),NIL))))));
law C23_COMMIT := IF GOES_WITH(C23_COMMITTED_OBJECT,p,h,next,world)
 THEN THIS(COMMITTED_WORLD,world);
law C23_COMMITTED_RETURN := IF THIS(COMMITTED_WORLD,world), GOES_WITH(C23_COMMITTED_OBJECT,p,h,next,world)
 THEN GOES_WITH(C23_COMMITTED_RETURN,p,h,next,world);

// Informational next-tick readout. The predecessor is g1, not Ground_0_012.
// All predicates have their own namespace; run018 DG values remain untouched.
// Metric 3419D528: count EDIT once for flag incidence's union, equivalently
// triad-contains-junction, not additive site/edge/triad multiplicities.
law D23_ROWS_START := IF GOES_WITH(C23_COMMITTED_RETURN,p,h,next,world), GOES_WITH(C23_GENESIS,h,e,ARRAY(rows),w)
 THEN THIS(D23_ROWS,rows);
law D23_ROWS_TAIL := IF THIS(D23_ROWS,CONS(row,tail)) THEN THIS(D23_ROWS,tail);
law D23_FIELD_PAIR := IF GOES_WITH(C23_COMMITTED_RETURN,p,h,next,world), THIS(D23_ROWS,CONS(ARRAY(CONS(json,CONS(text,NIL))),tail)), GOES_WITH(FLAG_JSON,f,json), GOES_WITH(C23_NEXT_FIELD,p,next,f,current), GOES_WITH(CURRENT_FIELD,f,prior)
 THEN GOES_WITH(D23_PAIR,f,current,prior);
law D23_READING_SAME := IF GOES_WITH(D23_PAIR,f,r,r) THEN GOES_WITH(D23_EDIT,f,NO_EDIT);
law D23_READING_THIS_NO := IF GOES_WITH(D23_PAIR,f,THIS,NO) THEN GOES_WITH(D23_EDIT,f,EDIT);
law D23_READING_NO_THIS := IF GOES_WITH(D23_PAIR,f,NO,THIS) THEN GOES_WITH(D23_EDIT,f,EDIT);
law D23_CONTRIBUTION_EDIT := IF GOES_WITH(DG_SUPPORT_TRIAD,s,t), GOES_WITH(D23_EDIT,TOGETHER_ALONE(v,e,t),EDIT)
 THEN GOES_WITH(D23_CONTRIBUTION,s,TOGETHER_ALONE(v,e,t),NEXT_COUNT(EMPTY_COUNT));
law D23_CONTRIBUTION_SAME := IF GOES_WITH(DG_SUPPORT_TRIAD,s,t), GOES_WITH(D23_EDIT,TOGETHER_ALONE(v,e,t),NO_EDIT)
 THEN GOES_WITH(D23_CONTRIBUTION,s,TOGETHER_ALONE(v,e,t),EMPTY_COUNT);
law D23_CONTRIBUTION_OUTSIDE := IF GOES_WITH(DG_MISS_TRIAD,s,t), GOES_WITH(D23_PAIR,TOGETHER_ALONE(v,e,t),current,prior)
 THEN GOES_WITH(D23_CONTRIBUTION,s,TOGETHER_ALONE(v,e,t),EMPTY_COUNT);
law D23_ACC_START := IF GOES_WITH(C23_COMMITTED_RETURN,p,h,next,world), GOES_WITH(C23_GENESIS,h,e,ARRAY(rows),w), GOES_WITH(WORLD_JUNCTION_SITE,s,j)
 THEN GOES_WITH(D23_ACC,s,rows,EMPTY_COUNT);
law D23_ACC_UNCHANGED := IF GOES_WITH(D23_ACC,s,CONS(ARRAY(CONS(json,CONS(text,NIL))),tail),n), GOES_WITH(FLAG_JSON,f,json), GOES_WITH(D23_CONTRIBUTION,s,f,EMPTY_COUNT)
 THEN GOES_WITH(D23_ACC,s,tail,n);
law D23_ACC_EDIT := IF GOES_WITH(D23_ACC,s,CONS(ARRAY(CONS(json,CONS(text,NIL))),tail),n), GOES_WITH(FLAG_JSON,f,json), GOES_WITH(D23_CONTRIBUTION,s,f,NEXT_COUNT(EMPTY_COUNT))
 THEN GOES_WITH(D23_ACC,s,tail,NEXT_COUNT(n));
law D23_ACC_DONE := IF GOES_WITH(D23_ACC,s,NIL,n) THEN GOES_WITH(D23_VALUE,s,n);
law D23_COUNT_REQUEST := IF GOES_WITH(D23_VALUE,s,n) THEN THIS(D23_COUNT_BYTES_REQUEST,n);
law D23_COUNT_DESCEND := IF THIS(D23_COUNT_BYTES_REQUEST,NEXT_COUNT(n)) THEN THIS(D23_COUNT_BYTES_REQUEST,n);
law D23_COUNT_EMPTY := IF THIS(D23_COUNT_BYTES_REQUEST,EMPTY_COUNT) THEN GOES_WITH(D23_COUNT_LIST,EMPTY_COUNT,NIL);
law D23_COUNT_ASCEND := IF THIS(D23_COUNT_BYTES_REQUEST,NEXT_COUNT(n)), GOES_WITH(D23_COUNT_LIST,n,items)
 THEN GOES_WITH(D23_COUNT_LIST,NEXT_COUNT(n),CONS("THIS",items));
law D23_VALUE_ROW := IF GOES_WITH(D23_VALUE,s,n), GOES_WITH(SITE_TEXT,s,text), GOES_WITH(D23_COUNT_LIST,n,items)
 THEN THIS(OBSERVATION_ROW,STEP_023_DG_VALUES,ARRAY(CONS(text,CONS(ARRAY(items),NIL))));
law D23_FACE_DISTANCES := IF GOES_WITH(DG_FACE,w,a,b,c), GOES_WITH(D23_VALUE,a,x), GOES_WITH(D23_VALUE,b,y), GOES_WITH(D23_VALUE,c,z)
 THEN GOES_WITH(D23_FACE_DISTANCE,w,a,b,c,x,y,z);
law D23_MEMBER_A := IF GOES_WITH(D23_FACE_DISTANCE,w,a,b,c,x,y,z) THEN GOES_WITH(D23_FACE_MEMBER,w,a,x);
law D23_MEMBER_B := IF GOES_WITH(D23_FACE_DISTANCE,w,a,b,c,x,y,z) THEN GOES_WITH(D23_FACE_MEMBER,w,b,y);
law D23_MEMBER_C := IF GOES_WITH(D23_FACE_DISTANCE,w,a,b,c,x,y,z) THEN GOES_WITH(D23_FACE_MEMBER,w,c,z);
law D23_COMPARE_REQUEST := IF GOES_WITH(D23_FACE_MEMBER,w,a,x), GOES_WITH(D23_FACE_MEMBER,w,b,y)
 THEN THIS(D23_COMPARE_REQUEST,x,y);
law D23_COMPARE_DESCEND := IF THIS(D23_COMPARE_REQUEST,NEXT_COUNT(x),NEXT_COUNT(y)) THEN THIS(D23_COMPARE_REQUEST,x,y);
law D23_COMPARE_EMPTY := IF THIS(D23_COMPARE_REQUEST,EMPTY_COUNT,EMPTY_COUNT) THEN GOES_WITH(D23_ORDER,EMPTY_COUNT,EMPTY_COUNT,SAME);
law D23_COMPARE_LESS := IF THIS(D23_COMPARE_REQUEST,EMPTY_COUNT,NEXT_COUNT(y)) THEN GOES_WITH(D23_ORDER,EMPTY_COUNT,NEXT_COUNT(y),LESS);
law D23_COMPARE_MORE := IF THIS(D23_COMPARE_REQUEST,NEXT_COUNT(x),EMPTY_COUNT) THEN GOES_WITH(D23_ORDER,NEXT_COUNT(x),EMPTY_COUNT,MORE);
law D23_COMPARE_ASCEND := IF THIS(D23_COMPARE_REQUEST,NEXT_COUNT(x),NEXT_COUNT(y)), GOES_WITH(D23_ORDER,x,y,r)
 THEN GOES_WITH(D23_ORDER,NEXT_COUNT(x),NEXT_COUNT(y),r);
law D23_G_A := IF GOES_WITH(D23_FACE_DISTANCE,w,a,b,c,x,y,z), GOES_WITH(D23_ORDER,x,y,LESS), GOES_WITH(D23_ORDER,x,z,LESS) THEN GOES_WITH(D23_G,w,a);
law D23_G_B := IF GOES_WITH(D23_FACE_DISTANCE,w,a,b,c,x,y,z), GOES_WITH(D23_ORDER,y,x,LESS), GOES_WITH(D23_ORDER,y,z,LESS) THEN GOES_WITH(D23_G,w,b);
law D23_G_C := IF GOES_WITH(D23_FACE_DISTANCE,w,a,b,c,x,y,z), GOES_WITH(D23_ORDER,z,x,LESS), GOES_WITH(D23_ORDER,z,y,LESS) THEN GOES_WITH(D23_G,w,c);
law D23_MIN_TIE_AB := IF GOES_WITH(D23_FACE_DISTANCE,w,a,b,c,x,x,z), GOES_WITH(D23_ORDER,x,z,LESS) THEN THIS(D23_G_MAYBE,w);
law D23_MIN_TIE_AC := IF GOES_WITH(D23_FACE_DISTANCE,w,a,b,c,x,y,x), GOES_WITH(D23_ORDER,x,y,LESS) THEN THIS(D23_G_MAYBE,w);
law D23_MIN_TIE_BC := IF GOES_WITH(D23_FACE_DISTANCE,w,a,b,c,x,y,y), GOES_WITH(D23_ORDER,y,x,LESS) THEN THIS(D23_G_MAYBE,w);
law D23_MIN_TIE_ALL := IF GOES_WITH(D23_FACE_DISTANCE,w,a,b,c,x,x,x) THEN THIS(D23_G_MAYBE,w);
law D23_UPPER_TIE_A := IF GOES_WITH(D23_FACE_DISTANCE,w,a,b,c,x,y,y), GOES_WITH(D23_ORDER,x,y,LESS) THEN THIS(D23_UPPER_TIE,w);
law D23_UPPER_TIE_B := IF GOES_WITH(D23_FACE_DISTANCE,w,a,b,c,x,y,x), GOES_WITH(D23_ORDER,y,x,LESS) THEN THIS(D23_UPPER_TIE,w);
law D23_UPPER_TIE_C := IF GOES_WITH(D23_FACE_DISTANCE,w,a,b,c,x,x,z), GOES_WITH(D23_ORDER,z,x,LESS) THEN THIS(D23_UPPER_TIE,w);
law D23_RANKS_DISTINCT := IF GOES_WITH(D23_FACE_MEMBER,w,a,x), GOES_WITH(D23_FACE_MEMBER,w,b,y), GOES_WITH(D23_FACE_MEMBER,w,c,z), GOES_WITH(D23_ORDER,x,y,LESS), GOES_WITH(D23_ORDER,y,z,LESS)
 THEN GOES_WITH(D23_RANKING,w,a,b,c);
law D23_MIN_RANK := IF GOES_WITH(D23_G,w,a) THEN GOES_WITH(D23_RANK,w,a,RANK_ONE);
law D23_MIDDLE_RANK := IF GOES_WITH(D23_RANKING,w,a,b,c) THEN GOES_WITH(D23_RANK,w,b,RANK_TWO);
law D23_MAX_A := IF GOES_WITH(D23_FACE_DISTANCE,w,a,b,c,x,y,z), GOES_WITH(D23_ORDER,x,y,MORE), GOES_WITH(D23_ORDER,x,z,MORE) THEN GOES_WITH(D23_RANK,w,a,RANK_THREE);
law D23_MAX_B := IF GOES_WITH(D23_FACE_DISTANCE,w,a,b,c,x,y,z), GOES_WITH(D23_ORDER,y,x,MORE), GOES_WITH(D23_ORDER,y,z,MORE) THEN GOES_WITH(D23_RANK,w,b,RANK_THREE);
law D23_MAX_C := IF GOES_WITH(D23_FACE_DISTANCE,w,a,b,c,x,y,z), GOES_WITH(D23_ORDER,z,x,MORE), GOES_WITH(D23_ORDER,z,y,MORE) THEN GOES_WITH(D23_RANK,w,c,RANK_THREE);
law D23_ROLE := IF GOES_WITH(D23_RANK,w,s,r), GOES_WITH(SF_RANK_ROLE,r,d), GOES_WITH(WORLD_JUNCTION_SITE,s,j)
 THEN GOES_WITH(D23_ROLE,w,j,d);
law D23_OWN_TIE := IF GOES_WITH(D23_FACE_MEMBER,w,a,n), GOES_WITH(D23_FACE_MEMBER,w,b,n), GOES_WITH(DISTINCT_SITE,a,b), GOES_WITH(WORLD_JUNCTION_SITE,a,j)
 THEN GOES_WITH(D23_OWN_TIE,w,j,MAYBE);
law D23_RESULT_DISTINCT := IF GOES_WITH(D23_RANKING,w,a,b,c), GOES_WITH(D23_G,w,a), GOES_WITH(SITE_TEXT,a,ta), GOES_WITH(SITE_TEXT,b,tb), GOES_WITH(SITE_TEXT,c,tc)
 THEN GOES_WITH(D23_RESULT,w,ta,ARRAY(CONS(ta,CONS(tb,CONS(tc,NIL)))),"IF_THEN","IF_THEN");
law D23_RESULT_UPPER_TIE := IF THIS(D23_UPPER_TIE,w), GOES_WITH(D23_G,w,a), GOES_WITH(SITE_TEXT,a,ta)
 THEN GOES_WITH(D23_RESULT,w,ta,JSON_NULL,"IF_THEN","MAYBE");
law D23_RESULT_MIN_TIE := IF THIS(D23_G_MAYBE,w)
 THEN GOES_WITH(D23_RESULT,w,JSON_NULL,JSON_NULL,"MAYBE","MAYBE");
law D23_FACE_OBSERVATION := IF GOES_WITH(D23_FACE_DISTANCE,w,a,b,c,x,y,z), GOES_WITH(TRIAD_JSON,TOGETHER_ALONE(a,b,c),face), GOES_WITH(D23_COUNT_LIST,x,lx), GOES_WITH(D23_COUNT_LIST,y,ly), GOES_WITH(D23_COUNT_LIST,z,lz)
 THEN GOES_WITH(D23_FACE_OBSERVATION,w,face,ARRAY(CONS(ARRAY(lx),CONS(ARRAY(ly),CONS(ARRAY(lz),NIL)))));
law D23_FACE_ROW := IF GOES_WITH(D23_FACE_OBSERVATION,w,face,distances), GOES_WITH(D23_RESULT,w,g,ranks,gv,sv)
 THEN THIS(OBSERVATION_ROW,STEP_023_FACE_READOUT,OBJECT(CONS(MEMBER("face",face),CONS(MEMBER("distances",distances),CONS(MEMBER("G",g),CONS(MEMBER("G_verdict",gv),CONS(MEMBER("ranks",ranks),CONS(MEMBER("S_F_verdict",sv),NIL))))))));
