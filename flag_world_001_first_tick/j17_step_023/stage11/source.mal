// EXECUTE TASK_CODEX_J17_SECOND_STEP_023, exact source-selected subprogram.
// No admission verdict, membership, placement or route selection enters from host.
// Generic custody contacts: J23_ID_RESPONSE(source_term, TEXT(exact_term_bytes));
// J23_ROUTE_HASH(m,RESULT,c,role,rid,mid,cid) is the pinned u64be-length
// prefixed SHA256 over (mid,"RESULT",cid,role). Program hash is generic sorted
// compact JSON SHA256. The three inventories order observed source facts only.
// Reverse coverage walks the already source-checked committed 480 field rows
// and 720 overlap rows. No count substitutes for a missing selected occurrence.
// Static definition E328B574 sections3--8,13; imported kernel8B983301 lines
// 386--433,501--630. Existing normalized per-occurrence enclosure pattern:
// frozen020/source/program.mal 08651A36, lines67--86.
// Source uses G/S/F; boxed JSON strings preserve imported static ABI spelling.
@propose seed J23_STATIC_SCHEMA := {
 THIS(J23_FABRIC_ROOT,"FLAG_WORLD_J17_SECOND_STEP_023"),
 THIS(J23_TICK_BLOCK,"FIRST_TICK"),
 GOES_WITH(J23_WITNESS_TYPE,WHAT,"identity/essence"),
 GOES_WITH(J23_SCHEMA,THIS,VALUE,EXACTLY_ONE),
 GOES_WITH(J23_SCHEMA,SAME_NOT_SAME,LEFT,EXACTLY_ONE),
 GOES_WITH(J23_SCHEMA,SAME_NOT_SAME,RIGHT,EXACTLY_ONE),
 GOES_WITH(J23_BYTE_NEXT,B40,B41),
 GOES_WITH(J23_BYTE_NEXT,B41,B44),
 GOES_WITH(J23_BYTE_NEXT,B44,B48),
 GOES_WITH(J23_BYTE_NEXT,B48,B49),
 GOES_WITH(J23_BYTE_NEXT,B49,B50),
 GOES_WITH(J23_BYTE_NEXT,B50,B51),
 GOES_WITH(J23_BYTE_NEXT,B51,B52),
 GOES_WITH(J23_BYTE_NEXT,B52,B53),
 GOES_WITH(J23_BYTE_NEXT,B53,B54),
 GOES_WITH(J23_BYTE_NEXT,B54,B55),
 GOES_WITH(J23_BYTE_NEXT,B55,B56),
 GOES_WITH(J23_BYTE_NEXT,B56,B57),
 GOES_WITH(J23_BYTE_NEXT,B57,B65),
 GOES_WITH(J23_BYTE_NEXT,B65,B66),
 GOES_WITH(J23_BYTE_NEXT,B66,B67),
 GOES_WITH(J23_BYTE_NEXT,B67,B68),
 GOES_WITH(J23_BYTE_NEXT,B68,B69),
 GOES_WITH(J23_BYTE_NEXT,B69,B70),
 GOES_WITH(J23_BYTE_NEXT,B70,B71),
 GOES_WITH(J23_BYTE_NEXT,B71,B72),
 GOES_WITH(J23_BYTE_NEXT,B72,B73),
 GOES_WITH(J23_BYTE_NEXT,B73,B74),
 GOES_WITH(J23_BYTE_NEXT,B74,B75),
 GOES_WITH(J23_BYTE_NEXT,B75,B76),
 GOES_WITH(J23_BYTE_NEXT,B76,B77),
 GOES_WITH(J23_BYTE_NEXT,B77,B78),
 GOES_WITH(J23_BYTE_NEXT,B78,B79),
 GOES_WITH(J23_BYTE_NEXT,B79,B80),
 GOES_WITH(J23_BYTE_NEXT,B80,B81),
 GOES_WITH(J23_BYTE_NEXT,B81,B82),
 GOES_WITH(J23_BYTE_NEXT,B82,B83),
 GOES_WITH(J23_BYTE_NEXT,B83,B84),
 GOES_WITH(J23_BYTE_NEXT,B84,B85),
 GOES_WITH(J23_BYTE_NEXT,B85,B86),
 GOES_WITH(J23_BYTE_NEXT,B86,B87),
 GOES_WITH(J23_BYTE_NEXT,B87,B88),
 GOES_WITH(J23_BYTE_NEXT,B88,B89),
 GOES_WITH(J23_BYTE_NEXT,B89,B90),
 GOES_WITH(J23_BYTE_NEXT,B90,B95),
 GOES_WITH(J23_BYTE_NEXT,B95,B97),
 GOES_WITH(J23_BYTE_NEXT,B97,B98),
 GOES_WITH(J23_BYTE_NEXT,B98,B99),
 GOES_WITH(J23_BYTE_NEXT,B99,B100),
 GOES_WITH(J23_BYTE_NEXT,B100,B101),
 GOES_WITH(J23_BYTE_NEXT,B101,B102)
};

// Canonical byte order is observation encoding, never locus/role selection.
law J23_BYTE_ORDER_BASE := IF GOES_WITH(J23_BYTE_NEXT,a,b)
 THEN GOES_WITH(J23_BYTE_LESS,a,b);
law J23_BYTE_ORDER_CHAIN := IF GOES_WITH(J23_BYTE_LESS,a,b), GOES_WITH(J23_BYTE_NEXT,b,c)
 THEN GOES_WITH(J23_BYTE_LESS,a,c);
law J23_LEX_PREFIX_REQUEST := IF THIS(J23_LEX_REQUEST,CONS(a,x),CONS(a,y))
 THEN THIS(J23_LEX_REQUEST,x,y);
law J23_LEX_FIRST_DISTINCT := IF THIS(J23_LEX_REQUEST,CONS(a,x),CONS(b,y)), GOES_WITH(J23_BYTE_LESS,a,b)
 THEN GOES_WITH(J23_LEX_LESS,CONS(a,x),CONS(b,y));
law J23_LEX_SHORTER := IF THIS(J23_LEX_REQUEST,NIL,CONS(a,y))
 THEN GOES_WITH(J23_LEX_LESS,NIL,CONS(a,y));
law J23_LEX_EQUAL_PREFIX := IF THIS(J23_LEX_REQUEST,CONS(a,x),CONS(a,y)), GOES_WITH(J23_LEX_LESS,x,y)
 THEN GOES_WITH(J23_LEX_LESS,CONS(a,x),CONS(a,y));

law J23_CELLS_START := IF THIS(J23_INVENTORY_CELLS,xs) THEN GOES_WITH(J23_LIST,CELLS,xs);
law J23_ROUTES_START := IF THIS(J23_INVENTORY_ROUTES,xs) THEN GOES_WITH(J23_LIST,ROUTES,xs);
law J23_COMPARATORS_START := IF THIS(J23_INVENTORY_COMPARATORS,xs) THEN GOES_WITH(J23_LIST,COMPARATORS,xs);
law J23_LIST_TAIL := IF GOES_WITH(J23_LIST,k,CONS(a,t)) THEN GOES_WITH(J23_LIST,k,t);
law J23_CELL_LIST_MEMBER := IF GOES_WITH(J23_LIST,CELLS,CONS(c,t)), GOES_WITH(J23_ID_RESPONSE,c,id)
 THEN GOES_WITH(J23_DECLARED_CELL,c,id);
law J23_COMP_LIST_MEMBER := IF GOES_WITH(J23_LIST,COMPARATORS,CONS(c,t)), GOES_WITH(J23_ID_RESPONSE,c,id), GOES_WITH(J23_SELECTED_COMPARATOR,c,f,g)
 THEN GOES_WITH(J23_DECLARED_COMPARATOR,c,id,f,g);
law J23_ROUTE_LIST_MEMBER := IF GOES_WITH(J23_LIST,ROUTES,CONS(ROUTE(rid,m,RESULT,c,role),t)), GOES_WITH(J23_SELECTED_ROUTE,m,RESULT,c,role), GOES_WITH(J23_ROUTE_HASH,m,RESULT,c,role,rid,mid,cid), GOES_WITH(J23_ID_RESPONSE,m,mid), GOES_WITH(J23_ID_RESPONSE,c,cid)
 THEN GOES_WITH(J23_DECLARED_ROUTE,ROUTE(rid,m,RESULT,c,role),mid,cid);
law J23_CELL_KEY := IF GOES_WITH(J23_LIST,CELLS,CONS(c,t)), GOES_WITH(J23_DECLARED_CELL,c,id)
 THEN GOES_WITH(J23_LIST_KEY,CELLS,c,id);
law J23_COMP_KEY := IF GOES_WITH(J23_LIST,COMPARATORS,CONS(c,t)), GOES_WITH(J23_DECLARED_COMPARATOR,c,id,f,g)
 THEN GOES_WITH(J23_LIST_KEY,COMPARATORS,c,id);
law J23_ROUTE_KEY := IF GOES_WITH(J23_DECLARED_ROUTE,ROUTE(rid,m,RESULT,c,role),mid,cid)
 THEN GOES_WITH(J23_LIST_KEY,ROUTES,ROUTE(rid,m,RESULT,c,role),rid);
law J23_LIST_ORDER_REQUEST := IF GOES_WITH(J23_LIST,k,CONS(a,CONS(b,t))), GOES_WITH(J23_LIST_KEY,k,a,TEXT(x)), GOES_WITH(J23_LIST_KEY,k,b,TEXT(y))
 THEN THIS(J23_LEX_REQUEST,x,y);
law J23_LIST_ORDER := IF GOES_WITH(J23_LIST,k,CONS(a,CONS(b,t))), GOES_WITH(J23_LIST_KEY,k,a,TEXT(x)), GOES_WITH(J23_LIST_KEY,k,b,TEXT(y)), GOES_WITH(J23_LEX_LESS,x,y)
 THEN THIS(J23_ORDERED,k,CONS(a,CONS(b,t)));
law J23_LIST_LAST := IF GOES_WITH(J23_LIST,k,CONS(a,NIL)), GOES_WITH(J23_LIST_KEY,k,a,id)
 THEN THIS(J23_ORDERED,k,CONS(a,NIL));

// Every selected cell is typed and located from its own already-produced contact.
// Constructor namespaces separate marker identities, comparator identities,
// source enclosures, block and root; strict inventory order prohibits aliases.
law J23_MARKER_CELL := IF GOES_WITH(J23_SELECTED_MARKER,m,f), GOES_WITH(J23_DECLARED_CELL,m,id), GOES_WITH(J22_CLASS,m,A,w,j,S), GOES_WITH(J22_LOCATION_EVIDENCE,m,LOCATION(INTERIOR(S),CONTAINMENT(FIRST_TICK,INCIDENCE(v,e,t)))), GOES_WITH(J21_COORDINATE,m,INCIDENCE(v,e,t),PARENT(w)), GOES_WITH(J22_MARKER_CAPABILITY,G), GOES_WITH(J22_MARKER_CAPABILITY,S), GOES_WITH(J23_SCHEMA,THIS,VALUE,EXACTLY_ONE)
 THEN GOES_WITH(J23_TYPED_SOURCE,m,id,THIS,"THIS",CONTAINMENT(FIRST_TICK,INCIDENCE(v,e,t)));
law J23_COMPARATOR_SCHEMA := IF GOES_WITH(SF_CAPABILITY,SAME_NOT_SAME,G), GOES_WITH(SF_CAPABILITY,SAME_NOT_SAME,S), GOES_WITH(J23_SCHEMA,SAME_NOT_SAME,LEFT,EXACTLY_ONE), GOES_WITH(J23_SCHEMA,SAME_NOT_SAME,RIGHT,EXACTLY_ONE)
 THEN THIS(J23_COMPARATOR_SCHEMA);
law J23_COMPARATOR_CELL := IF GOES_WITH(J23_SELECTED_COMPARATOR,c,f,g), GOES_WITH(J23_DECLARED_COMPARATOR,c,id,f,g), GOES_WITH(J23_DECLARED_CELL,c,id), GOES_WITH(SF_OCCURRENCE_ADMITTED,c,e), GOES_WITH(SF_OCCURRENCE_PLACEMENT,c,LOCATION(INTERIOR(S),CONTAINMENT(FIRST_TICK,OVERLAP(f,g)))), THIS(J23_COMPARATOR_SCHEMA)
 THEN GOES_WITH(J23_TYPED_SOURCE,c,id,SAME_NOT_SAME,"SAME_NOT_SAME",CONTAINMENT(FIRST_TICK,OVERLAP(f,g)));
law J23_CELL_ID_EXPORT := IF GOES_WITH(J23_TYPED_SOURCE,c,id,op,text,enclosure)
 THEN GOES_WITH(J23_CELL_ID,c,id);
law J23_ENCLOSURE_ID := IF GOES_WITH(J23_TYPED_SOURCE,c,TEXT(h),op,text,enclosure)
 THEN GOES_WITH(J23_ENCLOSURE_ID,c,TEXT(CONS(B101,CONS(B110,CONS(B99,CONS(B108,CONS(B111,CONS(B115,CONS(B117,CONS(B114,CONS(B101,CONS(B58,h))))))))))),enclosure);
law J23_CELL_DEF := IF GOES_WITH(J23_TYPED_SOURCE,c,id,op,text,enclosure), GOES_WITH(J23_WITNESS_TYPE,WHAT,t)
 THEN GOES_WITH(J23_CELL_DEF,c,OBJECT(CONS(MEMBER("cell_id",id),CONS(MEMBER("operator",text),CONS(MEMBER("payload_slot_type",t),CONS(MEMBER("triad_capability",ARRAY(CONS("\u25a1G",CONS("\u25a1S",NIL)))),CONS(MEMBER("witness","WHAT"),NIL)))))));
law J23_LOCATION := IF GOES_WITH(J23_TYPED_SOURCE,c,id,op,text,enclosure), GOES_WITH(J23_ENCLOSURE_ID,c,m,enclosure), THIS(J23_TICK_BLOCK,b), THIS(J23_FABRIC_ROOT,p)
 THEN GOES_WITH(J23_LOCATION,c,OBJECT(CONS(MEMBER("containment_path",ARRAY(CONS(m,CONS(b,CONS(p,NIL))))),CONS(MEMBER("triad_position",OBJECT(CONS(MEMBER("dimension","\u25a1S"),CONS(MEMBER("kind","INTERIOR"),NIL)))),NIL))));
law J23_PLACEMENT_ROW := IF GOES_WITH(J23_CELL_ID,c,id), GOES_WITH(J23_LOCATION,c,loc)
 THEN GOES_WITH(J23_PLACEMENT_ROW,c,OBJECT(CONS(MEMBER("cell_id",id),CONS(MEMBER("location",loc),NIL))));
law J23_MOTIF_ROW := IF GOES_WITH(J23_CELL_ID,c,id), GOES_WITH(J23_ENCLOSURE_ID,c,m,enclosure)
 THEN GOES_WITH(J23_MOTIF_ROW,c,OBJECT(CONS(MEMBER("contained_ids",ARRAY(CONS(id,NIL))),CONS(MEMBER("motif_id",m),NIL))));
law J23_CELL_CHECK := IF GOES_WITH(J23_CELL_DEF,c,def), GOES_WITH(J23_LOCATION,c,loc), GOES_WITH(J23_PLACEMENT_ROW,c,place), GOES_WITH(J23_MOTIF_ROW,c,motif), GOES_WITH(J23_ENCLOSURE_ID,c,m,enclosure), THIS(J23_TICK_BLOCK,b), THIS(J23_FABRIC_ROOT,p)
 THEN GOES_WITH(J23_CELL_CHECK,c,STATIC_CELL_CHECK(def,place,motif,CONTAINMENT_PATH(m,b,p),SOURCE_ENCLOSURE(enclosure)));

// Port, type, endpoint and hash checks for each actual selected route.
law J23_ROUTE_ENDPOINTS := IF GOES_WITH(J23_DECLARED_ROUTE,ROUTE(rid,m,RESULT,c,role),mid,cid), GOES_WITH(J23_CELL_CHECK,m,mp), GOES_WITH(J23_CELL_CHECK,c,cp), GOES_WITH(J23_CELL_ID,m,mid), GOES_WITH(J23_CELL_ID,c,cid)
 THEN GOES_WITH(J23_ROUTE_ENDPOINTS,ROUTE(rid,m,RESULT,c,role),mid,cid,ENDPOINTS(mp,cp));
law J23_ROUTE_CHECK := IF GOES_WITH(J23_ROUTE_ENDPOINTS,ROUTE(rid,m,RESULT,c,role),mid,cid,ep), GOES_WITH(J21_PORT,THIS,WHAT,RESULT,OUT,EXACTLY_ONE,t), GOES_WITH(J21_PORT,SAME_NOT_SAME,WHAT,role,IN,EXACTLY_ONE,t), GOES_WITH(J23_ROUTE_HASH,m,RESULT,c,role,rid,mid,cid), GOES_WITH(J22_ROUTE_REGION,m,RESULT,c,role,SAME_REGION(S))
 THEN GOES_WITH(J23_ROUTE_CHECK,ROUTE(rid,m,RESULT,c,role),STATIC_ROUTE_CHECK(ENDPOINTS(m,c),HASH(rid,mid,RESULT,cid,role),PORTS(RESULT,OUT,role,IN),PAYLOAD(t),SAME_REGION(S)));
law J23_ROUTE_JSON := IF GOES_WITH(J23_ROUTE_CHECK,ROUTE(rid,m,RESULT,c,role),proof), GOES_WITH(J23_CELL_ID,m,mid), GOES_WITH(J23_CELL_ID,c,cid), GOES_WITH(J23_ROLE_TEXT,role,text)
 THEN GOES_WITH(J23_ROUTE_JSON,ROUTE(rid,m,RESULT,c,role),OBJECT(CONS(MEMBER("route_id",rid),CONS(MEMBER("source_cell",mid),CONS(MEMBER("source_role","RESULT"),CONS(MEMBER("target_cell",cid),CONS(MEMBER("target_role",text),NIL)))))));
@propose seed J23_ROLE_OBSERVATION := {
 GOES_WITH(J23_ROLE_TEXT,LEFT,"LEFT"),
 GOES_WITH(J23_ROLE_TEXT,RIGHT,"RIGHT")
};
law J23_COMPLETE_JOIN := IF GOES_WITH(J23_DECLARED_COMPARATOR,c,id,f,g), GOES_WITH(J23_SELECTED_MARKER,l,f), GOES_WITH(J23_SELECTED_MARKER,r,g), GOES_WITH(J23_ROUTE_CHECK,ROUTE(lr,l,RESULT,c,LEFT),lp), GOES_WITH(J23_ROUTE_CHECK,ROUTE(rr,r,RESULT,c,RIGHT),rp), GOES_WITH(J22_JOIN_CHECK,c,IF_THEN,JOIN(LEFT(ONE),RIGHT(ONE)))
 THEN GOES_WITH(J23_COMPLETE_JOIN,c,l,lr,r,rr,JOIN(LEFT(ONE),RIGHT(ONE)));

// Forward inventory folds: every supplied row has a source proof; strict keys
// rule out duplicates/collisions. No success seed bypasses a missing member.
law J23_CELL_FOLD_END := IF GOES_WITH(J23_LIST,CELLS,NIL)
 THEN GOES_WITH(J23_CELL_FOLD,NIL,LISTS(NIL,NIL,NIL,NIL),NIL);
law J23_CELL_FOLD_ROW := IF GOES_WITH(J23_LIST,CELLS,CONS(c,t)), THIS(J23_ORDERED,CELLS,CONS(c,t)), GOES_WITH(J23_CELL_DEF,c,def), GOES_WITH(J23_PLACEMENT_ROW,c,place), GOES_WITH(J23_MOTIF_ROW,c,motif), GOES_WITH(J23_ENCLOSURE_ID,c,m,enclosure), GOES_WITH(J23_CELL_CHECK,c,proof), GOES_WITH(J23_CELL_FOLD,t,LISTS(ds,ms,ps,bs),proofs)
 THEN GOES_WITH(J23_CELL_FOLD,CONS(c,t),LISTS(CONS(def,ds),CONS(motif,ms),CONS(place,ps),CONS(m,bs)),CONS(proof,proofs));
law J23_ROUTE_FOLD_END := IF GOES_WITH(J23_LIST,ROUTES,NIL)
 THEN GOES_WITH(J23_ROUTE_FOLD,NIL,NIL,NIL);
law J23_ROUTE_FOLD_ROW := IF GOES_WITH(J23_LIST,ROUTES,CONS(r,t)), THIS(J23_ORDERED,ROUTES,CONS(r,t)), GOES_WITH(J23_ROUTE_JSON,r,json), GOES_WITH(J23_ROUTE_CHECK,r,proof), GOES_WITH(J23_ROUTE_FOLD,t,rs,proofs)
 THEN GOES_WITH(J23_ROUTE_FOLD,CONS(r,t),CONS(json,rs),CONS(proof,proofs));
law J23_COMP_FOLD_END := IF GOES_WITH(J23_LIST,COMPARATORS,NIL)
 THEN GOES_WITH(J23_COMP_FOLD,NIL,NIL);
law J23_COMP_FOLD_ROW := IF GOES_WITH(J23_LIST,COMPARATORS,CONS(c,t)), THIS(J23_ORDERED,COMPARATORS,CONS(c,t)), GOES_WITH(J23_COMPLETE_JOIN,c,l,lr,r,rr,proof), GOES_WITH(J23_COMP_FOLD,t,proofs)
 THEN GOES_WITH(J23_COMP_FOLD,CONS(c,t),CONS(COMPLETE_JOIN(c,l,lr,r,rr,proof),proofs));

// Reverse coverage: the retained committed field/witness lists, not a new
// host-selected coverage list, enumerate the entire candidate source.
law J23_MARKER_COVERED_A := IF GOES_WITH(J22_CLASS,m,A,w,j,d), GOES_WITH(J23_SELECTED_MARKER,m,f), GOES_WITH(J23_CELL_CHECK,m,proof)
 THEN THIS(J23_MARKER_COVERED,m);
law J23_MARKER_COVERED_B := IF GOES_WITH(J22_CLASS,m,B,w,j,d)
 THEN THIS(J23_MARKER_COVERED,m);
law J23_MARKER_COVERED_C := IF GOES_WITH(J22_CLASS,m,C,w,j,d)
 THEN THIS(J23_MARKER_COVERED,m);
law J23_MARKER_COVERED_D := IF GOES_WITH(J22_CLASS,m,D,w,j,d)
 THEN THIS(J23_MARKER_COVERED,m);
law J23_FIELD_COVER_END := IF GOES_WITH(GSC_ROWS,CURRENT_FIELD,NIL)
 THEN THIS(J23_FIELD_COVERED,NIL);
law J23_FIELD_COVER_ROW := IF GOES_WITH(GSC_ROWS,CURRENT_FIELD,CONS(ARRAY(CONS(json,CONS(text,NIL))),tail)), GOES_WITH(FLAG_JSON,f,json), GOES_WITH(J21_MARKER,m,TYPE(THIS,WHAT),f,r), THIS(J23_MARKER_COVERED,m), THIS(J23_FIELD_COVERED,tail)
 THEN THIS(J23_FIELD_COVERED,CONS(ARRAY(CONS(json,CONS(text,NIL))),tail));
law J23_COMP_COVERED_SELECTED := IF GOES_WITH(J23_COMPLETE_JOIN,c,l,lr,r,rr,proof)
 THEN THIS(J23_COMP_COVERED,c);
law J23_COMP_COVERED_WITHHELD := IF GOES_WITH(J23_EXCLUDED_TARGET,c,reason)
 THEN THIS(J23_COMP_COVERED,c);
law J23_PAIR_COVER_END := IF GOES_WITH(GSC_ROWS,CURRENT_WITNESS,NIL)
 THEN THIS(J23_PAIR_COVERED,NIL);
law J23_PAIR_COVER_ROW := IF GOES_WITH(GSC_ROWS,CURRENT_WITNESS,CONS(ARRAY(CONS(a,CONS(b,CONS(text,NIL)))),tail)), GOES_WITH(FLAG_JSON,f,a), GOES_WITH(FLAG_JSON,g,b), GOES_WITH(SF_COMPARATOR,c,f,g), THIS(J23_COMP_COVERED,c), THIS(J23_PAIR_COVERED,tail)
 THEN THIS(J23_PAIR_COVERED,CONS(ARRAY(CONS(a,CONS(b,CONS(text,NIL)))),tail));
law J23_FULL_COVERAGE := IF THIS(GSC_FIELD_INPUT,ARRAY(fs)), GOES_WITH(GSC_COMPLETE,CURRENT_FIELD,ARRAY(fs)), THIS(J23_FIELD_COVERED,fs), THIS(GSC_WITNESS_INPUT,ARRAY(ws)), GOES_WITH(GSC_COMPLETE,CURRENT_WITNESS,ARRAY(ws)), THIS(J23_PAIR_COVERED,ws)
 THEN THIS(J23_FULL_COVERAGE);

// All eight imported conditions are separately exposed on the assembled
// candidate. They depend on checked source rows, strict inventories, complete
// reverse coverage, exact endpoint/hash contacts and complete static joins.
law J23_STATIC_ASSEMBLED := IF THIS(J23_INVENTORY_CELLS,cs), GOES_WITH(J23_CELL_FOLD,cs,LISTS(ds,ms,ps,bs),cp), THIS(J23_INVENTORY_ROUTES,rs), GOES_WITH(J23_ROUTE_FOLD,rs,rjson,rp), THIS(J23_INVENTORY_COMPARATORS,ks), GOES_WITH(J23_COMP_FOLD,ks,kp), THIS(J23_FULL_COVERAGE)
 THEN GOES_WITH(J23_STATIC_ASSEMBLED,cs,rs,ks,LISTS(ds,ms,ps,bs,rjson),CHECKS(cp,rp,kp));
law J23_DRC_I := IF GOES_WITH(J23_STATIC_ASSEMBLED,cs,rs,ks,lists,CHECKS(cp,rp,kp))
 THEN GOES_WITH(J23_DRC_CONDITION,I,IF_THEN,IDENTITY_INTEGRITY(cs,cp));
law J23_DRC_II := IF GOES_WITH(J23_STATIC_ASSEMBLED,cs,rs,ks,lists,CHECKS(cp,rp,kp))
 THEN GOES_WITH(J23_DRC_CONDITION,II,IF_THEN,CONTAINMENT(cp));
law J23_DRC_III := IF GOES_WITH(J23_STATIC_ASSEMBLED,cs,rs,ks,lists,CHECKS(cp,rp,kp))
 THEN GOES_WITH(J23_DRC_CONDITION,III,IF_THEN,PLACEMENT_CAPABILITY(cp));
law J23_DRC_IV := IF GOES_WITH(J23_STATIC_ASSEMBLED,cs,rs,ks,lists,CHECKS(cp,rp,kp))
 THEN GOES_WITH(J23_DRC_CONDITION,IV,IF_THEN,ENDPOINTS(rp));
law J23_DRC_V := IF GOES_WITH(J23_STATIC_ASSEMBLED,cs,rs,ks,lists,CHECKS(cp,rp,kp))
 THEN GOES_WITH(J23_DRC_CONDITION,V,IF_THEN,ROUTE_IDENTITIES(rp));
law J23_DRC_VI := IF GOES_WITH(J23_STATIC_ASSEMBLED,cs,rs,ks,lists,CHECKS(cp,rp,kp))
 THEN GOES_WITH(J23_DRC_CONDITION,VI,IF_THEN,PORT_DIRECTION(rp));
law J23_DRC_VII := IF GOES_WITH(J23_STATIC_ASSEMBLED,cs,rs,ks,lists,CHECKS(cp,rp,kp))
 THEN GOES_WITH(J23_DRC_CONDITION,VII,IF_THEN,PAYLOAD_TYPE(rp));
law J23_DRC_VIII := IF GOES_WITH(J23_STATIC_ASSEMBLED,cs,rs,ks,lists,CHECKS(cp,rp,kp))
 THEN GOES_WITH(J23_DRC_CONDITION,VIII,IF_THEN,JOIN_ROLES_MULTIPLICITY(kp));

law J23_CANONICAL_PROGRAM := IF GOES_WITH(J23_STATIC_ASSEMBLED,cs,rs,ks,LISTS(ds,ms,ps,bs,rjson),proof), THIS(J23_FABRIC_ROOT,root), THIS(J23_TICK_BLOCK,block)
 THEN GOES_WITH(J23_CANONICAL_PROGRAM,cs,rs,ks,proof,OBJECT(CONS(MEMBER("cells",ARRAY(ds)),CONS(MEMBER("fabric_id",root),CONS(MEMBER("motifs",ARRAY(ms)),CONS(MEMBER("placements",ARRAY(ps)),CONS(MEMBER("routes",ARRAY(rjson)),CONS(MEMBER("triad_blocks",ARRAY(CONS(OBJECT(CONS(MEMBER("block_id",block),CONS(MEMBER("contained_ids",ARRAY(bs)),NIL))),NIL))),NIL))))))));
law J23_PROGRAM_HASH_REQUEST := IF GOES_WITH(J23_CANONICAL_PROGRAM,cs,rs,ks,proof,object)
 THEN GOES_WITH(GPU_HASH_REQUEST,PROGRAM,PROGRAM_023,object);
law J23_PROGRAM_BOUND := IF GOES_WITH(J23_CANONICAL_PROGRAM,cs,rs,ks,proof,object), GOES_WITH(GPU_HASH_RESPONSE,object,p)
 THEN GOES_WITH(J23_PROGRAM_BOUND,p,cs,rs,ks,proof,object);
law J23_PROGRAM_EXPORT := IF GOES_WITH(J23_PROGRAM_BOUND,p,cs,rs,ks,proof,object)
 THEN GOES_WITH(J23_PROGRAM,p,cs,rs);
law J23_PROGRAM_OBJECT_EXPORT := IF GOES_WITH(J23_PROGRAM_BOUND,p,cs,rs,ks,proof,object)
 THEN GOES_WITH(J23_PROGRAM_OBJECT,p,object);
law J23_PROGRAM_DRC_EXPORT := IF GOES_WITH(J23_PROGRAM_BOUND,p,cs,rs,ks,proof,object)
 THEN GOES_WITH(J23_PROGRAM_DRC,p,IF_THEN,proof);
law J23_COMPARATOR_LIST_EXPORT := IF GOES_WITH(J23_PROGRAM_BOUND,p,cs,rs,ks,proof,object)
 THEN GOES_WITH(J23_COMPARATOR_LIST,p,ks);
law J23_MARKER_MEMBER_EXPORT := IF GOES_WITH(J23_PROGRAM_BOUND,p,cs,rs,ks,proof,object), GOES_WITH(J23_SELECTED_MARKER,m,f), GOES_WITH(J23_CELL_CHECK,m,check)
 THEN GOES_WITH(J23_MARKER_MEMBER,p,m,f);
law J23_COMPARATOR_MEMBER_EXPORT := IF GOES_WITH(J23_PROGRAM_BOUND,p,cs,rs,ks,proof,object), GOES_WITH(J23_SELECTED_COMPARATOR,c,f,g), GOES_WITH(J23_COMPLETE_JOIN,c,l,lr,r,rr,check)
 THEN GOES_WITH(J23_COMPARATOR_MEMBER,p,c,f,g);
law J23_ROUTE_EXPORT := IF GOES_WITH(J23_PROGRAM_BOUND,p,cs,rs,ks,proof,object), GOES_WITH(J23_ROUTE_CHECK,ROUTE(rid,m,RESULT,c,role),check)
 THEN GOES_WITH(J23_ROUTE,p,rid,m,RESULT,c,role);
law J23_JOIN_EXPORT := IF GOES_WITH(J23_PROGRAM_BOUND,p,cs,rs,ks,proof,object), GOES_WITH(J23_COMPLETE_JOIN,c,l,lr,r,rr,check)
 THEN GOES_WITH(J23_JOIN,p,c,l,lr,r,rr);
// Report condition (iii) on every touched witness face, and condition (iv)
// for every route of this program rather than the larger retained candidate.
law J23_MARKER_FACE_CHECK := IF GOES_WITH(J23_MARKER_MEMBER,p,m,f), GOES_WITH(J21_CCC_MARKER,m,w,j), GOES_WITH(J22_DRC_III_CELL,m,w,IF_THEN,location)
 THEN GOES_WITH(J23_DRC_III_OCCURRENCE_FACE,p,m,w,IF_THEN,location);
law J23_COMPARATOR_FACE_CHECK := IF GOES_WITH(J23_COMPARATOR_MEMBER,p,c,f,g), GOES_WITH(J22_DRC_III_CELL,c,w,IF_THEN,location)
 THEN GOES_WITH(J23_DRC_III_OCCURRENCE_FACE,p,c,w,IF_THEN,location);
law J23_TOUCHED_FACE_CHECK := IF GOES_WITH(J23_DRC_III_OCCURRENCE_FACE,p,c,w,IF_THEN,location)
 THEN GOES_WITH(J23_DRC_III_FACE,p,w,IF_THEN);
law J23_ROUTE_ENDPOINT_CHECK := IF GOES_WITH(J23_ROUTE,p,rid,m,RESULT,c,role), GOES_WITH(J23_ROUTE_CHECK,ROUTE(rid,m,RESULT,c,role),check)
 THEN GOES_WITH(J23_DRC_IV_ROUTE,p,rid,IF_THEN,ENDPOINTS(m,c));



@readonly input J23_IMPORT_SVC02 := "svc02:";
law J23_IMPORT_SVC02 := IF THIS(J23_IMPORT_SVC02,ARRAY(rows)) THEN THIS(J23_SERVICE_ROWS,rows);

// TASK_CODEX_J17_SECOND_STEP_023: bounded, source-owned V3.3 execution.
// V3.3 5BB1497AA3D791150F0416FEDA4E393695A9302B42030ADD0A7D22C08CCBEAC0.
// Immutable snapshot -> evaluate -> propagate -> govern -> simultaneous return.
// execution_v0_3_0/execution_kernel.py:711-728: complete arrivals to a
// non-EMPTY snapshot target stay in its PartialInputBuffer. They are NOT a
// second same-tick evaluation, pending admission, or a FabricEdit.
// This branch accepts the source-selected complete program only. All eighteen
// payloads begin ADMITTED from g1, and the explicit ingress auxiliary state
// must have no prior routes, pending admissions, buffers, obligations, receipts.
// The comparator remains a sink. A completed payload is not discharged here.
// Field fixed point is NOT fabric-state fixed point: payloads and custody move.
// Hashes and canonical JSON are generic observation primitives, not world law.

@propose seed S23_RUNTIME_CONTRACT := {
 GOES_WITH(S23_READING_JSON,NO,"NO"),
 GOES_WITH(S23_READING_JSON,THIS,"THIS"),
 GOES_WITH(S23_READING_JSON,SAME,"SAME"),
 GOES_WITH(S23_READING_JSON,NOT_SAME,"NOT_SAME"),
 GOES_WITH(S23_COMPARE,NO,NO,SAME),
 GOES_WITH(S23_COMPARE,THIS,THIS,SAME),
 GOES_WITH(S23_COMPARE,NO,THIS,NOT_SAME),
 GOES_WITH(S23_COMPARE,THIS,NO,NOT_SAME),
 GOES_WITH(S23_ROLE_JSON,LEFT,"LEFT"),
 GOES_WITH(S23_ROLE_JSON,RIGHT,"RIGHT"),
 THIS(S23_AUTHORITY_JSON,OBJECT(CONS(MEMBER("decisions",ARRAY(NIL)),CONS(MEMBER("imported_v3_2_kernel_sha256","89105692eee04580db1c98556b51d0644292b7fb7b42fa4f41ebd381cde256dc"),NIL))))
};

// All stages are under the complete-program eight-condition DRC witness.
law S23_OPEN := IF GOES_WITH(J23_PROGRAM,p,cells,routes), GOES_WITH(J23_PROGRAM_DRC,p,IF_THEN,proof), GOES_WITH(J23_SNAPSHOT_AUX,p,GENESIS,AUX(NIL,NIL,NIL,NIL,NIL),stamp), THIS(COMMITTED_GENESIS,g1)
 THEN GOES_WITH(S23_OPEN,p,cells,routes,stamp,g1);
law S23_AUTHORITY_REQUEST := IF THIS(S23_AUTHORITY_JSON,j)
 THEN GOES_WITH(GPU_HASH_REQUEST,S23_AUTHORITY,S23_AUTHORITY,j);
law S23_AUTHORITY_BOUND := IF THIS(S23_AUTHORITY_JSON,j), GOES_WITH(GPU_HASH_RESPONSE,j,h)
 THEN THIS(S23_AUTHORITY_DIGEST,h);

// Source-bound snapshot frames. The InputValue source_receipt is g1's link;
// no value produced by this tick can satisfy a snapshot-frame antecedent.
law S23_MARKER_SNAPSHOT_VALUE := IF GOES_WITH(S23_OPEN,p,cells,routes,stamp,g1), GOES_WITH(J23_MARKER_MEMBER,p,m,f), GOES_WITH(SF_SNAPSHOT_FIELD,GENESIS,f,r), GOES_WITH(S23_READING_JSON,r,j), GOES_WITH(J23_CELL_ID,m,id), GOES_WITH(GSC_LINK_HASH,record,h)
 THEN GOES_WITH(S23_INPUT_REQUEST,SNAPSHOT_MARKER(p,m),id,j,h);
law S23_INPUT_JSON := IF GOES_WITH(S23_INPUT_REQUEST,key,route,value,receipt)
 THEN GOES_WITH(S23_INPUT_JSON,key,OBJECT(CONS(MEMBER("payload_type","identity/essence"),CONS(MEMBER("route_id",route),CONS(MEMBER("source_receipt",receipt),CONS(MEMBER("value",value),NIL))))));
law S23_MARKER_SNAPSHOT_FRAME := IF GOES_WITH(J23_MARKER_MEMBER,p,m,f), GOES_WITH(S23_INPUT_JSON,SNAPSHOT_MARKER(p,m),value), GOES_WITH(SF_SNAPSHOT_FIELD,GENESIS,f,r)
 THEN GOES_WITH(S23_SNAPSHOT_FRAME,p,m,OBJECT(CONS(MEMBER("VALUE",ARRAY(CONS(value,NIL))),NIL)),r);
law S23_COMPARATOR_LEFT_VALUE := IF GOES_WITH(S23_OPEN,p,cells,routes,stamp,g1), GOES_WITH(J23_JOIN,p,c,l,lr,r,rr), GOES_WITH(J23_COMPARATOR_MEMBER,p,c,f,g), GOES_WITH(SF_SNAPSHOT_FIELD,GENESIS,f,v), GOES_WITH(S23_READING_JSON,v,j), GOES_WITH(GSC_LINK_HASH,record,h)
 THEN GOES_WITH(S23_INPUT_REQUEST,SNAPSHOT_LEFT(p,c),lr,j,h);
law S23_COMPARATOR_RIGHT_VALUE := IF GOES_WITH(S23_OPEN,p,cells,routes,stamp,g1), GOES_WITH(J23_JOIN,p,c,l,lr,r,rr), GOES_WITH(J23_COMPARATOR_MEMBER,p,c,f,g), GOES_WITH(SF_SNAPSHOT_FIELD,GENESIS,g,v), GOES_WITH(S23_READING_JSON,v,j), GOES_WITH(GSC_LINK_HASH,record,h)
 THEN GOES_WITH(S23_INPUT_REQUEST,SNAPSHOT_RIGHT(p,c),rr,j,h);
law S23_COMPARATOR_READING := IF GOES_WITH(S23_OPEN,p,cells,routes,stamp,g1), GOES_WITH(J23_COMPARATOR_MEMBER,p,c,f,g), GOES_WITH(SF_SNAPSHOT_FIELD,GENESIS,f,a), GOES_WITH(SF_SNAPSHOT_FIELD,GENESIS,g,b), GOES_WITH(S23_COMPARE,a,b,r)
 THEN GOES_WITH(S23_COMPARATOR_READING,p,c,f,g,r);
law S23_COMPARATOR_SNAPSHOT_FRAME := IF GOES_WITH(S23_COMPARATOR_READING,p,c,f,g,r), GOES_WITH(S23_INPUT_JSON,SNAPSHOT_LEFT(p,c),left), GOES_WITH(S23_INPUT_JSON,SNAPSHOT_RIGHT(p,c),right)
 THEN GOES_WITH(S23_SNAPSHOT_FRAME,p,c,OBJECT(CONS(MEMBER("LEFT",ARRAY(CONS(left,NIL))),CONS(MEMBER("RIGHT",ARRAY(CONS(right,NIL))),NIL))),r);

// Source-owned evaluation specializes the declared THIS and SAME readings;
// evaluation remains a pure function of the immutable snapshot.
law S23_EVALUATE := IF GOES_WITH(S23_SNAPSHOT_FRAME,p,c,frame,r), GOES_WITH(S23_READING_JSON,r,j), GOES_WITH(J23_CELL_ID,c,id)
 THEN GOES_WITH(S23_EVALUATION,p,c,frame,r,j,EVALUATION(p,c));
law S23_EVALUATION_RECEIPT := IF GOES_WITH(S23_EVALUATION,p,c,frame,r,j,key), GOES_WITH(J23_CELL_ID,c,id)
 THEN GOES_WITH(S23_RECEIPT_PAYLOAD,key,"CELL_EVALUATED",id,j);
law S23_TRANSITION_RECEIPT := IF GOES_WITH(S23_EVALUATION,p,c,frame,r,j,key), GOES_WITH(J23_CELL_ID,c,id)
 THEN GOES_WITH(S23_RECEIPT_PAYLOAD,TRANSITION(p,c),"PAYLOAD_TRANSITION",id,ARRAY(CONS("ADMITTED",CONS("COMPLETED",NIL))));

// Runtime receipt identity follows reference :338-341 exactly: first hash the
// payload, then hash (kind, subject identity, payload hash). Generic responses
// are accepted only against the exact source-produced request JSON.
law S23_RECEIPT_PAYLOAD_HASH := IF GOES_WITH(S23_RECEIPT_PAYLOAD,key,kind,subject,j)
 THEN GOES_WITH(GPU_HASH_REQUEST,S23_RECEIPT_PAYLOAD,key,j);
law S23_RECEIPT_ID_REQUEST := IF GOES_WITH(S23_RECEIPT_PAYLOAD,key,kind,subject,j), GOES_WITH(GPU_HASH_RESPONSE,j,h)
 THEN GOES_WITH(S23_RECEIPT_ID_REQUEST,key,kind,subject,h,ARRAY(CONS(kind,CONS(subject,CONS(h,NIL)))));
law S23_RECEIPT_ID_HASH := IF GOES_WITH(S23_RECEIPT_ID_REQUEST,key,kind,subject,h,j)
 THEN GOES_WITH(GPU_HASH_REQUEST,S23_RECEIPT_ID,key,j);
law S23_RECEIPT_BOUND := IF GOES_WITH(S23_RECEIPT_ID_REQUEST,key,kind,subject,payload,j), GOES_WITH(GPU_HASH_RESPONSE,j,id)
 THEN GOES_WITH(S23_RECEIPT,key,id,OBJECT(CONS(MEMBER("kind",kind),CONS(MEMBER("payload_digest",payload),CONS(MEMBER("receipt_id",id),CONS(MEMBER("subject_id",subject),NIL))))));

// PROPAGATE in the same step; arrivals never feed S23_SNAPSHOT_FRAME.
law S23_PROPAGATE := IF GOES_WITH(J23_ROUTE,p,r,m,RESULT,c,role), GOES_WITH(S23_EVALUATION,p,m,frame,reading,j,key), GOES_WITH(S23_RECEIPT,key,receipt,evidence)
 THEN GOES_WITH(S23_INPUT_REQUEST,ARRIVAL(p,r),r,j,receipt);
law S23_ROUTE_ARRIVAL := IF GOES_WITH(J23_ROUTE,p,r,m,RESULT,c,role), GOES_WITH(S23_INPUT_JSON,ARRIVAL(p,r),value)
 THEN GOES_WITH(S23_ROUTE_ARRIVAL,p,r,m,c,role,value);

// RUNTIME GOVERNANCE. Same-region routes use the imported default authority
// with no edit request and no additional governance decision. The exact
// default authority identity is hash-bound above, reference :541-545.
law S23_ROUTE_AUTHORITY := IF GOES_WITH(S23_ROUTE_ARRIVAL,p,r,m,c,role,value), GOES_WITH(J22_ROUTE_REGION,m,RESULT,c,role,SAME_REGION(S)), THIS(S23_AUTHORITY_DIGEST,authority), GOES_WITH(J23_PROGRAM_DRC,p,IF_THEN,proof)
 THEN GOES_WITH(S23_ROUTE_AUTHORITY,p,r,ADMIT,authority);
law S23_ROUTE_RECEIPT := IF GOES_WITH(S23_ROUTE_ARRIVAL,p,r,m,c,role,value), GOES_WITH(S23_ROUTE_AUTHORITY,p,r,ADMIT,authority), GOES_WITH(J23_CELL_ID,c,id), GOES_WITH(S23_ROLE_JSON,role,jrole)
 THEN GOES_WITH(S23_RECEIPT_PAYLOAD,EGRESS(p,r),"ADMITTED_TO_TARGET",r,ARRAY(CONS(r,CONS(id,CONS(jrole,CONS(value,CONS(authority,NIL)))))));
law S23_ROUTE_DISPOSITION := IF GOES_WITH(S23_ROUTE_ARRIVAL,p,r,m,c,role,value), GOES_WITH(S23_RECEIPT,EGRESS(p,r),receipt,evidence), GOES_WITH(J23_CELL_ID,c,id)
 THEN GOES_WITH(S23_ROUTE_DISPOSITION,p,r,m,c,OBJECT(CONS(MEMBER("candidate_ref",JSON_NULL),CONS(MEMBER("kind","ADMITTED_TO_TARGET"),CONS(MEMBER("reason",JSON_NULL),CONS(MEMBER("receipt_id",receipt),CONS(MEMBER("route_id",r),CONS(MEMBER("target_cell",id),NIL))))))));

// A complete LEFT/RIGHT assembly is retained as input custody because the
// target is ADMITTED in the snapshot. This is not a rejected or partial frame.
law S23_BUSY_COMPLETE_BUFFER := IF GOES_WITH(J23_JOIN,p,c,l,lr,r,rr), GOES_WITH(S23_ROUTE_ARRIVAL,p,lr,l,c,LEFT,left), GOES_WITH(S23_ROUTE_ARRIVAL,p,rr,r,c,RIGHT,right), GOES_WITH(S23_ROUTE_DISPOSITION,p,lr,l,c,ld), GOES_WITH(S23_ROUTE_DISPOSITION,p,rr,r,c,rd), GOES_WITH(S23_SNAPSHOT_FRAME,p,c,old,reading)
 THEN GOES_WITH(S23_BUSY_BUFFER_FRAME,p,c,OBJECT(CONS(MEMBER("LEFT",ARRAY(CONS(left,NIL))),CONS(MEMBER("RIGHT",ARRAY(CONS(right,NIL))),NIL))),l,r);
law S23_BUSY_BUFFER_RECEIPTS := IF GOES_WITH(S23_BUSY_BUFFER_FRAME,p,c,frame,l,r), GOES_WITH(S23_RECEIPT,EVALUATION(p,l),lh,le), GOES_WITH(S23_RECEIPT,EVALUATION(p,r),rh,re)
 THEN GOES_WITH(S23_BUFFER_RECEIPTS,p,c,ARRAY(CONS(lh,CONS(rh,NIL))));
law S23_BUSY_BUFFER_SORT := IF GOES_WITH(S23_BUFFER_RECEIPTS,p,c,rs)
 THEN GOES_WITH(GPU_SORT_REQUEST,S23_BUFFER_RECEIPTS,BUFFER(p,c),rs,"");
law S23_BUSY_BUFFER_JSON := IF GOES_WITH(S23_BUSY_BUFFER_FRAME,p,c,frame,l,r), GOES_WITH(J23_CELL_ID,c,id), GOES_WITH(S23_BUFFER_RECEIPTS,p,c,rs), GOES_WITH(GPU_SORT_RESPONSE,rs,"",sorted), GOES_WITH(S23_OPEN,p,cells,routes,stamp,g1)
 THEN GOES_WITH(S23_BUFFER_JSON,p,c,OBJECT(CONS(MEMBER("arrived_values",frame),CONS(MEMBER("cell_id",id),CONS(MEMBER("source_receipts",sorted),CONS(MEMBER("tick_of_first_arrival",stamp),NIL))))));

// Simultaneous payload transition. Each selected marker has exactly its one
// retained route; complete DRC is required before this bounded branch opens.
law S23_MARKER_COMPLETION := IF GOES_WITH(J23_MARKER_MEMBER,p,m,f), GOES_WITH(S23_EVALUATION,p,m,frame,reading,result,key), GOES_WITH(J23_ROUTE,p,r,m,RESULT,c,role), GOES_WITH(S23_ROUTE_DISPOSITION,p,r,m,c,d)
 THEN GOES_WITH(S23_NEXT_PAYLOAD,p,m,frame,result,ARRAY(CONS(d,NIL)));
law S23_COMPARATOR_COMPLETION := IF GOES_WITH(J23_COMPARATOR_MEMBER,p,c,f,g), GOES_WITH(S23_EVALUATION,p,c,frame,reading,result,key), GOES_WITH(S23_BUFFER_JSON,p,c,buffer)
 THEN GOES_WITH(S23_NEXT_PAYLOAD,p,c,frame,result,ARRAY(NIL));
law S23_NEXT_PAYLOAD_JSON := IF GOES_WITH(S23_NEXT_PAYLOAD,p,c,frame,result,evidence)
 THEN GOES_WITH(S23_NEXT_PAYLOAD_JSON,p,c,OBJECT(CONS(MEMBER("admission_receipt",JSON_NULL),CONS(MEMBER("completion_evidence",evidence),CONS(MEMBER("discharge_receipt",JSON_NULL),CONS(MEMBER("frame",frame),CONS(MEMBER("phase","COMPLETED"),CONS(MEMBER("result",result),CONS(MEMBER("result_ref",JSON_NULL),NIL)))))))));

// Full-inventory folds: no missing row can silently disappear. Inventory order
// is custody/observation order and never selects a flag, role, or route.
law S23_CELL_TAIL := IF GOES_WITH(S23_OPEN,p,cells,routes,stamp,g1)
 THEN GOES_WITH(S23_CELL_TAIL,p,cells);
law S23_CELL_TAIL_NEXT := IF GOES_WITH(S23_CELL_TAIL,p,CONS(c,t))
 THEN GOES_WITH(S23_CELL_TAIL,p,t);
law S23_CELL_SUFFIX_END := IF GOES_WITH(S23_CELL_TAIL,p,NIL)
 THEN GOES_WITH(S23_CELL_SUFFIX,p,NIL,NIL,NIL);
law S23_CELL_SUFFIX := IF GOES_WITH(S23_CELL_TAIL,p,CONS(c,t)), GOES_WITH(J23_CELL_ID,c,id), GOES_WITH(S23_NEXT_PAYLOAD_JSON,p,c,j), GOES_WITH(S23_RECEIPT,EVALUATION(p,c),eh,e), GOES_WITH(S23_RECEIPT,TRANSITION(p,c),th,transition), GOES_WITH(S23_CELL_SUFFIX,p,t,rows,receipts)
 THEN GOES_WITH(S23_CELL_SUFFIX,p,CONS(c,t),CONS(MEMBER(id,j),rows),CONS(e,CONS(transition,receipts)));
law S23_ROUTE_TAIL := IF GOES_WITH(S23_OPEN,p,cells,routes,stamp,g1)
 THEN GOES_WITH(S23_ROUTE_TAIL,p,routes);
law S23_ROUTE_TAIL_NEXT := IF GOES_WITH(S23_ROUTE_TAIL,p,CONS(r,t))
 THEN GOES_WITH(S23_ROUTE_TAIL,p,t);
law S23_ROUTE_SUFFIX_END := IF GOES_WITH(S23_ROUTE_TAIL,p,NIL)
 THEN GOES_WITH(S23_ROUTE_SUFFIX,p,NIL,NIL,NIL);
law S23_ROUTE_SUFFIX := IF GOES_WITH(S23_ROUTE_TAIL,p,CONS(ROUTE(r,m,RESULT,c,role),t)), GOES_WITH(S23_ROUTE_DISPOSITION,p,r,m,c,j), GOES_WITH(S23_RECEIPT,EGRESS(p,r),h,e), GOES_WITH(S23_ROUTE_SUFFIX,p,t,rows,receipts)
 THEN GOES_WITH(S23_ROUTE_SUFFIX,p,CONS(ROUTE(r,m,RESULT,c,role),t),CONS(MEMBER(r,j),rows),CONS(e,receipts));
law S23_BUFFER_TAIL := IF GOES_WITH(J23_COMPARATOR_LIST,p,cs), GOES_WITH(S23_OPEN,p,cells,routes,stamp,g1)
 THEN GOES_WITH(S23_BUFFER_TAIL,p,cs);
law S23_BUFFER_TAIL_NEXT := IF GOES_WITH(S23_BUFFER_TAIL,p,CONS(c,t))
 THEN GOES_WITH(S23_BUFFER_TAIL,p,t);
law S23_BUFFER_SUFFIX_END := IF GOES_WITH(S23_BUFFER_TAIL,p,NIL)
 THEN GOES_WITH(S23_BUFFER_SUFFIX,p,NIL,NIL);
law S23_BUFFER_SUFFIX := IF GOES_WITH(S23_BUFFER_TAIL,p,CONS(c,t)), GOES_WITH(S23_BUFFER_JSON,p,c,j), GOES_WITH(S23_BUFFER_SUFFIX,p,t,rows)
 THEN GOES_WITH(S23_BUFFER_SUFFIX,p,CONS(c,t),CONS(j,rows));
law S23_RECEIPT_APPEND_REQUEST := IF GOES_WITH(S23_OPEN,p,cells,routes,stamp,g1), GOES_WITH(S23_CELL_SUFFIX,p,cells,ps,cr), GOES_WITH(S23_ROUTE_SUFFIX,p,routes,rs,rr)
 THEN GOES_WITH(S23_APPEND_REQUEST,cr,rr);
law S23_APPEND_TAIL := IF GOES_WITH(S23_APPEND_REQUEST,CONS(a,t),b)
 THEN GOES_WITH(S23_APPEND_REQUEST,t,b);
law S23_APPEND_END := IF GOES_WITH(S23_APPEND_REQUEST,NIL,b)
 THEN GOES_WITH(S23_APPEND,NIL,b,b);
law S23_APPEND_ROW := IF GOES_WITH(S23_APPEND_REQUEST,CONS(a,t),b), GOES_WITH(S23_APPEND,t,b,j)
 THEN GOES_WITH(S23_APPEND,CONS(a,t),b,CONS(a,j));
law S23_STATE_PARTS := IF GOES_WITH(S23_OPEN,p,cells,routes,stamp,g1), GOES_WITH(S23_CELL_SUFFIX,p,cells,ps,cr), GOES_WITH(S23_ROUTE_SUFFIX,p,routes,rs,rr), GOES_WITH(J23_COMPARATOR_LIST,p,cs), GOES_WITH(S23_BUFFER_SUFFIX,p,cs,bs), GOES_WITH(S23_APPEND,cr,rr,receipts)
 THEN GOES_WITH(S23_STATE_PARTS,p,ps,rs,bs,receipts);
law S23_FINAL_RECEIPT_SORT := IF GOES_WITH(S23_STATE_PARTS,p,ps,rs,bs,receipts)
 THEN GOES_WITH(GPU_SORT_REQUEST,S23_RECEIPTS,p,ARRAY(receipts),"receipt_id");
law S23_FINAL_BUFFER_SORT := IF GOES_WITH(S23_STATE_PARTS,p,ps,rs,bs,receipts)
 THEN GOES_WITH(GPU_SORT_REQUEST,S23_BUFFERS,p,ARRAY(bs),"cell_id");
law S23_STATE_JSON := IF GOES_WITH(S23_STATE_PARTS,p,ps,rs,bs,receipts), GOES_WITH(GPU_SORT_RESPONSE,ARRAY(receipts),"receipt_id",sorted_receipts), GOES_WITH(GPU_SORT_RESPONSE,ARRAY(bs),"cell_id",sorted_buffers)
 THEN GOES_WITH(S23_STATE_JSON,p,OBJECT(CONS(MEMBER("outstanding_obligations",ARRAY(NIL)),CONS(MEMBER("payload_states",OBJECT(ps)),CONS(MEMBER("pending_admissions",ARRAY(NIL)),CONS(MEMBER("pending_input_buffers",sorted_buffers),CONS(MEMBER("receipts",sorted_receipts),CONS(MEMBER("route_states",OBJECT(rs)),NIL))))))));
law S23_RETURN := IF GOES_WITH(S23_STATE_JSON,p,j), GOES_WITH(J23_PROGRAM,p,cells,routes)
 THEN GOES_WITH(STEP_FABRIC_RETURN,p,GENESIS,FABRIC_STATE(j));
law S23_SUCCESSOR_JSON := IF GOES_WITH(STEP_FABRIC_RETURN,p,GENESIS,FABRIC_STATE(j))
 THEN GOES_WITH(S23_SUCCESSOR_JSON,p,GENESIS,FABRIC_STATE(j),j);

// EXECUTE TASK_CODEX_J17_SECOND_STEP_023, steps 3--4.
// Reuse GPU-self-witness / C20 link observation schema, not frozen V1/V2 bytes.
// Every world effect is source-owned. Host JSON/SHA is generic observation only.
// The selected program contains THIS markers and SAME comparators only. Neither
// operator writes a flag reading. Full program and result folds below certify
// that restricted effect set before the unchanged world projection is made.
// Runtime payload state DOES change and is bound separately by its whole hash.
// An unchanged world field still appends a predecessor-bound link as instructed.

@readonly input C23_HASH_INPUT := "hash_batch:";
law C23_HASH_BEGIN := IF THIS(C23_HASH_INPUT,ARRAY(rows)) THEN THIS(C23_HASH_ROWS,rows);
law C23_HASH_TAIL := IF THIS(C23_HASH_ROWS,CONS(row,tail)) THEN THIS(C23_HASH_ROWS,tail);
law C23_HASH_RESPONSE := IF THIS(C23_HASH_ROWS,CONS(ARRAY(CONS(subject,CONS(digest,NIL))),tail))
 THEN GOES_WITH(GPU_HASH_RESPONSE,subject,digest);

// Exact archived g1 custody: the original chain entry and its source-bound hash.
law C23_GENESIS := IF THIS(COMMITTED_GENESIS,OBJECT(CONS(MEMBER("chain",ARRAY(CONS(entry,NIL))),CONS(MEMBER("field",field),CONS(MEMBER("receipt",receipt),CONS(MEMBER("witness",witness),NIL)))))), GOES_WITH(GSC_CHAIN_ENTRY,record,entry), GOES_WITH(GSC_LINK_HASH,record,h)
 THEN GOES_WITH(C23_GENESIS,h,entry,field,witness);
law C23_RETURN := IF GOES_WITH(STEP_FABRIC_RETURN,p,GENESIS,next), GOES_WITH(S23_SUCCESSOR_JSON,p,GENESIS,next,json), GOES_WITH(C23_GENESIS,h,entry,field,witness)
 THEN GOES_WITH(C23_RETURN,p,h,next,json);

// The task's exact 18-cell program, not an assumption about absent effects.
law C23_EFFECT_TAIL_START := IF GOES_WITH(J23_PROGRAM,p,cells,routes)
 THEN GOES_WITH(C23_EFFECT_TAIL,p,cells);
law C23_EFFECT_TAIL := IF GOES_WITH(C23_EFFECT_TAIL,p,CONS(c,tail))
 THEN GOES_WITH(C23_EFFECT_TAIL,p,tail);
law C23_MARKER_EFFECT := IF GOES_WITH(J23_MARKER_MEMBER,p,m,f)
 THEN GOES_WITH(C23_CELL_EFFECT,p,m,NO_FLAG_WRITE);
law C23_COMPARATOR_EFFECT := IF GOES_WITH(J23_COMPARATOR_MEMBER,p,c,f,g)
 THEN GOES_WITH(C23_CELL_EFFECT,p,c,NO_FLAG_WRITE);
law C23_EFFECT_END := IF GOES_WITH(C23_EFFECT_TAIL,p,NIL)
 THEN GOES_WITH(C23_EFFECT_SUFFIX,p,NIL,NO_FLAG_WRITE);
law C23_EFFECT_ROW := IF GOES_WITH(C23_EFFECT_TAIL,p,CONS(c,tail)), GOES_WITH(C23_CELL_EFFECT,p,c,NO_FLAG_WRITE), GOES_WITH(C23_EFFECT_SUFFIX,p,tail,NO_FLAG_WRITE)
 THEN GOES_WITH(C23_EFFECT_SUFFIX,p,CONS(c,tail),NO_FLAG_WRITE);
law C23_EFFECT_COMPLETE := IF GOES_WITH(J23_PROGRAM,p,cells,routes), GOES_WITH(C23_EFFECT_SUFFIX,p,cells,NO_FLAG_WRITE)
 THEN GOES_WITH(C23_PROGRAM_EFFECT,p,NO_FLAG_WRITE);

// Every admitted comparator must actually evaluate the same snapshot gluing.
// This certifies only the six program results; it does not pretend the other
// 714 comparators ran. The unchanged field carries their unchanged witnesses.
law C23_RESULT_TAIL_START := IF GOES_WITH(J23_COMPARATOR_LIST,p,cs)
 THEN GOES_WITH(C23_RESULT_TAIL,p,cs);
law C23_RESULT_TAIL := IF GOES_WITH(C23_RESULT_TAIL,p,CONS(c,tail))
 THEN GOES_WITH(C23_RESULT_TAIL,p,tail);
law C23_RESULT_SAME := IF GOES_WITH(J23_COMPARATOR_MEMBER,p,c,f,g), GOES_WITH(S23_COMPARATOR_READING,p,c,f,g,r), GOES_WITH(CURRENT_GLUING,f,g,r)
 THEN GOES_WITH(C23_RESULT_SAME,p,c,f,g,r);
law C23_RESULT_DIFFER_SAME := IF GOES_WITH(S23_COMPARATOR_READING,p,c,f,g,SAME), GOES_WITH(CURRENT_GLUING,f,g,NOT_SAME)
 THEN GOES_WITH(C23_RESULT_DIFFER,p,c,f,g,NOT_SAME);
law C23_RESULT_DIFFER_WALL := IF GOES_WITH(S23_COMPARATOR_READING,p,c,f,g,NOT_SAME), GOES_WITH(CURRENT_GLUING,f,g,SAME)
 THEN GOES_WITH(C23_RESULT_DIFFER,p,c,f,g,NOT_SAME);
law C23_RESULT_END := IF GOES_WITH(C23_RESULT_TAIL,p,NIL)
 THEN GOES_WITH(C23_RESULT_SUFFIX,p,NIL);
law C23_RESULT_ROW := IF GOES_WITH(C23_RESULT_TAIL,p,CONS(c,tail)), GOES_WITH(C23_RESULT_SAME,p,c,f,g,r), GOES_WITH(C23_RESULT_SUFFIX,p,tail)
 THEN GOES_WITH(C23_RESULT_SUFFIX,p,CONS(c,tail));
law C23_RESULTS_COMPLETE := IF GOES_WITH(J23_COMPARATOR_LIST,p,cs), GOES_WITH(C23_RESULT_SUFFIX,p,cs)
 THEN THIS(C23_RESULTS_COMPLETE,p);
law C23_PROJECTION := IF GOES_WITH(C23_RETURN,p,h,next,json), GOES_WITH(C23_GENESIS,h,entry,field,witness), GOES_WITH(C23_PROGRAM_EFFECT,p,NO_FLAG_WRITE), THIS(C23_RESULTS_COMPLETE,p), GOES_WITH(GSC_COMPLETE,CURRENT_FIELD,field), GOES_WITH(GSC_COMPLETE,CURRENT_WITNESS,witness)
 THEN GOES_WITH(C23_PROJECTION,p,next,PAIR(field,witness));
law C23_NEXT_FIELD := IF GOES_WITH(C23_PROJECTION,p,next,PAIR(field,witness)), GOES_WITH(CURRENT_FIELD,f,r)
 THEN GOES_WITH(C23_NEXT_FIELD,p,next,f,r);
law C23_NEXT_GLUING := IF GOES_WITH(C23_PROJECTION,p,next,PAIR(field,witness)), GOES_WITH(CURRENT_GLUING,f,g,r)
 THEN GOES_WITH(C23_NEXT_GLUING,p,next,f,g,r);

// Receipts describe the complete unchanged field, not just admitted routes.
// Retained walls are witnessed, never silently erased by a six-cell subprogram.
law C23_UNCHANGED := IF GOES_WITH(C23_RETURN,p,h,next,json), GOES_WITH(C23_NEXT_GLUING,p,next,f,g,SAME), GOES_WITH(CURRENT_GLUING,f,g,SAME)
 THEN GOES_WITH(C23_RECEIPT_PAIR,p,h,f,g,"UNCHANGED");
law C23_RETAINED := IF GOES_WITH(C23_RETURN,p,h,next,json), GOES_WITH(C23_NEXT_GLUING,p,next,f,g,NOT_SAME), GOES_WITH(CURRENT_GLUING,f,g,NOT_SAME)
 THEN GOES_WITH(C23_RECEIPT_PAIR,p,h,f,g,"RETAINED");
law C23_RECEIPT_ROW := IF GOES_WITH(C23_RECEIPT_PAIR,p,h,f,g,status), GOES_WITH(FLAG_JSON,f,a), GOES_WITH(FLAG_JSON,g,b)
 THEN THIS(OBSERVATION_ROW,STEP_023_RECEIPT,ARRAY(CONS(a,CONS(b,CONS(status,NIL)))));
law C23_RETAINED_ROW := IF GOES_WITH(C23_RECEIPT_PAIR,p,h,f,g,"RETAINED"), GOES_WITH(FLAG_JSON,f,a), GOES_WITH(FLAG_JSON,g,b)
 THEN THIS(OBSERVATION_ROW,STEP_023_RETAINED_WALLS,ARRAY(CONS(a,CONS(b,NIL))));

law C23_PAIR_OBJECT := IF GOES_WITH(C23_RETURN,p,h,next,json), GOES_WITH(C23_PROJECTION,p,next,PAIR(field,witness))
 THEN GOES_WITH(C23_PAIR_OBJECT,p,h,OBJECT(CONS(MEMBER("field",field),CONS(MEMBER("witness",witness),NIL))));
law C23_RECEIPT_OBJECT := IF GOES_WITH(C23_RETURN,p,h,next,json), GOES_WITH(C23_PROJECTION,p,next,PAIR(field,witness))
 THEN GOES_WITH(C23_RECEIPT_OBJECT,p,h,OBJECT(CONS(MEMBER("discharged",ARRAY(NIL)),CONS(MEMBER("opened",ARRAY(NIL)),NIL))));
law C23_RECEIPT_READING := IF GOES_WITH(C23_RECEIPT_OBJECT,p,h,OBJECT(CONS(MEMBER("discharged",ARRAY(NIL)),CONS(MEMBER("opened",ARRAY(NIL)),NIL))))
 THEN GOES_WITH(C23_RECEIPT_READING,p,h,"NO");
law C23_PAIR_HASH_REQUEST := IF GOES_WITH(C23_PAIR_OBJECT,p,h,subject)
 THEN GOES_WITH(GPU_HASH_REQUEST,WORLD_PAIR,CONTEXT(p,h),subject);
law C23_RECEIPT_HASH_REQUEST := IF GOES_WITH(C23_RECEIPT_OBJECT,p,h,subject)
 THEN GOES_WITH(GPU_HASH_REQUEST,WORLD_RECEIPT,CONTEXT(p,h),subject);
law C23_FABRIC_HASH_REQUEST := IF GOES_WITH(C23_RETURN,p,h,next,json)
 THEN GOES_WITH(GPU_HASH_REQUEST,FABRIC_SUCCESSOR,CONTEXT(p,h),json);
law C23_FABRIC_HASH := IF GOES_WITH(C23_RETURN,p,h,next,json), GOES_WITH(GPU_HASH_RESPONSE,json,digest)
 THEN GOES_WITH(C23_FABRIC_STATE_HASH,p,h,next,digest);
law C23_PAIR_HASH := IF GOES_WITH(C23_PAIR_OBJECT,p,h,subject), GOES_WITH(GPU_HASH_RESPONSE,subject,digest)
 THEN GOES_WITH(C23_PAIR_HASH,p,h,subject,digest);
law C23_RECEIPT_HASH := IF GOES_WITH(C23_RECEIPT_OBJECT,p,h,subject), GOES_WITH(GPU_HASH_RESPONSE,subject,digest)
 THEN GOES_WITH(C23_RECEIPT_HASH,p,h,subject,digest);
law C23_RECORD_PARTS := IF GOES_WITH(C23_PAIR_HASH,p,h,OBJECT(CONS(MEMBER("field",field),CONS(MEMBER("witness",witness),NIL))),pairhash), GOES_WITH(C23_RECEIPT_HASH,p,h,receipt,receipthash), GOES_WITH(C23_RECEIPT_READING,p,h,reading)
 THEN GOES_WITH(C23_RECORD_PARTS,p,h,PARTS(field,witness,receipt,pairhash,receipthash,reading));
law C23_TICK_RECORD := IF GOES_WITH(C23_RECORD_PARTS,p,h,PARTS(field,witness,receipt,pairhash,receipthash,reading))
 THEN GOES_WITH(C23_TICK_RECORD,p,h,OBJECT(CONS(MEMBER("fabric_program",p),CONS(MEMBER("field",field),CONS(MEMBER("kind","TICK"),CONS(MEMBER("pair_hash",pairhash),CONS(MEMBER("prev",h),CONS(MEMBER("receipt",receipt),CONS(MEMBER("receipt_hash",receipthash),CONS(MEMBER("receipt_reading",reading),CONS(MEMBER("witness",witness),NIL)))))))))));
law C23_TICK_HASH_REQUEST := IF GOES_WITH(C23_TICK_RECORD,p,h,subject)
 THEN GOES_WITH(GPU_HASH_REQUEST,WORLD_TICK,CONTEXT(p,h),subject);
law C23_TICK_HASH := IF GOES_WITH(C23_TICK_RECORD,p,h,subject), GOES_WITH(GPU_HASH_RESPONSE,subject,digest)
 THEN GOES_WITH(C23_TICK_HASH,p,h,subject,digest);
law C23_TICK_ENTRY := IF GOES_WITH(C23_TICK_HASH,p,h,record,digest)
 THEN GOES_WITH(C23_TICK_ENTRY,p,h,OBJECT(CONS(MEMBER("link",digest),CONS(MEMBER("record",record),NIL))));
// Publish one successor over g1 even when field and witness are unchanged.
// Its changed runtime state is witnessed separately by C23_FABRIC_STATE_HASH.
law C23_COMMIT_OBJECT := IF GOES_WITH(C23_RETURN,p,h,next,json), GOES_WITH(C23_PROJECTION,p,next,PAIR(field,witness)), GOES_WITH(C23_GENESIS,h,genesis,field,priorwitness), GOES_WITH(C23_RECORD_PARTS,p,h,PARTS(field,witness,receipt,pairhash,receipthash,reading)), GOES_WITH(C23_TICK_ENTRY,p,h,tick), GOES_WITH(C23_FABRIC_STATE_HASH,p,h,next,statehash)
 THEN GOES_WITH(C23_COMMITTED_OBJECT,p,h,next,OBJECT(CONS(MEMBER("chain",ARRAY(CONS(genesis,CONS(tick,NIL)))),CONS(MEMBER("field",field),CONS(MEMBER("receipt",receipt),CONS(MEMBER("witness",witness),NIL))))));
law C23_COMMIT := IF GOES_WITH(C23_COMMITTED_OBJECT,p,h,next,world)
 THEN THIS(COMMITTED_WORLD,world);
law C23_COMMITTED_RETURN := IF THIS(COMMITTED_WORLD,world), GOES_WITH(C23_COMMITTED_OBJECT,p,h,next,world)
 THEN GOES_WITH(C23_COMMITTED_RETURN,p,h,next,world);

// Informational next-tick readout. The predecessor is g1, not Ground_0_012.
// All predicates have their own namespace; run018 DG values remain untouched.
// Metric 3419D528: count EDIT once for flag incidence's union, equivalently
// triad-contains-junction, not additive site/edge/triad multiplicities.
law D23_ROWS_START := IF GOES_WITH(C23_COMMITTED_RETURN,p,h,next,world), GOES_WITH(C23_GENESIS,h,e,ARRAY(rows),w)
 THEN THIS(D23_ROWS,rows);
law D23_ROWS_TAIL := IF THIS(D23_ROWS,CONS(row,tail)) THEN THIS(D23_ROWS,tail);
law D23_FIELD_PAIR := IF GOES_WITH(C23_COMMITTED_RETURN,p,h,next,world), THIS(D23_ROWS,CONS(ARRAY(CONS(json,CONS(text,NIL))),tail)), GOES_WITH(FLAG_JSON,f,json), GOES_WITH(C23_NEXT_FIELD,p,next,f,current), GOES_WITH(CURRENT_FIELD,f,prior)
 THEN GOES_WITH(D23_PAIR,f,current,prior);
law D23_READING_SAME := IF GOES_WITH(D23_PAIR,f,r,r) THEN GOES_WITH(D23_EDIT,f,NO_EDIT);
law D23_READING_THIS_NO := IF GOES_WITH(D23_PAIR,f,THIS,NO) THEN GOES_WITH(D23_EDIT,f,EDIT);
law D23_READING_NO_THIS := IF GOES_WITH(D23_PAIR,f,NO,THIS) THEN GOES_WITH(D23_EDIT,f,EDIT);
law D23_CONTRIBUTION_EDIT := IF GOES_WITH(DG_SUPPORT_TRIAD,s,t), GOES_WITH(D23_EDIT,TOGETHER_ALONE(v,e,t),EDIT)
 THEN GOES_WITH(D23_CONTRIBUTION,s,TOGETHER_ALONE(v,e,t),NEXT_COUNT(EMPTY_COUNT));
law D23_CONTRIBUTION_SAME := IF GOES_WITH(DG_SUPPORT_TRIAD,s,t), GOES_WITH(D23_EDIT,TOGETHER_ALONE(v,e,t),NO_EDIT)
 THEN GOES_WITH(D23_CONTRIBUTION,s,TOGETHER_ALONE(v,e,t),EMPTY_COUNT);
law D23_CONTRIBUTION_OUTSIDE := IF GOES_WITH(DG_MISS_TRIAD,s,t), GOES_WITH(D23_PAIR,TOGETHER_ALONE(v,e,t),current,prior)
 THEN GOES_WITH(D23_CONTRIBUTION,s,TOGETHER_ALONE(v,e,t),EMPTY_COUNT);
law D23_ACC_START := IF GOES_WITH(C23_COMMITTED_RETURN,p,h,next,world), GOES_WITH(C23_GENESIS,h,e,ARRAY(rows),w), GOES_WITH(WORLD_JUNCTION_SITE,s,j)
 THEN GOES_WITH(D23_ACC,s,rows,EMPTY_COUNT);
law D23_ACC_UNCHANGED := IF GOES_WITH(D23_ACC,s,CONS(ARRAY(CONS(json,CONS(text,NIL))),tail),n), GOES_WITH(FLAG_JSON,f,json), GOES_WITH(D23_CONTRIBUTION,s,f,EMPTY_COUNT)
 THEN GOES_WITH(D23_ACC,s,tail,n);
law D23_ACC_EDIT := IF GOES_WITH(D23_ACC,s,CONS(ARRAY(CONS(json,CONS(text,NIL))),tail),n), GOES_WITH(FLAG_JSON,f,json), GOES_WITH(D23_CONTRIBUTION,s,f,NEXT_COUNT(EMPTY_COUNT))
 THEN GOES_WITH(D23_ACC,s,tail,NEXT_COUNT(n));
law D23_ACC_DONE := IF GOES_WITH(D23_ACC,s,NIL,n) THEN GOES_WITH(D23_VALUE,s,n);
law D23_COUNT_REQUEST := IF GOES_WITH(D23_VALUE,s,n) THEN THIS(D23_COUNT_BYTES_REQUEST,n);
law D23_COUNT_DESCEND := IF THIS(D23_COUNT_BYTES_REQUEST,NEXT_COUNT(n)) THEN THIS(D23_COUNT_BYTES_REQUEST,n);
law D23_COUNT_EMPTY := IF THIS(D23_COUNT_BYTES_REQUEST,EMPTY_COUNT) THEN GOES_WITH(D23_COUNT_LIST,EMPTY_COUNT,NIL);
law D23_COUNT_ASCEND := IF THIS(D23_COUNT_BYTES_REQUEST,NEXT_COUNT(n)), GOES_WITH(D23_COUNT_LIST,n,items)
 THEN GOES_WITH(D23_COUNT_LIST,NEXT_COUNT(n),CONS("THIS",items));
law D23_VALUE_ROW := IF GOES_WITH(D23_VALUE,s,n), GOES_WITH(SITE_TEXT,s,text), GOES_WITH(D23_COUNT_LIST,n,items)
 THEN THIS(OBSERVATION_ROW,STEP_023_DG_VALUES,ARRAY(CONS(text,CONS(ARRAY(items),NIL))));
law D23_FACE_DISTANCES := IF GOES_WITH(DG_FACE,w,a,b,c), GOES_WITH(D23_VALUE,a,x), GOES_WITH(D23_VALUE,b,y), GOES_WITH(D23_VALUE,c,z)
 THEN GOES_WITH(D23_FACE_DISTANCE,w,a,b,c,x,y,z);
law D23_MEMBER_A := IF GOES_WITH(D23_FACE_DISTANCE,w,a,b,c,x,y,z) THEN GOES_WITH(D23_FACE_MEMBER,w,a,x);
law D23_MEMBER_B := IF GOES_WITH(D23_FACE_DISTANCE,w,a,b,c,x,y,z) THEN GOES_WITH(D23_FACE_MEMBER,w,b,y);
law D23_MEMBER_C := IF GOES_WITH(D23_FACE_DISTANCE,w,a,b,c,x,y,z) THEN GOES_WITH(D23_FACE_MEMBER,w,c,z);
law D23_COMPARE_REQUEST := IF GOES_WITH(D23_FACE_MEMBER,w,a,x), GOES_WITH(D23_FACE_MEMBER,w,b,y)
 THEN THIS(D23_COMPARE_REQUEST,x,y);
law D23_COMPARE_DESCEND := IF THIS(D23_COMPARE_REQUEST,NEXT_COUNT(x),NEXT_COUNT(y)) THEN THIS(D23_COMPARE_REQUEST,x,y);
law D23_COMPARE_EMPTY := IF THIS(D23_COMPARE_REQUEST,EMPTY_COUNT,EMPTY_COUNT) THEN GOES_WITH(D23_ORDER,EMPTY_COUNT,EMPTY_COUNT,SAME);
law D23_COMPARE_LESS := IF THIS(D23_COMPARE_REQUEST,EMPTY_COUNT,NEXT_COUNT(y)) THEN GOES_WITH(D23_ORDER,EMPTY_COUNT,NEXT_COUNT(y),LESS);
law D23_COMPARE_MORE := IF THIS(D23_COMPARE_REQUEST,NEXT_COUNT(x),EMPTY_COUNT) THEN GOES_WITH(D23_ORDER,NEXT_COUNT(x),EMPTY_COUNT,MORE);
law D23_COMPARE_ASCEND := IF THIS(D23_COMPARE_REQUEST,NEXT_COUNT(x),NEXT_COUNT(y)), GOES_WITH(D23_ORDER,x,y,r)
 THEN GOES_WITH(D23_ORDER,NEXT_COUNT(x),NEXT_COUNT(y),r);
law D23_G_A := IF GOES_WITH(D23_FACE_DISTANCE,w,a,b,c,x,y,z), GOES_WITH(D23_ORDER,x,y,LESS), GOES_WITH(D23_ORDER,x,z,LESS) THEN GOES_WITH(D23_G,w,a);
law D23_G_B := IF GOES_WITH(D23_FACE_DISTANCE,w,a,b,c,x,y,z), GOES_WITH(D23_ORDER,y,x,LESS), GOES_WITH(D23_ORDER,y,z,LESS) THEN GOES_WITH(D23_G,w,b);
law D23_G_C := IF GOES_WITH(D23_FACE_DISTANCE,w,a,b,c,x,y,z), GOES_WITH(D23_ORDER,z,x,LESS), GOES_WITH(D23_ORDER,z,y,LESS) THEN GOES_WITH(D23_G,w,c);
law D23_MIN_TIE_AB := IF GOES_WITH(D23_FACE_DISTANCE,w,a,b,c,x,x,z), GOES_WITH(D23_ORDER,x,z,LESS) THEN THIS(D23_G_MAYBE,w);
law D23_MIN_TIE_AC := IF GOES_WITH(D23_FACE_DISTANCE,w,a,b,c,x,y,x), GOES_WITH(D23_ORDER,x,y,LESS) THEN THIS(D23_G_MAYBE,w);
law D23_MIN_TIE_BC := IF GOES_WITH(D23_FACE_DISTANCE,w,a,b,c,x,y,y), GOES_WITH(D23_ORDER,y,x,LESS) THEN THIS(D23_G_MAYBE,w);
law D23_MIN_TIE_ALL := IF GOES_WITH(D23_FACE_DISTANCE,w,a,b,c,x,x,x) THEN THIS(D23_G_MAYBE,w);
law D23_UPPER_TIE_A := IF GOES_WITH(D23_FACE_DISTANCE,w,a,b,c,x,y,y), GOES_WITH(D23_ORDER,x,y,LESS) THEN THIS(D23_UPPER_TIE,w);
law D23_UPPER_TIE_B := IF GOES_WITH(D23_FACE_DISTANCE,w,a,b,c,x,y,x), GOES_WITH(D23_ORDER,y,x,LESS) THEN THIS(D23_UPPER_TIE,w);
law D23_UPPER_TIE_C := IF GOES_WITH(D23_FACE_DISTANCE,w,a,b,c,x,x,z), GOES_WITH(D23_ORDER,z,x,LESS) THEN THIS(D23_UPPER_TIE,w);
law D23_RANKS_DISTINCT := IF GOES_WITH(D23_FACE_MEMBER,w,a,x), GOES_WITH(D23_FACE_MEMBER,w,b,y), GOES_WITH(D23_FACE_MEMBER,w,c,z), GOES_WITH(D23_ORDER,x,y,LESS), GOES_WITH(D23_ORDER,y,z,LESS)
 THEN GOES_WITH(D23_RANKING,w,a,b,c);
law D23_MIN_RANK := IF GOES_WITH(D23_G,w,a) THEN GOES_WITH(D23_RANK,w,a,RANK_ONE);
law D23_MIDDLE_RANK := IF GOES_WITH(D23_RANKING,w,a,b,c) THEN GOES_WITH(D23_RANK,w,b,RANK_TWO);
law D23_MAX_A := IF GOES_WITH(D23_FACE_DISTANCE,w,a,b,c,x,y,z), GOES_WITH(D23_ORDER,x,y,MORE), GOES_WITH(D23_ORDER,x,z,MORE) THEN GOES_WITH(D23_RANK,w,a,RANK_THREE);
law D23_MAX_B := IF GOES_WITH(D23_FACE_DISTANCE,w,a,b,c,x,y,z), GOES_WITH(D23_ORDER,y,x,MORE), GOES_WITH(D23_ORDER,y,z,MORE) THEN GOES_WITH(D23_RANK,w,b,RANK_THREE);
law D23_MAX_C := IF GOES_WITH(D23_FACE_DISTANCE,w,a,b,c,x,y,z), GOES_WITH(D23_ORDER,z,x,MORE), GOES_WITH(D23_ORDER,z,y,MORE) THEN GOES_WITH(D23_RANK,w,c,RANK_THREE);
law D23_ROLE := IF GOES_WITH(D23_RANK,w,s,r), GOES_WITH(SF_RANK_ROLE,r,d), GOES_WITH(WORLD_JUNCTION_SITE,s,j)
 THEN GOES_WITH(D23_ROLE,w,j,d);
law D23_OWN_TIE := IF GOES_WITH(D23_FACE_MEMBER,w,a,n), GOES_WITH(D23_FACE_MEMBER,w,b,n), GOES_WITH(DISTINCT_SITE,a,b), GOES_WITH(WORLD_JUNCTION_SITE,a,j)
 THEN GOES_WITH(D23_OWN_TIE,w,j,MAYBE);
law D23_RESULT_DISTINCT := IF GOES_WITH(D23_RANKING,w,a,b,c), GOES_WITH(D23_G,w,a), GOES_WITH(SITE_TEXT,a,ta), GOES_WITH(SITE_TEXT,b,tb), GOES_WITH(SITE_TEXT,c,tc)
 THEN GOES_WITH(D23_RESULT,w,ta,ARRAY(CONS(ta,CONS(tb,CONS(tc,NIL)))),"IF_THEN","IF_THEN");
law D23_RESULT_UPPER_TIE := IF THIS(D23_UPPER_TIE,w), GOES_WITH(D23_G,w,a), GOES_WITH(SITE_TEXT,a,ta)
 THEN GOES_WITH(D23_RESULT,w,ta,JSON_NULL,"IF_THEN","MAYBE");
law D23_RESULT_MIN_TIE := IF THIS(D23_G_MAYBE,w)
 THEN GOES_WITH(D23_RESULT,w,JSON_NULL,JSON_NULL,"MAYBE","MAYBE");
law D23_FACE_OBSERVATION := IF GOES_WITH(D23_FACE_DISTANCE,w,a,b,c,x,y,z), GOES_WITH(TRIAD_JSON,TOGETHER_ALONE(a,b,c),face), GOES_WITH(D23_COUNT_LIST,x,lx), GOES_WITH(D23_COUNT_LIST,y,ly), GOES_WITH(D23_COUNT_LIST,z,lz)
 THEN GOES_WITH(D23_FACE_OBSERVATION,w,face,ARRAY(CONS(ARRAY(lx),CONS(ARRAY(ly),CONS(ARRAY(lz),NIL)))));
law D23_FACE_ROW := IF GOES_WITH(D23_FACE_OBSERVATION,w,face,distances), GOES_WITH(D23_RESULT,w,g,ranks,gv,sv)
 THEN THIS(OBSERVATION_ROW,STEP_023_FACE_READOUT,OBJECT(CONS(MEMBER("face",face),CONS(MEMBER("distances",distances),CONS(MEMBER("G",g),CONS(MEMBER("G_verdict",gv),CONS(MEMBER("ranks",ranks),CONS(MEMBER("S_F_verdict",sv),NIL))))))));


@readonly input J23_IMPORT_SVC05 := "svc05:";
law J23_IMPORT_SVC05 := IF THIS(J23_IMPORT_SVC05,ARRAY(rows)) THEN THIS(J23_SERVICE_ROWS,rows);


@readonly input J23_IMPORT_SVC06 := "svc06:";
law J23_IMPORT_SVC06 := IF THIS(J23_IMPORT_SVC06,ARRAY(rows)) THEN THIS(J23_SERVICE_ROWS,rows);


@readonly input J23_IMPORT_SVC07 := "svc07:";
law J23_IMPORT_SVC07 := IF THIS(J23_IMPORT_SVC07,ARRAY(rows)) THEN THIS(J23_SERVICE_ROWS,rows);


@readonly input J23_IMPORT_SVC08 := "svc08:";
law J23_IMPORT_SVC08 := IF THIS(J23_IMPORT_SVC08,ARRAY(rows)) THEN THIS(J23_SERVICE_ROWS,rows);


@readonly input J23_IMPORT_SVC09 := "svc09:";
law J23_IMPORT_SVC09 := IF THIS(J23_IMPORT_SVC09,ARRAY(rows)) THEN THIS(J23_SERVICE_ROWS,rows);


@readonly input J23_IMPORT_SVC10 := "svc10:";
law J23_IMPORT_SVC10 := IF THIS(J23_IMPORT_SVC10,ARRAY(rows)) THEN THIS(J23_SERVICE_ROWS,rows);


@readonly input J23_IMPORT_SVC11 := "svc11:";
law J23_IMPORT_SVC11 := IF THIS(J23_IMPORT_SVC11,ARRAY(rows)) THEN THIS(J23_SERVICE_ROWS,rows);

