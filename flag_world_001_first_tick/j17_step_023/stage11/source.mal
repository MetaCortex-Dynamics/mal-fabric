 GOES_WITH(HARDWARE_EDGE,J_23,HW_07,HW_08),
 GOES_WITH(BASE_EDGE,HW_07,HW_11),
 GOES_WITH(HARDWARE_EDGE,J_24,HW_07,HW_11),
