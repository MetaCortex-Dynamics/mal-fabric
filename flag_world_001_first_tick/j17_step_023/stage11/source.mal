 GOES_WITH(HEADER_JUNCTION,"1003050408",J_16),
 GOES_WITH(HEADER_JUNCTION,"1100030409",J_17),
 GOES_WITH(HEADER_JUNCTION,"1200040509",J_18),
 GOES_WITH(HEADER_JUNCTION,"130004050A",J_19),
 GOES_WITH(HEADER_JUNCTION,"1400020607",J_20),
 GOES_WITH(HEADER_JUNCTION,"150506060A",J_21),
 GOES_WITH(HEADER_JUNCTION,"160206060B",J_22),
 GOES_WITH(HEADER_JUNCTION,"1700050708",J_23),
 GOES_WITH(HEADER_JUNCTION,"180205070B",J_24),
 GOES_WITH(HEADER_JUNCTION,"1901030809",J_25),
 GOES_WITH(HEADER_JUNCTION,"1A0105080B",J_26),
 GOES_WITH(HEADER_JUNCTION,"1B0204090A",J_27),
 GOES_WITH(HEADER_JUNCTION,"1C0102090B",J_28),
 GOES_WITH(HEADER_JUNCTION,"1D02060A0B",J_29)
};
@readonly input FRAME_DIGEST := "frame:/sha256";
@readonly input FRAME_SIZE := "frame:/size";
@readonly input FRAME_MAGIC := "frame:/fields/magic";
@readonly input FRAME_VERSION := "frame:/fields/version";
@readonly input FRAME_KIND := "frame:/fields/kind";
@readonly input FRAME_PHASE := "frame:/fields/phase";
@readonly input FRAME_HEADER_BYTES := "frame:/fields/header_bytes";
@readonly input FRAME_PAYLOAD_BYTES := "frame:/fields/payload_bytes";
@readonly input FRAME_CRC := "frame:/fields/crc32";
@readonly input FRAME_COMPUTED_CRC := "frame:/checks/frame_crc32";
@readonly input FRAME_MACHINE := "frame:/fields/machine_id";
@readonly input FRAME_TRANSITION := "frame:/fields/transition_id";
@readonly input FRAME_JUNCTION := "frame:/fields/junction_signature";
@readonly input CAPTURE_RESPONSE_DIGEST := "capture:/k0c_response/sha256";
@readonly input CAPTURE_FIRST_TRANSITION := "capture:/first_jtp_transition";
@readonly input CAPTURE_TERMINAL := "capture:/terminal_disposition";

// Compare the complete recorded string by interned term identity. This retains
// all bytes without recursively matching a long UTF-8 list on the carrier.
@propose seed CAPTURE_TERMINAL_BYTES := {
 THIS(RECORDED_CLOSURE_TERMINAL,"FIRST_JTP_TRANSITION_CLOSED_OPERATOR_NATIVE_COMPOSITE_ADMITTED")
};

// This bounded transport grammar reads the retained reply. It does not re-run
// Tang admission, produce a new hardware verdict, or inspect payload values.
law FRAME_GRAMMAR := IF THIS(FRAME_MAGIC,"4A545031"), THIS(FRAME_VERSION,"01"), THIS(FRAME_KIND,"03"), THIS(FRAME_PHASE,"03"), THIS(FRAME_SIZE,JSON_INTEGER("132")), THIS(FRAME_HEADER_BYTES,"0050"), THIS(FRAME_PAYLOAD_BYTES,"0030")
 THEN THIS(PERSISTENCE_REPLY_GRAMMAR,IF_THEN);
law FRAME_INTEGRITY := IF THIS(PERSISTENCE_REPLY_GRAMMAR,IF_THEN), THIS(FRAME_CRC,c), THIS(FRAME_COMPUTED_CRC,c), THIS(FRAME_DIGEST,h)
 THEN THIS(ARCHIVED_FRAME_CUSTODY,h);
law HEADER_TO_JUNCTION := IF THIS(ARCHIVED_FRAME_CUSTODY,h), THIS(FRAME_JUNCTION,s), GOES_WITH(HEADER_JUNCTION,s,j), THIS(FRAME_MACHINE,m), THIS(FRAME_TRANSITION,t)
 THEN GOES_WITH(ARCHIVED_JTP_LOCUS,h,m,t,j);
law HEADER_TO_WORLD_SITE := IF GOES_WITH(ARCHIVED_JTP_LOCUS,h,m,t,j), GOES_WITH(WORLD_JUNCTION_SITE,s,j)
 THEN GOES_WITH(ARCHIVED_JTP_SITE,h,m,t,j,s);
law SITE_SUPPORT := IF GOES_WITH(ARCHIVED_JTP_SITE,h,m,t,j,s), THIS(FLAG,TOGETHER_ALONE(s,e,u))
 THEN GOES_WITH(ARCHIVED_LOCUS_FLAG_SUPPORT,h,TOGETHER_ALONE(s,e,u));

// Preserve the positive canon receipt as recorded. Physical macro-transition
// closure is not silently renamed a retained, worldline-appended JTPClosureV1.
law PHYSICAL_CLOSURE_RECEIPT := IF GOES_WITH(ARCHIVED_JTP_SITE,h,m,t,j,s), THIS(CAPTURE_RESPONSE_DIGEST,h), THIS(CAPTURE_FIRST_TRANSITION,"CLOSED_LED_WITNESSED"), THIS(CAPTURE_TERMINAL,c), THIS(RECORDED_CLOSURE_TERMINAL,c)
 THEN GOES_WITH(ARCHIVED_PHYSICAL_CLOSED_LOCUS,h,m,t,j,s);

// No CURRENT_FIELD, genesis record, G readout, or commit is emitted here.
// A support set is not a field. The requested first worldline closure must be
// carried with its append/predecessor evidence before using it as that operand.


// EXECUTE DECISION_RECORD_GPU_SELF_WITNESS_001, promoted 2CBBA4AD...BCE7.
// The captured header supplies the site; its payload supplies no address.
// The hardware-lane append is not a game-world gate. Original 017 is preserved.
// Complete NO/THIS field: exactly the site support bound in that decision.
law EVENT_SITE := IF GOES_WITH(ARCHIVED_PHYSICAL_CLOSED_LOCUS,h,m,t,j,s)
 THEN GOES_WITH(GENESIS_EVENT,h,m,t,j,s);
law CURRENT_THIS := IF GOES_WITH(GENESIS_EVENT,h,m,t,j,s), THIS(FLAG,TOGETHER_ALONE(s,e,u))
 THEN GOES_WITH(CURRENT_FIELD,TOGETHER_ALONE(s,e,u),THIS);
// The symmetric closure of the retained observation order witnesses inequality
// only. Reversing that encoding order leaves every resulting reading SAME.
// No first/minimal identifier, direction or face is selected.
law SITE_DIFFER_FORWARD := IF GOES_WITH(SITE_ORDER,a,b)
 THEN GOES_WITH(DISTINCT_SITE,a,b);
law SITE_DIFFER_REVERSE := IF GOES_WITH(SITE_ORDER,a,b)
 THEN GOES_WITH(DISTINCT_SITE,b,a);
law CURRENT_NO := IF GOES_WITH(GENESIS_EVENT,h,m,t,j,s), THIS(FLAG,TOGETHER_ALONE(v,e,u)), GOES_WITH(DISTINCT_SITE,v,s)
 THEN GOES_WITH(CURRENT_FIELD,TOGETHER_ALONE(v,e,u),NO);
@propose seed MARKER_BYTES := {
 GOES_WITH(MARKER_TEXT,THIS,"THIS"), GOES_WITH(MARKER_TEXT,NO,"NO"),
 GOES_WITH(AGREEMENT_TEXT,SAME,"SAME"), GOES_WITH(AGREEMENT_TEXT,NOT_SAME,"NOT_SAME")
};
law FIELD_ROW := IF GOES_WITH(CURRENT_FIELD,f,r), GOES_WITH(FLAG_JSON,f,j), GOES_WITH(MARKER_TEXT,r,text)
 THEN THIS(OBSERVATION_ROW,CURRENT_FIELD,ARRAY(CONS(j,CONS(text,NIL))));

// A4: gluing compares both flags of each canonical overlap in one snapshot.
// Walls are records, not refusal of the self-witnessed genesis pair.
law GLUE_SAME := IF GOES_WITH(PAIR,f,g), GOES_WITH(CURRENT_FIELD,f,r), GOES_WITH(CURRENT_FIELD,g,r)
 THEN GOES_WITH(CURRENT_GLUING,f,g,SAME);
law GLUE_THIS_NO := IF GOES_WITH(PAIR,f,g), GOES_WITH(CURRENT_FIELD,f,THIS), GOES_WITH(CURRENT_FIELD,g,NO)
 THEN GOES_WITH(CURRENT_GLUING,f,g,NOT_SAME);
law GLUE_NO_THIS := IF GOES_WITH(PAIR,f,g), GOES_WITH(CURRENT_FIELD,f,NO), GOES_WITH(CURRENT_FIELD,g,THIS)
 THEN GOES_WITH(CURRENT_GLUING,f,g,NOT_SAME);
law PREDECESSOR_GLUING := IF GOES_WITH(PAIR,f,g), GOES_WITH(ARCHIVED_PREDECESSOR_FIELD,GROUND_0_012,f,r), GOES_WITH(ARCHIVED_PREDECESSOR_FIELD,GROUND_0_012,g,r)
 THEN GOES_WITH(PREDECESSOR_GLUING,f,g,SAME);
law WITNESS_ROW := IF GOES_WITH(CURRENT_GLUING,f,g,r), GOES_WITH(FLAG_JSON,f,a), GOES_WITH(FLAG_JSON,g,b), GOES_WITH(AGREEMENT_TEXT,r,text)
 THEN THIS(OBSERVATION_ROW,CURRENT_WITNESS,ARRAY(CONS(a,CONS(b,CONS(text,NIL)))));
law WALL := IF GOES_WITH(CURRENT_GLUING,f,g,NOT_SAME)
 THEN GOES_WITH(CURRENT_WALL,f,g);

// Receipt is the change of agreement against the archived field, not OCC.
law RECEIPT_UNCHANGED := IF GOES_WITH(PREDECESSOR_GLUING,f,g,SAME), GOES_WITH(CURRENT_GLUING,f,g,SAME)
 THEN GOES_WITH(GENESIS_RECEIPT_PAIR,f,g,"UNCHANGED");
law RECEIPT_OPENED := IF GOES_WITH(PREDECESSOR_GLUING,f,g,SAME), GOES_WITH(CURRENT_GLUING,f,g,NOT_SAME)
 THEN GOES_WITH(GENESIS_RECEIPT_PAIR,f,g,"OPENED");
law RECEIPT_DISCHARGED := IF GOES_WITH(PREDECESSOR_GLUING,f,g,NOT_SAME), GOES_WITH(CURRENT_GLUING,f,g,SAME)
 THEN GOES_WITH(GENESIS_RECEIPT_PAIR,f,g,"DISCHARGED");
law RECEIPT_RETAINED := IF GOES_WITH(PREDECESSOR_GLUING,f,g,NOT_SAME), GOES_WITH(CURRENT_GLUING,f,g,NOT_SAME)
 THEN GOES_WITH(GENESIS_RECEIPT_PAIR,f,g,"RETAINED");
law RECEIPT_ROW := IF GOES_WITH(GENESIS_RECEIPT_PAIR,f,g,r), GOES_WITH(FLAG_JSON,f,a), GOES_WITH(FLAG_JSON,g,b)
 THEN THIS(OBSERVATION_ROW,CURRENT_RECEIPT,ARRAY(CONS(a,CONS(b,CONS(r,NIL)))));
law RECEIPT_CONTENT := IF GOES_WITH(GENESIS_RECEIPT_PAIR,f,g,"OPENED")
 THEN THIS(GENESIS_RECEIPT_READING,"THIS");
law RECEIPT_CONTENT_DISCHARGED := IF GOES_WITH(GENESIS_RECEIPT_PAIR,f,g,"DISCHARGED")
 THEN THIS(GENESIS_RECEIPT_READING,"THIS");


// EXECUTE promoted DECISION_RECORD_GPU_SELF_WITNESS_001 2CBBA4AD...BCE7.
// GPU-owned composition and publication. Host JSON is observation transport only.
// The row arrays are accepted only against source-produced rows, strict distinct
// keys and the complete 012 cardinalities. Encoding order selects no world value.
// Hardware-lane append, kappa, S/F, placement and STEP_FABRIC are not genesis gates.
@readonly input GSC_FIELD_INPUT := "field:";
@readonly input GSC_WITNESS_INPUT := "witness:";
@readonly input GSC_HASH_INPUT := "hashes:";
@readonly input GSC_LINK_INPUT := "links:";

law GSC_FIELD_ROWS := IF THIS(GSC_FIELD_INPUT,ARRAY(xs)) THEN GOES_WITH(GSC_ROWS,CURRENT_FIELD,xs);
law GSC_WITNESS_ROWS := IF THIS(GSC_WITNESS_INPUT,ARRAY(xs)) THEN GOES_WITH(GSC_ROWS,CURRENT_WITNESS,xs);
law GSC_GROUND_ROWS := IF THIS(GSC_GROUND_INPUT,ARRAY(xs)) THEN GOES_WITH(GSC_ROWS,GROUND_0_012,xs);
law GSC_ROWS_TAIL := IF GOES_WITH(GSC_ROWS,k,CONS(row,tail)) THEN GOES_WITH(GSC_ROWS,k,tail);
law GSC_ROWS_BLOCK := IF GOES_WITH(GSC_ROWS,k,CONS(a,CONS(b,CONS(c,CONS(d,CONS(e,CONS(f,CONS(g,CONS(h,tail)))))))))
 THEN GOES_WITH(GSC_ROWS,k,tail);

@propose seed GSC_ROW_CLASSES := {
 THIS(GSC_FIELD_KIND,CURRENT_FIELD), THIS(GSC_FIELD_KIND,GROUND_0_012),
 THIS(GSC_PAIR_KIND,CURRENT_WITNESS)
};
law GSC_FIELD_KEY := IF THIS(GSC_FIELD_KIND,k), THIS(OBSERVATION_ROW,k,ARRAY(CONS(j,CONS(r,NIL)))), GOES_WITH(FLAG_JSON,f,j)
 THEN GOES_WITH(GSC_ROW_KEY,k,ARRAY(CONS(j,CONS(r,NIL))),f);
law GSC_PAIR_KEY := IF THIS(GSC_PAIR_KIND,k), THIS(OBSERVATION_ROW,k,ARRAY(CONS(a,CONS(b,CONS(r,NIL))))), GOES_WITH(FLAG_JSON,f,a), GOES_WITH(FLAG_JSON,g,b)
 THEN GOES_WITH(GSC_ROW_KEY,k,ARRAY(CONS(a,CONS(b,CONS(r,NIL)))),TOGETHER_ALONE(f,g));
law GSC_ORDER_REQUEST := IF GOES_WITH(GSC_ROWS,k,CONS(a,CONS(b,tail))), GOES_WITH(GSC_ROW_KEY,k,a,x), GOES_WITH(GSC_ROW_KEY,k,b,y)
 THEN THIS(GSC_ORDER_REQUEST,x,y);
// This is the retained structural observation order, not numeric identifier order.
law GSC_ORDER_SITE := IF THIS(GSC_ORDER_REQUEST,a,b), GOES_WITH(SITE_ORDER,a,b)
 THEN GOES_WITH(GSC_ORDERED,a,b);
law GSC_ORDER_PAIR_REQUEST_A := IF THIS(GSC_ORDER_REQUEST,TOGETHER_ALONE(a,b),TOGETHER_ALONE(c,d))
 THEN THIS(GSC_ORDER_REQUEST,a,c);
law GSC_ORDER_PAIR_REQUEST_B := IF THIS(GSC_ORDER_REQUEST,TOGETHER_ALONE(a,b),TOGETHER_ALONE(a,d))
 THEN THIS(GSC_ORDER_REQUEST,b,d);
law GSC_ORDER_PAIR_A := IF THIS(GSC_ORDER_REQUEST,TOGETHER_ALONE(a,b),TOGETHER_ALONE(c,d)), GOES_WITH(GSC_ORDERED,a,c)
 THEN GOES_WITH(GSC_ORDERED,TOGETHER_ALONE(a,b),TOGETHER_ALONE(c,d));
law GSC_ORDER_PAIR_B := IF THIS(GSC_ORDER_REQUEST,TOGETHER_ALONE(a,b),TOGETHER_ALONE(a,d)), GOES_WITH(GSC_ORDERED,b,d)
 THEN GOES_WITH(GSC_ORDERED,TOGETHER_ALONE(a,b),TOGETHER_ALONE(a,d));
law GSC_ORDER_TRIPLE_REQUEST_A := IF THIS(GSC_ORDER_REQUEST,TOGETHER_ALONE(a,b,c),TOGETHER_ALONE(d,e,f))
 THEN THIS(GSC_ORDER_REQUEST,a,d);
law GSC_ORDER_TRIPLE_REQUEST_B := IF THIS(GSC_ORDER_REQUEST,TOGETHER_ALONE(a,b,c),TOGETHER_ALONE(a,e,f))
 THEN THIS(GSC_ORDER_REQUEST,b,e);
law GSC_ORDER_TRIPLE_REQUEST_C := IF THIS(GSC_ORDER_REQUEST,TOGETHER_ALONE(a,b,c),TOGETHER_ALONE(a,b,f))
 THEN THIS(GSC_ORDER_REQUEST,c,f);
law GSC_ORDER_TRIPLE_A := IF THIS(GSC_ORDER_REQUEST,TOGETHER_ALONE(a,b,c),TOGETHER_ALONE(d,e,f)), GOES_WITH(GSC_ORDERED,a,d)
 THEN GOES_WITH(GSC_ORDERED,TOGETHER_ALONE(a,b,c),TOGETHER_ALONE(d,e,f));
law GSC_ORDER_TRIPLE_B := IF THIS(GSC_ORDER_REQUEST,TOGETHER_ALONE(a,b,c),TOGETHER_ALONE(a,e,f)), GOES_WITH(GSC_ORDERED,b,e)
 THEN GOES_WITH(GSC_ORDERED,TOGETHER_ALONE(a,b,c),TOGETHER_ALONE(a,e,f));
law GSC_ORDER_TRIPLE_C := IF THIS(GSC_ORDER_REQUEST,TOGETHER_ALONE(a,b,c),TOGETHER_ALONE(a,b,f)), GOES_WITH(GSC_ORDERED,c,f)
 THEN GOES_WITH(GSC_ORDERED,TOGETHER_ALONE(a,b,c),TOGETHER_ALONE(a,b,f));
law GSC_ORDERED_ROW := IF GOES_WITH(GSC_ROWS,k,CONS(a,CONS(b,tail))), GOES_WITH(GSC_ROW_KEY,k,a,x), GOES_WITH(GSC_ROW_KEY,k,b,y), GOES_WITH(GSC_ORDERED,x,y)
 THEN GOES_WITH(GSC_ROW_SPAN,k,ONE,CONS(a,CONS(b,tail)),CONS(b,tail));
law GSC_LAST_ROW := IF GOES_WITH(GSC_ROWS,k,CONS(a,NIL)), GOES_WITH(GSC_ROW_KEY,k,a,x)
 THEN GOES_WITH(GSC_ROW_SPAN,k,ONE,CONS(a,NIL),NIL);
@propose seed GSC_SPAN_LENGTHS := {
 GOES_WITH(GSC_SPAN_DOUBLE,ONE,TWO), GOES_WITH(GSC_SPAN_DOUBLE,TWO,FOUR),
 GOES_WITH(GSC_SPAN_DOUBLE,FOUR,EIGHT), GOES_WITH(GSC_SPAN_DOUBLE,EIGHT,SIXTEEN),
 GOES_WITH(GSC_SPAN_DOUBLE,SIXTEEN,THIRTY_TWO), GOES_WITH(GSC_SPAN_DOUBLE,THIRTY_TWO,SIXTY_FOUR),
 GOES_WITH(GSC_SPAN_DOUBLE,SIXTY_FOUR,ONE_TWENTY_EIGHT), GOES_WITH(GSC_SPAN_DOUBLE,ONE_TWENTY_EIGHT,TWO_FIFTY_SIX),
 GOES_WITH(GSC_SPAN_DOUBLE,TWO_FIFTY_SIX,FIVE_TWELVE)
};
law GSC_DOUBLE_ROWS := IF GOES_WITH(GSC_SPAN_DOUBLE,n,m), GOES_WITH(GSC_ROW_SPAN,k,n,a,b), GOES_WITH(GSC_ROW_SPAN,k,n,b,c)
 THEN GOES_WITH(GSC_ROW_SPAN,k,m,a,c);
// Complete cardinalities derive from the retained 012 carrier: 480 flags,
// 720 canonical overlap pairs. Distinct recognized keys plus exact length cover it.
law GSC_FIELD_COMPLETE := IF THIS(GSC_FIELD_KIND,k), GOES_WITH(GSC_ROWS,k,a), GOES_WITH(GSC_ROW_SPAN,k,TWO_FIFTY_SIX,a,b), GOES_WITH(GSC_ROW_SPAN,k,ONE_TWENTY_EIGHT,b,c), GOES_WITH(GSC_ROW_SPAN,k,SIXTY_FOUR,c,d), GOES_WITH(GSC_ROW_SPAN,k,THIRTY_TWO,d,NIL)
 THEN GOES_WITH(GSC_COMPLETE,k,ARRAY(a));
law GSC_PAIR_COMPLETE := IF THIS(GSC_PAIR_KIND,k), GOES_WITH(GSC_ROWS,k,a), GOES_WITH(GSC_ROW_SPAN,k,FIVE_TWELVE,a,b), GOES_WITH(GSC_ROW_SPAN,k,ONE_TWENTY_EIGHT,b,c), GOES_WITH(GSC_ROW_SPAN,k,SIXTY_FOUR,c,d), GOES_WITH(GSC_ROW_SPAN,k,SIXTEEN,d,NIL)
 THEN GOES_WITH(GSC_COMPLETE,k,ARRAY(a));

// Reconstruct the archived field from its source-produced NO rows, using the
// checked current-field sequence only as the observation enumeration. This drops
// a redundant imported copy; its complete GPU SHA must still be exactly B263....
// Current readings never supply the archived reading.
law GSC_GROUND_SEQUENCE_END := IF GOES_WITH(GSC_ROWS,CURRENT_FIELD,NIL)
 THEN GOES_WITH(GSC_GROUND_SEQUENCE,NIL,NIL);
law GSC_GROUND_SEQUENCE_ROW := IF GOES_WITH(GSC_ROWS,CURRENT_FIELD,CONS(row,tail)), GOES_WITH(GSC_ROW_KEY,CURRENT_FIELD,row,f), GOES_WITH(GSC_ROW_KEY,GROUND_0_012,ground,f), GOES_WITH(GSC_GROUND_SEQUENCE,tail,rest)
 THEN GOES_WITH(GSC_GROUND_SEQUENCE,CONS(row,tail),CONS(ground,rest));
law GSC_GROUND_SEQUENCE_COMPLETE := IF THIS(GSC_FIELD_INPUT,ARRAY(xs)), GOES_WITH(GSC_COMPLETE,CURRENT_FIELD,ARRAY(xs)), GOES_WITH(GSC_GROUND_SEQUENCE,xs,rows)
 THEN THIS(GSC_GROUND_INPUT,ARRAY(rows));

// FT receipt keeps discharged/opened only. Retained walls remain in WITNESS.
// This filter, its order, and the empty/content reading are all source laws.
// The already checked witness sequence enumerates every pair exactly once.
// Receipt status is read from the GPU's typed pair facts, not reimported from
// a redundant status array. No host filters or supplies a change verdict.
law GSC_CHANGE_ROW := IF GOES_WITH(GSC_ROW_SPAN,CURRENT_WITNESS,ONE,CONS(ARRAY(CONS(a,CONS(b,CONS(w,NIL)))),tail),tail), GOES_WITH(FLAG_JSON,f,a), GOES_WITH(FLAG_JSON,g,b), GOES_WITH(GENESIS_RECEIPT_PAIR,f,g,status)
 THEN GOES_WITH(GSC_CHANGE_ROW,CONS(ARRAY(CONS(a,CONS(b,CONS(w,NIL)))),tail),tail,ARRAY(CONS(a,CONS(b,NIL))),status);
law GSC_CHANGE_SKIP := IF GOES_WITH(GSC_CHANGE_ROW,start,tail,pair,"UNCHANGED")
 THEN GOES_WITH(GSC_CHANGE_SPAN,ONE,start,tail,CHANGE_LISTS(NIL,NIL));
law GSC_CHANGE_RETAINED := IF GOES_WITH(GSC_CHANGE_ROW,start,tail,pair,"RETAINED")
 THEN GOES_WITH(GSC_CHANGE_SPAN,ONE,start,tail,CHANGE_LISTS(NIL,NIL));
law GSC_CHANGE_OPENED := IF GOES_WITH(GSC_CHANGE_ROW,start,tail,pair,"OPENED")
 THEN GOES_WITH(GSC_CHANGE_SPAN,ONE,start,tail,CHANGE_LISTS(NIL,CONS(pair,NIL)));
law GSC_CHANGE_DISCHARGED := IF GOES_WITH(GSC_CHANGE_ROW,start,tail,pair,"DISCHARGED")
 THEN GOES_WITH(GSC_CHANGE_SPAN,ONE,start,tail,CHANGE_LISTS(CONS(pair,NIL),NIL));
law GSC_JOIN_D := IF THIS(GSC_JOIN_REQUEST,CHANGE_LISTS(a,b),CHANGE_LISTS(c,d)) THEN THIS(GSC_APPEND_REQUEST,a,c);
law GSC_JOIN_O := IF THIS(GSC_JOIN_REQUEST,CHANGE_LISTS(a,b),CHANGE_LISTS(c,d)) THEN THIS(GSC_APPEND_REQUEST,b,d);
law GSC_APPEND_END := IF THIS(GSC_APPEND_REQUEST,NIL,b) THEN GOES_WITH(GSC_APPEND,NIL,b,b);
law GSC_APPEND_TAIL := IF THIS(GSC_APPEND_REQUEST,CONS(a,t),b) THEN THIS(GSC_APPEND_REQUEST,t,b);
law GSC_APPEND_HEAD := IF THIS(GSC_APPEND_REQUEST,CONS(a,t),b), GOES_WITH(GSC_APPEND,t,b,c) THEN GOES_WITH(GSC_APPEND,CONS(a,t),b,CONS(a,c));
law GSC_JOIN_COMPLETE := IF THIS(GSC_JOIN_REQUEST,CHANGE_LISTS(a,b),CHANGE_LISTS(c,d)), GOES_WITH(GSC_APPEND,a,c,x), GOES_WITH(GSC_APPEND,b,d,y)
 THEN GOES_WITH(GSC_JOIN,CHANGE_LISTS(a,b),CHANGE_LISTS(c,d),CHANGE_LISTS(x,y));
law GSC_CHANGE_DOUBLE_REQUEST := IF GOES_WITH(GSC_SPAN_DOUBLE,n,m), GOES_WITH(GSC_CHANGE_SPAN,n,a,b,x), GOES_WITH(GSC_CHANGE_SPAN,n,b,c,y)
 THEN THIS(GSC_JOIN_REQUEST,x,y);
law GSC_CHANGE_DOUBLE := IF GOES_WITH(GSC_SPAN_DOUBLE,n,m), GOES_WITH(GSC_CHANGE_SPAN,n,a,b,x), GOES_WITH(GSC_CHANGE_SPAN,n,b,c,y), GOES_WITH(GSC_JOIN,x,y,z)
 THEN GOES_WITH(GSC_CHANGE_SPAN,m,a,c,z);
law GSC_CHANGE_PREFIX_REQUEST := IF THIS(GSC_WITNESS_INPUT,ARRAY(a)), GOES_WITH(GSC_CHANGE_SPAN,FIVE_TWELVE,a,b,x), GOES_WITH(GSC_CHANGE_SPAN,ONE_TWENTY_EIGHT,b,c,y)
 THEN THIS(GSC_JOIN_REQUEST,x,y);
law GSC_CHANGE_PREFIX := IF THIS(GSC_WITNESS_INPUT,ARRAY(a)), GOES_WITH(GSC_CHANGE_SPAN,FIVE_TWELVE,a,b,x), GOES_WITH(GSC_CHANGE_SPAN,ONE_TWENTY_EIGHT,b,c,y), GOES_WITH(GSC_JOIN,x,y,z)
 THEN GOES_WITH(GSC_CHANGE_PREFIX,c,z);
law GSC_CHANGE_SUFFIX_REQUEST := IF GOES_WITH(GSC_CHANGE_PREFIX,c,x), GOES_WITH(GSC_CHANGE_SPAN,SIXTY_FOUR,c,d,y), GOES_WITH(GSC_CHANGE_SPAN,SIXTEEN,d,NIL,z)
 THEN THIS(GSC_JOIN_REQUEST,y,z);
law GSC_CHANGE_SUFFIX := IF GOES_WITH(GSC_CHANGE_PREFIX,c,x), GOES_WITH(GSC_CHANGE_SPAN,SIXTY_FOUR,c,d,y), GOES_WITH(GSC_CHANGE_SPAN,SIXTEEN,d,NIL,z), GOES_WITH(GSC_JOIN,y,z,s)
 THEN GOES_WITH(GSC_CHANGE_PARTS,x,s);
law GSC_CHANGE_FINAL_REQUEST := IF GOES_WITH(GSC_CHANGE_PARTS,a,b) THEN THIS(GSC_JOIN_REQUEST,a,b);
law GSC_CHANGE_FINAL := IF GOES_WITH(GSC_CHANGE_PARTS,a,b), GOES_WITH(GSC_JOIN,a,b,c), THIS(GSC_WITNESS_INPUT,rows), GOES_WITH(GSC_COMPLETE,CURRENT_WITNESS,rows)
 THEN THIS(GSC_CHANGE_LISTS,c);
law GSC_RECEIPT_OBJECT := IF THIS(GSC_CHANGE_LISTS,CHANGE_LISTS(d,o))
 THEN THIS(GSC_RECEIPT_OBJECT,OBJECT(CONS(MEMBER("discharged",ARRAY(d)),CONS(MEMBER("opened",ARRAY(o)),NIL))));
law GSC_RECEIPT_EMPTY := IF THIS(GSC_CHANGE_LISTS,CHANGE_LISTS(NIL,NIL)) THEN THIS(GSC_RECEIPT_READING,"NO");
law GSC_RECEIPT_HAS_OPENED := IF THIS(GSC_CHANGE_LISTS,CHANGE_LISTS(d,CONS(a,t))) THEN THIS(GSC_RECEIPT_READING,"THIS");
law GSC_RECEIPT_HAS_DISCHARGED := IF THIS(GSC_CHANGE_LISTS,CHANGE_LISTS(CONS(a,t),o)) THEN THIS(GSC_RECEIPT_READING,"THIS");

// Source-owned complete subjects. Hashing is a generic GPU substrate primitive.
law GSC_GROUND_HASH_REQUEST := IF THIS(GSC_GROUND_INPUT,g), GOES_WITH(GSC_COMPLETE,GROUND_0_012,g)
 THEN THIS(HASH_JSON_REQUEST,GROUND_PREDECESSOR,g);
law GSC_PAIR_OBJECT := IF THIS(GSC_FIELD_INPUT,f), GOES_WITH(GSC_COMPLETE,CURRENT_FIELD,f), THIS(GSC_WITNESS_INPUT,w), GOES_WITH(GSC_COMPLETE,CURRENT_WITNESS,w)
 THEN THIS(GSC_PAIR_OBJECT,OBJECT(CONS(MEMBER("field",f),CONS(MEMBER("witness",w),NIL))));
law GSC_PAIR_HASH_REQUEST := IF THIS(GSC_PAIR_OBJECT,p) THEN THIS(HASH_JSON_REQUEST,GENESIS_PAIR,p);
law GSC_RECEIPT_HASH_REQUEST := IF THIS(GSC_RECEIPT_OBJECT,r) THEN THIS(HASH_JSON_REQUEST,GENESIS_RECEIPT,r);
// Empty objects are accepted as no hash responses, never as positive witnesses.
law GSC_HASH_ROWS := IF THIS(GSC_HASH_INPUT,OBJECT(xs)) THEN THIS(GSC_HASH_ROWS,xs);
law GSC_LINK_ROWS := IF THIS(GSC_LINK_INPUT,OBJECT(xs)) THEN THIS(GSC_HASH_ROWS,xs);
law GSC_HASH_TAIL := IF THIS(GSC_HASH_ROWS,CONS(a,t)) THEN THIS(GSC_HASH_ROWS,t);
law GSC_HASH_RESPONSE := IF THIS(GSC_HASH_ROWS,CONS(MEMBER(id,OBJECT(CONS(MEMBER("digest",h),CONS(MEMBER("value",v),NIL)))),tail))
 THEN GOES_WITH(GSC_HASH_RESPONSE,id,h,v);
@propose seed GSC_BOUND_PREDECESSOR := {
 THIS(GSC_EXPECTED_PREDECESSOR_HASH,"b263644e59a696999c02dfd25386a5abefdb2d0fc4317a0fe2cccd90502ebad3")
};
law GSC_GROUND_HASH_BOUND := IF GOES_WITH(GSC_HASH_RESPONSE,"GROUND_PREDECESSOR",h,g), THIS(GSC_EXPECTED_PREDECESSOR_HASH,h), THIS(GSC_GROUND_INPUT,g), GOES_WITH(GSC_COMPLETE,GROUND_0_012,g)
 THEN THIS(GSC_PREDECESSOR_HASH,h);
law GSC_PAIR_HASH_BOUND := IF GOES_WITH(GSC_HASH_RESPONSE,"GENESIS_PAIR",h,p), THIS(GSC_PAIR_OBJECT,p)
 THEN GOES_WITH(GSC_PAIR_HASH,p,h);
law GSC_RECEIPT_HASH_BOUND := IF GOES_WITH(GSC_HASH_RESPONSE,"GENESIS_RECEIPT",h,r), THIS(GSC_RECEIPT_OBJECT,r)
 THEN GOES_WITH(GSC_RECEIPT_HASH,r,h);
law GSC_RECORD_PARTS := IF GOES_WITH(GSC_PAIR_HASH,OBJECT(CONS(MEMBER("field",f),CONS(MEMBER("witness",w),NIL))),p), GOES_WITH(GSC_RECEIPT_HASH,r,q), THIS(GSC_PREDECESSOR_HASH,g), THIS(GSC_RECEIPT_READING,s), GOES_WITH(GENESIS_EVENT,h,m,t,j,site)
 THEN THIS(GSC_RECORD_PARTS,PARTS(f,w,r,p,q,g,s,h));
law GSC_LINK_RECORD := IF THIS(GSC_RECORD_PARTS,PARTS(f,w,r,p,q,g,s,h))
 THEN THIS(GSC_LINK_RECORD,OBJECT(CONS(MEMBER("event_record",h),CONS(MEMBER("field",f),CONS(MEMBER("kind","GENESIS"),CONS(MEMBER("pair_hash",p),CONS(MEMBER("prev",g),CONS(MEMBER("receipt",r),CONS(MEMBER("receipt_hash",q),CONS(MEMBER("receipt_reading",s),CONS(MEMBER("witness",w),NIL)))))))))));
law GSC_LINK_HASH_REQUEST := IF THIS(GSC_LINK_RECORD,r) THEN THIS(HASH_JSON_REQUEST,GENESIS_LINK,r);
law GSC_LINK_HASH_BOUND := IF GOES_WITH(GSC_HASH_RESPONSE,"GENESIS_LINK",h,r), THIS(GSC_LINK_RECORD,r)
 THEN GOES_WITH(GSC_LINK_HASH,r,h);
// ONE chain entry. The GPU publishes field, witness, receipt and its linked record
// together; no host stage can supply a COMMITTED_GENESIS fact.
law GSC_CHAIN_ENTRY := IF GOES_WITH(GSC_LINK_HASH,r,h)
 THEN GOES_WITH(GSC_CHAIN_ENTRY,r,OBJECT(CONS(MEMBER("link",h),CONS(MEMBER("record",r),NIL))));
law GSC_COMMIT := IF GOES_WITH(GSC_CHAIN_ENTRY,record,e), THIS(GSC_RECORD_PARTS,PARTS(f,w,r,p,q,g,s,h)), THIS(GSC_LINK_RECORD,record), GOES_WITH(GSC_LINK_HASH,record,link)
 THEN THIS(COMMITTED_GENESIS,OBJECT(CONS(MEMBER("chain",ARRAY(CONS(e,NIL))),CONS(MEMBER("field",f),CONS(MEMBER("receipt",r),CONS(MEMBER("witness",w),NIL))))));


// APPLY order in promoted 2CBBA4AD...BCE7: genesis commit precedes d_G.
// This is a consequence of the GPU publication, never an imported verdict.
law READOUT_AFTER_GENESIS_COMMIT := IF THIS(COMMITTED_GENESIS,c)
 THEN THIS(READOUT_CURRENT_ADMITTED);

// EXECUTE the promoted readout 057C30E2...C05355 and metric 3419D528...0A8718.
// Current is admitted only after the source-owned GPU genesis commit.
// Every count compares ONE flag across current/predecessor, NOT two flags in one field.
// A flag's site belongs to its edge and its edge belongs to its triad. Therefore
// (site contains v OR edge contains v OR triad contains v) is exactly triad contains v.
// Each flag contributes once to that union. No additive incidence multiplicity.
// The committed complete field supplies enumeration only; it selects no world value.
// EMPTY_COUNT / NEXT_COUNT count EDIT witnesses, not identifiers or marker magnitudes.
@readonly input DG_FIELD_INPUT := "field:";

// Tail enumeration is transport custody, permitted before commit; no EDIT or d_G
// is produced by it. The first cross-snapshot comparison remains commit-gated.
law DG_ROWS_START := IF THIS(DG_FIELD_INPUT,ARRAY(rows))
 THEN THIS(DG_ROWS,rows);
law DG_ROWS_TAIL := IF THIS(DG_ROWS,CONS(row,tail))
 THEN THIS(DG_ROWS,tail);
law DG_FIELD_PAIR := IF THIS(READOUT_CURRENT_ADMITTED), THIS(DG_ROWS,CONS(ARRAY(CONS(json,CONS(text,NIL))),tail)), GOES_WITH(FLAG_JSON,f,json), GOES_WITH(CURRENT_FIELD,f,current), GOES_WITH(MARKER_TEXT,current,text), GOES_WITH(ARCHIVED_PREDECESSOR_FIELD,GROUND_0_012,f,prior)
 THEN GOES_WITH(DG_PAIR,f,current,prior);
law DG_READING_SAME := IF GOES_WITH(DG_PAIR,f,r,r)
 THEN GOES_WITH(DG_EDIT,f,NO_EDIT);
law DG_READING_THIS_NO := IF GOES_WITH(DG_PAIR,f,THIS,NO)
 THEN GOES_WITH(DG_EDIT,f,EDIT);
law DG_READING_NO_THIS := IF GOES_WITH(DG_PAIR,f,NO,THIS)
 THEN GOES_WITH(DG_EDIT,f,EDIT);

law DG_SUPPORT_A := IF THIS(READOUT_CURRENT_ADMITTED), GOES_WITH(WORLD_JUNCTION_SITE,a,j), THIS(TRIAD,TOGETHER_ALONE(a,b,c))
 THEN GOES_WITH(DG_SUPPORT_TRIAD,a,TOGETHER_ALONE(a,b,c));
law DG_SUPPORT_B := IF THIS(READOUT_CURRENT_ADMITTED), GOES_WITH(WORLD_JUNCTION_SITE,b,j), THIS(TRIAD,TOGETHER_ALONE(a,b,c))
 THEN GOES_WITH(DG_SUPPORT_TRIAD,b,TOGETHER_ALONE(a,b,c));
law DG_SUPPORT_C := IF THIS(READOUT_CURRENT_ADMITTED), GOES_WITH(WORLD_JUNCTION_SITE,c,j), THIS(TRIAD,TOGETHER_ALONE(a,b,c))
 THEN GOES_WITH(DG_SUPPORT_TRIAD,c,TOGETHER_ALONE(a,b,c));
law DG_MISS_TRIAD := IF THIS(READOUT_CURRENT_ADMITTED), GOES_WITH(WORLD_JUNCTION_SITE,s,j), THIS(TRIAD,TOGETHER_ALONE(a,b,c)), GOES_WITH(DISTINCT_SITE,s,a), GOES_WITH(DISTINCT_SITE,s,b), GOES_WITH(DISTINCT_SITE,s,c)
 THEN GOES_WITH(DG_MISS_TRIAD,s,TOGETHER_ALONE(a,b,c));
law DG_CONTRIBUTION_EDIT := IF GOES_WITH(DG_SUPPORT_TRIAD,s,t), GOES_WITH(DG_EDIT,TOGETHER_ALONE(v,e,t),EDIT)
 THEN GOES_WITH(DG_CONTRIBUTION,s,TOGETHER_ALONE(v,e,t),NEXT_COUNT(EMPTY_COUNT));
law DG_CONTRIBUTION_SAME := IF GOES_WITH(DG_SUPPORT_TRIAD,s,t), GOES_WITH(DG_EDIT,TOGETHER_ALONE(v,e,t),NO_EDIT)
 THEN GOES_WITH(DG_CONTRIBUTION,s,TOGETHER_ALONE(v,e,t),EMPTY_COUNT);
law DG_CONTRIBUTION_OUTSIDE := IF GOES_WITH(DG_MISS_TRIAD,s,t), GOES_WITH(DG_PAIR,TOGETHER_ALONE(v,e,t),current,prior)
 THEN GOES_WITH(DG_CONTRIBUTION,s,TOGETHER_ALONE(v,e,t),EMPTY_COUNT);

law DG_ACC_START := IF THIS(READOUT_CURRENT_ADMITTED), THIS(DG_FIELD_INPUT,ARRAY(rows)), GOES_WITH(WORLD_JUNCTION_SITE,s,j)
 THEN GOES_WITH(DG_ACC,s,rows,EMPTY_COUNT);
law DG_ACC_UNCHANGED := IF GOES_WITH(DG_ACC,s,CONS(ARRAY(CONS(json,CONS(text,NIL))),tail),n), GOES_WITH(FLAG_JSON,f,json), GOES_WITH(DG_CONTRIBUTION,s,f,EMPTY_COUNT)
 THEN GOES_WITH(DG_ACC,s,tail,n);
law DG_ACC_EDIT := IF GOES_WITH(DG_ACC,s,CONS(ARRAY(CONS(json,CONS(text,NIL))),tail),n), GOES_WITH(FLAG_JSON,f,json), GOES_WITH(DG_CONTRIBUTION,s,f,NEXT_COUNT(EMPTY_COUNT))
 THEN GOES_WITH(DG_ACC,s,tail,NEXT_COUNT(n));
law DG_ACC_DONE := IF GOES_WITH(DG_ACC,s,NIL,n)
 THEN GOES_WITH(DG_VALUE,s,n);

// JSON distance is an unweighted unary list of THIS, one entry per EDIT.
// A reader may observe its cardinality; no host value produces the list or the rank.
law DG_COUNT_REQUEST := IF GOES_WITH(DG_VALUE,s,n)
 THEN THIS(DG_COUNT_BYTES_REQUEST,n);
law DG_COUNT_DESCEND := IF THIS(DG_COUNT_BYTES_REQUEST,NEXT_COUNT(n))
 THEN THIS(DG_COUNT_BYTES_REQUEST,n);
law DG_COUNT_EMPTY := IF THIS(DG_COUNT_BYTES_REQUEST,EMPTY_COUNT)
 THEN GOES_WITH(DG_COUNT_LIST,EMPTY_COUNT,NIL);
law DG_COUNT_ASCEND := IF THIS(DG_COUNT_BYTES_REQUEST,NEXT_COUNT(n)), GOES_WITH(DG_COUNT_LIST,n,items)
 THEN GOES_WITH(DG_COUNT_LIST,NEXT_COUNT(n),CONS("THIS",items));
law DG_VALUE_ROW := IF GOES_WITH(DG_VALUE,s,n), GOES_WITH(SITE_TEXT,s,text), GOES_WITH(DG_COUNT_LIST,n,items)
 THEN THIS(OBSERVATION_ROW,DG_VALUES,ARRAY(CONS(text,CONS(ARRAY(items),NIL))));

// CCC faces are recognized by incidence: all three sites are hardware junctions.
// WORLD_TRIAD_FACE carries the recorded hardware parent, not a numbering substitution.
law DG_CCC_FACE := IF THIS(READOUT_CURRENT_ADMITTED), THIS(TRIAD,TOGETHER_ALONE(a,b,c)), GOES_WITH(WORLD_TRIAD_FACE,TOGETHER_ALONE(a,b,c),w), GOES_WITH(WORLD_JUNCTION_SITE,a,ja), GOES_WITH(WORLD_JUNCTION_SITE,b,jb), GOES_WITH(WORLD_JUNCTION_SITE,c,jc)
 THEN GOES_WITH(DG_FACE,w,a,b,c);
law DG_FACE_DISTANCES := IF GOES_WITH(DG_FACE,w,a,b,c), GOES_WITH(DG_VALUE,a,x), GOES_WITH(DG_VALUE,b,y), GOES_WITH(DG_VALUE,c,z)
 THEN GOES_WITH(DG_FACE_DISTANCE,w,a,b,c,x,y,z);
law DG_MEMBER_A := IF GOES_WITH(DG_FACE_DISTANCE,w,a,b,c,x,y,z)
 THEN GOES_WITH(DG_FACE_MEMBER,w,a,x);
law DG_MEMBER_B := IF GOES_WITH(DG_FACE_DISTANCE,w,a,b,c,x,y,z)
 THEN GOES_WITH(DG_FACE_MEMBER,w,b,y);
law DG_MEMBER_C := IF GOES_WITH(DG_FACE_DISTANCE,w,a,b,c,x,y,z)
 THEN GOES_WITH(DG_FACE_MEMBER,w,c,z);

// Compare counts only. No ordering of identifiers, tuple positions or spellings.
law DG_COMPARE_REQUEST := IF GOES_WITH(DG_FACE_MEMBER,w,a,x), GOES_WITH(DG_FACE_MEMBER,w,b,y)
 THEN THIS(DG_COMPARE_REQUEST,x,y);
law DG_COMPARE_DESCEND := IF THIS(DG_COMPARE_REQUEST,NEXT_COUNT(x),NEXT_COUNT(y))
 THEN THIS(DG_COMPARE_REQUEST,x,y);
law DG_COMPARE_EMPTY := IF THIS(DG_COMPARE_REQUEST,EMPTY_COUNT,EMPTY_COUNT)
 THEN GOES_WITH(DG_ORDER,EMPTY_COUNT,EMPTY_COUNT,SAME);
law DG_COMPARE_LESS := IF THIS(DG_COMPARE_REQUEST,EMPTY_COUNT,NEXT_COUNT(y))
 THEN GOES_WITH(DG_ORDER,EMPTY_COUNT,NEXT_COUNT(y),LESS);
law DG_COMPARE_MORE := IF THIS(DG_COMPARE_REQUEST,NEXT_COUNT(x),EMPTY_COUNT)
 THEN GOES_WITH(DG_ORDER,NEXT_COUNT(x),EMPTY_COUNT,MORE);
law DG_COMPARE_ASCEND := IF THIS(DG_COMPARE_REQUEST,NEXT_COUNT(x),NEXT_COUNT(y)), GOES_WITH(DG_ORDER,x,y,r)
 THEN GOES_WITH(DG_ORDER,NEXT_COUNT(x),NEXT_COUNT(y),r);

law DG_G_A := IF GOES_WITH(DG_FACE_DISTANCE,w,a,b,c,x,y,z), GOES_WITH(DG_ORDER,x,y,LESS), GOES_WITH(DG_ORDER,x,z,LESS)
 THEN GOES_WITH(DG_G,w,a);
law DG_G_B := IF GOES_WITH(DG_FACE_DISTANCE,w,a,b,c,x,y,z), GOES_WITH(DG_ORDER,y,x,LESS), GOES_WITH(DG_ORDER,y,z,LESS)
 THEN GOES_WITH(DG_G,w,b);
law DG_G_C := IF GOES_WITH(DG_FACE_DISTANCE,w,a,b,c,x,y,z), GOES_WITH(DG_ORDER,z,x,LESS), GOES_WITH(DG_ORDER,z,y,LESS)
 THEN GOES_WITH(DG_G,w,c);
law DG_MIN_TIE_AB := IF GOES_WITH(DG_FACE_DISTANCE,w,a,b,c,x,x,z), GOES_WITH(DG_ORDER,x,z,LESS)
 THEN THIS(DG_G_MAYBE,w);
law DG_MIN_TIE_AC := IF GOES_WITH(DG_FACE_DISTANCE,w,a,b,c,x,y,x), GOES_WITH(DG_ORDER,x,y,LESS)
 THEN THIS(DG_G_MAYBE,w);
law DG_MIN_TIE_BC := IF GOES_WITH(DG_FACE_DISTANCE,w,a,b,c,x,y,y), GOES_WITH(DG_ORDER,y,x,LESS)
 THEN THIS(DG_G_MAYBE,w);
law DG_MIN_TIE_ALL := IF GOES_WITH(DG_FACE_DISTANCE,w,a,b,c,x,x,x)
 THEN THIS(DG_G_MAYBE,w);
law DG_UPPER_TIE_A := IF GOES_WITH(DG_FACE_DISTANCE,w,a,b,c,x,y,y), GOES_WITH(DG_ORDER,x,y,LESS)
 THEN THIS(DG_UPPER_TIE,w);
law DG_UPPER_TIE_B := IF GOES_WITH(DG_FACE_DISTANCE,w,a,b,c,x,y,x), GOES_WITH(DG_ORDER,y,x,LESS)
 THEN THIS(DG_UPPER_TIE,w);
law DG_UPPER_TIE_C := IF GOES_WITH(DG_FACE_DISTANCE,w,a,b,c,x,x,z), GOES_WITH(DG_ORDER,z,x,LESS)
 THEN THIS(DG_UPPER_TIE,w);
law DG_RANKS_DISTINCT := IF GOES_WITH(DG_FACE_MEMBER,w,a,x), GOES_WITH(DG_FACE_MEMBER,w,b,y), GOES_WITH(DG_FACE_MEMBER,w,c,z), GOES_WITH(DG_ORDER,x,y,LESS), GOES_WITH(DG_ORDER,y,z,LESS)
 THEN GOES_WITH(DG_RANKING,w,a,b,c);

// Rank list is ascending d_G; no rank is named S or F by this realization.
// S_F_verdict reports whether two distinct remaining ranks were produced,
// not an assignment of either rank to a modality. The latter stays O_next.
law DG_RESULT_DISTINCT := IF GOES_WITH(DG_RANKING,w,a,b,c), GOES_WITH(DG_G,w,a), GOES_WITH(SITE_TEXT,a,ta), GOES_WITH(SITE_TEXT,b,tb), GOES_WITH(SITE_TEXT,c,tc)
 THEN GOES_WITH(DG_RESULT,w,ta,ARRAY(CONS(ta,CONS(tb,CONS(tc,NIL)))),"IF_THEN","IF_THEN");
law DG_RESULT_UPPER_TIE := IF THIS(DG_UPPER_TIE,w), GOES_WITH(DG_G,w,a), GOES_WITH(SITE_TEXT,a,ta)
 THEN GOES_WITH(DG_RESULT,w,ta,JSON_NULL,"IF_THEN","MAYBE");
law DG_RESULT_MIN_TIE := IF THIS(DG_G_MAYBE,w)
 THEN GOES_WITH(DG_RESULT,w,JSON_NULL,JSON_NULL,"MAYBE","MAYBE");
law DG_FACE_OBSERVATION := IF GOES_WITH(DG_FACE_DISTANCE,w,a,b,c,x,y,z), GOES_WITH(TRIAD_JSON,TOGETHER_ALONE(a,b,c),face), GOES_WITH(DG_COUNT_LIST,x,lx), GOES_WITH(DG_COUNT_LIST,y,ly), GOES_WITH(DG_COUNT_LIST,z,lz)
 THEN GOES_WITH(DG_FACE_OBSERVATION,w,face,ARRAY(CONS(ARRAY(lx),CONS(ARRAY(ly),CONS(ARRAY(lz),NIL)))));
law DG_FACE_ROW := IF GOES_WITH(DG_FACE_OBSERVATION,w,face,distances), GOES_WITH(DG_RESULT,w,g,ranks,gv,sv)
 THEN THIS(OBSERVATION_ROW,FACE_READOUT,OBJECT(CONS(MEMBER("face",face),CONS(MEMBER("distances",distances),CONS(MEMBER("G",g),CONS(MEMBER("G_verdict",gv),CONS(MEMBER("ranks",ranks),CONS(MEMBER("S_F_verdict",sv),NIL))))))));


// EXECUTE promoted DECISION_RECORD_S_F_BINDING_001, 276EBD71...A1983108.
// Retain all run018 distances and unique-minimum G readings.
// New partial-rank rule reads a unique maximum even when the other two tie.
// No identifier order or choice is used. NEXT_COUNT compares edit counts only.
law SF_MAX_A := IF GOES_WITH(DG_FACE_DISTANCE,w,a,b,c,x,y,z), GOES_WITH(DG_ORDER,x,y,MORE), GOES_WITH(DG_ORDER,x,z,MORE)
 THEN GOES_WITH(SF_RANK,w,a,RANK_THREE);
law SF_MAX_B := IF GOES_WITH(DG_FACE_DISTANCE,w,a,b,c,x,y,z), GOES_WITH(DG_ORDER,y,x,MORE), GOES_WITH(DG_ORDER,y,z,MORE)
 THEN GOES_WITH(SF_RANK,w,b,RANK_THREE);
law SF_MAX_C := IF GOES_WITH(DG_FACE_DISTANCE,w,a,b,c,x,y,z), GOES_WITH(DG_ORDER,z,x,MORE), GOES_WITH(DG_ORDER,z,y,MORE)
 THEN GOES_WITH(SF_RANK,w,c,RANK_THREE);
law SF_MIN := IF GOES_WITH(DG_G,w,a)
 THEN GOES_WITH(SF_RANK,w,a,RANK_ONE);
law SF_MIDDLE := IF GOES_WITH(DG_RANKING,w,a,b,c)
 THEN GOES_WITH(SF_RANK,w,b,RANK_TWO);
@propose seed SF_PROMOTED_BINDING := {
 GOES_WITH(SF_RANK_ROLE,RANK_ONE,G),
 GOES_WITH(SF_RANK_ROLE,RANK_TWO,F),
 GOES_WITH(SF_RANK_ROLE,RANK_THREE,S)
};
law SF_ROLE := IF GOES_WITH(SF_RANK,w,a,r), GOES_WITH(SF_RANK_ROLE,r,d), GOES_WITH(WORLD_JUNCTION_SITE,a,j)
 THEN GOES_WITH(SF_FACE_ROLE,w,j,d);
// Equal minima remain unresolved; neither junction receives G or F.
law SF_TIED_MEMBER := IF THIS(DG_G_MAYBE,w), GOES_WITH(DG_FACE_MEMBER,w,a,n), GOES_WITH(DG_FACE_MEMBER,w,b,n), GOES_WITH(DISTINCT_SITE,a,b), GOES_WITH(WORLD_JUNCTION_SITE,a,j)
 THEN GOES_WITH(SF_PLACEMENT_PENDING,w,j,MAYBE);

// The type/seating and per-overlap occurrence construction are retained from014.
@propose seed SF_AGREEMENT_TYPE := {
 GOES_WITH(SF_AGREEMENT_TYPE,TYPE(SAME_NOT_SAME,WHAT),J_17),
 GOES_WITH(SF_PORT,LEFT,EXACTLY_ONE),
 GOES_WITH(SF_PORT,RIGHT,EXACTLY_ONE),
 GOES_WITH(SF_CAPABILITY,SAME_NOT_SAME,G),
 GOES_WITH(SF_CAPABILITY,SAME_NOT_SAME,S)
};
law SF_COMPARATOR := IF GOES_WITH(PAIR,f,g), GOES_WITH(SF_AGREEMENT_TYPE,t,j)
 THEN GOES_WITH(SF_COMPARATOR,OCCURRENCE(t,OVERLAP(f,g)),f,g);
law SF_OCCURRENCE_SEATING := IF GOES_WITH(SF_COMPARATOR,c,f,g), GOES_WITH(SF_AGREEMENT_TYPE,t,j)
 THEN GOES_WITH(SF_OCCURRENCE_SEATING,c,j);
law SF_PLACEMENT := IF GOES_WITH(SF_COMPARATOR,c,f,g), GOES_WITH(SF_FACE_ROLE,W_12,J_17,S), GOES_WITH(SF_FACE_ROLE,W_13,J_17,S), GOES_WITH(SF_CAPABILITY,SAME_NOT_SAME,S)
 THEN GOES_WITH(SF_OCCURRENCE_PLACEMENT,c,LOCATION(INTERIOR(S),CONTAINMENT(FIRST_TICK,OVERLAP(f,g))));
law SF_ADMISSION := IF THIS(READOUT_CURRENT_ADMITTED), GOES_WITH(SF_COMPARATOR,c,f,g), GOES_WITH(SF_OCCURRENCE_PLACEMENT,c,location)
 THEN GOES_WITH(SF_OCCURRENCE_ADMITTED,c,ADMISSION(SF_BINDING_001,location));
law SF_CUSTODIED_FIELD := IF THIS(READOUT_CURRENT_ADMITTED), GOES_WITH(CURRENT_FIELD,f,r)
 THEN GOES_WITH(SF_SNAPSHOT_FIELD,GENESIS,f,r);
law SF_SNAPSHOT_FRAME := IF GOES_WITH(SF_COMPARATOR,c,f,g), GOES_WITH(SF_OCCURRENCE_ADMITTED,c,admission), GOES_WITH(SF_SNAPSHOT_FIELD,GENESIS,f,a), GOES_WITH(SF_SNAPSHOT_FIELD,GENESIS,g,b)
 THEN GOES_WITH(SF_SNAPSHOT_PAYLOAD,GENESIS,c,ADMITTED(FRAME(LEFT(a),RIGHT(b)),admission));
law SF_READING_OBSERVATION := IF GOES_WITH(SF_FACE_ROLE,w,j,d)
 THEN THIS(SF_ROLE_OBSERVATION,w,j,d);


// J17 second-step occurrence contact, not a replacement for promoted evidence.
// 096 incidence coordinates; 116 L06/L08; retained 012 route_correspondence.
// NOTE_FLAGS_ARE_CELLS_LOCATED_BY_INCIDENCE: occurrence != type seat.
// A structural endpoint witness is not full static DRC or runtime admission.
// SOURCE_MARKER(GENESIS,flag) is the retained source occurrence identity.
// No numeric identifier order, role selection, boundary default, or J6 locus.
@propose seed J21_PORT_CONTACTS := {
 GOES_WITH(J21_PORT,THIS,WHAT,RESULT,OUT,EXACTLY_ONE,IDENTITY_ESSENCE),
 GOES_WITH(J21_PORT,SAME_NOT_SAME,WHAT,LEFT,IN,EXACTLY_ONE,IDENTITY_ESSENCE),
 GOES_WITH(J21_PORT,SAME_NOT_SAME,WHAT,RIGHT,IN,EXACTLY_ONE,IDENTITY_ESSENCE)
};
law J21_MARKER := IF GOES_WITH(SF_SNAPSHOT_FIELD,GENESIS,f,r), THIS(FLAG,f)
 THEN GOES_WITH(J21_MARKER,SOURCE_MARKER(GENESIS,f),TYPE(THIS,WHAT),f,r);
law J21_COORDINATE := IF GOES_WITH(J21_MARKER,m,type,TOGETHER_ALONE(v,e,t),r), GOES_WITH(WORLD_FLAG_FACE,TOGETHER_ALONE(v,e,t),w)
 THEN GOES_WITH(J21_COORDINATE,m,INCIDENCE(v,e,t),PARENT(w));
law J21_MARKER_MEMBER := IF GOES_WITH(J21_MARKER,m,type,f,r), GOES_WITH(J21_COORDINATE,m,coord,parent)
 THEN THIS(J21_CELL_MEMBER,m);
law J21_COMPARATOR_MEMBER := IF GOES_WITH(SF_COMPARATOR,c,f,g), GOES_WITH(SF_OCCURRENCE_ADMITTED,c,proof)
 THEN THIS(J21_CELL_MEMBER,c);
law J21_LEFT := IF GOES_WITH(SF_COMPARATOR,c,f,g), GOES_WITH(J21_MARKER,m,TYPE(THIS,WHAT),f,r), GOES_WITH(J21_PORT,THIS,WHAT,RESULT,OUT,EXACTLY_ONE,t), GOES_WITH(J21_PORT,SAME_NOT_SAME,WHAT,LEFT,IN,EXACTLY_ONE,t)
 THEN GOES_WITH(J21_ROUTE_CONTACT,m,RESULT,c,LEFT);
law J21_RIGHT := IF GOES_WITH(SF_COMPARATOR,c,f,g), GOES_WITH(J21_MARKER,m,TYPE(THIS,WHAT),g,r), GOES_WITH(J21_PORT,THIS,WHAT,RESULT,OUT,EXACTLY_ONE,t), GOES_WITH(J21_PORT,SAME_NOT_SAME,WHAT,RIGHT,IN,EXACTLY_ONE,t)
 THEN GOES_WITH(J21_ROUTE_CONTACT,m,RESULT,c,RIGHT);
// Imported static kernel 8B983301:565-567: endpoint membership, separately
// from :530-561 placement/capability/containment. No full DRC verdict here.
law J21_ENDPOINT_MEMBERSHIP := IF GOES_WITH(J21_ROUTE_CONTACT,m,RESULT,c,role), THIS(J21_CELL_MEMBER,m), THIS(J21_CELL_MEMBER,c)
 THEN GOES_WITH(J21_ENDPOINT_MEMBERSHIP,m,RESULT,c,role);

// The promoted readout applies to the CCC face actually containing this flag.
// Its parent witness label alone does not make a CCD triangle the CCC face.
law J21_CCC_MARKER := IF GOES_WITH(J21_COORDINATE,m,INCIDENCE(v,e,TOGETHER_ALONE(a,b,c)),PARENT(w)), GOES_WITH(DG_FACE,w,a,b,c), GOES_WITH(WORLD_JUNCTION_SITE,v,j)
 THEN GOES_WITH(J21_CCC_MARKER,m,w,j);
law J21_CCC_OWN_ROLE := IF GOES_WITH(J21_CCC_MARKER,m,w,j), GOES_WITH(SF_FACE_ROLE,w,j,d)
 THEN GOES_WITH(J21_CCC_OWN_ROLE,m,w,j,d);
law J21_CCC_OWN_TIE := IF GOES_WITH(J21_CCC_MARKER,m,w,j), GOES_WITH(SF_PLACEMENT_PENDING,w,j,MAYBE)
 THEN GOES_WITH(J21_CCC_OWN_TIE,m,w,j,MAYBE);
law J21_ROUTE_OWN_TIE := IF GOES_WITH(J21_ROUTE_CONTACT,m,RESULT,c,role), GOES_WITH(J21_CCC_OWN_TIE,m,w,j,MAYBE)
 THEN GOES_WITH(J21_ROUTE_OWN_TIE,m,RESULT,c,role,w,j,MAYBE);

// Explicit CCD incidence witnesses, without a modal role imported from a
// different face. The readout's CCC-only scope is retained.
law J21_CCD_DOMAIN_A := IF GOES_WITH(J21_COORDINATE,m,INCIDENCE(v,e,TOGETHER_ALONE(THIS(d),a,b)),PARENT(w))
 THEN GOES_WITH(J21_CCD_MARKER,m,w,THIS(d));
law J21_CCD_DOMAIN_B := IF GOES_WITH(J21_COORDINATE,m,INCIDENCE(v,e,TOGETHER_ALONE(a,THIS(d),b)),PARENT(w))
 THEN GOES_WITH(J21_CCD_MARKER,m,w,THIS(d));
law J21_CCD_DOMAIN_C := IF GOES_WITH(J21_COORDINATE,m,INCIDENCE(v,e,TOGETHER_ALONE(a,b,THIS(d))),PARENT(w))
 THEN GOES_WITH(J21_CCD_MARKER,m,w,THIS(d));


// EXECUTE TASK_CODEX_J17_SECOND_STEP_022; no promotion or expectation change.
// Readout and ranks are retained from 057C30E2 / 3419D528 / 276EBD71.
// 116 L06 FFF676FC:51 withholds each candidate lacking placement evidence.
// Marker occurrence coordinates, never the J6 type seat, supply containment.
// Class C is withheld this tick; it does not stop the admitted subprogram.
@propose seed J22_CLASS_CONTRACT := {
 GOES_WITH(J22_MARKER_CAPABILITY,G),
 GOES_WITH(J22_MARKER_CAPABILITY,S),
 GOES_WITH(J22_CLASS_STATE,A,ADMITTED),
 GOES_WITH(J22_CLASS_STATE,B,WITHHELD),
 GOES_WITH(J22_CLASS_STATE,C,WITHHELD),
 GOES_WITH(J22_CLASS_STATE,D,WITHHELD)
};
law J22_CLASS_A := IF GOES_WITH(J21_CCC_OWN_ROLE,m,w,j,d), GOES_WITH(J22_MARKER_CAPABILITY,d)
 THEN GOES_WITH(J22_CLASS,m,A,w,j,d);
law J22_CLASS_B := IF GOES_WITH(J21_CCC_OWN_ROLE,m,w,j,F)
 THEN GOES_WITH(J22_CLASS,m,B,w,j,F);
law J22_CLASS_C := IF GOES_WITH(J21_CCC_OWN_TIE,m,w,j,MAYBE)
 THEN GOES_WITH(J22_CLASS,m,C,w,j,MAYBE);
law J22_CLASS_D := IF GOES_WITH(J21_CCD_MARKER,m,w,d)
 THEN GOES_WITH(J22_CLASS,m,D,w,d,NOT_LOCATED);
law J22_MARKER_LOCATION := IF GOES_WITH(J22_CLASS,m,A,w,j,d), GOES_WITH(J21_COORDINATE,m,INCIDENCE(v,e,t),PARENT(w))
 THEN GOES_WITH(J22_LOCATION_EVIDENCE,m,LOCATION(INTERIOR(d),CONTAINMENT(FIRST_TICK,INCIDENCE(v,e,t))));
law J22_MARKER_ADMITTED := IF GOES_WITH(J22_CLASS,m,A,w,j,d), GOES_WITH(J22_LOCATION_EVIDENCE,m,location)
 THEN GOES_WITH(J22_CELL_ADMITTED,m,location);
law J22_COMPARATOR_ADMITTED := IF GOES_WITH(SF_OCCURRENCE_ADMITTED,c,receipt), GOES_WITH(SF_OCCURRENCE_PLACEMENT,c,location)
 THEN GOES_WITH(J22_CELL_ADMITTED,c,location);
// The requested induced route set; no replacement route or target is supplied.
law J22_ROUTE := IF GOES_WITH(J21_ROUTE_CONTACT,m,RESULT,c,role), GOES_WITH(J22_CELL_ADMITTED,m,ml), GOES_WITH(J22_CELL_ADMITTED,c,cl)
 THEN GOES_WITH(J22_ROUTE,m,RESULT,c,role);
// DRC (iii), placement-capability evidence. Per occurrence and touched CCC face.
law J22_MARKER_DRC_III := IF GOES_WITH(J22_CLASS,m,A,w,j,d), GOES_WITH(J22_MARKER_CAPABILITY,d), GOES_WITH(J22_LOCATION_EVIDENCE,m,location)
 THEN GOES_WITH(J22_DRC_III_CELL,m,w,IF_THEN,location);
law J22_MARKER_DRC_III_FACE := IF GOES_WITH(J22_DRC_III_CELL,m,w,IF_THEN,location)
 THEN GOES_WITH(J22_DRC_III_FACE,w,IF_THEN);
law J22_COMPARATOR_DRC_III := IF GOES_WITH(SF_OCCURRENCE_PLACEMENT,c,LOCATION(INTERIOR(S),containment)), GOES_WITH(SF_CAPABILITY,SAME_NOT_SAME,S), GOES_WITH(SF_OCCURRENCE_SEATING,c,j), GOES_WITH(SF_FACE_ROLE,w,j,S)
 THEN GOES_WITH(J22_DRC_III_CELL,c,w,IF_THEN,LOCATION(INTERIOR(S),containment));
law J22_COMPARATOR_DRC_III_FACE := IF GOES_WITH(J22_DRC_III_CELL,c,w,IF_THEN,location)
 THEN GOES_WITH(J22_DRC_III_FACE,w,IF_THEN);
// DRC (iv), both actual route endpoints in the admitted candidate cell set.
law J22_ROUTE_DRC_IV := IF GOES_WITH(J22_ROUTE,m,RESULT,c,role), THIS(J21_CELL_MEMBER,m), THIS(J21_CELL_MEMBER,c), GOES_WITH(J22_CELL_ADMITTED,m,ml), GOES_WITH(J22_CELL_ADMITTED,c,cl)
 THEN GOES_WITH(J22_DRC_IV,m,RESULT,c,role,IF_THEN);
// Same INTERIOR(S) endpoints: no modal crossing is manufactured.
law J22_ROUTE_SAME_REGION := IF GOES_WITH(J22_ROUTE,m,RESULT,c,role), GOES_WITH(J22_CELL_ADMITTED,m,LOCATION(INTERIOR(d),mp)), GOES_WITH(J22_CELL_ADMITTED,c,LOCATION(INTERIOR(d),cp))
 THEN GOES_WITH(J22_ROUTE_REGION,m,RESULT,c,role,SAME_REGION(d));
law J22_ROUTE_TYPE := IF GOES_WITH(J22_ROUTE,m,RESULT,c,role), GOES_WITH(J21_PORT,THIS,WHAT,RESULT,OUT,EXACTLY_ONE,t), GOES_WITH(J21_PORT,SAME_NOT_SAME,WHAT,role,IN,EXACTLY_ONE,t)
 THEN GOES_WITH(J22_ROUTE_PORT_TYPE,m,RESULT,c,role,IF_THEN,t);

// All original source endpoints receive a positive classification. Thus an
// excluded counterpart below is witnessed, not inferred from missing facts.
law J22_TARGET_ROLE := IF GOES_WITH(J21_ROUTE_CONTACT,m,RESULT,c,role), GOES_WITH(J22_CLASS,m,k,w,j,d), GOES_WITH(J22_CLASS_STATE,k,status)
 THEN GOES_WITH(J22_TARGET_ROLE_STATUS,c,role,status,m,k);
// Pinned static spec E328B574:652-661,678; reference 8B983301:603-628.
// ROLE_SCHEMA(SAME_NOT_SAME)=LEFT[1],RIGHT[1]. Runtime partial arrivals do
// not repair a missing static route. No current-tick payload is a FabricEdit.
law J22_JOIN_COMPLETE := IF GOES_WITH(J22_TARGET_ROLE_STATUS,c,LEFT,ADMITTED,l,A), GOES_WITH(J22_TARGET_ROLE_STATUS,c,RIGHT,ADMITTED,r,A)
 THEN GOES_WITH(J22_JOIN_CHECK,c,IF_THEN,JOIN(LEFT(ONE),RIGHT(ONE)));
law J22_JOIN_LEFT_ONLY := IF GOES_WITH(J22_TARGET_ROLE_STATUS,c,LEFT,ADMITTED,l,A), GOES_WITH(J22_TARGET_ROLE_STATUS,c,RIGHT,WITHHELD,r,k)
 THEN GOES_WITH(J22_JOIN_CHECK,c,NOT_SAME,JOIN_ROLE_SHAPE_VIOLATION(LEFT(ONE),RIGHT(NO_ROUTE),WITHHELD_SOURCE(r,k)));
law J22_JOIN_RIGHT_ONLY := IF GOES_WITH(J22_TARGET_ROLE_STATUS,c,LEFT,WITHHELD,l,k), GOES_WITH(J22_TARGET_ROLE_STATUS,c,RIGHT,ADMITTED,r,A)
 THEN GOES_WITH(J22_JOIN_CHECK,c,NOT_SAME,JOIN_ROLE_SHAPE_VIOLATION(LEFT(NO_ROUTE),RIGHT(ONE),WITHHELD_SOURCE(l,k)));
law J22_JOIN_UNCONNECTED := IF GOES_WITH(J22_TARGET_ROLE_STATUS,c,LEFT,WITHHELD,l,lk), GOES_WITH(J22_TARGET_ROLE_STATUS,c,RIGHT,WITHHELD,r,rk)
 THEN GOES_WITH(J22_JOIN_UNCONNECTED,c,NO_INCOMING_ROUTES);
law J22_STATIC_REFUSAL := IF GOES_WITH(J22_JOIN_CHECK,c,NOT_SAME,reason)
 THEN GOES_WITH(J22_PROGRAM_REFUSAL,NOT_SAME,STATIC_JOIN(c,reason));


// EXECUTE TASK_CODEX_J17_SECOND_STEP_023. Exact complete-join subset of022.
// Excluded candidates are witnessed, not erased or silently repaired.
law J23_SELECT_COMPARATOR := IF GOES_WITH(J22_JOIN_CHECK,c,IF_THEN,JOIN(LEFT(ONE),RIGHT(ONE))), GOES_WITH(SF_COMPARATOR,c,f,g)
 THEN GOES_WITH(J23_SELECTED_COMPARATOR,c,f,g);
law J23_SELECT_ROUTE := IF GOES_WITH(J22_ROUTE,m,RESULT,c,role), GOES_WITH(J23_SELECTED_COMPARATOR,c,f,g)
 THEN GOES_WITH(J23_SELECTED_ROUTE,m,RESULT,c,role);
law J23_SELECT_MARKER := IF GOES_WITH(J23_SELECTED_ROUTE,m,RESULT,c,role), GOES_WITH(J21_MARKER,m,TYPE(THIS,WHAT),f,reading)
 THEN GOES_WITH(J23_SELECTED_MARKER,m,f);
law J23_WITHHOLD_HALF_JOIN := IF GOES_WITH(J22_JOIN_CHECK,c,NOT_SAME,reason)
 THEN GOES_WITH(J23_EXCLUDED_TARGET,c,HALF_JOIN(reason));
law J23_WITHHOLD_UNCONNECTED := IF GOES_WITH(J22_JOIN_UNCONNECTED,c,NO_INCOMING_ROUTES)
 THEN GOES_WITH(J23_EXCLUDED_TARGET,c,NO_INCOMING_ROUTES);
law J23_WITHHOLD_ROUTE := IF GOES_WITH(J22_ROUTE,m,RESULT,c,role), GOES_WITH(J23_EXCLUDED_TARGET,c,HALF_JOIN(reason))
 THEN GOES_WITH(J23_WITHHELD_ROUTE,m,RESULT,c,role,reason);
// Initial runtime channels have no predecessor fabric transaction; payload
// ingress below is read from the already committed g1 field. This is not a
// fabricated world genesis or an admitted-state default for unresolved cells.
law J23_GENESIS_INGRESS_AUX := IF GOES_WITH(J23_PROGRAM,p,cells,routes), GOES_WITH(J23_PROGRAM_DRC,p,IF_THEN,proof), THIS(COMMITTED_GENESIS,genesis)
 THEN GOES_WITH(J23_SNAPSHOT_AUX,p,GENESIS,AUX(NIL,NIL,NIL,NIL,NIL),JSON_INTEGER("0"));

// Generic source-requested hash/sort response transport, not world decisions.
law J23_SERVICE_TAIL := IF THIS(J23_SERVICE_ROWS,CONS(row,tail))
 THEN THIS(J23_SERVICE_ROWS,tail);
law J23_SERVICE_HASH := IF THIS(J23_SERVICE_ROWS,CONS(ARRAY(CONS("HASH",CONS(subject,CONS(digest,NIL)))),tail))
 THEN GOES_WITH(GPU_HASH_RESPONSE,subject,digest);
law J23_SERVICE_SORT := IF THIS(J23_SERVICE_ROWS,CONS(ARRAY(CONS("SORT",CONS(subject,CONS(key,CONS(result,NIL))))),tail))
 THEN GOES_WITH(GPU_SORT_RESPONSE,subject,key,result);


@propose seed J23_OBSERVED_IDENTITY_BYTES := {
 GOES_WITH(J23_ID_RESPONSE,OCCURRENCE(TYPE(SAME_NOT_SAME,WHAT),OVERLAP(TOGETHER_ALONE(TOGETHER_ALONE(HW_04,HW_05),TOGETHER_ALONE(TOGETHER_ALONE(HW_00,HW_04),TOGETHER_ALONE(HW_04,HW_05)),TOGETHER_ALONE(TOGETHER_ALONE(HW_00,HW_04),TOGETHER_ALONE(HW_00,HW_05),TOGETHER_ALONE(HW_04,HW_05))),TOGETHER_ALONE(TOGETHER_ALONE(HW_04,HW_05),TOGETHER_ALONE(TOGETHER_ALONE(HW_00,HW_05),TOGETHER_ALONE(HW_04,HW_05)),TOGETHER_ALONE(TOGETHER_ALONE(HW_00,HW_04),TOGETHER_ALONE(HW_00,HW_05),TOGETHER_ALONE(HW_04,HW_05))))),"OCCURRENCE(TYPE(SAME_NOT_SAME,WHAT),OVERLAP(TOGETHER_ALONE(TOGETHER_ALONE(HW_04,HW_05),TOGETHER_ALONE(TOGETHER_ALONE(HW_00,HW_04),TOGETHER_ALONE(HW_04,HW_05)),TOGETHER_ALONE(TOGETHER_ALONE(HW_00,HW_04),TOGETHER_ALONE(HW_00,HW_05),TOGETHER_ALONE(HW_04,HW_05))),TOGETHER_ALONE(TOGETHER_ALONE(HW_04,HW_05),TOGETHER_ALONE(TOGETHER_ALONE(HW_00,HW_05),TOGETHER_ALONE(HW_04,HW_05)),TOGETHER_ALONE(TOGETHER_ALONE(HW_00,HW_04),TOGETHER_ALONE(HW_00,HW_05),TOGETHER_ALONE(HW_04,HW_05)))))"),
 GOES_WITH(J23_ID_RESPONSE,OCCURRENCE(TYPE(SAME_NOT_SAME,WHAT),OVERLAP(TOGETHER_ALONE(TOGETHER_ALONE(HW_04,HW_08),TOGETHER_ALONE(TOGETHER_ALONE(HW_03,HW_04),TOGETHER_ALONE(HW_04,HW_08)),TOGETHER_ALONE(TOGETHER_ALONE(HW_03,HW_04),TOGETHER_ALONE(HW_03,HW_08),TOGETHER_ALONE(HW_04,HW_08))),TOGETHER_ALONE(TOGETHER_ALONE(HW_04,HW_08),TOGETHER_ALONE(TOGETHER_ALONE(HW_03,HW_08),TOGETHER_ALONE(HW_04,HW_08)),TOGETHER_ALONE(TOGETHER_ALONE(HW_03,HW_04),TOGETHER_ALONE(HW_03,HW_08),TOGETHER_ALONE(HW_04,HW_08))))),"OCCURRENCE(TYPE(SAME_NOT_SAME,WHAT),OVERLAP(TOGETHER_ALONE(TOGETHER_ALONE(HW_04,HW_08),TOGETHER_ALONE(TOGETHER_ALONE(HW_03,HW_04),TOGETHER_ALONE(HW_04,HW_08)),TOGETHER_ALONE(TOGETHER_ALONE(HW_03,HW_04),TOGETHER_ALONE(HW_03,HW_08),TOGETHER_ALONE(HW_04,HW_08))),TOGETHER_ALONE(TOGETHER_ALONE(HW_04,HW_08),TOGETHER_ALONE(TOGETHER_ALONE(HW_03,HW_08),TOGETHER_ALONE(HW_04,HW_08)),TOGETHER_ALONE(TOGETHER_ALONE(HW_03,HW_04),TOGETHER_ALONE(HW_03,HW_08),TOGETHER_ALONE(HW_04,HW_08)))))"),
 GOES_WITH(J23_ID_RESPONSE,OCCURRENCE(TYPE(SAME_NOT_SAME,WHAT),OVERLAP(TOGETHER_ALONE(TOGETHER_ALONE(HW_04,HW_09),TOGETHER_ALONE(TOGETHER_ALONE(HW_04,HW_05),TOGETHER_ALONE(HW_04,HW_09)),TOGETHER_ALONE(TOGETHER_ALONE(HW_04,HW_05),TOGETHER_ALONE(HW_04,HW_09),TOGETHER_ALONE(HW_05,HW_09))),TOGETHER_ALONE(TOGETHER_ALONE(HW_04,HW_09),TOGETHER_ALONE(TOGETHER_ALONE(HW_04,HW_09),TOGETHER_ALONE(HW_05,HW_09)),TOGETHER_ALONE(TOGETHER_ALONE(HW_04,HW_05),TOGETHER_ALONE(HW_04,HW_09),TOGETHER_ALONE(HW_05,HW_09))))),"OCCURRENCE(TYPE(SAME_NOT_SAME,WHAT),OVERLAP(TOGETHER_ALONE(TOGETHER_ALONE(HW_04,HW_09),TOGETHER_ALONE(TOGETHER_ALONE(HW_04,HW_05),TOGETHER_ALONE(HW_04,HW_09)),TOGETHER_ALONE(TOGETHER_ALONE(HW_04,HW_05),TOGETHER_ALONE(HW_04,HW_09),TOGETHER_ALONE(HW_05,HW_09))),TOGETHER_ALONE(TOGETHER_ALONE(HW_04,HW_09),TOGETHER_ALONE(TOGETHER_ALONE(HW_04,HW_09),TOGETHER_ALONE(HW_05,HW_09)),TOGETHER_ALONE(TOGETHER_ALONE(HW_04,HW_05),TOGETHER_ALONE(HW_04,HW_09),TOGETHER_ALONE(HW_05,HW_09)))))"),
