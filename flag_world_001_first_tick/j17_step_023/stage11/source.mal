 GOES_WITH(BASE_EDGE,HW_03,HW_07),
 GOES_WITH(HARDWARE_EDGE,J_13,HW_03,HW_07),
 GOES_WITH(BASE_EDGE,HW_03,HW_08),
 GOES_WITH(HARDWARE_EDGE,J_14,HW_03,HW_08),
 GOES_WITH(BASE_EDGE,HW_04,HW_05),
 GOES_WITH(HARDWARE_EDGE,J_15,HW_04,HW_05),
