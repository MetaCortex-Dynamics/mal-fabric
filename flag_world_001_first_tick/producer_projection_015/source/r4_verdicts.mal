// Producer projection 015: verdict-only R4 normalization implementation candidate.
// Bound correspondence: witness_basis_normalizer_r4.mal, SHA256
// 3B9480414D1A2A61F7F976993E713811EBFD3FEBEAD1F7878ACA8CF848BA048F.
// BINDING_RECORD.md, SHA256
// CA4865B47A3FF7866A14392A1C1F16CBC3170DC43B6177DD0C24B123CA72B7D7.
// Input: GOES_WITH(P15_SEED,producer,POSITION(operator,basis),verdict,reference).
// The surrounding component supplies the fixed P15_OPERATOR, P15_BASIS and
// P15_VERDICT enum facts. Operators and witnesses are bare constructors;
// verdicts are the quoted readings "IF_THEN", "NOT_SAME", "NO", "MAYBE".
// References remain opaque input support. They are neither normalized nor
// copied into a derived witness. This component computes no content projection,
// shared/private partition, seed assignment, promotion, seal or admission.
// Missing inputs produce no derived conclusion; absence is never converted to NO.
// Partial indexed inputs are consumed independently. This is not a full-map
// schema or single-reading-per-coordinate validator.
// P15_DERIVED witnesses partial R1/R2 closure, not complete-map normalization.
// No complete-normal-form terminal is emitted; full-map coverage is observed separately.
// R1: WHERE = WHAT, WHICH = WHAT, WHEN = HOW.
// R2: WHENCE = WHAT meet (WHAT meet (HOW meet (FOR_WHAT meet why_F))),
// where why_F is this same producer's FOR_WHAT(BECAUSE).
// The full input-reading tuple is retained in each intermediate context.
// Native support custody links the derived verdicts to the original seeds.

law P15_R4_ACCEPT_SEED := IF GOES_WITH(P15_SEED,p,POSITION(o,b),v,r), GOES_WITH(P15_OPERATOR,o), GOES_WITH(P15_BASIS,b), GOES_WITH(P15_VERDICT,v) THEN GOES_WITH(P15_R4_INPUT,p,POSITION(o,b),v);

law P15_R4_WHERE := IF GOES_WITH(P15_R4_INPUT,p,POSITION(o,WHAT),v) THEN GOES_WITH(P15_DERIVED,p,POSITION(o,WHERE),v);
law P15_R4_WHICH := IF GOES_WITH(P15_R4_INPUT,p,POSITION(o,WHAT),v) THEN GOES_WITH(P15_DERIVED,p,POSITION(o,WHICH),v);
law P15_R4_WHEN := IF GOES_WITH(P15_R4_INPUT,p,POSITION(o,HOW),v) THEN GOES_WITH(P15_DERIVED,p,POSITION(o,WHEN),v);

// Explicit four-by-four meet table: NO < MAYBE < NOT_SAME < IF_THEN.
law P15_R4_MEET_IF_THEN_IF_THEN := IF GOES_WITH(P15_R4_MEET_REQUEST,p,c,"IF_THEN","IF_THEN") THEN GOES_WITH(P15_R4_MEET_RESULT,p,c,"IF_THEN","IF_THEN","IF_THEN");
law P15_R4_MEET_IF_THEN_NOT_SAME := IF GOES_WITH(P15_R4_MEET_REQUEST,p,c,"IF_THEN","NOT_SAME") THEN GOES_WITH(P15_R4_MEET_RESULT,p,c,"IF_THEN","NOT_SAME","NOT_SAME");
law P15_R4_MEET_IF_THEN_NO := IF GOES_WITH(P15_R4_MEET_REQUEST,p,c,"IF_THEN","NO") THEN GOES_WITH(P15_R4_MEET_RESULT,p,c,"IF_THEN","NO","NO");
law P15_R4_MEET_IF_THEN_MAYBE := IF GOES_WITH(P15_R4_MEET_REQUEST,p,c,"IF_THEN","MAYBE") THEN GOES_WITH(P15_R4_MEET_RESULT,p,c,"IF_THEN","MAYBE","MAYBE");
law P15_R4_MEET_NOT_SAME_IF_THEN := IF GOES_WITH(P15_R4_MEET_REQUEST,p,c,"NOT_SAME","IF_THEN") THEN GOES_WITH(P15_R4_MEET_RESULT,p,c,"NOT_SAME","IF_THEN","NOT_SAME");
law P15_R4_MEET_NOT_SAME_NOT_SAME := IF GOES_WITH(P15_R4_MEET_REQUEST,p,c,"NOT_SAME","NOT_SAME") THEN GOES_WITH(P15_R4_MEET_RESULT,p,c,"NOT_SAME","NOT_SAME","NOT_SAME");
law P15_R4_MEET_NOT_SAME_NO := IF GOES_WITH(P15_R4_MEET_REQUEST,p,c,"NOT_SAME","NO") THEN GOES_WITH(P15_R4_MEET_RESULT,p,c,"NOT_SAME","NO","NO");
law P15_R4_MEET_NOT_SAME_MAYBE := IF GOES_WITH(P15_R4_MEET_REQUEST,p,c,"NOT_SAME","MAYBE") THEN GOES_WITH(P15_R4_MEET_RESULT,p,c,"NOT_SAME","MAYBE","MAYBE");
law P15_R4_MEET_NO_IF_THEN := IF GOES_WITH(P15_R4_MEET_REQUEST,p,c,"NO","IF_THEN") THEN GOES_WITH(P15_R4_MEET_RESULT,p,c,"NO","IF_THEN","NO");
law P15_R4_MEET_NO_NOT_SAME := IF GOES_WITH(P15_R4_MEET_REQUEST,p,c,"NO","NOT_SAME") THEN GOES_WITH(P15_R4_MEET_RESULT,p,c,"NO","NOT_SAME","NO");
law P15_R4_MEET_NO_NO := IF GOES_WITH(P15_R4_MEET_REQUEST,p,c,"NO","NO") THEN GOES_WITH(P15_R4_MEET_RESULT,p,c,"NO","NO","NO");
law P15_R4_MEET_NO_MAYBE := IF GOES_WITH(P15_R4_MEET_REQUEST,p,c,"NO","MAYBE") THEN GOES_WITH(P15_R4_MEET_RESULT,p,c,"NO","MAYBE","NO");
law P15_R4_MEET_MAYBE_IF_THEN := IF GOES_WITH(P15_R4_MEET_REQUEST,p,c,"MAYBE","IF_THEN") THEN GOES_WITH(P15_R4_MEET_RESULT,p,c,"MAYBE","IF_THEN","MAYBE");
law P15_R4_MEET_MAYBE_NOT_SAME := IF GOES_WITH(P15_R4_MEET_REQUEST,p,c,"MAYBE","NOT_SAME") THEN GOES_WITH(P15_R4_MEET_RESULT,p,c,"MAYBE","NOT_SAME","MAYBE");
law P15_R4_MEET_MAYBE_NO := IF GOES_WITH(P15_R4_MEET_REQUEST,p,c,"MAYBE","NO") THEN GOES_WITH(P15_R4_MEET_RESULT,p,c,"MAYBE","NO","NO");
law P15_R4_MEET_MAYBE_MAYBE := IF GOES_WITH(P15_R4_MEET_REQUEST,p,c,"MAYBE","MAYBE") THEN GOES_WITH(P15_R4_MEET_RESULT,p,c,"MAYBE","MAYBE","MAYBE");

law P15_R4_WHENCE_BEGIN := IF GOES_WITH(P15_R4_INPUT,p,POSITION(o,WHAT),w), GOES_WITH(P15_R4_INPUT,p,POSITION(o,HOW),h), GOES_WITH(P15_R4_INPUT,p,POSITION(o,FOR_WHAT),f), GOES_WITH(P15_R4_INPUT,p,POSITION(BECAUSE,FOR_WHAT),y) THEN GOES_WITH(P15_R4_MEET_REQUEST,p,P15_R4_WHENCE_CONTEXT(o,w,h,f,y,FOR_WHAT_WHY_F),f,y);
law P15_R4_WHENCE_WHEN := IF GOES_WITH(P15_R4_MEET_RESULT,p,P15_R4_WHENCE_CONTEXT(o,w,h,f,y,FOR_WHAT_WHY_F),f,y,a) THEN GOES_WITH(P15_R4_MEET_REQUEST,p,P15_R4_WHENCE_CONTEXT(o,w,h,f,y,WITH_WHEN),h,a);
law P15_R4_WHENCE_WHICH := IF GOES_WITH(P15_R4_MEET_RESULT,p,P15_R4_WHENCE_CONTEXT(o,w,h,f,y,WITH_WHEN),h,a,v) THEN GOES_WITH(P15_R4_MEET_REQUEST,p,P15_R4_WHENCE_CONTEXT(o,w,h,f,y,WITH_WHICH),w,v);
law P15_R4_WHENCE_WHERE := IF GOES_WITH(P15_R4_MEET_RESULT,p,P15_R4_WHENCE_CONTEXT(o,w,h,f,y,WITH_WHICH),w,a,v) THEN GOES_WITH(P15_R4_MEET_REQUEST,p,P15_R4_WHENCE_CONTEXT(o,w,h,f,y,WITH_WHERE),w,v);
law P15_R4_WHENCE_END := IF GOES_WITH(P15_R4_MEET_RESULT,p,P15_R4_WHENCE_CONTEXT(o,w,h,f,y,WITH_WHERE),w,a,v) THEN GOES_WITH(P15_DERIVED,p,POSITION(o,WHENCE),v);
