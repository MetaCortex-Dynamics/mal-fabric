// Bounded J17 runtime re-entry fragment; not a world-fold realization.
// FABEX SHA256 5BB1497AA3D791150F0416FEDA4E393695A9302B42030ADD0A7D22C08CCBEAC0:
// sections 2/3: immutable snapshot; only ADMITTED cells evaluate.
// sections 5/10/11: COMPLETED is post-propagation custody; discharge iff every
// emitted consequence has a durable disposition; sinks close vacuously.
// section 8: retain buffered values separately from PayloadState.
// Reference 96C6F849F3AD64D6B9D8C2469A252E5A813354C1E2C0B7CD47FCDE7B518B4FE2:
// execution_kernel.py:699-731 retains COMPLETE buffers at non-EMPTY snapshot
// targets; :744-753 egress; :919-925 discharge; :932-939 snapshot admission;
// :941-959 receipt merge and route-state custody. Reference is read, not run.
// Scope: all payloads in the bound input inventory are COMPLETED. Nothing
// resets them to g1 frames. No world field, world successor, link, MOVED/HELD,
// O_REENTRY discharge, admission rerun, or program edit is emitted here.
// Hash/sort responses are generic observation primitives, never verdicts.
// Root may append an import wrapper yielding THIS(RR_SERVICE_ROWS,rows).

@readonly input RR_PROGRAM_INPUT := "rr_program:";
@readonly input RR_STATE_INPUT := "rr_state:";

@propose seed RR_CONTRACT := {
 THIS(RR_DURABLE_KIND,"ADMITTED_TO_TARGET"),
 THIS(RR_DURABLE_KIND,"PENDING_AT_TARGET"),
 THIS(RR_DURABLE_KIND,"REJECTED_AT_TARGET"),
 GOES_WITH(RR_BYTE_NEXT,B32,B40), GOES_WITH(RR_BYTE_NEXT,B40,B41),
 GOES_WITH(RR_BYTE_NEXT,B41,B44), GOES_WITH(RR_BYTE_NEXT,B44,B45),
 GOES_WITH(RR_BYTE_NEXT,B45,B46), GOES_WITH(RR_BYTE_NEXT,B46,B48),
 GOES_WITH(RR_BYTE_NEXT,B48,B49), GOES_WITH(RR_BYTE_NEXT,B49,B50),
 GOES_WITH(RR_BYTE_NEXT,B50,B51), GOES_WITH(RR_BYTE_NEXT,B51,B52),
 GOES_WITH(RR_BYTE_NEXT,B52,B53), GOES_WITH(RR_BYTE_NEXT,B53,B54),
 GOES_WITH(RR_BYTE_NEXT,B54,B55), GOES_WITH(RR_BYTE_NEXT,B55,B56),
 GOES_WITH(RR_BYTE_NEXT,B56,B57), GOES_WITH(RR_BYTE_NEXT,B57,B58),
 GOES_WITH(RR_BYTE_NEXT,B58,B65), GOES_WITH(RR_BYTE_NEXT,B65,B66),
 GOES_WITH(RR_BYTE_NEXT,B66,B67), GOES_WITH(RR_BYTE_NEXT,B67,B68),
 GOES_WITH(RR_BYTE_NEXT,B68,B69), GOES_WITH(RR_BYTE_NEXT,B69,B70),
 GOES_WITH(RR_BYTE_NEXT,B70,B71), GOES_WITH(RR_BYTE_NEXT,B71,B72),
 GOES_WITH(RR_BYTE_NEXT,B72,B73), GOES_WITH(RR_BYTE_NEXT,B73,B74),
 GOES_WITH(RR_BYTE_NEXT,B74,B75), GOES_WITH(RR_BYTE_NEXT,B75,B76),
 GOES_WITH(RR_BYTE_NEXT,B76,B77), GOES_WITH(RR_BYTE_NEXT,B77,B78),
 GOES_WITH(RR_BYTE_NEXT,B78,B79), GOES_WITH(RR_BYTE_NEXT,B79,B80),
 GOES_WITH(RR_BYTE_NEXT,B80,B81), GOES_WITH(RR_BYTE_NEXT,B81,B82),
 GOES_WITH(RR_BYTE_NEXT,B82,B83), GOES_WITH(RR_BYTE_NEXT,B83,B84),
 GOES_WITH(RR_BYTE_NEXT,B84,B85), GOES_WITH(RR_BYTE_NEXT,B85,B86),
 GOES_WITH(RR_BYTE_NEXT,B86,B87), GOES_WITH(RR_BYTE_NEXT,B87,B88),
 GOES_WITH(RR_BYTE_NEXT,B88,B89), GOES_WITH(RR_BYTE_NEXT,B89,B90),
 GOES_WITH(RR_BYTE_NEXT,B90,B95), GOES_WITH(RR_BYTE_NEXT,B95,B97),
 GOES_WITH(RR_BYTE_NEXT,B97,B98), GOES_WITH(RR_BYTE_NEXT,B98,B99),
 GOES_WITH(RR_BYTE_NEXT,B99,B100), GOES_WITH(RR_BYTE_NEXT,B100,B101),
 GOES_WITH(RR_BYTE_NEXT,B101,B102), GOES_WITH(RR_BYTE_NEXT,B102,B103),
 GOES_WITH(RR_BYTE_NEXT,B103,B104), GOES_WITH(RR_BYTE_NEXT,B104,B105),
 GOES_WITH(RR_BYTE_NEXT,B105,B106), GOES_WITH(RR_BYTE_NEXT,B106,B107),
 GOES_WITH(RR_BYTE_NEXT,B107,B108), GOES_WITH(RR_BYTE_NEXT,B108,B109),
 GOES_WITH(RR_BYTE_NEXT,B109,B110), GOES_WITH(RR_BYTE_NEXT,B110,B111),
 GOES_WITH(RR_BYTE_NEXT,B111,B112), GOES_WITH(RR_BYTE_NEXT,B112,B113),
 GOES_WITH(RR_BYTE_NEXT,B113,B114), GOES_WITH(RR_BYTE_NEXT,B114,B115),
 GOES_WITH(RR_BYTE_NEXT,B115,B116), GOES_WITH(RR_BYTE_NEXT,B116,B117),
 GOES_WITH(RR_BYTE_NEXT,B117,B118), GOES_WITH(RR_BYTE_NEXT,B118,B119),
 GOES_WITH(RR_BYTE_NEXT,B119,B120), GOES_WITH(RR_BYTE_NEXT,B120,B121),
 GOES_WITH(RR_BYTE_NEXT,B121,B122), GOES_WITH(RR_BYTE_NEXT,B122,B124)
};

// Byte observation is used only for symmetric identifier distinction.
// Neither direction is exposed as a route, role, placement, or selection.
law RR_BYTE_SPAN_ONE := IF GOES_WITH(RR_BYTE_NEXT,a,b) THEN GOES_WITH(RR_BYTE_SPAN,a,b);
law RR_BYTE_SPAN_MORE := IF GOES_WITH(RR_BYTE_SPAN,a,b), GOES_WITH(RR_BYTE_NEXT,b,c) THEN GOES_WITH(RR_BYTE_SPAN,a,c);
law RR_BYTE_DIFFER_FORWARD := IF GOES_WITH(RR_BYTE_SPAN,a,b) THEN GOES_WITH(RR_BYTE_DIFFER,a,b);
law RR_BYTE_DIFFER_REVERSE := IF GOES_WITH(RR_BYTE_SPAN,a,b) THEN GOES_WITH(RR_BYTE_DIFFER,b,a);
law RR_TEXT_REQUEST := IF GOES_WITH(RR_DISTINCT_REQUEST,TEXT(a),TEXT(b)) THEN GOES_WITH(RR_BYTES_REQUEST,a,b);
law RR_TEXT_PREFIX_REQUEST := IF GOES_WITH(RR_BYTES_REQUEST,CONS(a,x),CONS(a,y)) THEN GOES_WITH(RR_BYTES_REQUEST,x,y);
law RR_TEXT_FIRST_DIFFER := IF GOES_WITH(RR_BYTES_REQUEST,CONS(a,x),CONS(b,y)), GOES_WITH(RR_BYTE_DIFFER,a,b) THEN GOES_WITH(RR_BYTES_DIFFER,CONS(a,x),CONS(b,y));
law RR_TEXT_LEFT_END := IF GOES_WITH(RR_BYTES_REQUEST,NIL,CONS(a,t)) THEN GOES_WITH(RR_BYTES_DIFFER,NIL,CONS(a,t));
law RR_TEXT_RIGHT_END := IF GOES_WITH(RR_BYTES_REQUEST,CONS(a,t),NIL) THEN GOES_WITH(RR_BYTES_DIFFER,CONS(a,t),NIL);
law RR_TEXT_PREFIX_DIFFER := IF GOES_WITH(RR_BYTES_REQUEST,CONS(a,x),CONS(a,y)), GOES_WITH(RR_BYTES_DIFFER,x,y) THEN GOES_WITH(RR_BYTES_DIFFER,CONS(a,x),CONS(a,y));
law RR_TEXT_DIFFER := IF GOES_WITH(RR_DISTINCT_REQUEST,TEXT(a),TEXT(b)), GOES_WITH(RR_BYTES_DIFFER,a,b) THEN GOES_WITH(RR_DISTINCT,TEXT(a),TEXT(b));

// Source-driven object/list readers. No host cell/route classification enters.
law RR_READ_PROGRAM := IF THIS(RR_PROGRAM_INPUT,p) THEN THIS(RR_READ,p);
law RR_READ_STATE := IF THIS(RR_STATE_INPUT,s) THEN THIS(RR_READ,s);
law RR_OBJECT_BEGIN := IF THIS(RR_READ,OBJECT(rows)) THEN GOES_WITH(RR_MEMBER_SCAN,OBJECT(rows),rows);
law RR_OBJECT_TAIL := IF GOES_WITH(RR_MEMBER_SCAN,o,CONS(MEMBER(k,v),tail)) THEN GOES_WITH(RR_MEMBER_SCAN,o,tail);
law RR_OBJECT_MEMBER := IF GOES_WITH(RR_MEMBER_SCAN,o,CONS(MEMBER(k,v),tail)) THEN GOES_WITH(RR_MEMBER,o,k,v);
law RR_CELLS_INPUT := IF THIS(RR_PROGRAM_INPUT,p), GOES_WITH(RR_MEMBER,p,"cells",ARRAY(rows)) THEN THIS(RR_CELLS,rows);
law RR_ROUTES_INPUT := IF THIS(RR_PROGRAM_INPUT,p), GOES_WITH(RR_MEMBER,p,"routes",ARRAY(rows)) THEN THIS(RR_ROUTES,rows);
law RR_LIST_CELLS := IF THIS(RR_CELLS,rows) THEN GOES_WITH(RR_LIST,CELLS,rows);
law RR_LIST_ROUTES := IF THIS(RR_ROUTES,rows) THEN GOES_WITH(RR_LIST,ROUTES,rows);
law RR_LIST_TAIL := IF GOES_WITH(RR_LIST,k,CONS(row,tail)) THEN GOES_WITH(RR_LIST,k,tail);
law RR_LIST_READ := IF GOES_WITH(RR_LIST,k,CONS(row,tail)) THEN THIS(RR_READ,row);
law RR_CELL := IF GOES_WITH(RR_LIST,CELLS,CONS(row,tail)), GOES_WITH(RR_MEMBER,row,"cell_id",c) THEN THIS(RR_CELL,c);
law RR_CELL_DECLARATION := IF GOES_WITH(RR_LIST,CELLS,CONS(row,tail)), GOES_WITH(RR_MEMBER,row,"cell_id",c), GOES_WITH(RR_MEMBER,row,"operator",op), GOES_WITH(RR_MEMBER,row,"payload_slot_type",pt) THEN GOES_WITH(RR_CELL_DECLARATION,c,op,pt);
law RR_ROUTE := IF GOES_WITH(RR_LIST,ROUTES,CONS(row,tail)), GOES_WITH(RR_MEMBER,row,"route_id",r), GOES_WITH(RR_MEMBER,row,"source_cell",s), GOES_WITH(RR_MEMBER,row,"target_cell",t), GOES_WITH(RR_MEMBER,row,"source_role",sr), GOES_WITH(RR_MEMBER,row,"target_role",tr) THEN GOES_WITH(RR_ROUTE,row,r,s,t,sr,tr);
law RR_PAYLOADS_INPUT := IF THIS(RR_STATE_INPUT,s), GOES_WITH(RR_MEMBER,s,"payload_states",OBJECT(rows)) THEN THIS(RR_PAYLOAD_ROWS,rows);
law RR_PAYLOADS_BEGIN := IF THIS(RR_PAYLOAD_ROWS,rows) THEN THIS(RR_PAYLOAD_SCAN,rows);
law RR_PAYLOADS_TAIL := IF THIS(RR_PAYLOAD_SCAN,CONS(MEMBER(c,p),tail)) THEN THIS(RR_PAYLOAD_SCAN,tail);
law RR_PAYLOAD := IF THIS(RR_PAYLOAD_SCAN,CONS(MEMBER(c,p),tail)) THEN GOES_WITH(RR_PAYLOAD,c,p);
law RR_PAYLOAD_READ := IF GOES_WITH(RR_PAYLOAD,c,p) THEN THIS(RR_READ,p);
law RR_COMPLETED := IF GOES_WITH(RR_PAYLOAD,c,p), THIS(RR_CELL,c), GOES_WITH(RR_MEMBER,p,"phase","COMPLETED"), GOES_WITH(RR_MEMBER,p,"result",result), GOES_WITH(RR_MEMBER,p,"completion_evidence",ARRAY(es)) THEN GOES_WITH(RR_COMPLETED,c,p,result,es);
law RR_UNSUPPORTED_PHASE := IF GOES_WITH(RR_PAYLOAD,c,p), GOES_WITH(RR_MEMBER,p,"phase",phase) THEN GOES_WITH(RR_SNAPSHOT_PHASE,c,phase);
// These are exclusions of the other lifecycle antecedents, not alternatives
// selected by ranking: COMPLETED is NOT-SAME ADMITTED, DISCHARGED, and EMPTY.
law RR_NO_EVALUATION := IF GOES_WITH(RR_COMPLETED,c,p,result,es) THEN GOES_WITH(RR_EXCLUDED,c,EVALUATE,REQUIRES_SNAPSHOT_ADMITTED);
law RR_NO_NEW_PROPAGATION := IF GOES_WITH(RR_COMPLETED,c,p,result,es) THEN GOES_WITH(RR_EXCLUDED,c,NEW_PROPAGATION,REQUIRES_SNAPSHOT_ADMITTED_RESULT);
law RR_NO_CLEAR := IF GOES_WITH(RR_COMPLETED,c,p,result,es) THEN GOES_WITH(RR_EXCLUDED,c,CLEAR_TO_EMPTY,REQUIRES_SNAPSHOT_DISCHARGED);
law RR_NO_READMISSION := IF GOES_WITH(RR_COMPLETED,c,p,result,es) THEN GOES_WITH(RR_EXCLUDED,c,READMIT,REQUIRES_SNAPSHOT_EMPTY);

// Complete route-inventory proof for each COMPLETED cell. Non-outgoing rows
// need identifier-distinction evidence; outgoing rows need their own durable
// disposition. Empty matched proof is the vacuous sink witness.
law RR_EVIDENCE_BEGIN := IF GOES_WITH(RR_COMPLETED,c,p,result,es) THEN GOES_WITH(RR_EVIDENCE_SCAN,c,es);
law RR_EVIDENCE_TAIL := IF GOES_WITH(RR_EVIDENCE_SCAN,c,CONS(e,tail)) THEN GOES_WITH(RR_EVIDENCE_SCAN,c,tail);
law RR_EVIDENCE_READ := IF GOES_WITH(RR_EVIDENCE_SCAN,c,CONS(e,tail)) THEN THIS(RR_READ,e);
law RR_DURABLE := IF GOES_WITH(RR_EVIDENCE_SCAN,c,CONS(e,tail)), GOES_WITH(RR_MEMBER,e,"route_id",r), GOES_WITH(RR_MEMBER,e,"target_cell",t), GOES_WITH(RR_MEMBER,e,"kind",kind), THIS(RR_DURABLE_KIND,kind), GOES_WITH(RR_MEMBER,e,"receipt_id",receipt) THEN GOES_WITH(RR_DURABLE,c,r,t,kind,receipt);
law RR_COVER_BEGIN := IF GOES_WITH(RR_COMPLETED,c,p,result,es), THIS(RR_ROUTES,rows) THEN GOES_WITH(RR_COVER_SCAN,c,rows);
law RR_COVER_TAIL := IF GOES_WITH(RR_COVER_SCAN,c,CONS(row,tail)) THEN GOES_WITH(RR_COVER_SCAN,c,tail);
law RR_COVER_COMPARE := IF GOES_WITH(RR_COVER_SCAN,c,CONS(row,tail)), GOES_WITH(RR_ROUTE,row,r,s,t,sr,tr) THEN GOES_WITH(RR_DISTINCT_REQUEST,c,s);
law RR_COVER_END := IF GOES_WITH(RR_COVER_SCAN,c,NIL) THEN GOES_WITH(RR_COVER,c,NIL,NIL);
law RR_COVER_OTHER := IF GOES_WITH(RR_COVER_SCAN,c,CONS(row,tail)), GOES_WITH(RR_ROUTE,row,r,s,t,sr,tr), GOES_WITH(RR_DISTINCT,c,s), GOES_WITH(RR_COVER,c,tail,proof) THEN GOES_WITH(RR_COVER,c,CONS(row,tail),proof);
law RR_COVER_OWN := IF GOES_WITH(RR_COVER_SCAN,c,CONS(row,tail)), GOES_WITH(RR_ROUTE,row,r,c,t,sr,tr), GOES_WITH(RR_DURABLE,c,r,t,kind,receipt), GOES_WITH(RR_COVER,c,tail,proof) THEN GOES_WITH(RR_COVER,c,CONS(row,tail),CONS(DURABLE(r,kind,receipt),proof));
law RR_EGRESS_CLOSED := IF GOES_WITH(RR_COMPLETED,c,p,result,es), THIS(RR_ROUTES,rows), GOES_WITH(RR_COVER,c,rows,proof) THEN GOES_WITH(RR_EGRESS_CLOSED,c,proof);
law RR_SINK_CLOSED := IF GOES_WITH(RR_EGRESS_CLOSED,c,NIL) THEN THIS(RR_SINK_CLOSED,c);
law RR_NO_RETAIN_COMPLETED := IF GOES_WITH(RR_COMPLETED,c,p,result,es), GOES_WITH(RR_EGRESS_CLOSED,c,proof) THEN GOES_WITH(RR_EXCLUDED,c,RETAIN_COMPLETED,DISCHARGE_IFF_EGRESS_CLOSED);

// Busy complete buffers remain exact snapshot objects; no same-commit
// COMPLETED->ADMITTED shortcut, no buffer abandonment, no new arrivals.
law RR_BUFFERS_INPUT := IF THIS(RR_STATE_INPUT,s), GOES_WITH(RR_MEMBER,s,"pending_input_buffers",ARRAY(bs)) THEN THIS(RR_BUFFERS,bs);
law RR_BUFFERS_BEGIN := IF THIS(RR_BUFFERS,bs) THEN GOES_WITH(RR_LIST,BUFFERS,bs);
// FABEX sections 6-9 and Paper A SAME roles: LEFT[1], RIGHT[1]. The exact
// two singleton lists prove COMPLETE and exclude extra/missing/repeated roles.
// Checking the types excludes FRAME_REJECTED before retaining the original row.
law RR_BUFFER_JOIN_INPUT := IF GOES_WITH(RR_LIST,BUFFERS,CONS(b,tail)), GOES_WITH(RR_MEMBER,b,"cell_id",c), GOES_WITH(RR_CELL_DECLARATION,c,"SAME_NOT_SAME",pt), GOES_WITH(RR_MEMBER,b,"arrived_values",OBJECT(CONS(MEMBER("LEFT",ARRAY(CONS(l,NIL))),CONS(MEMBER("RIGHT",ARRAY(CONS(r,NIL))),NIL)))) THEN GOES_WITH(RR_BUFFER_JOIN_INPUT,c,b,pt,l,r);
law RR_BUFFER_LEFT_READ := IF GOES_WITH(RR_BUFFER_JOIN_INPUT,c,b,pt,l,r) THEN THIS(RR_READ,l);
law RR_BUFFER_RIGHT_READ := IF GOES_WITH(RR_BUFFER_JOIN_INPUT,c,b,pt,l,r) THEN THIS(RR_READ,r);
law RR_BUFFER_JOIN_COMPLETE := IF GOES_WITH(RR_BUFFER_JOIN_INPUT,c,b,pt,l,r), GOES_WITH(RR_MEMBER,l,"payload_type",pt), GOES_WITH(RR_MEMBER,r,"payload_type",pt) THEN GOES_WITH(RR_BUFFER_JOIN_COMPLETE,c,b);
law RR_BUFFER_RETAIN := IF GOES_WITH(RR_BUFFER_JOIN_COMPLETE,c,b), GOES_WITH(RR_COMPLETED,c,p,result,es) THEN GOES_WITH(RR_BUFFER_RETAINED,c,b);
law RR_BUFFER_CONSUME_EXCLUDED := IF GOES_WITH(RR_BUFFER_JOIN_COMPLETE,c,b), GOES_WITH(RR_COMPLETED,c,p,result,es) THEN GOES_WITH(RR_BUFFER_EXCLUDED,c,b,CONSUME,REQUIRES_SNAPSHOT_EMPTY);
law RR_BUFFER_REJECT_EXCLUDED := IF GOES_WITH(RR_BUFFER_JOIN_COMPLETE,c,b), GOES_WITH(RR_COMPLETED,c,p,result,es) THEN GOES_WITH(RR_BUFFER_EXCLUDED,c,b,REJECT,COMPLETE_JOIN_AND_MATCHED_TYPES);
law RR_BUFFERS_END := IF GOES_WITH(RR_LIST,BUFFERS,NIL) THEN THIS(RR_BUFFERS_COVERED,NIL);
law RR_BUFFERS_ROW := IF GOES_WITH(RR_LIST,BUFFERS,CONS(b,tail)), GOES_WITH(RR_MEMBER,b,"cell_id",c), GOES_WITH(RR_BUFFER_RETAINED,c,b), THIS(RR_BUFFERS_COVERED,tail) THEN THIS(RR_BUFFERS_COVERED,CONS(b,tail));

// Generic primitive replies are matched by their complete source request.
law RR_SERVICE_TAIL := IF THIS(RR_SERVICE_ROWS,CONS(row,tail)) THEN THIS(RR_SERVICE_ROWS,tail);
law RR_HASH_REPLY := IF THIS(RR_SERVICE_ROWS,CONS(ARRAY(CONS("HASH",CONS(j,CONS(h,NIL)))),tail)), GOES_WITH(GPU_HASH_REQUEST,k,key,j) THEN GOES_WITH(RR_HASH,j,h);
law RR_SORT_REPLY := IF THIS(RR_SERVICE_ROWS,CONS(ARRAY(CONS("SORT",CONS(j,CONS(field,CONS(sorted,NIL))))),tail)), GOES_WITH(GPU_SORT_REQUEST,k,key,j,field) THEN GOES_WITH(RR_SORT,j,field,sorted);
law RR_RESULT_HASH := IF GOES_WITH(RR_COMPLETED,c,p,result,es), GOES_WITH(RR_EGRESS_CLOSED,c,proof) THEN GOES_WITH(GPU_HASH_REQUEST,RR_RESULT,c,result);
law RR_RESULT_REF := IF GOES_WITH(RR_COMPLETED,c,p,result,es), GOES_WITH(RR_EGRESS_CLOSED,c,proof), GOES_WITH(RR_HASH,result,h) THEN GOES_WITH(RR_RESULT_REF,c,h);
law RR_DISCHARGE_REQUEST := IF GOES_WITH(RR_RESULT_REF,c,h) THEN GOES_WITH(RR_RECEIPT_REQUEST,DISCHARGE(c),"PAYLOAD_DISCHARGED",c,h);
law RR_TRANSITION_REQUEST := IF GOES_WITH(RR_EGRESS_CLOSED,c,proof) THEN GOES_WITH(RR_RECEIPT_REQUEST,TRANSITION(c),"PAYLOAD_TRANSITION",c,ARRAY(CONS("COMPLETED",CONS("DISCHARGED",NIL))));
law RR_RECEIPT_PAYLOAD_HASH := IF GOES_WITH(RR_RECEIPT_REQUEST,key,kind,c,payload) THEN GOES_WITH(GPU_HASH_REQUEST,RR_RECEIPT_PAYLOAD,key,payload);
law RR_RECEIPT_ID_REQUEST := IF GOES_WITH(RR_RECEIPT_REQUEST,key,kind,c,payload), GOES_WITH(RR_HASH,payload,h) THEN GOES_WITH(RR_RECEIPT_ID_REQUEST,key,kind,c,h,ARRAY(CONS(kind,CONS(c,CONS(h,NIL)))));
law RR_RECEIPT_ID_HASH := IF GOES_WITH(RR_RECEIPT_ID_REQUEST,key,kind,c,h,j) THEN GOES_WITH(GPU_HASH_REQUEST,RR_RECEIPT_ID,key,j);
law RR_RECEIPT := IF GOES_WITH(RR_RECEIPT_ID_REQUEST,key,kind,c,h,j), GOES_WITH(RR_HASH,j,id) THEN GOES_WITH(RR_RECEIPT,key,id,OBJECT(CONS(MEMBER("kind",kind),CONS(MEMBER("payload_digest",h),CONS(MEMBER("receipt_id",id),CONS(MEMBER("subject_id",c),NIL))))));
law RR_NEXT_PAYLOAD := IF GOES_WITH(RR_RESULT_REF,c,h), GOES_WITH(RR_RECEIPT,DISCHARGE(c),receipt,j) THEN GOES_WITH(RR_NEXT_PAYLOAD,c,OBJECT(CONS(MEMBER("admission_receipt",JSON_NULL),CONS(MEMBER("completion_evidence",ARRAY(NIL)),CONS(MEMBER("discharge_receipt",receipt),CONS(MEMBER("frame",JSON_NULL),CONS(MEMBER("phase","DISCHARGED"),CONS(MEMBER("result",JSON_NULL),CONS(MEMBER("result_ref",h),NIL)))))))));

// Full payload inventory and reverse program inventory must both discharge.
law RR_PAYLOAD_END := IF THIS(RR_PAYLOAD_SCAN,NIL) THEN GOES_WITH(RR_PAYLOAD_FOLD,NIL,NIL,NIL);
law RR_PAYLOAD_ROW := IF THIS(RR_PAYLOAD_SCAN,CONS(MEMBER(c,p),tail)), THIS(RR_CELL,c), GOES_WITH(RR_NEXT_PAYLOAD,c,next), GOES_WITH(RR_RECEIPT,TRANSITION(c),id,receipt), GOES_WITH(RR_PAYLOAD_FOLD,tail,rows,rs) THEN GOES_WITH(RR_PAYLOAD_FOLD,CONS(MEMBER(c,p),tail),CONS(MEMBER(c,next),rows),CONS(receipt,rs));
law RR_CELLS_END := IF GOES_WITH(RR_LIST,CELLS,NIL) THEN THIS(RR_CELLS_COVERED,NIL);
law RR_CELLS_ROW := IF GOES_WITH(RR_LIST,CELLS,CONS(row,tail)), GOES_WITH(RR_MEMBER,row,"cell_id",c), GOES_WITH(RR_NEXT_PAYLOAD,c,next), THIS(RR_CELLS_COVERED,tail) THEN THIS(RR_CELLS_COVERED,CONS(row,tail));
law RR_OLD_RECEIPTS := IF THIS(RR_STATE_INPUT,s), GOES_WITH(RR_MEMBER,s,"receipts",ARRAY(old)) THEN THIS(RR_OLD_RECEIPTS,old);
law RR_APPEND_REQUEST := IF THIS(RR_PAYLOAD_ROWS,rows), GOES_WITH(RR_PAYLOAD_FOLD,rows,next,rs), THIS(RR_OLD_RECEIPTS,old) THEN GOES_WITH(RR_APPEND_REQUEST,old,rs);
law RR_APPEND_TAIL := IF GOES_WITH(RR_APPEND_REQUEST,CONS(a,t),b) THEN GOES_WITH(RR_APPEND_REQUEST,t,b);
law RR_APPEND_END := IF GOES_WITH(RR_APPEND_REQUEST,NIL,b) THEN GOES_WITH(RR_APPEND,NIL,b,b);
law RR_APPEND_ROW := IF GOES_WITH(RR_APPEND_REQUEST,CONS(a,t),b), GOES_WITH(RR_APPEND,t,b,j) THEN GOES_WITH(RR_APPEND,CONS(a,t),b,CONS(a,j));
// The reference's receipt merge is a keyed union. Here the bounded append is
// that union only after every receipt ID is proved distinct. A repeated ID
// withholds this fragment; no last-writer or enumeration choice is installed.
law RR_RECEIPT_LIST := IF THIS(RR_PAYLOAD_ROWS,rows), GOES_WITH(RR_PAYLOAD_FOLD,rows,next,rs), THIS(RR_OLD_RECEIPTS,old), GOES_WITH(RR_APPEND,old,rs,all) THEN GOES_WITH(RR_LIST,RECEIPTS,all);
law RR_RECEIPT_ROW_ID := IF GOES_WITH(RR_LIST,RECEIPTS,CONS(row,tail)), GOES_WITH(RR_MEMBER,row,"receipt_id",id) THEN GOES_WITH(RR_RECEIPT_ROW_ID,row,id);
law RR_RECEIPT_COMPARE_BEGIN := IF GOES_WITH(RR_LIST,RECEIPTS,CONS(row,tail)), GOES_WITH(RR_RECEIPT_ROW_ID,row,id) THEN GOES_WITH(RR_RECEIPT_COMPARE,id,tail);
law RR_RECEIPT_COMPARE_TAIL := IF GOES_WITH(RR_RECEIPT_COMPARE,id,CONS(row,tail)) THEN GOES_WITH(RR_RECEIPT_COMPARE,id,tail);
law RR_RECEIPT_COMPARE_REQUEST := IF GOES_WITH(RR_RECEIPT_COMPARE,id,CONS(row,tail)), GOES_WITH(RR_RECEIPT_ROW_ID,row,other) THEN GOES_WITH(RR_DISTINCT_REQUEST,id,other);
law RR_RECEIPT_COMPARE_END := IF GOES_WITH(RR_RECEIPT_COMPARE,id,NIL) THEN GOES_WITH(RR_RECEIPT_DISTINCT_TAIL,id,NIL);
law RR_RECEIPT_COMPARE_ROW := IF GOES_WITH(RR_RECEIPT_COMPARE,id,CONS(row,tail)), GOES_WITH(RR_RECEIPT_ROW_ID,row,other), GOES_WITH(RR_DISTINCT,id,other), GOES_WITH(RR_RECEIPT_DISTINCT_TAIL,id,tail) THEN GOES_WITH(RR_RECEIPT_DISTINCT_TAIL,id,CONS(row,tail));
law RR_RECEIPTS_DISTINCT_END := IF GOES_WITH(RR_LIST,RECEIPTS,NIL) THEN THIS(RR_RECEIPTS_DISTINCT,NIL);
law RR_RECEIPTS_DISTINCT_ROW := IF GOES_WITH(RR_LIST,RECEIPTS,CONS(row,tail)), GOES_WITH(RR_RECEIPT_ROW_ID,row,id), GOES_WITH(RR_RECEIPT_DISTINCT_TAIL,id,tail), THIS(RR_RECEIPTS_DISTINCT,tail) THEN THIS(RR_RECEIPTS_DISTINCT,CONS(row,tail));
law RR_RECEIPTS_SORT := IF THIS(RR_PAYLOAD_ROWS,rows), GOES_WITH(RR_PAYLOAD_FOLD,rows,next,rs), THIS(RR_OLD_RECEIPTS,old), GOES_WITH(RR_APPEND,old,rs,all) THEN GOES_WITH(GPU_SORT_REQUEST,RR_RECEIPTS,REENTRY,ARRAY(all),"receipt_id");
law RR_RECEIPTS_READY := IF THIS(RR_PAYLOAD_ROWS,rows), GOES_WITH(RR_PAYLOAD_FOLD,rows,next,rs), THIS(RR_OLD_RECEIPTS,old), GOES_WITH(RR_APPEND,old,rs,all), THIS(RR_RECEIPTS_DISTINCT,all), GOES_WITH(RR_SORT,ARRAY(all),"receipt_id",sorted) THEN THIS(RR_RECEIPTS_READY,sorted);
law RR_INVENTORY_COMPLETE := IF THIS(RR_CELLS,cs), THIS(RR_CELLS_COVERED,cs), THIS(RR_BUFFERS,bs), THIS(RR_BUFFERS_COVERED,bs), THIS(RR_PAYLOAD_ROWS,ps), GOES_WITH(RR_PAYLOAD_FOLD,ps,next,rs) THEN GOES_WITH(RR_INVENTORY_COMPLETE,next,bs);
law RR_AUXILIARY := IF THIS(RR_STATE_INPUT,s), GOES_WITH(RR_MEMBER,s,"pending_admissions",ARRAY(NIL)), GOES_WITH(RR_MEMBER,s,"outstanding_obligations",ARRAY(NIL)), GOES_WITH(RR_MEMBER,s,"route_states",routes) THEN THIS(RR_AUXILIARY,routes);
law RR_RUNTIME_CANDIDATE := IF GOES_WITH(RR_INVENTORY_COMPLETE,next,bs), THIS(RR_AUXILIARY,routes), THIS(RR_RECEIPTS_READY,receipts) THEN THIS(RR_RUNTIME_CANDIDATE,OBJECT(CONS(MEMBER("outstanding_obligations",ARRAY(NIL)),CONS(MEMBER("payload_states",OBJECT(next)),CONS(MEMBER("pending_admissions",ARRAY(NIL)),CONS(MEMBER("pending_input_buffers",ARRAY(bs)),CONS(MEMBER("receipts",receipts),CONS(MEMBER("route_states",routes),NIL))))))));
law RR_COMPLETE := IF THIS(RR_RUNTIME_CANDIDATE,j), THIS(RR_PROGRAM_INPUT,p), THIS(RR_STATE_INPUT,s) THEN GOES_WITH(RR_COMPLETE,p,s,j,SANDBOX_RUNTIME_ONLY);

// Bounded uniqueness witness. Every input payload is covered; every program
// cell has exactly its snapshot payload (JSON object keys are unique under the
// lowerer's compact round-trip input contract); all are COMPLETED; each egress
// is closed. The lifecycle therefore requires DISCHARGED, with deterministic
// result-reference/discharge/transition receipts. Buffers are COMPLETE and
// target snapshot COMPLETED, excluding consume and reject. Empty pending and
// obligation inventories exclude those governance transitions. The remaining
// two runtime fields preserve the snapshot routes and canonical receipt union.
// Generic HASH/SORT services must be qualified deterministic primitives.
// This quantifies over this runtime inventory, NEVER over world-fold effects.
// The inspected bound JSON carries the runtime schemas. This is not a generic
// malformed-schema certificate or a law for other snapshot phases.
law RR_CELL_EFFECT_FORCED := IF GOES_WITH(RR_COMPLETED,c,p,result,es), GOES_WITH(RR_EGRESS_CLOSED,c,proof), GOES_WITH(RR_NEXT_PAYLOAD,c,next), GOES_WITH(RR_EXCLUDED,c,EVALUATE,REQUIRES_SNAPSHOT_ADMITTED), GOES_WITH(RR_EXCLUDED,c,NEW_PROPAGATION,REQUIRES_SNAPSHOT_ADMITTED_RESULT), GOES_WITH(RR_EXCLUDED,c,CLEAR_TO_EMPTY,REQUIRES_SNAPSHOT_DISCHARGED), GOES_WITH(RR_EXCLUDED,c,READMIT,REQUIRES_SNAPSHOT_EMPTY), GOES_WITH(RR_EXCLUDED,c,RETAIN_COMPLETED,DISCHARGE_IFF_EGRESS_CLOSED) THEN GOES_WITH(RR_CELL_EFFECT_FORCED,c,next,COMPLETED_TO_DISCHARGED);
law RR_PAYLOAD_UNIQUE_END := IF THIS(RR_PAYLOAD_SCAN,NIL) THEN THIS(RR_PAYLOAD_UNIQUE,NIL);
law RR_PAYLOAD_UNIQUE_ROW := IF THIS(RR_PAYLOAD_SCAN,CONS(MEMBER(c,p),tail)), GOES_WITH(RR_CELL_EFFECT_FORCED,c,next,COMPLETED_TO_DISCHARGED), THIS(RR_PAYLOAD_UNIQUE,tail) THEN THIS(RR_PAYLOAD_UNIQUE,CONS(MEMBER(c,p),tail));
law RR_BUFFER_UNIQUE_END := IF GOES_WITH(RR_LIST,BUFFERS,NIL) THEN THIS(RR_BUFFER_UNIQUE,NIL);
law RR_BUFFER_UNIQUE_ROW := IF GOES_WITH(RR_LIST,BUFFERS,CONS(b,tail)), GOES_WITH(RR_BUFFER_RETAINED,c,b), GOES_WITH(RR_BUFFER_EXCLUDED,c,b,CONSUME,REQUIRES_SNAPSHOT_EMPTY), GOES_WITH(RR_BUFFER_EXCLUDED,c,b,REJECT,COMPLETE_JOIN_AND_MATCHED_TYPES), THIS(RR_BUFFER_UNIQUE,tail) THEN THIS(RR_BUFFER_UNIQUE,CONS(b,tail));
law RR_RUNTIME_UNIQUE := IF GOES_WITH(RR_COMPLETE,p,s,j,SANDBOX_RUNTIME_ONLY), THIS(RR_PAYLOAD_ROWS,ps), THIS(RR_PAYLOAD_UNIQUE,ps), THIS(RR_BUFFERS,bs), THIS(RR_BUFFER_UNIQUE,bs), THIS(RR_AUXILIARY,routes) THEN GOES_WITH(RR_RUNTIME_UNIQUE,p,s,j,BOUNDED_COMPLETED_SNAPSHOT_FRAGMENT);
