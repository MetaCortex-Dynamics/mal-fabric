// Bounded enumeration only; no selection, admission or commit.
law P8_SITE_AB := IF GOES_WITH(CURRENT_FIELD,TOGETHER_ALONE(v,e,t),THIS), GOES_WITH(EDGE_IN_TRIAD,TOGETHER_ALONE(v,d),u)
 THEN THIS(P8_CONTEXT,PROBE(TOGETHER_ALONE(v,e,t),SITE,d));
law P8_SITE_BA := IF GOES_WITH(CURRENT_FIELD,TOGETHER_ALONE(v,e,t),THIS), GOES_WITH(EDGE_IN_TRIAD,TOGETHER_ALONE(d,v),u)
 THEN THIS(P8_CONTEXT,PROBE(TOGETHER_ALONE(v,e,t),SITE,d));
law P8_EDGE := IF GOES_WITH(CURRENT_FIELD,f,THIS), GOES_WITH(GAMMA,f,TOGETHER_ALONE(v,e,t))
 THEN THIS(P8_CONTEXT,PROBE(f,EDGE,e));
law P8_TRIAD := IF GOES_WITH(CURRENT_FIELD,TOGETHER_ALONE(v,e,t),THIS), GOES_WITH(TAU,TOGETHER_ALONE(s,q,t),TOGETHER_ALONE(s,q,u))
 THEN THIS(P8_CONTEXT,PROBE(TOGETHER_ALONE(v,e,t),TRIAD,u));
law P8_ENTITY := IF THIS(P8_CONTEXT,PROBE(f,k,t))
 THEN GOES_WITH(VD_SELECTED_ENTITY,PROBE(f,k,t),f,f);
law P8_TARGET := IF THIS(P8_CONTEXT,PROBE(f,k,t))
 THEN GOES_WITH(VD_TARGET,PROBE(f,k,t),k,t);
law P8_SNAPSHOT := IF THIS(P8_CONTEXT,c), GOES_WITH(CURRENT_FIELD,f,r)
 THEN GOES_WITH(VD_GENESIS_FIELD,c,f,r);
