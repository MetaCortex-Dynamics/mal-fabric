// EXECUTE TASK_CODEX_J17_SECOND_STEP_022; no promotion or expectation change.
// Readout and ranks are retained from 057C30E2 / 3419D528 / 276EBD71.
// 116 L06 FFF676FC:51 withholds each candidate lacking placement evidence.
// Marker occurrence coordinates, never the J6 type seat, supply containment.
// Class C is withheld this tick; it does not stop the admitted subprogram.
@propose seed J22_CLASS_CONTRACT := {
 GOES_WITH(J22_MARKER_CAPABILITY,G),
 GOES_WITH(J22_MARKER_CAPABILITY,S),
 GOES_WITH(J22_CLASS_STATE,A,ADMITTED),
 GOES_WITH(J22_CLASS_STATE,B,WITHHELD),
 GOES_WITH(J22_CLASS_STATE,C,WITHHELD),
 GOES_WITH(J22_CLASS_STATE,D,WITHHELD)
};
law J22_CLASS_A := IF GOES_WITH(J21_CCC_OWN_ROLE,m,w,j,d), GOES_WITH(J22_MARKER_CAPABILITY,d)
 THEN GOES_WITH(J22_CLASS,m,A,w,j,d);
law J22_CLASS_B := IF GOES_WITH(J21_CCC_OWN_ROLE,m,w,j,F)
 THEN GOES_WITH(J22_CLASS,m,B,w,j,F);
law J22_CLASS_C := IF GOES_WITH(J21_CCC_OWN_TIE,m,w,j,MAYBE)
 THEN GOES_WITH(J22_CLASS,m,C,w,j,MAYBE);
law J22_CLASS_D := IF GOES_WITH(J21_CCD_MARKER,m,w,d)
 THEN GOES_WITH(J22_CLASS,m,D,w,d,NOT_LOCATED);
law J22_MARKER_LOCATION := IF GOES_WITH(J22_CLASS,m,A,w,j,d), GOES_WITH(J21_COORDINATE,m,INCIDENCE(v,e,t),PARENT(w))
 THEN GOES_WITH(J22_LOCATION_EVIDENCE,m,LOCATION(INTERIOR(d),CONTAINMENT(FIRST_TICK,INCIDENCE(v,e,t))));
law J22_MARKER_ADMITTED := IF GOES_WITH(J22_CLASS,m,A,w,j,d), GOES_WITH(J22_LOCATION_EVIDENCE,m,location)
 THEN GOES_WITH(J22_CELL_ADMITTED,m,location);
law J22_COMPARATOR_ADMITTED := IF GOES_WITH(SF_OCCURRENCE_ADMITTED,c,receipt), GOES_WITH(SF_OCCURRENCE_PLACEMENT,c,location)
 THEN GOES_WITH(J22_CELL_ADMITTED,c,location);
// The requested induced route set; no replacement route or target is supplied.
law J22_ROUTE := IF GOES_WITH(J21_ROUTE_CONTACT,m,RESULT,c,role), GOES_WITH(J22_CELL_ADMITTED,m,ml), GOES_WITH(J22_CELL_ADMITTED,c,cl)
 THEN GOES_WITH(J22_ROUTE,m,RESULT,c,role);
// DRC (iii), placement-capability evidence. Per occurrence and touched CCC face.
law J22_MARKER_DRC_III := IF GOES_WITH(J22_CLASS,m,A,w,j,d), GOES_WITH(J22_MARKER_CAPABILITY,d), GOES_WITH(J22_LOCATION_EVIDENCE,m,location)
 THEN GOES_WITH(J22_DRC_III_CELL,m,w,IF_THEN,location);
law J22_MARKER_DRC_III_FACE := IF GOES_WITH(J22_DRC_III_CELL,m,w,IF_THEN,location)
 THEN GOES_WITH(J22_DRC_III_FACE,w,IF_THEN);
law J22_COMPARATOR_DRC_III := IF GOES_WITH(SF_OCCURRENCE_PLACEMENT,c,LOCATION(INTERIOR(S),containment)), GOES_WITH(SF_CAPABILITY,SAME_NOT_SAME,S), GOES_WITH(SF_OCCURRENCE_SEATING,c,j), GOES_WITH(SF_FACE_ROLE,w,j,S)
 THEN GOES_WITH(J22_DRC_III_CELL,c,w,IF_THEN,LOCATION(INTERIOR(S),containment));
law J22_COMPARATOR_DRC_III_FACE := IF GOES_WITH(J22_DRC_III_CELL,c,w,IF_THEN,location)
 THEN GOES_WITH(J22_DRC_III_FACE,w,IF_THEN);
// DRC (iv), both actual route endpoints in the admitted candidate cell set.
law J22_ROUTE_DRC_IV := IF GOES_WITH(J22_ROUTE,m,RESULT,c,role), THIS(J21_CELL_MEMBER,m), THIS(J21_CELL_MEMBER,c), GOES_WITH(J22_CELL_ADMITTED,m,ml), GOES_WITH(J22_CELL_ADMITTED,c,cl)
 THEN GOES_WITH(J22_DRC_IV,m,RESULT,c,role,IF_THEN);
// Same INTERIOR(S) endpoints: no modal crossing is manufactured.
law J22_ROUTE_SAME_REGION := IF GOES_WITH(J22_ROUTE,m,RESULT,c,role), GOES_WITH(J22_CELL_ADMITTED,m,LOCATION(INTERIOR(d),mp)), GOES_WITH(J22_CELL_ADMITTED,c,LOCATION(INTERIOR(d),cp))
 THEN GOES_WITH(J22_ROUTE_REGION,m,RESULT,c,role,SAME_REGION(d));
law J22_ROUTE_TYPE := IF GOES_WITH(J22_ROUTE,m,RESULT,c,role), GOES_WITH(J21_PORT,THIS,WHAT,RESULT,OUT,EXACTLY_ONE,t), GOES_WITH(J21_PORT,SAME_NOT_SAME,WHAT,role,IN,EXACTLY_ONE,t)
 THEN GOES_WITH(J22_ROUTE_PORT_TYPE,m,RESULT,c,role,IF_THEN,t);

// All original source endpoints receive a positive classification. Thus an
// excluded counterpart below is witnessed, not inferred from missing facts.
law J22_TARGET_ROLE := IF GOES_WITH(J21_ROUTE_CONTACT,m,RESULT,c,role), GOES_WITH(J22_CLASS,m,k,w,j,d), GOES_WITH(J22_CLASS_STATE,k,status)
 THEN GOES_WITH(J22_TARGET_ROLE_STATUS,c,role,status,m,k);
// Pinned static spec E328B574:652-661,678; reference 8B983301:603-628.
// ROLE_SCHEMA(SAME_NOT_SAME)=LEFT[1],RIGHT[1]. Runtime partial arrivals do
// not repair a missing static route. No current-tick payload is a FabricEdit.
law J22_JOIN_COMPLETE := IF GOES_WITH(J22_TARGET_ROLE_STATUS,c,LEFT,ADMITTED,l,A), GOES_WITH(J22_TARGET_ROLE_STATUS,c,RIGHT,ADMITTED,r,A)
 THEN GOES_WITH(J22_JOIN_CHECK,c,IF_THEN,JOIN(LEFT(ONE),RIGHT(ONE)));
law J22_JOIN_LEFT_ONLY := IF GOES_WITH(J22_TARGET_ROLE_STATUS,c,LEFT,ADMITTED,l,A), GOES_WITH(J22_TARGET_ROLE_STATUS,c,RIGHT,WITHHELD,r,k)
 THEN GOES_WITH(J22_JOIN_CHECK,c,NOT_SAME,JOIN_ROLE_SHAPE_VIOLATION(LEFT(ONE),RIGHT(NO_ROUTE),WITHHELD_SOURCE(r,k)));
law J22_JOIN_RIGHT_ONLY := IF GOES_WITH(J22_TARGET_ROLE_STATUS,c,LEFT,WITHHELD,l,k), GOES_WITH(J22_TARGET_ROLE_STATUS,c,RIGHT,ADMITTED,r,A)
 THEN GOES_WITH(J22_JOIN_CHECK,c,NOT_SAME,JOIN_ROLE_SHAPE_VIOLATION(LEFT(NO_ROUTE),RIGHT(ONE),WITHHELD_SOURCE(l,k)));
law J22_JOIN_UNCONNECTED := IF GOES_WITH(J22_TARGET_ROLE_STATUS,c,LEFT,WITHHELD,l,lk), GOES_WITH(J22_TARGET_ROLE_STATUS,c,RIGHT,WITHHELD,r,rk)
 THEN GOES_WITH(J22_JOIN_UNCONNECTED,c,NO_INCOMING_ROUTES);
law J22_STATIC_REFUSAL := IF GOES_WITH(J22_JOIN_CHECK,c,NOT_SAME,reason)
 THEN GOES_WITH(J22_PROGRAM_REFUSAL,NOT_SAME,STATIC_JOIN(c,reason));
