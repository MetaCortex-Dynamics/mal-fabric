// J17 second-step occurrence contact, not a replacement for promoted evidence.
// 096 incidence coordinates; 116 L06/L08; retained 012 route_correspondence.
// NOTE_FLAGS_ARE_CELLS_LOCATED_BY_INCIDENCE: occurrence != type seat.
// A structural endpoint witness is not full static DRC or runtime admission.
// SOURCE_MARKER(GENESIS,flag) is the retained source occurrence identity.
// No numeric identifier order, role selection, boundary default, or J6 locus.
@propose seed J21_PORT_CONTACTS := {
 GOES_WITH(J21_PORT,THIS,WHAT,RESULT,OUT,EXACTLY_ONE,IDENTITY_ESSENCE),
 GOES_WITH(J21_PORT,SAME_NOT_SAME,WHAT,LEFT,IN,EXACTLY_ONE,IDENTITY_ESSENCE),
 GOES_WITH(J21_PORT,SAME_NOT_SAME,WHAT,RIGHT,IN,EXACTLY_ONE,IDENTITY_ESSENCE)
};
law J21_MARKER := IF GOES_WITH(SF_SNAPSHOT_FIELD,GENESIS,f,r), THIS(FLAG,f)
 THEN GOES_WITH(J21_MARKER,SOURCE_MARKER(GENESIS,f),TYPE(THIS,WHAT),f,r);
law J21_COORDINATE := IF GOES_WITH(J21_MARKER,m,type,TOGETHER_ALONE(v,e,t),r), GOES_WITH(WORLD_FLAG_FACE,TOGETHER_ALONE(v,e,t),w)
 THEN GOES_WITH(J21_COORDINATE,m,INCIDENCE(v,e,t),PARENT(w));
law J21_MARKER_MEMBER := IF GOES_WITH(J21_MARKER,m,type,f,r), GOES_WITH(J21_COORDINATE,m,coord,parent)
 THEN THIS(J21_CELL_MEMBER,m);
law J21_COMPARATOR_MEMBER := IF GOES_WITH(SF_COMPARATOR,c,f,g), GOES_WITH(SF_OCCURRENCE_ADMITTED,c,proof)
 THEN THIS(J21_CELL_MEMBER,c);
law J21_LEFT := IF GOES_WITH(SF_COMPARATOR,c,f,g), GOES_WITH(J21_MARKER,m,TYPE(THIS,WHAT),f,r), GOES_WITH(J21_PORT,THIS,WHAT,RESULT,OUT,EXACTLY_ONE,t), GOES_WITH(J21_PORT,SAME_NOT_SAME,WHAT,LEFT,IN,EXACTLY_ONE,t)
 THEN GOES_WITH(J21_ROUTE_CONTACT,m,RESULT,c,LEFT);
law J21_RIGHT := IF GOES_WITH(SF_COMPARATOR,c,f,g), GOES_WITH(J21_MARKER,m,TYPE(THIS,WHAT),g,r), GOES_WITH(J21_PORT,THIS,WHAT,RESULT,OUT,EXACTLY_ONE,t), GOES_WITH(J21_PORT,SAME_NOT_SAME,WHAT,RIGHT,IN,EXACTLY_ONE,t)
 THEN GOES_WITH(J21_ROUTE_CONTACT,m,RESULT,c,RIGHT);
// Imported static kernel 8B983301:565-567: endpoint membership, separately
// from :530-561 placement/capability/containment. No full DRC verdict here.
law J21_ENDPOINT_MEMBERSHIP := IF GOES_WITH(J21_ROUTE_CONTACT,m,RESULT,c,role), THIS(J21_CELL_MEMBER,m), THIS(J21_CELL_MEMBER,c)
 THEN GOES_WITH(J21_ENDPOINT_MEMBERSHIP,m,RESULT,c,role);

// The promoted readout applies to the CCC face actually containing this flag.
// Its parent witness label alone does not make a CCD triangle the CCC face.
law J21_CCC_MARKER := IF GOES_WITH(J21_COORDINATE,m,INCIDENCE(v,e,TOGETHER_ALONE(a,b,c)),PARENT(w)), GOES_WITH(DG_FACE,w,a,b,c), GOES_WITH(WORLD_JUNCTION_SITE,v,j)
 THEN GOES_WITH(J21_CCC_MARKER,m,w,j);
law J21_CCC_OWN_ROLE := IF GOES_WITH(J21_CCC_MARKER,m,w,j), GOES_WITH(SF_FACE_ROLE,w,j,d)
 THEN GOES_WITH(J21_CCC_OWN_ROLE,m,w,j,d);
law J21_CCC_OWN_TIE := IF GOES_WITH(J21_CCC_MARKER,m,w,j), GOES_WITH(SF_PLACEMENT_PENDING,w,j,MAYBE)
 THEN GOES_WITH(J21_CCC_OWN_TIE,m,w,j,MAYBE);
law J21_ROUTE_OWN_TIE := IF GOES_WITH(J21_ROUTE_CONTACT,m,RESULT,c,role), GOES_WITH(J21_CCC_OWN_TIE,m,w,j,MAYBE)
 THEN GOES_WITH(J21_ROUTE_OWN_TIE,m,RESULT,c,role,w,j,MAYBE);

// Explicit CCD incidence witnesses, without a modal role imported from a
// different face. The readout's CCC-only scope is retained.
law J21_CCD_DOMAIN_A := IF GOES_WITH(J21_COORDINATE,m,INCIDENCE(v,e,TOGETHER_ALONE(THIS(d),a,b)),PARENT(w))
 THEN GOES_WITH(J21_CCD_MARKER,m,w,THIS(d));
law J21_CCD_DOMAIN_B := IF GOES_WITH(J21_COORDINATE,m,INCIDENCE(v,e,TOGETHER_ALONE(a,THIS(d),b)),PARENT(w))
 THEN GOES_WITH(J21_CCD_MARKER,m,w,THIS(d));
law J21_CCD_DOMAIN_C := IF GOES_WITH(J21_COORDINATE,m,INCIDENCE(v,e,TOGETHER_ALONE(a,b,THIS(d))),PARENT(w))
 THEN GOES_WITH(J21_CCD_MARKER,m,w,THIS(d));
