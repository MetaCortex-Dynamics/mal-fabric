// Actual source incidence; no authority is assigned by endpoint order.
law A13_OFFER_SOURCE := IF GOES_WITH(VD_LIFT_GEOMETRY,c,LIFT(TOGETHER_ALONE(v,e,t),via,to))
 THEN GOES_WITH(A13_OFFER_SOURCE,c,LIFT(TOGETHER_ALONE(v,e,t),via,to),v,TOGETHER_ALONE(v,e,t));
law A13_CORRIDOR := IF GOES_WITH(A13_OFFER_SOURCE,c,l,v,f), GOES_WITH(WORLD_JUNCTION_SITE,v,j), GOES_WITH(HARDWARE_EDGE,j,a,b)
 THEN GOES_WITH(A13_OFFER_CORRIDOR,c,l,j,a,b);
law A13_FACE := IF GOES_WITH(A13_OFFER_SOURCE,c,l,v,f), GOES_WITH(WORLD_FLAG_FACE,f,w)
 THEN GOES_WITH(A13_SOURCE_FACE,c,l,w);
law A13_CARRIER := IF GOES_WITH(HARDWARE_EDGE,j,a,b)
 THEN GOES_WITH(A12_CORRIDOR,j,a,b);
law A13_OFFER := IF GOES_WITH(VD_LIFT_GEOMETRY,c,l), THIS(A13_BINDING,INPUTS(set,state,readback))
 THEN GOES_WITH(A12_OFFER,PROPOSAL(set,c),state,l,FIELD_EVIDENCE(readback,c,l));
