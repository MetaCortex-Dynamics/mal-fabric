// User-authorized diagnostic field assignments. Not ENGINE offer membership.
// Uses the exact field, parts, overlap, move and distinction predicates of 008.
// SITE(v,r): set every flag whose site is v to r; retain all other flags.
// UNIFORM(r) and BOUNDARY_GROW are separate checks, not extra site offers.
// No entity, selection, runtime admission, worldline or repository commit.

law SC_SITE := IF GOES_WITH(KD_PARTS,f,v,e,t) THEN THIS(SC_SITE,v);
law SC_SITE_THIS := IF THIS(SC_SITE,v) THEN THIS(SC_CASE,SITE(v,"THIS"));
law SC_SITE_NO := IF THIS(SC_SITE,v) THEN THIS(SC_CASE,SITE(v,"NO"));
law SC_SITE_INSIDE := IF THIS(SC_CASE,SITE(v,r)), GOES_WITH(KD_PARTS,f,v,e,t) THEN GOES_WITH(SC_FIELD,SITE(v,r),f,r);
law SC_SITE_COMPARE := IF THIS(SC_SITE,v), THIS(SC_SITE,w) THEN GOES_WITH(KD_DIFF_REQUEST,v,w);
law SC_SITE_OUTSIDE := IF THIS(SC_CASE,SITE(v,r)), GOES_WITH(KD_PARTS,f,w,e,t), GOES_WITH(KD_DIFF,w,v), GOES_WITH(KD_FIELD,f,old) THEN GOES_WITH(SC_FIELD,SITE(v,r),f,old);
law SC_UNIFORM_THIS := IF THIS(SC_SITE,v) THEN THIS(SC_CASE,UNIFORM("THIS"));
law SC_UNIFORM_NO := IF THIS(SC_SITE,v) THEN THIS(SC_CASE,UNIFORM("NO"));
law SC_UNIFORM_FIELD := IF THIS(SC_CASE,UNIFORM(r)), GOES_WITH(KD_FIELD,f,old) THEN GOES_WITH(SC_FIELD,UNIFORM(r),f,r);

// The proposed grow-boundary check: exactly NO endpoints of existing walls.
law SC_BOUNDARY_CASE := IF GOES_WITH(KD_WITNESS,a,b,"NOT_SAME") THEN THIS(SC_CASE,BOUNDARY_GROW);
law SC_BOUNDARY_A := IF GOES_WITH(KD_WITNESS,a,b,"NOT_SAME"), GOES_WITH(KD_FIELD,a,"NO") THEN THIS(SC_BOUNDARY_FLAG,a);
law SC_BOUNDARY_B := IF GOES_WITH(KD_WITNESS,a,b,"NOT_SAME"), GOES_WITH(KD_FIELD,b,"NO") THEN THIS(SC_BOUNDARY_FLAG,b);
law SC_BOUNDARY_SET := IF THIS(SC_BOUNDARY_FLAG,f) THEN GOES_WITH(SC_FIELD,BOUNDARY_GROW,f,"THIS");
law SC_BOUNDARY_KEEP_THIS := IF THIS(SC_CASE,BOUNDARY_GROW), GOES_WITH(KD_FIELD,f,"THIS") THEN GOES_WITH(SC_FIELD,BOUNDARY_GROW,f,"THIS");
law SC_BOUNDARY_KEEP_NO := IF THIS(SC_CASE,BOUNDARY_GROW), GOES_WITH(KD_FIELD,f,"NO"), GOES_WITH(KD_INCIDENT,f,DELTA,a,b,"SAME"), GOES_WITH(KD_INCIDENT,f,GAMMA,c,d,"SAME"), GOES_WITH(KD_INCIDENT,f,TAU,e,g,"SAME") THEN GOES_WITH(SC_FIELD,BOUNDARY_GROW,f,"NO");

// Evaluate all 720 overlaps for every case, not just its changed boundary.
law SC_AFTER_SAME := IF THIS(SC_CASE,m), GOES_WITH(KD_BASE_BOUND,a,b,old), GOES_WITH(SC_FIELD,m,a,r), GOES_WITH(SC_FIELD,m,b,r) THEN GOES_WITH(SC_AFTER,m,a,b,old,"SAME");
law SC_AFTER_DIFF_A := IF THIS(SC_CASE,m), GOES_WITH(KD_BASE_BOUND,a,b,old), GOES_WITH(SC_FIELD,m,a,"THIS"), GOES_WITH(SC_FIELD,m,b,"NO") THEN GOES_WITH(SC_AFTER,m,a,b,old,"NOT_SAME");
law SC_AFTER_DIFF_B := IF THIS(SC_CASE,m), GOES_WITH(KD_BASE_BOUND,a,b,old), GOES_WITH(SC_FIELD,m,a,"NO"), GOES_WITH(SC_FIELD,m,b,"THIS") THEN GOES_WITH(SC_AFTER,m,a,b,old,"NOT_SAME");
law SC_OPENED := IF GOES_WITH(SC_AFTER,m,a,b,"SAME","NOT_SAME") THEN GOES_WITH(SC_OPENED,m,a,b);
law SC_DISCHARGED := IF GOES_WITH(SC_AFTER,m,a,b,"NOT_SAME","SAME") THEN GOES_WITH(SC_DISCHARGED,m,a,b);
law SC_RETAINED := IF GOES_WITH(SC_AFTER,m,a,b,"NOT_SAME","NOT_SAME") THEN GOES_WITH(SC_RETAINED,m,a,b);
law SC_CHANGE_THIS := IF GOES_WITH(KD_FIELD,f,"NO"), GOES_WITH(SC_FIELD,m,f,"THIS") THEN GOES_WITH(SC_CHANGED,m,f,"NO","THIS");
law SC_CHANGE_NO := IF GOES_WITH(KD_FIELD,f,"THIS"), GOES_WITH(SC_FIELD,m,f,"NO") THEN GOES_WITH(SC_CHANGED,m,f,"THIS","NO");

// A coverage hierarchy is generic transport of the complete witness array.
// Leaves reference its JSON rows; pair nodes only group execution. No node
// creates, drops, orders a move, or chooses a field reading.
law SC_COVER_LEAF := IF GOES_WITH(SC_WITNESS_LEAF,leaf,a,b,old), GOES_WITH(SC_AFTER,m,a,b,old,next) THEN GOES_WITH(SC_COVER,m,leaf);
law SC_COVER_PAIR := IF GOES_WITH(SC_COVER_PAIR,node,left,right), GOES_WITH(SC_COVER,m,left), GOES_WITH(SC_COVER,m,right) THEN GOES_WITH(SC_COVER,m,node);
law SC_COMPLETE := IF THIS(SC_COVER_ROOT,root), GOES_WITH(SC_COVER,m,root) THEN THIS(SC_COMPLETE,m);
law SC_NO_OPEN_SAME := IF GOES_WITH(SC_AFTER,m,a,b,old,"SAME") THEN GOES_WITH(SC_NO_OPEN,m,a,b);
law SC_NO_OPEN_RETAINED := IF GOES_WITH(SC_AFTER,m,a,b,"NOT_SAME","NOT_SAME") THEN GOES_WITH(SC_NO_OPEN,m,a,b);
law SC_NO_DISCHARGE_SAME := IF GOES_WITH(SC_AFTER,m,a,b,"SAME",next) THEN GOES_WITH(SC_NO_DISCHARGE,m,a,b);
law SC_NO_DISCHARGE_RETAINED := IF GOES_WITH(SC_AFTER,m,a,b,"NOT_SAME","NOT_SAME") THEN GOES_WITH(SC_NO_DISCHARGE,m,a,b);
law SC_EMPTY_OPEN_LEAF := IF GOES_WITH(SC_WITNESS_LEAF,leaf,a,b,old), GOES_WITH(SC_NO_OPEN,m,a,b) THEN GOES_WITH(SC_EMPTY_OPEN,m,leaf);
law SC_EMPTY_OPEN_PAIR := IF GOES_WITH(SC_COVER_PAIR,node,left,right), GOES_WITH(SC_EMPTY_OPEN,m,left), GOES_WITH(SC_EMPTY_OPEN,m,right) THEN GOES_WITH(SC_EMPTY_OPEN,m,node);
law SC_EMPTY_DISCHARGE_LEAF := IF GOES_WITH(SC_WITNESS_LEAF,leaf,a,b,old), GOES_WITH(SC_NO_DISCHARGE,m,a,b) THEN GOES_WITH(SC_EMPTY_DISCHARGE,m,leaf);
law SC_EMPTY_DISCHARGE_PAIR := IF GOES_WITH(SC_COVER_PAIR,node,left,right), GOES_WITH(SC_EMPTY_DISCHARGE,m,left), GOES_WITH(SC_EMPTY_DISCHARGE,m,right) THEN GOES_WITH(SC_EMPTY_DISCHARGE,m,node);
law SC_STRICT := IF THIS(SC_COMPLETE,m), THIS(SC_COVER_ROOT,root), GOES_WITH(SC_EMPTY_OPEN,m,root), GOES_WITH(SC_DISCHARGED,m,a,b) THEN THIS(SC_STRICT,m);
law SC_NOT_STRICT_OPEN := IF THIS(SC_COMPLETE,m), GOES_WITH(SC_OPENED,m,a,b) THEN GOES_WITH(SC_NOT_STRICT,m,OPENED_NONEMPTY);
law SC_NOT_STRICT_EMPTY := IF THIS(SC_COMPLETE,m), THIS(SC_COVER_ROOT,root), GOES_WITH(SC_EMPTY_DISCHARGE,m,root) THEN GOES_WITH(SC_NOT_STRICT,m,DISCHARGED_EMPTY);

// Exhaust all 480 one-flag inversions, with three incident overlaps each.
law SC_SINGLE_THIS := IF GOES_WITH(KD_FIELD,f,"NO") THEN GOES_WITH(SC_SINGLE,f,"NO","THIS");
law SC_SINGLE_NO := IF GOES_WITH(KD_FIELD,f,"THIS") THEN GOES_WITH(SC_SINGLE,f,"THIS","NO");
law SC_SINGLE_A := IF GOES_WITH(SC_SINGLE,f,old,r), GOES_WITH(KD_INCIDENT,f,k,f,b,prior), GOES_WITH(KD_FIELD,b,s) THEN GOES_WITH(SC_SINGLE_PAIR,f,k,f,b,prior,r,s);
law SC_SINGLE_B := IF GOES_WITH(SC_SINGLE,f,old,r), GOES_WITH(KD_INCIDENT,f,k,a,f,prior), GOES_WITH(KD_FIELD,a,s) THEN GOES_WITH(SC_SINGLE_PAIR,f,k,a,f,prior,s,r);
law SC_SINGLE_AFTER_SAME := IF GOES_WITH(SC_SINGLE_PAIR,f,k,a,b,prior,r,r) THEN GOES_WITH(SC_SINGLE_AFTER,f,k,a,b,prior,"SAME");
law SC_SINGLE_AFTER_DIFF_A := IF GOES_WITH(SC_SINGLE_PAIR,f,k,a,b,prior,"THIS","NO") THEN GOES_WITH(SC_SINGLE_AFTER,f,k,a,b,prior,"NOT_SAME");
law SC_SINGLE_AFTER_DIFF_B := IF GOES_WITH(SC_SINGLE_PAIR,f,k,a,b,prior,"NO","THIS") THEN GOES_WITH(SC_SINGLE_AFTER,f,k,a,b,prior,"NOT_SAME");
law SC_SINGLE_OPEN := IF GOES_WITH(SC_SINGLE_AFTER,f,k,a,b,"SAME","NOT_SAME") THEN GOES_WITH(SC_SINGLE_OPEN,f,k,a,b);
law SC_SINGLE_DISCHARGE := IF GOES_WITH(SC_SINGLE_AFTER,f,k,a,b,"NOT_SAME","SAME") THEN GOES_WITH(SC_SINGLE_DISCHARGE,f,k,a,b);
law SC_SINGLE_EXAMINED := IF GOES_WITH(SC_SINGLE_AFTER,f,k,a,b,old,next) THEN GOES_WITH(SC_SINGLE_EXAMINED,f,k);
law SC_SINGLE_COMPLETE := IF GOES_WITH(SC_SINGLE_EXAMINED,f,DELTA), GOES_WITH(SC_SINGLE_EXAMINED,f,GAMMA), GOES_WITH(SC_SINGLE_EXAMINED,f,TAU) THEN THIS(SC_SINGLE_COMPLETE,f);
law SC_SINGLE_NOT_STRICT := IF THIS(SC_SINGLE_COMPLETE,f), GOES_WITH(SC_SINGLE_OPEN,f,k,a,b) THEN THIS(SC_SINGLE_NOT_STRICT,f);

// Explicit input geometry witnesses used by the user's boundary claim.
law SC_THIS_INTERNAL := IF GOES_WITH(KD_INCIDENT,a,k,a,b,"SAME"), GOES_WITH(KD_FIELD,a,"THIS"), GOES_WITH(KD_FIELD,b,"THIS") THEN GOES_WITH(SC_THIS_INTERNAL,k,a,b);
law SC_OLD_WALL := IF GOES_WITH(KD_INCIDENT,a,k,a,b,"NOT_SAME") THEN GOES_WITH(SC_OLD_WALL,k,a,b);
