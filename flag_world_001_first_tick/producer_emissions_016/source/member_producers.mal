// Member-restricted producer AUTHOR candidate 016.
// AUTHOR contact: SPEC_MAL_SPECIFICATION_SYSTEM_002.mal :91-93,171-173,
// SHA256 FF85EE5F18813F7D64CE7BF275EBEA2F1FF581B32431D232FA4FD2B5B4E7E093.
// These two readings per producer are authored Phase-1 implementation content,
// not a claim that syntax uniquely determines a coordinate mapping.
// THIS x WHAT: the exact source-bound member restriction, NOT the OfferedSet.
// BECAUSE x HOW: this producer's own construction/binding proof reference.
// IF_THEN below records the contacted construction. It is neither the field
// reading NO, the receipt reading THIS, nor a hash renamed as a verdict.
// The record/domain declaration emits before content joins. Missing contact
// cannot turn a shared declared coordinate into a private coordinate.
// The other 43 basis coordinates have no declarations in this candidate.
// Their PENDING status is observational; absence never emits UNSUPPORTED.
// No grants, authorization conclusion, seal, admission, law promotion,
// successor execution or worldchain link is emitted.
//
// All inputs are custody-verified transport of existing record/native bytes:
// GOES_WITH(P16_SOURCE_RESTRICTION,source,m,memberRef,promoteRecord).
// GOES_WITH(P16_PRODUCER_RECORD,source,m,role,recordRef,domainRef).
// THIS(SC_CASE,m), with
// GOES_WITH(P16_CASE_SUPPORT,source,recordRef,THIS(SC_CASE,m),memberRef,proofId).
// THIS(SC_STRICT,m), with the analogous P16_STRICT_SUPPORT.
// GOES_WITH(P16_PROMOTE_MEMBER,source,promoteRecord,m,memberRef,proofId).
// GOES_WITH(P16_PROOF_CONTENT,source,recordRef,subject,proofId,PRESENT(bits)).
//   subject = P16_PROOF_SUBJECT(THIS(SC_CASE,m),memberRef), or
//             P16_PROOF_SUBJECT(THIS(SC_STRICT,m),memberRef), or
//             P16_PROMOTED_MEMBER(m,memberRef).
// GOES_WITH(P16_MEMBER_CONTENT,source,m,memberRef,PRESENT(bits)).
// Reference identity and its transported bit content are separate operands.
// Transport binds proofId to its exact source, record, native fact/member and
// proof-content bytes; this file does not authenticate arbitrary caller facts.

@propose seed P16_SUPPORTED_COORDINATES := {
  GOES_WITH(P16_SUPPORTED_SCHEMA,PROPOSE,POSITION(THIS,WHAT)),
  GOES_WITH(P16_SUPPORTED_SCHEMA,PROPOSE,POSITION(BECAUSE,HOW)),
  GOES_WITH(P16_SUPPORTED_SCHEMA,DECIDE,POSITION(THIS,WHAT)),
  GOES_WITH(P16_SUPPORTED_SCHEMA,DECIDE,POSITION(BECAUSE,HOW)),
  GOES_WITH(P16_SUPPORTED_SCHEMA,PROMOTE,POSITION(THIS,WHAT)),
  GOES_WITH(P16_SUPPORTED_SCHEMA,PROMOTE,POSITION(BECAUSE,HOW))
};

// Producer identity preserves source, member, role and record identity.
// PROMOTE must name the exact restriction's binding record.
law P16_PROPOSE_OWNER := IF GOES_WITH(P16_SOURCE_RESTRICTION,s,m,mr,pr), GOES_WITH(P16_PRODUCER_RECORD,s,m,PROPOSE,r,d) THEN GOES_WITH(P16_OWNER,P16_PRODUCER_ID(s,m,PROPOSE,r),d,mr,pr);
law P16_DECIDE_OWNER := IF GOES_WITH(P16_SOURCE_RESTRICTION,s,m,mr,pr), GOES_WITH(P16_PRODUCER_RECORD,s,m,DECIDE,r,d) THEN GOES_WITH(P16_OWNER,P16_PRODUCER_ID(s,m,DECIDE,r),d,mr,pr);
law P16_PROMOTE_OWNER := IF GOES_WITH(P16_SOURCE_RESTRICTION,s,m,mr,pr), GOES_WITH(P16_PRODUCER_RECORD,s,m,PROMOTE,pr,d) THEN GOES_WITH(P16_OWNER,P16_PRODUCER_ID(s,m,PROMOTE,pr),d,mr,pr);

law P16_EMIT_PRODUCER := IF GOES_WITH(P16_OWNER,P16_PRODUCER_ID(s,m,role,r),d,mr,pr) THEN GOES_WITH(P15_PRODUCER,P16_PRODUCER_ID(s,m,role,r),role,r,d);
law P16_DECLARE_COORDINATE := IF GOES_WITH(P16_OWNER,P16_PRODUCER_ID(s,m,role,r),d,mr,pr), GOES_WITH(P16_SUPPORTED_SCHEMA,role,pos) THEN GOES_WITH(P15_DECLARE,P16_PRODUCER_ID(s,m,role,r),d,pos,SUPPORTED);

// Qualified support and raw native fact must agree on the same member. The
// proof-content join additionally retains source, own record and proof identity.
law P16_PROPOSE_CONTACT_PROOF := IF GOES_WITH(P16_OWNER,P16_PRODUCER_ID(s,m,PROPOSE,r),d,mr,pr), THIS(SC_CASE,m), GOES_WITH(P16_CASE_SUPPORT,s,r,THIS(SC_CASE,m),mr,pf), GOES_WITH(P16_PROOF_CONTENT,s,r,P16_PROOF_SUBJECT(THIS(SC_CASE,m),mr),pf,PRESENT(bits)) THEN GOES_WITH(P16_CONTACT_PROOF,P16_PRODUCER_ID(s,m,PROPOSE,r),d,mr,PRESENT(bits));
law P16_DECIDE_CONTACT_PROOF := IF GOES_WITH(P16_OWNER,P16_PRODUCER_ID(s,m,DECIDE,r),d,mr,pr), THIS(SC_STRICT,m), GOES_WITH(P16_STRICT_SUPPORT,s,r,THIS(SC_STRICT,m),mr,pf), GOES_WITH(P16_PROOF_CONTENT,s,r,P16_PROOF_SUBJECT(THIS(SC_STRICT,m),mr),pf,PRESENT(bits)) THEN GOES_WITH(P16_CONTACT_PROOF,P16_PRODUCER_ID(s,m,DECIDE,r),d,mr,PRESENT(bits));
law P16_PROMOTE_CONTACT_PROOF := IF GOES_WITH(P16_OWNER,P16_PRODUCER_ID(s,m,PROMOTE,pr),d,mr,pr), GOES_WITH(P16_PROMOTE_MEMBER,s,pr,m,mr,pf), GOES_WITH(P16_PROOF_CONTENT,s,pr,P16_PROMOTED_MEMBER(m,mr),pf,PRESENT(bits)) THEN GOES_WITH(P16_CONTACT_PROOF,P16_PRODUCER_ID(s,m,PROMOTE,pr),d,mr,PRESENT(bits));

// The native member restriction supplies common WHAT content; proof content
// remains producer-specific. No equal proof bytes are manufactured here.
law P16_EMIT_MEMBER_CONTACT := IF GOES_WITH(P16_CONTACT_PROOF,P16_PRODUCER_ID(s,m,role,r),d,mr,proof), GOES_WITH(P16_MEMBER_CONTENT,s,m,mr,PRESENT(bits)) THEN GOES_WITH(P15_CONTACT,P16_PRODUCER_ID(s,m,role,r),r,POSITION(THIS,WHAT),"IF_THEN",PRESENT(bits));
law P16_EMIT_PROOF_CONTACT := IF GOES_WITH(P16_CONTACT_PROOF,P16_PRODUCER_ID(s,m,role,r),d,mr,proof) THEN GOES_WITH(P15_CONTACT,P16_PRODUCER_ID(s,m,role,r),r,POSITION(BECAUSE,HOW),"IF_THEN",proof);
