// Bounded diagnostic authorized in the current user request; not promoted law.
// Native contacts: vector_displacement.mal 22192EBA...3F8F :132-168,223-253.
// Every target allowed by those clauses is included; no entity name is invented.
// THIS source flags are diagnostic loci, not an inferred entity inventory.
// Replacing a declared base move by this union is NOT promoted by this run.
// No selection, current field write, fabric admission, or worldline append.
// Input wrappers transport exact g2 field/witness rows without semantic work.

law KD_FIELD_ROW := IF THIS(KD_INPUT_FIELD_ROW,ARRAY(CONS(f,CONS(r,NIL)))) THEN GOES_WITH(KD_FIELD,f,r);
law KD_PARTS := IF GOES_WITH(KD_FIELD,ARRAY(CONS(v,CONS(e,CONS(t,NIL)))),r) THEN GOES_WITH(KD_PARTS,ARRAY(CONS(v,CONS(e,CONS(t,NIL)))),v,e,t);
law KD_WITNESS_ROW := IF THIS(KD_INPUT_WITNESS_ROW,ARRAY(CONS(a,CONS(b,CONS(r,NIL))))) THEN GOES_WITH(KD_WITNESS,a,b,r);
law KD_BASE_SAME := IF GOES_WITH(KD_WITNESS,a,b,r), GOES_WITH(KD_FIELD,a,x), GOES_WITH(KD_FIELD,b,x) THEN GOES_WITH(KD_BASELINE,a,b,"SAME");
law KD_BASE_DIFFER_A := IF GOES_WITH(KD_WITNESS,a,b,r), GOES_WITH(KD_FIELD,a,"THIS"), GOES_WITH(KD_FIELD,b,"NO") THEN GOES_WITH(KD_BASELINE,a,b,"NOT_SAME");
law KD_BASE_DIFFER_B := IF GOES_WITH(KD_WITNESS,a,b,r), GOES_WITH(KD_FIELD,a,"NO"), GOES_WITH(KD_FIELD,b,"THIS") THEN GOES_WITH(KD_BASELINE,a,b,"NOT_SAME");
law KD_BASE_BOUND := IF GOES_WITH(KD_WITNESS,a,b,r), GOES_WITH(KD_BASELINE,a,b,r) THEN GOES_WITH(KD_BASE_BOUND,a,b,r);

// Delta/gamma/tau are read by the two shared coordinates of an overlap.
// The committed witness has distinct endpoint flags. Input hash is bound.
law KD_DELTA := IF GOES_WITH(KD_BASE_BOUND,a,b,r), GOES_WITH(KD_PARTS,a,v,e,t), GOES_WITH(KD_PARTS,b,w,e,t) THEN GOES_WITH(KD_INCIDENT,a,DELTA,a,b,r);
law KD_GAMMA := IF GOES_WITH(KD_BASE_BOUND,a,b,r), GOES_WITH(KD_PARTS,a,v,e,t), GOES_WITH(KD_PARTS,b,v,q,t) THEN GOES_WITH(KD_INCIDENT,a,GAMMA,a,b,r);
law KD_TAU := IF GOES_WITH(KD_BASE_BOUND,a,b,r), GOES_WITH(KD_PARTS,a,v,e,t), GOES_WITH(KD_PARTS,b,v,e,u) THEN GOES_WITH(KD_INCIDENT,a,TAU,a,b,r);
law KD_INCIDENT_OTHER := IF GOES_WITH(KD_INCIDENT,a,k,a,b,r) THEN GOES_WITH(KD_INCIDENT,b,k,a,b,r);
law KD_MOVE_FORWARD := IF GOES_WITH(KD_INCIDENT,a,k,a,b,r) THEN GOES_WITH(KD_MOVE,k,a,b);
law KD_MOVE_REVERSE := IF GOES_WITH(KD_INCIDENT,a,k,a,b,r) THEN GOES_WITH(KD_MOVE,k,b,a);

// The source's target-bound lift relation, unioned over ALL eligible targets.
law KD_SITE_OFFER := IF GOES_WITH(KD_FIELD,f,"THIS"), GOES_WITH(KD_PARTS,f,v,e,t), GOES_WITH(KD_MOVE,DELTA,g,h), GOES_WITH(KD_PARTS,g,v,q,u), GOES_WITH(KD_PARTS,h,d,q,u) THEN THIS(KD_OFFER,MOVE("site",d,f,g,h));
law KD_EDGE_OFFER := IF GOES_WITH(KD_FIELD,f,"THIS"), GOES_WITH(KD_MOVE,GAMMA,f,h), GOES_WITH(KD_PARTS,h,v,e,t) THEN THIS(KD_OFFER,MOVE("edge",e,f,f,h));
law KD_TRIAD_OFFER := IF GOES_WITH(KD_FIELD,f,"THIS"), GOES_WITH(KD_PARTS,f,v,e,t), GOES_WITH(KD_MOVE,TAU,g,h), GOES_WITH(KD_PARTS,g,s,q,t), GOES_WITH(KD_PARTS,h,s,q,u) THEN THIS(KD_OFFER,MOVE("triad",u,f,g,h));
law KD_BASE_MOVE := IF THIS(KD_OFFER,MOVE(k,t,f,g,h)) THEN GOES_WITH(KD_BASE_MOVE,f,k,t);
law KD_WRITE_CONFLICT := IF THIS(KD_OFFER,MOVE(k,t,f,g,f)) THEN THIS(KD_WRITE_CONFLICT,MOVE(k,t,f,g,f));
law KD_LOCAL_EFFECT := IF THIS(KD_OFFER,MOVE(k,t,f,g,h)) THEN GOES_WITH(KD_LOCAL_EFFECT,MOVE(k,t,f,g,h),WRITE(f,"NO"),WRITE(h,"THIS"),RETAIN_OTHER_FLAGS);
law KD_ENDPOINT_FROM := IF THIS(KD_OFFER,MOVE(k,t,f,g,h)) THEN GOES_WITH(KD_ENDPOINT,MOVE(k,t,f,g,h),FROM,f);
law KD_ENDPOINT_TO := IF THIS(KD_OFFER,MOVE(k,t,f,g,h)) THEN GOES_WITH(KD_ENDPOINT,MOVE(k,t,f,g,h),TO,h);
law KD_AFFECTED := IF GOES_WITH(KD_ENDPOINT,m,side,f), GOES_WITH(KD_INCIDENT,f,k,a,b,r) THEN GOES_WITH(KD_AFFECTED,m,a,b,r);
law KD_READ_A := IF GOES_WITH(KD_AFFECTED,m,a,b,r) THEN GOES_WITH(KD_READ,m,a);
law KD_READ_B := IF GOES_WITH(KD_AFFECTED,m,a,b,r) THEN GOES_WITH(KD_READ,m,b);
law KD_FROM_READING := IF THIS(KD_OFFER,MOVE(k,t,f,g,h)), GOES_WITH(KD_READ,MOVE(k,t,f,g,h),f) THEN GOES_WITH(KD_AFTER_FLAG,MOVE(k,t,f,g,h),f,"NO");
law KD_TO_READING := IF THIS(KD_OFFER,MOVE(k,t,f,g,h)), GOES_WITH(KD_READ,MOVE(k,t,f,g,h),h) THEN GOES_WITH(KD_AFTER_FLAG,MOVE(k,t,f,g,h),h,"THIS");
law KD_COMPARE_FROM := IF GOES_WITH(KD_READ,MOVE(k,t,f,g,h),x) THEN GOES_WITH(KD_DIFF_REQUEST,x,f);
law KD_COMPARE_TO := IF GOES_WITH(KD_READ,MOVE(k,t,f,g,h),x) THEN GOES_WITH(KD_DIFF_REQUEST,x,h);
law KD_RETAIN_READING := IF GOES_WITH(KD_READ,MOVE(k,t,f,g,h),x), GOES_WITH(KD_DIFF,x,f), GOES_WITH(KD_DIFF,x,h), GOES_WITH(KD_FIELD,x,r) THEN GOES_WITH(KD_AFTER_FLAG,MOVE(k,t,f,g,h),x,r);

// Exact symmetric byte distinction. The byte chain is encoding only: neither
// direction supplies a base move, priority, modality, hand or selected lift.
law KD_BYTE_SPAN := IF GOES_WITH(KD_BYTE_NEXT,a,b) THEN GOES_WITH(KD_BYTE_SPAN,a,b);
law KD_BYTE_SPAN_MORE := IF GOES_WITH(KD_BYTE_SPAN,a,b), GOES_WITH(KD_BYTE_NEXT,b,c) THEN GOES_WITH(KD_BYTE_SPAN,a,c);
law KD_BYTE_DIFFER_F := IF GOES_WITH(KD_BYTE_SPAN,a,b) THEN GOES_WITH(KD_BYTE_DIFFER,a,b);
law KD_BYTE_DIFFER_R := IF GOES_WITH(KD_BYTE_SPAN,a,b) THEN GOES_WITH(KD_BYTE_DIFFER,b,a);
law KD_TEXT_REQUEST := IF GOES_WITH(KD_DIFF_REQUEST,TEXT(a),TEXT(b)) THEN GOES_WITH(KD_TEXT_REQUEST,a,b);
law KD_TEXT_PREFIX := IF GOES_WITH(KD_TEXT_REQUEST,CONS(a,x),CONS(a,y)) THEN GOES_WITH(KD_TEXT_REQUEST,x,y);
law KD_TEXT_HEAD_DIFF := IF GOES_WITH(KD_TEXT_REQUEST,CONS(a,x),CONS(b,y)), GOES_WITH(KD_BYTE_DIFFER,a,b) THEN GOES_WITH(KD_TEXT_DIFF,CONS(a,x),CONS(b,y));
law KD_TEXT_LEFT_END := IF GOES_WITH(KD_TEXT_REQUEST,NIL,CONS(a,t)) THEN GOES_WITH(KD_TEXT_DIFF,NIL,CONS(a,t));
law KD_TEXT_RIGHT_END := IF GOES_WITH(KD_TEXT_REQUEST,CONS(a,t),NIL) THEN GOES_WITH(KD_TEXT_DIFF,CONS(a,t),NIL);
law KD_TEXT_DIFF_PREFIX := IF GOES_WITH(KD_TEXT_REQUEST,CONS(a,x),CONS(a,y)), GOES_WITH(KD_TEXT_DIFF,x,y) THEN GOES_WITH(KD_TEXT_DIFF,CONS(a,x),CONS(a,y));
law KD_TEXT_DIFF := IF GOES_WITH(KD_DIFF_REQUEST,TEXT(a),TEXT(b)), GOES_WITH(KD_TEXT_DIFF,a,b) THEN GOES_WITH(KD_DIFF,TEXT(a),TEXT(b));
law KD_ARRAY_REQUEST := IF GOES_WITH(KD_DIFF_REQUEST,ARRAY(a),ARRAY(b)) THEN GOES_WITH(KD_LIST_REQUEST,a,b);
law KD_LIST_HEAD := IF GOES_WITH(KD_LIST_REQUEST,CONS(a,x),CONS(b,y)) THEN GOES_WITH(KD_DIFF_REQUEST,a,b);
law KD_LIST_TAIL := IF GOES_WITH(KD_LIST_REQUEST,CONS(a,x),CONS(b,y)) THEN GOES_WITH(KD_LIST_REQUEST,x,y);
law KD_LIST_HEAD_DIFF := IF GOES_WITH(KD_LIST_REQUEST,CONS(a,x),CONS(b,y)), GOES_WITH(KD_DIFF,a,b) THEN GOES_WITH(KD_LIST_DIFF,CONS(a,x),CONS(b,y));
law KD_LIST_TAIL_DIFF := IF GOES_WITH(KD_LIST_REQUEST,CONS(a,x),CONS(b,y)), GOES_WITH(KD_LIST_DIFF,x,y) THEN GOES_WITH(KD_LIST_DIFF,CONS(a,x),CONS(b,y));
law KD_ARRAY_DIFF := IF GOES_WITH(KD_DIFF_REQUEST,ARRAY(a),ARRAY(b)), GOES_WITH(KD_LIST_DIFF,a,b) THEN GOES_WITH(KD_DIFF,ARRAY(a),ARRAY(b));

// Only overlaps incident to FROM or TO can change under RETAIN_OTHER_FLAGS.
// This exhausts the receipt difference without recomputing unchanged overlaps.
law KD_AFTER_SAME := IF GOES_WITH(KD_AFFECTED,m,a,b,old), GOES_WITH(KD_AFTER_FLAG,m,a,r), GOES_WITH(KD_AFTER_FLAG,m,b,r) THEN GOES_WITH(KD_AFTER_OVERLAP,m,a,b,old,"SAME");
law KD_AFTER_DIFF_A := IF GOES_WITH(KD_AFFECTED,m,a,b,old), GOES_WITH(KD_AFTER_FLAG,m,a,"THIS"), GOES_WITH(KD_AFTER_FLAG,m,b,"NO") THEN GOES_WITH(KD_AFTER_OVERLAP,m,a,b,old,"NOT_SAME");
law KD_AFTER_DIFF_B := IF GOES_WITH(KD_AFFECTED,m,a,b,old), GOES_WITH(KD_AFTER_FLAG,m,a,"NO"), GOES_WITH(KD_AFTER_FLAG,m,b,"THIS") THEN GOES_WITH(KD_AFTER_OVERLAP,m,a,b,old,"NOT_SAME");
law KD_DISCHARGED := IF GOES_WITH(KD_AFTER_OVERLAP,m,a,b,"NOT_SAME","SAME") THEN GOES_WITH(KD_DISCHARGED,m,a,b);
law KD_OPENED := IF GOES_WITH(KD_AFTER_OVERLAP,m,a,b,"SAME","NOT_SAME") THEN GOES_WITH(KD_OPENED,m,a,b);
law KD_NO_OPEN_SAME := IF GOES_WITH(KD_AFTER_OVERLAP,m,a,b,old,"SAME") THEN GOES_WITH(KD_NO_OPEN,m,a,b);
law KD_NO_OPEN_RETAINED := IF GOES_WITH(KD_AFTER_OVERLAP,m,a,b,"NOT_SAME","NOT_SAME") THEN GOES_WITH(KD_NO_OPEN,m,a,b);
law KD_SIDE_EXAMINED := IF GOES_WITH(KD_ENDPOINT,m,side,f), GOES_WITH(KD_INCIDENT,f,k,a,b,r), GOES_WITH(KD_AFTER_OVERLAP,m,a,b,r,s) THEN GOES_WITH(KD_SIDE_EXAMINED,m,side,k);
law KD_ENDPOINT_EXAMINED := IF GOES_WITH(KD_SIDE_EXAMINED,m,side,DELTA), GOES_WITH(KD_SIDE_EXAMINED,m,side,GAMMA), GOES_WITH(KD_SIDE_EXAMINED,m,side,TAU) THEN GOES_WITH(KD_ENDPOINT_EXAMINED,m,side);
law KD_RECEIPT_COMPLETE := IF THIS(KD_OFFER,m), GOES_WITH(KD_ENDPOINT_EXAMINED,m,FROM), GOES_WITH(KD_ENDPOINT_EXAMINED,m,TO) THEN THIS(KD_RECEIPT_COMPLETE,m);
law KD_SIDE_NO_OPEN := IF GOES_WITH(KD_ENDPOINT,m,side,f), GOES_WITH(KD_INCIDENT,f,k,a,b,r), GOES_WITH(KD_NO_OPEN,m,a,b) THEN GOES_WITH(KD_SIDE_NO_OPEN,m,side,k);
law KD_ENDPOINT_NO_OPEN := IF GOES_WITH(KD_SIDE_NO_OPEN,m,side,DELTA), GOES_WITH(KD_SIDE_NO_OPEN,m,side,GAMMA), GOES_WITH(KD_SIDE_NO_OPEN,m,side,TAU) THEN GOES_WITH(KD_ENDPOINT_NO_OPEN,m,side);
law KD_STRICT := IF THIS(KD_RECEIPT_COMPLETE,m), GOES_WITH(KD_ENDPOINT_NO_OPEN,m,FROM), GOES_WITH(KD_ENDPOINT_NO_OPEN,m,TO), GOES_WITH(KD_DISCHARGED,m,a,b) THEN THIS(KD_STRICT,m);
law KD_NOT_STRICT := IF THIS(KD_RECEIPT_COMPLETE,m), GOES_WITH(KD_OPENED,m,a,b) THEN GOES_WITH(KD_NOT_STRICT,m,OPENED_NONEMPTY,a,b);
