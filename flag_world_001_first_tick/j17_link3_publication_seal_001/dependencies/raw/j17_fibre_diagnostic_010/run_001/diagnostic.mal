law SC_IMPORT_WITNESS := IF THIS(SC_INPUT_WITNESS_ROW,ARRAY(CONS(leaf,CONS(row,NIL)))) THEN THIS(KD_INPUT_WITNESS_ROW,row);
law SC_IMPORT_LEAF := IF THIS(SC_INPUT_WITNESS_ROW,ARRAY(CONS(leaf,CONS(ARRAY(CONS(a,CONS(b,CONS(old,NIL)))),NIL)))) THEN GOES_WITH(SC_WITNESS_LEAF,leaf,a,b,old);
// Bounded diagnostic authorized in the current user request; not promoted law.
// Native contacts: vector_displacement.mal 22192EBA...3F8F :132-168,223-253.
// Every target allowed by those clauses is included; no entity name is invented.
// THIS source flags are diagnostic loci, not an inferred entity inventory.
// Replacing a declared base move by this union is NOT promoted by this run.
// No selection, current field write, fabric admission, or worldline append.
// Input wrappers transport exact g2 field/witness rows without semantic work.

law KD_FIELD_ROW := IF THIS(KD_INPUT_FIELD_ROW,ARRAY(CONS(f,CONS(r,NIL)))) THEN GOES_WITH(KD_FIELD,f,r);
law KD_PARTS := IF GOES_WITH(KD_FIELD,ARRAY(CONS(v,CONS(e,CONS(t,NIL)))),r) THEN GOES_WITH(KD_PARTS,ARRAY(CONS(v,CONS(e,CONS(t,NIL)))),v,e,t);
law KD_WITNESS_ROW := IF THIS(KD_INPUT_WITNESS_ROW,ARRAY(CONS(a,CONS(b,CONS(r,NIL))))) THEN GOES_WITH(KD_WITNESS,a,b,r);
law KD_BASE_SAME := IF GOES_WITH(KD_WITNESS,a,b,r), GOES_WITH(KD_FIELD,a,x), GOES_WITH(KD_FIELD,b,x) THEN GOES_WITH(KD_BASELINE,a,b,"SAME");
law KD_BASE_DIFFER_A := IF GOES_WITH(KD_WITNESS,a,b,r), GOES_WITH(KD_FIELD,a,"THIS"), GOES_WITH(KD_FIELD,b,"NO") THEN GOES_WITH(KD_BASELINE,a,b,"NOT_SAME");
law KD_BASE_DIFFER_B := IF GOES_WITH(KD_WITNESS,a,b,r), GOES_WITH(KD_FIELD,a,"NO"), GOES_WITH(KD_FIELD,b,"THIS") THEN GOES_WITH(KD_BASELINE,a,b,"NOT_SAME");
law KD_BASE_BOUND := IF GOES_WITH(KD_WITNESS,a,b,r), GOES_WITH(KD_BASELINE,a,b,r) THEN GOES_WITH(KD_BASE_BOUND,a,b,r);

// Delta/gamma/tau are read by the two shared coordinates of an overlap.
// The committed witness has distinct endpoint flags. Input hash is bound.
law KD_DELTA := IF GOES_WITH(KD_BASE_BOUND,a,b,r), GOES_WITH(KD_PARTS,a,v,e,t), GOES_WITH(KD_PARTS,b,w,e,t) THEN GOES_WITH(KD_INCIDENT,a,DELTA,a,b,r);
law KD_GAMMA := IF GOES_WITH(KD_BASE_BOUND,a,b,r), GOES_WITH(KD_PARTS,a,v,e,t), GOES_WITH(KD_PARTS,b,v,q,t) THEN GOES_WITH(KD_INCIDENT,a,GAMMA,a,b,r);
law KD_TAU := IF GOES_WITH(KD_BASE_BOUND,a,b,r), GOES_WITH(KD_PARTS,a,v,e,t), GOES_WITH(KD_PARTS,b,v,e,u) THEN GOES_WITH(KD_INCIDENT,a,TAU,a,b,r);
law KD_INCIDENT_OTHER := IF GOES_WITH(KD_INCIDENT,a,k,a,b,r) THEN GOES_WITH(KD_INCIDENT,b,k,a,b,r);
law KD_MOVE_FORWARD := IF GOES_WITH(KD_INCIDENT,a,k,a,b,r) THEN GOES_WITH(KD_MOVE,k,a,b);
law KD_MOVE_REVERSE := IF GOES_WITH(KD_INCIDENT,a,k,a,b,r) THEN GOES_WITH(KD_MOVE,k,b,a);

// The source's target-bound lift relation, unioned over ALL eligible targets.
law KD_SITE_OFFER := IF GOES_WITH(KD_FIELD,f,"THIS"), GOES_WITH(KD_PARTS,f,v,e,t), GOES_WITH(KD_MOVE,DELTA,g,h), GOES_WITH(KD_PARTS,g,v,q,u), GOES_WITH(KD_PARTS,h,d,q,u) THEN THIS(KD_OFFER,MOVE("site",d,f,g,h));
law KD_EDGE_OFFER := IF GOES_WITH(KD_FIELD,f,"THIS"), GOES_WITH(KD_MOVE,GAMMA,f,h), GOES_WITH(KD_PARTS,h,v,e,t) THEN THIS(KD_OFFER,MOVE("edge",e,f,f,h));
law KD_TRIAD_OFFER := IF GOES_WITH(KD_FIELD,f,"THIS"), GOES_WITH(KD_PARTS,f,v,e,t), GOES_WITH(KD_MOVE,TAU,g,h), GOES_WITH(KD_PARTS,g,s,q,t), GOES_WITH(KD_PARTS,h,s,q,u) THEN THIS(KD_OFFER,MOVE("triad",u,f,g,h));
law KD_BASE_MOVE := IF THIS(KD_OFFER,MOVE(k,t,f,g,h)) THEN GOES_WITH(KD_BASE_MOVE,f,k,t);
law KD_WRITE_CONFLICT := IF THIS(KD_OFFER,MOVE(k,t,f,g,f)) THEN THIS(KD_WRITE_CONFLICT,MOVE(k,t,f,g,f));
law KD_LOCAL_EFFECT := IF THIS(KD_OFFER,MOVE(k,t,f,g,h)) THEN GOES_WITH(KD_LOCAL_EFFECT,MOVE(k,t,f,g,h),WRITE(f,"NO"),WRITE(h,"THIS"),RETAIN_OTHER_FLAGS);
law KD_ENDPOINT_FROM := IF THIS(KD_OFFER,MOVE(k,t,f,g,h)) THEN GOES_WITH(KD_ENDPOINT,MOVE(k,t,f,g,h),FROM,f);
law KD_ENDPOINT_TO := IF THIS(KD_OFFER,MOVE(k,t,f,g,h)) THEN GOES_WITH(KD_ENDPOINT,MOVE(k,t,f,g,h),TO,h);
law KD_AFFECTED := IF GOES_WITH(KD_ENDPOINT,m,side,f), GOES_WITH(KD_INCIDENT,f,k,a,b,r) THEN GOES_WITH(KD_AFFECTED,m,a,b,r);
law KD_READ_A := IF GOES_WITH(KD_AFFECTED,m,a,b,r) THEN GOES_WITH(KD_READ,m,a);
law KD_READ_B := IF GOES_WITH(KD_AFFECTED,m,a,b,r) THEN GOES_WITH(KD_READ,m,b);
law KD_FROM_READING := IF THIS(KD_OFFER,MOVE(k,t,f,g,h)), GOES_WITH(KD_READ,MOVE(k,t,f,g,h),f) THEN GOES_WITH(KD_AFTER_FLAG,MOVE(k,t,f,g,h),f,"NO");
law KD_TO_READING := IF THIS(KD_OFFER,MOVE(k,t,f,g,h)), GOES_WITH(KD_READ,MOVE(k,t,f,g,h),h) THEN GOES_WITH(KD_AFTER_FLAG,MOVE(k,t,f,g,h),h,"THIS");
law KD_COMPARE_FROM := IF GOES_WITH(KD_READ,MOVE(k,t,f,g,h),x) THEN GOES_WITH(KD_DIFF_REQUEST,x,f);
law KD_COMPARE_TO := IF GOES_WITH(KD_READ,MOVE(k,t,f,g,h),x) THEN GOES_WITH(KD_DIFF_REQUEST,x,h);
law KD_RETAIN_READING := IF GOES_WITH(KD_READ,MOVE(k,t,f,g,h),x), GOES_WITH(KD_DIFF,x,f), GOES_WITH(KD_DIFF,x,h), GOES_WITH(KD_FIELD,x,r) THEN GOES_WITH(KD_AFTER_FLAG,MOVE(k,t,f,g,h),x,r);

// Exact symmetric byte distinction. The byte chain is encoding only: neither
// direction supplies a base move, priority, modality, hand or selected lift.
law KD_BYTE_SPAN := IF GOES_WITH(KD_BYTE_NEXT,a,b) THEN GOES_WITH(KD_BYTE_SPAN,a,b);
law KD_BYTE_SPAN_MORE := IF GOES_WITH(KD_BYTE_SPAN,a,b), GOES_WITH(KD_BYTE_NEXT,b,c) THEN GOES_WITH(KD_BYTE_SPAN,a,c);
law KD_BYTE_DIFFER_F := IF GOES_WITH(KD_BYTE_SPAN,a,b) THEN GOES_WITH(KD_BYTE_DIFFER,a,b);
law KD_BYTE_DIFFER_R := IF GOES_WITH(KD_BYTE_SPAN,a,b) THEN GOES_WITH(KD_BYTE_DIFFER,b,a);
law KD_TEXT_REQUEST := IF GOES_WITH(KD_DIFF_REQUEST,TEXT(a),TEXT(b)) THEN GOES_WITH(KD_TEXT_REQUEST,a,b);
law KD_TEXT_PREFIX := IF GOES_WITH(KD_TEXT_REQUEST,CONS(a,x),CONS(a,y)) THEN GOES_WITH(KD_TEXT_REQUEST,x,y);
law KD_TEXT_HEAD_DIFF := IF GOES_WITH(KD_TEXT_REQUEST,CONS(a,x),CONS(b,y)), GOES_WITH(KD_BYTE_DIFFER,a,b) THEN GOES_WITH(KD_TEXT_DIFF,CONS(a,x),CONS(b,y));
law KD_TEXT_LEFT_END := IF GOES_WITH(KD_TEXT_REQUEST,NIL,CONS(a,t)) THEN GOES_WITH(KD_TEXT_DIFF,NIL,CONS(a,t));
law KD_TEXT_RIGHT_END := IF GOES_WITH(KD_TEXT_REQUEST,CONS(a,t),NIL) THEN GOES_WITH(KD_TEXT_DIFF,CONS(a,t),NIL);
law KD_TEXT_DIFF_PREFIX := IF GOES_WITH(KD_TEXT_REQUEST,CONS(a,x),CONS(a,y)), GOES_WITH(KD_TEXT_DIFF,x,y) THEN GOES_WITH(KD_TEXT_DIFF,CONS(a,x),CONS(a,y));
law KD_TEXT_DIFF := IF GOES_WITH(KD_DIFF_REQUEST,TEXT(a),TEXT(b)), GOES_WITH(KD_TEXT_DIFF,a,b) THEN GOES_WITH(KD_DIFF,TEXT(a),TEXT(b));
law KD_ARRAY_REQUEST := IF GOES_WITH(KD_DIFF_REQUEST,ARRAY(a),ARRAY(b)) THEN GOES_WITH(KD_LIST_REQUEST,a,b);
law KD_LIST_HEAD := IF GOES_WITH(KD_LIST_REQUEST,CONS(a,x),CONS(b,y)) THEN GOES_WITH(KD_DIFF_REQUEST,a,b);
law KD_LIST_TAIL := IF GOES_WITH(KD_LIST_REQUEST,CONS(a,x),CONS(b,y)) THEN GOES_WITH(KD_LIST_REQUEST,x,y);
law KD_LIST_HEAD_DIFF := IF GOES_WITH(KD_LIST_REQUEST,CONS(a,x),CONS(b,y)), GOES_WITH(KD_DIFF,a,b) THEN GOES_WITH(KD_LIST_DIFF,CONS(a,x),CONS(b,y));
law KD_LIST_TAIL_DIFF := IF GOES_WITH(KD_LIST_REQUEST,CONS(a,x),CONS(b,y)), GOES_WITH(KD_LIST_DIFF,x,y) THEN GOES_WITH(KD_LIST_DIFF,CONS(a,x),CONS(b,y));
law KD_ARRAY_DIFF := IF GOES_WITH(KD_DIFF_REQUEST,ARRAY(a),ARRAY(b)), GOES_WITH(KD_LIST_DIFF,a,b) THEN GOES_WITH(KD_DIFF,ARRAY(a),ARRAY(b));

// Only overlaps incident to FROM or TO can change under RETAIN_OTHER_FLAGS.
// This exhausts the receipt difference without recomputing unchanged overlaps.
law KD_AFTER_SAME := IF GOES_WITH(KD_AFFECTED,m,a,b,old), GOES_WITH(KD_AFTER_FLAG,m,a,r), GOES_WITH(KD_AFTER_FLAG,m,b,r) THEN GOES_WITH(KD_AFTER_OVERLAP,m,a,b,old,"SAME");
law KD_AFTER_DIFF_A := IF GOES_WITH(KD_AFFECTED,m,a,b,old), GOES_WITH(KD_AFTER_FLAG,m,a,"THIS"), GOES_WITH(KD_AFTER_FLAG,m,b,"NO") THEN GOES_WITH(KD_AFTER_OVERLAP,m,a,b,old,"NOT_SAME");
law KD_AFTER_DIFF_B := IF GOES_WITH(KD_AFFECTED,m,a,b,old), GOES_WITH(KD_AFTER_FLAG,m,a,"NO"), GOES_WITH(KD_AFTER_FLAG,m,b,"THIS") THEN GOES_WITH(KD_AFTER_OVERLAP,m,a,b,old,"NOT_SAME");
law KD_DISCHARGED := IF GOES_WITH(KD_AFTER_OVERLAP,m,a,b,"NOT_SAME","SAME") THEN GOES_WITH(KD_DISCHARGED,m,a,b);
law KD_OPENED := IF GOES_WITH(KD_AFTER_OVERLAP,m,a,b,"SAME","NOT_SAME") THEN GOES_WITH(KD_OPENED,m,a,b);
law KD_NO_OPEN_SAME := IF GOES_WITH(KD_AFTER_OVERLAP,m,a,b,old,"SAME") THEN GOES_WITH(KD_NO_OPEN,m,a,b);
law KD_NO_OPEN_RETAINED := IF GOES_WITH(KD_AFTER_OVERLAP,m,a,b,"NOT_SAME","NOT_SAME") THEN GOES_WITH(KD_NO_OPEN,m,a,b);
law KD_SIDE_EXAMINED := IF GOES_WITH(KD_ENDPOINT,m,side,f), GOES_WITH(KD_INCIDENT,f,k,a,b,r), GOES_WITH(KD_AFTER_OVERLAP,m,a,b,r,s) THEN GOES_WITH(KD_SIDE_EXAMINED,m,side,k);
law KD_ENDPOINT_EXAMINED := IF GOES_WITH(KD_SIDE_EXAMINED,m,side,DELTA), GOES_WITH(KD_SIDE_EXAMINED,m,side,GAMMA), GOES_WITH(KD_SIDE_EXAMINED,m,side,TAU) THEN GOES_WITH(KD_ENDPOINT_EXAMINED,m,side);
law KD_RECEIPT_COMPLETE := IF THIS(KD_OFFER,m), GOES_WITH(KD_ENDPOINT_EXAMINED,m,FROM), GOES_WITH(KD_ENDPOINT_EXAMINED,m,TO) THEN THIS(KD_RECEIPT_COMPLETE,m);
law KD_SIDE_NO_OPEN := IF GOES_WITH(KD_ENDPOINT,m,side,f), GOES_WITH(KD_INCIDENT,f,k,a,b,r), GOES_WITH(KD_NO_OPEN,m,a,b) THEN GOES_WITH(KD_SIDE_NO_OPEN,m,side,k);
law KD_ENDPOINT_NO_OPEN := IF GOES_WITH(KD_SIDE_NO_OPEN,m,side,DELTA), GOES_WITH(KD_SIDE_NO_OPEN,m,side,GAMMA), GOES_WITH(KD_SIDE_NO_OPEN,m,side,TAU) THEN GOES_WITH(KD_ENDPOINT_NO_OPEN,m,side);
law KD_STRICT := IF THIS(KD_RECEIPT_COMPLETE,m), GOES_WITH(KD_ENDPOINT_NO_OPEN,m,FROM), GOES_WITH(KD_ENDPOINT_NO_OPEN,m,TO), GOES_WITH(KD_DISCHARGED,m,a,b) THEN THIS(KD_STRICT,m);
law KD_NOT_STRICT := IF THIS(KD_RECEIPT_COMPLETE,m), GOES_WITH(KD_OPENED,m,a,b) THEN GOES_WITH(KD_NOT_STRICT,m,OPENED_NONEMPTY,a,b);

// User-authorized diagnostic field assignments. Not ENGINE offer membership.
// Uses the exact field, parts, overlap, move and distinction predicates of 008.
// SITE(v,r): set every flag whose site is v to r; retain all other flags.
// UNIFORM(r) and BOUNDARY_GROW are separate checks, not extra site offers.
// No entity, selection, runtime admission, worldline or repository commit.

law SC_SITE := IF GOES_WITH(KD_PARTS,f,v,e,t) THEN THIS(SC_SITE,v);
law SC_SITE_THIS := IF THIS(SC_SITE,v) THEN THIS(SC_CASE,SITE(v,"THIS"));
law SC_SITE_NO := IF THIS(SC_SITE,v) THEN THIS(SC_CASE,SITE(v,"NO"));
law SC_SITE_INSIDE := IF THIS(SC_CASE,SITE(v,r)), GOES_WITH(KD_PARTS,f,v,e,t) THEN GOES_WITH(SC_FIELD,SITE(v,r),f,r);
law SC_SITE_COMPARE := IF THIS(SC_SITE,v), THIS(SC_SITE,w) THEN GOES_WITH(KD_DIFF_REQUEST,v,w);
law SC_SITE_OUTSIDE := IF THIS(SC_CASE,SITE(v,r)), GOES_WITH(KD_PARTS,f,w,e,t), GOES_WITH(KD_DIFF,w,v), GOES_WITH(KD_FIELD,f,old) THEN GOES_WITH(SC_FIELD,SITE(v,r),f,old);
law SC_UNIFORM_THIS := IF THIS(SC_SITE,v) THEN THIS(SC_CASE,UNIFORM("THIS"));
law SC_UNIFORM_NO := IF THIS(SC_SITE,v) THEN THIS(SC_CASE,UNIFORM("NO"));
law SC_UNIFORM_FIELD := IF THIS(SC_CASE,UNIFORM(r)), GOES_WITH(KD_FIELD,f,old) THEN GOES_WITH(SC_FIELD,UNIFORM(r),f,r);

// The proposed grow-boundary check: exactly NO endpoints of existing walls.
law SC_BOUNDARY_CASE := IF GOES_WITH(KD_WITNESS,a,b,"NOT_SAME") THEN THIS(SC_CASE,BOUNDARY_GROW);
law SC_BOUNDARY_A := IF GOES_WITH(KD_WITNESS,a,b,"NOT_SAME"), GOES_WITH(KD_FIELD,a,"NO") THEN THIS(SC_BOUNDARY_FLAG,a);
law SC_BOUNDARY_B := IF GOES_WITH(KD_WITNESS,a,b,"NOT_SAME"), GOES_WITH(KD_FIELD,b,"NO") THEN THIS(SC_BOUNDARY_FLAG,b);
law SC_BOUNDARY_SET := IF THIS(SC_BOUNDARY_FLAG,f) THEN GOES_WITH(SC_FIELD,BOUNDARY_GROW,f,"THIS");
law SC_BOUNDARY_KEEP_THIS := IF THIS(SC_CASE,BOUNDARY_GROW), GOES_WITH(KD_FIELD,f,"THIS") THEN GOES_WITH(SC_FIELD,BOUNDARY_GROW,f,"THIS");
law SC_BOUNDARY_KEEP_NO := IF THIS(SC_CASE,BOUNDARY_GROW), GOES_WITH(KD_FIELD,f,"NO"), GOES_WITH(KD_INCIDENT,f,DELTA,a,b,"SAME"), GOES_WITH(KD_INCIDENT,f,GAMMA,c,d,"SAME"), GOES_WITH(KD_INCIDENT,f,TAU,e,g,"SAME") THEN GOES_WITH(SC_FIELD,BOUNDARY_GROW,f,"NO");

// Evaluate all 720 overlaps for every case, not just its changed boundary.
law SC_AFTER_SAME := IF THIS(SC_CASE,m), GOES_WITH(KD_BASE_BOUND,a,b,old), GOES_WITH(SC_FIELD,m,a,r), GOES_WITH(SC_FIELD,m,b,r) THEN GOES_WITH(SC_AFTER,m,a,b,old,"SAME");
law SC_AFTER_DIFF_A := IF THIS(SC_CASE,m), GOES_WITH(KD_BASE_BOUND,a,b,old), GOES_WITH(SC_FIELD,m,a,"THIS"), GOES_WITH(SC_FIELD,m,b,"NO") THEN GOES_WITH(SC_AFTER,m,a,b,old,"NOT_SAME");
law SC_AFTER_DIFF_B := IF THIS(SC_CASE,m), GOES_WITH(KD_BASE_BOUND,a,b,old), GOES_WITH(SC_FIELD,m,a,"NO"), GOES_WITH(SC_FIELD,m,b,"THIS") THEN GOES_WITH(SC_AFTER,m,a,b,old,"NOT_SAME");
law SC_OPENED := IF GOES_WITH(SC_AFTER,m,a,b,"SAME","NOT_SAME") THEN GOES_WITH(SC_OPENED,m,a,b);
law SC_DISCHARGED := IF GOES_WITH(SC_AFTER,m,a,b,"NOT_SAME","SAME") THEN GOES_WITH(SC_DISCHARGED,m,a,b);
law SC_RETAINED := IF GOES_WITH(SC_AFTER,m,a,b,"NOT_SAME","NOT_SAME") THEN GOES_WITH(SC_RETAINED,m,a,b);
law SC_CHANGE_THIS := IF GOES_WITH(KD_FIELD,f,"NO"), GOES_WITH(SC_FIELD,m,f,"THIS") THEN GOES_WITH(SC_CHANGED,m,f,"NO","THIS");
law SC_CHANGE_NO := IF GOES_WITH(KD_FIELD,f,"THIS"), GOES_WITH(SC_FIELD,m,f,"NO") THEN GOES_WITH(SC_CHANGED,m,f,"THIS","NO");

// A coverage hierarchy is generic transport of the complete witness array.
// Leaves reference its JSON rows; pair nodes only group execution. No node
// creates, drops, orders a move, or chooses a field reading.
law SC_COVER_LEAF := IF GOES_WITH(SC_WITNESS_LEAF,leaf,a,b,old), GOES_WITH(SC_AFTER,m,a,b,old,next) THEN GOES_WITH(SC_COVER,m,leaf);
law SC_COVER_PAIR := IF GOES_WITH(SC_COVER_PAIR,node,left,right), GOES_WITH(SC_COVER,m,left), GOES_WITH(SC_COVER,m,right) THEN GOES_WITH(SC_COVER,m,node);
law SC_COMPLETE := IF THIS(SC_COVER_ROOT,root), GOES_WITH(SC_COVER,m,root) THEN THIS(SC_COMPLETE,m);
law SC_NO_OPEN_SAME := IF GOES_WITH(SC_AFTER,m,a,b,old,"SAME") THEN GOES_WITH(SC_NO_OPEN,m,a,b);
law SC_NO_OPEN_RETAINED := IF GOES_WITH(SC_AFTER,m,a,b,"NOT_SAME","NOT_SAME") THEN GOES_WITH(SC_NO_OPEN,m,a,b);
law SC_NO_DISCHARGE_SAME := IF GOES_WITH(SC_AFTER,m,a,b,"SAME",next) THEN GOES_WITH(SC_NO_DISCHARGE,m,a,b);
law SC_NO_DISCHARGE_RETAINED := IF GOES_WITH(SC_AFTER,m,a,b,"NOT_SAME","NOT_SAME") THEN GOES_WITH(SC_NO_DISCHARGE,m,a,b);
law SC_EMPTY_OPEN_LEAF := IF GOES_WITH(SC_WITNESS_LEAF,leaf,a,b,old), GOES_WITH(SC_NO_OPEN,m,a,b) THEN GOES_WITH(SC_EMPTY_OPEN,m,leaf);
law SC_EMPTY_OPEN_PAIR := IF GOES_WITH(SC_COVER_PAIR,node,left,right), GOES_WITH(SC_EMPTY_OPEN,m,left), GOES_WITH(SC_EMPTY_OPEN,m,right) THEN GOES_WITH(SC_EMPTY_OPEN,m,node);
law SC_EMPTY_DISCHARGE_LEAF := IF GOES_WITH(SC_WITNESS_LEAF,leaf,a,b,old), GOES_WITH(SC_NO_DISCHARGE,m,a,b) THEN GOES_WITH(SC_EMPTY_DISCHARGE,m,leaf);
law SC_EMPTY_DISCHARGE_PAIR := IF GOES_WITH(SC_COVER_PAIR,node,left,right), GOES_WITH(SC_EMPTY_DISCHARGE,m,left), GOES_WITH(SC_EMPTY_DISCHARGE,m,right) THEN GOES_WITH(SC_EMPTY_DISCHARGE,m,node);
law SC_STRICT := IF THIS(SC_COMPLETE,m), THIS(SC_COVER_ROOT,root), GOES_WITH(SC_EMPTY_OPEN,m,root), GOES_WITH(SC_DISCHARGED,m,a,b) THEN THIS(SC_STRICT,m);
law SC_NOT_STRICT_OPEN := IF THIS(SC_COMPLETE,m), GOES_WITH(SC_OPENED,m,a,b) THEN GOES_WITH(SC_NOT_STRICT,m,OPENED_NONEMPTY);
law SC_NOT_STRICT_EMPTY := IF THIS(SC_COMPLETE,m), THIS(SC_COVER_ROOT,root), GOES_WITH(SC_EMPTY_DISCHARGE,m,root) THEN GOES_WITH(SC_NOT_STRICT,m,DISCHARGED_EMPTY);

// Exhaust all 480 one-flag inversions, with three incident overlaps each.
law SC_SINGLE_THIS := IF GOES_WITH(KD_FIELD,f,"NO") THEN GOES_WITH(SC_SINGLE,f,"NO","THIS");
law SC_SINGLE_NO := IF GOES_WITH(KD_FIELD,f,"THIS") THEN GOES_WITH(SC_SINGLE,f,"THIS","NO");
law SC_SINGLE_A := IF GOES_WITH(SC_SINGLE,f,old,r), GOES_WITH(KD_INCIDENT,f,k,f,b,prior), GOES_WITH(KD_FIELD,b,s) THEN GOES_WITH(SC_SINGLE_PAIR,f,k,f,b,prior,r,s);
law SC_SINGLE_B := IF GOES_WITH(SC_SINGLE,f,old,r), GOES_WITH(KD_INCIDENT,f,k,a,f,prior), GOES_WITH(KD_FIELD,a,s) THEN GOES_WITH(SC_SINGLE_PAIR,f,k,a,f,prior,s,r);
law SC_SINGLE_AFTER_SAME := IF GOES_WITH(SC_SINGLE_PAIR,f,k,a,b,prior,r,r) THEN GOES_WITH(SC_SINGLE_AFTER,f,k,a,b,prior,"SAME");
law SC_SINGLE_AFTER_DIFF_A := IF GOES_WITH(SC_SINGLE_PAIR,f,k,a,b,prior,"THIS","NO") THEN GOES_WITH(SC_SINGLE_AFTER,f,k,a,b,prior,"NOT_SAME");
law SC_SINGLE_AFTER_DIFF_B := IF GOES_WITH(SC_SINGLE_PAIR,f,k,a,b,prior,"NO","THIS") THEN GOES_WITH(SC_SINGLE_AFTER,f,k,a,b,prior,"NOT_SAME");
law SC_SINGLE_OPEN := IF GOES_WITH(SC_SINGLE_AFTER,f,k,a,b,"SAME","NOT_SAME") THEN GOES_WITH(SC_SINGLE_OPEN,f,k,a,b);
law SC_SINGLE_DISCHARGE := IF GOES_WITH(SC_SINGLE_AFTER,f,k,a,b,"NOT_SAME","SAME") THEN GOES_WITH(SC_SINGLE_DISCHARGE,f,k,a,b);
law SC_SINGLE_EXAMINED := IF GOES_WITH(SC_SINGLE_AFTER,f,k,a,b,old,next) THEN GOES_WITH(SC_SINGLE_EXAMINED,f,k);
law SC_SINGLE_COMPLETE := IF GOES_WITH(SC_SINGLE_EXAMINED,f,DELTA), GOES_WITH(SC_SINGLE_EXAMINED,f,GAMMA), GOES_WITH(SC_SINGLE_EXAMINED,f,TAU) THEN THIS(SC_SINGLE_COMPLETE,f);
law SC_SINGLE_NOT_STRICT := IF THIS(SC_SINGLE_COMPLETE,f), GOES_WITH(SC_SINGLE_OPEN,f,k,a,b) THEN THIS(SC_SINGLE_NOT_STRICT,f);

// Explicit input geometry witnesses used by the user's boundary claim.
law SC_THIS_INTERNAL := IF GOES_WITH(KD_INCIDENT,a,k,a,b,"SAME"), GOES_WITH(KD_FIELD,a,"THIS"), GOES_WITH(KD_FIELD,b,"THIS") THEN GOES_WITH(SC_THIS_INTERNAL,k,a,b);
law SC_OLD_WALL := IF GOES_WITH(KD_INCIDENT,a,k,a,b,"NOT_SAME") THEN GOES_WITH(SC_OLD_WALL,k,a,b);

// Extend diagnostic009 to both readings of every edge and triad fibre.
// Receipt evaluation and full-overlap coverage are unchanged native .mal.
// Fibres are equality classes of a coordinate, not host-enumerated offers.
// No worldline append or semantic offer-membership verdict is performed here.

law FC_EDGE := IF GOES_WITH(KD_PARTS,f,v,e,t) THEN THIS(FC_EDGE,e);
law FC_EDGE_THIS := IF THIS(FC_EDGE,e) THEN THIS(SC_CASE,EDGE(e,"THIS"));
law FC_EDGE_NO := IF THIS(FC_EDGE,e) THEN THIS(SC_CASE,EDGE(e,"NO"));
law FC_EDGE_INSIDE := IF THIS(SC_CASE,EDGE(e,r)), GOES_WITH(KD_PARTS,f,v,e,t) THEN GOES_WITH(SC_FIELD,EDGE(e,r),f,r);
law FC_EDGE_COMPARE := IF THIS(FC_EDGE,e), THIS(FC_EDGE,q) THEN GOES_WITH(KD_DIFF_REQUEST,e,q);
law FC_EDGE_OUTSIDE := IF THIS(SC_CASE,EDGE(e,r)), GOES_WITH(KD_PARTS,f,v,q,t), GOES_WITH(KD_DIFF,q,e), GOES_WITH(KD_FIELD,f,old) THEN GOES_WITH(SC_FIELD,EDGE(e,r),f,old);

law FC_TRIAD := IF GOES_WITH(KD_PARTS,f,v,e,t) THEN THIS(FC_TRIAD,t);
law FC_TRIAD_THIS := IF THIS(FC_TRIAD,t) THEN THIS(SC_CASE,TRIAD(t,"THIS"));
law FC_TRIAD_NO := IF THIS(FC_TRIAD,t) THEN THIS(SC_CASE,TRIAD(t,"NO"));
law FC_TRIAD_INSIDE := IF THIS(SC_CASE,TRIAD(t,r)), GOES_WITH(KD_PARTS,f,v,e,t) THEN GOES_WITH(SC_FIELD,TRIAD(t,r),f,r);
law FC_TRIAD_COMPARE := IF THIS(FC_TRIAD,t), THIS(FC_TRIAD,u) THEN GOES_WITH(KD_DIFF_REQUEST,t,u);
law FC_TRIAD_OUTSIDE := IF THIS(SC_CASE,TRIAD(t,r)), GOES_WITH(KD_PARTS,f,v,e,u), GOES_WITH(KD_DIFF,u,t), GOES_WITH(KD_FIELD,f,old) THEN GOES_WITH(SC_FIELD,TRIAD(t,r),f,old);
