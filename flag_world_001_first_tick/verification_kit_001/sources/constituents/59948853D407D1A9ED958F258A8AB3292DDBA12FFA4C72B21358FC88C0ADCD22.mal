// EXECUTE promoted DECISION_RECORD_GPU_SELF_WITNESS_001 2CBBA4AD...BCE7.
// GPU-owned composition and publication. Host JSON is observation transport only.
// The row arrays are accepted only against source-produced rows, strict distinct
// keys and the complete 012 cardinalities. Encoding order selects no world value.
// Hardware-lane append, kappa, S/F, placement and STEP_FABRIC are not genesis gates.
@readonly input GSC_FIELD_INPUT := "field:";
@readonly input GSC_WITNESS_INPUT := "witness:";
@readonly input GSC_HASH_INPUT := "hashes:";
@readonly input GSC_LINK_INPUT := "links:";

law GSC_FIELD_ROWS := IF THIS(GSC_FIELD_INPUT,ARRAY(xs)) THEN GOES_WITH(GSC_ROWS,CURRENT_FIELD,xs);
law GSC_WITNESS_ROWS := IF THIS(GSC_WITNESS_INPUT,ARRAY(xs)) THEN GOES_WITH(GSC_ROWS,CURRENT_WITNESS,xs);
law GSC_GROUND_ROWS := IF THIS(GSC_GROUND_INPUT,ARRAY(xs)) THEN GOES_WITH(GSC_ROWS,GROUND_0_012,xs);
law GSC_ROWS_TAIL := IF GOES_WITH(GSC_ROWS,k,CONS(row,tail)) THEN GOES_WITH(GSC_ROWS,k,tail);
law GSC_ROWS_BLOCK := IF GOES_WITH(GSC_ROWS,k,CONS(a,CONS(b,CONS(c,CONS(d,CONS(e,CONS(f,CONS(g,CONS(h,tail)))))))))
 THEN GOES_WITH(GSC_ROWS,k,tail);

@propose seed GSC_ROW_CLASSES := {
 THIS(GSC_FIELD_KIND,CURRENT_FIELD), THIS(GSC_FIELD_KIND,GROUND_0_012),
 THIS(GSC_PAIR_KIND,CURRENT_WITNESS)
};
law GSC_FIELD_KEY := IF THIS(GSC_FIELD_KIND,k), THIS(OBSERVATION_ROW,k,ARRAY(CONS(j,CONS(r,NIL)))), GOES_WITH(FLAG_JSON,f,j)
 THEN GOES_WITH(GSC_ROW_KEY,k,ARRAY(CONS(j,CONS(r,NIL))),f);
law GSC_PAIR_KEY := IF THIS(GSC_PAIR_KIND,k), THIS(OBSERVATION_ROW,k,ARRAY(CONS(a,CONS(b,CONS(r,NIL))))), GOES_WITH(FLAG_JSON,f,a), GOES_WITH(FLAG_JSON,g,b)
 THEN GOES_WITH(GSC_ROW_KEY,k,ARRAY(CONS(a,CONS(b,CONS(r,NIL)))),TOGETHER_ALONE(f,g));
law GSC_ORDER_REQUEST := IF GOES_WITH(GSC_ROWS,k,CONS(a,CONS(b,tail))), GOES_WITH(GSC_ROW_KEY,k,a,x), GOES_WITH(GSC_ROW_KEY,k,b,y)
 THEN THIS(GSC_ORDER_REQUEST,x,y);
// This is the retained structural observation order, not numeric identifier order.
law GSC_ORDER_SITE := IF THIS(GSC_ORDER_REQUEST,a,b), GOES_WITH(SITE_ORDER,a,b)
 THEN GOES_WITH(GSC_ORDERED,a,b);
law GSC_ORDER_PAIR_REQUEST_A := IF THIS(GSC_ORDER_REQUEST,TOGETHER_ALONE(a,b),TOGETHER_ALONE(c,d))
 THEN THIS(GSC_ORDER_REQUEST,a,c);
law GSC_ORDER_PAIR_REQUEST_B := IF THIS(GSC_ORDER_REQUEST,TOGETHER_ALONE(a,b),TOGETHER_ALONE(a,d))
 THEN THIS(GSC_ORDER_REQUEST,b,d);
law GSC_ORDER_PAIR_A := IF THIS(GSC_ORDER_REQUEST,TOGETHER_ALONE(a,b),TOGETHER_ALONE(c,d)), GOES_WITH(GSC_ORDERED,a,c)
 THEN GOES_WITH(GSC_ORDERED,TOGETHER_ALONE(a,b),TOGETHER_ALONE(c,d));
law GSC_ORDER_PAIR_B := IF THIS(GSC_ORDER_REQUEST,TOGETHER_ALONE(a,b),TOGETHER_ALONE(a,d)), GOES_WITH(GSC_ORDERED,b,d)
 THEN GOES_WITH(GSC_ORDERED,TOGETHER_ALONE(a,b),TOGETHER_ALONE(a,d));
law GSC_ORDER_TRIPLE_REQUEST_A := IF THIS(GSC_ORDER_REQUEST,TOGETHER_ALONE(a,b,c),TOGETHER_ALONE(d,e,f))
 THEN THIS(GSC_ORDER_REQUEST,a,d);
law GSC_ORDER_TRIPLE_REQUEST_B := IF THIS(GSC_ORDER_REQUEST,TOGETHER_ALONE(a,b,c),TOGETHER_ALONE(a,e,f))
 THEN THIS(GSC_ORDER_REQUEST,b,e);
law GSC_ORDER_TRIPLE_REQUEST_C := IF THIS(GSC_ORDER_REQUEST,TOGETHER_ALONE(a,b,c),TOGETHER_ALONE(a,b,f))
 THEN THIS(GSC_ORDER_REQUEST,c,f);
law GSC_ORDER_TRIPLE_A := IF THIS(GSC_ORDER_REQUEST,TOGETHER_ALONE(a,b,c),TOGETHER_ALONE(d,e,f)), GOES_WITH(GSC_ORDERED,a,d)
 THEN GOES_WITH(GSC_ORDERED,TOGETHER_ALONE(a,b,c),TOGETHER_ALONE(d,e,f));
law GSC_ORDER_TRIPLE_B := IF THIS(GSC_ORDER_REQUEST,TOGETHER_ALONE(a,b,c),TOGETHER_ALONE(a,e,f)), GOES_WITH(GSC_ORDERED,b,e)
 THEN GOES_WITH(GSC_ORDERED,TOGETHER_ALONE(a,b,c),TOGETHER_ALONE(a,e,f));
law GSC_ORDER_TRIPLE_C := IF THIS(GSC_ORDER_REQUEST,TOGETHER_ALONE(a,b,c),TOGETHER_ALONE(a,b,f)), GOES_WITH(GSC_ORDERED,c,f)
 THEN GOES_WITH(GSC_ORDERED,TOGETHER_ALONE(a,b,c),TOGETHER_ALONE(a,b,f));
law GSC_ORDERED_ROW := IF GOES_WITH(GSC_ROWS,k,CONS(a,CONS(b,tail))), GOES_WITH(GSC_ROW_KEY,k,a,x), GOES_WITH(GSC_ROW_KEY,k,b,y), GOES_WITH(GSC_ORDERED,x,y)
 THEN GOES_WITH(GSC_ROW_SPAN,k,ONE,CONS(a,CONS(b,tail)),CONS(b,tail));
law GSC_LAST_ROW := IF GOES_WITH(GSC_ROWS,k,CONS(a,NIL)), GOES_WITH(GSC_ROW_KEY,k,a,x)
 THEN GOES_WITH(GSC_ROW_SPAN,k,ONE,CONS(a,NIL),NIL);
@propose seed GSC_SPAN_LENGTHS := {
 GOES_WITH(GSC_SPAN_DOUBLE,ONE,TWO), GOES_WITH(GSC_SPAN_DOUBLE,TWO,FOUR),
 GOES_WITH(GSC_SPAN_DOUBLE,FOUR,EIGHT), GOES_WITH(GSC_SPAN_DOUBLE,EIGHT,SIXTEEN),
 GOES_WITH(GSC_SPAN_DOUBLE,SIXTEEN,THIRTY_TWO), GOES_WITH(GSC_SPAN_DOUBLE,THIRTY_TWO,SIXTY_FOUR),
 GOES_WITH(GSC_SPAN_DOUBLE,SIXTY_FOUR,ONE_TWENTY_EIGHT), GOES_WITH(GSC_SPAN_DOUBLE,ONE_TWENTY_EIGHT,TWO_FIFTY_SIX),
 GOES_WITH(GSC_SPAN_DOUBLE,TWO_FIFTY_SIX,FIVE_TWELVE)
};
law GSC_DOUBLE_ROWS := IF GOES_WITH(GSC_SPAN_DOUBLE,n,m), GOES_WITH(GSC_ROW_SPAN,k,n,a,b), GOES_WITH(GSC_ROW_SPAN,k,n,b,c)
 THEN GOES_WITH(GSC_ROW_SPAN,k,m,a,c);
// Complete cardinalities derive from the retained 012 carrier: 480 flags,
// 720 canonical overlap pairs. Distinct recognized keys plus exact length cover it.
law GSC_FIELD_COMPLETE := IF THIS(GSC_FIELD_KIND,k), GOES_WITH(GSC_ROWS,k,a), GOES_WITH(GSC_ROW_SPAN,k,TWO_FIFTY_SIX,a,b), GOES_WITH(GSC_ROW_SPAN,k,ONE_TWENTY_EIGHT,b,c), GOES_WITH(GSC_ROW_SPAN,k,SIXTY_FOUR,c,d), GOES_WITH(GSC_ROW_SPAN,k,THIRTY_TWO,d,NIL)
 THEN GOES_WITH(GSC_COMPLETE,k,ARRAY(a));
law GSC_PAIR_COMPLETE := IF THIS(GSC_PAIR_KIND,k), GOES_WITH(GSC_ROWS,k,a), GOES_WITH(GSC_ROW_SPAN,k,FIVE_TWELVE,a,b), GOES_WITH(GSC_ROW_SPAN,k,ONE_TWENTY_EIGHT,b,c), GOES_WITH(GSC_ROW_SPAN,k,SIXTY_FOUR,c,d), GOES_WITH(GSC_ROW_SPAN,k,SIXTEEN,d,NIL)
 THEN GOES_WITH(GSC_COMPLETE,k,ARRAY(a));

// Reconstruct the archived field from its source-produced NO rows, using the
// checked current-field sequence only as the observation enumeration. This drops
// a redundant imported copy; its complete GPU SHA must still be exactly B263....
// Current readings never supply the archived reading.
law GSC_GROUND_SEQUENCE_END := IF GOES_WITH(GSC_ROWS,CURRENT_FIELD,NIL)
 THEN GOES_WITH(GSC_GROUND_SEQUENCE,NIL,NIL);
law GSC_GROUND_SEQUENCE_ROW := IF GOES_WITH(GSC_ROWS,CURRENT_FIELD,CONS(row,tail)), GOES_WITH(GSC_ROW_KEY,CURRENT_FIELD,row,f), GOES_WITH(GSC_ROW_KEY,GROUND_0_012,ground,f), GOES_WITH(GSC_GROUND_SEQUENCE,tail,rest)
 THEN GOES_WITH(GSC_GROUND_SEQUENCE,CONS(row,tail),CONS(ground,rest));
law GSC_GROUND_SEQUENCE_COMPLETE := IF THIS(GSC_FIELD_INPUT,ARRAY(xs)), GOES_WITH(GSC_COMPLETE,CURRENT_FIELD,ARRAY(xs)), GOES_WITH(GSC_GROUND_SEQUENCE,xs,rows)
 THEN THIS(GSC_GROUND_INPUT,ARRAY(rows));

// FT receipt keeps discharged/opened only. Retained walls remain in WITNESS.
// This filter, its order, and the empty/content reading are all source laws.
// The already checked witness sequence enumerates every pair exactly once.
// Receipt status is read from the GPU's typed pair facts, not reimported from
// a redundant status array. No host filters or supplies a change verdict.
law GSC_CHANGE_ROW := IF GOES_WITH(GSC_ROW_SPAN,CURRENT_WITNESS,ONE,CONS(ARRAY(CONS(a,CONS(b,CONS(w,NIL)))),tail),tail), GOES_WITH(FLAG_JSON,f,a), GOES_WITH(FLAG_JSON,g,b), GOES_WITH(GENESIS_RECEIPT_PAIR,f,g,status)
 THEN GOES_WITH(GSC_CHANGE_ROW,CONS(ARRAY(CONS(a,CONS(b,CONS(w,NIL)))),tail),tail,ARRAY(CONS(a,CONS(b,NIL))),status);
law GSC_CHANGE_SKIP := IF GOES_WITH(GSC_CHANGE_ROW,start,tail,pair,"UNCHANGED")
 THEN GOES_WITH(GSC_CHANGE_SPAN,ONE,start,tail,CHANGE_LISTS(NIL,NIL));
law GSC_CHANGE_RETAINED := IF GOES_WITH(GSC_CHANGE_ROW,start,tail,pair,"RETAINED")
 THEN GOES_WITH(GSC_CHANGE_SPAN,ONE,start,tail,CHANGE_LISTS(NIL,NIL));
law GSC_CHANGE_OPENED := IF GOES_WITH(GSC_CHANGE_ROW,start,tail,pair,"OPENED")
 THEN GOES_WITH(GSC_CHANGE_SPAN,ONE,start,tail,CHANGE_LISTS(NIL,CONS(pair,NIL)));
law GSC_CHANGE_DISCHARGED := IF GOES_WITH(GSC_CHANGE_ROW,start,tail,pair,"DISCHARGED")
 THEN GOES_WITH(GSC_CHANGE_SPAN,ONE,start,tail,CHANGE_LISTS(CONS(pair,NIL),NIL));
law GSC_JOIN_D := IF THIS(GSC_JOIN_REQUEST,CHANGE_LISTS(a,b),CHANGE_LISTS(c,d)) THEN THIS(GSC_APPEND_REQUEST,a,c);
law GSC_JOIN_O := IF THIS(GSC_JOIN_REQUEST,CHANGE_LISTS(a,b),CHANGE_LISTS(c,d)) THEN THIS(GSC_APPEND_REQUEST,b,d);
law GSC_APPEND_END := IF THIS(GSC_APPEND_REQUEST,NIL,b) THEN GOES_WITH(GSC_APPEND,NIL,b,b);
law GSC_APPEND_TAIL := IF THIS(GSC_APPEND_REQUEST,CONS(a,t),b) THEN THIS(GSC_APPEND_REQUEST,t,b);
law GSC_APPEND_HEAD := IF THIS(GSC_APPEND_REQUEST,CONS(a,t),b), GOES_WITH(GSC_APPEND,t,b,c) THEN GOES_WITH(GSC_APPEND,CONS(a,t),b,CONS(a,c));
law GSC_JOIN_COMPLETE := IF THIS(GSC_JOIN_REQUEST,CHANGE_LISTS(a,b),CHANGE_LISTS(c,d)), GOES_WITH(GSC_APPEND,a,c,x), GOES_WITH(GSC_APPEND,b,d,y)
 THEN GOES_WITH(GSC_JOIN,CHANGE_LISTS(a,b),CHANGE_LISTS(c,d),CHANGE_LISTS(x,y));
law GSC_CHANGE_DOUBLE_REQUEST := IF GOES_WITH(GSC_SPAN_DOUBLE,n,m), GOES_WITH(GSC_CHANGE_SPAN,n,a,b,x), GOES_WITH(GSC_CHANGE_SPAN,n,b,c,y)
 THEN THIS(GSC_JOIN_REQUEST,x,y);
law GSC_CHANGE_DOUBLE := IF GOES_WITH(GSC_SPAN_DOUBLE,n,m), GOES_WITH(GSC_CHANGE_SPAN,n,a,b,x), GOES_WITH(GSC_CHANGE_SPAN,n,b,c,y), GOES_WITH(GSC_JOIN,x,y,z)
 THEN GOES_WITH(GSC_CHANGE_SPAN,m,a,c,z);
law GSC_CHANGE_PREFIX_REQUEST := IF THIS(GSC_WITNESS_INPUT,ARRAY(a)), GOES_WITH(GSC_CHANGE_SPAN,FIVE_TWELVE,a,b,x), GOES_WITH(GSC_CHANGE_SPAN,ONE_TWENTY_EIGHT,b,c,y)
 THEN THIS(GSC_JOIN_REQUEST,x,y);
law GSC_CHANGE_PREFIX := IF THIS(GSC_WITNESS_INPUT,ARRAY(a)), GOES_WITH(GSC_CHANGE_SPAN,FIVE_TWELVE,a,b,x), GOES_WITH(GSC_CHANGE_SPAN,ONE_TWENTY_EIGHT,b,c,y), GOES_WITH(GSC_JOIN,x,y,z)
 THEN GOES_WITH(GSC_CHANGE_PREFIX,c,z);
law GSC_CHANGE_SUFFIX_REQUEST := IF GOES_WITH(GSC_CHANGE_PREFIX,c,x), GOES_WITH(GSC_CHANGE_SPAN,SIXTY_FOUR,c,d,y), GOES_WITH(GSC_CHANGE_SPAN,SIXTEEN,d,NIL,z)
 THEN THIS(GSC_JOIN_REQUEST,y,z);
law GSC_CHANGE_SUFFIX := IF GOES_WITH(GSC_CHANGE_PREFIX,c,x), GOES_WITH(GSC_CHANGE_SPAN,SIXTY_FOUR,c,d,y), GOES_WITH(GSC_CHANGE_SPAN,SIXTEEN,d,NIL,z), GOES_WITH(GSC_JOIN,y,z,s)
 THEN GOES_WITH(GSC_CHANGE_PARTS,x,s);
law GSC_CHANGE_FINAL_REQUEST := IF GOES_WITH(GSC_CHANGE_PARTS,a,b) THEN THIS(GSC_JOIN_REQUEST,a,b);
law GSC_CHANGE_FINAL := IF GOES_WITH(GSC_CHANGE_PARTS,a,b), GOES_WITH(GSC_JOIN,a,b,c), THIS(GSC_WITNESS_INPUT,rows), GOES_WITH(GSC_COMPLETE,CURRENT_WITNESS,rows)
 THEN THIS(GSC_CHANGE_LISTS,c);
law GSC_RECEIPT_OBJECT := IF THIS(GSC_CHANGE_LISTS,CHANGE_LISTS(d,o))
 THEN THIS(GSC_RECEIPT_OBJECT,OBJECT(CONS(MEMBER("discharged",ARRAY(d)),CONS(MEMBER("opened",ARRAY(o)),NIL))));
law GSC_RECEIPT_EMPTY := IF THIS(GSC_CHANGE_LISTS,CHANGE_LISTS(NIL,NIL)) THEN THIS(GSC_RECEIPT_READING,"NO");
law GSC_RECEIPT_HAS_OPENED := IF THIS(GSC_CHANGE_LISTS,CHANGE_LISTS(d,CONS(a,t))) THEN THIS(GSC_RECEIPT_READING,"THIS");
law GSC_RECEIPT_HAS_DISCHARGED := IF THIS(GSC_CHANGE_LISTS,CHANGE_LISTS(CONS(a,t),o)) THEN THIS(GSC_RECEIPT_READING,"THIS");

// Source-owned complete subjects. Hashing is a generic GPU substrate primitive.
law GSC_GROUND_HASH_REQUEST := IF THIS(GSC_GROUND_INPUT,g), GOES_WITH(GSC_COMPLETE,GROUND_0_012,g)
 THEN THIS(HASH_JSON_REQUEST,GROUND_PREDECESSOR,g);
law GSC_PAIR_OBJECT := IF THIS(GSC_FIELD_INPUT,f), GOES_WITH(GSC_COMPLETE,CURRENT_FIELD,f), THIS(GSC_WITNESS_INPUT,w), GOES_WITH(GSC_COMPLETE,CURRENT_WITNESS,w)
 THEN THIS(GSC_PAIR_OBJECT,OBJECT(CONS(MEMBER("field",f),CONS(MEMBER("witness",w),NIL))));
law GSC_PAIR_HASH_REQUEST := IF THIS(GSC_PAIR_OBJECT,p) THEN THIS(HASH_JSON_REQUEST,GENESIS_PAIR,p);
law GSC_RECEIPT_HASH_REQUEST := IF THIS(GSC_RECEIPT_OBJECT,r) THEN THIS(HASH_JSON_REQUEST,GENESIS_RECEIPT,r);
// Empty objects are accepted as no hash responses, never as positive witnesses.
law GSC_HASH_ROWS := IF THIS(GSC_HASH_INPUT,OBJECT(xs)) THEN THIS(GSC_HASH_ROWS,xs);
law GSC_LINK_ROWS := IF THIS(GSC_LINK_INPUT,OBJECT(xs)) THEN THIS(GSC_HASH_ROWS,xs);
law GSC_HASH_TAIL := IF THIS(GSC_HASH_ROWS,CONS(a,t)) THEN THIS(GSC_HASH_ROWS,t);
law GSC_HASH_RESPONSE := IF THIS(GSC_HASH_ROWS,CONS(MEMBER(id,OBJECT(CONS(MEMBER("digest",h),CONS(MEMBER("value",v),NIL)))),tail))
 THEN GOES_WITH(GSC_HASH_RESPONSE,id,h,v);
@propose seed GSC_BOUND_PREDECESSOR := {
 THIS(GSC_EXPECTED_PREDECESSOR_HASH,"b263644e59a696999c02dfd25386a5abefdb2d0fc4317a0fe2cccd90502ebad3")
};
law GSC_GROUND_HASH_BOUND := IF GOES_WITH(GSC_HASH_RESPONSE,"GROUND_PREDECESSOR",h,g), THIS(GSC_EXPECTED_PREDECESSOR_HASH,h), THIS(GSC_GROUND_INPUT,g), GOES_WITH(GSC_COMPLETE,GROUND_0_012,g)
 THEN THIS(GSC_PREDECESSOR_HASH,h);
law GSC_PAIR_HASH_BOUND := IF GOES_WITH(GSC_HASH_RESPONSE,"GENESIS_PAIR",h,p), THIS(GSC_PAIR_OBJECT,p)
 THEN GOES_WITH(GSC_PAIR_HASH,p,h);
law GSC_RECEIPT_HASH_BOUND := IF GOES_WITH(GSC_HASH_RESPONSE,"GENESIS_RECEIPT",h,r), THIS(GSC_RECEIPT_OBJECT,r)
 THEN GOES_WITH(GSC_RECEIPT_HASH,r,h);
law GSC_RECORD_PARTS := IF GOES_WITH(GSC_PAIR_HASH,OBJECT(CONS(MEMBER("field",f),CONS(MEMBER("witness",w),NIL))),p), GOES_WITH(GSC_RECEIPT_HASH,r,q), THIS(GSC_PREDECESSOR_HASH,g), THIS(GSC_RECEIPT_READING,s), GOES_WITH(GENESIS_EVENT,h,m,t,j,site)
 THEN THIS(GSC_RECORD_PARTS,PARTS(f,w,r,p,q,g,s,h));
law GSC_LINK_RECORD := IF THIS(GSC_RECORD_PARTS,PARTS(f,w,r,p,q,g,s,h))
 THEN THIS(GSC_LINK_RECORD,OBJECT(CONS(MEMBER("event_record",h),CONS(MEMBER("field",f),CONS(MEMBER("kind","GENESIS"),CONS(MEMBER("pair_hash",p),CONS(MEMBER("prev",g),CONS(MEMBER("receipt",r),CONS(MEMBER("receipt_hash",q),CONS(MEMBER("receipt_reading",s),CONS(MEMBER("witness",w),NIL)))))))))));
law GSC_LINK_HASH_REQUEST := IF THIS(GSC_LINK_RECORD,r) THEN THIS(HASH_JSON_REQUEST,GENESIS_LINK,r);
law GSC_LINK_HASH_BOUND := IF GOES_WITH(GSC_HASH_RESPONSE,"GENESIS_LINK",h,r), THIS(GSC_LINK_RECORD,r)
 THEN GOES_WITH(GSC_LINK_HASH,r,h);
// ONE chain entry. The GPU publishes field, witness, receipt and its linked record
// together; no host stage can supply a COMMITTED_GENESIS fact.
law GSC_CHAIN_ENTRY := IF GOES_WITH(GSC_LINK_HASH,r,h)
 THEN GOES_WITH(GSC_CHAIN_ENTRY,r,OBJECT(CONS(MEMBER("link",h),CONS(MEMBER("record",r),NIL))));
law GSC_COMMIT := IF GOES_WITH(GSC_CHAIN_ENTRY,record,e), THIS(GSC_RECORD_PARTS,PARTS(f,w,r,p,q,g,s,h)), THIS(GSC_LINK_RECORD,record), GOES_WITH(GSC_LINK_HASH,record,link)
 THEN THIS(COMMITTED_GENESIS,OBJECT(CONS(MEMBER("chain",ARRAY(CONS(e,NIL))),CONS(MEMBER("field",f),CONS(MEMBER("receipt",r),CONS(MEMBER("witness",w),NIL))))));
