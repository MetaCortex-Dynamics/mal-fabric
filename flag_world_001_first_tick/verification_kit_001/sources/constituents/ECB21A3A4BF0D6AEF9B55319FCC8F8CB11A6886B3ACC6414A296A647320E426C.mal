@readonly input FRAME_DIGEST := "frame:/sha256";
@readonly input FRAME_SIZE := "frame:/size";
@readonly input FRAME_MAGIC := "frame:/fields/magic";
@readonly input FRAME_VERSION := "frame:/fields/version";
@readonly input FRAME_KIND := "frame:/fields/kind";
@readonly input FRAME_PHASE := "frame:/fields/phase";
