 GOES_WITH(HARDWARE_FACE,W_11,HW_03,HW_07,HW_08),
 GOES_WITH(HARDWARE_FACE,W_12,HW_04,HW_05,HW_09),
 GOES_WITH(HARDWARE_FACE,W_13,HW_04,HW_08,HW_09),
 GOES_WITH(HARDWARE_FACE,W_14,HW_05,HW_09,HW_10),
 GOES_WITH(HARDWARE_FACE,W_15,HW_06,HW_07,HW_11),
 GOES_WITH(HARDWARE_FACE,W_16,HW_06,HW_10,HW_11),
 GOES_WITH(HARDWARE_FACE,W_17,HW_07,HW_08,HW_11),
 GOES_WITH(HARDWARE_FACE,W_18,HW_08,HW_09,HW_11),
 GOES_WITH(HARDWARE_FACE,W_19,HW_09,HW_10,HW_11),
 GOES_WITH(DOMAIN_NEXT,HW_00,HW_01),
 GOES_WITH(DOMAIN_NEXT,HW_01,HW_02),
 GOES_WITH(DOMAIN_NEXT,HW_02,HW_03),
 GOES_WITH(DOMAIN_NEXT,HW_03,HW_04),
 GOES_WITH(DOMAIN_NEXT,HW_04,HW_05),
 GOES_WITH(DOMAIN_NEXT,HW_05,HW_06),
 GOES_WITH(DOMAIN_NEXT,HW_06,HW_07),
 GOES_WITH(DOMAIN_NEXT,HW_07,HW_08),
 GOES_WITH(DOMAIN_NEXT,HW_08,HW_09),
 GOES_WITH(DOMAIN_NEXT,HW_09,HW_10),
 GOES_WITH(DOMAIN_NEXT,HW_10,HW_11)
};
law BASE_FROM_HARDWARE := IF GOES_WITH(HARDWARE_FACE,w,a,b,c) THEN THIS(BASE_TRIAD,TOGETHER_ALONE(a,b,c));
law REFINE_A :=
  IF THIS(BASE_TRIAD,TOGETHER_ALONE(a,b,c))
  THEN THIS(REFINED_TRIAD,TOGETHER_ALONE(THIS(a),TOGETHER_ALONE(a,b),TOGETHER_ALONE(a,c)));
law REFINE_B :=
  IF THIS(BASE_TRIAD,TOGETHER_ALONE(a,b,c))
  THEN THIS(REFINED_TRIAD,TOGETHER_ALONE(THIS(b),TOGETHER_ALONE(a,b),TOGETHER_ALONE(b,c)));
law REFINE_C :=
  IF THIS(BASE_TRIAD,TOGETHER_ALONE(a,b,c))
  THEN THIS(REFINED_TRIAD,TOGETHER_ALONE(THIS(c),TOGETHER_ALONE(a,c),TOGETHER_ALONE(b,c)));
law REFINE_CENTRE :=
  IF THIS(BASE_TRIAD,TOGETHER_ALONE(a,b,c))
  THEN THIS(REFINED_TRIAD,TOGETHER_ALONE(TOGETHER_ALONE(a,b),TOGETHER_ALONE(a,c),TOGETHER_ALONE(b,c)));

law SITE_A := IF THIS(REFINED_TRIAD,TOGETHER_ALONE(a,b,c)) THEN THIS(SITE,a);
law SITE_B := IF THIS(REFINED_TRIAD,TOGETHER_ALONE(a,b,c)) THEN THIS(SITE,b);
law SITE_C := IF THIS(REFINED_TRIAD,TOGETHER_ALONE(a,b,c)) THEN THIS(SITE,c);




law ORDER_BASE := IF GOES_WITH(DOMAIN_NEXT,a,b) THEN GOES_WITH(DOMAIN_ORDER,a,b);
law ORDER_TRANSITIVE := IF GOES_WITH(DOMAIN_ORDER,a,b), GOES_WITH(DOMAIN_NEXT,b,c) THEN GOES_WITH(DOMAIN_ORDER,a,c);
law ORDER_DOMAINS :=
  IF THIS(SITE,THIS(a)), THIS(SITE,THIS(b)), GOES_WITH(DOMAIN_ORDER,a,b)
  THEN GOES_WITH(SITE_ORDER,THIS(a),THIS(b));
law ORDER_MIDPOINT_DOMAIN :=
  IF THIS(SITE,TOGETHER_ALONE(a,b)), THIS(SITE,THIS(c))
  THEN GOES_WITH(SITE_ORDER,TOGETHER_ALONE(a,b),THIS(c));
law ORDER_MIDPOINT_FIRST :=
  IF THIS(SITE,TOGETHER_ALONE(a,b)), THIS(SITE,TOGETHER_ALONE(c,d)), GOES_WITH(DOMAIN_ORDER,a,c)
  THEN GOES_WITH(SITE_ORDER,TOGETHER_ALONE(a,b),TOGETHER_ALONE(c,d));
law ORDER_MIDPOINT_SECOND :=
  IF THIS(SITE,TOGETHER_ALONE(a,b)), THIS(SITE,TOGETHER_ALONE(a,c)), GOES_WITH(DOMAIN_ORDER,b,c)
  THEN GOES_WITH(SITE_ORDER,TOGETHER_ALONE(a,b),TOGETHER_ALONE(a,c));


law TRIAD_ABC := IF THIS(REFINED_TRIAD,TOGETHER_ALONE(a,b,c)), GOES_WITH(SITE_ORDER,a,b), GOES_WITH(SITE_ORDER,b,c) THEN THIS(TRIAD,TOGETHER_ALONE(a,b,c));
law TRIAD_ACB := IF THIS(REFINED_TRIAD,TOGETHER_ALONE(a,c,b)), GOES_WITH(SITE_ORDER,a,b), GOES_WITH(SITE_ORDER,b,c) THEN THIS(TRIAD,TOGETHER_ALONE(a,b,c));
law TRIAD_BAC := IF THIS(REFINED_TRIAD,TOGETHER_ALONE(b,a,c)), GOES_WITH(SITE_ORDER,a,b), GOES_WITH(SITE_ORDER,b,c) THEN THIS(TRIAD,TOGETHER_ALONE(a,b,c));
law TRIAD_BCA := IF THIS(REFINED_TRIAD,TOGETHER_ALONE(b,c,a)), GOES_WITH(SITE_ORDER,a,b), GOES_WITH(SITE_ORDER,b,c) THEN THIS(TRIAD,TOGETHER_ALONE(a,b,c));
law TRIAD_CAB := IF THIS(REFINED_TRIAD,TOGETHER_ALONE(c,a,b)), GOES_WITH(SITE_ORDER,a,b), GOES_WITH(SITE_ORDER,b,c) THEN THIS(TRIAD,TOGETHER_ALONE(a,b,c));
law TRIAD_CBA := IF THIS(REFINED_TRIAD,TOGETHER_ALONE(c,b,a)), GOES_WITH(SITE_ORDER,a,b), GOES_WITH(SITE_ORDER,b,c) THEN THIS(TRIAD,TOGETHER_ALONE(a,b,c));

law EDGE_AB := IF THIS(TRIAD,TOGETHER_ALONE(a,b,c)) THEN GOES_WITH(EDGE_IN_TRIAD,TOGETHER_ALONE(a,b),TOGETHER_ALONE(a,b,c));
law EDGE_AC := IF THIS(TRIAD,TOGETHER_ALONE(a,b,c)) THEN GOES_WITH(EDGE_IN_TRIAD,TOGETHER_ALONE(a,c),TOGETHER_ALONE(a,b,c));
law EDGE_BC := IF THIS(TRIAD,TOGETHER_ALONE(a,b,c)) THEN GOES_WITH(EDGE_IN_TRIAD,TOGETHER_ALONE(b,c),TOGETHER_ALONE(a,b,c));
law EDGE := IF GOES_WITH(EDGE_IN_TRIAD,e,t) THEN THIS(EDGE,e);
law FLAG_FIRST := IF GOES_WITH(EDGE_IN_TRIAD,TOGETHER_ALONE(a,b),t) THEN THIS(FLAG,TOGETHER_ALONE(a,TOGETHER_ALONE(a,b),t));
law FLAG_SECOND := IF GOES_WITH(EDGE_IN_TRIAD,TOGETHER_ALONE(a,b),t) THEN THIS(FLAG,TOGETHER_ALONE(b,TOGETHER_ALONE(a,b),t));


// Continuation of incidence.mal; D2 tick.py:28-35.
// These declarations are concatenated by byte transport before structural seating.
// No evaluated carrier or expected vector is supplied by that transport.
law DELTA_FIRST := IF GOES_WITH(EDGE_IN_TRIAD,TOGETHER_ALONE(a,b),t) THEN GOES_WITH(DELTA,TOGETHER_ALONE(a,TOGETHER_ALONE(a,b),t),TOGETHER_ALONE(b,TOGETHER_ALONE(a,b),t));
law DELTA_SECOND := IF GOES_WITH(DELTA,f,g) THEN GOES_WITH(DELTA,g,f);

law GAMMA_A := IF THIS(TRIAD,TOGETHER_ALONE(a,b,c)) THEN GOES_WITH(GAMMA,TOGETHER_ALONE(a,TOGETHER_ALONE(a,b),TOGETHER_ALONE(a,b,c)),TOGETHER_ALONE(a,TOGETHER_ALONE(a,c),TOGETHER_ALONE(a,b,c)));
law GAMMA_B := IF THIS(TRIAD,TOGETHER_ALONE(a,b,c)) THEN GOES_WITH(GAMMA,TOGETHER_ALONE(b,TOGETHER_ALONE(a,b),TOGETHER_ALONE(a,b,c)),TOGETHER_ALONE(b,TOGETHER_ALONE(b,c),TOGETHER_ALONE(a,b,c)));
law GAMMA_C := IF THIS(TRIAD,TOGETHER_ALONE(a,b,c)) THEN GOES_WITH(GAMMA,TOGETHER_ALONE(c,TOGETHER_ALONE(a,c),TOGETHER_ALONE(a,b,c)),TOGETHER_ALONE(c,TOGETHER_ALONE(b,c),TOGETHER_ALONE(a,b,c)));
law GAMMA_REVERSE := IF GOES_WITH(GAMMA,f,g) THEN GOES_WITH(GAMMA,g,f);

law OPPOSITE_AB := IF THIS(TRIAD,TOGETHER_ALONE(a,b,c)) THEN GOES_WITH(EDGE_OPPOSITE,TOGETHER_ALONE(a,b),c,TOGETHER_ALONE(a,b,c));
law OPPOSITE_AC := IF THIS(TRIAD,TOGETHER_ALONE(a,b,c)) THEN GOES_WITH(EDGE_OPPOSITE,TOGETHER_ALONE(a,c),b,TOGETHER_ALONE(a,b,c));
law OPPOSITE_BC := IF THIS(TRIAD,TOGETHER_ALONE(a,b,c)) THEN GOES_WITH(EDGE_OPPOSITE,TOGETHER_ALONE(b,c),a,TOGETHER_ALONE(a,b,c));
// With two shared sites fixed, ordering the third orders the sorted triad tuple.
law ADJACENT_TRIADS := IF GOES_WITH(EDGE_OPPOSITE,e,a,t), GOES_WITH(EDGE_OPPOSITE,e,b,u), GOES_WITH(SITE_ORDER,a,b) THEN GOES_WITH(ADJACENT_TRIADS,e,t,u);
law TAU_FIRST := IF GOES_WITH(ADJACENT_TRIADS,TOGETHER_ALONE(a,b),t,u) THEN GOES_WITH(TAU,TOGETHER_ALONE(a,TOGETHER_ALONE(a,b),t),TOGETHER_ALONE(a,TOGETHER_ALONE(a,b),u));
law TAU_SECOND := IF GOES_WITH(ADJACENT_TRIADS,TOGETHER_ALONE(a,b),t,u) THEN GOES_WITH(TAU,TOGETHER_ALONE(b,TOGETHER_ALONE(a,b),t),TOGETHER_ALONE(b,TOGETHER_ALONE(a,b),u));
law TAU_REVERSE := IF GOES_WITH(TAU,f,g) THEN GOES_WITH(TAU,g,f);

// D2's unordered overlaps, represented once in its lexicographic flag order.
law PAIR_DELTA := IF GOES_WITH(EDGE_IN_TRIAD,TOGETHER_ALONE(a,b),t) THEN GOES_WITH(PAIR,TOGETHER_ALONE(a,TOGETHER_ALONE(a,b),t),TOGETHER_ALONE(b,TOGETHER_ALONE(a,b),t));
law PAIR_GAMMA_A := IF THIS(TRIAD,TOGETHER_ALONE(a,b,c)) THEN GOES_WITH(PAIR,TOGETHER_ALONE(a,TOGETHER_ALONE(a,b),TOGETHER_ALONE(a,b,c)),TOGETHER_ALONE(a,TOGETHER_ALONE(a,c),TOGETHER_ALONE(a,b,c)));
law PAIR_GAMMA_B := IF THIS(TRIAD,TOGETHER_ALONE(a,b,c)) THEN GOES_WITH(PAIR,TOGETHER_ALONE(b,TOGETHER_ALONE(a,b),TOGETHER_ALONE(a,b,c)),TOGETHER_ALONE(b,TOGETHER_ALONE(b,c),TOGETHER_ALONE(a,b,c)));
law PAIR_GAMMA_C := IF THIS(TRIAD,TOGETHER_ALONE(a,b,c)) THEN GOES_WITH(PAIR,TOGETHER_ALONE(c,TOGETHER_ALONE(a,c),TOGETHER_ALONE(a,b,c)),TOGETHER_ALONE(c,TOGETHER_ALONE(b,c),TOGETHER_ALONE(a,b,c)));
law PAIR_TAU_FIRST := IF GOES_WITH(ADJACENT_TRIADS,TOGETHER_ALONE(a,b),t,u) THEN GOES_WITH(PAIR,TOGETHER_ALONE(a,TOGETHER_ALONE(a,b),t),TOGETHER_ALONE(a,TOGETHER_ALONE(a,b),u));
law PAIR_TAU_SECOND := IF GOES_WITH(ADJACENT_TRIADS,TOGETHER_ALONE(a,b),t,u) THEN GOES_WITH(PAIR,TOGETHER_ALONE(b,TOGETHER_ALONE(a,b),t),TOGETHER_ALONE(b,TOGETHER_ALONE(a,b),u));

// A refined world flag is not equated with a hardware junction.
// Its midpoint site identifies a junction; its refined triad has a hardware-face parent.
law DOMAIN_SITE := IF THIS(SITE,THIS(a)) THEN GOES_WITH(WORLD_DOMAIN_SITE,THIS(a),a);
law JUNCTION_SITE := IF GOES_WITH(HARDWARE_EDGE,j,a,b), THIS(SITE,TOGETHER_ALONE(a,b)) THEN GOES_WITH(WORLD_JUNCTION_SITE,TOGETHER_ALONE(a,b),j);
law PARENT_A := IF GOES_WITH(HARDWARE_FACE,w,a,b,c) THEN GOES_WITH(REFINED_PARENT,TOGETHER_ALONE(THIS(a),TOGETHER_ALONE(a,b),TOGETHER_ALONE(a,c)),w);
law PARENT_B := IF GOES_WITH(HARDWARE_FACE,w,a,b,c) THEN GOES_WITH(REFINED_PARENT,TOGETHER_ALONE(THIS(b),TOGETHER_ALONE(a,b),TOGETHER_ALONE(b,c)),w);
law PARENT_C := IF GOES_WITH(HARDWARE_FACE,w,a,b,c) THEN GOES_WITH(REFINED_PARENT,TOGETHER_ALONE(THIS(c),TOGETHER_ALONE(a,c),TOGETHER_ALONE(b,c)),w);
law PARENT_CENTRE := IF GOES_WITH(HARDWARE_FACE,w,a,b,c) THEN GOES_WITH(REFINED_PARENT,TOGETHER_ALONE(TOGETHER_ALONE(a,b),TOGETHER_ALONE(a,c),TOGETHER_ALONE(b,c)),w);
law FACE_PARENT_ABC := IF GOES_WITH(REFINED_PARENT,TOGETHER_ALONE(a,b,c),w), THIS(TRIAD,TOGETHER_ALONE(a,b,c)) THEN GOES_WITH(WORLD_TRIAD_FACE,TOGETHER_ALONE(a,b,c),w);
law FACE_PARENT_ACB := IF GOES_WITH(REFINED_PARENT,TOGETHER_ALONE(a,c,b),w), THIS(TRIAD,TOGETHER_ALONE(a,b,c)) THEN GOES_WITH(WORLD_TRIAD_FACE,TOGETHER_ALONE(a,b,c),w);
law FACE_PARENT_BAC := IF GOES_WITH(REFINED_PARENT,TOGETHER_ALONE(b,a,c),w), THIS(TRIAD,TOGETHER_ALONE(a,b,c)) THEN GOES_WITH(WORLD_TRIAD_FACE,TOGETHER_ALONE(a,b,c),w);
law FACE_PARENT_BCA := IF GOES_WITH(REFINED_PARENT,TOGETHER_ALONE(b,c,a),w), THIS(TRIAD,TOGETHER_ALONE(a,b,c)) THEN GOES_WITH(WORLD_TRIAD_FACE,TOGETHER_ALONE(a,b,c),w);
law FACE_PARENT_CAB := IF GOES_WITH(REFINED_PARENT,TOGETHER_ALONE(c,a,b),w), THIS(TRIAD,TOGETHER_ALONE(a,b,c)) THEN GOES_WITH(WORLD_TRIAD_FACE,TOGETHER_ALONE(a,b,c),w);
law FACE_PARENT_CBA := IF GOES_WITH(REFINED_PARENT,TOGETHER_ALONE(c,b,a),w), THIS(TRIAD,TOGETHER_ALONE(a,b,c)) THEN GOES_WITH(WORLD_TRIAD_FACE,TOGETHER_ALONE(a,b,c),w);
law FLAG_FACE := IF THIS(FLAG,TOGETHER_ALONE(v,e,t)), GOES_WITH(WORLD_TRIAD_FACE,t,w) THEN GOES_WITH(WORLD_FLAG_FACE,TOGETHER_ALONE(v,e,t),w);

// Hardware domain transport spelling; not a selected kappa.
@propose seed DOMAIN_OBSERVATION_BYTES := {
 GOES_WITH(DOMAIN_TEXT,HW_00,"HW_00"),
 GOES_WITH(DOMAIN_TEXT,HW_01,"HW_01"),
 GOES_WITH(DOMAIN_TEXT,HW_02,"HW_02"),
 GOES_WITH(DOMAIN_TEXT,HW_03,"HW_03"),
 GOES_WITH(DOMAIN_TEXT,HW_04,"HW_04"),
 GOES_WITH(DOMAIN_TEXT,HW_05,"HW_05"),
 GOES_WITH(DOMAIN_TEXT,HW_06,"HW_06"),
 GOES_WITH(DOMAIN_TEXT,HW_07,"HW_07"),
 GOES_WITH(DOMAIN_TEXT,HW_08,"HW_08"),
 GOES_WITH(DOMAIN_TEXT,HW_09,"HW_09"),
 GOES_WITH(DOMAIN_TEXT,HW_10,"HW_10"),
 GOES_WITH(DOMAIN_TEXT,HW_11,"HW_11")
};
law DOMAIN_OBSERVATION := IF THIS(SITE,THIS(d)), GOES_WITH(DOMAIN_TEXT,d,TEXT(a))
 THEN GOES_WITH(SITE_TEXT,THIS(d),TEXT(CONS(B68,CONS(B58,a))));
law MIDPOINT_JOIN := IF THIS(SITE,TOGETHER_ALONE(d,e)), GOES_WITH(DOMAIN_TEXT,d,TEXT(a)), GOES_WITH(DOMAIN_TEXT,e,TEXT(b))
 THEN THIS(BYTE_JOIN,a,CONS(B124,b));
law JOIN_TAIL := IF THIS(BYTE_JOIN,CONS(h,t),b) THEN THIS(BYTE_JOIN,t,b);
law JOIN_EMPTY := IF THIS(BYTE_JOIN,NIL,b) THEN GOES_WITH(BYTE_JOINED,NIL,b,b);
law JOIN_CONS := IF THIS(BYTE_JOIN,CONS(h,t),b), GOES_WITH(BYTE_JOINED,t,b,r)
 THEN GOES_WITH(BYTE_JOINED,CONS(h,t),b,CONS(h,r));
law MIDPOINT_OBSERVATION := IF THIS(SITE,TOGETHER_ALONE(d,e)), GOES_WITH(DOMAIN_TEXT,d,TEXT(a)), GOES_WITH(DOMAIN_TEXT,e,TEXT(b)), GOES_WITH(BYTE_JOINED,a,CONS(B124,b),r)
 THEN GOES_WITH(SITE_TEXT,TOGETHER_ALONE(d,e),TEXT(CONS(B67,CONS(B58,r))));
law EDGE_OBSERVATION := IF THIS(EDGE,TOGETHER_ALONE(a,b)), GOES_WITH(SITE_TEXT,a,x), GOES_WITH(SITE_TEXT,b,y)
 THEN GOES_WITH(EDGE_JSON,TOGETHER_ALONE(a,b),ARRAY(CONS(x,CONS(y,NIL))));
law TRIAD_OBSERVATION := IF THIS(TRIAD,TOGETHER_ALONE(a,b,c)), GOES_WITH(SITE_TEXT,a,x), GOES_WITH(SITE_TEXT,b,y), GOES_WITH(SITE_TEXT,c,z)
 THEN GOES_WITH(TRIAD_JSON,TOGETHER_ALONE(a,b,c),ARRAY(CONS(x,CONS(y,CONS(z,NIL)))));
law FLAG_OBSERVATION := IF THIS(FLAG,TOGETHER_ALONE(s,e,t)), GOES_WITH(SITE_TEXT,s,a), GOES_WITH(EDGE_JSON,e,b), GOES_WITH(TRIAD_JSON,t,c)
 THEN GOES_WITH(FLAG_JSON,TOGETHER_ALONE(s,e,t),ARRAY(CONS(a,CONS(b,CONS(c,NIL)))));

// Devon, 2026-10-21: x_t := Ground_0(012), every flag NO; current unbound.
// Parent flags come only from retained 012 hardware incidence.
// This is the archived predecessor operand, not event capture or genesis commit.
// No kappa, E0, selected face, fixture or current-field declaration is imported.
law GROUND_PREDECESSOR_FIELD := IF THIS(FLAG,f)
 THEN GOES_WITH(ARCHIVED_PREDECESSOR_FIELD,GROUND_0_012,f,NO);

// Observation encoding only. FLAG_JSON is the retained 012 source encoding.
law GROUND_PREDECESSOR_ROW := IF GOES_WITH(ARCHIVED_PREDECESSOR_FIELD,GROUND_0_012,f,NO), GOES_WITH(FLAG_JSON,f,j)
 THEN THIS(OBSERVATION_ROW,GROUND_0_012,ARRAY(CONS(j,CONS("NO",NIL))));


// JTP v0.1.0:26-30,44: header locus independent of opcode and payload.
