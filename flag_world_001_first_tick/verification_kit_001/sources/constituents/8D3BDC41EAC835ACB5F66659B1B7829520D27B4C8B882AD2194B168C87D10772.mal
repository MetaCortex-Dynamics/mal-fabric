 GOES_WITH(HARDWARE_EDGE,J_18,HW_05,HW_09),
 GOES_WITH(BASE_EDGE,HW_05,HW_10),
 GOES_WITH(HARDWARE_EDGE,J_19,HW_05,HW_10),
 GOES_WITH(BASE_EDGE,HW_06,HW_07),
 GOES_WITH(HARDWARE_EDGE,J_20,HW_06,HW_07),
 GOES_WITH(BASE_EDGE,HW_06,HW_10),
 GOES_WITH(HARDWARE_EDGE,J_21,HW_06,HW_10),
 GOES_WITH(BASE_EDGE,HW_06,HW_11),
 GOES_WITH(HARDWARE_EDGE,J_22,HW_06,HW_11),
