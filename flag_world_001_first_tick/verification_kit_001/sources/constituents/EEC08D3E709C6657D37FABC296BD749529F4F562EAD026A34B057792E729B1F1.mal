 GOES_WITH(HARDWARE_EDGE,J_25,HW_08,HW_09),
 GOES_WITH(BASE_EDGE,HW_08,HW_11),
 GOES_WITH(HARDWARE_EDGE,J_26,HW_08,HW_11),
 GOES_WITH(BASE_EDGE,HW_09,HW_10),
 GOES_WITH(HARDWARE_EDGE,J_27,HW_09,HW_10),
 GOES_WITH(BASE_EDGE,HW_09,HW_11),
 GOES_WITH(HARDWARE_EDGE,J_28,HW_09,HW_11),
 GOES_WITH(BASE_EDGE,HW_10,HW_11),
 GOES_WITH(HARDWARE_EDGE,J_29,HW_10,HW_11),
 GOES_WITH(HARDWARE_FACE,W_00,HW_00,HW_01,HW_02),
