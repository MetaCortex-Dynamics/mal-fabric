// JTP v0.1.0:26-30,44: header locus independent of opcode and payload.
// Exact captured kind-3 frame: QG-JTP-K0C-FIRST16-CAPTURE-021 corrective-002.
// Source-owned transport spelling of the canon header's five-coordinate rows.
// Parent motif_junction_table_v1.h SHA256
// 25AF837405F450986FBD24A425D2197BD5E5D9D4BF952F74BE43CFB992B10F64.
// Hex strings and J identifiers are compared by identity, never ordered.
@propose seed JUNCTION_HEADER_IDENTITIES := {
 GOES_WITH(HEADER_JUNCTION,"0001050001",J_00),
 GOES_WITH(HEADER_JUNCTION,"0101020002",J_01),
 GOES_WITH(HEADER_JUNCTION,"0202060003",J_02),
 GOES_WITH(HEADER_JUNCTION,"0302060004",J_03),
 GOES_WITH(HEADER_JUNCTION,"0402050005",J_04),
 GOES_WITH(HEADER_JUNCTION,"0501030102",J_05),
