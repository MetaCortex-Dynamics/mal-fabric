// EXECUTE DECISION_RECORD_GPU_SELF_WITNESS_001, promoted 2CBBA4AD...BCE7.
// The captured header supplies the site; its payload supplies no address.
// The hardware-lane append is not a game-world gate. Original 017 is preserved.
// Complete NO/THIS field: exactly the site support bound in that decision.
law EVENT_SITE := IF GOES_WITH(ARCHIVED_PHYSICAL_CLOSED_LOCUS,h,m,t,j,s)
 THEN GOES_WITH(GENESIS_EVENT,h,m,t,j,s);
law CURRENT_THIS := IF GOES_WITH(GENESIS_EVENT,h,m,t,j,s), THIS(FLAG,TOGETHER_ALONE(s,e,u))
 THEN GOES_WITH(CURRENT_FIELD,TOGETHER_ALONE(s,e,u),THIS);
// The symmetric closure of the retained observation order witnesses inequality
// only. Reversing that encoding order leaves every resulting reading SAME.
// No first/minimal identifier, direction or face is selected.
law SITE_DIFFER_FORWARD := IF GOES_WITH(SITE_ORDER,a,b)
 THEN GOES_WITH(DISTINCT_SITE,a,b);
law SITE_DIFFER_REVERSE := IF GOES_WITH(SITE_ORDER,a,b)
 THEN GOES_WITH(DISTINCT_SITE,b,a);
law CURRENT_NO := IF GOES_WITH(GENESIS_EVENT,h,m,t,j,s), THIS(FLAG,TOGETHER_ALONE(v,e,u)), GOES_WITH(DISTINCT_SITE,v,s)
 THEN GOES_WITH(CURRENT_FIELD,TOGETHER_ALONE(v,e,u),NO);
@propose seed MARKER_BYTES := {
 GOES_WITH(MARKER_TEXT,THIS,"THIS"), GOES_WITH(MARKER_TEXT,NO,"NO"),
 GOES_WITH(AGREEMENT_TEXT,SAME,"SAME"), GOES_WITH(AGREEMENT_TEXT,NOT_SAME,"NOT_SAME")
};
law FIELD_ROW := IF GOES_WITH(CURRENT_FIELD,f,r), GOES_WITH(FLAG_JSON,f,j), GOES_WITH(MARKER_TEXT,r,text)
 THEN THIS(OBSERVATION_ROW,CURRENT_FIELD,ARRAY(CONS(j,CONS(text,NIL))));

// A4: gluing compares both flags of each canonical overlap in one snapshot.
// Walls are records, not refusal of the self-witnessed genesis pair.
law GLUE_SAME := IF GOES_WITH(PAIR,f,g), GOES_WITH(CURRENT_FIELD,f,r), GOES_WITH(CURRENT_FIELD,g,r)
 THEN GOES_WITH(CURRENT_GLUING,f,g,SAME);
law GLUE_THIS_NO := IF GOES_WITH(PAIR,f,g), GOES_WITH(CURRENT_FIELD,f,THIS), GOES_WITH(CURRENT_FIELD,g,NO)
 THEN GOES_WITH(CURRENT_GLUING,f,g,NOT_SAME);
law GLUE_NO_THIS := IF GOES_WITH(PAIR,f,g), GOES_WITH(CURRENT_FIELD,f,NO), GOES_WITH(CURRENT_FIELD,g,THIS)
 THEN GOES_WITH(CURRENT_GLUING,f,g,NOT_SAME);
law PREDECESSOR_GLUING := IF GOES_WITH(PAIR,f,g), GOES_WITH(ARCHIVED_PREDECESSOR_FIELD,GROUND_0_012,f,r), GOES_WITH(ARCHIVED_PREDECESSOR_FIELD,GROUND_0_012,g,r)
 THEN GOES_WITH(PREDECESSOR_GLUING,f,g,SAME);
law WITNESS_ROW := IF GOES_WITH(CURRENT_GLUING,f,g,r), GOES_WITH(FLAG_JSON,f,a), GOES_WITH(FLAG_JSON,g,b), GOES_WITH(AGREEMENT_TEXT,r,text)
 THEN THIS(OBSERVATION_ROW,CURRENT_WITNESS,ARRAY(CONS(a,CONS(b,CONS(text,NIL)))));
law WALL := IF GOES_WITH(CURRENT_GLUING,f,g,NOT_SAME)
 THEN GOES_WITH(CURRENT_WALL,f,g);

// Receipt is the change of agreement against the archived field, not OCC.
law RECEIPT_UNCHANGED := IF GOES_WITH(PREDECESSOR_GLUING,f,g,SAME), GOES_WITH(CURRENT_GLUING,f,g,SAME)
 THEN GOES_WITH(GENESIS_RECEIPT_PAIR,f,g,"UNCHANGED");
law RECEIPT_OPENED := IF GOES_WITH(PREDECESSOR_GLUING,f,g,SAME), GOES_WITH(CURRENT_GLUING,f,g,NOT_SAME)
 THEN GOES_WITH(GENESIS_RECEIPT_PAIR,f,g,"OPENED");
law RECEIPT_DISCHARGED := IF GOES_WITH(PREDECESSOR_GLUING,f,g,NOT_SAME), GOES_WITH(CURRENT_GLUING,f,g,SAME)
 THEN GOES_WITH(GENESIS_RECEIPT_PAIR,f,g,"DISCHARGED");
law RECEIPT_RETAINED := IF GOES_WITH(PREDECESSOR_GLUING,f,g,NOT_SAME), GOES_WITH(CURRENT_GLUING,f,g,NOT_SAME)
 THEN GOES_WITH(GENESIS_RECEIPT_PAIR,f,g,"RETAINED");
law RECEIPT_ROW := IF GOES_WITH(GENESIS_RECEIPT_PAIR,f,g,r), GOES_WITH(FLAG_JSON,f,a), GOES_WITH(FLAG_JSON,g,b)
 THEN THIS(OBSERVATION_ROW,CURRENT_RECEIPT,ARRAY(CONS(a,CONS(b,CONS(r,NIL)))));
law RECEIPT_CONTENT := IF GOES_WITH(GENESIS_RECEIPT_PAIR,f,g,"OPENED")
 THEN THIS(GENESIS_RECEIPT_READING,"THIS");
law RECEIPT_CONTENT_DISCHARGED := IF GOES_WITH(GENESIS_RECEIPT_PAIR,f,g,"DISCHARGED")
 THEN THIS(GENESIS_RECEIPT_READING,"THIS");
