// STATIC/N08 = evidence/receipts/N08.json
// SHA256 D1843D9023A1DA62FB04A9FA5DF2CD51C02B4C7234AF962F5EE07E70F6E5FFBA.
// STATIC/N09 = evidence/receipts/N09.json
// SHA256 C0D6F39132FEB18E76FF870C900C9B28C006227277AB215C84F0FBDBF8D1EA9E.
// STATIC/N10 = evidence/receipts/N10.json
// SHA256 7CD8373F71B019E7D97412FF631E2A13A4F96B6CABECC09A89F0B89409DA1E37.
// STATIC/C01 = evidence/receipts/C01.json
