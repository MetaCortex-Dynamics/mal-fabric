// EXECUTE frozen V1/V2 through the SAME canonical program and ingress core.
// Governing contacts: FT v0.1.3 2ECF2EEF...C1A01; 116 L11 checked reference
// correspondence; MF_GAME section9 FED38C3B...480557; V3.3 sections2--8.
// VD/VO have constructed and checked all120 observer correspondences, every
// offered lift and its reading, the supplied selected lift, the full field,
// entities, and the exact source-recomputed frozen initial chain.
// No observer correspondence is selected as the actual world's kappa.
//
// The prior genesis entry below IS committed fixture custody. The candidate
// field is NOT a committed world state: it is a prepared proposal observation
// supplied through MF_GAME's external ingress before STEP_FABRIC snapshots
// its admitted frames. h always names that prior genesis link, not a digest
// claimed for the candidate field. Input/admission receipts bind each exact
// candidate observation. vector_commit requires the ACTUAL shared RETURN and
// all720 returned comparisons before publishing a world successor.
//
// This file replaces actual_core_contacts.mal for the frozen-vector runs;
// those two contact files MUST NOT be combined in one realization image.

// The occurrence and its raw JSON flag identity come from the complete
// source-certified observer. Field entries are not producer CellDefs.
law FC_OCCURRENCE := IF GOES_WITH(VO_COMPARATOR,c,f,g), THIS(VO_OPERAND_FIXTURE_READY,FROZEN_VECTOR_OBSERVER)
 THEN GOES_WITH(P20_SOURCE_OCCURRENCE,c,f,g);
law FC_FLAG_JSON := IF GOES_WITH(VO_FLAG_JSON,f,j), THIS(VO_OPERAND_FIXTURE_READY,FROZEN_VECTOR_OBSERVER)
 THEN GOES_WITH(P20_SOURCE_FLAG_JSON,f,j);

// Retain the actual018/019 readout and promoted S/F binding 276EBD71...3108.
// Both incident-face readings place the SAME/WHAT type at INTERIOR(S).
// The fixture supplies only its per-overlap occurrence and containment.
// No capability-to-role inference, default placement, or fixture-local G is
// introduced. The actual readout's provenance remains in every support chain.
law FC_PLACEMENT := IF GOES_WITH(VO_COMPARATOR,c,f,g), GOES_WITH(SF_FACE_ROLE,W_12,J_17,S), GOES_WITH(SF_FACE_ROLE,W_13,J_17,S), GOES_WITH(SF_CAPABILITY,SAME_NOT_SAME,S), THIS(VO_OPERAND_FIXTURE_READY,FROZEN_VECTOR_OBSERVER)
 THEN GOES_WITH(P20_SOURCE_PLACEMENT,c,LOCATION(INTERIOR(S),CONTAINMENT(FIRST_TICK,OVERLAP(f,g))));
law FC_ADMISSION := IF THIS(READOUT_CURRENT_ADMITTED), GOES_WITH(VO_COMPARATOR,c,f,g), GOES_WITH(P20_SOURCE_PLACEMENT,c,location), THIS(VO_OPERAND_FIXTURE_READY,FROZEN_VECTOR_OBSERVER)
 THEN GOES_WITH(P20_SOURCE_ADMISSION,c,ADMISSION(SF_BINDING_001,location));

// Source maps the checked720 pair sequence to the core's three-column
// coverage schema. Its comparison column is proposal observation evidence,
// never an I20 result or receipt. The core uses these rows for reverse pair
// coverage; runtime independently evaluates each admitted frame afterward.
@propose seed FC_OBSERVATION_ENCODING := {
 GOES_WITH(FC_READING_TEXT,SAME,"SAME"),
 GOES_WITH(FC_READING_TEXT,NOT_SAME,"NOT_SAME")
};
law FC_COVERAGE_ROWS := IF THIS(VO_PAIR_SEQUENCE,ARRAY(rows))
 THEN THIS(FC_COVERAGE_ROWS,rows);
law FC_COVERAGE_TAIL := IF THIS(FC_COVERAGE_ROWS,CONS(row,tail))
 THEN THIS(FC_COVERAGE_ROWS,tail);
law FC_COMPARISON := IF GOES_WITH(VO_PAIR,f,g), GOES_WITH(VO_FIELD,CANDIDATE,f,a), GOES_WITH(VO_FIELD,CANDIDATE,g,b), GOES_WITH(JTP_SAME_RESULT,MARKER(a),MARKER(b),word,reading), GOES_WITH(FC_READING_TEXT,reading,text)
 THEN GOES_WITH(FC_COMPARISON,f,g,text);
law FC_COVERAGE_END := IF THIS(FC_COVERAGE_ROWS,NIL)
 THEN GOES_WITH(FC_COVERAGE_SUFFIX,NIL,NIL);
law FC_COVERAGE_HEAD := IF THIS(FC_COVERAGE_ROWS,CONS(ARRAY(CONS(f,CONS(g,NIL))),tail)), GOES_WITH(FC_COMPARISON,f,g,text), GOES_WITH(FC_COVERAGE_SUFFIX,tail,rows)
 THEN GOES_WITH(FC_COVERAGE_SUFFIX,CONS(ARRAY(CONS(f,CONS(g,NIL))),tail),CONS(ARRAY(CONS(f,CONS(g,CONS(text,NIL)))),rows));
law FC_COVERAGE := IF THIS(VO_PAIR_SEQUENCE,ARRAY(pairs)), GOES_WITH(FC_COVERAGE_SUFFIX,pairs,rows), THIS(VO_OPERAND_FIXTURE_READY,FROZEN_VECTOR_OBSERVER)
 THEN THIS(P20_SOURCE_COVERAGE,ARRAY(rows));

// This contact names ONLY the frozen predecessor, whose hash and full entry
// were reconstructed from source then matched against its initial chain.
law FC_SNAPSHOT := IF GOES_WITH(VO_FIXTURE_PARENT,basis,h,entry), THIS(VD_INITIAL_CHAIN_MATCH), THIS(VO_OPERAND_FIXTURE_READY,FROZEN_VECTOR_OBSERVER)
 THEN GOES_WITH(P20_SOURCE_SNAPSHOT,h,entry);
law FC_ADMITTED := IF GOES_WITH(P20_SOURCE_SNAPSHOT,h,entry), GOES_WITH(VO_FIXTURE_PARENT,basis,h,entry), THIS(VO_DECISION,DECISION(PROPOSAL(basis,entity,kind,target,lifts),selected)), THIS(VD_INITIAL_CHAIN_MATCH)
 THEN THIS(P20_SOURCE_ADMITTED,h);

// Prepared external ingress observations: snapshot/commit custody stays at
// the predecessor h. The candidate is not promoted or committed here.
law FC_OPERAND := IF GOES_WITH(P20_SOURCE_SNAPSHOT,h,entry), GOES_WITH(VO_FIXTURE_PARENT,basis,h,entry), THIS(VO_DECISION,DECISION(PROPOSAL(basis,entity,kind,target,lifts),selected)), THIS(VO_OPERAND_FIXTURE_READY,FROZEN_VECTOR_OBSERVER), GOES_WITH(VO_FIELD,CANDIDATE,f,reading)
 THEN GOES_WITH(P20_SOURCE_OPERAND,h,f,reading);

// EXECUTE retained FT v0.1.3 and S/F decision 276EBD71...A1983108 C2.
// Static contact: E328B574...D8D68F1 sections 3--8,13 and reference/kernel.py
// 8B983301...4347C0 (CellDef, containment, DRC, canonical normalization).
// Initial operand custody is MF_GAME section 9, FED38C3B...480557. This
// source declares a comparator-only program: snapshot ingress is NOT an
// internal RESULT route and does not manufacture marker CellDefs.
//
// Inputs, all custody rather than verdicts:
//   P20_INVENTORY: [cell_digest, flag_json_left, flag_json_right] rows, sorted
//   by digest bytes only for the bound canonical JSON observation encoding.
//   P20_CELL_HASH(c,digest,TYPE(SAME_NOT_SAME,WHAT),OVERLAP(f,g)): generic
//   SHA-256 of retained014 u64be-length-prefixed type/overlap term bytes.
//   The hash response is tied to those source terms, NOT to the inventory.
//   GPU_HASH_RESPONSE(subject_json,digest): generic SHA-256 over compact,
//   sorted-key UTF-8 JSON. No host program, placement or DRC verdict enters.
//
// Export: P20_CELL(c,id,CellDefJSON,LocationJSON), P20_PROGRAM_OBJECT(p,json),
// SF_PROGRAM(p,symbolic_occurrence_list,NIL), SF_PROGRAM_DRC(p,IF_THEN,proof),
// and P20_NO_INTERNAL_ROUTES(p). p is the canonical program's SHA-256.
// Source terms use G/S/F. Boxed strings below preserve the retained static
// format's ABI spelling; they are not a reintroduction of boxed modalities.
@readonly input P20_INVENTORY := "program_inventory:";

@propose seed P20_STATIC_BOUNDARY := {
 THIS(P20_FABRIC_ROOT,"FLAG_WORLD_FIRST_TICK_020"),
 THIS(P20_TICK_BLOCK,"FIRST_TICK"),
 THIS(P20_DECLARED_ROUTES,NIL),
 GOES_WITH(P20_OPERATOR_SCHEMA,SAME_NOT_SAME,LEFT,EXACTLY_ONE,RIGHT,EXACTLY_ONE),
 GOES_WITH(P20_WITNESS_TYPE,WHAT,"identity/essence"),
 GOES_WITH(P20_HEX_NEXT,B48,B49), GOES_WITH(P20_HEX_NEXT,B49,B50),
 GOES_WITH(P20_HEX_NEXT,B50,B51), GOES_WITH(P20_HEX_NEXT,B51,B52),
 GOES_WITH(P20_HEX_NEXT,B52,B53), GOES_WITH(P20_HEX_NEXT,B53,B54),
 GOES_WITH(P20_HEX_NEXT,B54,B55), GOES_WITH(P20_HEX_NEXT,B55,B56),
 GOES_WITH(P20_HEX_NEXT,B56,B57), GOES_WITH(P20_HEX_NEXT,B57,B65),
 GOES_WITH(P20_HEX_NEXT,B65,B66), GOES_WITH(P20_HEX_NEXT,B66,B67),
 GOES_WITH(P20_HEX_NEXT,B67,B68), GOES_WITH(P20_HEX_NEXT,B68,B69),
 GOES_WITH(P20_HEX_NEXT,B69,B70)
};

law P20_CAPABILITY_BINDING := IF GOES_WITH(SF_CAPABILITY,SAME_NOT_SAME,d)
 THEN GOES_WITH(P20_CAPABILITY,SAME_NOT_SAME,d);

// Digest order is canonical observation order, never a world-locus selection.
law P20_HEX_ORDER_BASE := IF GOES_WITH(P20_HEX_NEXT,a,b)
 THEN GOES_WITH(P20_HEX_LESS,a,b);
law P20_HEX_ORDER_TRANSITIVE := IF GOES_WITH(P20_HEX_LESS,a,b), GOES_WITH(P20_HEX_NEXT,b,c)
 THEN GOES_WITH(P20_HEX_LESS,a,c);
law P20_ROWS := IF THIS(P20_INVENTORY,ARRAY(rows)) THEN THIS(P20_ROWS,rows);
law P20_ROWS_TAIL := IF THIS(P20_ROWS,CONS(row,tail)) THEN THIS(P20_ROWS,tail);
law P20_ROW_MATCH := IF THIS(P20_ROWS,CONS(ARRAY(CONS(id,CONS(a,CONS(b,NIL)))),tail)), GOES_WITH(P20_SOURCE_FLAG_JSON,f,a), GOES_WITH(P20_SOURCE_FLAG_JSON,g,b), GOES_WITH(P20_SOURCE_OCCURRENCE,c,f,g), GOES_WITH(P20_CELL_HASH,c,id,TYPE(SAME_NOT_SAME,WHAT),OVERLAP(f,g))
 THEN GOES_WITH(P20_INVENTORY_CELL,ARRAY(CONS(id,CONS(a,CONS(b,NIL)))),c,id,f,g);
law P20_PAIR_PRESENT := IF GOES_WITH(P20_INVENTORY_CELL,row,c,id,f,g)
 THEN GOES_WITH(P20_PAIR_PRESENT,f,g,c);
law P20_ORDER_REQUEST := IF THIS(P20_ROWS,CONS(a,CONS(b,tail))), GOES_WITH(P20_INVENTORY_CELL,a,c,TEXT(x),f,g), GOES_WITH(P20_INVENTORY_CELL,b,d,TEXT(y),h,i)
 THEN THIS(P20_ORDER_REQUEST,x,y);
law P20_ORDER_TAIL_REQUEST := IF THIS(P20_ORDER_REQUEST,CONS(a,x),CONS(a,y))
 THEN THIS(P20_ORDER_REQUEST,x,y);
law P20_ORDER_FIRST_DISTINCT := IF THIS(P20_ORDER_REQUEST,CONS(a,x),CONS(b,y)), GOES_WITH(P20_HEX_LESS,a,b)
 THEN GOES_WITH(P20_ORDERED,CONS(a,x),CONS(b,y));
law P20_ORDER_EQUAL_PREFIX := IF THIS(P20_ORDER_REQUEST,CONS(a,x),CONS(a,y)), GOES_WITH(P20_ORDERED,x,y)
 THEN GOES_WITH(P20_ORDERED,CONS(a,x),CONS(a,y));
law P20_ROW_ORDERED := IF THIS(P20_ROWS,CONS(a,CONS(b,tail))), GOES_WITH(P20_INVENTORY_CELL,a,c,TEXT(x),f,g), GOES_WITH(P20_INVENTORY_CELL,b,d,TEXT(y),h,i), GOES_WITH(P20_ORDERED,x,y)
 THEN THIS(P20_ROW_ORDERED,CONS(a,CONS(b,tail)));
law P20_ROW_LAST := IF THIS(P20_ROWS,CONS(a,NIL)), GOES_WITH(P20_INVENTORY_CELL,a,c,id,f,g)
 THEN THIS(P20_ROW_ORDERED,CONS(a,NIL));

// The motif namespace is disjoint from SHA-256 cell IDs and both root names.
// It is a source-owned observation identity for this overlap enclosure.
law P20_MOTIF_ID := IF GOES_WITH(P20_INVENTORY_CELL,row,c,TEXT(h),f,g)
 THEN GOES_WITH(P20_MOTIF_ID,c,TEXT(CONS(B111,CONS(B118,CONS(B101,CONS(B114,CONS(B108,CONS(B97,CONS(B112,CONS(B58,h))))))))));

// Per-row DRC is constructed from the retained schema, source placement,
// admitted occurrence, hardware capability, and source enclosure. There is
// no seeded DRC success. EXACTLY_ONE ports are schema, not internal routes.
law P20_TYPED_CELL := IF GOES_WITH(P20_INVENTORY_CELL,row,c,id,f,g), GOES_WITH(P20_OPERATOR_SCHEMA,SAME_NOT_SAME,LEFT,EXACTLY_ONE,RIGHT,EXACTLY_ONE), GOES_WITH(P20_WITNESS_TYPE,WHAT,t), GOES_WITH(P20_CAPABILITY,SAME_NOT_SAME,G), GOES_WITH(P20_CAPABILITY,SAME_NOT_SAME,S)
 THEN GOES_WITH(P20_TYPED_CELL,c,id,OBJECT(CONS(MEMBER("cell_id",id),CONS(MEMBER("operator","SAME_NOT_SAME"),CONS(MEMBER("payload_slot_type",t),CONS(MEMBER("triad_capability",ARRAY(CONS("\u25a1G",CONS("\u25a1S",NIL)))),CONS(MEMBER("witness","WHAT"),NIL)))))));
law P20_LOCATED_CELL := IF GOES_WITH(P20_INVENTORY_CELL,row,c,id,f,g), GOES_WITH(P20_SOURCE_PLACEMENT,c,LOCATION(INTERIOR(S),CONTAINMENT(FIRST_TICK,OVERLAP(f,g)))), GOES_WITH(P20_SOURCE_ADMISSION,c,e), GOES_WITH(P20_CAPABILITY,SAME_NOT_SAME,S), GOES_WITH(P20_MOTIF_ID,c,m), THIS(P20_TICK_BLOCK,b), THIS(P20_FABRIC_ROOT,p)
 THEN GOES_WITH(P20_LOCATED_CELL,c,OBJECT(CONS(MEMBER("containment_path",ARRAY(CONS(m,CONS(b,CONS(p,NIL))))),CONS(MEMBER("triad_position",OBJECT(CONS(MEMBER("dimension","\u25a1S"),CONS(MEMBER("kind","INTERIOR"),NIL)))),NIL))));
law P20_CELL_EXPORT := IF GOES_WITH(P20_TYPED_CELL,c,id,def), GOES_WITH(P20_LOCATED_CELL,c,loc)
 THEN GOES_WITH(P20_CELL,c,id,def,loc);
law P20_PLACEMENT_ROW := IF GOES_WITH(P20_CELL,c,id,def,loc)
 THEN GOES_WITH(P20_PLACEMENT_ROW,c,OBJECT(CONS(MEMBER("cell_id",id),CONS(MEMBER("location",loc),NIL))));
law P20_MOTIF_ROW := IF GOES_WITH(P20_CELL,c,id,def,loc), GOES_WITH(P20_MOTIF_ID,c,m)
 THEN GOES_WITH(P20_MOTIF_ROW,c,OBJECT(CONS(MEMBER("contained_ids",ARRAY(CONS(id,NIL))),CONS(MEMBER("motif_id",m),NIL))));
law P20_CELL_DRC := IF GOES_WITH(P20_CELL,c,id,def,loc), GOES_WITH(P20_PLACEMENT_ROW,c,place), GOES_WITH(P20_MOTIF_ROW,c,motif), GOES_WITH(P20_MOTIF_ID,c,m), THIS(P20_TICK_BLOCK,b), THIS(P20_FABRIC_ROOT,p)
 THEN GOES_WITH(P20_CELL_DRC,c,STATIC_CELL_CHECK(def,place,motif,CONTAINMENT_PATH(m,b,p)));
law P20_READY_ROW := IF GOES_WITH(P20_INVENTORY_CELL,row,c,id,f,g), GOES_WITH(P20_CELL,c,id,def,loc), GOES_WITH(P20_PLACEMENT_ROW,c,place), GOES_WITH(P20_MOTIF_ROW,c,motif), GOES_WITH(P20_MOTIF_ID,c,m), GOES_WITH(P20_CELL_DRC,c,proof)
 THEN GOES_WITH(P20_READY_ROW,row,c,def,motif,place,m);

// Coverage in the reverse direction walks the already source-checked complete
// committed overlap witness. No total count substitutes for a missing row.
law P20_COVERAGE_ROWS := IF THIS(P20_SOURCE_COVERAGE,ARRAY(rows))
 THEN THIS(P20_COVERAGE_ROWS,rows);
law P20_COVERAGE_TAIL := IF THIS(P20_COVERAGE_ROWS,CONS(row,tail))
 THEN THIS(P20_COVERAGE_ROWS,tail);
law P20_COVERAGE_END := IF THIS(P20_COVERAGE_ROWS,NIL)
 THEN THIS(P20_COVERED_SUFFIX,NIL);
law P20_COVERAGE_ROW := IF THIS(P20_COVERAGE_ROWS,CONS(ARRAY(CONS(a,CONS(b,CONS(r,NIL)))),tail)), GOES_WITH(P20_SOURCE_FLAG_JSON,f,a), GOES_WITH(P20_SOURCE_FLAG_JSON,g,b), GOES_WITH(P20_PAIR_PRESENT,f,g,c), GOES_WITH(P20_CELL_DRC,c,proof), THIS(P20_COVERED_SUFFIX,tail)
 THEN THIS(P20_COVERED_SUFFIX,CONS(ARRAY(CONS(a,CONS(b,CONS(r,NIL)))),tail));
law P20_COVERAGE_COMPLETE := IF THIS(P20_SOURCE_COVERAGE,ARRAY(rows)), THIS(P20_COVERED_SUFFIX,rows)
 THEN THIS(P20_ALL_SOURCE_PAIRS_COVERED);

// Full canonical lists, in the checked identity encoding order. Both CellDefs
// and placements follow cell-ID order; motif IDs have the same fixed prefix.
law P20_LIST_END := IF THIS(P20_ROWS,NIL)
 THEN GOES_WITH(P20_LIST_SUFFIX,NIL,LISTS(NIL,NIL,NIL,NIL,NIL),NIL);
law P20_LIST_ROW := IF THIS(P20_ROWS,CONS(row,tail)), THIS(P20_ROW_ORDERED,CONS(row,tail)), GOES_WITH(P20_READY_ROW,row,c,def,motif,place,m), GOES_WITH(P20_LIST_SUFFIX,tail,LISTS(ds,ms,ps,cs,bs),proofs)
 THEN GOES_WITH(P20_LIST_SUFFIX,CONS(row,tail),LISTS(CONS(def,ds),CONS(motif,ms),CONS(place,ps),CONS(c,cs),CONS(m,bs)),CONS(c,proofs));
law P20_NORMALIZED_PARTS := IF THIS(P20_INVENTORY,ARRAY(rows)), GOES_WITH(P20_LIST_SUFFIX,rows,LISTS(ds,ms,ps,cs,bs),proofs), THIS(P20_ALL_SOURCE_PAIRS_COVERED), THIS(P20_DECLARED_ROUTES,NIL)
 THEN GOES_WITH(P20_NORMALIZED_PARTS,LISTS(ds,ms,ps,cs,bs),STATIC_DRC_SOURCE_CHECKS(proofs,ALL_SOURCE_PAIRS_COVERED,NO_INTERNAL_ROUTES));
law P20_PROGRAM_JSON := IF GOES_WITH(P20_NORMALIZED_PARTS,LISTS(ds,ms,ps,cs,bs),proof), THIS(P20_FABRIC_ROOT,root), THIS(P20_TICK_BLOCK,block)
 THEN GOES_WITH(P20_CANONICAL_PROGRAM,cs,proof,OBJECT(CONS(MEMBER("cells",ARRAY(ds)),CONS(MEMBER("fabric_id",root),CONS(MEMBER("motifs",ARRAY(ms)),CONS(MEMBER("placements",ARRAY(ps)),CONS(MEMBER("routes",ARRAY(NIL)),CONS(MEMBER("triad_blocks",ARRAY(CONS(OBJECT(CONS(MEMBER("block_id",block),CONS(MEMBER("contained_ids",ARRAY(bs)),NIL))),NIL))),NIL))))))));
law P20_PROGRAM_HASH_REQUEST := IF GOES_WITH(P20_CANONICAL_PROGRAM,cs,proof,object)
 THEN GOES_WITH(GPU_HASH_REQUEST,PROGRAM,PROGRAM_020,object);
law P20_PROGRAM_BOUND := IF GOES_WITH(P20_CANONICAL_PROGRAM,cs,proof,object), GOES_WITH(GPU_HASH_RESPONSE,object,p)
 THEN GOES_WITH(P20_PROGRAM_BOUND,p,cs,proof,object);
law P20_PROGRAM_EXPORT := IF GOES_WITH(P20_PROGRAM_BOUND,p,cs,proof,object)
 THEN GOES_WITH(SF_PROGRAM,p,cs,NIL);
law P20_PROGRAM_OBJECT_EXPORT := IF GOES_WITH(P20_PROGRAM_BOUND,p,cs,proof,object)
 THEN GOES_WITH(P20_PROGRAM_OBJECT,p,object);
law P20_DRC_EXPORT := IF GOES_WITH(P20_PROGRAM_BOUND,p,cs,proof,object)
 THEN GOES_WITH(SF_PROGRAM_DRC,p,IF_THEN,proof);
law P20_EMPTY_INTERNAL_ROUTE_SET := IF GOES_WITH(P20_PROGRAM_BOUND,p,cs,proof,object), THIS(P20_DECLARED_ROUTES,NIL)
 THEN THIS(P20_NO_INTERNAL_ROUTES,p);

// Bounded ingress + ONE STEP_FABRIC for the comparator-only program.
// MF_GAME section9: FED38C3B57092838D25DEC5FA323A3827FB28A360251ECCD1CB991D976480557.
// _seed_frame/ingress_bind: game_loop.py:379--425,
// F711C6499E345C6B6952D8E8AA570B385D7F48A46F3E2189491E98653C4C1833.
// V3.3 sections1--8: 5BB1497AA3D791150F0416FEDA4E393695A9302B42030ADD0A7D22C08CCBEAC0.
// Only the declared ingress boundary is reused; no DEMO-003 game content.
// No marker CellDefs, internal routes, FabricEdits or same-tick operand reads.
// The initial empty auxiliary custody is constructed below for a NEW fabric
// run, not substituted for an absent prior fabric snapshot.
//
// Required contacts from source-owned program construction:
// P20_CELL(c,canonical_id,CellDef,LOCATION), SF_PROGRAM(p,cells,NIL),
// SF_PROGRAM_DRC(p,IF_THEN,receipt), THIS(P20_NO_INTERNAL_ROUTES,p).
// Generic hash contact: GPU_HASH_REQUEST(kind,key,JSON_subject) requests SHA-256;
// GOES_WITH(GPU_HASH_RESPONSE,JSON_subject,digest) returns subject-bound bytes.
// Neither the primitive nor its transport creates a frame or world verdict.
@readonly input I20_RECEIPT_INVENTORY := "receipt_inventory:";

// Exact published genesis custody, not the uncommitted 019 evaluation result.
law I20_COMMITTED_SNAPSHOT := IF GOES_WITH(P20_SOURCE_SNAPSHOT,h,obj), THIS(P20_SOURCE_ADMITTED,h)
 THEN GOES_WITH(I20_COMMITTED_SNAPSHOT,h,obj);
law I20_PROGRAM_SNAPSHOT := IF GOES_WITH(SF_PROGRAM,p,cells,NIL), GOES_WITH(SF_PROGRAM_DRC,p,IF_THEN,e), THIS(P20_NO_INTERNAL_ROUTES,p), GOES_WITH(I20_COMMITTED_SNAPSHOT,h,obj)
 THEN GOES_WITH(I20_RUN,p,h,cells);
law I20_CELLS_BEGIN := IF GOES_WITH(I20_RUN,p,h,cells)
 THEN GOES_WITH(I20_CELL_TAIL,p,h,cells);
law I20_CELLS_TAIL := IF GOES_WITH(I20_CELL_TAIL,p,h,CONS(c,tail))
 THEN GOES_WITH(I20_CELL_TAIL,p,h,tail);
law I20_CELL_MEMBER := IF GOES_WITH(I20_CELL_TAIL,p,h,CONS(c,tail)), GOES_WITH(P20_CELL,c,id,def,location)
 THEN GOES_WITH(I20_CELL,p,h,c,id);

// InitialFabricState: execution_kernel.py:382--403. EMPTY per declared cell;
// the five auxiliary collections are empty by new-run construction.
law I20_INITIAL_PAYLOAD := IF GOES_WITH(I20_CELL,p,h,c,id)
 THEN GOES_WITH(I20_INITIAL_PAYLOAD,p,h,c,EMPTY);
law I20_INITIAL_AUX := IF GOES_WITH(I20_RUN,p,h,cells)
 THEN GOES_WITH(I20_INITIAL_AUX,p,h,AUX(NIL,NIL,NIL,NIL,NIL));

// Declared ingress bindings follow this occurrence's two source operands.
// They are external observation bindings, NOT program.routes.
law I20_LEFT_BINDING := IF GOES_WITH(I20_CELL,p,h,c,id), GOES_WITH(P20_SOURCE_OCCURRENCE,c,f,g), GOES_WITH(SF_PORT,LEFT,EXACTLY_ONE)
 THEN GOES_WITH(I20_INGRESS_BINDING,p,h,c,id,LEFT,f);
law I20_RIGHT_BINDING := IF GOES_WITH(I20_CELL,p,h,c,id), GOES_WITH(P20_SOURCE_OCCURRENCE,c,f,g), GOES_WITH(SF_PORT,RIGHT,EXACTLY_ONE)
 THEN GOES_WITH(I20_INGRESS_BINDING,p,h,c,id,RIGHT,g);
law I20_BINDING_ROW := IF GOES_WITH(I20_CELL,p,h,c,id), GOES_WITH(P20_SOURCE_OCCURRENCE,c,f,g), GOES_WITH(P20_SOURCE_FLAG_JSON,f,a), GOES_WITH(P20_SOURCE_FLAG_JSON,g,b)
 THEN GOES_WITH(I20_BINDING_ROW,p,h,c,OBJECT(CONS(MEMBER("LEFT",a),CONS(MEMBER("RIGHT",b),CONS(MEMBER("target_cell",id),NIL)))));
law I20_BINDING_END := IF GOES_WITH(I20_CELL_TAIL,p,h,NIL)
 THEN GOES_WITH(I20_BINDING_SUFFIX,p,h,NIL,NIL);
law I20_BINDING_ROW_APPEND := IF GOES_WITH(I20_CELL_TAIL,p,h,CONS(c,tail)), GOES_WITH(I20_BINDING_ROW,p,h,c,row), GOES_WITH(I20_BINDING_SUFFIX,p,h,tail,rows)
 THEN GOES_WITH(I20_BINDING_SUFFIX,p,h,CONS(c,tail),CONS(row,rows));
law I20_BINDING_OBJECT := IF GOES_WITH(I20_RUN,p,h,cells), GOES_WITH(I20_BINDING_SUFFIX,p,h,cells,rows)
 THEN GOES_WITH(I20_BINDING_OBJECT,p,h,OBJECT(CONS(MEMBER("fabric_digest",p),CONS(MEMBER("ingress_bindings",ARRAY(rows)),CONS(MEMBER("snapshot",h),NIL)))));
law I20_BINDING_HASH_REQUEST := IF GOES_WITH(I20_BINDING_OBJECT,p,h,subject)
 THEN GOES_WITH(GPU_HASH_REQUEST,INGRESS_BINDING,CONTEXT(p,h),subject);
law I20_BINDING_ID := IF GOES_WITH(I20_BINDING_OBJECT,p,h,subject), GOES_WITH(GPU_HASH_RESPONSE,subject,digest)
 THEN GOES_WITH(I20_BINDING_ID,p,h,digest);
law I20_RUN_ID_SUBJECT := IF GOES_WITH(I20_BINDING_ID,p,h,binding)
 THEN GOES_WITH(I20_RUN_ID_SUBJECT,p,h,ARRAY(CONS("FLAG_WORLD_RUN",CONS(p,CONS(binding,CONS(h,NIL))))));
law I20_RUN_ID_REQUEST := IF GOES_WITH(I20_RUN_ID_SUBJECT,p,h,subject)
 THEN GOES_WITH(GPU_HASH_REQUEST,RUN_ID,CONTEXT(p,h),subject);
law I20_RUN_ID := IF GOES_WITH(I20_RUN_ID_SUBJECT,p,h,subject), GOES_WITH(GPU_HASH_RESPONSE,subject,digest)
 THEN GOES_WITH(I20_RUN_ID,p,h,digest);
@propose seed I20_ENCODING := {
 GOES_WITH(I20_ROLE_TEXT,LEFT,"LEFT"), GOES_WITH(I20_ROLE_TEXT,RIGHT,"RIGHT"),
 GOES_WITH(I20_READING_TEXT,NO,"NO"), GOES_WITH(I20_READING_TEXT,THIS,"THIS"),
 GOES_WITH(I20_RESULT_TEXT,SAME,"SAME"), GOES_WITH(I20_RESULT_TEXT,NOT_SAME,"NOT_SAME"),
 GOES_WITH(I20_COMPARE,NO,NO,SAME), GOES_WITH(I20_COMPARE,THIS,THIS,SAME),
 GOES_WITH(I20_COMPARE,NO,THIS,NOT_SAME), GOES_WITH(I20_COMPARE,THIS,NO,NOT_SAME)
};
// Input payload contains both the reading and its committed snapshot/flag
// custody. A captured snapshot is never resampled during evaluation.
law I20_INPUT_PAYLOAD := IF GOES_WITH(I20_INGRESS_BINDING,p,h,c,id,role,f), GOES_WITH(P20_SOURCE_OPERAND,h,f,r), GOES_WITH(P20_SOURCE_FLAG_JSON,f,j), GOES_WITH(I20_READING_TEXT,r,t)
 THEN GOES_WITH(I20_INPUT_PAYLOAD,p,h,c,role,r,OBJECT(CONS(MEMBER("flag",j),CONS(MEMBER("reading",t),CONS(MEMBER("snapshot",h),NIL)))));
// Source-owned canonical input identity. The role and occurrence distinguish
// the two input values even when their readings are SAME.
// The first logical tick is count NO (JSON integer 0), not an identifier order.
// This is the caller's GAME_INGRESS hash formula with source-owned bindings.
law I20_ROUTE_SUBJECT := IF GOES_WITH(I20_INGRESS_BINDING,p,h,c,id,role,f), GOES_WITH(I20_ROLE_TEXT,role,t), GOES_WITH(I20_BINDING_ID,p,h,binding)
 THEN GOES_WITH(I20_ROUTE_SUBJECT,p,h,c,role,ARRAY(CONS("GAME_INGRESS",CONS(binding,CONS(JSON_INTEGER("0"),CONS(id,CONS(t,NIL)))))));
law I20_ROUTE_HASH_REQUEST := IF GOES_WITH(I20_ROUTE_SUBJECT,p,h,c,role,subject)
 THEN GOES_WITH(GPU_HASH_REQUEST,INGRESS_ROUTE,CONTEXT(p,h,c,role),subject);
law I20_ROUTE_HASH := IF GOES_WITH(I20_ROUTE_SUBJECT,p,h,c,role,subject), GOES_WITH(GPU_HASH_RESPONSE,subject,digest)
 THEN GOES_WITH(I20_ROUTE_ID,p,h,c,role,digest);
law I20_INPUT_RECEIPT_SUBJECT := IF GOES_WITH(I20_ROUTE_ID,p,h,c,role,rid), GOES_WITH(I20_INPUT_PAYLOAD,p,h,c,role,r,payload)
 THEN GOES_WITH(I20_INPUT_RECEIPT_SUBJECT,p,h,c,role,ARRAY(CONS("GAME_INGRESS_RECEIPT",CONS(rid,CONS(payload,NIL)))));
law I20_INPUT_RECEIPT_REQUEST := IF GOES_WITH(I20_INPUT_RECEIPT_SUBJECT,p,h,c,role,subject)
 THEN GOES_WITH(GPU_HASH_REQUEST,INGRESS_RECEIPT,CONTEXT(p,h,c,role),subject);
law I20_INPUT_VALUE := IF GOES_WITH(I20_ROUTE_ID,p,h,c,role,rid), GOES_WITH(I20_INPUT_PAYLOAD,p,h,c,role,r,payload), GOES_WITH(I20_INPUT_RECEIPT_SUBJECT,p,h,c,role,subject), GOES_WITH(GPU_HASH_RESPONSE,subject,receipt)
 THEN GOES_WITH(I20_INPUT_VALUE,p,h,c,role,r,INPUT_VALUE(rid,IDENTITY_ESSENCE,payload,receipt));
law I20_INPUT_JSON := IF GOES_WITH(I20_INPUT_VALUE,p,h,c,role,r,INPUT_VALUE(rid,IDENTITY_ESSENCE,payload,receipt))
 THEN GOES_WITH(I20_INPUT_JSON,p,h,c,role,OBJECT(CONS(MEMBER("payload_type","identity/essence"),CONS(MEMBER("route_id",rid),CONS(MEMBER("source_receipt",receipt),CONS(MEMBER("value",payload),NIL))))));

// Singleton role lists are EXACTLY_ONE. Their payload types match the imported
// SAME/WHAT JOIN_SIGNATURE. No default or partial frame can reach ADMITTED.
law I20_FRAME := IF GOES_WITH(I20_INPUT_VALUE,p,h,c,LEFT,a,left), GOES_WITH(I20_INPUT_VALUE,p,h,c,RIGHT,b,right), GOES_WITH(I20_INPUT_JSON,p,h,c,LEFT,lj), GOES_WITH(I20_INPUT_JSON,p,h,c,RIGHT,rj)
 THEN GOES_WITH(I20_FRAME,p,h,c,FRAME(LEFT(CONS(left,NIL)),RIGHT(CONS(right,NIL))),OBJECT(CONS(MEMBER("LEFT",ARRAY(CONS(lj,NIL))),CONS(MEMBER("RIGHT",ARRAY(CONS(rj,NIL))),NIL))));
law I20_ADMISSION_SUBJECT := IF GOES_WITH(I20_CELL,p,h,c,id), GOES_WITH(I20_FRAME,p,h,c,frame,json), GOES_WITH(I20_RUN_ID,p,h,run)
 THEN GOES_WITH(I20_ADMISSION_SUBJECT,p,h,c,ARRAY(CONS("GAME_FRAME_ADMITTED",CONS(run,CONS(JSON_INTEGER("0"),CONS(id,CONS(json,NIL)))))));
law I20_ADMISSION_REQUEST := IF GOES_WITH(I20_ADMISSION_SUBJECT,p,h,c,subject)
 THEN GOES_WITH(GPU_HASH_REQUEST,FRAME_ADMISSION,CONTEXT(p,h,c),subject);
law I20_PREPARED_PAYLOAD := IF GOES_WITH(I20_INITIAL_PAYLOAD,p,h,c,EMPTY), GOES_WITH(I20_FRAME,p,h,c,frame,json), GOES_WITH(I20_ADMISSION_SUBJECT,p,h,c,subject), GOES_WITH(GPU_HASH_RESPONSE,subject,receipt), GOES_WITH(P20_SOURCE_ADMISSION,c,e)
 THEN GOES_WITH(I20_PREPARED_PAYLOAD,p,h,c,ADMITTED(frame,receipt));

// STEP_FABRIC stage1: the entire prepared payload map is closed before the
// immutable snapshot opens. Inputs and receipts are copied, not recomputed.
law I20_PREPARED_END := IF GOES_WITH(I20_CELL_TAIL,p,h,NIL)
 THEN GOES_WITH(I20_PREPARED_SUFFIX,p,h,NIL,NIL);
law I20_PREPARED_ROW := IF GOES_WITH(I20_CELL_TAIL,p,h,CONS(c,tail)), GOES_WITH(I20_CELL,p,h,c,id), GOES_WITH(I20_PREPARED_PAYLOAD,p,h,c,payload), GOES_WITH(I20_PREPARED_SUFFIX,p,h,tail,rows)
 THEN GOES_WITH(I20_PREPARED_SUFFIX,p,h,CONS(c,tail),CONS(CELL_STATE(id,payload),rows));
law I20_SNAPSHOT := IF GOES_WITH(I20_RUN,p,h,cells), GOES_WITH(I20_PREPARED_SUFFIX,p,h,cells,payloads), GOES_WITH(I20_INITIAL_AUX,p,h,AUX(rs,pa,ib,ob,receipts))
 THEN GOES_WITH(I20_SNAPSHOT,p,h,FABRIC_STATE(PAYLOAD_MAP(payloads),rs,pa,ib,ob,receipts));

// Stage2: pure SAME reading of this snapshot's complete typed frame.
law I20_EVALUATE := IF GOES_WITH(I20_SNAPSHOT,p,h,snapshot), GOES_WITH(I20_PREPARED_PAYLOAD,p,h,c,ADMITTED(FRAME(LEFT(CONS(left,NIL)),RIGHT(CONS(right,NIL))),admission)), GOES_WITH(I20_INPUT_VALUE,p,h,c,LEFT,a,left), GOES_WITH(I20_INPUT_VALUE,p,h,c,RIGHT,b,right), GOES_WITH(I20_COMPARE,a,b,r)
 THEN GOES_WITH(I20_CELL_RESULT,p,h,c,RESULT(r));
law I20_AGREEMENT := IF GOES_WITH(I20_CELL_RESULT,p,h,c,RESULT(r)), GOES_WITH(P20_SOURCE_OCCURRENCE,c,f,g)
 THEN GOES_WITH(I20_AGREEMENT,p,h,f,g,r);
law I20_WALL := IF GOES_WITH(I20_AGREEMENT,p,h,f,g,NOT_SAME)
 THEN GOES_WITH(I20_WALL,p,h,f,g);

// Full result and RuntimeReceipt custody, execution_kernel.py:338--341,
// 490--505, 941--959. SHA is generic; every hashed subject is source-produced.
law I20_RESULT_JSON := IF GOES_WITH(I20_CELL_RESULT,p,h,c,RESULT(r)), GOES_WITH(I20_FRAME,p,h,c,frame,fj), GOES_WITH(I20_RESULT_TEXT,r,t)
 THEN GOES_WITH(I20_RESULT_JSON,p,h,c,OBJECT(CONS(MEMBER("input_frame",fj),CONS(MEMBER("operator","SAME_NOT_SAME"),CONS(MEMBER("reading",t),CONS(MEMBER("witness","WHAT"),NIL))))));
law I20_EVALUATION_PAYLOAD := IF GOES_WITH(I20_RESULT_JSON,p,h,c,json)
 THEN GOES_WITH(I20_RECEIPT_PAYLOAD,p,h,c,CELL_EVALUATED,json);
law I20_TRANSITION_PAYLOAD := IF GOES_WITH(I20_CELL_RESULT,p,h,c,r)
 THEN GOES_WITH(I20_RECEIPT_PAYLOAD,p,h,c,PAYLOAD_TRANSITION,ARRAY(CONS("ADMITTED",CONS("COMPLETED",NIL))));
@propose seed I20_RECEIPT_KINDS := {
 GOES_WITH(I20_RECEIPT_KIND_TEXT,CELL_EVALUATED,"CELL_EVALUATED"),
 GOES_WITH(I20_RECEIPT_KIND_TEXT,PAYLOAD_TRANSITION,"PAYLOAD_TRANSITION")
};
law I20_RECEIPT_PAYLOAD_REQUEST := IF GOES_WITH(I20_RECEIPT_PAYLOAD,p,h,c,kind,subject)
 THEN GOES_WITH(GPU_HASH_REQUEST,RUNTIME_PAYLOAD,CONTEXT(p,h,c,kind),subject);
law I20_RECEIPT_ID_SUBJECT := IF GOES_WITH(I20_RECEIPT_PAYLOAD,p,h,c,kind,subject), GOES_WITH(GPU_HASH_RESPONSE,subject,digest), GOES_WITH(I20_CELL,p,h,c,id), GOES_WITH(I20_RECEIPT_KIND_TEXT,kind,k)
 THEN GOES_WITH(I20_RECEIPT_ID_SUBJECT,p,h,c,kind,digest,ARRAY(CONS(k,CONS(id,CONS(digest,NIL)))));
law I20_RECEIPT_ID_REQUEST := IF GOES_WITH(I20_RECEIPT_ID_SUBJECT,p,h,c,kind,digest,subject)
 THEN GOES_WITH(GPU_HASH_REQUEST,RUNTIME_RECEIPT,CONTEXT(p,h,c,kind),subject);
law I20_RUNTIME_RECEIPT := IF GOES_WITH(I20_RECEIPT_ID_SUBJECT,p,h,c,kind,digest,subject), GOES_WITH(GPU_HASH_RESPONSE,subject,rid), GOES_WITH(I20_CELL,p,h,c,id), GOES_WITH(I20_RECEIPT_KIND_TEXT,kind,k)
 THEN GOES_WITH(I20_RUNTIME_RECEIPT,p,h,c,kind,rid,OBJECT(CONS(MEMBER("kind",k),CONS(MEMBER("payload_digest",digest),CONS(MEMBER("receipt_id",rid),CONS(MEMBER("subject_id",id),NIL))))));
law I20_RECEIPT_ROW := IF GOES_WITH(I20_RUNTIME_RECEIPT,p,h,c,kind,rid,json)
 THEN THIS(OBSERVATION_ROW,I20_RECEIPTS,ARRAY(CONS(rid,CONS(json,NIL))));

// Stage3: the exact canonical program inventory has NO internal routes. No
// source associations are silently reclassified; ingress is explicitly above.
law I20_PROPAGATE := IF GOES_WITH(I20_SNAPSHOT,p,h,snapshot), GOES_WITH(SF_PROGRAM,p,cells,NIL), THIS(P20_NO_INTERNAL_ROUTES,p)
 THEN GOES_WITH(I20_ROUTE_RESULTS,p,h,NIL);
// Stage4: with no route results and a NEW initial snapshot's empty pending
// custody, runtime governance carries those exact five auxiliary collections.
law I20_GOVERN := IF GOES_WITH(I20_ROUTE_RESULTS,p,h,NIL), GOES_WITH(I20_SNAPSHOT,p,h,FABRIC_STATE(payloads,rs,NIL,NIL,NIL,receipts))
 THEN GOES_WITH(I20_GOVERNANCE,p,h,AUX(rs,NIL,NIL,NIL,receipts));

// Stage5: every ADMITTED cell becomes COMPLETED simultaneously. The empty
// completion-evidence set is sourced by the actual empty program route list.
// It is post-evaluation custody, never a claim of a selected displacement.
law I20_COMPLETED := IF GOES_WITH(I20_PREPARED_PAYLOAD,p,h,c,ADMITTED(frame,admission)), GOES_WITH(I20_CELL_RESULT,p,h,c,result), GOES_WITH(I20_GOVERNANCE,p,h,aux)
 THEN GOES_WITH(I20_NEXT_PAYLOAD,p,h,c,COMPLETED(frame,result,NIL));
law I20_NEXT_END := IF GOES_WITH(I20_CELL_TAIL,p,h,NIL), GOES_WITH(I20_GOVERNANCE,p,h,aux)
 THEN GOES_WITH(I20_NEXT_SUFFIX,p,h,NIL,NIL,NIL);
law I20_NEXT_ROW := IF GOES_WITH(I20_CELL_TAIL,p,h,CONS(c,tail)), GOES_WITH(I20_CELL,p,h,c,id), GOES_WITH(I20_NEXT_PAYLOAD,p,h,c,after), GOES_WITH(I20_RUNTIME_RECEIPT,p,h,c,CELL_EVALUATED,eid,e), GOES_WITH(I20_RUNTIME_RECEIPT,p,h,c,PAYLOAD_TRANSITION,tid,t), GOES_WITH(I20_NEXT_SUFFIX,p,h,tail,rows,receipts)
 THEN GOES_WITH(I20_NEXT_SUFFIX,p,h,CONS(c,tail),CONS(CELL_STATE(id,after),rows),CONS(e,CONS(t,receipts)));
law I20_SIMULTANEOUS_COMMIT := IF GOES_WITH(I20_RUN,p,h,cells), GOES_WITH(I20_NEXT_SUFFIX,p,h,cells,payloads,newreceipts), GOES_WITH(I20_GOVERNANCE,p,h,AUX(rs,pa,ib,ob,NIL)), GOES_WITH(I20_SNAPSHOT,p,h,snapshot)
 THEN GOES_WITH(STEP_FABRIC_RETURN,p,snapshot,FABRIC_STATE(PAYLOAD_MAP(payloads),rs,pa,ib,ob,RECEIPT_SET(newreceipts)));

// Effects may read only this returned simultaneous successor (MF_GAME section11).
law I20_RETURNED_AGREEMENT := IF GOES_WITH(I20_SNAPSHOT,p,h,snapshot), GOES_WITH(STEP_FABRIC_RETURN,p,snapshot,next), GOES_WITH(I20_AGREEMENT,p,h,f,g,r)
 THEN GOES_WITH(I20_COMMITTED_AGREEMENT,p,h,next,f,g,r);

// Canonical observation of the complete successor. The host may collect/sort
// emitted receipt rows, but cannot supply an object not produced above. Strict
// byte order below is receipt-identity serialization, never world selection.
law I20_RECEIPT_ROWS := IF THIS(I20_RECEIPT_INVENTORY,ARRAY(rows))
 THEN THIS(I20_RECEIPT_ROWS,rows);
law I20_RECEIPT_ROWS_TAIL := IF THIS(I20_RECEIPT_ROWS,CONS(row,tail))
 THEN THIS(I20_RECEIPT_ROWS,tail);
law I20_RECEIPT_ROWS_BLOCK := IF THIS(I20_RECEIPT_ROWS,CONS(a,CONS(b,CONS(c,CONS(d,CONS(e,CONS(f,CONS(g,CONS(h,tail)))))))))
 THEN THIS(I20_RECEIPT_ROWS,tail);
law I20_RECEIPT_ROW_MEMBER := IF THIS(I20_RECEIPT_ROWS,CONS(ARRAY(CONS(id,CONS(json,NIL))),tail)), GOES_WITH(I20_RUNTIME_RECEIPT,p,h,c,kind,id,json)
 THEN GOES_WITH(I20_RECEIPT_ROW_MEMBER,p,h,ARRAY(CONS(id,CONS(json,NIL))),id,json);
@propose seed I20_HEX_SERIALIZATION := {
 GOES_WITH(I20_HEX_NEXT,B48,B49), GOES_WITH(I20_HEX_NEXT,B49,B50),
 GOES_WITH(I20_HEX_NEXT,B50,B51), GOES_WITH(I20_HEX_NEXT,B51,B52),
 GOES_WITH(I20_HEX_NEXT,B52,B53), GOES_WITH(I20_HEX_NEXT,B53,B54),
 GOES_WITH(I20_HEX_NEXT,B54,B55), GOES_WITH(I20_HEX_NEXT,B55,B56),
 GOES_WITH(I20_HEX_NEXT,B56,B57), GOES_WITH(I20_HEX_NEXT,B57,B97),
 GOES_WITH(I20_HEX_NEXT,B97,B98), GOES_WITH(I20_HEX_NEXT,B98,B99),
 GOES_WITH(I20_HEX_NEXT,B99,B100), GOES_WITH(I20_HEX_NEXT,B100,B101),
 GOES_WITH(I20_HEX_NEXT,B101,B102),
 GOES_WITH(I20_SPAN_DOUBLE,ONE,TWO), GOES_WITH(I20_SPAN_DOUBLE,TWO,FOUR),
 GOES_WITH(I20_SPAN_DOUBLE,FOUR,EIGHT), GOES_WITH(I20_SPAN_DOUBLE,EIGHT,SIXTEEN),
 GOES_WITH(I20_SPAN_DOUBLE,SIXTEEN,THIRTY_TWO), GOES_WITH(I20_SPAN_DOUBLE,THIRTY_TWO,SIXTY_FOUR),
 GOES_WITH(I20_SPAN_DOUBLE,SIXTY_FOUR,ONE_TWENTY_EIGHT), GOES_WITH(I20_SPAN_DOUBLE,ONE_TWENTY_EIGHT,TWO_FIFTY_SIX),
 GOES_WITH(I20_SPAN_DOUBLE,TWO_FIFTY_SIX,FIVE_TWELVE), GOES_WITH(I20_SPAN_DOUBLE,FIVE_TWELVE,TEN_TWENTY_FOUR)
};
law I20_HEX_LESS_ONE := IF GOES_WITH(I20_HEX_NEXT,a,b) THEN GOES_WITH(I20_HEX_LESS,a,b);
law I20_HEX_LESS_MORE := IF GOES_WITH(I20_HEX_LESS,a,b), GOES_WITH(I20_HEX_NEXT,b,c) THEN GOES_WITH(I20_HEX_LESS,a,c);
law I20_RECEIPT_ORDER_REQUEST := IF THIS(I20_RECEIPT_ROWS,CONS(ARRAY(CONS(a,CONS(x,NIL))),CONS(ARRAY(CONS(b,CONS(y,NIL))),tail)))
 THEN THIS(I20_DIGEST_ORDER_REQUEST,a,b);
law I20_DIGEST_ORDER_PREFIX := IF THIS(I20_DIGEST_ORDER_REQUEST,TEXT(CONS(a,x)),TEXT(CONS(a,y)))
 THEN THIS(I20_DIGEST_ORDER_REQUEST,TEXT(x),TEXT(y));
law I20_DIGEST_ORDER_DIFFERENT := IF THIS(I20_DIGEST_ORDER_REQUEST,TEXT(CONS(a,x)),TEXT(CONS(b,y))), GOES_WITH(I20_HEX_LESS,a,b)
 THEN GOES_WITH(I20_DIGEST_LESS,TEXT(CONS(a,x)),TEXT(CONS(b,y)));
law I20_DIGEST_ORDER_EQUAL_PREFIX := IF THIS(I20_DIGEST_ORDER_REQUEST,TEXT(CONS(a,x)),TEXT(CONS(a,y))), GOES_WITH(I20_DIGEST_LESS,TEXT(x),TEXT(y))
 THEN GOES_WITH(I20_DIGEST_LESS,TEXT(CONS(a,x)),TEXT(CONS(a,y)));
law I20_RECEIPT_SPAN_ROW := IF THIS(I20_RECEIPT_ROWS,CONS(a,CONS(b,tail))), GOES_WITH(I20_RECEIPT_ROW_MEMBER,p,h,a,x,aj), GOES_WITH(I20_RECEIPT_ROW_MEMBER,p,h,b,y,bj), GOES_WITH(I20_DIGEST_LESS,x,y)
 THEN GOES_WITH(I20_RECEIPT_SPAN,p,h,ONE,CONS(a,CONS(b,tail)),CONS(b,tail));
law I20_RECEIPT_SPAN_LAST := IF THIS(I20_RECEIPT_ROWS,CONS(a,NIL)), GOES_WITH(I20_RECEIPT_ROW_MEMBER,p,h,a,x,aj)
 THEN GOES_WITH(I20_RECEIPT_SPAN,p,h,ONE,CONS(a,NIL),NIL);
law I20_RECEIPT_SPAN_DOUBLE := IF GOES_WITH(I20_SPAN_DOUBLE,n,m), GOES_WITH(I20_RECEIPT_SPAN,p,h,n,a,b), GOES_WITH(I20_RECEIPT_SPAN,p,h,n,b,c)
 THEN GOES_WITH(I20_RECEIPT_SPAN,p,h,m,a,c);
// Two runtime receipts per each of the complete 720 canonical occurrences.
law I20_RECEIPT_COMPLETE := IF THIS(I20_RECEIPT_INVENTORY,ARRAY(a)), GOES_WITH(I20_RECEIPT_SPAN,p,h,TEN_TWENTY_FOUR,a,b), GOES_WITH(I20_RECEIPT_SPAN,p,h,TWO_FIFTY_SIX,b,c), GOES_WITH(I20_RECEIPT_SPAN,p,h,ONE_TWENTY_EIGHT,c,d), GOES_WITH(I20_RECEIPT_SPAN,p,h,THIRTY_TWO,d,NIL)
 THEN GOES_WITH(I20_RECEIPT_COMPLETE,p,h,a);
law I20_RECEIPT_JSON_END := IF THIS(I20_RECEIPT_ROWS,NIL)
 THEN GOES_WITH(I20_RECEIPT_JSON_SUFFIX,NIL,NIL);
law I20_RECEIPT_JSON_ROW := IF THIS(I20_RECEIPT_ROWS,CONS(ARRAY(CONS(id,CONS(json,NIL))),tail)), GOES_WITH(I20_RECEIPT_JSON_SUFFIX,tail,rows)
 THEN GOES_WITH(I20_RECEIPT_JSON_SUFFIX,CONS(ARRAY(CONS(id,CONS(json,NIL))),tail),CONS(json,rows));
law I20_COMPLETED_JSON := IF GOES_WITH(I20_NEXT_PAYLOAD,p,h,c,COMPLETED(frame,result,NIL)), GOES_WITH(I20_FRAME,p,h,c,frame,fj), GOES_WITH(I20_RESULT_JSON,p,h,c,rj)
 THEN GOES_WITH(I20_COMPLETED_JSON,p,h,c,OBJECT(CONS(MEMBER("admission_receipt",JSON_NULL),CONS(MEMBER("completion_evidence",ARRAY(NIL)),CONS(MEMBER("discharge_receipt",JSON_NULL),CONS(MEMBER("frame",fj),CONS(MEMBER("phase","COMPLETED"),CONS(MEMBER("result",rj),CONS(MEMBER("result_ref",JSON_NULL),NIL)))))))));
law I20_PAYLOAD_JSON_END := IF GOES_WITH(I20_CELL_TAIL,p,h,NIL)
 THEN GOES_WITH(I20_PAYLOAD_JSON_SUFFIX,p,h,NIL,NIL);
law I20_PAYLOAD_JSON_ROW := IF GOES_WITH(I20_CELL_TAIL,p,h,CONS(c,tail)), GOES_WITH(I20_CELL,p,h,c,id), GOES_WITH(I20_COMPLETED_JSON,p,h,c,json), GOES_WITH(I20_PAYLOAD_JSON_SUFFIX,p,h,tail,rows)
 THEN GOES_WITH(I20_PAYLOAD_JSON_SUFFIX,p,h,CONS(c,tail),CONS(MEMBER(id,json),rows));
law I20_SUCCESSOR_JSON := IF GOES_WITH(I20_RUN,p,h,cells), GOES_WITH(I20_SNAPSHOT,p,h,snapshot), GOES_WITH(STEP_FABRIC_RETURN,p,snapshot,next), GOES_WITH(I20_PAYLOAD_JSON_SUFFIX,p,h,cells,payloads), GOES_WITH(I20_RECEIPT_COMPLETE,p,h,receiptrows), GOES_WITH(I20_RECEIPT_JSON_SUFFIX,receiptrows,receipts)
 THEN GOES_WITH(I20_SUCCESSOR_JSON,p,h,next,OBJECT(CONS(MEMBER("outstanding_obligations",ARRAY(NIL)),CONS(MEMBER("payload_states",OBJECT(payloads)),CONS(MEMBER("pending_admissions",ARRAY(NIL)),CONS(MEMBER("pending_input_buffers",ARRAY(NIL)),CONS(MEMBER("receipts",ARRAY(receipts)),CONS(MEMBER("route_states",OBJECT(NIL)),NIL))))))));

// Exact frozen V1/V2 observation commit under FT v0.1.3 (2ECF2EEF...C1A01).
// Source contacts: retained007 state_objects.mal, receipt_object.mal,
// tick_record.mal, commit.mal; V3.3 sections2--8 simultaneous RETURN;
// GPU_SELF_WITNESS 2CBBA4AD...BCE7 removes hardware append as a GPU tick gate.
//
// VD/VO supply a universally checked observer fixture, not a selected carrier
// map. The shared canonical program, typed ingress and actual STEP_FABRIC
// RETURN still run. Every returned comparison must match the source-derived
// candidate field before the world successor can commit.
//
// No expected bytes, hardware closure, FABRIC_STEP_COMMIT_READY, host world law,
// or current018 chain enters this constructor. Frozen input bytes stay intact.
// The original genesis entry is preserved byte-for-byte and exactly one tick
// entry is appended. Its schema is the frozen D2 observation encoding, with
// the promoted receipt_reading substitution.

// Exact returned successor and exact source-recomputed frozen predecessor.
law VCOM_RETURN := IF GOES_WITH(I20_SNAPSHOT,p,h,snapshot), GOES_WITH(STEP_FABRIC_RETURN,p,snapshot,next), GOES_WITH(I20_SUCCESSOR_JSON,p,h,next,json), GOES_WITH(VO_FIXTURE_PARENT,basis,h,genesis), THIS(VO_DECISION,decision), THIS(VD_INITIAL_CHAIN_MATCH)
 THEN GOES_WITH(VCOM_RETURN,p,h,next);

// Expected comparison operands are the source-produced observer field. The
// JTP contact is the same four NO/THIS readings already used by proposal;
// here it checks, and never replaces, the committed canonical result.
law VCOM_EXPECTED_READING := IF GOES_WITH(VO_PAIR,f,g), GOES_WITH(VO_FIELD,state,f,a), GOES_WITH(VO_FIELD,state,g,b), GOES_WITH(JTP_SAME_RESULT,MARKER(a),MARKER(b),word,reading)
 THEN GOES_WITH(VCOM_EXPECTED_READING,state,f,g,reading);
law VCOM_RESULT_ROW := IF GOES_WITH(VO_PAIR_SPAN,ONE,CONS(ARRAY(CONS(f,CONS(g,NIL))),tail),tail), GOES_WITH(VCOM_EXPECTED_READING,CANDIDATE,f,g,reading), GOES_WITH(I20_COMMITTED_AGREEMENT,p,h,next,f,g,reading)
 THEN GOES_WITH(VCOM_RESULT_SPAN,p,h,next,ONE,CONS(ARRAY(CONS(f,CONS(g,NIL))),tail),tail);
law VCOM_RESULT_DOUBLE := IF GOES_WITH(GSC_SPAN_DOUBLE,n,m), GOES_WITH(VCOM_RESULT_SPAN,p,h,next,n,a,b), GOES_WITH(VCOM_RESULT_SPAN,p,h,next,n,b,c)
 THEN GOES_WITH(VCOM_RESULT_SPAN,p,h,next,m,a,c);
law VCOM_ALL_RESULTS := IF THIS(VO_PAIR_SEQUENCE,ARRAY(rows)), GOES_WITH(VCOM_RESULT_SPAN,p,h,next,FIVE_TWELVE,rows,a), GOES_WITH(VCOM_RESULT_SPAN,p,h,next,ONE_TWENTY_EIGHT,a,b), GOES_WITH(VCOM_RESULT_SPAN,p,h,next,SIXTY_FOUR,b,c), GOES_WITH(VCOM_RESULT_SPAN,p,h,next,SIXTEEN,c,NIL), GOES_WITH(VCOM_RETURN,p,h,next)
 THEN GOES_WITH(VCOM_ALL_RESULTS,p,h,next,ALL_COMPARISONS_SAME);
law VCOM_RESULT_DIFFER_SAME := IF GOES_WITH(VCOM_EXPECTED_READING,CANDIDATE,f,g,SAME), GOES_WITH(I20_COMMITTED_AGREEMENT,p,h,next,f,g,NOT_SAME)
 THEN GOES_WITH(VCOM_RESULT_DIFFER,p,h,next,f,g,NOT_SAME);
law VCOM_RESULT_DIFFER_WALL := IF GOES_WITH(VCOM_EXPECTED_READING,CANDIDATE,f,g,NOT_SAME), GOES_WITH(I20_COMMITTED_AGREEMENT,p,h,next,f,g,SAME)
 THEN GOES_WITH(VCOM_RESULT_DIFFER,p,h,next,f,g,NOT_SAME);

// Receipt changes compare the prior field with actual returned results. The
// NOT_SAME overlap remains a wall, not a failed frame or an admission refusal.
law VCOM_UNCHANGED := IF GOES_WITH(VCOM_RETURN,p,h,next), GOES_WITH(VCOM_EXPECTED_READING,GENESIS,f,g,SAME), GOES_WITH(I20_COMMITTED_AGREEMENT,p,h,next,f,g,SAME)
 THEN GOES_WITH(VCOM_CHANGE_PAIR,p,h,next,f,g,UNCHANGED);
law VCOM_DISCHARGED := IF GOES_WITH(VCOM_RETURN,p,h,next), GOES_WITH(VCOM_EXPECTED_READING,GENESIS,f,g,NOT_SAME), GOES_WITH(I20_COMMITTED_AGREEMENT,p,h,next,f,g,SAME)
 THEN GOES_WITH(VCOM_CHANGE_PAIR,p,h,next,f,g,DISCHARGED);
law VCOM_OPENED := IF GOES_WITH(VCOM_RETURN,p,h,next), GOES_WITH(VCOM_EXPECTED_READING,GENESIS,f,g,SAME), GOES_WITH(I20_COMMITTED_AGREEMENT,p,h,next,f,g,NOT_SAME)
 THEN GOES_WITH(VCOM_CHANGE_PAIR,p,h,next,f,g,OPENED);
law VCOM_RETAINED := IF GOES_WITH(VCOM_RETURN,p,h,next), GOES_WITH(VCOM_EXPECTED_READING,GENESIS,f,g,NOT_SAME), GOES_WITH(I20_COMMITTED_AGREEMENT,p,h,next,f,g,NOT_SAME)
 THEN GOES_WITH(VCOM_CHANGE_PAIR,p,h,next,f,g,RETAINED_WALL);
law VCOM_RECEIPT_ROW_UNCHANGED := IF GOES_WITH(VO_PAIR_SPAN,ONE,CONS(ARRAY(CONS(f,CONS(g,NIL))),tail),tail), GOES_WITH(VCOM_CHANGE_PAIR,p,h,next,f,g,UNCHANGED)
 THEN GOES_WITH(VCOM_RECEIPT_SPAN,p,h,next,ONE,CONS(ARRAY(CONS(f,CONS(g,NIL))),tail),tail,CHANGE_LISTS(NIL,NIL));
law VCOM_RECEIPT_ROW_RETAINED := IF GOES_WITH(VO_PAIR_SPAN,ONE,CONS(ARRAY(CONS(f,CONS(g,NIL))),tail),tail), GOES_WITH(VCOM_CHANGE_PAIR,p,h,next,f,g,RETAINED_WALL)
 THEN GOES_WITH(VCOM_RECEIPT_SPAN,p,h,next,ONE,CONS(ARRAY(CONS(f,CONS(g,NIL))),tail),tail,CHANGE_LISTS(NIL,NIL));
law VCOM_RECEIPT_ROW_DISCHARGED := IF GOES_WITH(VO_PAIR_SPAN,ONE,CONS(ARRAY(CONS(f,CONS(g,NIL))),tail),tail), GOES_WITH(VCOM_CHANGE_PAIR,p,h,next,f,g,DISCHARGED)
 THEN GOES_WITH(VCOM_RECEIPT_SPAN,p,h,next,ONE,CONS(ARRAY(CONS(f,CONS(g,NIL))),tail),tail,CHANGE_LISTS(CONS(ARRAY(CONS(f,CONS(g,NIL))),NIL),NIL));
law VCOM_RECEIPT_ROW_OPENED := IF GOES_WITH(VO_PAIR_SPAN,ONE,CONS(ARRAY(CONS(f,CONS(g,NIL))),tail),tail), GOES_WITH(VCOM_CHANGE_PAIR,p,h,next,f,g,OPENED)
 THEN GOES_WITH(VCOM_RECEIPT_SPAN,p,h,next,ONE,CONS(ARRAY(CONS(f,CONS(g,NIL))),tail),tail,CHANGE_LISTS(NIL,CONS(ARRAY(CONS(f,CONS(g,NIL))),NIL)));

// Balanced ordered folds preserve sorted compact reference observation bytes.
// The sequence has already discharged distinctness,720rows and full coverage
// in VO_PAIR_SEQUENCE. No host supplies discharged/opened membership.
law VCOM_JOIN_D := IF THIS(VCOM_JOIN_REQUEST,CHANGE_LISTS(a,b),CHANGE_LISTS(c,d))
 THEN THIS(VCOM_APPEND_REQUEST,a,c);
law VCOM_JOIN_O := IF THIS(VCOM_JOIN_REQUEST,CHANGE_LISTS(a,b),CHANGE_LISTS(c,d))
 THEN THIS(VCOM_APPEND_REQUEST,b,d);
law VCOM_APPEND_END := IF THIS(VCOM_APPEND_REQUEST,NIL,b)
 THEN GOES_WITH(VCOM_APPEND,NIL,b,b);
law VCOM_APPEND_TAIL := IF THIS(VCOM_APPEND_REQUEST,CONS(a,t),b)
 THEN THIS(VCOM_APPEND_REQUEST,t,b);
law VCOM_APPEND_HEAD := IF THIS(VCOM_APPEND_REQUEST,CONS(a,t),b), GOES_WITH(VCOM_APPEND,t,b,c)
 THEN GOES_WITH(VCOM_APPEND,CONS(a,t),b,CONS(a,c));
law VCOM_JOIN := IF THIS(VCOM_JOIN_REQUEST,CHANGE_LISTS(a,b),CHANGE_LISTS(c,d)), GOES_WITH(VCOM_APPEND,a,c,x), GOES_WITH(VCOM_APPEND,b,d,y)
 THEN GOES_WITH(VCOM_JOIN,CHANGE_LISTS(a,b),CHANGE_LISTS(c,d),CHANGE_LISTS(x,y));
law VCOM_RECEIPT_DOUBLE_REQUEST := IF GOES_WITH(GSC_SPAN_DOUBLE,n,m), GOES_WITH(VCOM_RECEIPT_SPAN,p,h,next,n,a,b,x), GOES_WITH(VCOM_RECEIPT_SPAN,p,h,next,n,b,c,y)
 THEN THIS(VCOM_JOIN_REQUEST,x,y);
law VCOM_RECEIPT_DOUBLE := IF GOES_WITH(GSC_SPAN_DOUBLE,n,m), GOES_WITH(VCOM_RECEIPT_SPAN,p,h,next,n,a,b,x), GOES_WITH(VCOM_RECEIPT_SPAN,p,h,next,n,b,c,y), GOES_WITH(VCOM_JOIN,x,y,z)
 THEN GOES_WITH(VCOM_RECEIPT_SPAN,p,h,next,m,a,c,z);
law VCOM_RECEIPT_PREFIX_REQUEST := IF THIS(VO_PAIR_SEQUENCE,ARRAY(rows)), GOES_WITH(VCOM_RECEIPT_SPAN,p,h,next,FIVE_TWELVE,rows,a,x), GOES_WITH(VCOM_RECEIPT_SPAN,p,h,next,ONE_TWENTY_EIGHT,a,b,y)
 THEN THIS(VCOM_JOIN_REQUEST,x,y);
law VCOM_RECEIPT_PREFIX := IF THIS(VO_PAIR_SEQUENCE,ARRAY(rows)), GOES_WITH(VCOM_RECEIPT_SPAN,p,h,next,FIVE_TWELVE,rows,a,x), GOES_WITH(VCOM_RECEIPT_SPAN,p,h,next,ONE_TWENTY_EIGHT,a,b,y), GOES_WITH(VCOM_JOIN,x,y,z)
 THEN GOES_WITH(VCOM_RECEIPT_PREFIX,p,h,next,b,z);
law VCOM_RECEIPT_SUFFIX_REQUEST := IF GOES_WITH(VCOM_RECEIPT_PREFIX,p,h,next,b,x), GOES_WITH(VCOM_RECEIPT_SPAN,p,h,next,SIXTY_FOUR,b,c,y), GOES_WITH(VCOM_RECEIPT_SPAN,p,h,next,SIXTEEN,c,NIL,z)
 THEN THIS(VCOM_JOIN_REQUEST,y,z);
law VCOM_RECEIPT_SUFFIX := IF GOES_WITH(VCOM_RECEIPT_PREFIX,p,h,next,b,x), GOES_WITH(VCOM_RECEIPT_SPAN,p,h,next,SIXTY_FOUR,b,c,y), GOES_WITH(VCOM_RECEIPT_SPAN,p,h,next,SIXTEEN,c,NIL,z), GOES_WITH(VCOM_JOIN,y,z,s)
 THEN GOES_WITH(VCOM_RECEIPT_PARTS,p,h,next,x,s);
law VCOM_RECEIPT_FINAL_REQUEST := IF GOES_WITH(VCOM_RECEIPT_PARTS,p,h,next,x,y)
 THEN THIS(VCOM_JOIN_REQUEST,x,y);
law VCOM_RECEIPT_LISTS := IF GOES_WITH(VCOM_RECEIPT_PARTS,p,h,next,x,y), GOES_WITH(VCOM_JOIN,x,y,z), GOES_WITH(VCOM_ALL_RESULTS,p,h,next,ALL_COMPARISONS_SAME)
 THEN GOES_WITH(VCOM_RECEIPT_LISTS,p,h,next,z);
law VCOM_RECEIPT_OBJECT := IF GOES_WITH(VCOM_RECEIPT_LISTS,p,h,next,CHANGE_LISTS(d,o))
 THEN GOES_WITH(VCOM_RECEIPT_OBJECT,p,h,next,OBJECT(CONS(MEMBER("discharged",ARRAY(d)),CONS(MEMBER("opened",ARRAY(o)),NIL))));
law VCOM_RECEIPT_NO := IF GOES_WITH(VCOM_RECEIPT_LISTS,p,h,next,CHANGE_LISTS(NIL,NIL))
 THEN GOES_WITH(VCOM_RECEIPT_READING,p,h,next,"NO");
law VCOM_RECEIPT_D_THIS := IF GOES_WITH(VCOM_RECEIPT_LISTS,p,h,next,CHANGE_LISTS(CONS(pair,tail),opened))
 THEN GOES_WITH(VCOM_RECEIPT_READING,p,h,next,"THIS");
law VCOM_RECEIPT_O_THIS := IF GOES_WITH(VCOM_RECEIPT_LISTS,p,h,next,CHANGE_LISTS(discharged,CONS(pair,tail)))
 THEN GOES_WITH(VCOM_RECEIPT_READING,p,h,next,"THIS");

// Candidate observation serialization may precede runtime, exactly as the
// retained state_objects.mal constructs a candidate body. Publication below
// requires the universal VO fixture and every committed comparison. No body
// or digest alone is a committed world.
law VCOM_FIELD_END := IF THIS(VC_ROWS,NIL)
 THEN GOES_WITH(VCOM_FIELD_SUFFIX,NIL,NIL);
law VCOM_FIELD_HEAD := IF THIS(VC_ROWS,CONS(ARRAY(CONS(f,CONS(old,NIL))),tail)), GOES_WITH(VD_REFERENCE_CANDIDATE_FIELD,f,r), GOES_WITH(VC_READING,text,r), GOES_WITH(VCOM_FIELD_SUFFIX,tail,rest)
 THEN GOES_WITH(VCOM_FIELD_SUFFIX,CONS(ARRAY(CONS(f,CONS(old,NIL))),tail),CONS(ARRAY(CONS(f,CONS(text,NIL))),rest));
law VCOM_FIELD_OBJECT := IF THIS(VC_INPUT_FIELD,ARRAY(rows)), GOES_WITH(VCOM_FIELD_SUFFIX,rows,field), THIS(VO_OPERAND_FIXTURE_READY,FROZEN_VECTOR_OBSERVER), THIS(VD_INITIAL_CONTENT_MATCH)
 THEN THIS(VCOM_FIELD_OBJECT,ARRAY(field));
law VCOM_ENTITY_END := IF THIS(VD_E0_ROWS,NIL)
 THEN GOES_WITH(VCOM_ENTITY_SUFFIX,NIL,NIL);
law VCOM_ENTITY_HEAD := IF THIS(VD_E0_ROWS,CONS(MEMBER(name,old),tail)), GOES_WITH(VO_REFERENCE_ENTITY,name,f), GOES_WITH(VCOM_ENTITY_SUFFIX,tail,rest)
 THEN GOES_WITH(VCOM_ENTITY_SUFFIX,CONS(MEMBER(name,old),tail),CONS(MEMBER(name,f),rest));
law VCOM_ENTITY_OBJECT := IF THIS(VD_INPUT_E0,OBJECT(rows)), GOES_WITH(VCOM_ENTITY_SUFFIX,rows,entities), THIS(VO_DECISION,decision), THIS(VO_OPERAND_FIXTURE_READY,FROZEN_VECTOR_OBSERVER)
 THEN THIS(VCOM_ENTITY_OBJECT,OBJECT(entities));
law VCOM_STATE_BODY := IF THIS(VCOM_FIELD_OBJECT,field), THIS(VCOM_ENTITY_OBJECT,entities), GOES_WITH(VCOM_ALL_RESULTS,p,h,next,ALL_COMPARISONS_SAME), THIS(VO_DECISION,decision)
 THEN GOES_WITH(VCOM_STATE_BODY,p,h,next,OBJECT(CONS(MEMBER("entities",entities),CONS(MEMBER("field",field),NIL))));

// Generic SHA-256 responses are matched to their exact source subjects.
law VCOM_STATE_HASH_REQUEST := IF GOES_WITH(VCOM_STATE_BODY,p,h,next,body)
 THEN GOES_WITH(GPU_HASH_REQUEST,VECTOR_STATE,CONTEXT(p,h,next),body);
law VCOM_RECEIPT_HASH_REQUEST := IF GOES_WITH(VCOM_RECEIPT_OBJECT,p,h,next,receipt)
 THEN GOES_WITH(GPU_HASH_REQUEST,VECTOR_RECEIPT,CONTEXT(p,h,next),receipt);
law VCOM_STATE_HASH := IF GOES_WITH(VCOM_STATE_BODY,p,h,next,body), GOES_WITH(GPU_HASH_RESPONSE,body,digest)
 THEN GOES_WITH(VCOM_STATE_HASH,p,h,next,body,digest);
law VCOM_RECEIPT_HASH := IF GOES_WITH(VCOM_RECEIPT_OBJECT,p,h,next,receipt), GOES_WITH(GPU_HASH_RESPONSE,receipt,digest)
 THEN GOES_WITH(VCOM_RECEIPT_HASH,p,h,next,receipt,digest);
law VCOM_DECISION_WHAT := IF THIS(VO_DECISION,DECISION(PROPOSAL(basis,entity,kind,target,lifts),selected)), THIS(VD_INPUT_LIFT,selected), GOES_WITH(VD_SELECTED_OBJECT,LIFT(f,g,k),reading)
 THEN GOES_WITH(VCOM_DECISION_WHAT,DECISION(PROPOSAL(basis,entity,kind,target,lifts),selected),OBJECT(CONS(MEMBER("entity",entity),CONS(MEMBER("lift",selected),CONS(MEMBER("whence",f),NIL)))));
law VCOM_TICK_RECORD := IF GOES_WITH(VCOM_DECISION_WHAT,decision,what), GOES_WITH(VCOM_STATE_HASH,p,h,next,body,stateHash), GOES_WITH(VCOM_RECEIPT_HASH,p,h,next,receipt,receiptHash), GOES_WITH(VCOM_RECEIPT_READING,p,h,next,reading), GOES_WITH(VO_FIXTURE_PARENT,basis,h,entry), GOES_WITH(VCOM_ALL_RESULTS,p,h,next,ALL_COMPARISONS_SAME)
 THEN GOES_WITH(VCOM_TICK_RECORD,p,h,next,decision,OBJECT(CONS(MEMBER("kind","TICK"),CONS(MEMBER("prev",h),CONS(MEMBER("receipt_hash",receiptHash),CONS(MEMBER("receipt_reading",reading),CONS(MEMBER("state_hash",stateHash),CONS(MEMBER("what",what),NIL))))))));
law VCOM_PROMOTION := IF GOES_WITH(VCOM_TICK_RECORD,p,h,next,decision,record), GOES_WITH(VCOM_STATE_BODY,p,h,next,body), GOES_WITH(VCOM_RECEIPT_OBJECT,p,h,next,receipt), GOES_WITH(VCOM_RETURN,p,h,next)
 THEN GOES_WITH(VCOM_PROMOTION,p,h,next,PROMOTION(decision,body,receipt,record));
law VCOM_SUCCESSOR_PROJECTION := IF GOES_WITH(VCOM_PROMOTION,p,h,next,promotion), GOES_WITH(VCOM_RETURN,p,h,next), GOES_WITH(VCOM_ALL_RESULTS,p,h,next,ALL_COMPARISONS_SAME), THIS(VD_INITIAL_CHAIN_MATCH)
 THEN GOES_WITH(FABRIC_SUCCESSOR_PROJECTION,p,next,promotion);
law VCOM_TICK_HASH_REQUEST := IF GOES_WITH(VCOM_PROMOTION,p,h,next,PROMOTION(decision,body,receipt,record)), GOES_WITH(FABRIC_SUCCESSOR_PROJECTION,p,next,PROMOTION(decision,body,receipt,record))
 THEN GOES_WITH(GPU_HASH_REQUEST,VECTOR_TICK,CONTEXT(p,h,next),record);
law VCOM_TICK_HASH := IF GOES_WITH(VCOM_PROMOTION,p,h,next,PROMOTION(decision,body,receipt,record)), GOES_WITH(GPU_HASH_RESPONSE,record,digest), GOES_WITH(FABRIC_SUCCESSOR_PROJECTION,p,next,PROMOTION(decision,body,receipt,record))
 THEN GOES_WITH(VCOM_TICK_HASH,p,h,next,PROMOTION(decision,body,receipt,record),digest);

// The previous link is rechecked at publication. The reference tick entry is
// flat (kind,link,prev,...), NOT the actual018 record-wrapper encoding.
law VCOM_TICK_ENTRY := IF GOES_WITH(VCOM_TICK_HASH,p,h,next,PROMOTION(decision,body,receipt,OBJECT(CONS(MEMBER("kind","TICK"),CONS(MEMBER("prev",h),tail)))),digest), GOES_WITH(VO_FIXTURE_PARENT,basis,h,entry), THIS(VD_INITIAL_CHAIN_MATCH)
 THEN GOES_WITH(VCOM_TICK_ENTRY,p,h,next,OBJECT(CONS(MEMBER("kind","TICK"),CONS(MEMBER("link",digest),CONS(MEMBER("prev",h),tail)))));
law VCOM_COMMIT := IF GOES_WITH(VCOM_PROMOTION,p,h,next,PROMOTION(decision,OBJECT(CONS(MEMBER("entities",entities),CONS(MEMBER("field",field),NIL))),receipt,record)), GOES_WITH(FABRIC_SUCCESSOR_PROJECTION,p,next,PROMOTION(decision,OBJECT(CONS(MEMBER("entities",entities),CONS(MEMBER("field",field),NIL))),receipt,record)), GOES_WITH(VO_FIXTURE_PARENT,basis,h,genesis), GOES_WITH(VCOM_TICK_ENTRY,p,h,next,tick), GOES_WITH(VCOM_RETURN,p,h,next), GOES_WITH(VCOM_ALL_RESULTS,p,h,next,ALL_COMPARISONS_SAME), THIS(VD_INITIAL_CHAIN_MATCH)
 THEN THIS(COMMITTED_VECTOR_OUTPUT,OBJECT(CONS(MEMBER("receipt",receipt),CONS(MEMBER("state",OBJECT(CONS(MEMBER("chain",ARRAY(CONS(genesis,CONS(tick,NIL)))),CONS(MEMBER("entities",entities),CONS(MEMBER("field",field),NIL))))),NIL))));

// Bounded diagnostics remain distinct from the frozen output bytes.
@propose seed VCOM_DIAGNOSTIC_TEXT := {
 GOES_WITH(VCOM_CHANGE_TEXT,UNCHANGED,"UNCHANGED"),
 GOES_WITH(VCOM_CHANGE_TEXT,DISCHARGED,"DISCHARGED"),
 GOES_WITH(VCOM_CHANGE_TEXT,OPENED,"OPENED"),
 GOES_WITH(VCOM_CHANGE_TEXT,RETAINED_WALL,"RETAINED_WALL")
};
law VCOM_CHANGE_OBSERVATION := IF GOES_WITH(VCOM_CHANGE_PAIR,p,h,next,f,g,change), GOES_WITH(VCOM_CHANGE_TEXT,change,text), GOES_WITH(VCOM_ALL_RESULTS,p,h,next,ALL_COMPARISONS_SAME)
 THEN THIS(OBSERVATION_ROW,VECTOR_RECEIPT,ARRAY(CONS(f,CONS(g,CONS(text,NIL)))));
law VCOM_RETAINED_OBSERVATION := IF GOES_WITH(VCOM_CHANGE_PAIR,p,h,next,f,g,RETAINED_WALL), GOES_WITH(VCOM_ALL_RESULTS,p,h,next,ALL_COMPARISONS_SAME)
 THEN THIS(OBSERVATION_ROW,VECTOR_RETAINED_WALLS,ARRAY(CONS(f,CONS(g,NIL))));

// Additive accelerations of ingress_step.mal 61DF9020...E872F5.
// Every conclusion equals repeated applications of the retained one-row rule.
// Block size is execution grouping only: it supplies no row, order, placement,
// admission, hash, receipt, or collection boundary. Original rules remain.

// Four applications of I20_CELLS_TAIL. Intermediate tails remain derivable.
law I20A_CELL_TAIL_FOUR := IF GOES_WITH(I20_CELL_TAIL,p,s,CONS(a,CONS(b,CONS(c,CONS(d,tail)))))
 THEN GOES_WITH(I20_CELL_TAIL,p,s,tail);

// Four I20_BINDING_ROW_APPEND applications; the exact same row witnesses and
// existing terminal suffix are required. Output order remains a,b,c,d,rest.
law I20A_BINDING_FOUR := IF GOES_WITH(I20_CELL_TAIL,p,s,CONS(a,CONS(b,CONS(c,CONS(d,tail))))), GOES_WITH(I20_BINDING_ROW,p,s,a,ar), GOES_WITH(I20_BINDING_ROW,p,s,b,br), GOES_WITH(I20_BINDING_ROW,p,s,c,cr), GOES_WITH(I20_BINDING_ROW,p,s,d,dr), GOES_WITH(I20_BINDING_SUFFIX,p,s,tail,rows)
 THEN GOES_WITH(I20_BINDING_SUFFIX,p,s,CONS(a,CONS(b,CONS(c,CONS(d,tail)))),CONS(ar,CONS(br,CONS(cr,CONS(dr,rows)))));

// Two I20_PREPARED_ROW applications. Neither INPUT_VALUE nor admission is
// produced here; both prepared payloads must already have their source proof.
law I20A_PREPARED_TWO := IF GOES_WITH(I20_CELL_TAIL,p,s,CONS(a,CONS(b,tail))), GOES_WITH(I20_CELL,p,s,a,ai), GOES_WITH(I20_CELL,p,s,b,bi), GOES_WITH(I20_PREPARED_PAYLOAD,p,s,a,ap), GOES_WITH(I20_PREPARED_PAYLOAD,p,s,b,bp), GOES_WITH(I20_PREPARED_SUFFIX,p,s,tail,rows)
 THEN GOES_WITH(I20_PREPARED_SUFFIX,p,s,CONS(a,CONS(b,tail)),CONS(CELL_STATE(ai,ap),CONS(CELL_STATE(bi,bp),rows)));

// This helper packages exactly the four row witnesses of I20_NEXT_ROW. It is
// needed to keep the two-row shortcut within eight antecedents. It carries no
// collection boundary and cannot publish a return without the existing suffix.
law I20A_NEXT_ROW_WITNESSES := IF GOES_WITH(I20_CELL,p,s,c,id), GOES_WITH(I20_NEXT_PAYLOAD,p,s,c,after), GOES_WITH(I20_RUNTIME_RECEIPT,p,s,c,CELL_EVALUATED,eid,e), GOES_WITH(I20_RUNTIME_RECEIPT,p,s,c,PAYLOAD_TRANSITION,tid,t)
 THEN GOES_WITH(I20A_NEXT_ROW,p,s,c,STEP_ROW(CELL_STATE(id,after),e,t));
// Two I20_NEXT_ROW applications. Receipt order is exactly e_a,t_a,e_b,t_b.
law I20A_NEXT_TWO := IF GOES_WITH(I20_CELL_TAIL,p,s,CONS(a,CONS(b,tail))), GOES_WITH(I20A_NEXT_ROW,p,s,a,STEP_ROW(CELL_STATE(ai,ap),ae,at)), GOES_WITH(I20A_NEXT_ROW,p,s,b,STEP_ROW(CELL_STATE(bi,bp),be,bt)), GOES_WITH(I20_NEXT_SUFFIX,p,s,tail,rows,receipts)
 THEN GOES_WITH(I20_NEXT_SUFFIX,p,s,CONS(a,CONS(b,tail)),CONS(CELL_STATE(ai,ap),CONS(CELL_STATE(bi,bp),rows)),CONS(ae,CONS(at,CONS(be,CONS(bt,receipts)))));

// Two I20_PAYLOAD_JSON_ROW applications. The same checked cell identities and
// source-produced completed objects appear in the same canonical observation.
law I20A_PAYLOAD_JSON_TWO := IF GOES_WITH(I20_CELL_TAIL,p,s,CONS(a,CONS(b,tail))), GOES_WITH(I20_CELL,p,s,a,ai), GOES_WITH(I20_CELL,p,s,b,bi), GOES_WITH(I20_COMPLETED_JSON,p,s,a,aj), GOES_WITH(I20_COMPLETED_JSON,p,s,b,bj), GOES_WITH(I20_PAYLOAD_JSON_SUFFIX,p,s,tail,rows)
 THEN GOES_WITH(I20_PAYLOAD_JSON_SUFFIX,p,s,CONS(a,CONS(b,tail)),CONS(MEMBER(ai,aj),CONS(MEMBER(bi,bj),rows)));

// Four I20_RECEIPT_JSON_ROW applications. This is only JSON projection;
// I20_RECEIPT_COMPLETE still separately requires membership, strict receipt-ID
// order, and all 1440 rows before I20_SUCCESSOR_JSON can be emitted.
law I20A_RECEIPT_JSON_FOUR := IF THIS(I20_RECEIPT_ROWS,CONS(ARRAY(CONS(ai,CONS(aj,NIL))),CONS(ARRAY(CONS(bi,CONS(bj,NIL))),CONS(ARRAY(CONS(ci,CONS(cj,NIL))),CONS(ARRAY(CONS(di,CONS(dj,NIL))),tail))))), GOES_WITH(I20_RECEIPT_JSON_SUFFIX,tail,rows)
 THEN GOES_WITH(I20_RECEIPT_JSON_SUFFIX,CONS(ARRAY(CONS(ai,CONS(aj,NIL))),CONS(ARRAY(CONS(bi,CONS(bj,NIL))),CONS(ARRAY(CONS(ci,CONS(cj,NIL))),CONS(ARRAY(CONS(di,CONS(dj,NIL))),tail)))),CONS(aj,CONS(bj,CONS(cj,CONS(dj,rows)))));

// Four HASH_BATCH_TAIL applications complement the retained eight-row block;
// no response tuple or hash assertion is manufactured by this traversal.
law I20A_HASH_BATCH_FOUR := IF THIS(HASH_BATCH_ROWS,CONS(a,CONS(b,CONS(c,CONS(d,tail)))))
 THEN THIS(HASH_BATCH_ROWS,tail);


// Generic additive custody import; no previous input seed is replaced.
@readonly input VECTOR_HASH_05 := "vh05:";
law VECTOR_HASH_05_TRANSPORT := IF THIS(VECTOR_HASH_05,ARRAY(rows)) THEN THIS(HASH_BATCH_ROWS,rows);

// Generic additive custody import; no previous input seed is replaced.
@readonly input VECTOR_HASH_06 := "vh06:";
law VECTOR_HASH_06_TRANSPORT := IF THIS(VECTOR_HASH_06,ARRAY(rows)) THEN THIS(HASH_BATCH_ROWS,rows);

// Generic additive custody import; no previous input seed is replaced.
@readonly input VECTOR_HASH_07 := "vh07:";
law VECTOR_HASH_07_TRANSPORT := IF THIS(VECTOR_HASH_07,ARRAY(rows)) THEN THIS(HASH_BATCH_ROWS,rows);
