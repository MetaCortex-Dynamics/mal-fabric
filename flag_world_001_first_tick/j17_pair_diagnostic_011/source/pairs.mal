// User-requested Part A: both constant readings on every keep-two fibre.
// An overlap's two original endpoint flags define the fibre; no host offers.
// All other flags retain their snapshot reading. No worldline mutation.

law PA_CASE_THIS := IF GOES_WITH(KD_INCIDENT,a,k,a,b,old) THEN THIS(PA_CASE,PAIR(k,a,b,"THIS"));
law PA_CASE_NO := IF GOES_WITH(KD_INCIDENT,a,k,a,b,old) THEN THIS(PA_CASE,PAIR(k,a,b,"NO"));
law PA_EFFECT := IF THIS(PA_CASE,PAIR(k,a,b,r)) THEN GOES_WITH(PA_EFFECT,PAIR(k,a,b,r),WRITE(a,r),WRITE(b,r),RETAIN_OTHER_FLAGS);
law PA_ENDPOINT_A := IF THIS(PA_CASE,PAIR(k,a,b,r)) THEN GOES_WITH(PA_ENDPOINT,PAIR(k,a,b,r),SIDE_A,a);
law PA_ENDPOINT_B := IF THIS(PA_CASE,PAIR(k,a,b,r)) THEN GOES_WITH(PA_ENDPOINT,PAIR(k,a,b,r),SIDE_B,b);
law PA_AFFECTED := IF GOES_WITH(PA_ENDPOINT,m,side,f), GOES_WITH(KD_INCIDENT,f,k,a,b,old) THEN GOES_WITH(PA_AFFECTED,m,a,b,old);
law PA_CHECK_AFFECTED := IF GOES_WITH(PA_AFFECTED,m,a,b,old) THEN GOES_WITH(PA_CHECK,m,a,b,old);
// Include every old wall as well, so retained walls are explicit native bytes.
law PA_CHECK_WALL := IF THIS(PA_CASE,m), GOES_WITH(KD_BASE_BOUND,a,b,"NOT_SAME") THEN GOES_WITH(PA_CHECK,m,a,b,"NOT_SAME");
law PA_READ_A := IF GOES_WITH(PA_CHECK,m,a,b,old) THEN GOES_WITH(PA_READ,m,a);
law PA_READ_B := IF GOES_WITH(PA_CHECK,m,a,b,old) THEN GOES_WITH(PA_READ,m,b);
law PA_ASSIGN_A := IF THIS(PA_CASE,PAIR(k,a,b,r)), GOES_WITH(PA_READ,PAIR(k,a,b,r),a) THEN GOES_WITH(PA_FIELD,PAIR(k,a,b,r),a,r);
law PA_ASSIGN_B := IF THIS(PA_CASE,PAIR(k,a,b,r)), GOES_WITH(PA_READ,PAIR(k,a,b,r),b) THEN GOES_WITH(PA_FIELD,PAIR(k,a,b,r),b,r);
law PA_COMPARE_A := IF GOES_WITH(PA_READ,PAIR(k,a,b,r),f) THEN GOES_WITH(KD_DIFF_REQUEST,f,a);
law PA_COMPARE_B := IF GOES_WITH(PA_READ,PAIR(k,a,b,r),f) THEN GOES_WITH(KD_DIFF_REQUEST,f,b);
law PA_RETAIN := IF GOES_WITH(PA_READ,PAIR(k,a,b,r),f), GOES_WITH(KD_DIFF,f,a), GOES_WITH(KD_DIFF,f,b), GOES_WITH(KD_FIELD,f,old) THEN GOES_WITH(PA_FIELD,PAIR(k,a,b,r),f,old);
law PA_AFTER_SAME := IF GOES_WITH(PA_CHECK,m,a,b,old), GOES_WITH(PA_FIELD,m,a,r), GOES_WITH(PA_FIELD,m,b,r) THEN GOES_WITH(PA_AFTER,m,a,b,old,"SAME");
law PA_AFTER_DIFFER_A := IF GOES_WITH(PA_CHECK,m,a,b,old), GOES_WITH(PA_FIELD,m,a,"THIS"), GOES_WITH(PA_FIELD,m,b,"NO") THEN GOES_WITH(PA_AFTER,m,a,b,old,"NOT_SAME");
law PA_AFTER_DIFFER_B := IF GOES_WITH(PA_CHECK,m,a,b,old), GOES_WITH(PA_FIELD,m,a,"NO"), GOES_WITH(PA_FIELD,m,b,"THIS") THEN GOES_WITH(PA_AFTER,m,a,b,old,"NOT_SAME");
law PA_OPENED := IF GOES_WITH(PA_AFTER,m,a,b,"SAME","NOT_SAME") THEN GOES_WITH(PA_OPENED,m,a,b);
law PA_DISCHARGED := IF GOES_WITH(PA_AFTER,m,a,b,"NOT_SAME","SAME") THEN GOES_WITH(PA_DISCHARGED,m,a,b);
law PA_RETAINED := IF GOES_WITH(PA_AFTER,m,a,b,"NOT_SAME","NOT_SAME") THEN GOES_WITH(PA_RETAINED,m,a,b);
law PA_CHANGED_A := IF THIS(PA_CASE,PAIR(k,a,b,"THIS")), GOES_WITH(KD_FIELD,a,"NO") THEN GOES_WITH(PA_CHANGED,PAIR(k,a,b,"THIS"),a,"NO","THIS");
law PA_CHANGED_B := IF THIS(PA_CASE,PAIR(k,a,b,"THIS")), GOES_WITH(KD_FIELD,b,"NO") THEN GOES_WITH(PA_CHANGED,PAIR(k,a,b,"THIS"),b,"NO","THIS");
law PA_CHANGED_C := IF THIS(PA_CASE,PAIR(k,a,b,"NO")), GOES_WITH(KD_FIELD,a,"THIS") THEN GOES_WITH(PA_CHANGED,PAIR(k,a,b,"NO"),a,"THIS","NO");
law PA_CHANGED_D := IF THIS(PA_CASE,PAIR(k,a,b,"NO")), GOES_WITH(KD_FIELD,b,"THIS") THEN GOES_WITH(PA_CHANGED,PAIR(k,a,b,"NO"),b,"THIS","NO");

// The only possibly changed overlaps touch the assigned endpoints. Both have
// exactly one delta/gamma/tau neighbour, witnessed by the unchanged input.
law PA_SIDE_EXAMINED := IF GOES_WITH(PA_ENDPOINT,m,side,f), GOES_WITH(KD_INCIDENT,f,k,a,b,old), GOES_WITH(PA_AFTER,m,a,b,old,next) THEN GOES_WITH(PA_SIDE_EXAMINED,m,side,k);
law PA_ENDPOINT_EXAMINED := IF GOES_WITH(PA_SIDE_EXAMINED,m,side,DELTA), GOES_WITH(PA_SIDE_EXAMINED,m,side,GAMMA), GOES_WITH(PA_SIDE_EXAMINED,m,side,TAU) THEN GOES_WITH(PA_ENDPOINT_EXAMINED,m,side);
law PA_COMPLETE := IF THIS(PA_CASE,m), GOES_WITH(PA_ENDPOINT_EXAMINED,m,SIDE_A), GOES_WITH(PA_ENDPOINT_EXAMINED,m,SIDE_B) THEN THIS(PA_COMPLETE,m);
law PA_NO_OPEN_SAME := IF GOES_WITH(PA_AFTER,m,a,b,old,"SAME") THEN GOES_WITH(PA_NO_OPEN,m,a,b);
law PA_NO_OPEN_RETAINED := IF GOES_WITH(PA_AFTER,m,a,b,"NOT_SAME","NOT_SAME") THEN GOES_WITH(PA_NO_OPEN,m,a,b);
law PA_NO_DISCHARGE_SAME := IF GOES_WITH(PA_AFTER,m,a,b,"SAME",next) THEN GOES_WITH(PA_NO_DISCHARGE,m,a,b);
law PA_NO_DISCHARGE_RETAINED := IF GOES_WITH(PA_AFTER,m,a,b,"NOT_SAME","NOT_SAME") THEN GOES_WITH(PA_NO_DISCHARGE,m,a,b);
law PA_SIDE_NO_OPEN := IF GOES_WITH(PA_ENDPOINT,m,side,f), GOES_WITH(KD_INCIDENT,f,k,a,b,old), GOES_WITH(PA_NO_OPEN,m,a,b) THEN GOES_WITH(PA_SIDE_NO_OPEN,m,side,k);
law PA_ENDPOINT_NO_OPEN := IF GOES_WITH(PA_SIDE_NO_OPEN,m,side,DELTA), GOES_WITH(PA_SIDE_NO_OPEN,m,side,GAMMA), GOES_WITH(PA_SIDE_NO_OPEN,m,side,TAU) THEN GOES_WITH(PA_ENDPOINT_NO_OPEN,m,side);
law PA_SIDE_NO_DISCHARGE := IF GOES_WITH(PA_ENDPOINT,m,side,f), GOES_WITH(KD_INCIDENT,f,k,a,b,old), GOES_WITH(PA_NO_DISCHARGE,m,a,b) THEN GOES_WITH(PA_SIDE_NO_DISCHARGE,m,side,k);
law PA_ENDPOINT_NO_DISCHARGE := IF GOES_WITH(PA_SIDE_NO_DISCHARGE,m,side,DELTA), GOES_WITH(PA_SIDE_NO_DISCHARGE,m,side,GAMMA), GOES_WITH(PA_SIDE_NO_DISCHARGE,m,side,TAU) THEN GOES_WITH(PA_ENDPOINT_NO_DISCHARGE,m,side);
law PA_STRICT := IF THIS(PA_COMPLETE,m), GOES_WITH(PA_ENDPOINT_NO_OPEN,m,SIDE_A), GOES_WITH(PA_ENDPOINT_NO_OPEN,m,SIDE_B), GOES_WITH(PA_DISCHARGED,m,a,b) THEN THIS(PA_STRICT,m);
law PA_EXCLUDED_OPEN := IF THIS(PA_COMPLETE,m), GOES_WITH(PA_OPENED,m,a,b) THEN GOES_WITH(PA_EXCLUDED,m,OPENED_NONEMPTY,a,b);
law PA_EXCLUDED_EMPTY := IF THIS(PA_COMPLETE,m), GOES_WITH(PA_ENDPOINT_NO_DISCHARGE,m,SIDE_A), GOES_WITH(PA_ENDPOINT_NO_DISCHARGE,m,SIDE_B) THEN GOES_WITH(PA_EXCLUDED_EMPTY,m,DISCHARGED_EMPTY);
