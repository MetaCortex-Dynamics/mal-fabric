  CAN readonly IN sha256_message_walk() -> Atom {
    SAME sha_message_stack.kind {
      "END" -> NO IN true
      "NODE" -> IN sha_message_step {
        THIS sha_message_node = sha_message_stack.value
        THIS sha_message_rest = sha_message_stack.next
        SAME sha_message_node.kind {
          "EMPTY" -> IN sha_message_empty {
            THIS sha_message_stack = sha_message_rest
            NO IN sha256_message_walk.call()
          }
          "LEAF" -> IN sha_message_leaf {
            MANY sha_message_byte IN sha_message_node.items {
              THIS sha_message_write_receipt = sha256_block_write.call(sha_message_byte)
              THIS sha_length_add_result = word32_add2_full.call(sha_bit_length_low, sha_constant_eight)
              THIS sha_bit_length_low = sha_length_add_result.word
              SAME sha_length_add_result.carry {
                true -> THIS sha_bit_length_high = word32_add2.call(sha_bit_length_high, sha_constant_one)
                _ -> NONE
              }
            }
            THIS sha_message_stack = sha_message_rest
            NO IN sha256_message_walk.call()
          }
          "CONCAT" -> IN sha_message_concat {
            THIS sha_message_stack = TOGETHER {
              kind: "NODE"
              value: sha_message_node.left
              next: TOGETHER {
                kind: "NODE"
                value: sha_message_node.right
                next: sha_message_rest
              }
            }
            NO IN sha256_message_walk.call()
          }
          _ -> NO IN false
        }
      }
      _ -> NO IN false
    }
