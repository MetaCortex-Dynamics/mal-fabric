        THIS sha_message_receipt = sha256_message_walk.call()
        THIS sha_saved_bit_length_high = sha_bit_length_high
        THIS sha_saved_bit_length_low = sha_bit_length_low
        THIS sha_padding_start_receipt = sha256_block_write.call(128)
        THIS sha_padding_zero_receipt = sha256_pad_to_length_field.call()
        THIS sha_length_byte_0 = word32_be_byte_0.call(sha_saved_bit_length_high)
