 THEN GOES_WITH(R42_PRIOR_MAP,t,n,KEYED_LEAF(c,payload));
law R42_PRIOR_JOIN := IF GOES_WITH(R42_MAP_JOIN,n,a,b), GOES_WITH(R42_PRIOR_MAP,t,a,left), GOES_WITH(R42_PRIOR_MAP,t,b,right)
 THEN GOES_WITH(R42_PRIOR_MAP,t,n,KEYED_JOIN(left,right));
law R42_SNAPSHOT := IF THIS(R42_MAP_ROOT,n), GOES_WITH(R42_PRIOR_MAP,t,n,payloads), GOES_WITH(R42_ADMITTED_PROGRAM,p,program,proof), GOES_WITH(R42_INITIAL_AUX,t,AUX(rs,pa,ib,ob,receipts))
 THEN GOES_WITH(R42_SNAPSHOT,t,p,FABRIC_STATE(PAYLOAD_MAP(payloads),rs,pa,ib,ob,receipts));

// I20 :65-68,113-114. Exact two-reading SAME semantics, before projection.
@propose seed R42_COMPARISON_DOMAIN := {
 GOES_WITH(R42_COMPARE,READING_NO,READING_NO,SAME),
 GOES_WITH(R42_COMPARE,READING_THIS,READING_THIS,SAME),
 GOES_WITH(R42_COMPARE,READING_NO,READING_THIS,NOT_SAME),
 GOES_WITH(R42_COMPARE,READING_THIS,READING_NO,NOT_SAME)
};
law R42_EVALUATE := IF GOES_WITH(R42_SNAPSHOT,t,p,snapshot), GOES_WITH(R42_ADMITTED,t,c,ADMITTED(frame,admission)), GOES_WITH(R42_INPUT_VALUE,t,c,LEFT,f,l,lv), GOES_WITH(R42_INPUT_VALUE,t,c,RIGHT,g,r,rv), GOES_WITH(R42_COMPARE,l,r,result)
 THEN GOES_WITH(R42_RESULT,t,c,RESULT(SAME_NOT_SAME,WHAT,frame,result));
// I20 :122-140,155-166. Complete retained frame, result, two runtime receipt
// subjects, empty egress (canonical routes are NIL), then one RETURN barrier.
law R42_COMPLETED := IF GOES_WITH(R42_ADMITTED,t,c,ADMITTED(frame,admission)), GOES_WITH(R42_RESULT,t,c,result)
 THEN GOES_WITH(R42_COMPLETED,t,c,COMPLETED(frame,result,NIL));
law R42_RESULT_JSON := IF GOES_WITH(R42_RESULT,t,c,RESULT(SAME_NOT_SAME,WHAT,frame,v)), GOES_WITH(R42_FRAME_JSON,t,c,fj), GOES_WITH(R42_VERDICT_TEXT,v,text)
 THEN GOES_WITH(R42_RESULT_JSON,t,c,OBJECT(CONS(MEMBER("input_frame",fj),CONS(MEMBER("operator","SAME_NOT_SAME"),CONS(MEMBER("reading",text),CONS(MEMBER("witness","WHAT"),NIL))))));
law R42_EVAL_RECEIPT_PAYLOAD := IF GOES_WITH(R42_RESULT_JSON,t,c,json) THEN GOES_WITH(R42_RECEIPT_PAYLOAD,t,c,CELL_EVALUATED,json);
law R42_TRANSITION_RECEIPT_PAYLOAD := IF GOES_WITH(R42_RESULT,t,c,result) THEN GOES_WITH(R42_RECEIPT_PAYLOAD,t,c,PAYLOAD_TRANSITION,ARRAY(CONS("ADMITTED",CONS("COMPLETED",NIL))));
law R42_RECEIPT_PAYLOAD_REQUEST := IF GOES_WITH(R42_RECEIPT_PAYLOAD,t,c,kind,subject) THEN GOES_WITH(R42_HASH_REQUEST,subject);
law R42_RECEIPT_ID_SUBJECT := IF GOES_WITH(R42_RECEIPT_PAYLOAD,t,c,kind,subject), GOES_WITH(R42_HASH_RESPONSE,subject,digest), GOES_WITH(R42_KIND_TEXT,kind,text)
 THEN GOES_WITH(R42_RECEIPT_ID_SUBJECT,t,c,kind,digest,ARRAY(CONS(text,CONS(c,CONS(digest,NIL)))));
law R42_RECEIPT_ID_REQUEST := IF GOES_WITH(R42_RECEIPT_ID_SUBJECT,t,c,kind,digest,subject) THEN GOES_WITH(R42_HASH_REQUEST,subject);
law R42_RUNTIME_RECEIPT := IF GOES_WITH(R42_RECEIPT_ID_SUBJECT,t,c,kind,digest,subject), GOES_WITH(R42_HASH_RESPONSE,subject,rid), GOES_WITH(R42_KIND_TEXT,kind,text)
 THEN GOES_WITH(R42_RUNTIME_RECEIPT,t,c,kind,OBJECT(CONS(MEMBER("kind",text),CONS(MEMBER("payload_digest",digest),CONS(MEMBER("receipt_id",rid),CONS(MEMBER("subject_id",c),NIL))))));
law R42_RECEIPTS := IF GOES_WITH(R42_RUNTIME_RECEIPT,t,c,CELL_EVALUATED,e), GOES_WITH(R42_RUNTIME_RECEIPT,t,c,PAYLOAD_TRANSITION,p)
 THEN GOES_WITH(R42_RECEIPTS,t,c,RECEIPTS(e,p));
law R42_NEXT_LEAF := IF GOES_WITH(R42_MAP_LEAF,n,c), GOES_WITH(R42_COMPLETED,t,c,payload), GOES_WITH(R42_RECEIPTS,t,c,receipts)
 THEN GOES_WITH(R42_NEXT_MAP,t,n,KEYED_LEAF(c,payload),KEYED_LEAF(c,receipts));
law R42_NEXT_JOIN := IF GOES_WITH(R42_MAP_JOIN,n,a,b), GOES_WITH(R42_NEXT_MAP,t,a,left,lr), GOES_WITH(R42_NEXT_MAP,t,b,right,rr)
 THEN GOES_WITH(R42_NEXT_MAP,t,n,KEYED_JOIN(left,right),KEYED_JOIN(lr,rr));
law R42_RETURN := IF THIS(R42_MAP_ROOT,n), GOES_WITH(R42_NEXT_MAP,t,n,payloads,receipts), GOES_WITH(R42_SNAPSHOT,t,p,prior), GOES_WITH(R42_ADMITTED_PROGRAM,p,program,proof)
 THEN GOES_WITH(STEP_FABRIC_RETURN,t,program,prior,FABRIC_STATE(PAYLOAD_MAP(payloads),NIL,NIL,NIL,NIL,RECEIPT_SET(receipts)));
law R42_RETURNED_CELL := IF GOES_WITH(STEP_FABRIC_RETURN,t,program,prior,next), GOES_WITH(R42_COMPLETED,t,c,payload)
 THEN GOES_WITH(R42_RETURNED_CELL,t,c,payload);

// Leaves come from returned COMPLETED frame values, never raw source readings.
law R42_RETURNED_LEFT := IF GOES_WITH(R42_RETURNED_CELL,t,c,COMPLETED(FRAME(LEFT(CONS(INPUT_VALUE(route,IDENTITY_ESSENCE,OBJECT(CONS(MEMBER("flag",j),CONS(MEMBER("reading",text),CONS(MEMBER("snapshot",h),NIL)))),receipt),NIL)),RIGHT(rv)),result,NIL)), GOES_WITH(R42_CELL,c,f,g), GOES_WITH(R42_FLAG_JSON,f,j), GOES_WITH(R42_CASE_TEXT,t,h), GOES_WITH(R42_READING_TEXT,r,text)
 THEN GOES_WITH(R42_RETURNED_READING,t,f,r);
law R42_RETURNED_RIGHT := IF GOES_WITH(R42_RETURNED_CELL,t,c,COMPLETED(FRAME(LEFT(lv),RIGHT(CONS(INPUT_VALUE(route,IDENTITY_ESSENCE,OBJECT(CONS(MEMBER("flag",j),CONS(MEMBER("reading",text),CONS(MEMBER("snapshot",h),NIL)))),receipt),NIL))),result,NIL)), GOES_WITH(R42_CELL,c,g,f), GOES_WITH(R42_FLAG_JSON,f,j), GOES_WITH(R42_CASE_TEXT,t,h), GOES_WITH(R42_READING_TEXT,r,text)
 THEN GOES_WITH(R42_RETURNED_READING,t,f,r);
// RESULT_CONTACT transports a result to its unchanged snapshot in positives.
// The two diagnostic controls omit/displace this contact for one entire site;
// canonical execution and returned frames remain present in those controls.
law R42_RETURNED_RESULT := IF GOES_WITH(R42_RETURNED_CELL,t,c,COMPLETED(frame,RESULT(SAME_NOT_SAME,WHAT,frame,v),NIL)), GOES_WITH(R42_RESULT_CONTACT,t,c,target), GOES_WITH(R42_CELL,c,f,g), GOES_WITH(R42_FLAG,f,s), GOES_WITH(R42_FLAG,g,s)
 THEN GOES_WITH(R42_EDGE_RESULT,target,s,f,g,v);
law R42_PATH_EDGE := IF GOES_WITH(R42_EDGE_RESULT,t,s,f,g,v) THEN GOES_WITH(R42_PATH,t,s,f,g,v);
law R42_PATH_REVERSE := IF GOES_WITH(R42_EDGE_RESULT,t,s,f,g,v) THEN GOES_WITH(R42_PATH,t,s,g,f,v);
// Every incidence path participates. No convenient route is selected. These
// four compositions are exact equality on the bound two-reading domain.
// This closure reads the RETURNED result record. It neither evaluates another
// canonical cell nor observes a current-tick result inside STEP_FABRIC.
law R42_PATH_SS := IF GOES_WITH(R42_PATH,t,s,a,b,SAME), GOES_WITH(R42_PATH,t,s,b,c,SAME)
 THEN GOES_WITH(R42_PATH,t,s,a,c,SAME);
law R42_PATH_SN := IF GOES_WITH(R42_PATH,t,s,a,b,SAME), GOES_WITH(R42_PATH,t,s,b,c,NOT_SAME)
 THEN GOES_WITH(R42_PATH,t,s,a,c,NOT_SAME);
law R42_PATH_NS := IF GOES_WITH(R42_PATH,t,s,a,b,NOT_SAME), GOES_WITH(R42_PATH,t,s,b,c,SAME)
 THEN GOES_WITH(R42_PATH,t,s,a,c,NOT_SAME);
law R42_PATH_NN := IF GOES_WITH(R42_PATH,t,s,a,b,NOT_SAME), GOES_WITH(R42_PATH,t,s,b,c,NOT_SAME)
 THEN GOES_WITH(R42_PATH,t,s,a,c,SAME);

// Source cover-left supplies the representative structurally. The parent
// constructor is W38 :31; canonical results supply its equality premise. Both
// complete child-uniformity proofs remain required, including disconnected
// intermediate supports. No equality is reconstructed from source readings.
law R42_TREE_LEAF := IF GOES_WITH(R42_COVER_LEAF,s,n,f), GOES_WITH(R42_RETURNED_READING,t,f,r)
 THEN GOES_WITH(R42_TREE,t,s,n,r,f);
law R42_TREE_JOIN := IF GOES_WITH(R42_COVER_JOIN,s,n,a,b), GOES_WITH(R42_TREE,t,s,a,l,fa), GOES_WITH(R42_TREE,t,s,b,r,fb), GOES_WITH(R42_PATH,t,s,fa,fb,SAME)
 THEN GOES_WITH(R42_TREE,t,s,n,l,fa);
law R42_SOURCE_PARENT := IF GOES_WITH(R42_COVER_JOIN,s,n,a,b), GOES_WITH(R42_TREE,t,s,n,r,f)
 THEN GOES_WITH(W38_SITE_READING_TREE,t,s,r,n);
