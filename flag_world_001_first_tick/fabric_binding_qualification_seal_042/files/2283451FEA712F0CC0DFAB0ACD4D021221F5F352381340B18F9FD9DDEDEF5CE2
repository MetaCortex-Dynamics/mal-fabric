// Canonical static DRC, bounded to SAME_NOT_SAME cells and finite P20-shaped
// primitive inventories. No host DRC verdict is an input. Trees are lossless
// serialization covers; source laws check every leaf and every join.
// Sources: STATIC_FABRIC_SPEC sections3-13 and canonical static kernel
// 8B983301...E4347C0. VIII applies to actual incoming-route targets only.
// Historical box spellings below are exact canonical payload bytes, not new law.
@propose seed D42_CONTRACT := {
 THIS(D42_CONDITION,I),THIS(D42_CONDITION,II),THIS(D42_CONDITION,III),THIS(D42_CONDITION,IV),
 THIS(D42_CONDITION,V),THIS(D42_CONDITION,VI),THIS(D42_CONDITION,VII),THIS(D42_CONDITION,VIII),THIS(D42_CONDITION,SCOPE),
 GOES_WITH(D42_SORT_CONDITION,IDS,I),GOES_WITH(D42_SORT_CONDITION,MEMBERS,II),GOES_WITH(D42_SORT_CONDITION,PLACEMENTS,III),GOES_WITH(D42_SORT_CONDITION,ROUTES,V),
 GOES_WITH(D42_MEMBER_KINDS,MOTIF,CELL),GOES_WITH(D42_MEMBER_KINDS,MOTIF,MOTIF),GOES_WITH(D42_MEMBER_KINDS,BLOCK,MOTIF),GOES_WITH(D42_MEMBER_KINDS,ROOT,BLOCK),
 THIS(D42_NONCELL,MOTIF),THIS(D42_NONCELL,BLOCK),THIS(D42_NONCELL,ROOT),
 GOES_WITH(D42_WTYPE,"WHAT","identity/essence"),GOES_WITH(D42_WTYPE,"WHERE","location/context"),
 GOES_WITH(D42_WTYPE,"WHICH","selection/discrimination"),GOES_WITH(D42_WTYPE,"WHEN","temporal/sequence"),
 GOES_WITH(D42_WTYPE,"FOR_WHAT","teleological/purpose"),GOES_WITH(D42_WTYPE,"HOW","mechanism/process"),GOES_WITH(D42_WTYPE,"WHENCE","origin/genealogy"),
 THIS(D42_ROLE,"LEFT"),THIS(D42_ROLE,"RIGHT")
};

// Unsigned byte order is derived at the first differing bit of exact UTF8 bytes.
law D42_BYTE_QUERY := IF GOES_WITH(D42_BYTES_QUERY,CONS(h,a),CONS(j,b)) THEN GOES_WITH(D42_BYTE_QUERY,h,j);
law D42_BYTE_QUERY_REVERSE := IF GOES_WITH(D42_BYTES_QUERY,CONS(h,a),CONS(j,b)) THEN GOES_WITH(D42_BYTE_QUERY,j,h);
law D42_BYTE_LT_0 := IF GOES_WITH(D42_BYTE_QUERY,a,b),GOES_WITH(D42_BYTE_BITS,a,BITS(Z,a0,a1,a2,a3,a4,a5,a6)),GOES_WITH(D42_BYTE_BITS,b,BITS(O,b0,b1,b2,b3,b4,b5,b6)) THEN GOES_WITH(D42_BYTE_LT,a,b);
law D42_BYTE_LT_1 := IF GOES_WITH(D42_BYTE_QUERY,a,b),GOES_WITH(D42_BYTE_BITS,a,BITS(p0,Z,a0,a1,a2,a3,a4,a5)),GOES_WITH(D42_BYTE_BITS,b,BITS(p0,O,b0,b1,b2,b3,b4,b5)) THEN GOES_WITH(D42_BYTE_LT,a,b);
law D42_BYTE_LT_2 := IF GOES_WITH(D42_BYTE_QUERY,a,b),GOES_WITH(D42_BYTE_BITS,a,BITS(p0,p1,Z,a0,a1,a2,a3,a4)),GOES_WITH(D42_BYTE_BITS,b,BITS(p0,p1,O,b0,b1,b2,b3,b4)) THEN GOES_WITH(D42_BYTE_LT,a,b);
law D42_BYTE_LT_3 := IF GOES_WITH(D42_BYTE_QUERY,a,b),GOES_WITH(D42_BYTE_BITS,a,BITS(p0,p1,p2,Z,a0,a1,a2,a3)),GOES_WITH(D42_BYTE_BITS,b,BITS(p0,p1,p2,O,b0,b1,b2,b3)) THEN GOES_WITH(D42_BYTE_LT,a,b);
law D42_BYTE_LT_4 := IF GOES_WITH(D42_BYTE_QUERY,a,b),GOES_WITH(D42_BYTE_BITS,a,BITS(p0,p1,p2,p3,Z,a0,a1,a2)),GOES_WITH(D42_BYTE_BITS,b,BITS(p0,p1,p2,p3,O,b0,b1,b2)) THEN GOES_WITH(D42_BYTE_LT,a,b);
law D42_BYTE_LT_5 := IF GOES_WITH(D42_BYTE_QUERY,a,b),GOES_WITH(D42_BYTE_BITS,a,BITS(p0,p1,p2,p3,p4,Z,a0,a1)),GOES_WITH(D42_BYTE_BITS,b,BITS(p0,p1,p2,p3,p4,O,b0,b1)) THEN GOES_WITH(D42_BYTE_LT,a,b);
law D42_BYTE_LT_6 := IF GOES_WITH(D42_BYTE_QUERY,a,b),GOES_WITH(D42_BYTE_BITS,a,BITS(p0,p1,p2,p3,p4,p5,Z,a0)),GOES_WITH(D42_BYTE_BITS,b,BITS(p0,p1,p2,p3,p4,p5,O,b0)) THEN GOES_WITH(D42_BYTE_LT,a,b);
law D42_BYTE_LT_7 := IF GOES_WITH(D42_BYTE_QUERY,a,b),GOES_WITH(D42_BYTE_BITS,a,BITS(p0,p1,p2,p3,p4,p5,p6,Z)),GOES_WITH(D42_BYTE_BITS,b,BITS(p0,p1,p2,p3,p4,p5,p6,O)) THEN GOES_WITH(D42_BYTE_LT,a,b);
law D42_TEXT_QUERY := IF GOES_WITH(D42_COMPARE,TEXT(a),TEXT(b)) THEN GOES_WITH(D42_BYTES_QUERY,a,b);
law D42_BYTES_EQ_EMPTY := IF GOES_WITH(D42_BYTES_QUERY,NIL,NIL) THEN GOES_WITH(D42_BYTES_ORDER,NIL,NIL,EQ);
law D42_BYTES_LT_EMPTY := IF GOES_WITH(D42_BYTES_QUERY,NIL,CONS(h,t)) THEN GOES_WITH(D42_BYTES_ORDER,NIL,CONS(h,t),LT);
law D42_BYTES_GT_EMPTY := IF GOES_WITH(D42_BYTES_QUERY,CONS(h,t),NIL) THEN GOES_WITH(D42_BYTES_ORDER,CONS(h,t),NIL,GT);
law D42_BYTES_RECURSE := IF GOES_WITH(D42_BYTES_QUERY,CONS(h,a),CONS(h,b)) THEN GOES_WITH(D42_BYTES_QUERY,a,b);
law D42_BYTES_SAME_HEAD := IF GOES_WITH(D42_BYTES_QUERY,CONS(h,a),CONS(h,b)),GOES_WITH(D42_BYTES_ORDER,a,b,o) THEN GOES_WITH(D42_BYTES_ORDER,CONS(h,a),CONS(h,b),o);
law D42_BYTES_LT_HEAD := IF GOES_WITH(D42_BYTES_QUERY,CONS(h,a),CONS(j,b)),GOES_WITH(D42_BYTE_LT,h,j) THEN GOES_WITH(D42_BYTES_ORDER,CONS(h,a),CONS(j,b),LT);
law D42_BYTES_GT_HEAD := IF GOES_WITH(D42_BYTES_QUERY,CONS(h,a),CONS(j,b)),GOES_WITH(D42_BYTE_LT,j,h) THEN GOES_WITH(D42_BYTES_ORDER,CONS(h,a),CONS(j,b),GT);
law D42_TEXT_ORDER := IF GOES_WITH(D42_COMPARE,TEXT(a),TEXT(b)),GOES_WITH(D42_BYTES_ORDER,a,b,o) THEN GOES_WITH(D42_ORDER,TEXT(a),TEXT(b),o);
law D42_TEXT_DIFFERENT_LT := IF GOES_WITH(D42_ORDER,a,b,LT) THEN GOES_WITH(D42_DIFFERENT,a,b);
law D42_TEXT_DIFFERENT_GT := IF GOES_WITH(D42_ORDER,a,b,GT) THEN GOES_WITH(D42_DIFFERENT,a,b);

// Exact immutable primitive subject and complete serialization domains.
law D42_IDS_ROOT := IF GOES_WITH(D42_CASE,k,r,DATA(i,c,m,b,p,t,e)) THEN GOES_WITH(D42_ROOT,k,IDS,i);
law D42_CELLS_ROOT := IF GOES_WITH(D42_CASE,k,r,DATA(i,c,m,b,p,t,e)) THEN GOES_WITH(D42_ROOT,k,CELLS,c);
law D42_MOTIFS_ROOT := IF GOES_WITH(D42_CASE,k,r,DATA(i,c,m,b,p,t,e)) THEN GOES_WITH(D42_ROOT,k,MOTIFS,m);
law D42_BLOCKS_ROOT := IF GOES_WITH(D42_CASE,k,r,DATA(i,c,m,b,p,t,e)) THEN GOES_WITH(D42_ROOT,k,BLOCKS,b);
law D42_PLACEMENTS_ROOT := IF GOES_WITH(D42_CASE,k,r,DATA(i,c,m,b,p,t,e)) THEN GOES_WITH(D42_ROOT,k,PLACEMENTS,p);
law D42_ROUTES_ROOT := IF GOES_WITH(D42_CASE,k,r,DATA(i,c,m,b,p,t,e)) THEN GOES_WITH(D42_ROOT,k,ROUTES,t);
law D42_MEMBERS_ROOT := IF GOES_WITH(D42_CASE,k,r,DATA(i,c,m,b,p,t,e)) THEN GOES_WITH(D42_ROOT,k,MEMBERS,e);
law D42_DOMAIN_ROOT := IF GOES_WITH(D42_ROOT,k,d,t) THEN GOES_WITH(D42_DOMAIN,k,d,t);
law D42_DOMAIN_LEFT := IF GOES_WITH(D42_DOMAIN,k,d,T_JOIN(a,b)) THEN GOES_WITH(D42_DOMAIN,k,d,a);
law D42_DOMAIN_RIGHT := IF GOES_WITH(D42_DOMAIN,k,d,T_JOIN(a,b)) THEN GOES_WITH(D42_DOMAIN,k,d,b);
law D42_CELL := IF GOES_WITH(D42_DOMAIN,k,CELLS,T_LEAF(CELL(i,o,w,t,c))) THEN GOES_WITH(D42_CELL,k,i,o,w,t,c);
law D42_MOTIF := IF GOES_WITH(D42_DOMAIN,k,MOTIFS,T_LEAF(MOTIF(i,m))) THEN GOES_WITH(D42_CONTAINER,k,MOTIF,i,m);
law D42_BLOCK := IF GOES_WITH(D42_DOMAIN,k,BLOCKS,T_LEAF(BLOCK(i,m))) THEN GOES_WITH(D42_CONTAINER,k,BLOCK,i,m);
law D42_PLACEMENT := IF GOES_WITH(D42_DOMAIN,k,PLACEMENTS,T_LEAF(PLACEMENT(i,l,p))) THEN GOES_WITH(D42_PLACEMENT,k,i,l,p);
law D42_ROUTE := IF GOES_WITH(D42_DOMAIN,k,ROUTES,T_LEAF(ROUTE(i,a,r,b,s))) THEN GOES_WITH(D42_ROUTE,k,i,a,r,b,s);
law D42_ROOT_OBJECT := IF GOES_WITH(D42_CASE,k,r,d) THEN GOES_WITH(D42_OBJECT,k,ROOT,r);
law D42_CELL_OBJECT := IF GOES_WITH(D42_CELL,k,i,o,w,t,c) THEN GOES_WITH(D42_OBJECT,k,CELL,i);
law D42_CONTAINER_OBJECT := IF GOES_WITH(D42_CONTAINER,k,t,i,m) THEN GOES_WITH(D42_OBJECT,k,t,i);
law D42_MEMBER_LIST := IF GOES_WITH(D42_CONTAINER,k,t,i,m) THEN GOES_WITH(D42_MEMBER_LIST,k,t,i,m);
law D42_MEMBER_LEFT := IF GOES_WITH(D42_MEMBER_LIST,k,t,i,T_JOIN(a,b)) THEN GOES_WITH(D42_MEMBER_LIST,k,t,i,a);
law D42_MEMBER_RIGHT := IF GOES_WITH(D42_MEMBER_LIST,k,t,i,T_JOIN(a,b)) THEN GOES_WITH(D42_MEMBER_LIST,k,t,i,b);
law D42_MEMBER_EDGE := IF GOES_WITH(D42_MEMBER_LIST,k,t,i,T_LEAF(c)) THEN GOES_WITH(D42_EDGE,k,c,i);
law D42_BLOCK_ROOT_EDGE := IF GOES_WITH(D42_CONTAINER,k,BLOCK,i,m),GOES_WITH(D42_CASE,k,r,d) THEN GOES_WITH(D42_EDGE,k,i,r);
law D42_ROOT_PATH := IF GOES_WITH(D42_CASE,k,r,d) THEN GOES_WITH(D42_PATH,k,r,NIL);
law D42_CHILD_PATH := IF GOES_WITH(D42_SORT_CLOSED,k,MEMBERS),GOES_WITH(D42_CONDITION,k,I,IF_THEN),GOES_WITH(D42_MEMBER_OK,k,c,p),GOES_WITH(D42_PATH,k,p,tail) THEN GOES_WITH(D42_PATH,k,c,CONS(p,tail));

// Native sorted-fold proof of uniqueness, complete over the source inventories.
law D42_ID_KEY := IF GOES_WITH(D42_DOMAIN,k,IDS,T_LEAF(OBJ(t,i))),GOES_WITH(D42_OBJECT,k,t,i) THEN GOES_WITH(D42_KEY,k,IDS,OBJ(t,i),i);
law D42_MEMBER_KEY := IF GOES_WITH(D42_DOMAIN,k,MEMBERS,T_LEAF(MEMBER(c,p))),GOES_WITH(D42_EDGE,k,c,p) THEN GOES_WITH(D42_KEY,k,MEMBERS,MEMBER(c,p),c);
law D42_PLACEMENT_KEY := IF GOES_WITH(D42_PLACEMENT,k,i,l,p) THEN GOES_WITH(D42_KEY,k,PLACEMENTS,PLACEMENT(i,l,p),i);
law D42_ROUTE_KEY := IF GOES_WITH(D42_ROUTE,k,i,a,r,b,s) THEN GOES_WITH(D42_KEY,k,ROUTES,ROUTE(i,a,r,b,s),i);
law D42_SORT_LEAF := IF GOES_WITH(D42_KEY,k,d,v,TEXT(CONS(h,t))) THEN GOES_WITH(D42_SORT,k,d,T_LEAF(v),TEXT(CONS(h,t)),TEXT(CONS(h,t)));
law D42_SORT_COMPARE := IF GOES_WITH(D42_DOMAIN,k,d,T_JOIN(a,b)),GOES_WITH(D42_SORT,k,d,a,al,ah),GOES_WITH(D42_SORT,k,d,b,bl,bh) THEN GOES_WITH(D42_COMPARE,ah,bl);
law D42_SORT_JOIN := IF GOES_WITH(D42_DOMAIN,k,d,T_JOIN(a,b)),GOES_WITH(D42_SORT,k,d,a,al,ah),GOES_WITH(D42_SORT,k,d,b,bl,bh),GOES_WITH(D42_ORDER,ah,bl,LT) THEN GOES_WITH(D42_SORT,k,d,T_JOIN(a,b),al,bh);
law D42_SORT_DUPLICATE := IF GOES_WITH(D42_DOMAIN,k,d,T_JOIN(a,b)),GOES_WITH(D42_SORT,k,d,a,al,ah),GOES_WITH(D42_SORT,k,d,b,ah,bh),GOES_WITH(D42_SORT_CONDITION,d,c) THEN GOES_WITH(D42_NO,k,c,DUPLICATE_ID(ah));
law D42_SORT_DISPLACED := IF GOES_WITH(D42_DOMAIN,k,d,T_JOIN(a,b)),GOES_WITH(D42_SORT,k,d,a,al,ah),GOES_WITH(D42_SORT,k,d,b,bl,bh),GOES_WITH(D42_ORDER,ah,bl,GT),GOES_WITH(D42_SORT_CONDITION,d,c) THEN GOES_WITH(D42_NO,k,c,UNORDERED_ID(ah,bl));
law D42_SORT_ROOT := IF GOES_WITH(D42_ROOT,k,d,t),GOES_WITH(D42_SORT,k,d,t,a,b) THEN GOES_WITH(D42_SORT_CLOSED,k,d);
law D42_SORT_EMPTY := IF GOES_WITH(D42_ROOT,k,d,T_EMPTY),GOES_WITH(D42_SORT_CONDITION,d,c) THEN GOES_WITH(D42_SORT_CLOSED,k,d);
law D42_ID_SEEN := IF GOES_WITH(D42_KEY,k,IDS,OBJ(t,i),i) THEN GOES_WITH(D42_ID_SEEN,k,t,i);
law D42_MEMBER_SEEN := IF GOES_WITH(D42_KEY,k,MEMBERS,MEMBER(c,p),c) THEN GOES_WITH(D42_MEMBER_SEEN,k,c,p);
law D42_I_CELL := IF GOES_WITH(D42_CELL,k,i,o,w,t,c),GOES_WITH(D42_ID_SEEN,k,CELL,i) THEN GOES_WITH(D42_CHECK,k,I,CELL(i,o,w,t,c));
law D42_I_MOTIF := IF GOES_WITH(D42_CONTAINER,k,MOTIF,i,m),GOES_WITH(D42_ID_SEEN,k,MOTIF,i) THEN GOES_WITH(D42_CHECK,k,I,MOTIF(i,m));
law D42_I_BLOCK := IF GOES_WITH(D42_CONTAINER,k,BLOCK,i,m),GOES_WITH(D42_ID_SEEN,k,BLOCK,i) THEN GOES_WITH(D42_CHECK,k,I,BLOCK(i,m));

// Root-terminated containment and exact LOCATION path.
law D42_MEMBER_OK := IF GOES_WITH(D42_EDGE,k,c,p),GOES_WITH(D42_OBJECT,k,ct,c),GOES_WITH(D42_OBJECT,k,pt,p),GOES_WITH(D42_MEMBER_KINDS,pt,ct),GOES_WITH(D42_MEMBER_SEEN,k,c,p) THEN GOES_WITH(D42_MEMBER_OK,k,c,p);
law D42_MEMBERS_EMPTY := IF GOES_WITH(D42_MEMBER_LIST,k,t,i,T_EMPTY) THEN GOES_WITH(D42_MEMBERS_OK,k,i,T_EMPTY);
law D42_MEMBERS_LEAF := IF GOES_WITH(D42_MEMBER_LIST,k,t,i,T_LEAF(c)),GOES_WITH(D42_MEMBER_OK,k,c,i) THEN GOES_WITH(D42_MEMBERS_OK,k,i,T_LEAF(c));
law D42_MEMBERS_JOIN := IF GOES_WITH(D42_MEMBER_LIST,k,t,i,T_JOIN(a,b)),GOES_WITH(D42_MEMBERS_OK,k,i,a),GOES_WITH(D42_MEMBERS_OK,k,i,b) THEN GOES_WITH(D42_MEMBERS_OK,k,i,T_JOIN(a,b));
law D42_II_CELL := IF GOES_WITH(D42_CELL,k,i,o,w,t,c),GOES_WITH(D42_PATH,k,i,CONS(p,r)),GOES_WITH(D42_MEMBER_OK,k,i,p) THEN GOES_WITH(D42_CHECK,k,II,CELL(i,o,w,t,c));
law D42_II_MOTIF := IF GOES_WITH(D42_CONTAINER,k,MOTIF,i,m),GOES_WITH(D42_MEMBERS_OK,k,i,m),GOES_WITH(D42_PATH,k,i,CONS(p,r)),GOES_WITH(D42_MEMBER_OK,k,i,p) THEN GOES_WITH(D42_CHECK,k,II,MOTIF(i,m));
law D42_II_BLOCK := IF GOES_WITH(D42_CONTAINER,k,BLOCK,i,m),GOES_WITH(D42_MEMBERS_OK,k,i,m),GOES_WITH(D42_PATH,k,i,CONS(p,NIL)),GOES_WITH(D42_MEMBER_OK,k,i,p) THEN GOES_WITH(D42_CHECK,k,II,BLOCK(i,m));
law D42_II_PLACEMENT := IF GOES_WITH(D42_PLACEMENT,k,i,l,p),GOES_WITH(D42_PATH,k,i,p),GOES_WITH(D42_OBJECT,k,CELL,i) THEN GOES_WITH(D42_CHECK,k,II,PLACEMENT(i,l,p));
law D42_PATH_QUERY := IF GOES_WITH(D42_PLACEMENT,k,i,l,p),GOES_WITH(D42_PATH,k,i,q) THEN GOES_WITH(D42_LIST_QUERY,p,q);
law D42_LIST_EMPTY := IF GOES_WITH(D42_LIST_QUERY,NIL,NIL) THEN GOES_WITH(D42_LIST_ORDER,NIL,NIL,EQ);
law D42_LIST_LEFT_EMPTY := IF GOES_WITH(D42_LIST_QUERY,NIL,CONS(h,t)) THEN GOES_WITH(D42_LIST_ORDER,NIL,CONS(h,t),NOT_SAME);
law D42_LIST_RIGHT_EMPTY := IF GOES_WITH(D42_LIST_QUERY,CONS(h,t),NIL) THEN GOES_WITH(D42_LIST_ORDER,CONS(h,t),NIL,NOT_SAME);
law D42_LIST_HEAD_QUERY := IF GOES_WITH(D42_LIST_QUERY,CONS(h,t),CONS(j,u)) THEN GOES_WITH(D42_COMPARE,h,j);
law D42_LIST_TAIL_QUERY := IF GOES_WITH(D42_LIST_QUERY,CONS(h,t),CONS(h,u)) THEN GOES_WITH(D42_LIST_QUERY,t,u);
law D42_LIST_SAME_HEAD := IF GOES_WITH(D42_LIST_QUERY,CONS(h,t),CONS(h,u)),GOES_WITH(D42_LIST_ORDER,t,u,o) THEN GOES_WITH(D42_LIST_ORDER,CONS(h,t),CONS(h,u),o);
law D42_LIST_DIFFERENT := IF GOES_WITH(D42_LIST_QUERY,CONS(h,t),CONS(j,u)),GOES_WITH(D42_DIFFERENT,h,j) THEN GOES_WITH(D42_LIST_ORDER,CONS(h,t),CONS(j,u),NOT_SAME);
law D42_II_BAD_PATH := IF GOES_WITH(D42_PLACEMENT,k,i,l,p),GOES_WITH(D42_PATH,k,i,q),GOES_WITH(D42_LIST_ORDER,p,q,NOT_SAME) THEN GOES_WITH(D42_NO,k,II,PATH_MISMATCH(i));

// Complete capability-set fold. Duplicate/unknown dimensions cannot close.
law D42_CAP_LIST := IF GOES_WITH(D42_CELL,k,i,o,w,t,c) THEN GOES_WITH(D42_CAP_LIST,k,i,c);
law D42_CAP_TAIL := IF GOES_WITH(D42_CAP_LIST,k,i,CONS(h,t)) THEN GOES_WITH(D42_CAP_LIST,k,i,t);
law D42_CAP_EMPTY := IF GOES_WITH(D42_CAP_LIST,k,i,NIL) THEN GOES_WITH(D42_CAP_FOLD,k,i,NIL,Z,Z,Z);
law D42_CAP_G := IF GOES_WITH(D42_CAP_LIST,k,i,CONS("□G",t)),GOES_WITH(D42_CAP_FOLD,k,i,t,Z,s,f) THEN GOES_WITH(D42_CAP_FOLD,k,i,CONS("□G",t),O,s,f);
law D42_CAP_S := IF GOES_WITH(D42_CAP_LIST,k,i,CONS("□S",t)),GOES_WITH(D42_CAP_FOLD,k,i,t,g,Z,f) THEN GOES_WITH(D42_CAP_FOLD,k,i,CONS("□S",t),g,O,f);
law D42_CAP_F := IF GOES_WITH(D42_CAP_LIST,k,i,CONS("□F",t)),GOES_WITH(D42_CAP_FOLD,k,i,t,g,s,Z) THEN GOES_WITH(D42_CAP_FOLD,k,i,CONS("□F",t),g,s,O);
law D42_CAP_PROFILE := IF GOES_WITH(D42_CELL,k,i,o,w,t,CONS(h,r)),GOES_WITH(D42_CAP_FOLD,k,i,CONS(h,r),g,s,f) THEN GOES_WITH(D42_CAP_PROFILE,k,i,g,s,f);
law D42_CAP_G_STATE := IF GOES_WITH(D42_CAP_PROFILE,k,i,g,s,f) THEN GOES_WITH(D42_CAP_STATE,k,i,"□G",g);
law D42_CAP_S_STATE := IF GOES_WITH(D42_CAP_PROFILE,k,i,g,s,f) THEN GOES_WITH(D42_CAP_STATE,k,i,"□S",s);
law D42_CAP_F_STATE := IF GOES_WITH(D42_CAP_PROFILE,k,i,g,s,f) THEN GOES_WITH(D42_CAP_STATE,k,i,"□F",f);
law D42_LOCATION_INTERIOR := IF GOES_WITH(D42_PLACEMENT,k,i,INTERIOR(d),p),GOES_WITH(D42_CAP_STATE,k,i,d,O) THEN GOES_WITH(D42_LOCATION_OK,k,i,INTERIOR(d));
law D42_LOCATION_BOUNDARY_QUERY := IF GOES_WITH(D42_PLACEMENT,k,i,BOUNDARY(a,b),p) THEN GOES_WITH(D42_COMPARE,a,b);
law D42_LOCATION_BOUNDARY := IF GOES_WITH(D42_PLACEMENT,k,i,BOUNDARY(a,b),p),GOES_WITH(D42_CAP_STATE,k,i,a,O),GOES_WITH(D42_CAP_STATE,k,i,b,O),GOES_WITH(D42_DIFFERENT,a,b) THEN GOES_WITH(D42_LOCATION_OK,k,i,BOUNDARY(a,b));
law D42_III_CELL := IF GOES_WITH(D42_CELL,k,i,o,w,t,c),GOES_WITH(D42_PLACEMENT,k,i,l,p),GOES_WITH(D42_LOCATION_OK,k,i,l) THEN GOES_WITH(D42_CHECK,k,III,CELL(i,o,w,t,c));
law D42_III_PLACEMENT := IF GOES_WITH(D42_PLACEMENT,k,i,l,p),GOES_WITH(D42_OBJECT,k,CELL,i),GOES_WITH(D42_LOCATION_OK,k,i,l) THEN GOES_WITH(D42_CHECK,k,III,PLACEMENT(i,l,p));
law D42_III_EXCLUDED := IF GOES_WITH(D42_PLACEMENT,k,i,INTERIOR(d),p),GOES_WITH(D42_CAP_STATE,k,i,d,Z) THEN GOES_WITH(D42_NO,k,III,OUTSIDE_CAPABILITY(i,d));

// Route endpoints, independently checked generic hash contact, ports and types.
law D42_IV := IF GOES_WITH(D42_ROUTE,k,i,a,r,b,s),GOES_WITH(D42_OBJECT,k,CELL,a),GOES_WITH(D42_OBJECT,k,CELL,b) THEN GOES_WITH(D42_CHECK,k,IV,ROUTE(i,a,r,b,s));
law D42_IV_NONCELL_SOURCE := IF GOES_WITH(D42_ROUTE,k,i,a,r,b,s),GOES_WITH(D42_OBJECT,k,t,a),THIS(D42_NONCELL,t) THEN GOES_WITH(D42_NO,k,IV,SOURCE_NOT_CELL(i,a));
law D42_IV_NONCELL_TARGET := IF GOES_WITH(D42_ROUTE,k,i,a,r,b,s),GOES_WITH(D42_OBJECT,k,t,b),THIS(D42_NONCELL,t) THEN GOES_WITH(D42_NO,k,IV,TARGET_NOT_CELL(i,b));
law D42_HASH_REQUEST := IF GOES_WITH(D42_ROUTE,k,i,a,r,b,s) THEN GOES_WITH(D42_HASH_REQUEST,k,CONNECTION(a,r,b,s));
law D42_HASH_BOUND := IF GOES_WITH(D42_HASH_REQUEST,k,c),GOES_WITH(D42_HASH_RESPONSE,c,h) THEN GOES_WITH(D42_HASH_BOUND,k,c,h);
law D42_V := IF GOES_WITH(D42_ROUTE,k,i,a,r,b,s),GOES_WITH(D42_HASH_BOUND,k,CONNECTION(a,r,b,s),i) THEN GOES_WITH(D42_CHECK,k,V,ROUTE(i,a,r,b,s));
law D42_HASH_COMPARE := IF GOES_WITH(D42_ROUTE,k,i,a,r,b,s),GOES_WITH(D42_HASH_BOUND,k,CONNECTION(a,r,b,s),h) THEN GOES_WITH(D42_COMPARE,i,h);
law D42_V_BAD_HASH := IF GOES_WITH(D42_ROUTE,k,i,a,r,b,s),GOES_WITH(D42_HASH_BOUND,k,CONNECTION(a,r,b,s),h),GOES_WITH(D42_DIFFERENT,i,h) THEN GOES_WITH(D42_NO,k,V,ROUTE_HASH_NOT_SAME(i,h));
law D42_VI := IF GOES_WITH(D42_ROUTE,k,i,a,"RESULT",b,s),GOES_WITH(D42_CELL,k,b,"SAME_NOT_SAME",w,t,c),THIS(D42_ROLE,s) THEN GOES_WITH(D42_CHECK,k,VI,ROUTE(i,a,"RESULT",b,s));
law D42_ROLE_QUERY := IF GOES_WITH(D42_ROUTE,k,i,a,r,b,s) THEN GOES_WITH(D42_COMPARE,r,"RESULT");
law D42_VI_BAD_SOURCE := IF GOES_WITH(D42_ROUTE,k,i,a,r,b,s),GOES_WITH(D42_DIFFERENT,r,"RESULT") THEN GOES_WITH(D42_NO,k,VI,SOURCE_NOT_RESULT(i,r));
law D42_VII_CELL := IF GOES_WITH(D42_CELL,k,i,o,w,t,c),GOES_WITH(D42_WTYPE,w,t) THEN GOES_WITH(D42_CHECK,k,VII,CELL(i,o,w,t,c));
law D42_CELL_TYPE_QUERY := IF GOES_WITH(D42_CELL,k,i,o,w,t,c),GOES_WITH(D42_WTYPE,w,e) THEN GOES_WITH(D42_COMPARE,t,e);
law D42_VII_BAD_CELL := IF GOES_WITH(D42_CELL,k,i,o,w,t,c),GOES_WITH(D42_WTYPE,w,e),GOES_WITH(D42_DIFFERENT,t,e) THEN GOES_WITH(D42_NO,k,VII,CELL_PAYLOAD_NOT_SAME(i,t,e));
law D42_ROUTE_TYPES := IF GOES_WITH(D42_ROUTE,k,i,a,r,b,s),GOES_WITH(D42_CELL,k,a,ao,aw,at,ac),GOES_WITH(D42_CELL,k,b,bo,bw,bt,bc) THEN GOES_WITH(D42_ROUTE_TYPES,k,ROUTE(i,a,r,b,s),aw,bw);
law D42_VII_ROUTE := IF GOES_WITH(D42_ROUTE_TYPES,k,r,w,w),GOES_WITH(D42_WTYPE,w,t) THEN GOES_WITH(D42_CHECK,k,VII,r);
law D42_WITNESS_QUERY := IF GOES_WITH(D42_ROUTE_TYPES,k,r,a,b) THEN GOES_WITH(D42_COMPARE,a,b);
law D42_VII_BAD_ROUTE := IF GOES_WITH(D42_ROUTE_TYPES,k,r,a,b),GOES_WITH(D42_DIFFERENT,a,b) THEN GOES_WITH(D42_NO,k,VII,WITNESS_NOT_SAME(r,a,b));

// VIII counts every incoming route for each actual target, never ingress cells.
law D42_TARGET := IF GOES_WITH(D42_ROUTE,k,i,a,r,b,s) THEN GOES_WITH(D42_TARGET,k,b);
law D42_COUNT_ROOT := IF GOES_WITH(D42_TARGET,k,t),GOES_WITH(D42_ROOT,k,ROUTES,r) THEN GOES_WITH(D42_COUNT_DOMAIN,k,t,r);
law D42_COUNT_LEFT := IF GOES_WITH(D42_COUNT_DOMAIN,k,t,T_JOIN(a,b)) THEN GOES_WITH(D42_COUNT_DOMAIN,k,t,a);
law D42_COUNT_RIGHT := IF GOES_WITH(D42_COUNT_DOMAIN,k,t,T_JOIN(a,b)) THEN GOES_WITH(D42_COUNT_DOMAIN,k,t,b);
law D42_COUNT_EMPTY := IF GOES_WITH(D42_COUNT_DOMAIN,k,t,T_EMPTY) THEN GOES_WITH(D42_COUNT,k,t,T_EMPTY,Z,Z);
law D42_COUNT_LEFT_ROLE := IF GOES_WITH(D42_COUNT_DOMAIN,k,t,T_LEAF(ROUTE(i,a,r,t,"LEFT"))) THEN GOES_WITH(D42_COUNT,k,t,T_LEAF(ROUTE(i,a,r,t,"LEFT")),S(Z),Z);
law D42_COUNT_RIGHT_ROLE := IF GOES_WITH(D42_COUNT_DOMAIN,k,t,T_LEAF(ROUTE(i,a,r,t,"RIGHT"))) THEN GOES_WITH(D42_COUNT,k,t,T_LEAF(ROUTE(i,a,r,t,"RIGHT")),Z,S(Z));
law D42_COUNT_OTHER_QUERY := IF GOES_WITH(D42_COUNT_DOMAIN,k,t,T_LEAF(ROUTE(i,a,r,b,s))) THEN GOES_WITH(D42_COMPARE,t,b);
law D42_COUNT_OTHER := IF GOES_WITH(D42_COUNT_DOMAIN,k,t,T_LEAF(ROUTE(i,a,r,b,s))),GOES_WITH(D42_DIFFERENT,t,b) THEN GOES_WITH(D42_COUNT,k,t,T_LEAF(ROUTE(i,a,r,b,s)),Z,Z);
law D42_ADD_LEFT_QUERY := IF GOES_WITH(D42_COUNT_DOMAIN,k,t,T_JOIN(a,b)),GOES_WITH(D42_COUNT,k,t,a,al,ar),GOES_WITH(D42_COUNT,k,t,b,bl,br) THEN GOES_WITH(D42_ADD_REQUEST,al,bl);
law D42_ADD_RIGHT_QUERY := IF GOES_WITH(D42_COUNT_DOMAIN,k,t,T_JOIN(a,b)),GOES_WITH(D42_COUNT,k,t,a,al,ar),GOES_WITH(D42_COUNT,k,t,b,bl,br) THEN GOES_WITH(D42_ADD_REQUEST,ar,br);
law D42_ADD_ZERO := IF GOES_WITH(D42_ADD_REQUEST,Z,b) THEN GOES_WITH(D42_ADD,Z,b,b);
law D42_ADD_RECURSE := IF GOES_WITH(D42_ADD_REQUEST,S(a),b) THEN GOES_WITH(D42_ADD_REQUEST,a,b);
law D42_ADD_NEXT := IF GOES_WITH(D42_ADD_REQUEST,S(a),b),GOES_WITH(D42_ADD,a,b,c) THEN GOES_WITH(D42_ADD,S(a),b,S(c));
law D42_COUNT_JOIN := IF GOES_WITH(D42_COUNT_DOMAIN,k,t,T_JOIN(a,b)),GOES_WITH(D42_COUNT,k,t,a,al,ar),GOES_WITH(D42_COUNT,k,t,b,bl,br),GOES_WITH(D42_ADD,al,bl,l),GOES_WITH(D42_ADD,ar,br,r) THEN GOES_WITH(D42_COUNT,k,t,T_JOIN(a,b),l,r);
law D42_TARGET_DONE := IF GOES_WITH(D42_ROOT,k,ROUTES,tree),GOES_WITH(D42_COUNT,k,t,tree,S(Z),S(Z)),GOES_WITH(D42_CELL,k,t,"SAME_NOT_SAME",w,p,c) THEN GOES_WITH(D42_TARGET_DONE,k,t);
law D42_VIII_ROUTE := IF GOES_WITH(D42_ROUTE,k,i,a,r,b,s),GOES_WITH(D42_TARGET_DONE,k,b) THEN GOES_WITH(D42_CHECK,k,VIII,ROUTE(i,a,r,b,s));
law D42_VIII_LEFT_MISSING := IF GOES_WITH(D42_ROOT,k,ROUTES,tree),GOES_WITH(D42_COUNT,k,t,tree,Z,r) THEN GOES_WITH(D42_NO,k,VIII,LEFT_ABSENT(t));
law D42_VIII_RIGHT_MISSING := IF GOES_WITH(D42_ROOT,k,ROUTES,tree),GOES_WITH(D42_COUNT,k,t,tree,l,Z) THEN GOES_WITH(D42_NO,k,VIII,RIGHT_ABSENT(t));
law D42_VIII_LEFT_MULTIPLE := IF GOES_WITH(D42_ROOT,k,ROUTES,tree),GOES_WITH(D42_COUNT,k,t,tree,S(S(n)),r) THEN GOES_WITH(D42_NO,k,VIII,LEFT_MULTIPLE(t));
law D42_VIII_RIGHT_MULTIPLE := IF GOES_WITH(D42_ROOT,k,ROUTES,tree),GOES_WITH(D42_COUNT,k,t,tree,l,S(S(n))) THEN GOES_WITH(D42_NO,k,VIII,RIGHT_MULTIPLE(t));
law D42_CELL_SCOPE := IF GOES_WITH(D42_CELL,k,i,"SAME_NOT_SAME",w,t,c),GOES_WITH(D42_WTYPE,w,e) THEN GOES_WITH(D42_CHECK,k,SCOPE,CELL(i,"SAME_NOT_SAME",w,t,c));

// Full folds and the eight native condition facts. Empty domains are explicit.
law D42_COVER_EMPTY := IF GOES_WITH(D42_DOMAIN,k,d,T_EMPTY),THIS(D42_CONDITION,c) THEN GOES_WITH(D42_COVER,k,c,d,T_EMPTY);
law D42_COVER_LEAF := IF GOES_WITH(D42_DOMAIN,k,d,T_LEAF(v)),GOES_WITH(D42_CHECK,k,c,v) THEN GOES_WITH(D42_COVER,k,c,d,T_LEAF(v));
law D42_COVER_JOIN := IF GOES_WITH(D42_DOMAIN,k,d,T_JOIN(a,b)),GOES_WITH(D42_COVER,k,c,d,a),GOES_WITH(D42_COVER,k,c,d,b) THEN GOES_WITH(D42_COVER,k,c,d,T_JOIN(a,b));
law D42_CLOSED_COVER := IF GOES_WITH(D42_ROOT,k,d,t),GOES_WITH(D42_COVER,k,c,d,t) THEN GOES_WITH(D42_CLOSED_COVER,k,c,d);
law D42_I_CLOSED := IF GOES_WITH(D42_SORT_CLOSED,k,IDS),GOES_WITH(D42_CLOSED_COVER,k,I,CELLS),GOES_WITH(D42_CLOSED_COVER,k,I,MOTIFS),GOES_WITH(D42_CLOSED_COVER,k,I,BLOCKS),GOES_WITH(D42_CASE,k,r,d),GOES_WITH(D42_ID_SEEN,k,ROOT,r) THEN GOES_WITH(D42_CONDITION,k,I,IF_THEN);
law D42_II_CLOSED := IF GOES_WITH(D42_SORT_CLOSED,k,MEMBERS),GOES_WITH(D42_CLOSED_COVER,k,II,CELLS),GOES_WITH(D42_CLOSED_COVER,k,II,MOTIFS),GOES_WITH(D42_CLOSED_COVER,k,II,BLOCKS),GOES_WITH(D42_CLOSED_COVER,k,II,PLACEMENTS) THEN GOES_WITH(D42_CONDITION,k,II,IF_THEN);
law D42_III_CLOSED := IF GOES_WITH(D42_SORT_CLOSED,k,PLACEMENTS),GOES_WITH(D42_CLOSED_COVER,k,III,CELLS),GOES_WITH(D42_CLOSED_COVER,k,III,PLACEMENTS) THEN GOES_WITH(D42_CONDITION,k,III,IF_THEN);
law D42_IV_CLOSED := IF GOES_WITH(D42_CLOSED_COVER,k,IV,ROUTES) THEN GOES_WITH(D42_CONDITION,k,IV,IF_THEN);
law D42_V_CLOSED := IF GOES_WITH(D42_SORT_CLOSED,k,ROUTES),GOES_WITH(D42_CLOSED_COVER,k,V,ROUTES) THEN GOES_WITH(D42_CONDITION,k,V,IF_THEN);
law D42_VI_CLOSED := IF GOES_WITH(D42_CLOSED_COVER,k,VI,ROUTES) THEN GOES_WITH(D42_CONDITION,k,VI,IF_THEN);
law D42_VII_CLOSED := IF GOES_WITH(D42_CLOSED_COVER,k,VII,CELLS),GOES_WITH(D42_CLOSED_COVER,k,VII,ROUTES) THEN GOES_WITH(D42_CONDITION,k,VII,IF_THEN);
law D42_VIII_CLOSED := IF GOES_WITH(D42_CLOSED_COVER,k,VIII,ROUTES) THEN GOES_WITH(D42_CONDITION,k,VIII,IF_THEN);
law D42_ALL_CONDITIONS := IF GOES_WITH(D42_CONDITION,k,I,IF_THEN),GOES_WITH(D42_CONDITION,k,II,IF_THEN),GOES_WITH(D42_CONDITION,k,III,IF_THEN),GOES_WITH(D42_CONDITION,k,IV,IF_THEN),GOES_WITH(D42_CONDITION,k,V,IF_THEN),GOES_WITH(D42_CONDITION,k,VI,IF_THEN),GOES_WITH(D42_CONDITION,k,VII,IF_THEN),GOES_WITH(D42_CONDITION,k,VIII,IF_THEN) THEN THIS(D42_ALL_CONDITIONS,k);
law D42_DRC_ADMITTED := IF THIS(D42_ALL_CONDITIONS,k),GOES_WITH(D42_CLOSED_COVER,k,SCOPE,CELLS) THEN GOES_WITH(D42_DRC,k,IF_THEN);
law D42_DRC_NO := IF GOES_WITH(D42_NO,k,c,reason) THEN GOES_WITH(D42_DRC,k,NO);
