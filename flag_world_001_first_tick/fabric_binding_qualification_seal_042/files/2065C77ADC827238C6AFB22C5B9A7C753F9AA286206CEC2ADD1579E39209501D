      if (!path.isAbsolute(o.path) || outputs.has(path.resolve(o.path)) || !o.equals || !Object.keys(o.equals).length) throw Error('OUTPUT_CONTRACT_NOT_SAME');
      outputs.add(path.resolve(o.path));
