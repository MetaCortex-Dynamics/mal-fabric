    if (!s.sources?.length || !s.sources.every(source => path.isAbsolute(source) && p.inputs.some(r => path.resolve(r.path) === path.resolve(source))) || !s.sources.some(source => s.argv.includes(source))) throw Error('ENTRY_SOURCE_NOT_BOUND');
