}
// Large readback hashes must not block either observer's liveness event loop.
function checked(op, value) {
  return new Promise((resolve, reject) => {
    const worker = new Worker(self, { workerData: { op, value } });
    let delivered = false;
    worker.on('message', msg => { delivered = true; if (msg.error) reject(Error(msg.error)); else resolve(msg.value); });
    worker.on('error', reject);
    worker.on('exit', code => { if (!delivered) reject(Error(`CUSTODY_WORKER_EXIT_WITHOUT_RESULT:${code}`)); });
  });
}
async function watch(dir) {
  const start = read(path.join(dir, 'START.json'));
  same(start.implementation);
  let last = Date.now(), finished = false, scope = 'START_BARRIER', worker = null;
  record(path.join(dir, 'OBSERVER_READY.json'), { pid: process.pid, owner: start.owner, at: now(), implementation: identity(self) });
  process.send({ type: 'ready', pid: process.pid });
  const timer = setInterval(() => {
    if (process.connected) process.send({ type: 'observer_heartbeat' });
    if (Date.now() - last > 30000 && !finished) {
      block(dir, 'SUPERVISOR_HEARTBEAT_MISSING', { scope, worker, cause: 'NOT_RECORDED' });
      process.send?.({ type: 'blocked' });
    }
  }, 1000);
  process.on('message', async msg => {
    if (msg.type === 'heartbeat') { last = Date.now(); scope = msg.scope; worker = msg.worker; }
    if (msg.type === 'finish') {
      try {
        const candidate = identity(path.join(dir, 'CANDIDATE_CLOSURE.json'));
        if (fs.existsSync(path.join(dir, 'BLOCKED.json'))) throw Error('BLOCKED_BEFORE_CLOSURE');
        await checked('candidate', read(candidate.path));
        if (fs.existsSync(path.join(dir, 'BLOCKED.json'))) throw Error('BLOCKED_DURING_CLOSURE');
        record(path.join(dir, 'OBSERVER_CLOSED.json'), { verdict: 'IF_THEN', candidate, owner: start.owner, at: now() });
        finished = true; clearInterval(timer);
        process.send({ type: 'closed' }); process.disconnect();
      } catch (e) { block(dir, e.message, { scope }); clearInterval(timer); process.disconnect(); }
    }
    if (msg.type === 'stop') { finished = true; clearInterval(timer); process.disconnect(); }
  });
