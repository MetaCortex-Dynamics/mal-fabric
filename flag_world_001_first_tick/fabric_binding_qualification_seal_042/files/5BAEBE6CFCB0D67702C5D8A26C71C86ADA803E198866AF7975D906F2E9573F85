 const actualWalls=q.predicate('SW_OLD_WALL').map(f=>{const a=q.node(f.term).c.slice(1).map(q.term);return key(...a);}).sort();equal(c.walls.map(x=>key(x.field,x.overlap)).sort(),actualWalls,'complete native old-wall relation');
