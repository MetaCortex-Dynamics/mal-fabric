}
export function catalogue(bindingPath){const b=read(bindingPath);verify(b.catalogue);verify(b.implementation);for(const r of b.inputs??[])verify(r);const c=read(b.catalogue.path);need(c.schema==='StagedFieldMaskCatalogueV13','candidate catalogue schema');need(c.fields.length===c.counts.fields&&c.supports.length===c.counts.supports,'candidate catalogue counts');return{c,b,binding:record(bindingPath)};}
