}
export function openNative(identity){verify(identity.readback);verify(identity.source_map);verify(identity.source);verify(identity.image);const q=openReadback(path.dirname(identity.readback.path));need(q.error===0,'native run error/capacity');need(sha(q.raw)===identity.readback.sha256&&q.raw.length===identity.readback.bytes,'inspected native bytes');need(q.map.source_sha256===identity.source.sha256&&q.map.image_sha256===identity.image.sha256,'native source/image subject');return q;}
export function fieldSiteCache(cachePath){
