export const need=(x,m)=>{if(!x)throw Error(m);},read=p=>JSON.parse(fs.readFileSync(p)),json=x=>JSON.stringify(x,null,2)+'\n',equal=(a,b,m)=>need(JSON.stringify(a)===JSON.stringify(b),m),key=(...a)=>JSON.stringify(a);
