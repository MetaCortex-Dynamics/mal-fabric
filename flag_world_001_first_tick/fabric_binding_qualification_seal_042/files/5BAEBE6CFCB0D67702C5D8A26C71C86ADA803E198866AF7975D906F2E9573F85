export function verify(r){need(r&&typeof r.path==='string'&&typeof r.sha256==='string','identity record');const a=record(r.path);need(a.sha256===r.sha256&&(r.bytes===undefined||a.bytes===r.bytes),'NOT_SAME '+r.path);return a;}
