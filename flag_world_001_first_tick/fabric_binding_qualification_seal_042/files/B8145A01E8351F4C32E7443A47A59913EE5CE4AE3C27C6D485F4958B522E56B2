// V9 exact transport-join factorization of V8: each nested row antecedent is first projected to an indexed flat contact.
// Requested fields/supports and all positive completeness premises are unchanged.
law SW_V9_PROJECT_FIELD_REQUEST := IF THIS(SW_ROW,FIELD_REQUEST(p0)) THEN GOES_WITH(SW_V9_TRANSPORT_FIELD_REQUEST,p0);
law SW_V9_PROJECT_CACHE_INPUT := IF THIS(SW_ROW,CACHE_INPUT(p0)) THEN GOES_WITH(SW_V9_TRANSPORT_CACHE_INPUT,p0);
law SW_V9_PROJECT_CACHE_BASE := IF THIS(SW_ROW,CACHE_BASE(p0,p1,p2)) THEN GOES_WITH(SW_V9_TRANSPORT_CACHE_BASE,p0,p1,p2);
law SW_V9_PROJECT_CACHE_BASELINE := IF THIS(SW_ROW,CACHE_BASELINE(p0,p1,p2)) THEN GOES_WITH(SW_V9_TRANSPORT_CACHE_BASELINE,p0,p1,p2);
law SW_V9_PROJECT_CACHE_CHECK := IF THIS(SW_ROW,CACHE_CHECK(p0,p1,p2,p3)) THEN GOES_WITH(SW_V9_TRANSPORT_CACHE_CHECK,p0,p1,p2,p3);
law SW_V9_PROJECT_CACHE_MEMBER := IF THIS(SW_ROW,CACHE_MEMBER(p0,p1)) THEN GOES_WITH(SW_V9_TRANSPORT_CACHE_MEMBER,p0,p1);
law SW_V9_PROJECT_CACHE_COVER_LEAF := IF THIS(SW_ROW,CACHE_COVER_LEAF(p0,p1,p2)) THEN GOES_WITH(SW_V9_TRANSPORT_CACHE_COVER_LEAF,p0,p1,p2);
law SW_V9_PROJECT_AFFECTED_COVER_LEAF := IF THIS(SW_ROW,AFFECTED_COVER_LEAF(p0,p1,p2)) THEN GOES_WITH(SW_V9_TRANSPORT_AFFECTED_COVER_LEAF,p0,p1,p2);
law SW_V9_PROJECT_FIELD_FLAG_LEAF := IF THIS(SW_ROW,FIELD_FLAG_LEAF(p0,p1)) THEN GOES_WITH(SW_V9_TRANSPORT_FIELD_FLAG_LEAF,p0,p1);
law SW_V9_PROJECT_FIELD_OVERLAP_LEAF := IF THIS(SW_ROW,FIELD_OVERLAP_LEAF(p0,p1)) THEN GOES_WITH(SW_V9_TRANSPORT_FIELD_OVERLAP_LEAF,p0,p1);
// V8 direct uniform-assignment receipts over source-owned INTERNAL/BOUNDARY contacts.
// Positive complete-field and complete-support roots gate every case; affected-overlap coverage gates receipts.
law SW_ROWS_HEAD := IF THIS(SW_ROWS,CONS(x,xs)) THEN THIS(SW_ROW,x);
law SW_ROWS_TAIL := IF THIS(SW_ROWS,CONS(x,xs)) THEN THIS(SW_ROWS,xs);
law SW_ROWS_FORK_A := IF THIS(SW_ROWS,FORK(a,b)) THEN THIS(SW_ROWS,a);
law SW_ROWS_FORK_B := IF THIS(SW_ROWS,FORK(a,b)) THEN THIS(SW_ROWS,b);
law SW_CACHED_TRIAL := IF GOES_WITH(SW_V9_TRANSPORT_FIELD_REQUEST,t), GOES_WITH(SW_V9_TRANSPORT_CACHE_INPUT,t) THEN THIS(SW_TRIAL,t);
law SW_CACHED_BASE := IF THIS(SW_TRIAL,t), GOES_WITH(SW_V9_TRANSPORT_CACHE_BASE,t,f,r) THEN GOES_WITH(SW_BASE,t,f,r);
law SW_CACHED_BASELINE := IF THIS(SW_TRIAL,t), GOES_WITH(SW_V9_TRANSPORT_CACHE_BASELINE,t,o,r) THEN GOES_WITH(SW_BASELINE,t,o,r);
law SW_CACHED_SUPPORT := IF THIS(SW_ROW,CACHE_SUPPORT(u)) THEN THIS(SW_SUPPORT,u);
law SW_CACHED_CHECK := IF THIS(SW_SUPPORT,u), GOES_WITH(SW_V9_TRANSPORT_CACHE_CHECK,u,o,a,b) THEN GOES_WITH(SW_SUPPORT_CHECK,u,o,a,b);
law SW_REQUEST := IF THIS(SW_ROW,OFFER_REQUEST(t,u,r)) THEN GOES_WITH(SW_REQUEST,t,u,r);
law SW_OLD_WALL := IF GOES_WITH(SW_BASELINE,t,o,NOT_SAME) THEN GOES_WITH(SW_OLD_WALL,t,o);
law SW_OPENED := IF GOES_WITH(SW_AFTER,t,u,r,o,SAME,NOT_SAME) THEN GOES_WITH(SW_OPENED,t,u,r,o);
law SW_DISCHARGED := IF GOES_WITH(SW_AFTER,t,u,r,o,NOT_SAME,SAME) THEN GOES_WITH(SW_DISCHARGED,t,u,r,o);
law SW_NO_OPEN_SAME := IF GOES_WITH(SW_AFTER,t,u,r,o,old,SAME) THEN GOES_WITH(SW_NO_OPEN,t,u,r,o);
law SW_NO_OPEN_RETAINED := IF GOES_WITH(SW_AFTER,t,u,r,o,NOT_SAME,NOT_SAME) THEN GOES_WITH(SW_NO_OPEN,t,u,r,o);
law SW_NO_DISCHARGE_SAME := IF GOES_WITH(SW_AFTER,t,u,r,o,SAME,next) THEN GOES_WITH(SW_NO_DISCHARGE,t,u,r,o);
law SW_NO_DISCHARGE_RETAINED := IF GOES_WITH(SW_AFTER,t,u,r,o,NOT_SAME,NOT_SAME) THEN GOES_WITH(SW_NO_DISCHARGE,t,u,r,o);
law SW_STRICT := IF GOES_WITH(SW_COMPLETE,t,u,r), GOES_WITH(SW_EMPTY_OPEN,t,u,r), GOES_WITH(SW_DISCHARGED,t,u,r,o) THEN GOES_WITH(SW_STRICT,t,u,r);
law SW_EXCLUDED_OPEN := IF GOES_WITH(SW_COMPLETE,t,u,r), GOES_WITH(SW_OPENED,t,u,r,o) THEN GOES_WITH(SW_EXCLUDED_OPEN,t,u,r);
law SW_EXCLUDED_EMPTY := IF GOES_WITH(SW_COMPLETE,t,u,r), GOES_WITH(SW_EMPTY_DISCHARGE,t,u,r) THEN GOES_WITH(SW_EXCLUDED_EMPTY,t,u,r);
law SW_RECEIPT := IF GOES_WITH(SW_COMPLETE,t,u,r) THEN GOES_WITH(SW_RECEIPT,t,u,r,RECEIPT(DISCHARGED_SET(t,u,r),OPENED_SET(t,u,r),RESIDUAL(OLD_WALL_SET(t),DISCHARGED_SET(t,u,r))));

law SW_CACHED_FLAG := IF THIS(SW_ROW,CACHE_FLAG(f,s,e,v)) THEN GOES_WITH(SW_FLAG,f,s,e,v);
law SW_CACHED_OVERLAP := IF THIS(SW_ROW,CACHE_OVERLAP(o,a,b,k)) THEN GOES_WITH(SW_OVERLAP,o,a,b,k);
law SW_CACHED_INTERNAL := IF THIS(SW_ROW,CACHE_INTERNAL(u,o)) THEN GOES_WITH(SW_SUPPORT_INTERNAL,u,o);
law SW_CACHED_BOUNDARY := IF THIS(SW_ROW,CACHE_BOUNDARY(u,o,f)) THEN GOES_WITH(SW_SUPPORT_BOUNDARY,u,o,f);
// A retained source total records lineage, but transported contacts must rebuild their own total.
law SW_CACHED_SOURCE_SUPPORT_TOTAL := IF THIS(SW_ROW,CACHE_SUPPORT_TOTAL(u)) THEN GOES_WITH(SW_SOURCE_SUPPORT_TOTAL,u);
law SW_CACHED_MEMBER := IF THIS(SW_SUPPORT,u), GOES_WITH(SW_V9_TRANSPORT_CACHE_MEMBER,u,f) THEN GOES_WITH(SW_MEMBER,u,f);
law SW_CACHED_INCIDENT := IF THIS(SW_ROW,CACHE_INCIDENT(f,k,o)) THEN GOES_WITH(SW_INCIDENT,f,k,o);
law SW_CACHED_CLEAF := IF GOES_WITH(SW_V9_TRANSPORT_CACHE_COVER_LEAF,u,n,f), GOES_WITH(SW_MEMBER,u,f) THEN GOES_WITH(SW_COVER_LEAF,u,n,f);
law SW_CACHED_CJOIN := IF THIS(SW_ROW,CACHE_COVER_JOIN(u,n,a,b)) THEN GOES_WITH(SW_COVER_JOIN,u,n,a,b);
law SW_CACHED_CROOT := IF THIS(SW_ROW,CACHE_COVER_ROOT(u,n)) THEN GOES_WITH(SW_COVER_ROOT,u,n);
law SW_SUPPORT_CLASSIFIED_INTERNAL := IF GOES_WITH(SW_SUPPORT_CHECK,u,o,a,b), GOES_WITH(SW_SUPPORT_INTERNAL,u,o), GOES_WITH(SW_MEMBER,u,a), GOES_WITH(SW_MEMBER,u,b) THEN GOES_WITH(SW_SUPPORT_CLASSIFIED,u,o);
law SW_SUPPORT_CLASSIFIED_BOUNDARY_A := IF GOES_WITH(SW_SUPPORT_CHECK,u,o,a,b), GOES_WITH(SW_SUPPORT_BOUNDARY,u,o,a), GOES_WITH(SW_MEMBER,u,b) THEN GOES_WITH(SW_SUPPORT_CLASSIFIED,u,o);
law SW_SUPPORT_CLASSIFIED_BOUNDARY_B := IF GOES_WITH(SW_SUPPORT_CHECK,u,o,a,b), GOES_WITH(SW_SUPPORT_BOUNDARY,u,o,b), GOES_WITH(SW_MEMBER,u,a) THEN GOES_WITH(SW_SUPPORT_CLASSIFIED,u,o);
law SW_SUPPORT_MEMBER_KIND := IF GOES_WITH(SW_MEMBER,u,f), GOES_WITH(SW_INCIDENT,f,k,o), GOES_WITH(SW_SUPPORT_CLASSIFIED,u,o) THEN GOES_WITH(SW_SUPPORT_MEMBER_KIND,u,f,k);
law SW_SUPPORT_MEMBER_TOTAL := IF GOES_WITH(SW_SUPPORT_MEMBER_KIND,u,f,DELTA), GOES_WITH(SW_SUPPORT_MEMBER_KIND,u,f,GAMMA), GOES_WITH(SW_SUPPORT_MEMBER_KIND,u,f,TAU) THEN GOES_WITH(SW_SUPPORT_MEMBER_TOTAL,u,f);
law SW_SUPPORT_TOTAL_LEAF := IF GOES_WITH(SW_COVER_LEAF,u,n,f), GOES_WITH(SW_SUPPORT_MEMBER_TOTAL,u,f) THEN GOES_WITH(SW_SUPPORT_TOTAL_TREE,u,n);
law SW_SUPPORT_TOTAL_JOIN := IF GOES_WITH(SW_COVER_JOIN,u,n,a,b), GOES_WITH(SW_SUPPORT_TOTAL_TREE,u,a), GOES_WITH(SW_SUPPORT_TOTAL_TREE,u,b) THEN GOES_WITH(SW_SUPPORT_TOTAL_TREE,u,n);
law SW_SUPPORT_TOTAL_ROOT := IF GOES_WITH(SW_SOURCE_SUPPORT_TOTAL,u), GOES_WITH(SW_COVER_ROOT,u,n), GOES_WITH(SW_SUPPORT_TOTAL_TREE,u,n) THEN GOES_WITH(SW_SUPPORT_TOTAL,u);
law SW_CASE_THIS := IF GOES_WITH(SW_REQUEST,t,u,READING_THIS), THIS(SW_TRIAL,t), THIS(SW_FIELD_TOTAL,t), THIS(SW_SUPPORT,u), GOES_WITH(SW_SUPPORT_TOTAL,u) THEN GOES_WITH(SW_CASE,t,u,READING_THIS);
law SW_CASE_NO := IF GOES_WITH(SW_REQUEST,t,u,READING_NO), THIS(SW_TRIAL,t), THIS(SW_FIELD_TOTAL,t), THIS(SW_SUPPORT,u), GOES_WITH(SW_SUPPORT_TOTAL,u) THEN GOES_WITH(SW_CASE,t,u,READING_NO);
law SW_AFTER_INTERNAL := IF GOES_WITH(SW_CASE,t,u,r), GOES_WITH(SW_SUPPORT_INTERNAL,u,o), GOES_WITH(SW_BASELINE,t,o,old) THEN GOES_WITH(SW_AFTER,t,u,r,o,old,SAME);
law SW_AFTER_BOUNDARY_SAME := IF GOES_WITH(SW_CASE,t,u,r), GOES_WITH(SW_SUPPORT_BOUNDARY,u,o,f), GOES_WITH(SW_BASE,t,f,r), GOES_WITH(SW_BASELINE,t,o,old) THEN GOES_WITH(SW_AFTER,t,u,r,o,old,SAME);
law SW_AFTER_BOUNDARY_DIFF_A := IF GOES_WITH(SW_CASE,t,u,READING_THIS), GOES_WITH(SW_SUPPORT_BOUNDARY,u,o,f), GOES_WITH(SW_BASE,t,f,READING_NO), GOES_WITH(SW_BASELINE,t,o,old) THEN GOES_WITH(SW_AFTER,t,u,READING_THIS,o,old,NOT_SAME);
law SW_AFTER_BOUNDARY_DIFF_B := IF GOES_WITH(SW_CASE,t,u,READING_NO), GOES_WITH(SW_SUPPORT_BOUNDARY,u,o,f), GOES_WITH(SW_BASE,t,f,READING_THIS), GOES_WITH(SW_BASELINE,t,o,old) THEN GOES_WITH(SW_AFTER,t,u,READING_NO,o,old,NOT_SAME);
law SW_AFFECTED_CLEAF := IF GOES_WITH(SW_V9_TRANSPORT_AFFECTED_COVER_LEAF,u,n,o), GOES_WITH(SW_SUPPORT_CHECK,u,o,a,b) THEN GOES_WITH(SW_AFFECTED_COVER_LEAF,u,n,o);
law SW_AFFECTED_CJOIN := IF THIS(SW_ROW,AFFECTED_COVER_JOIN(u,n,a,b)) THEN GOES_WITH(SW_AFFECTED_COVER_JOIN,u,n,a,b);
law SW_AFFECTED_CROOT := IF THIS(SW_ROW,AFFECTED_COVER_ROOT(u,n)) THEN GOES_WITH(SW_AFFECTED_COVER_ROOT,u,n);
law SW_COMPLETE_LEAF := IF GOES_WITH(SW_AFFECTED_COVER_LEAF,u,n,o), GOES_WITH(SW_AFTER,t,u,r,o,old,next) THEN GOES_WITH(SW_COMPLETE_TREE,t,u,r,n);
law SW_COMPLETE_JOIN := IF GOES_WITH(SW_AFFECTED_COVER_JOIN,u,n,a,b), GOES_WITH(SW_COMPLETE_TREE,t,u,r,a), GOES_WITH(SW_COMPLETE_TREE,t,u,r,b) THEN GOES_WITH(SW_COMPLETE_TREE,t,u,r,n);
law SW_COMPLETE_ROOT := IF GOES_WITH(SW_AFFECTED_COVER_ROOT,u,n), GOES_WITH(SW_COMPLETE_TREE,t,u,r,n) THEN GOES_WITH(SW_COMPLETE,t,u,r);
law SW_EMPTY_OPEN_LEAF := IF GOES_WITH(SW_AFFECTED_COVER_LEAF,u,n,o), GOES_WITH(SW_NO_OPEN,t,u,r,o) THEN GOES_WITH(SW_EMPTY_OPEN_TREE,t,u,r,n);
law SW_EMPTY_OPEN_JOIN := IF GOES_WITH(SW_AFFECTED_COVER_JOIN,u,n,a,b), GOES_WITH(SW_EMPTY_OPEN_TREE,t,u,r,a), GOES_WITH(SW_EMPTY_OPEN_TREE,t,u,r,b) THEN GOES_WITH(SW_EMPTY_OPEN_TREE,t,u,r,n);
law SW_EMPTY_OPEN_ROOT := IF GOES_WITH(SW_AFFECTED_COVER_ROOT,u,n), GOES_WITH(SW_EMPTY_OPEN_TREE,t,u,r,n) THEN GOES_WITH(SW_EMPTY_OPEN,t,u,r);
law SW_EMPTY_DISCHARGE_LEAF := IF GOES_WITH(SW_AFFECTED_COVER_LEAF,u,n,o), GOES_WITH(SW_NO_DISCHARGE,t,u,r,o) THEN GOES_WITH(SW_EMPTY_DISCHARGE_TREE,t,u,r,n);
law SW_EMPTY_DISCHARGE_JOIN := IF GOES_WITH(SW_AFFECTED_COVER_JOIN,u,n,a,b), GOES_WITH(SW_EMPTY_DISCHARGE_TREE,t,u,r,a), GOES_WITH(SW_EMPTY_DISCHARGE_TREE,t,u,r,b) THEN GOES_WITH(SW_EMPTY_DISCHARGE_TREE,t,u,r,n);
law SW_EMPTY_DISCHARGE_ROOT := IF GOES_WITH(SW_AFFECTED_COVER_ROOT,u,n), GOES_WITH(SW_EMPTY_DISCHARGE_TREE,t,u,r,n) THEN GOES_WITH(SW_EMPTY_DISCHARGE,t,u,r);
law CF_FLAG_LEAF := IF GOES_WITH(SW_V9_TRANSPORT_FIELD_FLAG_LEAF,n,f), GOES_WITH(SW_FLAG,f,s,e,v) THEN GOES_WITH(CF_FLAG_LEAF,n,f);
law CF_FLAG_JOIN := IF THIS(SW_ROW,FIELD_FLAG_JOIN(n,a,b)) THEN GOES_WITH(CF_FLAG_JOIN,n,a,b);
law CF_FLAG_ROOT := IF THIS(SW_ROW,FIELD_FLAG_ROOT(n)) THEN GOES_WITH(CF_FLAG_ROOT,n);
law CF_FLAG_SEEN := IF THIS(SW_TRIAL,t), GOES_WITH(CF_FLAG_LEAF,n,f), GOES_WITH(SW_BASE,t,f,r) THEN GOES_WITH(CF_FLAG_COVER,t,n);
law CF_FLAG_JOINED := IF GOES_WITH(CF_FLAG_JOIN,n,a,b), GOES_WITH(CF_FLAG_COVER,t,a), GOES_WITH(CF_FLAG_COVER,t,b) THEN GOES_WITH(CF_FLAG_COVER,t,n);
law CF_FLAG_TOTAL := IF GOES_WITH(CF_FLAG_ROOT,n), GOES_WITH(CF_FLAG_COVER,t,n) THEN THIS(SW_FIELD_BASE_TOTAL,t);
law CF_OVERLAP_LEAF := IF GOES_WITH(SW_V9_TRANSPORT_FIELD_OVERLAP_LEAF,n,o), GOES_WITH(SW_OVERLAP,o,a,b,k) THEN GOES_WITH(CF_OVERLAP_LEAF,n,o);
law CF_OVERLAP_JOIN := IF THIS(SW_ROW,FIELD_OVERLAP_JOIN(n,a,b)) THEN GOES_WITH(CF_OVERLAP_JOIN,n,a,b);
law CF_OVERLAP_ROOT := IF THIS(SW_ROW,FIELD_OVERLAP_ROOT(n)) THEN GOES_WITH(CF_OVERLAP_ROOT,n);
law CF_OVERLAP_SEEN := IF THIS(SW_TRIAL,t), GOES_WITH(CF_OVERLAP_LEAF,n,o), GOES_WITH(SW_BASELINE,t,o,r) THEN GOES_WITH(CF_OVERLAP_COVER,t,n);
law CF_OVERLAP_JOINED := IF GOES_WITH(CF_OVERLAP_JOIN,n,a,b), GOES_WITH(CF_OVERLAP_COVER,t,a), GOES_WITH(CF_OVERLAP_COVER,t,b) THEN GOES_WITH(CF_OVERLAP_COVER,t,n);
law CF_OVERLAP_TOTAL := IF GOES_WITH(CF_OVERLAP_ROOT,n), GOES_WITH(CF_OVERLAP_COVER,t,n) THEN THIS(SW_FIELD_BASELINE_TOTAL,t);
law CF_TOTAL := IF THIS(SW_TRIAL,t), THIS(SW_FIELD_BASE_TOTAL,t), THIS(SW_FIELD_BASELINE_TOTAL,t) THEN THIS(SW_FIELD_TOTAL,t);



// Additive retained-inventory realization. Imported support/input facts
// carry the full native inventory readback identity and coverage custody.
// Positive opaque identifier distinction; all nibble distinctions are frozen finite transport algebra.
law SW_NDIFF_IMPORT := IF THIS(SW_ROW,NDIFF(a,b)) THEN GOES_WITH(SW_NDIFF,a,b);
law SW_NBEFORE_IMPORT := IF THIS(SW_ROW,NBEFORE(a,b)) THEN GOES_WITH(SW_NBEFORE,a,b);
law SW_DIFF_0 := IF GOES_WITH(SW_DIFF_REQUEST,ID(a,b,c,d,e,f),ID(g,h,i,j,k,l)), GOES_WITH(SW_NDIFF,a,g) THEN GOES_WITH(SW_DIFF,ID(a,b,c,d,e,f),ID(g,h,i,j,k,l));
law SW_DIFF_1 := IF GOES_WITH(SW_DIFF_REQUEST,ID(a,b,c,d,e,f),ID(g,h,i,j,k,l)), GOES_WITH(SW_NDIFF,b,h) THEN GOES_WITH(SW_DIFF,ID(a,b,c,d,e,f),ID(g,h,i,j,k,l));
law SW_DIFF_2 := IF GOES_WITH(SW_DIFF_REQUEST,ID(a,b,c,d,e,f),ID(g,h,i,j,k,l)), GOES_WITH(SW_NDIFF,c,i) THEN GOES_WITH(SW_DIFF,ID(a,b,c,d,e,f),ID(g,h,i,j,k,l));
law SW_DIFF_3 := IF GOES_WITH(SW_DIFF_REQUEST,ID(a,b,c,d,e,f),ID(g,h,i,j,k,l)), GOES_WITH(SW_NDIFF,d,j) THEN GOES_WITH(SW_DIFF,ID(a,b,c,d,e,f),ID(g,h,i,j,k,l));
law SW_DIFF_4 := IF GOES_WITH(SW_DIFF_REQUEST,ID(a,b,c,d,e,f),ID(g,h,i,j,k,l)), GOES_WITH(SW_NDIFF,e,k) THEN GOES_WITH(SW_DIFF,ID(a,b,c,d,e,f),ID(g,h,i,j,k,l));
law SW_DIFF_5 := IF GOES_WITH(SW_DIFF_REQUEST,ID(a,b,c,d,e,f),ID(g,h,i,j,k,l)), GOES_WITH(SW_NDIFF,f,l) THEN GOES_WITH(SW_DIFF,ID(a,b,c,d,e,f),ID(g,h,i,j,k,l));

law W38_BASELINE_SAME := IF GOES_WITH(SW_OVERLAP,o,a,b,k), GOES_WITH(SW_BASE,t,a,r), GOES_WITH(SW_BASE,t,b,r) THEN GOES_WITH(SW_BASELINE,t,o,SAME);
law W38_BASELINE_DIFF_A := IF GOES_WITH(SW_OVERLAP,o,a,b,k), GOES_WITH(SW_BASE,t,a,READING_THIS), GOES_WITH(SW_BASE,t,b,READING_NO) THEN GOES_WITH(SW_BASELINE,t,o,NOT_SAME);
law W38_BASELINE_DIFF_B := IF GOES_WITH(SW_OVERLAP,o,a,b,k), GOES_WITH(SW_BASE,t,a,READING_NO), GOES_WITH(SW_BASE,t,b,READING_THIS) THEN GOES_WITH(SW_BASELINE,t,o,NOT_SAME);
law W38_RETURN_IMPORT := IF THIS(SW_ROW,RETURNED_FLAG(t,l,f,r)), THIS(SW_TRIAL,t) THEN GOES_WITH(SW_BASE,t,f,r);
law W38_A_CASE_LEAF := IF THIS(SW_ROW,A38_OFFER_LEAF(t,n,u,r)), GOES_WITH(SW_COMPLETE,t,u,r) THEN GOES_WITH(A38_OFFER_COVER,t,n);
law W38_A_CASE_JOIN := IF THIS(SW_ROW,A38_OFFER_JOIN(t,n,a,b)), GOES_WITH(A38_OFFER_COVER,t,a), GOES_WITH(A38_OFFER_COVER,t,b) THEN GOES_WITH(A38_OFFER_COVER,t,n);
law W38_A_CASE_ROOT := IF THIS(SW_ROW,A38_OFFER_ROOT(t,n)), GOES_WITH(A38_OFFER_COVER,t,n) THEN THIS(A38_COMPLETE,t);
// Native prior-snapshot wave realization of promoted amendment 037.
// Scope custody pins the bound levels 1/2/4 and complete offered inventories.
// Stage B consumes EVERY raw K member from a closed native Stage-A readback.
// W38_ORIGIN_CLOSED carries that readback identity; its exact K-domain transport
// is checked by the package observer before launch and again at closure.
// Neither this source nor the transport chooses an effect representative.
// Dependencies: unchanged receipts_cached_v9.mal and identity_retained_v2.mal.
// All CF flag/overlap trees and site/K trees cover their complete bound domains.
// A missing leaf, reading, contact, K member or root withholds W38_WAVE_READY.

@propose seed W38_CARRIER_READINGS := {
  THIS(W38_READING,READING_THIS), THIS(W38_READING,READING_NO)
};

// Import complete, source-bound domains. These constructors are transport only.
law W38_ORIGIN_IMPORT := IF THIS(SW_ROW,W38_ORIGIN_CLOSED(t,h)) THEN GOES_WITH(W38_ORIGIN_CLOSED,t,h);
law W38_MEMBER_IMPORT := IF THIS(SW_ROW,W38_MEMBER_K(t,m,u,r)), GOES_WITH(W38_ORIGIN_CLOSED,t,h), THIS(W38_READING,r) THEN GOES_WITH(W38_MEMBER,t,m,u,r);
law W38_K_LEAF_IMPORT := IF THIS(SW_ROW,W38_K_LEAF(t,n,m)), GOES_WITH(W38_MEMBER,t,m,u,r) THEN GOES_WITH(W38_K_LEAF,t,n,m);
law W38_K_JOIN_IMPORT := IF THIS(SW_ROW,W38_K_JOIN(t,n,a,b)) THEN GOES_WITH(W38_K_JOIN,t,n,a,b);
law W38_K_ROOT_IMPORT := IF THIS(SW_ROW,W38_K_ROOT(t,n)) THEN GOES_WITH(W38_K_ROOT,t,n);
law W38_K_EMPTY_IMPORT := IF THIS(SW_ROW,W38_K_EMPTY(t)), GOES_WITH(W38_ORIGIN_CLOSED,t,h) THEN THIS(W38_K_EMPTY,t);
law W38_SITE_LEAF_IMPORT := IF THIS(SW_ROW,W38_SITE_LEAF(n,s)), GOES_WITH(SW_FLAG,f,s,e,v) THEN GOES_WITH(W38_SITE_LEAF,n,s);
law W38_SITE_JOIN_IMPORT := IF THIS(SW_ROW,W38_SITE_JOIN(n,a,b)) THEN GOES_WITH(W38_SITE_JOIN,n,a,b);
law W38_SITE_ROOT_IMPORT := IF THIS(SW_ROW,W38_SITE_ROOT(n)) THEN GOES_WITH(W38_SITE_ROOT,n);
law W38_ANCESTOR_SITE_IMPORT := IF THIS(SW_ROW,ANCESTOR_SITE(l,p,s)) THEN GOES_WITH(SW_ANCESTOR_SITE,l,p,s);
law W38_ANCESTOR_TRIAD_IMPORT := IF THIS(SW_ROW,ANCESTOR_TRIAD(l,p,v)) THEN GOES_WITH(SW_ANCESTOR_TRIAD_PART,l,p,v);
law W38_SITE_IMPORT := IF GOES_WITH(SW_FLAG,f,s,e,v) THEN THIS(SW_SITE,s);

// Whole-site scope: every flag of each site has ONE same reading.
law W38_SITE_READING_LEAF := IF GOES_WITH(SW_COVER_LEAF,SITE(s),n,f), GOES_WITH(SW_FLAG,f,s,e,v), GOES_WITH(SW_BASE,t,f,r), THIS(W38_READING,r) THEN GOES_WITH(W38_SITE_READING_TREE,t,s,r,n);
law W38_SITE_READING_JOIN := IF GOES_WITH(SW_COVER_JOIN,SITE(s),n,a,b), GOES_WITH(W38_SITE_READING_TREE,t,s,r,a), GOES_WITH(W38_SITE_READING_TREE,t,s,r,b) THEN GOES_WITH(W38_SITE_READING_TREE,t,s,r,n);
law W38_SITE_READING_ROOT := IF GOES_WITH(SW_COVER_ROOT,SITE(s),n), GOES_WITH(W38_SITE_READING_TREE,t,s,r,n) THEN GOES_WITH(W38_SITE_READING,t,s,r);
law W38_WHOLE_SITE_LEAF := IF GOES_WITH(W38_SITE_LEAF,n,s), GOES_WITH(W38_SITE_READING,t,s,r) THEN GOES_WITH(W38_WHOLE_SITE_TREE,t,n);
law W38_WHOLE_SITE_JOIN := IF GOES_WITH(W38_SITE_JOIN,n,a,b), GOES_WITH(W38_WHOLE_SITE_TREE,t,a), GOES_WITH(W38_WHOLE_SITE_TREE,t,b) THEN GOES_WITH(W38_WHOLE_SITE_TREE,t,n);
law W38_WHOLE_SITE_ROOT := IF GOES_WITH(W38_SITE_ROOT,n), GOES_WITH(W38_WHOLE_SITE_TREE,t,n) THEN THIS(W38_WHOLE_SITE,t);
law W38_SPLIT_SITE := IF GOES_WITH(SW_FLAG,f,s,e,v), GOES_WITH(SW_FLAG,g,s,j,w), GOES_WITH(SW_BASE,t,f,READING_THIS), GOES_WITH(SW_BASE,t,g,READING_NO) THEN GOES_WITH(W38_SCOPE_REFUSAL,t,SPLIT_SITE(s,f,g));

// Closed carrier scope: each flag carries all three incidence contacts.
law W38_CLOSED_FLAG := IF GOES_WITH(SW_FLAG,f,s,e,v), GOES_WITH(SW_INCIDENT,f,DELTA,d), GOES_WITH(SW_INCIDENT,f,GAMMA,g), GOES_WITH(SW_INCIDENT,f,TAU,a) THEN THIS(W38_CLOSED_FLAG,f);
law W38_CLOSED_LEAF := IF GOES_WITH(CF_FLAG_LEAF,n,f), THIS(W38_CLOSED_FLAG,f) THEN THIS(W38_CLOSED_TREE,n);
law W38_CLOSED_JOIN := IF GOES_WITH(CF_FLAG_JOIN,n,a,b), THIS(W38_CLOSED_TREE,a), THIS(W38_CLOSED_TREE,b) THEN THIS(W38_CLOSED_TREE,n);
law W38_CLOSED_ROOT := IF GOES_WITH(CF_FLAG_ROOT,n), THIS(W38_CLOSED_TREE,n) THEN THIS(W38_CLOSED_CARRIER);
law W38_SNAPSHOT_READY := IF THIS(SW_FIELD_TOTAL,t), THIS(W38_WHOLE_SITE,t), THIS(W38_CLOSED_CARRIER), GOES_WITH(W38_ORIGIN_CLOSED,t,h) THEN THIS(W38_SNAPSHOT_READY,t);

// Optional named open-carrier diagnostic. The requested missing slot is NOT a
// supplied absence verdict: native coverage proves no overlap occupies it.
law W38_MISSING_KIND_REQUEST := IF THIS(SW_ROW,W38_CHECK_MISSING_KIND(f,k)), GOES_WITH(SW_FLAG,f,s,e,v) THEN GOES_WITH(W38_CHECK_MISSING_KIND,f,k);
law W38_KIND_DG := IF GOES_WITH(W38_CHECK_MISSING_KIND,f,DELTA), GOES_WITH(SW_OVERLAP,o,a,b,GAMMA) THEN GOES_WITH(W38_NOT_INCIDENT,f,DELTA,o);
law W38_KIND_DT := IF GOES_WITH(W38_CHECK_MISSING_KIND,f,DELTA), GOES_WITH(SW_OVERLAP,o,a,b,TAU) THEN GOES_WITH(W38_NOT_INCIDENT,f,DELTA,o);
law W38_KIND_GD := IF GOES_WITH(W38_CHECK_MISSING_KIND,f,GAMMA), GOES_WITH(SW_OVERLAP,o,a,b,DELTA) THEN GOES_WITH(W38_NOT_INCIDENT,f,GAMMA,o);
law W38_KIND_GT := IF GOES_WITH(W38_CHECK_MISSING_KIND,f,GAMMA), GOES_WITH(SW_OVERLAP,o,a,b,TAU) THEN GOES_WITH(W38_NOT_INCIDENT,f,GAMMA,o);
law W38_KIND_TD := IF GOES_WITH(W38_CHECK_MISSING_KIND,f,TAU), GOES_WITH(SW_OVERLAP,o,a,b,DELTA) THEN GOES_WITH(W38_NOT_INCIDENT,f,TAU,o);
law W38_KIND_TG := IF GOES_WITH(W38_CHECK_MISSING_KIND,f,TAU), GOES_WITH(SW_OVERLAP,o,a,b,GAMMA) THEN GOES_WITH(W38_NOT_INCIDENT,f,TAU,o);
law W38_MISSING_COMPARE_A := IF GOES_WITH(W38_CHECK_MISSING_KIND,f,k), GOES_WITH(SW_OVERLAP,o,a,b,k) THEN GOES_WITH(SW_DIFF_REQUEST,f,a);
law W38_MISSING_COMPARE_B := IF GOES_WITH(W38_CHECK_MISSING_KIND,f,k), GOES_WITH(SW_OVERLAP,o,a,b,k) THEN GOES_WITH(SW_DIFF_REQUEST,f,b);
law W38_MISSING_OTHER_ENDPOINTS := IF GOES_WITH(W38_CHECK_MISSING_KIND,f,k), GOES_WITH(SW_OVERLAP,o,a,b,k), GOES_WITH(SW_DIFF,f,a), GOES_WITH(SW_DIFF,f,b) THEN GOES_WITH(W38_NOT_INCIDENT,f,k,o);
law W38_MISSING_KIND_LEAF := IF GOES_WITH(CF_OVERLAP_LEAF,n,o), GOES_WITH(W38_NOT_INCIDENT,f,k,o) THEN GOES_WITH(W38_MISSING_KIND_TREE,f,k,n);
law W38_MISSING_KIND_JOIN := IF GOES_WITH(CF_OVERLAP_JOIN,n,a,b), GOES_WITH(W38_MISSING_KIND_TREE,f,k,a), GOES_WITH(W38_MISSING_KIND_TREE,f,k,b) THEN GOES_WITH(W38_MISSING_KIND_TREE,f,k,n);
law W38_MISSING_KIND_ROOT := IF GOES_WITH(CF_OVERLAP_ROOT,n), GOES_WITH(W38_MISSING_KIND_TREE,f,k,n), THIS(SW_TRIAL,t) THEN GOES_WITH(W38_SCOPE_REFUSAL,t,OPEN_CARRIER(f,k));

// Native K supports that can contain a whole site on the bound scope.
// Every transported K member must discharge this type and its full effect.
law W38_SUPPORT_SITE := IF GOES_WITH(W38_MEMBER,t,m,SITE(s),r), THIS(SW_SITE,s) THEN GOES_WITH(W38_TYPED_MEMBER,t,m,SITE(s),r);
law W38_SUPPORT_A_SITE := IF GOES_WITH(W38_MEMBER,t,m,A_SITE(l,p),r), GOES_WITH(SW_ANCESTOR_SITE,l,p,s) THEN GOES_WITH(W38_TYPED_MEMBER,t,m,A_SITE(l,p),r);
law W38_SUPPORT_A_TRIAD := IF GOES_WITH(W38_MEMBER,t,m,A_TRIAD(l,p),r), GOES_WITH(SW_ANCESTOR_TRIAD_PART,l,p,v) THEN GOES_WITH(W38_TYPED_MEMBER,t,m,A_TRIAD(l,p),r);
law W38_SUPPORT_EDGE_REFUSAL := IF GOES_WITH(W38_MEMBER,t,m,EDGE(e),r) THEN GOES_WITH(W38_SCOPE_REFUSAL,t,K_MEMBER_OUTSIDE_WHOLE_SITE_SCOPE(m,EDGE(e)));
law W38_SUPPORT_TRIAD_REFUSAL := IF GOES_WITH(W38_MEMBER,t,m,TRIAD(v),r) THEN GOES_WITH(W38_SCOPE_REFUSAL,t,K_MEMBER_OUTSIDE_WHOLE_SITE_SCOPE(m,TRIAD(v)));
law W38_SUPPORT_A_EDGE_REFUSAL := IF GOES_WITH(W38_MEMBER,t,m,A_EDGE(l,p),r) THEN GOES_WITH(W38_SCOPE_REFUSAL,t,K_MEMBER_OUTSIDE_WHOLE_SITE_SCOPE(m,A_EDGE(l,p)));
law W38_SUPPORT_PAIR_REFUSAL := IF GOES_WITH(W38_MEMBER,t,m,PAIR(o),r) THEN GOES_WITH(W38_SCOPE_REFUSAL,t,K_MEMBER_OUTSIDE_WHOLE_SITE_SCOPE(m,PAIR(o)));
law W38_INSIDE := IF GOES_WITH(W38_TYPED_MEMBER,t,m,u,r), GOES_WITH(SW_MEMBER,u,f), THIS(W38_SNAPSHOT_READY,t) THEN GOES_WITH(W38_INSIDE,t,m,f,r);
law W38_SITE_COMPARE := IF GOES_WITH(W38_TYPED_MEMBER,t,m,SITE(a),r), GOES_WITH(SW_FLAG,f,s,e,v) THEN GOES_WITH(SW_DIFF_REQUEST,s,a);
law W38_SITE_OUTSIDE := IF GOES_WITH(W38_TYPED_MEMBER,t,m,SITE(a),r), GOES_WITH(SW_FLAG,f,s,e,v), GOES_WITH(SW_DIFF,s,a) THEN GOES_WITH(W38_OUTSIDE,t,m,f);
law W38_A_SITE_COMPARE := IF GOES_WITH(W38_TYPED_MEMBER,t,m,A_SITE(l,p),r), GOES_WITH(SW_ANCESTOR_SITE,l,p,a), GOES_WITH(SW_FLAG,f,s,e,v) THEN GOES_WITH(SW_DIFF_REQUEST,s,a);
law W38_A_SITE_OUTSIDE := IF GOES_WITH(W38_TYPED_MEMBER,t,m,A_SITE(l,p),r), GOES_WITH(SW_ANCESTOR_SITE,l,p,a), GOES_WITH(SW_FLAG,f,s,e,v), GOES_WITH(SW_DIFF,s,a) THEN GOES_WITH(W38_OUTSIDE,t,m,f);
law W38_A_TRIAD_COMPARE := IF GOES_WITH(W38_TYPED_MEMBER,t,m,A_TRIAD(l,p),r), GOES_WITH(SW_FLAG,f,s,e,v), GOES_WITH(SW_ANCESTOR_TRIAD_PART,l,q,v) THEN GOES_WITH(SW_DIFF_REQUEST,p,q);
law W38_A_TRIAD_OUTSIDE := IF GOES_WITH(W38_TYPED_MEMBER,t,m,A_TRIAD(l,p),r), GOES_WITH(SW_FLAG,f,s,e,v), GOES_WITH(SW_ANCESTOR_TRIAD_PART,l,q,v), GOES_WITH(SW_DIFF,p,q) THEN GOES_WITH(W38_OUTSIDE,t,m,f);
law W38_EFFECT_WRITE := IF GOES_WITH(W38_INSIDE,t,m,f,r) THEN GOES_WITH(W38_EFFECT,t,m,f,r);
law W38_EFFECT_RETAIN := IF GOES_WITH(W38_OUTSIDE,t,m,f), GOES_WITH(SW_BASE,t,f,r), THIS(W38_SNAPSHOT_READY,t) THEN GOES_WITH(W38_EFFECT,t,m,f,r);
law W38_EFFECT_LEAF := IF GOES_WITH(CF_FLAG_LEAF,n,f), GOES_WITH(W38_EFFECT,t,m,f,r) THEN GOES_WITH(W38_EFFECT_TREE,t,m,n);
law W38_EFFECT_JOIN := IF GOES_WITH(CF_FLAG_JOIN,n,a,b), GOES_WITH(W38_EFFECT_TREE,t,m,a), GOES_WITH(W38_EFFECT_TREE,t,m,b) THEN GOES_WITH(W38_EFFECT_TREE,t,m,n);
law W38_EFFECT_ROOT := IF GOES_WITH(CF_FLAG_ROOT,n), GOES_WITH(W38_EFFECT_TREE,t,m,n) THEN GOES_WITH(W38_EFFECT_COMPLETE,t,m);
law W38_K_TOTAL_LEAF := IF GOES_WITH(W38_K_LEAF,t,n,m), GOES_WITH(W38_EFFECT_COMPLETE,t,m) THEN GOES_WITH(W38_K_TOTAL_TREE,t,n);
law W38_K_TOTAL_JOIN := IF GOES_WITH(W38_K_JOIN,t,n,a,b), GOES_WITH(W38_K_TOTAL_TREE,t,a), GOES_WITH(W38_K_TOTAL_TREE,t,b) THEN GOES_WITH(W38_K_TOTAL_TREE,t,n);
law W38_K_TOTAL_ROOT := IF GOES_WITH(W38_K_ROOT,t,n), GOES_WITH(W38_K_TOTAL_TREE,t,n) THEN THIS(W38_K_TOTAL,t);
law W38_NO_APPEND := IF THIS(W38_K_EMPTY,t), THIS(W38_SNAPSHOT_READY,t) THEN THIS(W38_NO_APPEND,t);

// Full field equivalence; raw aliases remain separate members in every tree.
law W38_EQUAL_LEAF := IF GOES_WITH(CF_FLAG_LEAF,n,f), GOES_WITH(W38_EFFECT,t,a,f,r), GOES_WITH(W38_EFFECT,t,b,f,r) THEN GOES_WITH(W38_EQUAL_TREE,t,a,b,n);
law W38_EQUAL_JOIN := IF GOES_WITH(CF_FLAG_JOIN,n,x,y), GOES_WITH(W38_EQUAL_TREE,t,a,b,x), GOES_WITH(W38_EQUAL_TREE,t,a,b,y) THEN GOES_WITH(W38_EQUAL_TREE,t,a,b,n);
law W38_EQUAL_ROOT := IF GOES_WITH(CF_FLAG_ROOT,n), GOES_WITH(W38_EQUAL_TREE,t,a,b,n), THIS(W38_K_TOTAL,t) THEN GOES_WITH(W38_EQUIVALENT,t,a,b);
law W38_DIFFERENT_THIS := IF GOES_WITH(W38_EFFECT,t,a,f,READING_THIS), GOES_WITH(W38_EFFECT,t,b,f,READING_NO), GOES_WITH(W38_EFFECT_COMPLETE,t,a), GOES_WITH(W38_EFFECT_COMPLETE,t,b) THEN GOES_WITH(W38_EFFECT_NOT_SAME,t,a,b,f);
law W38_DIFFERENT_NO := IF GOES_WITH(W38_EFFECT,t,a,f,READING_NO), GOES_WITH(W38_EFFECT,t,b,f,READING_THIS), GOES_WITH(W38_EFFECT_COMPLETE,t,a), GOES_WITH(W38_EFFECT_COMPLETE,t,b) THEN GOES_WITH(W38_EFFECT_NOT_SAME,t,a,b,f);

// COMPOSE(after,before) applies the first member's own support to the second's
// already-derived field. This is a relation witness, never execution feedback.
law W38_COMPOSE_WRITE := IF GOES_WITH(W38_INSIDE,t,a,f,r), GOES_WITH(W38_EFFECT_COMPLETE,t,b), THIS(W38_K_TOTAL,t) THEN GOES_WITH(W38_COMPOSE,t,a,b,f,r);
law W38_COMPOSE_RETAIN := IF GOES_WITH(W38_OUTSIDE,t,a,f), GOES_WITH(W38_EFFECT,t,b,f,r), THIS(W38_K_TOTAL,t) THEN GOES_WITH(W38_COMPOSE,t,a,b,f,r);
law W38_ABSORB_LEAF := IF GOES_WITH(CF_FLAG_LEAF,n,f), GOES_WITH(W38_COMPOSE,t,a,b,f,r), GOES_WITH(W38_EFFECT,t,a,f,r) THEN GOES_WITH(W38_ABSORB_TREE,t,a,b,n);
law W38_ABSORB_JOIN := IF GOES_WITH(CF_FLAG_JOIN,n,x,y), GOES_WITH(W38_ABSORB_TREE,t,a,b,x), GOES_WITH(W38_ABSORB_TREE,t,a,b,y) THEN GOES_WITH(W38_ABSORB_TREE,t,a,b,n);
law W38_ABSORB_ROOT := IF GOES_WITH(CF_FLAG_ROOT,n), GOES_WITH(W38_ABSORB_TREE,t,a,b,n), GOES_WITH(W38_EFFECT_NOT_SAME,t,a,b,f), THIS(W38_K_TOTAL,t) THEN GOES_WITH(W38_ABSORBS,t,a,b);
law W38_ABSORBED := IF GOES_WITH(W38_ABSORBS,t,a,b) THEN GOES_WITH(W38_ABSORBED,t,b);
// Positive negation of absorption: same effect, or a named differing flag in
// the absorber-after-absorbed comparison. No closed-world absence is used.
law W38_NOT_ABSORBED_EQUIVALENT := IF GOES_WITH(W38_EQUIVALENT,t,a,b) THEN GOES_WITH(W38_NOT_ABSORBED_BY,t,b,a);
law W38_NOT_ABSORBED_THIS := IF GOES_WITH(W38_COMPOSE,t,a,b,f,READING_THIS), GOES_WITH(W38_EFFECT,t,a,f,READING_NO) THEN GOES_WITH(W38_NOT_ABSORBED_BY,t,b,a);
law W38_NOT_ABSORBED_NO := IF GOES_WITH(W38_COMPOSE,t,a,b,f,READING_NO), GOES_WITH(W38_EFFECT,t,a,f,READING_THIS) THEN GOES_WITH(W38_NOT_ABSORBED_BY,t,b,a);
law W38_NONABSORBED_LEAF := IF GOES_WITH(W38_K_LEAF,t,n,a), GOES_WITH(W38_NOT_ABSORBED_BY,t,b,a) THEN GOES_WITH(W38_NONABSORBED_TREE,t,b,n);
law W38_NONABSORBED_JOIN := IF GOES_WITH(W38_K_JOIN,t,n,x,y), GOES_WITH(W38_NONABSORBED_TREE,t,b,x), GOES_WITH(W38_NONABSORBED_TREE,t,b,y) THEN GOES_WITH(W38_NONABSORBED_TREE,t,b,n);
law W38_NONABSORBED_ROOT := IF GOES_WITH(W38_K_ROOT,t,n), GOES_WITH(W38_NONABSORBED_TREE,t,b,n), THIS(W38_K_TOTAL,t) THEN GOES_WITH(W38_NONABSORBED,t,b);

// Pairwise concurrency of all retained effect classes, with full flag coverage.
law W38_CONCURRENT_LEAF := IF GOES_WITH(CF_FLAG_LEAF,n,f), GOES_WITH(W38_COMPOSE,t,a,b,f,r), GOES_WITH(W38_COMPOSE,t,b,a,f,r) THEN GOES_WITH(W38_CONCURRENT_TREE,t,a,b,n);
law W38_CONCURRENT_JOIN := IF GOES_WITH(CF_FLAG_JOIN,n,x,y), GOES_WITH(W38_CONCURRENT_TREE,t,a,b,x), GOES_WITH(W38_CONCURRENT_TREE,t,a,b,y) THEN GOES_WITH(W38_CONCURRENT_TREE,t,a,b,n);
law W38_CONCURRENT_ROOT := IF GOES_WITH(CF_FLAG_ROOT,n), GOES_WITH(W38_CONCURRENT_TREE,t,a,b,n), THIS(W38_K_TOTAL,t) THEN GOES_WITH(W38_CONCURRENT,t,a,b);
law W38_CONFLICT_THIS := IF GOES_WITH(W38_COMPOSE,t,a,b,f,READING_THIS), GOES_WITH(W38_COMPOSE,t,b,a,f,READING_NO), GOES_WITH(W38_NONABSORBED,t,a), GOES_WITH(W38_NONABSORBED,t,b) THEN GOES_WITH(W38_ASSIGNMENT_REFUSAL,t,NONCOMMUTING(a,b,f));
law W38_CONFLICT_NO := IF GOES_WITH(W38_COMPOSE,t,a,b,f,READING_NO), GOES_WITH(W38_COMPOSE,t,b,a,f,READING_THIS), GOES_WITH(W38_NONABSORBED,t,a), GOES_WITH(W38_NONABSORBED,t,b) THEN GOES_WITH(W38_ASSIGNMENT_REFUSAL,t,NONCOMMUTING(a,b,f));
law W38_PAIR_NEUTRAL_A := IF GOES_WITH(W38_ABSORBED,t,a), GOES_WITH(W38_EFFECT_COMPLETE,t,b) THEN GOES_WITH(W38_PAIR_ACCOUNTED,t,a,b);
law W38_PAIR_NEUTRAL_B := IF GOES_WITH(W38_EFFECT_COMPLETE,t,a), GOES_WITH(W38_ABSORBED,t,b) THEN GOES_WITH(W38_PAIR_ACCOUNTED,t,a,b);
law W38_PAIR_RETAINED := IF GOES_WITH(W38_NONABSORBED,t,a), GOES_WITH(W38_NONABSORBED,t,b), GOES_WITH(W38_CONCURRENT,t,a,b) THEN GOES_WITH(W38_PAIR_ACCOUNTED,t,a,b);
law W38_COMPATIBLE_ROW_LEAF := IF GOES_WITH(W38_K_LEAF,t,n,b), GOES_WITH(W38_PAIR_ACCOUNTED,t,a,b) THEN GOES_WITH(W38_COMPATIBLE_ROW_TREE,t,a,n);
law W38_COMPATIBLE_ROW_JOIN := IF GOES_WITH(W38_K_JOIN,t,n,x,y), GOES_WITH(W38_COMPATIBLE_ROW_TREE,t,a,x), GOES_WITH(W38_COMPATIBLE_ROW_TREE,t,a,y) THEN GOES_WITH(W38_COMPATIBLE_ROW_TREE,t,a,n);
law W38_COMPATIBLE_ROW_ROOT := IF GOES_WITH(W38_K_ROOT,t,n), GOES_WITH(W38_COMPATIBLE_ROW_TREE,t,a,n) THEN GOES_WITH(W38_COMPATIBLE_ROW,t,a);
law W38_COMPATIBLE_ALL_LEAF := IF GOES_WITH(W38_K_LEAF,t,n,a), GOES_WITH(W38_COMPATIBLE_ROW,t,a) THEN GOES_WITH(W38_COMPATIBLE_ALL_TREE,t,n);
law W38_COMPATIBLE_ALL_JOIN := IF GOES_WITH(W38_K_JOIN,t,n,x,y), GOES_WITH(W38_COMPATIBLE_ALL_TREE,t,x), GOES_WITH(W38_COMPATIBLE_ALL_TREE,t,y) THEN GOES_WITH(W38_COMPATIBLE_ALL_TREE,t,n);
law W38_COMPATIBLE_ALL_ROOT := IF GOES_WITH(W38_K_ROOT,t,n), GOES_WITH(W38_COMPATIBLE_ALL_TREE,t,n), THIS(W38_K_TOTAL,t) THEN THIS(W38_COMPATIBLE_ALL,t);

// Assemble only changed assignments of every nonabsorbed raw member. The
// commutative leaf algebra is set union of writes, not offer ordering.
law W38_WRITE_ABSORBED := IF GOES_WITH(W38_K_LEAF,t,n,m), GOES_WITH(W38_ABSORBED,t,m), GOES_WITH(CF_FLAG_LEAF,z,f) THEN GOES_WITH(W38_WRITE_TREE,t,n,f,NO_WRITE);
law W38_WRITE_UNCHANGED := IF GOES_WITH(W38_K_LEAF,t,n,m), GOES_WITH(W38_NONABSORBED,t,m), GOES_WITH(W38_EFFECT,t,m,f,r), GOES_WITH(SW_BASE,t,f,r) THEN GOES_WITH(W38_WRITE_TREE,t,n,f,NO_WRITE);
law W38_WRITE_THIS := IF GOES_WITH(W38_K_LEAF,t,n,m), GOES_WITH(W38_NONABSORBED,t,m), GOES_WITH(W38_EFFECT,t,m,f,READING_THIS), GOES_WITH(SW_BASE,t,f,READING_NO) THEN GOES_WITH(W38_WRITE_TREE,t,n,f,READING_THIS);
law W38_WRITE_NO := IF GOES_WITH(W38_K_LEAF,t,n,m), GOES_WITH(W38_NONABSORBED,t,m), GOES_WITH(W38_EFFECT,t,m,f,READING_NO), GOES_WITH(SW_BASE,t,f,READING_THIS) THEN GOES_WITH(W38_WRITE_TREE,t,n,f,READING_NO);
law W38_WRITE_JOIN_EMPTY := IF GOES_WITH(W38_K_JOIN,t,n,a,b), GOES_WITH(W38_WRITE_TREE,t,a,f,NO_WRITE), GOES_WITH(W38_WRITE_TREE,t,b,f,NO_WRITE) THEN GOES_WITH(W38_WRITE_TREE,t,n,f,NO_WRITE);
law W38_WRITE_JOIN_LEFT := IF GOES_WITH(W38_K_JOIN,t,n,a,b), GOES_WITH(W38_WRITE_TREE,t,a,f,r), GOES_WITH(W38_WRITE_TREE,t,b,f,NO_WRITE) THEN GOES_WITH(W38_WRITE_TREE,t,n,f,r);
law W38_WRITE_JOIN_RIGHT := IF GOES_WITH(W38_K_JOIN,t,n,a,b), GOES_WITH(W38_WRITE_TREE,t,a,f,NO_WRITE), GOES_WITH(W38_WRITE_TREE,t,b,f,r) THEN GOES_WITH(W38_WRITE_TREE,t,n,f,r);
law W38_WRITE_JOIN_SAME := IF GOES_WITH(W38_K_JOIN,t,n,a,b), GOES_WITH(W38_WRITE_TREE,t,a,f,r), GOES_WITH(W38_WRITE_TREE,t,b,f,r) THEN GOES_WITH(W38_WRITE_TREE,t,n,f,r);
law W38_WRITE_JOIN_CONFLICT_A := IF GOES_WITH(W38_K_JOIN,t,n,a,b), GOES_WITH(W38_WRITE_TREE,t,a,f,READING_THIS), GOES_WITH(W38_WRITE_TREE,t,b,f,READING_NO) THEN GOES_WITH(W38_WRITE_TREE,t,n,f,CONFLICT);
law W38_WRITE_JOIN_CONFLICT_B := IF GOES_WITH(W38_K_JOIN,t,n,a,b), GOES_WITH(W38_WRITE_TREE,t,a,f,READING_NO), GOES_WITH(W38_WRITE_TREE,t,b,f,READING_THIS) THEN GOES_WITH(W38_WRITE_TREE,t,n,f,CONFLICT);
