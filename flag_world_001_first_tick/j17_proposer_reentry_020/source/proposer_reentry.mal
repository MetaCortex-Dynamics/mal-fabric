// Test P: bounded diagnostic re-entry of the same 1,924-offer R1 producer.
// Imported R1 and KD laws remain byte-identical. This fragment supplies no move.
// A positive ZERO/ONE/MANY fold covers every native case before execution.
// Returned state means the complete pair(field,witness), not FABRIC_STATE.
// RETURNED and RELOADED_G2 are distinct constructors. No seal or commit here.
// P20_EFFECT/EXEC_FIELD/EXEC_WITNESS are pure candidate effect projections.
// P20_RETURN is an uncommitted return candidate. Only P_COMMITTED_RETURN,
// emitted by the separately bound own commit module, permits second-pass input.
// Grouping rows transport the native inventory; no verdict or result is seeded.

law P20_ROWS := IF THIS(P20_INPUT_CHUNK,ARRAY(xs)) THEN THIS(P20_ROWS,xs);
law P20_ROW := IF THIS(P20_ROWS,CONS(x,xs)) THEN THIS(P20_ROW,x);
law P20_TAIL := IF THIS(P20_ROWS,CONS(x,xs)) THEN THIS(P20_ROWS,xs);
law P20_K_LEAF := IF THIS(P20_ROW,K_LEAF(n,m)), THIS(R1_CASE,m) THEN GOES_WITH(P20_K_LEAF,n,m);
law P20_K_JOIN := IF THIS(P20_ROW,K_JOIN(n,a,b)) THEN GOES_WITH(P20_K_JOIN,n,a,b);
law P20_K_ROOT := IF THIS(P20_ROW,K_ROOT(n)) THEN THIS(P20_K_ROOT,n);
law P20_FIELD_LEAF := IF THIS(P20_ROW,FIELD_LEAF(n,f)), GOES_WITH(R1_FLAG,f,v,e,t) THEN GOES_WITH(P20_FIELD_LEAF,n,f);
law P20_FIELD_JOIN := IF THIS(P20_ROW,FIELD_JOIN(n,a,b)) THEN GOES_WITH(P20_FIELD_JOIN,n,a,b);
law P20_FIELD_ROOT := IF THIS(P20_ROW,FIELD_ROOT(n)) THEN THIS(P20_FIELD_ROOT,n);
law P20_WITNESS_LEAF := IF THIS(P20_ROW,WITNESS_LEAF(n,a,b)), GOES_WITH(R1_OVERLAP,a,b) THEN GOES_WITH(P20_WITNESS_LEAF,n,a,b);
law P20_WITNESS_JOIN := IF THIS(P20_ROW,WITNESS_JOIN(n,a,b)) THEN GOES_WITH(P20_WITNESS_JOIN,n,a,b);
law P20_WITNESS_ROOT := IF THIS(P20_ROW,WITNESS_ROOT(n)) THEN THIS(P20_WITNESS_ROOT,n);
law P20_RETURN_ROOT := IF THIS(P20_ROW,RETURN_ROOT(f,w)) THEN GOES_WITH(P20_RETURN_ROOT,f,w);

// The initial field and witness have the recorded source identity. Their entire
// extents must agree before a singleton or empty-K result is exposed.
law P20_INITIAL_CONTEXT := IF THIS(R1_TRIAL,G2), THIS(P20_SOURCE_ID,h) THEN GOES_WITH(P20_CONTEXT,G2,RECORDED_PAIR(h));
law P20_INITIAL_WITNESS := IF GOES_WITH(P20_CONTEXT,G2,p), GOES_WITH(R1_SOURCE_WITNESS,a,b,r) THEN GOES_WITH(P20_INPUT_WITNESS,G2,a,b,r);
law P20_INPUT_FIELD_LEAF := IF GOES_WITH(P20_FIELD_LEAF,n,f), GOES_WITH(R1_BASE,i,f,r) THEN GOES_WITH(P20_INPUT_FIELD_COVER,i,n);
law P20_INPUT_FIELD_JOIN := IF GOES_WITH(P20_FIELD_JOIN,n,a,b), GOES_WITH(P20_INPUT_FIELD_COVER,i,a), GOES_WITH(P20_INPUT_FIELD_COVER,i,b) THEN GOES_WITH(P20_INPUT_FIELD_COVER,i,n);
law P20_INPUT_WITNESS_LEAF := IF GOES_WITH(P20_WITNESS_LEAF,n,a,b), GOES_WITH(R1_BASELINE,i,a,b,r), GOES_WITH(P20_INPUT_WITNESS,i,a,b,r) THEN GOES_WITH(P20_INPUT_WITNESS_COVER,i,n);
law P20_INPUT_WITNESS_JOIN := IF GOES_WITH(P20_WITNESS_JOIN,n,a,b), GOES_WITH(P20_INPUT_WITNESS_COVER,i,a), GOES_WITH(P20_INPUT_WITNESS_COVER,i,b) THEN GOES_WITH(P20_INPUT_WITNESS_COVER,i,n);
law P20_INPUT_READY := IF GOES_WITH(P20_CONTEXT,i,p), THIS(P20_FIELD_ROOT,f), THIS(P20_WITNESS_ROOT,w), GOES_WITH(P20_INPUT_FIELD_COVER,i,f), GOES_WITH(P20_INPUT_WITNESS_COVER,i,w) THEN GOES_WITH(P20_INPUT_READY,i,p);

// Native exhaustive cardinality fold. ZERO has a positive exclusion witness;
// ONE retains its member. No absence test, ordering preference or host pick.
law P20_K_ZERO_OPEN := IF GOES_WITH(P20_K_LEAF,n,m), GOES_WITH(R1_EXCLUDED_OPEN,i,m,a,b) THEN GOES_WITH(P20_K_ZERO,i,n);
law P20_K_ZERO_EMPTY := IF GOES_WITH(P20_K_LEAF,n,m), GOES_WITH(R1_EXCLUDED_EMPTY,i,m) THEN GOES_WITH(P20_K_ZERO,i,n);
law P20_K_ONE_LEAF := IF GOES_WITH(P20_K_LEAF,n,m), GOES_WITH(R1_STRICT,i,m) THEN GOES_WITH(P20_K_ONE,i,n,m);
law P20_K_ZERO_JOIN := IF GOES_WITH(P20_K_JOIN,n,a,b), GOES_WITH(P20_K_ZERO,i,a), GOES_WITH(P20_K_ZERO,i,b) THEN GOES_WITH(P20_K_ZERO,i,n);
law P20_K_ONE_LEFT := IF GOES_WITH(P20_K_JOIN,n,a,b), GOES_WITH(P20_K_ONE,i,a,m), GOES_WITH(P20_K_ZERO,i,b) THEN GOES_WITH(P20_K_ONE,i,n,m);
law P20_K_ONE_RIGHT := IF GOES_WITH(P20_K_JOIN,n,a,b), GOES_WITH(P20_K_ZERO,i,a), GOES_WITH(P20_K_ONE,i,b,m) THEN GOES_WITH(P20_K_ONE,i,n,m);
law P20_K_MANY_ONES := IF GOES_WITH(P20_K_JOIN,n,a,b), GOES_WITH(P20_K_ONE,i,a,m), GOES_WITH(P20_K_ONE,i,b,q) THEN GOES_WITH(P20_K_MANY,i,n);
law P20_K_MANY_LEFT_ZERO := IF GOES_WITH(P20_K_JOIN,n,a,b), GOES_WITH(P20_K_MANY,i,a), GOES_WITH(P20_K_ZERO,i,b) THEN GOES_WITH(P20_K_MANY,i,n);
law P20_K_MANY_LEFT_ONE := IF GOES_WITH(P20_K_JOIN,n,a,b), GOES_WITH(P20_K_MANY,i,a), GOES_WITH(P20_K_ONE,i,b,m) THEN GOES_WITH(P20_K_MANY,i,n);
law P20_K_MANY_RIGHT_ZERO := IF GOES_WITH(P20_K_JOIN,n,a,b), GOES_WITH(P20_K_ZERO,i,a), GOES_WITH(P20_K_MANY,i,b) THEN GOES_WITH(P20_K_MANY,i,n);
law P20_K_MANY_RIGHT_ONE := IF GOES_WITH(P20_K_JOIN,n,a,b), GOES_WITH(P20_K_ONE,i,a,m), GOES_WITH(P20_K_MANY,i,b) THEN GOES_WITH(P20_K_MANY,i,n);
law P20_K_MANY_BOTH := IF GOES_WITH(P20_K_JOIN,n,a,b), GOES_WITH(P20_K_MANY,i,a), GOES_WITH(P20_K_MANY,i,b) THEN GOES_WITH(P20_K_MANY,i,n);
law P20_UNIQUE := IF GOES_WITH(P20_INPUT_READY,i,p), THIS(P20_K_ROOT,n), GOES_WITH(P20_K_ONE,i,n,m) THEN GOES_WITH(P20_UNIQUE,i,p,m);
law P20_K_EMPTY := IF GOES_WITH(P20_INPUT_READY,i,p), THIS(P20_K_ROOT,n), GOES_WITH(P20_K_ZERO,i,n) THEN GOES_WITH(P20_K_EMPTY,i,p);
law P20_K_MULTIPLE := IF GOES_WITH(P20_INPUT_READY,i,p), THIS(P20_K_ROOT,n), GOES_WITH(P20_K_MANY,i,n) THEN GOES_WITH(P20_K_MULTIPLE,i,p);

// Context/source-pair is retained on offered records. The offer-domain member
// identities may be SAME while their contextual receipts are NOT-SAME.
law P20_OFFER := IF GOES_WITH(P20_INPUT_READY,i,p), THIS(R1_CASE,m) THEN GOES_WITH(P20_OFFER,i,p,m);
law P20_OFFER_COMPLETE := IF GOES_WITH(P20_OFFER,i,p,m), GOES_WITH(R1_COMPLETE,i,m) THEN GOES_WITH(P20_OFFER_COMPLETE,i,p,m);
law P20_OFFER_OPENED := IF GOES_WITH(P20_OFFER,i,p,m), GOES_WITH(R1_OPENED,i,m,a,b) THEN GOES_WITH(P20_OFFER_OPENED,i,p,m,a,b);
law P20_OFFER_DISCHARGED := IF GOES_WITH(P20_OFFER,i,p,m), GOES_WITH(R1_DISCHARGED,i,m,a,b) THEN GOES_WITH(P20_OFFER_DISCHARGED,i,p,m,a,b);
law P20_OFFER_RETAINED := IF GOES_WITH(P20_OFFER,i,p,m), GOES_WITH(R1_RETAINED,i,m,a,b) THEN GOES_WITH(P20_OFFER_RETAINED,i,p,m,a,b);

// Only G2's exhaustive singleton can initiate this bounded two-pass diagnostic.
// The complete field uses the same member/retain construction as R1_NEXT;
// separate P20 tags leave the sparse qualified R1 evaluator unchanged.
law P20_EFFECT := IF GOES_WITH(P20_UNIQUE,G2,p,m) THEN GOES_WITH(P20_EFFECT,G2,p,m);
law P20_EXEC_ASSIGN := IF GOES_WITH(P20_EFFECT,i,p,m), GOES_WITH(R1_MEMBER,m,f,r) THEN GOES_WITH(P20_EXEC_FIELD,i,m,f,r);
law P20_EXEC_COMPARE_SITE := IF GOES_WITH(P20_EFFECT,i,p,SITE(v,r)), GOES_WITH(R1_FLAG,f,w,e,t) THEN GOES_WITH(KD_DIFF_REQUEST,w,v);
law P20_EXEC_COMPARE_EDGE := IF GOES_WITH(P20_EFFECT,i,p,EDGE(e,r)), GOES_WITH(R1_FLAG,f,v,q,t) THEN GOES_WITH(KD_DIFF_REQUEST,q,e);
law P20_EXEC_COMPARE_TRIAD := IF GOES_WITH(P20_EFFECT,i,p,TRIAD(t,r)), GOES_WITH(R1_FLAG,f,v,e,u) THEN GOES_WITH(KD_DIFF_REQUEST,u,t);
law P20_EXEC_COMPARE_PAIR_A := IF GOES_WITH(P20_EFFECT,i,p,PAIR(k,a,b,r)), GOES_WITH(R1_FLAG,f,v,e,t) THEN GOES_WITH(KD_DIFF_REQUEST,f,a);
law P20_EXEC_COMPARE_PAIR_B := IF GOES_WITH(P20_EFFECT,i,p,PAIR(k,a,b,r)), GOES_WITH(R1_FLAG,f,v,e,t) THEN GOES_WITH(KD_DIFF_REQUEST,f,b);
law P20_EXEC_RETAIN_SITE := IF GOES_WITH(P20_EFFECT,i,p,SITE(v,r)), GOES_WITH(R1_FLAG,f,w,e,t), GOES_WITH(KD_DIFF,w,v), GOES_WITH(R1_BASE,i,f,old) THEN GOES_WITH(P20_EXEC_FIELD,i,SITE(v,r),f,old);
law P20_EXEC_RETAIN_EDGE := IF GOES_WITH(P20_EFFECT,i,p,EDGE(e,r)), GOES_WITH(R1_FLAG,f,v,q,t), GOES_WITH(KD_DIFF,q,e), GOES_WITH(R1_BASE,i,f,old) THEN GOES_WITH(P20_EXEC_FIELD,i,EDGE(e,r),f,old);
law P20_EXEC_RETAIN_TRIAD := IF GOES_WITH(P20_EFFECT,i,p,TRIAD(t,r)), GOES_WITH(R1_FLAG,f,v,e,u), GOES_WITH(KD_DIFF,u,t), GOES_WITH(R1_BASE,i,f,old) THEN GOES_WITH(P20_EXEC_FIELD,i,TRIAD(t,r),f,old);
law P20_EXEC_RETAIN_PAIR := IF GOES_WITH(P20_EFFECT,i,p,PAIR(k,a,b,r)), GOES_WITH(R1_FLAG,f,v,e,t), GOES_WITH(KD_DIFF,f,a), GOES_WITH(KD_DIFF,f,b), GOES_WITH(R1_BASE,i,f,old) THEN GOES_WITH(P20_EXEC_FIELD,i,PAIR(k,a,b,r),f,old);
law P20_EXEC_WITNESS_SAME := IF GOES_WITH(P20_EFFECT,i,p,m), GOES_WITH(R1_OVERLAP,a,b), GOES_WITH(P20_EXEC_FIELD,i,m,a,r), GOES_WITH(P20_EXEC_FIELD,i,m,b,r) THEN GOES_WITH(P20_EXEC_WITNESS,i,m,a,b,"SAME");
law P20_EXEC_WITNESS_DIFF_A := IF GOES_WITH(P20_EFFECT,i,p,m), GOES_WITH(R1_OVERLAP,a,b), GOES_WITH(P20_EXEC_FIELD,i,m,a,"THIS"), GOES_WITH(P20_EXEC_FIELD,i,m,b,"NO") THEN GOES_WITH(P20_EXEC_WITNESS,i,m,a,b,"NOT_SAME");
law P20_EXEC_WITNESS_DIFF_B := IF GOES_WITH(P20_EFFECT,i,p,m), GOES_WITH(R1_OVERLAP,a,b), GOES_WITH(P20_EXEC_FIELD,i,m,a,"NO"), GOES_WITH(P20_EXEC_FIELD,i,m,b,"THIS") THEN GOES_WITH(P20_EXEC_WITNESS,i,m,a,b,"NOT_SAME");
law P20_RETURN_FIELD_LEAF := IF GOES_WITH(P20_FIELD_LEAF,n,f), GOES_WITH(P20_EXEC_FIELD,i,m,f,r) THEN GOES_WITH(P20_RETURN_FIELD_COVER,i,m,n);
law P20_RETURN_FIELD_JOIN := IF GOES_WITH(P20_FIELD_JOIN,n,a,b), GOES_WITH(P20_RETURN_FIELD_COVER,i,m,a), GOES_WITH(P20_RETURN_FIELD_COVER,i,m,b) THEN GOES_WITH(P20_RETURN_FIELD_COVER,i,m,n);
law P20_RETURN_WITNESS_LEAF := IF GOES_WITH(P20_WITNESS_LEAF,n,a,b), GOES_WITH(P20_EXEC_WITNESS,i,m,a,b,r) THEN GOES_WITH(P20_RETURN_WITNESS_COVER,i,m,n);
law P20_RETURN_WITNESS_JOIN := IF GOES_WITH(P20_WITNESS_JOIN,n,a,b), GOES_WITH(P20_RETURN_WITNESS_COVER,i,m,a), GOES_WITH(P20_RETURN_WITNESS_COVER,i,m,b) THEN GOES_WITH(P20_RETURN_WITNESS_COVER,i,m,n);
law P20_RETURN := IF GOES_WITH(P20_EFFECT,i,p,m), GOES_WITH(P20_RETURN_ROOT,f,w), GOES_WITH(P20_RETURN_FIELD_COVER,i,m,f), GOES_WITH(P20_RETURN_WITNESS_COVER,i,m,w) THEN GOES_WITH(P20_RETURN,i,p,m,RETURN_PAIR(i,m));

// Direct native feedback is gated by the own commit module's committed return,
// not by the candidate return above. Both payload components retain their exact
// first-pass native producer; no second field or expected result is supplied.
law P20_REENTRY_TRIAL := IF THIS(P20_MODE,CHAIN), GOES_WITH(P_COMMITTED_RETURN,i,p,m,q,prior,tick) THEN THIS(R1_TRIAL,RETURNED(i,m));
law P20_REENTRY_CONTEXT := IF THIS(P20_MODE,CHAIN), GOES_WITH(P_COMMITTED_RETURN,i,p,m,q,prior,tick), GOES_WITH(P20_C_PAIR_BOUND,i,m,pair,pairHash) THEN GOES_WITH(P20_CONTEXT,RETURNED(i,m),COMMITTED_PAIR(q,pairHash,prior,tick));
law P20_REENTRY_FIELD := IF THIS(P20_MODE,CHAIN), GOES_WITH(P_COMMITTED_RETURN,i,p,m,q,prior,tick), GOES_WITH(P20_EXEC_FIELD,i,m,f,r) THEN GOES_WITH(R1_BASE,RETURNED(i,m),f,r);
law P20_REENTRY_WITNESS := IF THIS(P20_MODE,CHAIN), GOES_WITH(P_COMMITTED_RETURN,i,p,m,q,prior,tick), GOES_WITH(P20_EXEC_WITNESS,i,m,a,b,r) THEN GOES_WITH(P20_INPUT_WITNESS,RETURNED(i,m),a,b,r);

// Negative control only: reloading the original pair is explicitly distinguished
// and never receives RETURNED provenance. CHAIN inputs contain no RELOAD_G2.
law P20_RELOAD_TRIAL := IF THIS(P20_MODE,RELOAD_G2), GOES_WITH(P_COMMITTED_RETURN,i,p,m,q,prior,tick) THEN THIS(R1_TRIAL,RELOADED_G2);
law P20_RELOAD_CONTEXT := IF THIS(P20_MODE,RELOAD_G2), GOES_WITH(P_COMMITTED_RETURN,i,p,m,q,prior,tick), THIS(P20_SOURCE_ID,h) THEN GOES_WITH(P20_CONTEXT,RELOADED_G2,RELOADED_PAIR(h));
law P20_RELOAD_FIELD := IF THIS(P20_MODE,RELOAD_G2), GOES_WITH(P_COMMITTED_RETURN,i,p,m,q,prior,tick), GOES_WITH(R1_SOURCE_FIELD,f,r) THEN GOES_WITH(R1_BASE,RELOADED_G2,f,r);
law P20_RELOAD_WITNESS := IF THIS(P20_MODE,RELOAD_G2), GOES_WITH(P_COMMITTED_RETURN,i,p,m,q,prior,tick), GOES_WITH(R1_SOURCE_WITNESS,a,b,r) THEN GOES_WITH(P20_INPUT_WITNESS,RELOADED_G2,a,b,r);
