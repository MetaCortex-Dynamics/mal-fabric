@propose seed P20_BYTE := { GOES_WITH(KD_BYTE_NEXT,B125,B126) };
law KD_BYTE_SPAN := IF GOES_WITH(KD_BYTE_NEXT,a,b) THEN GOES_WITH(KD_BYTE_SPAN,a,b);
law KD_BYTE_SPAN_MORE := IF GOES_WITH(KD_BYTE_SPAN,a,b), GOES_WITH(KD_BYTE_NEXT,b,c) THEN GOES_WITH(KD_BYTE_SPAN,a,c);
law KD_BYTE_DIFFER_F := IF GOES_WITH(KD_BYTE_SPAN,a,b) THEN GOES_WITH(KD_BYTE_DIFFER,a,b);
law KD_BYTE_DIFFER_R := IF GOES_WITH(KD_BYTE_SPAN,a,b) THEN GOES_WITH(KD_BYTE_DIFFER,b,a);
law KD_TEXT_REQUEST := IF GOES_WITH(KD_DIFF_REQUEST,TEXT(a),TEXT(b)) THEN GOES_WITH(KD_TEXT_REQUEST,a,b);
law KD_TEXT_PREFIX := IF GOES_WITH(KD_TEXT_REQUEST,CONS(a,x),CONS(a,y)) THEN GOES_WITH(KD_TEXT_REQUEST,x,y);
law KD_TEXT_HEAD_DIFF := IF GOES_WITH(KD_TEXT_REQUEST,CONS(a,x),CONS(b,y)), GOES_WITH(KD_BYTE_DIFFER,a,b) THEN GOES_WITH(KD_TEXT_DIFF,CONS(a,x),CONS(b,y));
law KD_TEXT_LEFT_END := IF GOES_WITH(KD_TEXT_REQUEST,NIL,CONS(a,t)) THEN GOES_WITH(KD_TEXT_DIFF,NIL,CONS(a,t));
law KD_TEXT_RIGHT_END := IF GOES_WITH(KD_TEXT_REQUEST,CONS(a,t),NIL) THEN GOES_WITH(KD_TEXT_DIFF,CONS(a,t),NIL);
law KD_TEXT_DIFF_PREFIX := IF GOES_WITH(KD_TEXT_REQUEST,CONS(a,x),CONS(a,y)), GOES_WITH(KD_TEXT_DIFF,x,y) THEN GOES_WITH(KD_TEXT_DIFF,CONS(a,x),CONS(a,y));
law KD_TEXT_DIFF := IF GOES_WITH(KD_DIFF_REQUEST,TEXT(a),TEXT(b)), GOES_WITH(KD_TEXT_DIFF,a,b) THEN GOES_WITH(KD_DIFF,TEXT(a),TEXT(b));
law KD_ARRAY_REQUEST := IF GOES_WITH(KD_DIFF_REQUEST,ARRAY(a),ARRAY(b)) THEN GOES_WITH(KD_LIST_REQUEST,a,b);
law KD_LIST_HEAD := IF GOES_WITH(KD_LIST_REQUEST,CONS(a,x),CONS(b,y)) THEN GOES_WITH(KD_DIFF_REQUEST,a,b);
law KD_LIST_TAIL := IF GOES_WITH(KD_LIST_REQUEST,CONS(a,x),CONS(b,y)) THEN GOES_WITH(KD_LIST_REQUEST,x,y);
law KD_ARRAY_DIFF := IF GOES_WITH(KD_DIFF_REQUEST,ARRAY(a),ARRAY(b)), GOES_WITH(KD_LIST_DIFF,a,b) THEN GOES_WITH(KD_DIFF,ARRAY(a),ARRAY(b));
// Additive native index extension of diagnostic008:60-61 only.
// The sole producer unpacks an already derived CONS/CONS LIST_REQUEST.
// No index fact is an input. The old requests, distinctions and heads remain.
// Projection omits ONLY KD_LIST_PARTS_019 when comparing the old full fact set.
law KD_LIST_PARTS_019 := IF GOES_WITH(KD_LIST_REQUEST,CONS(a,x),CONS(b,y)) THEN GOES_WITH(KD_LIST_PARTS_019,CONS(a,x),CONS(b,y),a,x,b,y);
law KD_LIST_HEAD_DIFF := IF GOES_WITH(KD_LIST_PARTS_019,CONS(a,x),CONS(b,y),a,x,b,y), GOES_WITH(KD_DIFF,a,b) THEN GOES_WITH(KD_LIST_DIFF,CONS(a,x),CONS(b,y));
law KD_LIST_TAIL_DIFF := IF GOES_WITH(KD_LIST_PARTS_019,CONS(a,x),CONS(b,y),a,x,b,y), GOES_WITH(KD_LIST_DIFF,x,y) THEN GOES_WITH(KD_LIST_DIFF,CONS(a,x),CONS(b,y));

// Additive execution-cost variant of r1.mal; original bytes and readback retained.
// Only four RETAIN antecedents gain their already-forced native CASE witness.
// READ <- CHECK <- (CASE and OLD_WALL) or (AFFECTED and BASELINE);
// AFFECTED <- MEMBER and INCIDENT; every MEMBER constructor requires CASE.
// Thus every READ already entails CASE; no input, head, receipt or case changes.
// R1: source-owned two-site inputs and the bounded 484+1440 diagnostic offers.
// Candidate diagnostic only. No promoted offer exhaustion, selection, admission,
// worldline append, or current-world write. All verdicts below concern this family.
// Native ancestry: diagnostic008 geometry/distinction; sections009/fibres010
// constant-coordinate assignments; pairs011 sparse receipt/completeness clauses.
// KD_DIFF is the unchanged byte/array distinction fragment of diagnostic008.
// Coverage rows are generic grouping of every native R1_MEMBER, not extra offers.

law R1_FIELD_IMPORT := IF THIS(R1_INPUT_FIELD_ROW,ARRAY(CONS(f,CONS(r,NIL)))) THEN GOES_WITH(R1_SOURCE_FIELD,f,r);
law R1_FLAG := IF GOES_WITH(R1_SOURCE_FIELD,ARRAY(CONS(v,CONS(e,CONS(t,NIL)))),r) THEN GOES_WITH(R1_FLAG,ARRAY(CONS(v,CONS(e,CONS(t,NIL)))),v,e,t);
law R1_WITNESS_IMPORT := IF THIS(R1_INPUT_WITNESS_ROW,ARRAY(CONS(a,CONS(b,CONS(r,NIL))))) THEN GOES_WITH(R1_SOURCE_WITNESS,a,b,r);
law R1_OVERLAP := IF GOES_WITH(R1_SOURCE_WITNESS,a,b,r) THEN GOES_WITH(R1_OVERLAP,a,b);
law R1_DELTA := IF GOES_WITH(R1_OVERLAP,a,b), GOES_WITH(R1_FLAG,a,v,e,t), GOES_WITH(R1_FLAG,b,w,e,t) THEN GOES_WITH(R1_INCIDENT,a,DELTA,a,b);
law R1_GAMMA := IF GOES_WITH(R1_OVERLAP,a,b), GOES_WITH(R1_FLAG,a,v,e,t), GOES_WITH(R1_FLAG,b,v,q,t) THEN GOES_WITH(R1_INCIDENT,a,GAMMA,a,b);
law R1_TAU := IF GOES_WITH(R1_OVERLAP,a,b), GOES_WITH(R1_FLAG,a,v,e,t), GOES_WITH(R1_FLAG,b,v,e,u) THEN GOES_WITH(R1_INCIDENT,a,TAU,a,b);
law R1_INCIDENT_OTHER := IF GOES_WITH(R1_INCIDENT,a,k,a,b) THEN GOES_WITH(R1_INCIDENT,b,k,a,b);
law R1_SITE := IF GOES_WITH(R1_FLAG,f,v,e,t) THEN THIS(R1_SITE,v);
law R1_EDGE := IF GOES_WITH(R1_FLAG,f,v,e,t) THEN THIS(R1_EDGE,e);
law R1_TRIAD := IF GOES_WITH(R1_FLAG,f,v,e,t) THEN THIS(R1_TRIAD,t);
law R1_TWO_SITE_INPUT := IF THIS(R1_EDGE,ARRAY(CONS(v,CONS(w,NIL)))) THEN THIS(R1_INPUT,TWO_SITES(ARRAY(CONS(v,CONS(w,NIL)))));

// The exact 1,924 families are enumerated from incidence, not supplied by host.
law R1_SITE_THIS := IF THIS(R1_SITE,v) THEN THIS(R1_CASE,SITE(v,"THIS"));
law R1_SITE_NO := IF THIS(R1_SITE,v) THEN THIS(R1_CASE,SITE(v,"NO"));
law R1_EDGE_THIS := IF THIS(R1_EDGE,e) THEN THIS(R1_CASE,EDGE(e,"THIS"));
law R1_EDGE_NO := IF THIS(R1_EDGE,e) THEN THIS(R1_CASE,EDGE(e,"NO"));
law R1_TRIAD_THIS := IF THIS(R1_TRIAD,t) THEN THIS(R1_CASE,TRIAD(t,"THIS"));
law R1_TRIAD_NO := IF THIS(R1_TRIAD,t) THEN THIS(R1_CASE,TRIAD(t,"NO"));
law R1_PAIR_THIS := IF GOES_WITH(R1_INCIDENT,a,k,a,b) THEN THIS(R1_CASE,PAIR(k,a,b,"THIS"));
law R1_PAIR_NO := IF GOES_WITH(R1_INCIDENT,a,k,a,b) THEN THIS(R1_CASE,PAIR(k,a,b,"NO"));
law R1_SITE_MEMBER := IF THIS(R1_CASE,SITE(v,r)), GOES_WITH(R1_FLAG,f,v,e,t) THEN GOES_WITH(R1_MEMBER,SITE(v,r),f,r);
law R1_EDGE_MEMBER := IF THIS(R1_CASE,EDGE(e,r)), GOES_WITH(R1_FLAG,f,v,e,t) THEN GOES_WITH(R1_MEMBER,EDGE(e,r),f,r);
law R1_TRIAD_MEMBER := IF THIS(R1_CASE,TRIAD(t,r)), GOES_WITH(R1_FLAG,f,v,e,t) THEN GOES_WITH(R1_MEMBER,TRIAD(t,r),f,r);
law R1_PAIR_MEMBER_A := IF THIS(R1_CASE,PAIR(k,a,b,r)) THEN GOES_WITH(R1_MEMBER,PAIR(k,a,b,r),a,r);
law R1_PAIR_MEMBER_B := IF THIS(R1_CASE,PAIR(k,a,b,r)) THEN GOES_WITH(R1_MEMBER,PAIR(k,a,b,r),b,r);
law R1_AFFECTED := IF GOES_WITH(R1_MEMBER,m,f,r), GOES_WITH(R1_INCIDENT,f,k,a,b) THEN GOES_WITH(R1_AFFECTED,m,a,b);

// G2 is qualification only. TWO_SITES writes both complete site fibres THIS,
// every other flag NO. Original g2 witness statuses never bind new baselines.
law R1_TRIAL_G2 := IF THIS(R1_REQUEST,G2) THEN THIS(R1_TRIAL,G2);
law R1_TRIAL_TWO := IF THIS(R1_REQUEST,TWO_SITES(e)), THIS(R1_INPUT,TWO_SITES(e)) THEN THIS(R1_TRIAL,TWO_SITES(e));
law R1_BASE_G2 := IF THIS(R1_TRIAL,G2), GOES_WITH(R1_SOURCE_FIELD,f,r) THEN GOES_WITH(R1_BASE,G2,f,r);
law R1_BASE_LEFT := IF THIS(R1_TRIAL,TWO_SITES(ARRAY(CONS(v,CONS(w,NIL))))), GOES_WITH(R1_FLAG,f,v,e,t) THEN GOES_WITH(R1_BASE,TWO_SITES(ARRAY(CONS(v,CONS(w,NIL)))),f,"THIS");
law R1_BASE_RIGHT := IF THIS(R1_TRIAL,TWO_SITES(ARRAY(CONS(v,CONS(w,NIL))))), GOES_WITH(R1_FLAG,f,w,e,t) THEN GOES_WITH(R1_BASE,TWO_SITES(ARRAY(CONS(v,CONS(w,NIL)))),f,"THIS");
law R1_BASE_COMPARE_LEFT := IF THIS(R1_TRIAL,TWO_SITES(ARRAY(CONS(v,CONS(w,NIL))))), THIS(R1_SITE,s) THEN GOES_WITH(KD_DIFF_REQUEST,s,v);
law R1_BASE_COMPARE_RIGHT := IF THIS(R1_TRIAL,TWO_SITES(ARRAY(CONS(v,CONS(w,NIL))))), THIS(R1_SITE,s) THEN GOES_WITH(KD_DIFF_REQUEST,s,w);
law R1_BASE_OUTSIDE := IF THIS(R1_TRIAL,TWO_SITES(ARRAY(CONS(v,CONS(w,NIL))))), GOES_WITH(R1_FLAG,f,s,e,t), GOES_WITH(KD_DIFF,s,v), GOES_WITH(KD_DIFF,s,w) THEN GOES_WITH(R1_BASE,TWO_SITES(ARRAY(CONS(v,CONS(w,NIL)))),f,"NO");
law R1_BASE_SAME := IF THIS(R1_TRIAL,i), GOES_WITH(R1_OVERLAP,a,b), GOES_WITH(R1_BASE,i,a,r), GOES_WITH(R1_BASE,i,b,r) THEN GOES_WITH(R1_BASELINE,i,a,b,"SAME");
law R1_BASE_DIFF_A := IF THIS(R1_TRIAL,i), GOES_WITH(R1_OVERLAP,a,b), GOES_WITH(R1_BASE,i,a,"THIS"), GOES_WITH(R1_BASE,i,b,"NO") THEN GOES_WITH(R1_BASELINE,i,a,b,"NOT_SAME");
law R1_BASE_DIFF_B := IF THIS(R1_TRIAL,i), GOES_WITH(R1_OVERLAP,a,b), GOES_WITH(R1_BASE,i,a,"NO"), GOES_WITH(R1_BASE,i,b,"THIS") THEN GOES_WITH(R1_BASELINE,i,a,b,"NOT_SAME");
law R1_OLD_WALL := IF GOES_WITH(R1_BASELINE,i,a,b,"NOT_SAME") THEN GOES_WITH(R1_OLD_WALL,i,a,b);
law R1_G2_WITNESS_BOUND := IF GOES_WITH(R1_BASELINE,G2,a,b,r), GOES_WITH(R1_SOURCE_WITNESS,a,b,r) THEN GOES_WITH(R1_G2_WITNESS_BOUND,a,b,r);

// Only assigned flags may change. Every affected overlap and every old wall
// is evaluated, so all three receipt sets have explicit native witnesses.
law R1_CHECK_AFFECTED := IF GOES_WITH(R1_AFFECTED,m,a,b), GOES_WITH(R1_BASELINE,i,a,b,old) THEN GOES_WITH(R1_CHECK,i,m,a,b,old);
law R1_CHECK_WALL := IF THIS(R1_CASE,m), GOES_WITH(R1_OLD_WALL,i,a,b) THEN GOES_WITH(R1_CHECK,i,m,a,b,"NOT_SAME");
law R1_READ_A := IF GOES_WITH(R1_CHECK,i,m,a,b,old) THEN GOES_WITH(R1_READ,i,m,a);
law R1_READ_B := IF GOES_WITH(R1_CHECK,i,m,a,b,old) THEN GOES_WITH(R1_READ,i,m,b);
law R1_ASSIGNED := IF GOES_WITH(R1_READ,i,m,f), GOES_WITH(R1_MEMBER,m,f,r) THEN GOES_WITH(R1_NEXT,i,m,f,r);
law R1_COMPARE_SITE := IF GOES_WITH(R1_READ,i,SITE(v,r),f), GOES_WITH(R1_FLAG,f,w,e,t) THEN GOES_WITH(KD_DIFF_REQUEST,w,v);
law R1_COMPARE_EDGE := IF GOES_WITH(R1_READ,i,EDGE(e,r),f), GOES_WITH(R1_FLAG,f,v,q,t) THEN GOES_WITH(KD_DIFF_REQUEST,q,e);
law R1_COMPARE_TRIAD := IF GOES_WITH(R1_READ,i,TRIAD(t,r),f), GOES_WITH(R1_FLAG,f,v,e,u) THEN GOES_WITH(KD_DIFF_REQUEST,u,t);
law R1_COMPARE_PAIR_A := IF GOES_WITH(R1_READ,i,PAIR(k,a,b,r),f) THEN GOES_WITH(KD_DIFF_REQUEST,f,a);
law R1_COMPARE_PAIR_B := IF GOES_WITH(R1_READ,i,PAIR(k,a,b,r),f) THEN GOES_WITH(KD_DIFF_REQUEST,f,b);
law R1_RETAIN_SITE := IF THIS(R1_CASE,SITE(v,r)), GOES_WITH(R1_READ,i,SITE(v,r),f), GOES_WITH(R1_FLAG,f,w,e,t), GOES_WITH(KD_DIFF,w,v), GOES_WITH(R1_BASE,i,f,old) THEN GOES_WITH(R1_NEXT,i,SITE(v,r),f,old);
law R1_RETAIN_EDGE := IF THIS(R1_CASE,EDGE(e,r)), GOES_WITH(R1_READ,i,EDGE(e,r),f), GOES_WITH(R1_FLAG,f,v,q,t), GOES_WITH(KD_DIFF,q,e), GOES_WITH(R1_BASE,i,f,old) THEN GOES_WITH(R1_NEXT,i,EDGE(e,r),f,old);
law R1_RETAIN_TRIAD := IF THIS(R1_CASE,TRIAD(t,r)), GOES_WITH(R1_READ,i,TRIAD(t,r),f), GOES_WITH(R1_FLAG,f,v,e,u), GOES_WITH(KD_DIFF,u,t), GOES_WITH(R1_BASE,i,f,old) THEN GOES_WITH(R1_NEXT,i,TRIAD(t,r),f,old);
law R1_RETAIN_PAIR := IF THIS(R1_CASE,PAIR(k,a,b,r)), GOES_WITH(R1_READ,i,PAIR(k,a,b,r),f), GOES_WITH(KD_DIFF,f,a), GOES_WITH(KD_DIFF,f,b), GOES_WITH(R1_BASE,i,f,old) THEN GOES_WITH(R1_NEXT,i,PAIR(k,a,b,r),f,old);
law R1_AFTER_SAME := IF GOES_WITH(R1_CHECK,i,m,a,b,old), GOES_WITH(R1_NEXT,i,m,a,r), GOES_WITH(R1_NEXT,i,m,b,r) THEN GOES_WITH(R1_AFTER,i,m,a,b,old,"SAME");
law R1_AFTER_DIFF_A := IF GOES_WITH(R1_CHECK,i,m,a,b,old), GOES_WITH(R1_NEXT,i,m,a,"THIS"), GOES_WITH(R1_NEXT,i,m,b,"NO") THEN GOES_WITH(R1_AFTER,i,m,a,b,old,"NOT_SAME");
law R1_AFTER_DIFF_B := IF GOES_WITH(R1_CHECK,i,m,a,b,old), GOES_WITH(R1_NEXT,i,m,a,"NO"), GOES_WITH(R1_NEXT,i,m,b,"THIS") THEN GOES_WITH(R1_AFTER,i,m,a,b,old,"NOT_SAME");
law R1_OPENED := IF GOES_WITH(R1_AFTER,i,m,a,b,"SAME","NOT_SAME") THEN GOES_WITH(R1_OPENED,i,m,a,b);
law R1_DISCHARGED := IF GOES_WITH(R1_AFTER,i,m,a,b,"NOT_SAME","SAME") THEN GOES_WITH(R1_DISCHARGED,i,m,a,b);
law R1_RETAINED := IF GOES_WITH(R1_AFTER,i,m,a,b,"NOT_SAME","NOT_SAME") THEN GOES_WITH(R1_RETAINED,i,m,a,b);
law R1_NO_OPEN_SAME := IF GOES_WITH(R1_AFTER,i,m,a,b,old,"SAME") THEN GOES_WITH(R1_NO_OPEN,i,m,a,b);
law R1_NO_OPEN_RETAINED := IF GOES_WITH(R1_AFTER,i,m,a,b,"NOT_SAME","NOT_SAME") THEN GOES_WITH(R1_NO_OPEN,i,m,a,b);
law R1_NO_DISCHARGE_SAME := IF GOES_WITH(R1_AFTER,i,m,a,b,"SAME",next) THEN GOES_WITH(R1_NO_DISCHARGE,i,m,a,b);
law R1_NO_DISCHARGE_RETAINED := IF GOES_WITH(R1_AFTER,i,m,a,b,"NOT_SAME","NOT_SAME") THEN GOES_WITH(R1_NO_DISCHARGE,i,m,a,b);

// Generalize PA's two-endpoint proof to the complete native member extent.
law R1_MEMBER_SEEN := IF GOES_WITH(R1_MEMBER,m,f,r), GOES_WITH(R1_INCIDENT,f,k,a,b), GOES_WITH(R1_AFTER,i,m,a,b,old,next) THEN GOES_WITH(R1_MEMBER_SEEN,i,m,f,k);
law R1_MEMBER_COMPLETE := IF GOES_WITH(R1_MEMBER_SEEN,i,m,f,DELTA), GOES_WITH(R1_MEMBER_SEEN,i,m,f,GAMMA), GOES_WITH(R1_MEMBER_SEEN,i,m,f,TAU) THEN GOES_WITH(R1_MEMBER_COMPLETE,i,m,f);
law R1_MEMBER_NO_OPEN_KIND := IF GOES_WITH(R1_MEMBER,m,f,r), GOES_WITH(R1_INCIDENT,f,k,a,b), GOES_WITH(R1_NO_OPEN,i,m,a,b) THEN GOES_WITH(R1_MEMBER_NO_OPEN_KIND,i,m,f,k);
law R1_MEMBER_NO_OPEN := IF GOES_WITH(R1_MEMBER_NO_OPEN_KIND,i,m,f,DELTA), GOES_WITH(R1_MEMBER_NO_OPEN_KIND,i,m,f,GAMMA), GOES_WITH(R1_MEMBER_NO_OPEN_KIND,i,m,f,TAU) THEN GOES_WITH(R1_MEMBER_NO_OPEN,i,m,f);
law R1_MEMBER_NO_DISCHARGE_KIND := IF GOES_WITH(R1_MEMBER,m,f,r), GOES_WITH(R1_INCIDENT,f,k,a,b), GOES_WITH(R1_NO_DISCHARGE,i,m,a,b) THEN GOES_WITH(R1_MEMBER_NO_DISCHARGE_KIND,i,m,f,k);
law R1_MEMBER_NO_DISCHARGE := IF GOES_WITH(R1_MEMBER_NO_DISCHARGE_KIND,i,m,f,DELTA), GOES_WITH(R1_MEMBER_NO_DISCHARGE_KIND,i,m,f,GAMMA), GOES_WITH(R1_MEMBER_NO_DISCHARGE_KIND,i,m,f,TAU) THEN GOES_WITH(R1_MEMBER_NO_DISCHARGE,i,m,f);

// Bounded chunk transport is generic list projection. It never supplies a case,
// field, receipt, completeness fact, exclusion or strict verdict.
law R1_COVER_CHUNK := IF THIS(R1_INPUT_COVER_CHUNK,ARRAY(xs)) THEN THIS(R1_COVER_ROWS,xs);
law R1_COVER_ROW := IF THIS(R1_COVER_ROWS,CONS(row,tail)) THEN THIS(R1_COVER_ROW,row);
law R1_COVER_TAIL := IF THIS(R1_COVER_ROWS,CONS(row,tail)) THEN THIS(R1_COVER_ROWS,tail);
law R1_IMPORT_LEAF := IF THIS(R1_COVER_ROW,LEAF(m,n,f)) THEN GOES_WITH(R1_COVER_LEAF,m,n,f);
law R1_IMPORT_JOIN := IF THIS(R1_COVER_ROW,JOIN(m,n,a,b)) THEN GOES_WITH(R1_COVER_JOIN,m,n,a,b);
law R1_IMPORT_ROOT := IF THIS(R1_COVER_ROW,ROOT(m,n)) THEN GOES_WITH(R1_COVER_ROOT,m,n);
law R1_COVER_LEAF := IF GOES_WITH(R1_COVER_LEAF,m,n,f), GOES_WITH(R1_MEMBER_COMPLETE,i,m,f) THEN GOES_WITH(R1_COVER,i,m,n);
law R1_COVER_JOIN := IF GOES_WITH(R1_COVER_JOIN,m,n,a,b), GOES_WITH(R1_COVER,i,m,a), GOES_WITH(R1_COVER,i,m,b) THEN GOES_WITH(R1_COVER,i,m,n);
law R1_EMPTY_OPEN_LEAF := IF GOES_WITH(R1_COVER_LEAF,m,n,f), GOES_WITH(R1_MEMBER_NO_OPEN,i,m,f) THEN GOES_WITH(R1_EMPTY_OPEN,i,m,n);
law R1_EMPTY_OPEN_JOIN := IF GOES_WITH(R1_COVER_JOIN,m,n,a,b), GOES_WITH(R1_EMPTY_OPEN,i,m,a), GOES_WITH(R1_EMPTY_OPEN,i,m,b) THEN GOES_WITH(R1_EMPTY_OPEN,i,m,n);
law R1_EMPTY_DISCHARGE_LEAF := IF GOES_WITH(R1_COVER_LEAF,m,n,f), GOES_WITH(R1_MEMBER_NO_DISCHARGE,i,m,f) THEN GOES_WITH(R1_EMPTY_DISCHARGE,i,m,n);
law R1_EMPTY_DISCHARGE_JOIN := IF GOES_WITH(R1_COVER_JOIN,m,n,a,b), GOES_WITH(R1_EMPTY_DISCHARGE,i,m,a), GOES_WITH(R1_EMPTY_DISCHARGE,i,m,b) THEN GOES_WITH(R1_EMPTY_DISCHARGE,i,m,n);
law R1_COMPLETE := IF GOES_WITH(R1_COVER_ROOT,m,n), GOES_WITH(R1_COVER,i,m,n) THEN GOES_WITH(R1_COMPLETE,i,m);
law R1_STRICT := IF GOES_WITH(R1_COMPLETE,i,m), GOES_WITH(R1_COVER_ROOT,m,n), GOES_WITH(R1_EMPTY_OPEN,i,m,n), GOES_WITH(R1_DISCHARGED,i,m,a,b) THEN GOES_WITH(R1_STRICT,i,m);
law R1_EXCLUDED_OPEN := IF GOES_WITH(R1_COMPLETE,i,m), GOES_WITH(R1_OPENED,i,m,a,b) THEN GOES_WITH(R1_EXCLUDED_OPEN,i,m,a,b);
law R1_EXCLUDED_EMPTY := IF GOES_WITH(R1_COMPLETE,i,m), GOES_WITH(R1_COVER_ROOT,m,n), GOES_WITH(R1_EMPTY_DISCHARGE,i,m,n) THEN GOES_WITH(R1_EXCLUDED_EMPTY,i,m);

// Test P: bounded diagnostic re-entry of the same 1,924-offer R1 producer.
// Imported R1 and KD laws remain byte-identical. This fragment supplies no move.
// A positive ZERO/ONE/MANY fold covers every native case before execution.
// Returned state means the complete pair(field,witness), not FABRIC_STATE.
// RETURNED and RELOADED_G2 are distinct constructors. No seal or commit here.
// P20_EFFECT/EXEC_FIELD/EXEC_WITNESS are pure candidate effect projections.
// P20_RETURN is an uncommitted return candidate. Only P_COMMITTED_RETURN,
// emitted by the separately bound own commit module, permits second-pass input.
// Grouping rows transport the native inventory; no verdict or result is seeded.

law P20_ROWS := IF THIS(P20_INPUT_CHUNK,ARRAY(xs)) THEN THIS(P20_ROWS,xs);
law P20_ROW := IF THIS(P20_ROWS,CONS(x,xs)) THEN THIS(P20_ROW,x);
law P20_TAIL := IF THIS(P20_ROWS,CONS(x,xs)) THEN THIS(P20_ROWS,xs);
law P20_K_LEAF := IF THIS(P20_ROW,K_LEAF(n,m)), THIS(R1_CASE,m) THEN GOES_WITH(P20_K_LEAF,n,m);
law P20_K_JOIN := IF THIS(P20_ROW,K_JOIN(n,a,b)) THEN GOES_WITH(P20_K_JOIN,n,a,b);
law P20_K_ROOT := IF THIS(P20_ROW,K_ROOT(n)) THEN THIS(P20_K_ROOT,n);
law P20_FIELD_LEAF := IF THIS(P20_ROW,FIELD_LEAF(n,f)), GOES_WITH(R1_FLAG,f,v,e,t) THEN GOES_WITH(P20_FIELD_LEAF,n,f);
law P20_FIELD_JOIN := IF THIS(P20_ROW,FIELD_JOIN(n,a,b)) THEN GOES_WITH(P20_FIELD_JOIN,n,a,b);
law P20_FIELD_ROOT := IF THIS(P20_ROW,FIELD_ROOT(n)) THEN THIS(P20_FIELD_ROOT,n);
law P20_WITNESS_LEAF := IF THIS(P20_ROW,WITNESS_LEAF(n,a,b)), GOES_WITH(R1_OVERLAP,a,b) THEN GOES_WITH(P20_WITNESS_LEAF,n,a,b);
law P20_WITNESS_JOIN := IF THIS(P20_ROW,WITNESS_JOIN(n,a,b)) THEN GOES_WITH(P20_WITNESS_JOIN,n,a,b);
law P20_WITNESS_ROOT := IF THIS(P20_ROW,WITNESS_ROOT(n)) THEN THIS(P20_WITNESS_ROOT,n);
law P20_RETURN_ROOT := IF THIS(P20_ROW,RETURN_ROOT(f,w)) THEN GOES_WITH(P20_RETURN_ROOT,f,w);

// The initial field and witness have the recorded source identity. Their entire
// extents must agree before a singleton or empty-K result is exposed.
law P20_INITIAL_CONTEXT := IF THIS(R1_TRIAL,G2), THIS(P20_SOURCE_ID,h) THEN GOES_WITH(P20_CONTEXT,G2,RECORDED_PAIR(h));
law P20_INITIAL_WITNESS := IF GOES_WITH(P20_CONTEXT,G2,p), GOES_WITH(R1_SOURCE_WITNESS,a,b,r) THEN GOES_WITH(P20_INPUT_WITNESS,G2,a,b,r);
law P20_INPUT_FIELD_LEAF := IF GOES_WITH(P20_FIELD_LEAF,n,f), GOES_WITH(R1_BASE,i,f,r) THEN GOES_WITH(P20_INPUT_FIELD_COVER,i,n);
law P20_INPUT_FIELD_JOIN := IF GOES_WITH(P20_FIELD_JOIN,n,a,b), GOES_WITH(P20_INPUT_FIELD_COVER,i,a), GOES_WITH(P20_INPUT_FIELD_COVER,i,b) THEN GOES_WITH(P20_INPUT_FIELD_COVER,i,n);
law P20_INPUT_WITNESS_LEAF := IF GOES_WITH(P20_WITNESS_LEAF,n,a,b), GOES_WITH(R1_BASELINE,i,a,b,r), GOES_WITH(P20_INPUT_WITNESS,i,a,b,r) THEN GOES_WITH(P20_INPUT_WITNESS_COVER,i,n);
law P20_INPUT_WITNESS_JOIN := IF GOES_WITH(P20_WITNESS_JOIN,n,a,b), GOES_WITH(P20_INPUT_WITNESS_COVER,i,a), GOES_WITH(P20_INPUT_WITNESS_COVER,i,b) THEN GOES_WITH(P20_INPUT_WITNESS_COVER,i,n);
law P20_INPUT_READY := IF GOES_WITH(P20_CONTEXT,i,p), THIS(P20_FIELD_ROOT,f), THIS(P20_WITNESS_ROOT,w), GOES_WITH(P20_INPUT_FIELD_COVER,i,f), GOES_WITH(P20_INPUT_WITNESS_COVER,i,w) THEN GOES_WITH(P20_INPUT_READY,i,p);

// Native exhaustive cardinality fold. ZERO has a positive exclusion witness;
// ONE retains its member. No absence test, ordering preference or host pick.
law P20_K_ZERO_OPEN := IF GOES_WITH(P20_K_LEAF,n,m), GOES_WITH(R1_EXCLUDED_OPEN,i,m,a,b) THEN GOES_WITH(P20_K_ZERO,i,n);
law P20_K_ZERO_EMPTY := IF GOES_WITH(P20_K_LEAF,n,m), GOES_WITH(R1_EXCLUDED_EMPTY,i,m) THEN GOES_WITH(P20_K_ZERO,i,n);
law P20_K_ONE_LEAF := IF GOES_WITH(P20_K_LEAF,n,m), GOES_WITH(R1_STRICT,i,m) THEN GOES_WITH(P20_K_ONE,i,n,m);
law P20_K_ZERO_JOIN := IF GOES_WITH(P20_K_JOIN,n,a,b), GOES_WITH(P20_K_ZERO,i,a), GOES_WITH(P20_K_ZERO,i,b) THEN GOES_WITH(P20_K_ZERO,i,n);
law P20_K_ONE_LEFT := IF GOES_WITH(P20_K_JOIN,n,a,b), GOES_WITH(P20_K_ONE,i,a,m), GOES_WITH(P20_K_ZERO,i,b) THEN GOES_WITH(P20_K_ONE,i,n,m);
law P20_K_ONE_RIGHT := IF GOES_WITH(P20_K_JOIN,n,a,b), GOES_WITH(P20_K_ZERO,i,a), GOES_WITH(P20_K_ONE,i,b,m) THEN GOES_WITH(P20_K_ONE,i,n,m);
law P20_K_MANY_ONES := IF GOES_WITH(P20_K_JOIN,n,a,b), GOES_WITH(P20_K_ONE,i,a,m), GOES_WITH(P20_K_ONE,i,b,q) THEN GOES_WITH(P20_K_MANY,i,n);
law P20_K_MANY_LEFT_ZERO := IF GOES_WITH(P20_K_JOIN,n,a,b), GOES_WITH(P20_K_MANY,i,a), GOES_WITH(P20_K_ZERO,i,b) THEN GOES_WITH(P20_K_MANY,i,n);
law P20_K_MANY_LEFT_ONE := IF GOES_WITH(P20_K_JOIN,n,a,b), GOES_WITH(P20_K_MANY,i,a), GOES_WITH(P20_K_ONE,i,b,m) THEN GOES_WITH(P20_K_MANY,i,n);
law P20_K_MANY_RIGHT_ZERO := IF GOES_WITH(P20_K_JOIN,n,a,b), GOES_WITH(P20_K_ZERO,i,a), GOES_WITH(P20_K_MANY,i,b) THEN GOES_WITH(P20_K_MANY,i,n);
law P20_K_MANY_RIGHT_ONE := IF GOES_WITH(P20_K_JOIN,n,a,b), GOES_WITH(P20_K_ONE,i,a,m), GOES_WITH(P20_K_MANY,i,b) THEN GOES_WITH(P20_K_MANY,i,n);
law P20_K_MANY_BOTH := IF GOES_WITH(P20_K_JOIN,n,a,b), GOES_WITH(P20_K_MANY,i,a), GOES_WITH(P20_K_MANY,i,b) THEN GOES_WITH(P20_K_MANY,i,n);
law P20_UNIQUE := IF GOES_WITH(P20_INPUT_READY,i,p), THIS(P20_K_ROOT,n), GOES_WITH(P20_K_ONE,i,n,m) THEN GOES_WITH(P20_UNIQUE,i,p,m);
law P20_K_EMPTY := IF GOES_WITH(P20_INPUT_READY,i,p), THIS(P20_K_ROOT,n), GOES_WITH(P20_K_ZERO,i,n) THEN GOES_WITH(P20_K_EMPTY,i,p);
law P20_K_MULTIPLE := IF GOES_WITH(P20_INPUT_READY,i,p), THIS(P20_K_ROOT,n), GOES_WITH(P20_K_MANY,i,n) THEN GOES_WITH(P20_K_MULTIPLE,i,p);

// Context/source-pair is retained on offered records. The offer-domain member
// identities may be SAME while their contextual receipts are NOT-SAME.
law P20_OFFER := IF GOES_WITH(P20_INPUT_READY,i,p), THIS(R1_CASE,m) THEN GOES_WITH(P20_OFFER,i,p,m);
law P20_OFFER_COMPLETE := IF GOES_WITH(P20_OFFER,i,p,m), GOES_WITH(R1_COMPLETE,i,m) THEN GOES_WITH(P20_OFFER_COMPLETE,i,p,m);
law P20_OFFER_OPENED := IF GOES_WITH(P20_OFFER,i,p,m), GOES_WITH(R1_OPENED,i,m,a,b) THEN GOES_WITH(P20_OFFER_OPENED,i,p,m,a,b);
law P20_OFFER_DISCHARGED := IF GOES_WITH(P20_OFFER,i,p,m), GOES_WITH(R1_DISCHARGED,i,m,a,b) THEN GOES_WITH(P20_OFFER_DISCHARGED,i,p,m,a,b);
law P20_OFFER_RETAINED := IF GOES_WITH(P20_OFFER,i,p,m), GOES_WITH(R1_RETAINED,i,m,a,b) THEN GOES_WITH(P20_OFFER_RETAINED,i,p,m,a,b);

// Only G2's exhaustive singleton can initiate this bounded two-pass diagnostic.
// The complete field uses the same member/retain construction as R1_NEXT;
// separate P20 tags leave the sparse qualified R1 evaluator unchanged.
law P20_EFFECT := IF GOES_WITH(P20_UNIQUE,G2,p,m) THEN GOES_WITH(P20_EFFECT,G2,p,m);
law P20_EXEC_ASSIGN := IF GOES_WITH(P20_EFFECT,i,p,m), GOES_WITH(R1_MEMBER,m,f,r) THEN GOES_WITH(P20_EXEC_FIELD,i,m,f,r);
law P20_EXEC_COMPARE_SITE := IF GOES_WITH(P20_EFFECT,i,p,SITE(v,r)), GOES_WITH(R1_FLAG,f,w,e,t) THEN GOES_WITH(KD_DIFF_REQUEST,w,v);
law P20_EXEC_COMPARE_EDGE := IF GOES_WITH(P20_EFFECT,i,p,EDGE(e,r)), GOES_WITH(R1_FLAG,f,v,q,t) THEN GOES_WITH(KD_DIFF_REQUEST,q,e);
law P20_EXEC_COMPARE_TRIAD := IF GOES_WITH(P20_EFFECT,i,p,TRIAD(t,r)), GOES_WITH(R1_FLAG,f,v,e,u) THEN GOES_WITH(KD_DIFF_REQUEST,u,t);
law P20_EXEC_COMPARE_PAIR_A := IF GOES_WITH(P20_EFFECT,i,p,PAIR(k,a,b,r)), GOES_WITH(R1_FLAG,f,v,e,t) THEN GOES_WITH(KD_DIFF_REQUEST,f,a);
law P20_EXEC_COMPARE_PAIR_B := IF GOES_WITH(P20_EFFECT,i,p,PAIR(k,a,b,r)), GOES_WITH(R1_FLAG,f,v,e,t) THEN GOES_WITH(KD_DIFF_REQUEST,f,b);
law P20_EXEC_RETAIN_SITE := IF GOES_WITH(P20_EFFECT,i,p,SITE(v,r)), GOES_WITH(R1_FLAG,f,w,e,t), GOES_WITH(KD_DIFF,w,v), GOES_WITH(R1_BASE,i,f,old) THEN GOES_WITH(P20_EXEC_FIELD,i,SITE(v,r),f,old);
law P20_EXEC_RETAIN_EDGE := IF GOES_WITH(P20_EFFECT,i,p,EDGE(e,r)), GOES_WITH(R1_FLAG,f,v,q,t), GOES_WITH(KD_DIFF,q,e), GOES_WITH(R1_BASE,i,f,old) THEN GOES_WITH(P20_EXEC_FIELD,i,EDGE(e,r),f,old);
law P20_EXEC_RETAIN_TRIAD := IF GOES_WITH(P20_EFFECT,i,p,TRIAD(t,r)), GOES_WITH(R1_FLAG,f,v,e,u), GOES_WITH(KD_DIFF,u,t), GOES_WITH(R1_BASE,i,f,old) THEN GOES_WITH(P20_EXEC_FIELD,i,TRIAD(t,r),f,old);
law P20_EXEC_RETAIN_PAIR := IF GOES_WITH(P20_EFFECT,i,p,PAIR(k,a,b,r)), GOES_WITH(R1_FLAG,f,v,e,t), GOES_WITH(KD_DIFF,f,a), GOES_WITH(KD_DIFF,f,b), GOES_WITH(R1_BASE,i,f,old) THEN GOES_WITH(P20_EXEC_FIELD,i,PAIR(k,a,b,r),f,old);
law P20_EXEC_WITNESS_SAME := IF GOES_WITH(P20_EFFECT,i,p,m), GOES_WITH(R1_OVERLAP,a,b), GOES_WITH(P20_EXEC_FIELD,i,m,a,r), GOES_WITH(P20_EXEC_FIELD,i,m,b,r) THEN GOES_WITH(P20_EXEC_WITNESS,i,m,a,b,"SAME");
law P20_EXEC_WITNESS_DIFF_A := IF GOES_WITH(P20_EFFECT,i,p,m), GOES_WITH(R1_OVERLAP,a,b), GOES_WITH(P20_EXEC_FIELD,i,m,a,"THIS"), GOES_WITH(P20_EXEC_FIELD,i,m,b,"NO") THEN GOES_WITH(P20_EXEC_WITNESS,i,m,a,b,"NOT_SAME");
law P20_EXEC_WITNESS_DIFF_B := IF GOES_WITH(P20_EFFECT,i,p,m), GOES_WITH(R1_OVERLAP,a,b), GOES_WITH(P20_EXEC_FIELD,i,m,a,"NO"), GOES_WITH(P20_EXEC_FIELD,i,m,b,"THIS") THEN GOES_WITH(P20_EXEC_WITNESS,i,m,a,b,"NOT_SAME");
law P20_RETURN_FIELD_LEAF := IF GOES_WITH(P20_FIELD_LEAF,n,f), GOES_WITH(P20_EXEC_FIELD,i,m,f,r) THEN GOES_WITH(P20_RETURN_FIELD_COVER,i,m,n);
law P20_RETURN_FIELD_JOIN := IF GOES_WITH(P20_FIELD_JOIN,n,a,b), GOES_WITH(P20_RETURN_FIELD_COVER,i,m,a), GOES_WITH(P20_RETURN_FIELD_COVER,i,m,b) THEN GOES_WITH(P20_RETURN_FIELD_COVER,i,m,n);
law P20_RETURN_WITNESS_LEAF := IF GOES_WITH(P20_WITNESS_LEAF,n,a,b), GOES_WITH(P20_EXEC_WITNESS,i,m,a,b,r) THEN GOES_WITH(P20_RETURN_WITNESS_COVER,i,m,n);
law P20_RETURN_WITNESS_JOIN := IF GOES_WITH(P20_WITNESS_JOIN,n,a,b), GOES_WITH(P20_RETURN_WITNESS_COVER,i,m,a), GOES_WITH(P20_RETURN_WITNESS_COVER,i,m,b) THEN GOES_WITH(P20_RETURN_WITNESS_COVER,i,m,n);
law P20_RETURN := IF GOES_WITH(P20_EFFECT,i,p,m), GOES_WITH(P20_RETURN_ROOT,f,w), GOES_WITH(P20_RETURN_FIELD_COVER,i,m,f), GOES_WITH(P20_RETURN_WITNESS_COVER,i,m,w) THEN GOES_WITH(P20_RETURN,i,p,m,RETURN_PAIR(i,m));

// Direct native feedback is gated by the own commit module's committed return,
// not by the candidate return above. Both payload components retain their exact
// first-pass native producer; no second field or expected result is supplied.
law P20_REENTRY_TRIAL := IF THIS(P20_MODE,CHAIN), GOES_WITH(P_COMMITTED_RETURN,i,p,m,q,prior,tick) THEN THIS(R1_TRIAL,RETURNED(i,m));
law P20_REENTRY_CONTEXT := IF THIS(P20_MODE,CHAIN), GOES_WITH(P_COMMITTED_RETURN,i,p,m,q,prior,tick), GOES_WITH(P20_C_PAIR_BOUND,i,m,pair,pairHash) THEN GOES_WITH(P20_CONTEXT,RETURNED(i,m),COMMITTED_PAIR(q,pairHash,prior,tick));
law P20_REENTRY_FIELD := IF THIS(P20_MODE,CHAIN), GOES_WITH(P_COMMITTED_RETURN,i,p,m,q,prior,tick), GOES_WITH(P20_EXEC_FIELD,i,m,f,r) THEN GOES_WITH(R1_BASE,RETURNED(i,m),f,r);
law P20_REENTRY_WITNESS := IF THIS(P20_MODE,CHAIN), GOES_WITH(P_COMMITTED_RETURN,i,p,m,q,prior,tick), GOES_WITH(P20_EXEC_WITNESS,i,m,a,b,r) THEN GOES_WITH(P20_INPUT_WITNESS,RETURNED(i,m),a,b,r);

// Negative control only: reloading the original pair is explicitly distinguished
// and never receives RETURNED provenance. CHAIN inputs contain no RELOAD_G2.
law P20_RELOAD_TRIAL := IF THIS(P20_MODE,RELOAD_G2), GOES_WITH(P_COMMITTED_RETURN,i,p,m,q,prior,tick) THEN THIS(R1_TRIAL,RELOADED_G2);
law P20_RELOAD_CONTEXT := IF THIS(P20_MODE,RELOAD_G2), GOES_WITH(P_COMMITTED_RETURN,i,p,m,q,prior,tick), THIS(P20_SOURCE_ID,h) THEN GOES_WITH(P20_CONTEXT,RELOADED_G2,RELOADED_PAIR(h));
law P20_RELOAD_FIELD := IF THIS(P20_MODE,RELOAD_G2), GOES_WITH(P_COMMITTED_RETURN,i,p,m,q,prior,tick), GOES_WITH(R1_SOURCE_FIELD,f,r) THEN GOES_WITH(R1_BASE,RELOADED_G2,f,r);
law P20_RELOAD_WITNESS := IF THIS(P20_MODE,RELOAD_G2), GOES_WITH(P_COMMITTED_RETURN,i,p,m,q,prior,tick), GOES_WITH(R1_SOURCE_WITNESS,a,b,r) THEN GOES_WITH(P20_INPUT_WITNESS,RELOADED_G2,a,b,r);

// Test P's own pair-world commit. Not a LocalSection grant, not an A3 lift,
// not the old 18-cell NO_FLAG_WRITE program, and not full FABRIC_STATE.
// Inputs are byte-bound by finish.mjs. No returned reading is a host seed.
// P20_RETURN already carries native full-field/full-witness coverage.
// The folds below render those exact native rows in the archived g2 order.
// The hash service only hashes native request subjects; no effect or verdict.
// All native TICK fields are C23 :93-102 except execution_source replaces the
// optional fabric_program slot: source custody is NOT geometric program ID.

@readonly input P20_COMMIT_WORLD := "commit_world:";
@readonly input P20_COMMIT_EXECUTION_SOURCE := "commit_execution_source:";
@readonly input P20_COMMIT_EXPECTED_RECEIPT := "commit_binding:/binding/receipt";
@readonly input P20_COMMIT_EXPECTED_SITE := "commit_binding:/binding/enactment/site";
@readonly input P20_COMMIT_EXPECTED_READING := "commit_binding:/binding/enactment/reading";
@readonly input P20_COMMIT_EXPECTED_PAIR := "commit_binding:/binding/successor_identity/pair_hash";
@readonly input P20_COMMIT_EXPECTED_RECEIPT_HASH := "commit_binding:/binding/receipt_hash";
@readonly input P20_COMMIT_EXPECTED_PREV := "commit_binding:/binding/prior_head";
@readonly input P20_COMMIT_EXPECTED_WHENCE := "commit_binding:/binding/whence";
@readonly input P20_COMMIT_EXPECTED_SOURCE_PAIR := "commit_binding:/binding/source/pair_hash";

// One P20_COMMIT_HASH_ROW readonly seed is appended per native request response,
// after ALL fixed laws. Prior rows remain identical in every continuation.
law P20_C_HASH_ROW := IF THIS(P20_COMMIT_HASH_ROW,ARRAY(CONS(subject,CONS(digest,NIL)))) THEN GOES_WITH(GPU_HASH_RESPONSE,subject,digest);

// Preserve the two archived entries as whole terms. The old head must also be
// the SHA256 of its actual record; source-pair and raw-file bindings are distinct.
law P20_C_SOURCE := IF THIS(P20_COMMIT_WORLD,OBJECT(CONS(MEMBER("chain",ARRAY(CONS(genesis,CONS(tick,NIL)))),CONS(MEMBER("field",field),CONS(MEMBER("receipt",receipt),CONS(MEMBER("witness",witness),NIL))))))
 THEN GOES_WITH(P20_C_SOURCE,genesis,tick,field,witness);
law P20_C_HEAD := IF GOES_WITH(P20_C_SOURCE,genesis,OBJECT(CONS(MEMBER("link",head),CONS(MEMBER("record",record),NIL))),field,witness)
 THEN GOES_WITH(P20_C_HEAD,head,record);
law P20_C_SOURCE_PAIR := IF GOES_WITH(P20_C_SOURCE,genesis,tick,field,witness)
 THEN GOES_WITH(P20_C_SOURCE_PAIR,OBJECT(CONS(MEMBER("field",field),CONS(MEMBER("witness",witness),NIL))));
law P20_C_SOURCE_PAIR_REQUEST := IF GOES_WITH(P20_C_SOURCE_PAIR,pair) THEN GOES_WITH(GPU_HASH_REQUEST,WORLD_PAIR,SOURCE_G2,pair);
law P20_C_SOURCE_HEAD_REQUEST := IF GOES_WITH(P20_C_HEAD,head,record) THEN GOES_WITH(GPU_HASH_REQUEST,WORLD_TICK,SOURCE_G2_HEAD,record);
law P20_C_SOURCE_CHECKED := IF GOES_WITH(P20_C_SOURCE_PAIR,pair), GOES_WITH(GPU_HASH_RESPONSE,pair,digest), THIS(P20_COMMIT_EXPECTED_SOURCE_PAIR,digest), GOES_WITH(P20_C_HEAD,head,record), GOES_WITH(GPU_HASH_RESPONSE,record,head), THIS(P20_COMMIT_EXPECTED_PREV,head), THIS(P20_COMMIT_EXPECTED_WHENCE,head)
 THEN GOES_WITH(P20_C_SOURCE_CHECKED,head);
// P20_SOURCE_ID is the pair identity, not the whole-file custody hash E447...
law P20_C_CONTEXT_CHECKED := IF GOES_WITH(P20_RETURN,G2,RECORDED_PAIR(pairhash),m,q), THIS(P20_SOURCE_ID,pairhash), THIS(P20_COMMIT_EXPECTED_SOURCE_PAIR,pairhash), GOES_WITH(P20_C_SOURCE_CHECKED,head)
 THEN GOES_WITH(P20_C_CONTEXT_CHECKED,G2,RECORDED_PAIR(pairhash),m,q,head);

// No host selection: the singleton member must itself equal the recorded
// SECTION_READING member. The two negative requests cannot cross this join.
law P20_C_REQUEST := IF GOES_WITH(P20_C_CONTEXT_CHECKED,i,p,m,q,head) THEN GOES_WITH(P20_C_REQUEST,NORMAL,i,p,m,q,head);
law P20_C_BAD_MEMBER_REQUEST := IF GOES_WITH(P20_C_CONTEXT_CHECKED,i,p,m,q,head), THIS(P20_COMMIT_EXPECTED_SITE,site) THEN GOES_WITH(P20_C_REQUEST,ALTERED_MEMBER,i,p,SITE(site,"THIS"),q,head);
law P20_C_BAD_HEAD_REQUEST := IF GOES_WITH(P20_C_CONTEXT_CHECKED,i,p,m,q,head) THEN GOES_WITH(P20_C_REQUEST,WRONG_HEAD,i,p,m,q,"CONTROL_WRONG_HEAD");
law P20_C_REQUEST_JOIN := IF GOES_WITH(P20_C_REQUEST,caseid,i,p,m,q,head), GOES_WITH(P20_C_CONTEXT_CHECKED,i,p,m,q,head), GOES_WITH(P20_UNIQUE,i,p,m), THIS(P20_COMMIT_EXPECTED_SITE,site), THIS(P20_COMMIT_EXPECTED_READING,reading), GOES_WITH(P20_RETURN,i,p,SITE(site,reading),q)
 THEN GOES_WITH(P20_C_REQUEST_JOINED,caseid,i,p,m,q,head);
law P20_C_GUARD := IF GOES_WITH(P20_C_REQUEST_JOINED,NORMAL,i,p,m,q,head) THEN GOES_WITH(P20_C_GUARD,i,p,m,q,head);

// Native total field rendering. A missing, altered, or extra source row fails
// its source-row join. No new order is chosen; the entire archived list is used.
law P20_C_FIELD_BEGIN := IF GOES_WITH(P20_C_GUARD,i,p,m,q,head), GOES_WITH(P20_C_SOURCE,genesis,tick,ARRAY(rows),witness) THEN GOES_WITH(P20_C_FIELD_SCAN,i,m,rows);
law P20_C_FIELD_TAIL := IF GOES_WITH(P20_C_FIELD_SCAN,i,m,CONS(ARRAY(CONS(f,CONS(old,NIL))),tail)), GOES_WITH(R1_SOURCE_FIELD,f,old) THEN GOES_WITH(P20_C_FIELD_SCAN,i,m,tail);
law P20_C_FIELD_END := IF GOES_WITH(P20_C_FIELD_SCAN,i,m,NIL) THEN GOES_WITH(P20_C_FIELD_BUILD,i,m,NIL,NIL);
law P20_C_FIELD_ROW := IF GOES_WITH(P20_C_FIELD_SCAN,i,m,CONS(ARRAY(CONS(f,CONS(old,NIL))),tail)), GOES_WITH(R1_SOURCE_FIELD,f,old), GOES_WITH(P20_EXEC_FIELD,i,m,f,reading), GOES_WITH(P20_C_FIELD_BUILD,i,m,tail,next)
 THEN GOES_WITH(P20_C_FIELD_BUILD,i,m,CONS(ARRAY(CONS(f,CONS(old,NIL))),tail),CONS(ARRAY(CONS(f,CONS(reading,NIL))),next));
law P20_C_FIELD_COMPLETE := IF GOES_WITH(P20_C_SOURCE,genesis,tick,ARRAY(rows),witness), GOES_WITH(P20_C_FIELD_BUILD,i,m,rows,next) THEN GOES_WITH(P20_C_FIELD_COMPLETE,i,m,ARRAY(next));

// Witness and receipt are folded together from every old/new overlap reading.
// The four branches are precisely A4's two readings before and after the step.
law P20_C_WITNESS_BEGIN := IF GOES_WITH(P20_C_GUARD,i,p,m,q,head), GOES_WITH(P20_C_SOURCE,genesis,tick,field,ARRAY(rows)) THEN GOES_WITH(P20_C_WITNESS_SCAN,i,m,rows);
law P20_C_WITNESS_TAIL := IF GOES_WITH(P20_C_WITNESS_SCAN,i,m,CONS(ARRAY(CONS(a,CONS(b,CONS(old,NIL)))),tail)), GOES_WITH(R1_SOURCE_WITNESS,a,b,old) THEN GOES_WITH(P20_C_WITNESS_SCAN,i,m,tail);
law P20_C_WITNESS_END := IF GOES_WITH(P20_C_WITNESS_SCAN,i,m,NIL) THEN GOES_WITH(P20_C_WITNESS_BUILD,i,m,NIL,NIL,NIL,NIL,NIL);
law P20_C_UNCHANGED := IF GOES_WITH(P20_C_WITNESS_SCAN,i,m,CONS(ARRAY(CONS(a,CONS(b,CONS("SAME",NIL)))),tail)), GOES_WITH(P20_EXEC_WITNESS,i,m,a,b,"SAME"), GOES_WITH(P20_C_WITNESS_BUILD,i,m,tail,ws,ds,os,rs)
 THEN GOES_WITH(P20_C_WITNESS_BUILD,i,m,CONS(ARRAY(CONS(a,CONS(b,CONS("SAME",NIL)))),tail),CONS(ARRAY(CONS(a,CONS(b,CONS("SAME",NIL)))),ws),ds,os,rs);
law P20_C_DISCHARGED := IF GOES_WITH(P20_C_WITNESS_SCAN,i,m,CONS(ARRAY(CONS(a,CONS(b,CONS("NOT_SAME",NIL)))),tail)), GOES_WITH(P20_EXEC_WITNESS,i,m,a,b,"SAME"), GOES_WITH(P20_C_WITNESS_BUILD,i,m,tail,ws,ds,os,rs)
 THEN GOES_WITH(P20_C_WITNESS_BUILD,i,m,CONS(ARRAY(CONS(a,CONS(b,CONS("NOT_SAME",NIL)))),tail),CONS(ARRAY(CONS(a,CONS(b,CONS("SAME",NIL)))),ws),CONS(ARRAY(CONS(a,CONS(b,NIL))),ds),os,rs);
law P20_C_OPENED := IF GOES_WITH(P20_C_WITNESS_SCAN,i,m,CONS(ARRAY(CONS(a,CONS(b,CONS("SAME",NIL)))),tail)), GOES_WITH(P20_EXEC_WITNESS,i,m,a,b,"NOT_SAME"), GOES_WITH(P20_C_WITNESS_BUILD,i,m,tail,ws,ds,os,rs)
 THEN GOES_WITH(P20_C_WITNESS_BUILD,i,m,CONS(ARRAY(CONS(a,CONS(b,CONS("SAME",NIL)))),tail),CONS(ARRAY(CONS(a,CONS(b,CONS("NOT_SAME",NIL)))),ws),ds,CONS(ARRAY(CONS(a,CONS(b,NIL))),os),rs);
law P20_C_RETAINED := IF GOES_WITH(P20_C_WITNESS_SCAN,i,m,CONS(ARRAY(CONS(a,CONS(b,CONS("NOT_SAME",NIL)))),tail)), GOES_WITH(P20_EXEC_WITNESS,i,m,a,b,"NOT_SAME"), GOES_WITH(P20_C_WITNESS_BUILD,i,m,tail,ws,ds,os,rs)
 THEN GOES_WITH(P20_C_WITNESS_BUILD,i,m,CONS(ARRAY(CONS(a,CONS(b,CONS("NOT_SAME",NIL)))),tail),CONS(ARRAY(CONS(a,CONS(b,CONS("NOT_SAME",NIL)))),ws),ds,os,CONS(ARRAY(CONS(a,CONS(b,NIL))),rs));
law P20_C_WITNESS_COMPLETE := IF GOES_WITH(P20_C_SOURCE,genesis,tick,field,ARRAY(rows)), GOES_WITH(P20_C_WITNESS_BUILD,i,m,rows,ws,ds,os,rs) THEN GOES_WITH(P20_C_WITNESS_COMPLETE,i,m,ARRAY(ws),ARRAY(ds),ARRAY(os),ARRAY(rs));
law P20_C_PAIR := IF GOES_WITH(P20_C_GUARD,i,p,m,q,head), GOES_WITH(P20_C_FIELD_COMPLETE,i,m,field), GOES_WITH(P20_C_WITNESS_COMPLETE,i,m,witness,discharged,opened,retained)
 THEN GOES_WITH(P20_C_PAIR,i,m,OBJECT(CONS(MEMBER("field",field),CONS(MEMBER("witness",witness),NIL))));
law P20_C_RECEIPT := IF GOES_WITH(P20_C_WITNESS_COMPLETE,i,m,witness,discharged,opened,retained)
 THEN GOES_WITH(P20_C_RECEIPT,i,m,OBJECT(CONS(MEMBER("discharged",discharged),CONS(MEMBER("opened",opened),NIL))));
// RECEIPT_READING_001, first-tick v0.1.3 :350-354: content in either list -> THIS.
law P20_C_RECEIPT_READING_DISCHARGED := IF GOES_WITH(P20_C_RECEIPT,i,m,OBJECT(CONS(MEMBER("discharged",ARRAY(CONS(x,xs))),CONS(MEMBER("opened",opened),NIL)))) THEN GOES_WITH(P20_C_RECEIPT_READING,i,m,"THIS");
law P20_C_RECEIPT_READING_OPENED := IF GOES_WITH(P20_C_RECEIPT,i,m,OBJECT(CONS(MEMBER("discharged",discharged),CONS(MEMBER("opened",ARRAY(CONS(x,xs))),NIL)))) THEN GOES_WITH(P20_C_RECEIPT_READING,i,m,"THIS");
law P20_C_RECEIPT_READING_EMPTY := IF GOES_WITH(P20_C_RECEIPT,i,m,OBJECT(CONS(MEMBER("discharged",ARRAY(NIL)),CONS(MEMBER("opened",ARRAY(NIL)),NIL)))) THEN GOES_WITH(P20_C_RECEIPT_READING,i,m,"NO");
law P20_C_PAIR_REQUEST := IF GOES_WITH(P20_C_PAIR,i,m,pair) THEN GOES_WITH(GPU_HASH_REQUEST,WORLD_PAIR,RETURN_PAIR(i,m),pair);
law P20_C_RECEIPT_REQUEST := IF GOES_WITH(P20_C_RECEIPT,i,m,receipt) THEN GOES_WITH(GPU_HASH_REQUEST,WORLD_RECEIPT,RETURN_PAIR(i,m),receipt);
law P20_C_PAIR_BOUND := IF GOES_WITH(P20_C_PAIR,i,m,pair), GOES_WITH(GPU_HASH_RESPONSE,pair,digest), THIS(P20_COMMIT_EXPECTED_PAIR,digest) THEN GOES_WITH(P20_C_PAIR_BOUND,i,m,pair,digest);
law P20_C_RECEIPT_BOUND := IF GOES_WITH(P20_C_RECEIPT,i,m,receipt), THIS(P20_COMMIT_EXPECTED_RECEIPT,receipt), GOES_WITH(GPU_HASH_RESPONSE,receipt,digest), THIS(P20_COMMIT_EXPECTED_RECEIPT_HASH,digest), GOES_WITH(P20_C_RECEIPT_READING,i,m,"THIS") THEN GOES_WITH(P20_C_RECEIPT_BOUND,i,m,receipt,digest,"THIS");

// execution_source names exactly the .mal bundle producing this operation. Its
// bytes identify code custody only; it is not a cells/routes program identifier.
law P20_C_RECORD_PARTS := IF GOES_WITH(P20_C_PAIR_BOUND,i,m,OBJECT(CONS(MEMBER("field",field),CONS(MEMBER("witness",witness),NIL))),pairhash), GOES_WITH(P20_C_RECEIPT_BOUND,i,m,receipt,receipthash,reading)
 THEN GOES_WITH(P20_C_RECORD_PARTS,i,m,PARTS(field,witness,receipt,pairhash,receipthash,reading));
law P20_C_TICK_RECORD := IF GOES_WITH(P20_C_GUARD,i,p,m,q,head), GOES_WITH(P20_C_RECORD_PARTS,i,m,PARTS(field,witness,receipt,pairhash,receipthash,reading)), THIS(P20_COMMIT_EXECUTION_SOURCE,source)
 THEN GOES_WITH(P20_C_TICK_RECORD,i,m,head,OBJECT(CONS(MEMBER("execution_source",source),CONS(MEMBER("field",field),CONS(MEMBER("kind","TICK"),CONS(MEMBER("pair_hash",pairhash),CONS(MEMBER("prev",head),CONS(MEMBER("receipt",receipt),CONS(MEMBER("receipt_hash",receipthash),CONS(MEMBER("receipt_reading",reading),CONS(MEMBER("witness",witness),NIL)))))))))));
law P20_C_TICK_REQUEST := IF GOES_WITH(P20_C_TICK_RECORD,i,m,head,record) THEN GOES_WITH(GPU_HASH_REQUEST,WORLD_TICK,RETURN_PAIR(i,m),record);
law P20_C_TICK_HASH := IF GOES_WITH(P20_C_TICK_RECORD,i,m,head,record), GOES_WITH(GPU_HASH_RESPONSE,record,digest) THEN GOES_WITH(P20_C_TICK_HASH,i,m,head,record,digest);
law P20_C_TICK_ENTRY := IF GOES_WITH(P20_C_TICK_HASH,i,m,head,record,digest) THEN GOES_WITH(P20_C_TICK_ENTRY,i,m,head,OBJECT(CONS(MEMBER("link",digest),CONS(MEMBER("record",record),NIL))));
law P20_C_WORLD := IF GOES_WITH(P20_C_SOURCE,genesis,prior,oldfield,oldwitness), GOES_WITH(P20_C_RECORD_PARTS,i,m,PARTS(field,witness,receipt,pairhash,receipthash,reading)), GOES_WITH(P20_C_TICK_ENTRY,i,m,head,tick)
 THEN GOES_WITH(P20_C_WORLD,i,m,head,OBJECT(CONS(MEMBER("chain",ARRAY(CONS(genesis,CONS(prior,CONS(tick,NIL))))),CONS(MEMBER("field",field),CONS(MEMBER("receipt",receipt),CONS(MEMBER("witness",witness),NIL))))));
law P20_C_COMMITTED_RETURN := IF GOES_WITH(P20_C_GUARD,i,p,m,q,head), GOES_WITH(P20_C_WORLD,i,m,head,world), GOES_WITH(P20_C_TICK_HASH,i,m,head,record,digest)
 THEN GOES_WITH(P_COMMITTED_RETURN,i,p,m,q,head,digest);
law P20_C_COMMITTED_WORLD := IF GOES_WITH(P_COMMITTED_RETURN,i,p,m,q,head,digest), GOES_WITH(P20_C_WORLD,i,m,head,world) THEN THIS(P20_COMMITTED_WORLD,world);

// Generic SHA256 service responses; all earlier rows retained.
@readonly input P20_COMMIT_HASH_ROW := "commit_hashes:/0";
@readonly input P20_COMMIT_HASH_ROW := "commit_hashes:/1";
